// Resources of the release launcher "Project Helghast.exe" (release pass 6).
// The icon is generated by tools/release/installer_art.py into installer/art/; build_launcher.sh passes that folder
// with --include-dir. Version strings are plain text (no game names beyond the port's title).
#include <winver.h>

1 ICON "kz3-launcher.ico"

1 VERSIONINFO
FILEVERSION 0,1,4,0
PRODUCTVERSION 0,1,4,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Project Helghast contributors"
      VALUE "FileVersion", "0.1.4"
      VALUE "ProductVersion", "0.1.4"
      VALUE "FileDescription", "Project Helghast launcher"
      VALUE "InternalName", "launcher"
      VALUE "OriginalFilename", "Project Helghast.exe"
      VALUE "ProductName", "Project Helghast"
      VALUE "Comments", "https://undecuple.github.io/project-helghast"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
