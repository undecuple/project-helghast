# No global text/eol normalisation: several ps3recomp sources are CRLF and our patches carry that context byte for
# byte (a global `text=auto eol=lf` made `git apply` reject them in CI).
*.png binary
*.patch -text linguist-generated=true
re/data/*.tsv linguist-generated=true
# Intel's XeSS licence texts are stored byte for byte as Intel ships them (CRLF): xess_runtime.py pins their
# SHA-256 and test_licenses_match.py compares the committed copies with those pins.
licenses/Intel-XeSS-*.txt -text -whitespace
