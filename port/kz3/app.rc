// Resources of kz3.exe (release pass 40): icon, version block (Task Manager's Processes tab shows
// FileDescription) and the application manifest. Only the port is named; no game publisher or developer.
// The icon is the port's own art, generated by tools/release/installer_art.py (installer/art/kz3-launcher.ico).
#include <winver.h>

#ifndef KZ3_VER_MAJOR
#define KZ3_VER_MAJOR 0
#define KZ3_VER_MINOR 1
#define KZ3_VER_PATCH 0
#endif
#ifndef KZ3_VER_BUILD
#define KZ3_VER_BUILD 0
#endif
#define KZ3_STR2(x) #x
#define KZ3_STR(x) KZ3_STR2(x)
#define KZ3_VER_STR KZ3_STR(KZ3_VER_MAJOR) "." KZ3_STR(KZ3_VER_MINOR) "." KZ3_STR(KZ3_VER_PATCH) "." KZ3_STR(KZ3_VER_BUILD)

1 ICON "kz3-launcher.ico"

1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION KZ3_VER_MAJOR,KZ3_VER_MINOR,KZ3_VER_PATCH,KZ3_VER_BUILD
PRODUCTVERSION KZ3_VER_MAJOR,KZ3_VER_MINOR,KZ3_VER_PATCH,KZ3_VER_BUILD
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Project Helghast contributors"
      VALUE "FileDescription", "Project Helghast"
      VALUE "FileVersion", KZ3_VER_STR
      VALUE "InternalName", "kz3"
      VALUE "LegalCopyright", "Project Helghast contributors. Unofficial PC port, built from your own game copy."
      VALUE "OriginalFilename", "kz3.exe"
      VALUE "ProductName", "Project Helghast"
      VALUE "ProductVersion", KZ3_VER_STR
      VALUE "Comments", "https://undecuple.github.io/project-helghast"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
