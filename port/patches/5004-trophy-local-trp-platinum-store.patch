+/* ---------------------------------------------------------------------------
+ * TROPHY.TRP: header 0x40 B (BE magic 0xDCA24D00, version, u64 file size,
+ * u32 entry count, u32 entry size), then entries {char name[32]; u64 offset;
+ * u64 size; ...}. TROP.SFM (default language) / TROPCONF.SFM are small XML:
+ * <trophy id="000" hidden="no" ttype="P" pid="-1"><name>..</name><detail>..</detail></trophy>
+ * -----------------------------------------------------------------------*/
+
+#define TRP_MAGIC 0xDCA24D00u
+
+static u32 rd_be32(const u8* p) { return ((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | p[3]; }
+static u64 rd_be64(const u8* p) { return ((u64)rd_be32(p) << 32) | rd_be32(p + 4); }
+
+static int ci_equal(const char* a, const char* b)
+{
+    for (; *a && *b; a++, b++) {
+        char x = *a, y = *b;
+        if (x >= 'a' && x <= 'z') x -= 32;
+        if (y >= 'a' && y <= 'z') y -= 32;
+        if (x != y) return 0;
+    }
+    return *a == *b;
+}
+
+/* Copy XML text [s, e) into out (cap bytes), decoding the five predefined
+ * entities and cutting at a UTF-8 character boundary. */
+static void xml_text(const char* s, const char* e, char* out, size_t cap)
+{
+    size_t n = 0;
+    while (s < e && n + 1 < cap) {
+        char c = *s;
+        size_t adv = 1;
+        if (c == '&') {
+            static const struct { const char* ent; char ch; } ents[] = {
+                {"&amp;", '&'}, {"&lt;", '<'}, {"&gt;", '>'}, {"&quot;", '"'}, {"&apos;", '\''} };
+            for (size_t i = 0; i < sizeof(ents) / sizeof(ents[0]); i++) {
+                size_t l = strlen(ents[i].ent);
+                if ((size_t)(e - s) >= l && memcmp(s, ents[i].ent, l) == 0) { c = ents[i].ch; adv = l; break; }
+            }
+        }
+        out[n++] = c;
+        s += adv;
+    }
+    /* do not leave half a UTF-8 sequence at the cut */
+    if (s < e && n > 0) {
+        size_t k = n;
+        while (k > 0 && ((u8)out[k - 1] & 0xC0) == 0x80) k--;
+        if (k > 0 && ((u8)out[k - 1] & 0xC0) == 0xC0) n = k - 1;
+    }
+    out[n] = '\0';
+}
+
+/* Value of attribute `name` inside the tag text [tag, end). */
+static int xml_attr(const char* tag, const char* end, const char* name, char* out, size_t cap)
+{
+    size_t l = strlen(name);
+    for (const char* p = tag; p + l + 2 < end; p++) {
+        if ((p[-1] == ' ' || p[-1] == '\t' || p[-1] == '\n') && memcmp(p, name, l) == 0 && p[l] == '=' && p[l + 1] == '"') {
+            const char* v = p + l + 2;
+            const char* q = memchr(v, '"', (size_t)(end - v));
+            if (!q) return 0;
+            xml_text(v, q, out, cap);
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/* Text of the first <elem>..</elem> in [s, e). */
+static int xml_elem(const char* s, const char* e, const char* elem, char* out, size_t cap)
+{
+    char open[48], close[48];
+    snprintf(open, sizeof(open), "<%s>", elem);
+    snprintf(close, sizeof(close), "</%s>", elem);
+    size_t lo = strlen(open);
+    for (const char* p = s; p + lo <= e; p++) {
+        if (memcmp(p, open, lo) == 0) {
+            const char* v = p + lo;
+            for (const char* q = v; q + strlen(close) <= e; q++)
+                if (memcmp(q, close, strlen(close)) == 0) { xml_text(v, q, out, cap); return 1; }
+            return 0;
+        }
+    }
+    return 0;
+}
+
+/* Parse one SFM. Returns the number of <trophy> tags taken. */
+static int trophy_parse_sfm(TrophyContext* ctx, const char* x, size_t len)
+{
+    const char* end = x + len;
+    const char* p = x;
+    int found = 0;
+    s32 max_id = -1;
+    char v[64];
+
+    /* title: the first <title-name> (outside any trophy) */
+    xml_elem(x, end, "title-name", ctx->title, sizeof(ctx->title));
+    xml_elem(x, end, "title-detail", ctx->title_detail, sizeof(ctx->title_detail));
+
+    while ((p = strstr(p, "<trophy ")) != NULL && p < end) {
+        const char* tag_end = memchr(p, '>', (size_t)(end - p));
+        if (!tag_end) break;
+        const char* body_end = tag_end;
+        if (tag_end[-1] != '/') {
+            const char* c = strstr(tag_end, "</trophy>");
+            if (!c || c > end) break;
+            body_end = c;
+        }
+        if (!xml_attr(p + 1, tag_end, "id", v, sizeof(v))) { p = tag_end; continue; }
+        long id = strtol(v, NULL, 10);
+        if (id < 0 || id >= SCE_NP_TROPHY_MAX_NUM_TROPHIES) {
+            printf("[sceNpTrophy] TRP trophy id %ld beyond the %d supported: skipped\n", id, SCE_NP_TROPHY_MAX_NUM_TROPHIES);
+            p = tag_end;
+            continue;
+        }
+        TrophyMeta* m = &ctx->meta[id];
+        m->grade = SCE_NP_TROPHY_GRADE_UNKNOWN;
+        if (xml_attr(p + 1, tag_end, "ttype", v, sizeof(v)))
+            m->grade = v[0] == 'P' ? SCE_NP_TROPHY_GRADE_PLATINUM : v[0] == 'G' ? SCE_NP_TROPHY_GRADE_GOLD
+                     : v[0] == 'S' ? SCE_NP_TROPHY_GRADE_SILVER : v[0] == 'B' ? SCE_NP_TROPHY_GRADE_BRONZE
+                     : SCE_NP_TROPHY_GRADE_UNKNOWN;
+        m->hidden = xml_attr(p + 1, tag_end, "hidden", v, sizeof(v)) && strcmp(v, "yes") == 0;
+        m->pid = xml_attr(p + 1, tag_end, "pid", v, sizeof(v)) ? (s16)strtol(v, NULL, 10) : -1;
+        if (body_end > tag_end) {
+            xml_elem(tag_end, body_end, "name", m->name, sizeof(m->name));
+            xml_elem(tag_end, body_end, "detail", m->detail, sizeof(m->detail));
+        }
+        if (id > max_id) max_id = (s32)id;
+        found++;
+        p = body_end;
+    }
+    if (found > 0) ctx->total_trophies = (u32)(max_id + 1);
+    return found;
+}
+
+static int trophy_try_trp(TrophyContext* ctx, const char* path)
+{
+    FILE* fp = fopen(path, "rb");
+    if (!fp) return 0;
+    u8 hdr[0x40];
+    int ok = 0;
+    u8* table = NULL;
+    char* sfm = NULL;
+
+    if (fread(hdr, 1, sizeof(hdr), fp) != sizeof(hdr) || rd_be32(hdr) != TRP_MAGIC) {
+        printf("[sceNpTrophy] %s: not a TRP (bad magic)\n", path);
+        goto out;
+    }
+    u64 fsize = rd_be64(hdr + 8);
+    u32 count = rd_be32(hdr + 0x10), esize = rd_be32(hdr + 0x14);
+    if (count == 0 || count > 4096 || esize < 0x30 || esize > 0x400) {
+        printf("[sceNpTrophy] %s: bad TRP entry table (%u x %u)\n", path, count, esize);
+        goto out;
+    }
+    table = (u8*)malloc((size_t)count * esize);
+    if (!table || fread(table, esize, count, fp) != count) {
+        printf("[sceNpTrophy] %s: short TRP entry table\n", path);
+        goto out;
+    }
+    /* TROP.SFM carries names + attributes; TROPCONF.SFM only the attributes. */
+    static const char* const want[] = { "TROP.SFM", "TROPCONF.SFM" };
+    for (size_t w = 0; w < 2 && !ok; w++) {
+        for (u32 i = 0; i < count; i++) {
+            const u8* e = table + (size_t)i * esize;
+            char name[33];
+            memcpy(name, e, 32); name[32] = '\0';
+            if (!ci_equal(name, want[w])) continue;
+            u64 off = rd_be64(e + 32), sz = rd_be64(e + 40);
+            if (sz == 0 || sz > (16u << 20) || (fsize && off + sz > fsize)) break;
+            sfm = (char*)malloc((size_t)sz + 1);
+            if (!sfm || fseek(fp, (long)off, SEEK_SET) != 0 || fread(sfm, 1, (size_t)sz, fp) != sz) break;
+            sfm[sz] = '\0';
+            memset(ctx->meta, 0, sizeof(ctx->meta));
+            for (u32 k = 0; k < SCE_NP_TROPHY_MAX_NUM_TROPHIES; k++) ctx->meta[k].pid = -1;
+            if (trophy_parse_sfm(ctx, sfm, (size_t)sz) > 0) ok = 1;
+            else printf("[sceNpTrophy] %s: %s has no <trophy> tags (encrypted?)\n", path, want[w]);
+            free(sfm); sfm = NULL;
+            break;
+        }
+    }
+    if (ok) {
+        fseek(fp, 0, SEEK_END);
+        long real = ftell(fp);
+        ctx->trp_size = real > 0 ? (u64)real : fsize;
+    }
+out:
+    free(sfm);
+    free(table);
+    fclose(fp);
+    return ok;
+}
+
+/* Find and read the title's TROPHY.TRP. Order: $PS3_TROPHY_TRP (a host file),
+ * <hdd0>/game/<title>/TROPDIR/<commId>/ (an installed update; <title> from
+ * $PS3_TITLE, else every game dir), <vfs root>/PS3_GAME/TROPDIR/<commId>/. */
+static void trophy_load_trp(TrophyContext* ctx)
+{
+    char path[1100], hdd0[512];
+    const char* cid = ctx->cid;
+    const char* env = getenv("PS3_TROPHY_TRP");
+    int ok = 0;
+
+    ctx->have_trp = 0;
+    ctx->platinum_id = -1;
+    ctx->total_trophies = SCE_NP_TROPHY_MAX_NUM_TROPHIES;
+    if (env && *env) {
+        snprintf(path, sizeof(path), "%s", env);
+        ok = trophy_try_trp(ctx, path);
+    }
+    trophy_hdd0_root(hdd0, sizeof(hdd0));
+    const char* title = getenv("PS3_TITLE");
+    if (!ok && title && *title) {
+        snprintf(path, sizeof(path), "%s/game/%s/TROPDIR/%s/TROPHY.TRP", hdd0, title, cid);
+        ok = is_file(path) && trophy_try_trp(ctx, path);
+    }
+    if (!ok) {
+        char gdir[600];
+        snprintf(gdir, sizeof(gdir), "%s/game", hdd0);
+        DIR* d = opendir(gdir);
+        if (d) {
+            struct dirent* de;
+            while (!ok && (de = readdir(d)) != NULL) {
+                if (de->d_name[0] == '.') continue;
+                snprintf(path, sizeof(path), "%s/%s/TROPDIR/%s/TROPHY.TRP", gdir, de->d_name, cid);
+                ok = is_file(path) && trophy_try_trp(ctx, path);
+            }
+            closedir(d);
+        }
+    }
+    if (!ok) {
+        snprintf(path, sizeof(path), "%s/PS3_GAME/TROPDIR/%s/TROPHY.TRP",
+                 (ppu_vfs_root && *ppu_vfs_root) ? ppu_vfs_root : ".", cid);
+        ok = trophy_try_trp(ctx, path);
+    }
+    if (!ok) {
+        memset(ctx->meta, 0, sizeof(ctx->meta));
+        for (u32 k = 0; k < SCE_NP_TROPHY_MAX_NUM_TROPHIES; k++) ctx->meta[k].pid = -1;
+        ctx->title[0] = ctx->title_detail[0] = '\0';
+        ctx->total_trophies = SCE_NP_TROPHY_MAX_NUM_TROPHIES;
+        ctx->trp_size = 0;
+        printf("[sceNpTrophy] no readable TROPHY.TRP for %s (hdd0 %s, vfs root %s): %u anonymous slots, no platinum\n",
+               cid, hdd0, ppu_vfs_root ? ppu_vfs_root : "(null)", ctx->total_trophies);
+        return;
+    }
+    ctx->have_trp = 1;
+    u32 n[5] = {0}, members = 0;
+    for (u32 i = 0; i < ctx->total_trophies; i++) {
+        n[ctx->meta[i].grade <= 4 ? ctx->meta[i].grade : 0]++;
+        if (ctx->meta[i].grade == SCE_NP_TROPHY_GRADE_PLATINUM && ctx->platinum_id < 0) ctx->platinum_id = (s32)i;
+    }
+    for (u32 i = 0; i < ctx->total_trophies; i++)
+        if (ctx->platinum_id >= 0 && ctx->meta[i].pid == ctx->platinum_id && (s32)i != ctx->platinum_id) members++;
+    printf("[sceNpTrophy] TRP %s: \"%s\", %u trophies (P%u G%u S%u B%u), platinum %d over %u trophies\n",
+           path, ctx->title, ctx->total_trophies, n[1], n[2], n[3], n[4], ctx->platinum_id, members);
