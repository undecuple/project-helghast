+static inline int64_t lv2s_deadline(uint64_t timeout_us)
+{
+    if (!timeout_us) return -1;
+    if (timeout_us > (1ull << 48)) timeout_us = 1ull << 48;
+    return lv2s_now_ns() + (int64_t)timeout_us * 1000;
