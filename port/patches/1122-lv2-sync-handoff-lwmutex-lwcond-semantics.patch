+static inline int lv2s_sleep(lv2s_mutex* m, int64_t deadline_ns)
+{
+    int64_t rem = -1;
+    if (deadline_ns >= 0) { rem = deadline_ns - lv2s_now_ns(); if (rem <= 0) return 0; }
+    if (rem < 0 && lv2s_watch()) rem = 5000000000ll;   /* MUTEX_WATCH: 5 s slices */
