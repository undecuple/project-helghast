+typedef struct lv2s_mutex {
+#ifdef _WIN32
+    SRWLOCK lock; CONDITION_VARIABLE cv;
+#else
+    pthread_mutex_t lock; pthread_cond_t cv;
+#endif
+    int inited;
+    uint32_t owner;          /* thread id, 0 = free */
+    uint32_t count;          /* recursion count while owned */
+    int recursive;
+    lv2s_queue q;            /* threads asleep in lock (or handed over from a condition) */
