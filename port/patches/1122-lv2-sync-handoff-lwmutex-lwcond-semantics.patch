+/* Signal (host lock held): the oldest waiter (all = 0, to_tid = 0), every waiter queued now (all), or the named
+ * thread if queued, else the oldest (to_tid, KZ3 patch 1059's choice). Returns how many were moved to the mutex. */
+static inline int lv2s_cond_signal_locked(lv2s_mutex* m, lv2s_queue* cq, int all, uint32_t to_tid)
