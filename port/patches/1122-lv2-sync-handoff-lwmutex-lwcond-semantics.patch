+/* Wait on condition queue `cq` bound to `m` (host lock held; the caller must own m: else EPERM). Drops m entirely,
+ * sleeps until signalled (then owns m again, handed over) or the timeout (then takes m back; ETIMEDOUT). */
+static inline uint32_t lv2s_cond_wait_locked(lv2s_mutex* m, lv2s_queue* cq, uint32_t tid, uint64_t timeout_us)
+{
