+/* Lock (host lock held). Returns 0, EDEADLK (non-recursive re-lock) or ETIMEDOUT. */
+static inline uint32_t lv2s_lock_locked(lv2s_mutex* m, uint32_t tid, uint64_t timeout_us)
+{
