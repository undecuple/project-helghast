+static inline void lv2s_init(lv2s_mutex* m)
+{
+    if (m->inited) return;
+#ifdef _WIN32
+    InitializeSRWLock(&m->lock); InitializeConditionVariable(&m->cv);
+#else
+    pthread_condattr_t ca; pthread_condattr_init(&ca);
