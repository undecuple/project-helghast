+    struct lv2s_waiter* next;
+    uint32_t tid;
+    uint32_t depth;          /* recursion count to own the mutex with */
+    volatile int state;      /* LV2S_ON_COND / ON_MUTEX / OWNED */
+} lv2s_waiter;
