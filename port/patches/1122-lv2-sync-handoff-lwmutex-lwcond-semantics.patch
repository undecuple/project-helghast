+/* lv2-style mutex + condition core shared by sys_mutex/sys_cond (runtime/syscalls) and the HLE sys_lwmutex/sys_lwcond
+ * (runtime/ppu/ppu_sysprx.cpp). KZ3 patch 1122 (upstream candidate). Idea credit: the Ratchet & Clank port
+ * (their patch 7007, lv2 hand-off for sys_mutex/sys_cond); semantics per lv2 as RPCS3 models it (read, no code copied).
+ *
+ * The mutex is an owner thread id, a recursion count and a FIFO queue of sleeping waiters, under one host lock:
+ *  - unlock with a waiter queued hands the mutex to the oldest waiter (owner and count set by the unlocker), so a
+ *    thread that tries the lock in between gets EBUSY: lv2 never lets a barging thread take a mutex that has sleepers;
+ *  - a condition bound to the mutex keeps its own FIFO of waiters under the same host lock. A signal moves the chosen
+ *    waiters to the mutex: the mutex is free -> the first one owns it as the signal returns (lwcond mode 3), else they
+ *    queue on the mutex and are handed it at the holder's unlock (sys_cond_signal, lwcond mode 1). The woken thread
+ *    never re-locks the mutex itself, so no third thread can take it in a gap (the Ratchet & Clank port's level-load stall);
+ *  - a condition wait that times out leaves the condition queue and takes the mutex back the same way, restoring its
+ *    recursion depth, and returns ETIMEDOUT.
+ * All waiters sleep on one host condition variable per mutex and look at their own node's state, so spurious host
+ * wakeups never return to the guest. MUTEX_WATCH=1 (idea from upstream PR #474 by erikomis): an infinite wait sleeps
+ * in 5 s slices and prints who it is waiting on, so a guest deadlock names its threads. Platform-neutral (Windows
+ * SRWLOCK/CONDITION_VARIABLE, POSIX pthreads) so host tests build it anywhere. */
+#ifndef LV2_SYNC_CORE_H
+#define LV2_SYNC_CORE_H
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#else
+#include <pthread.h>
+#include <time.h>
+#include <errno.h>
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define LV2S_EDEADLK   0x80010008u
+#define LV2S_EPERM     0x80010009u
+#define LV2S_EBUSY     0x8001000Au
+#define LV2S_ETIMEDOUT 0x8001000Bu
+
+enum { LV2S_ON_COND = 1, LV2S_ON_MUTEX = 2, LV2S_OWNED = 3 };
+
+typedef struct lv2s_waiter {
+    struct lv2s_waiter* next;
+    uint32_t tid;
+    uint32_t depth;          /* recursion count to own the mutex with */
+    volatile int state;      /* LV2S_ON_COND / ON_MUTEX / OWNED */
