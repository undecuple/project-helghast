+static inline uint32_t lv2s_trylock_locked(lv2s_mutex* m, uint32_t tid)
+{
+    if (!m->owner && !m->q.head) { lv2s_set_owner(m, tid, 1); return 0; }
+    if (m->owner == tid) {
