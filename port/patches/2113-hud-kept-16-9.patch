+/* KZ3 patch 2113 (RSX pass 106; ENHANCEMENT, display): the 2D layer (HUD, menus, subtitles, movies) kept 16:9 and
+ * centred at any window aspect while the 3D view follows the window (patch 2096).
+ *
+ * The guest draws everything into its 1280x720 display buffer and the present stretches that buffer over the whole
+ * client (KZ3_ASPECT=screen, Image scaling Stretch). The 3D picture was rendered for the client's aspect, so it comes
+ * out right; the 2D drawn after it would be stretched with it. The draws classified 2D (rsx_live_draw.c, sink_end_impl)
+ * get their viewport epilogue squeezed about the buffer centre so that, after the stretch, they cover a centred 16:9
+ * box: above 16:9 x by kx = (16/9)/aspect, below 16:9 y by ky = aspect/(16/9). Their scissors are mapped the same way.
+ * The menu mouse (patch 2098) maps a buffer pixel back through the inverse for the GUM hit test only.
+ * Design and the draw capture it rests on: the RE notes "Pass 159" and "Pass 162".
+ *
+ * Pure helpers here (host test tools/smoke/test_hud169.c); state and classification in rsx_live_draw.c. */
+#ifndef RSX_HUD169_H
+#define RSX_HUD169_H
+
+#include <math.h>
+
+/* Factors for a client of w x h pixels: 1 when the squeeze is active (some factor differs from 1 by >= 1e-3). */
+static inline int rsx_h169_factors(unsigned w, unsigned h, float* kx, float* ky)
+{
+    *kx = 1.0f; *ky = 1.0f;
+    if (!w || !h) return 0;
+    const double a = (double)w / (double)h, r = a / (16.0 / 9.0);
+    if (r > 1.0) *kx = (float)(1.0 / r);
+    else         *ky = (float)r;
+    if (fabsf(*kx - 1.0f) < 1e-3f) *kx = 1.0f;
+    if (fabsf(*ky - 1.0f) < 1e-3f) *ky = 1.0f;
+    return *kx != 1.0f || *ky != 1.0f;
+}
+
+/* The host viewport epilogue xf[0..7] = {sx, sy, sz, 0, tx, ty, tz, 0} (NDC = clip * xf[0..2] + w * xf[4..6]): the
+ * buffer centre is NDC 0, so scaling both scale and offset squeezes about the centre. */
+static inline void rsx_h169_xf(float xf[8], float kx, float ky)
+{
+    xf[0] *= kx; xf[4] *= kx;
+    xf[1] *= ky; xf[5] *= ky;
+}
+
+/* One scissor edge pair [a0, a1) in guest pixels of an extent of n pixels, mapped about n/2 by k: the left/top edge
+ * floored, the right/bottom edge ceiled (never loses a covered pixel), the input first clamped to [0, n] so "no
+ * scissor" becomes the squeezed box. */
+static inline void rsx_h169_span(long a0, long a1, long n, float k, long* o0, long* o1)
+{
+    if (a0 < 0) a0 = 0;
+    if (a1 > n) a1 = n;
+    if (a1 < a0) a1 = a0;
+    const double c = (double)n * 0.5;
+    /* 1e-4 px of slack: a float k (0.9f is 0.89999998) must not push an exact edge to the next pixel */
+    *o0 = (long)floor(c + ((double)a0 - c) * (double)k + 1e-4);
+    *o1 = (long)ceil(c + ((double)a1 - c) * (double)k - 1e-4);
+    if (a1 == a0) *o1 = *o0;   /* an empty scissor stays empty */
+}
+
+/* The scissor rectangle {left, top, right, bottom} in guest pixels of a wv x hv viewport, mapped in place. */
+static inline void rsx_h169_scissor(long r[4], long wv, long hv, float kx, float ky)
+{
+    long a, b;
+    rsx_h169_span(r[0], r[2], wv, kx, &a, &b); r[0] = a; r[2] = b;
+    rsx_h169_span(r[1], r[3], hv, ky, &a, &b); r[1] = a; r[3] = b;
+}
+
+/* A buffer pixel (bx, by) of a wv x hv buffer -> the guest UI pixel the squeezed 2D layer shows there. 0 = in a bar
+ * (outside the 16:9 box): no hit. */
+static inline int rsx_h169_ui_point(float bx, float by, float wv, float hv, float kx, float ky, float* gx, float* gy)
+{
+    const float cx = wv * 0.5f, cy = hv * 0.5f;
+    *gx = cx + (bx - cx) / kx;
+    *gy = cy + (by - cy) / ky;
+    return *gx >= 0.0f && *gy >= 0.0f && *gx < wv && *gy < hv;
+}
+
+#endif /* RSX_HUD169_H */
