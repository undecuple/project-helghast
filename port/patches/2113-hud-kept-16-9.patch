+/* patch 2113: KZ3_HUD_169 (=0 off, else on; one run) over display.ini hud_169 (rsx_live_draw_set_hud169; default on).
+ * Active only while the present stretches the buffer to a client that is not 16:9: KZ3_ASPECT=screen and Stretch now
+ * (Fit already letterboxes the whole frame; KZ3_ASPECT=16:9 keeps the PS3 picture). */
+static volatile LONG g_h169_cfg = 1;
+void rsx_live_draw_set_hud169(int on) { InterlockedExchange(&g_h169_cfg, on ? 1 : 0); }
+static int ld_h169_on(void)
+{
+    static int env = -2;
+    if (env == -2) {
+        const char* e = getenv("KZ3_HUD_169");
+        env = (e && *e) ? (e[0] == '0' ? 0 : 1) : -1;
+        fprintf(stderr, "[hud169] 2D layer kept 16:9: %s (%s)\n", (env >= 0 ? env : (int)g_h169_cfg) ? "on" : "off",
+                env >= 0 ? "KZ3_HUD_169" : "display.ini hud_169");
+        fflush(stderr);
+    }
+    return env >= 0 ? env : (int)g_h169_cfg;
+}
+static int ld_h169_factors(float* kx, float* ky)
+{
+    *kx = 1.0f; *ky = 1.0f;
+    if (!ld_h169_on() || rsx_display_get_aspect() != RSX_DM_ASPECT_SCREEN || ld_dm_scaling_now() != RSX_DM_STRETCH)
+        return 0;
+    return rsx_h169_factors(g_dm_bb_w, g_dm_bb_h, kx, ky);
+}
+/* For the menu mouse (rsx_null_backend.c rsx_display_client_to_ui): the factors the 2D draws get now. */
