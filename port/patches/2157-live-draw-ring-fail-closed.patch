+/* Patch 2157: the fence rsx_rm_acquire(m, end) would return, without retiring any mark. The caller retires with
+ * rsx_rm_acquire only after waiting for it succeeded. */
+static inline uint64_t rsx_rm_peek(const rsx_ring_marks* m, uint64_t end)
+{
+    uint64_t f = 0;
+    for (uint32_t i = 0; i < m->old_n; i++)
+        if (m->old[i].start < end && m->old[i].fence > f) f = m->old[i].fence;
+    return f;
+}
