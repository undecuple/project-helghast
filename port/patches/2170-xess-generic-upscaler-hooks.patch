+static u32 ld_up_filter_with_bias(u32 filter, int32_t bias_fp)
+{
+    int32_t bias = (int32_t)(filter & 0x1FFFu);
+    if (bias & 0x1000) bias -= 0x2000;
+    bias += bias_fp;
+    if (bias < -0x1000) bias = -0x1000;
+    if (bias > 0x0FFF) bias = 0x0FFF;
+    return (filter & ~0x1FFFu) | ((u32)bias & 0x1FFFu);
+}
+static void ld_up_bias_samplers(
+    u32 texture_mask, u32* smp_slots, int32_t bias_fp)
+{
+    if (!bias_fp) return;
+    for (u32 u = 0; u < SMP_TABLE_SIZE; u++) {
+        if (!((texture_mask >> u) & 1u)) continue;
+        rsx_dsp_texture texture;
+        rsx_dsp_get_texture(&g.rsx, u, &texture);
+        const u32 min_filter = (texture.filter >> 16) & 0x7u;
+        if (min_filter < 3u || min_filter > 6u) continue;
+        texture.filter =
+            ld_up_filter_with_bias(texture.filter, bias_fp);
+        u32 key[4];
+        sampler_key(&texture, key);
+        const u32 slot = sampler_slot(&texture, key);
+        if (slot != SMP_DEFAULT) smp_slots[u] = slot;
+    }
 }
