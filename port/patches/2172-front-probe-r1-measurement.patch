+/* one line per interval of the sampled flip: ev W/B/F, draws, reports (first..last draw ordinal), MB, ms */
+static inline int rsx_fp_iv_line(const rsx_fp* p, uint32_t i, char* out, size_t n)
+{
+    if (i >= p->n_sv) return 0;
+    const rsx_fp_ivs* s = &p->sv[i];
+    snprintf(out, n, "[front-probe] iv %u %c draws %u reports %u (draw %u..%u) tex %.2f MB vtx %.2f MB idx %.2f MB | F %.2f R %.2f drain %.2f T %.2f ms",
