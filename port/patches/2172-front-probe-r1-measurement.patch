+static inline rsx_fp_gates rsx_fp_gate(const rsx_fp_w* w)
+{
+    rsx_fp_gates g; memset(&g, 0, sizeof g);
+    const double tf = w->tflips ? (double)w->tflips : 1.0, af = w->c.flips ? (double)w->c.flips : 1.0;
