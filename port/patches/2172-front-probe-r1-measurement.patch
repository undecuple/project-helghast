+        " zpass reports %.1f (dflt %.1f never %.1f noval %.1f val %.1f) lag-state %llu lag-val %llu |"
+        " cross-draws %.1f in %.1f ivs, pubs %.1f | gates T>35.2ms %d front+snap>=22ms %d report-lag>0 %d tex>10MB %d",
