@@ -0,0 +1,565 @@
+/* KZ3 patch 2172 (renderer step 1, round R1): LD_FRONT_PROBE=1 measurement unit. GPU-free, host-tested
+ * (tools/smoke/test_front_probe.sh). Nothing here moves work to another thread: it counts what a front/recorder split
+ * would have to snapshot, wait for and answer, and models its cost.
+ *
+ * Callers (hook sites are listed in the RE notes "Pass 159"): the walker thread for everything except
+ * rsx_fp_note_write (any thread, atomics only) and rsx_fp_pub_note (any thread, atomics only). The instance is calloc'ed.
+ *
+ * WRITE GENERATIONS (a counter-only model, no copies). rsx_fp_note_write bumps a global epoch and stamps every 4 KB page
+ * of the range with it (location 0/1, offsets alias modulo 256 MB). A span's generation is the largest stamp of its pages.
+ * A TEX span "moved" when its generation is newer than the epoch at its last would-be snapshot, or it has none: every
+ * bound span whose generation moved counts, never "once per frame". A bump is counted once, not per draw.
+ *
+ * INTERVALS. A hard interval ends at a would-be hard wait: SYNC_WB (every NV0039 write-back call), SYNC_BGS only when
+ * drawn_since_wb is set, FLIP. drawn_since_wb is set by rsx_fp_draw_rt when the draw's RT registers name a
+ * main-memory colour or depth surface and cleared after a SYNC_BGS/SYNC_WB/FLIP. A SYNC_BGS with the bit clear is an
+ * ordering record only (bgs_ord); bgs_missed counts a clear bit while the recorder's own test found dirty surfaces
+ * (the bit would not have been conservative).
+ *
+ * TIME MODEL: T = sum over intervals of max(front_i + snap_i, rec_i) + drain_i.
+ *   front_raw = wall - draw time - sync time - probe time (the walker's non-draw time, incl. one decode pass);
+ *   snap      = snapshot bytes * measured memcpy ns/B + index bytes * measured scan ns/B (rates from one sampled flip);
+ *   rec       = draw time + sync time + the previous present + dec (second decode pass per draw, from the sampled flip);
+ *   drain_i   = how far a one-recorder queue simulation (draws handed over one by one) ends after max(front+snap, rec),
+ *               plus the sync, i.e. the recorder tail the front still waits for at the wait. MODEL, not measured: today
+ *               recorder == walker, so no drain exists in a run. Rates are 0 until the first sampled flip has closed.
+ */
+#ifndef RSX_FRONT_PROBE_H
+#define RSX_FRONT_PROBE_H
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef RSX_FP_CLOCK
+#  ifdef _WIN32
+#    include <windows.h>
+static inline uint64_t rsx_fp_clock_ns(void)
+{
+    static LARGE_INTEGER f; LARGE_INTEGER n;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&n);
+    return (uint64_t)((double)n.QuadPart * 1e9 / (double)f.QuadPart);
+}
+#  else
+#    include <time.h>
+static inline uint64_t rsx_fp_clock_ns(void)
+{
+    struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t);
+    return (uint64_t)t.tv_sec * 1000000000ull + (uint64_t)t.tv_nsec;
+}
+#  endif
+#  define RSX_FP_CLOCK() rsx_fp_clock_ns()
+#endif
+
+/* gate thresholds (a 41.4 ms walk on Frozen Shores) */
+#define RSX_FP_T_GATE_NS       35200000ull       /* 0.85 x 41.4 ms */
+#define RSX_FP_FRONT_GATE_NS   22000000ull
+#define RSX_FP_TEX_GATE_BYTES  (10ull << 20)     /* 10 MiB per flip (ASSUMPTION: MB = MiB) */
+
+enum { RSX_FP_PAGE_SHIFT = 12, RSX_FP_PAGES = 1u << 20, RSX_FP_TAB = 8192, RSX_FP_FPT = 512, RSX_FP_MAXD = 16384,
+       RSX_FP_MAXIV = 48, RSX_FP_SLOTS = 1024, RSX_FP_D2_MAX = 4u << 20, RSX_FP_SCRATCH_MAX = 64u << 20 };
+enum { RSX_FP_EV_WB = 0, RSX_FP_EV_BGS, RSX_FP_EV_FLIP, RSX_FP_EV_N };
+enum { RSX_FP_RC_DFLT = 0, RSX_FP_RC_NEVER, RSX_FP_RC_NOVAL, RSX_FP_RC_VAL };   /* report classes */
+
+typedef struct {
+    uint64_t draws, inl, vtx_unk;                                     /* draws; inline draws (no guest read); draws whose vertex spans are unknown */
+    uint64_t tex_b, tex_n, texb_b, texb_n, tex_surf;                  /* TEX snapshot bytes/spans (moved), bound bytes/spans, GPU-surface binds skipped */
+    uint64_t vtx_b, idx_b, fp_b, fp_miss, fp_n;                       /* vertex span bytes, index bytes, FP bytes copied, FP misses, FP draws */
+    uint64_t rep, rep_dflt, rep_never, rep_noval, rep_val;            /* main-memory ZPASS GET_REPORT by class */
+    uint64_t rep_lag_state, rep_lag_val;                              /* the mirror model: state / has_val differ from a mirror published at the last hard point */
+    uint64_t wb, bgs_hard, bgs_ord, bgs_missed, flips;                /* waits */
+    uint64_t ivs, cross_d, cross_iv, pubs;                            /* intervals; draws before an async ref publication in their interval */
+} rsx_fp_c;
+
+typedef struct {
+    uint32_t ev, draws, rep, rep_first, rep_last;                     /* positions are draw ordinals in the interval */
+    uint64_t tex_b, vtx_b, idx_b, F_ns, R_ns, drain_ns, T_ns;
+} rsx_fp_ivs;
+
+typedef struct { uint32_t f_ns, rec_ns, snap_b, idx_b; } rsx_fp_dr;
+
+typedef struct {
+    rsx_fp_c c;
+    uint64_t T_ns, F_ns, R_ns, drain_ns, wall_ns, drain_k[RSX_FP_EV_N], n_k[RSX_FP_EV_N], tflips;
+    uint64_t tflips_over;                                              /* flips with T above the gate */
+} rsx_fp_w;
+
+typedef struct rsx_fp {
+    uint32_t every, flips_total, win_flips, sampling, sample_flip, rates_known, d2_known, win_no;
+    /* write generations */
+    uint32_t epoch;
+    uint32_t stamp[2][RSX_FP_PAGES];                                   /* 1M pages of 4 KiB = the whole 32-bit offset space: exact, no aliasing */
+    /* span table (texture spans) and fragment-program table: open addressing, power-of-two capacity, grown (rehash) at 50 % load,
+     * allocated at init, touched only by the walker thread (rsx_fp_snap_tex / rsx_fp_snap_fp); other threads only stamp[] */
+    struct rsx_fp_tab_e { uint32_t loc, off, len, snap_epoch, flip_mark, used; } *tab; uint32_t tab_cap, tab_n;
+    struct rsx_fp_fpt_e { uint32_t loc, off, len, used; uint64_t h; } *fpt; uint32_t fpt_cap, fpt_n;
+    uint64_t tab_full, fpt_full;                                       /* overflow counters (stay 0 unless an allocation failed, or RSX_FP_NOGROW) */
+    uint64_t slot_over;                                                /* report slot index >= RSX_FP_SLOTS (dropped from the lag model) */
+    uint64_t tab_grows, fpt_grows;
+    /* interval */
+    uint64_t t_start, probe_total, probe0, pres_t0, carry_ns, draw_t0, draw_probe0, draw_f_ns;
+    uint32_t drawn_since_wb, in_draw, cur_snap_b, cur_idx_b;
+    rsx_fp_c iv;                                                       /* current interval counters */
+    uint64_t iv_rec_ns, iv_sync_ns;
+    uint32_t iv_rep_first, iv_rep_last, iv_pub0;
+    uint64_t iv_draw0;
+    rsx_fp_dr* dr; uint32_t n_dr, dr_cap; uint64_t dr_over;     /* dr grows (walker only); dr_over counts only a failed allocation */
+    uint64_t draws_total;                                              /* walker writes, pub_note reads (atomics) */
+    uint64_t pub_count, pub_draw_mark;                                 /* any thread (atomics) */
+    uint64_t pub_seen_iv;
+    void (*hard_cb)(void*); void* hard_ctx;
+    /* mirror model */
+    uint32_t pub_off[RSX_FP_SLOTS]; uint8_t pub_state[RSX_FP_SLOTS], pub_hv[RSX_FP_SLOTS];
+    /* flip / window / total */
+    rsx_fp_c fl_c; uint64_t fl_T, fl_F, fl_R, fl_drain, fl_wall, fl_drain_k[RSX_FP_EV_N], fl_n_k[RSX_FP_EV_N];
+    rsx_fp_w win, tot;
+    rsx_fp_ivs sv[RSX_FP_MAXIV]; uint32_t n_sv, sv_cap_hit;
+    /* sampled costs and the rates they give */
+    uint64_t samp_cp_ns, samp_cp_b, samp_scan_ns, samp_scan_b, samp_d2_ns, samp_d2_words, samp_d2_draws, samp_flip_draws;
+    double copy_rate, scan_rate, dec_per_draw;                         /* ns per byte / ns per byte / ns per draw */
+    uint8_t* scratch; uint32_t scratch_cap;
+    uint32_t* d2; uint32_t d2_n; uint64_t d2_over;
+    uint64_t n_scratch_skip;
+    uint64_t last_samp_cp_ns, last_samp_cp_b;
+} rsx_fp;
+
+/* ---- lifecycle / flags ---- */
+static inline rsx_fp* rsx_fp_new(uint32_t every, uint64_t now)
+{
+    rsx_fp* p = (rsx_fp*)calloc(1, sizeof *p);
+    if (!p) return NULL;
+    p->every = every ? every : 100u;
+    p->sampling = 1; p->t_start = now;
+    p->dr_cap = RSX_FP_MAXD;
+    p->dr = (rsx_fp_dr*)calloc(p->dr_cap, sizeof(rsx_fp_dr));
+    p->tab_cap = RSX_FP_TAB; p->fpt_cap = RSX_FP_FPT;
+    p->tab = (struct rsx_fp_tab_e*)calloc(p->tab_cap, sizeof *p->tab);
+    p->fpt = (struct rsx_fp_fpt_e*)calloc(p->fpt_cap, sizeof *p->fpt);
+    if (!p->dr || !p->tab || !p->fpt) { free(p->dr); free(p->tab); free(p->fpt); free(p); return NULL; }
+    return p;
+}
+static inline void rsx_fp_free(rsx_fp* p) { if (!p) return; free(p->dr); free(p->tab); free(p->fpt); free(p->scratch); free(p->d2); free(p); }
+static inline int rsx_fp_sampling(const rsx_fp* p) { return p ? (int)p->sampling : 0; }
+static inline void rsx_fp_set_hard_cb(rsx_fp* p, void (*cb)(void*), void* ctx) { p->hard_cb = cb; p->hard_ctx = ctx; }
+static inline void rsx_fp_probe_add(rsx_fp* p, uint64_t ns) { p->probe_total += ns; }
+
+/* ---- write generations (any thread) ---- */
+static inline void rsx_fp_note_write(rsx_fp* p, uint32_t loc, uint32_t off, uint32_t len)
+{
+    if (loc > 1u || !len) return;
+    const uint32_t e = __atomic_add_fetch(&p->epoch, 1u, __ATOMIC_RELAXED);
+    const uint64_t last = (uint64_t)off + len - 1u;
+    uint32_t p0 = off >> RSX_FP_PAGE_SHIFT, p1 = (uint32_t)((last > 0xFFFFFFFFull ? 0xFFFFFFFFull : last) >> RSX_FP_PAGE_SHIFT);
+    for (uint32_t q = p0;; q++) {
+        __atomic_store_n(&p->stamp[loc][q], e, __ATOMIC_RELAXED);
+        if (q == p1) break;
+    }
+}
+static inline uint32_t rsx_fp_span_gen(const rsx_fp* p, uint32_t loc, uint32_t off, uint32_t len)
+{
+    if (loc > 1u || !len) return 0;
+    const uint64_t last = (uint64_t)off + len - 1u;
+    uint32_t p0 = off >> RSX_FP_PAGE_SHIFT, p1 = (uint32_t)((last > 0xFFFFFFFFull ? 0xFFFFFFFFull : last) >> RSX_FP_PAGE_SHIFT), g = 0;
+    for (uint32_t q = p0;; q++) {
+        const uint32_t s = __atomic_load_n(&p->stamp[loc][q], __ATOMIC_RELAXED);
+        if (s > g) g = s;
+        if (q == p1) break;
+    }
+    return g;
+}
+
+static inline uint64_t rsx_fp_fnv(const uint8_t* b, uint32_t n)
+{
+    uint64_t h = 1469598103934665603ull;
+    for (uint32_t i = 0; i < n; i++) { h ^= b[i]; h *= 1099511628211ull; }
+    return h;
+}
+
+/* ---- sampled copies (only on the sampled flip; bytes may be NULL) ---- */
+static inline void rsx_fp_sample_copy(rsx_fp* p, const uint8_t* bytes, uint32_t len)
+{
+    if (!p->sampling || !bytes || !len) return;
+    if (len > RSX_FP_SCRATCH_MAX) { p->n_scratch_skip++; return; }
+    if (len > p->scratch_cap) {
+        free(p->scratch); p->scratch = (uint8_t*)malloc(len); p->scratch_cap = p->scratch ? len : 0;
+        if (!p->scratch) { p->n_scratch_skip++; return; }
+    }
+    const uint64_t t0 = RSX_FP_CLOCK();
+    memcpy(p->scratch, bytes, len);
+    __asm__ volatile("" : : "r"(p->scratch) : "memory");
+    const uint64_t dt = RSX_FP_CLOCK() - t0;
+    p->samp_cp_ns += dt; p->samp_cp_b += len;   /* the caller's hook time (rsx_fp_probe_add) already holds dt */
+}
+/* the front's index scan: min/max of the (big-endian) indices of the span, timed */
+static inline uint32_t rsx_fp_sample_scan(rsx_fp* p, const uint8_t* bytes, uint32_t len, uint32_t esz)
+{
+    if (!p->sampling || !bytes || !len || (esz != 2 && esz != 4)) return 0;
+    const uint64_t t0 = RSX_FP_CLOCK();
+    uint32_t lo = 0xFFFFFFFFu, hi = 0;
+    for (uint32_t i = 0; i + esz <= len; i += esz) {
+        const uint32_t v = esz == 2 ? ((uint32_t)bytes[i] << 8 | bytes[i + 1])
+                                    : ((uint32_t)bytes[i] << 24 | (uint32_t)bytes[i + 1] << 16 | (uint32_t)bytes[i + 2] << 8 | bytes[i + 3]);
+        if (v < lo) lo = v;
+        if (v > hi) hi = v;
+    }
+    __asm__ volatile("" : : "r"(lo), "r"(hi));
+    const uint64_t dt = RSX_FP_CLOCK() - t0;
+    p->samp_scan_ns += dt; p->samp_scan_b += len;
+    return hi - lo;
+}
+
+/* ---- open-addressed tables (walker thread only; power-of-two capacity, linear probing, grown at 50 % load) ---- */
+static inline uint32_t rsx_fp_hash3(uint32_t loc, uint32_t off, uint32_t len)
+{
+    uint64_t x = ((uint64_t)off << 32 | len) * 0x9E3779B97F4A7C15ull ^ (uint64_t)loc * 0xC2B2AE3D27D4EB4Full;
+    x ^= x >> 29; x *= 0xBF58476D1CE4E5B9ull; x ^= x >> 32;
+    return (uint32_t)x;
+}
+static inline struct rsx_fp_tab_e* rsx_fp_tab_find(rsx_fp* p, uint32_t loc, uint32_t off, uint32_t len)
+{
+    for (uint32_t k = 0, h = rsx_fp_hash3(loc, off, len) & (p->tab_cap - 1u); k < p->tab_cap; k++, h = (h + 1u) & (p->tab_cap - 1u)) {
+        struct rsx_fp_tab_e* e = &p->tab[h];
+        if (!e->used) return NULL;
+        if (e->loc == loc && e->off == off && e->len == len) return e;
+    }
+    return NULL;
+}
+static inline struct rsx_fp_tab_e* rsx_fp_tab_insert(rsx_fp* p, uint32_t loc, uint32_t off, uint32_t len)
+{
+    if ((p->tab_n + 1u) * 2u > p->tab_cap) {
+#ifdef RSX_FP_NOGROW
+        return NULL;                                                     /* negative control: the old fixed table (it was full at 100 %) */
+#else
+        const uint32_t nc = p->tab_cap * 2u;
+        struct rsx_fp_tab_e* nt = (struct rsx_fp_tab_e*)calloc(nc, sizeof *nt);
+        if (!nt) return NULL;
+        for (uint32_t i = 0; i < p->tab_cap; i++) if (p->tab[i].used) {
+            uint32_t h = rsx_fp_hash3(p->tab[i].loc, p->tab[i].off, p->tab[i].len) & (nc - 1u);
+            while (nt[h].used) h = (h + 1u) & (nc - 1u);
+            nt[h] = p->tab[i];
+        }
+        free(p->tab); p->tab = nt; p->tab_cap = nc; p->tab_grows++;
+#endif
+    }
+    uint32_t h = rsx_fp_hash3(loc, off, len) & (p->tab_cap - 1u);
+    while (p->tab[h].used) h = (h + 1u) & (p->tab_cap - 1u);
+    struct rsx_fp_tab_e* e = &p->tab[h];
+    e->used = 1; e->loc = loc; e->off = off; e->len = len; e->snap_epoch = 0; e->flip_mark = 0xFFFFFFFFu;
+    p->tab_n++;
+    return e;
+}
+static inline struct rsx_fp_fpt_e* rsx_fp_fpt_find(rsx_fp* p, uint32_t loc, uint32_t off)
+{
+    for (uint32_t k = 0, h = rsx_fp_hash3(loc, off, 0) & (p->fpt_cap - 1u); k < p->fpt_cap; k++, h = (h + 1u) & (p->fpt_cap - 1u)) {
+        struct rsx_fp_fpt_e* e = &p->fpt[h];
+        if (!e->used) return NULL;
+        if (e->loc == loc && e->off == off) return e;
+    }
+    return NULL;
+}
+static inline struct rsx_fp_fpt_e* rsx_fp_fpt_insert(rsx_fp* p, uint32_t loc, uint32_t off)
+{
+    if ((p->fpt_n + 1u) * 2u > p->fpt_cap) {
+#ifdef RSX_FP_NOGROW
+        return NULL;
+#else
+        const uint32_t nc = p->fpt_cap * 2u;
+        struct rsx_fp_fpt_e* nt = (struct rsx_fp_fpt_e*)calloc(nc, sizeof *nt);
+        if (!nt) return NULL;
+        for (uint32_t i = 0; i < p->fpt_cap; i++) if (p->fpt[i].used) {
+            uint32_t h = rsx_fp_hash3(p->fpt[i].loc, p->fpt[i].off, 0) & (nc - 1u);
+            while (nt[h].used) h = (h + 1u) & (nc - 1u);
+            nt[h] = p->fpt[i];
+        }
+        free(p->fpt); p->fpt = nt; p->fpt_cap = nc; p->fpt_grows++;
+#endif
+    }
+    uint32_t h = rsx_fp_hash3(loc, off, 0) & (p->fpt_cap - 1u);
+    while (p->fpt[h].used) h = (h + 1u) & (p->fpt_cap - 1u);
+    struct rsx_fp_fpt_e* e = &p->fpt[h];
+    e->used = 1; e->loc = loc; e->off = off; e->len = 0; e->h = 0;
+    p->fpt_n++;
+    return e;
+}
+
+/* ---- snapshot accounting (walker, between draw_begin and draw_end) ---- */
+static inline void rsx_fp_snap_tex(rsx_fp* p, uint32_t loc, uint32_t off, uint32_t len, const uint8_t* bytes)
+{
+    if (!len) return;
+    p->iv.texb_b += len; p->iv.texb_n++;
+    const uint32_t gen = rsx_fp_span_gen(p, loc, off, len);
+    const uint32_t cur_epoch = __atomic_load_n(&p->epoch, __ATOMIC_RELAXED);
+    int moved = 1;
+    struct rsx_fp_tab_e* e = rsx_fp_tab_find(p, loc, off, len);          /* walker thread only */
+    if (!e) {
+        e = rsx_fp_tab_insert(p, loc, off, len);                         /* first sight counts as moved: a first snapshot must copy */
+        if (!e) p->tab_full++;                                           /* only an allocation failure (or RSX_FP_NOGROW): counted as moved, never stored */
+    } else moved = gen > e->snap_epoch;
+    if (e && moved) e->snap_epoch = cur_epoch;
+    if (!moved) return;
+    p->iv.tex_b += len; p->cur_snap_b += len;
+    if (!e || e->flip_mark != p->flips_total) { p->iv.tex_n++; if (e) e->flip_mark = p->flips_total; }
+    rsx_fp_sample_copy(p, bytes, len);
+}
+static inline void rsx_fp_snap_tex_surface(rsx_fp* p) { p->iv.tex_surf++; }
+static inline void rsx_fp_snap_vtx(rsx_fp* p, uint32_t len, const uint8_t* bytes)
+{ p->iv.vtx_b += len; p->cur_snap_b += len; rsx_fp_sample_copy(p, bytes, len); }
+static inline void rsx_fp_snap_idx(rsx_fp* p, uint32_t len, uint32_t esz, const uint8_t* bytes)
+{ p->iv.idx_b += len; p->cur_snap_b += len; p->cur_idx_b += len; rsx_fp_sample_copy(p, bytes, len); rsx_fp_sample_scan(p, bytes, len, esz); }
+static inline void rsx_fp_snap_fp(rsx_fp* p, uint32_t loc, uint32_t off, uint32_t len, const uint8_t* bytes)
+{
+    if (!len || !bytes) return;
+    p->iv.fp_n++;
+    const uint64_t h = rsx_fp_fnv(bytes, len);
+    int miss = 1;
+    struct rsx_fp_fpt_e* e = rsx_fp_fpt_find(p, loc, off);               /* walker thread only */
+    if (!e) {
+        e = rsx_fp_fpt_insert(p, loc, off);                              /* first sight: a miss (the first copy) */
+        if (!e) p->fpt_full++;
+    } else miss = !(e->len == len && e->h == h);
+    if (e) { e->len = len; e->h = h; }
+    if (miss) { p->iv.fp_miss++; p->iv.fp_b += len; p->cur_snap_b += len; rsx_fp_sample_copy(p, bytes, len); }
+}
+static inline void rsx_fp_note_inline(rsx_fp* p) { p->iv.inl++; }
+static inline void rsx_fp_note_vtx_unknown(rsx_fp* p) { p->iv.vtx_unk++; }
+
+/* ---- draws ---- */
+static inline void rsx_fp_draw_rt(rsx_fp* p, int main_rt) { if (main_rt) p->drawn_since_wb = 1; }
+static inline uint64_t rsx_fp_front_now(const rsx_fp* p, uint64_t now)
+{
+    const uint64_t wall = now > p->t_start ? now - p->t_start : 0;
+    const uint64_t sub = p->iv_rec_ns + p->iv_sync_ns + (p->probe_total - p->probe0);
+    return wall > sub ? wall - sub : 0;
+}
+static inline void rsx_fp_draw_begin(rsx_fp* p, uint64_t now)
+{
+    p->in_draw = 1; p->draw_t0 = now; p->draw_probe0 = p->probe_total; p->draw_f_ns = rsx_fp_front_now(p, now);
+    p->cur_snap_b = 0; p->cur_idx_b = 0;
+}
+static inline void rsx_fp_draw_end(rsx_fp* p, uint64_t now)
+{
+    if (!p->in_draw) return;
+    p->in_draw = 0;
+    const uint64_t wall = now > p->draw_t0 ? now - p->draw_t0 : 0, pr = p->probe_total - p->draw_probe0;
+    const uint64_t rec = wall > pr ? wall - pr : 0;
+    p->iv_rec_ns += rec; p->iv.draws++;
+    __atomic_store_n(&p->draws_total, p->draws_total + 1u, __ATOMIC_RELAXED);
+    if (p->n_dr >= p->dr_cap) {                                           /* grow: the per-draw rows feed the queue simulation, a cap would change T */
+        rsx_fp_dr* nd = (rsx_fp_dr*)realloc(p->dr, (size_t)p->dr_cap * 2u * sizeof(rsx_fp_dr));
+        if (nd) { p->dr = nd; p->dr_cap *= 2u; }
+    }
+    if (p->n_dr < p->dr_cap) {
+        rsx_fp_dr* d = &p->dr[p->n_dr++];
+        d->f_ns = p->draw_f_ns > 0xFFFFFFFFull ? 0xFFFFFFFFu : (uint32_t)p->draw_f_ns;
+        d->rec_ns = rec > 0xFFFFFFFFull ? 0xFFFFFFFFu : (uint32_t)rec;
+        d->snap_b = p->cur_snap_b; d->idx_b = p->cur_idx_b;
+    } else p->dr_over++;
+}
+static inline void rsx_fp_sync_time(rsx_fp* p, uint64_t ns) { p->iv_sync_ns += ns; }
+
+/* ---- reports ---- */
+static inline void rsx_fp_pub_begin(rsx_fp* p) { memset(p->pub_state, 0, sizeof p->pub_state); memset(p->pub_hv, 0, sizeof p->pub_hv); memset(p->pub_off, 0, sizeof p->pub_off); }
+static inline void rsx_fp_pub_set(rsx_fp* p, uint32_t idx, uint32_t off, uint32_t state, uint32_t hv)
+{ if (idx >= RSX_FP_SLOTS) p->slot_over++; else { p->pub_off[idx] = off; p->pub_state[idx] = (uint8_t)state; p->pub_hv[idx] = (uint8_t)hv; } }
+/* idx < 0: no slot. cls: RSX_FP_RC_*. state/hv: the slot's state and has_val as of now. */
+static inline void rsx_fp_report(rsx_fp* p, int cls, int idx, uint32_t off, uint32_t state, uint32_t hv)
+{
+    p->iv.rep++;
+    if (cls == RSX_FP_RC_NEVER) p->iv.rep_never++;
+    else if (cls == RSX_FP_RC_NOVAL) p->iv.rep_noval++;
+    else if (cls == RSX_FP_RC_VAL) p->iv.rep_val++;
+    else p->iv.rep_dflt++;
+    const uint32_t pos = p->iv.draws;
+    if (p->iv.rep == 1) p->iv_rep_first = pos;
+    p->iv_rep_last = pos;
+    if (idx >= 0 && (uint32_t)idx >= RSX_FP_SLOTS) p->slot_over++;
+    if (idx >= 0 && (uint32_t)idx < RSX_FP_SLOTS) {
+        if (p->pub_off[idx] != off || p->pub_state[idx] != state) p->iv.rep_lag_state++;
+        else if (p->pub_hv[idx] != hv) p->iv.rep_lag_val++;
+    }
+}
+/* async ref publication (any thread) */
+static inline void rsx_fp_pub_note(rsx_fp* p)
+{
+    __atomic_store_n(&p->pub_draw_mark, __atomic_load_n(&p->draws_total, __ATOMIC_RELAXED), __ATOMIC_RELAXED);
+    __atomic_add_fetch(&p->pub_count, 1u, __ATOMIC_RELAXED);
+}
+
+/* ---- second decode pass buffer (sampled flip) ---- */
+static inline void rsx_fp_word(rsx_fp* p, uint32_t m, uint32_t v)
+{
+    if (!p->sampling) return;
+    if (!p->d2) { p->d2 = (uint32_t*)malloc((size_t)RSX_FP_D2_MAX * 2u * sizeof(uint32_t)); if (!p->d2) { p->d2_over++; return; } }
+    if (p->d2_n >= RSX_FP_D2_MAX) { p->d2_over++; return; }
+    p->d2[2u * p->d2_n] = m; p->d2[2u * p->d2_n + 1u] = v; p->d2_n++;
+}
+static inline void rsx_fp_d2_result(rsx_fp* p, uint64_t ns, uint32_t words)
+{ p->samp_d2_ns = ns; p->samp_d2_words = words; p->d2_n = 0; p->probe_total += ns; }
+
+/* ---- hard points ---- */
+static inline void rsx_fp_close_iv(rsx_fp* p, uint64_t now, int ev)
+{
+    const uint64_t wall = now > p->t_start ? now - p->t_start : 0;
+    const uint64_t probe = p->probe_total - p->probe0;
+    const uint64_t front_raw = rsx_fp_front_now(p, now);
+    const rsx_fp_c* c = &p->iv;
+    const uint64_t snap_b = c->tex_b + c->vtx_b + c->idx_b + c->fp_b;
+    const double cr = p->rates_known ? p->copy_rate : 0.0, sr = p->rates_known ? p->scan_rate : 0.0, dp = p->d2_known ? p->dec_per_draw : 0.0;
+    const uint64_t snap_ns = (uint64_t)((double)snap_b * cr + (double)c->idx_b * sr);
+    const uint64_t dec_ns = (uint64_t)((double)c->draws * dp);
+    const uint64_t F = front_raw + snap_ns;
+    const uint64_t R = p->iv_rec_ns + p->iv_sync_ns + p->carry_ns + dec_ns;
+    const uint64_t base = F > R ? F : R;
+    /* one-recorder queue simulation: the recorder starts the interval busy with the previous present (carry) */
+    double cc = (double)p->carry_ns, cum = 0.0;
+    for (uint32_t j = 0; j < p->n_dr; j++) {
+        cum += (double)p->dr[j].snap_b * cr + (double)p->dr[j].idx_b * sr;
+        const double ready = (double)p->dr[j].f_ns + cum;
+        cc = (cc > ready ? cc : ready) + (double)p->dr[j].rec_ns + dp;
+    }
+    cc = (cc > (double)F ? cc : (double)F) + (double)p->iv_sync_ns;
+    const uint64_t drain = cc > (double)base ? (uint64_t)(cc - (double)base) : 0;
+    const uint64_t T = base + drain;
+    /* async ref publication inside the interval: the draws recorded before the last one */
+    const uint64_t pubs = __atomic_load_n(&p->pub_count, __ATOMIC_RELAXED);
+    uint64_t cross = 0;
+    if (pubs != p->pub_seen_iv) {
+        const uint64_t mark = __atomic_load_n(&p->pub_draw_mark, __ATOMIC_RELAXED);
+        cross = mark > p->iv_draw0 ? mark - p->iv_draw0 : 0;
+        if (cross > c->draws) cross = c->draws;
+        p->iv.cross_iv = 1; p->iv.pubs = pubs - p->pub_seen_iv; p->iv.cross_d = cross;
+    }
+    p->pub_seen_iv = pubs;
+    p->iv.ivs = 1;
+    /* accumulate into the flip */
+    rsx_fp_c* f = &p->fl_c; const uint64_t* a = (const uint64_t*)c; uint64_t* b = (uint64_t*)f;
+    for (size_t k = 0; k < sizeof(rsx_fp_c) / sizeof(uint64_t); k++) b[k] += a[k];
+    p->fl_T += T; p->fl_F += F; p->fl_R += R; p->fl_drain += drain; p->fl_wall += wall > probe ? wall - probe : 0;
+    p->fl_drain_k[ev] += drain; p->fl_n_k[ev]++;
+    if (p->sampling && p->n_sv < RSX_FP_MAXIV) {
+        rsx_fp_ivs* s = &p->sv[p->n_sv++];
+        s->ev = (uint32_t)ev; s->draws = c->draws; s->rep = (uint32_t)c->rep; s->rep_first = p->iv_rep_first; s->rep_last = p->iv_rep_last;
+        s->tex_b = c->tex_b; s->vtx_b = c->vtx_b; s->idx_b = c->idx_b; s->F_ns = F; s->R_ns = R; s->drain_ns = drain; s->T_ns = T;
+    } else if (p->sampling) p->sv_cap_hit++;
+    if (p->sampling) p->samp_flip_draws += c->draws;
+    /* reset the interval */
+    memset(&p->iv, 0, sizeof p->iv);
+    p->iv_rec_ns = 0; p->iv_sync_ns = 0; p->iv_rep_first = p->iv_rep_last = 0; p->n_dr = 0; p->carry_ns = 0;
+    p->probe0 = p->probe_total; p->iv_draw0 = p->draws_total; p->t_start = now;
+    if (p->hard_cb) p->hard_cb(p->hard_ctx);
+}
+static inline void rsx_fp_acc_w(rsx_fp_w* w, const rsx_fp_c* c)
+{ const uint64_t* a = (const uint64_t*)c; uint64_t* b = (uint64_t*)&w->c; for (size_t k = 0; k < sizeof(rsx_fp_c) / sizeof(uint64_t); k++) b[k] += a[k]; }
+
+/* returns 1 when a window line is due (call rsx_fp_window_line, then rsx_fp_window_done) */
+static inline int rsx_fp_event(rsx_fp* p, int ev, uint64_t now, uint32_t dirty)
+{
+    if (ev == RSX_FP_EV_BGS) {
+        if (!p->drawn_since_wb) { p->iv.bgs_ord++; if (dirty) p->iv.bgs_missed++; return 0; }
+        p->iv.bgs_hard++;
+    } else if (ev == RSX_FP_EV_WB) p->iv.wb++;
+    if (ev == RSX_FP_EV_FLIP && p->pres_t0) now = p->pres_t0;   /* the present itself is recorder work, see rsx_fp_present_done */
+    if (ev == RSX_FP_EV_FLIP) p->iv.flips++;
+    rsx_fp_close_iv(p, now, ev);
+    p->drawn_since_wb = 0;
+    if (ev != RSX_FP_EV_FLIP) return 0;
+    /* flip closed */
+    const int was_sample = (int)p->sampling;
+    p->flips_total++; p->win_flips++;
+    rsx_fp_acc_w(&p->win, &p->fl_c); rsx_fp_acc_w(&p->tot, &p->fl_c);
+    if (!was_sample) {
+        rsx_fp_w* ws[2] = { &p->win, &p->tot };
+        for (int i = 0; i < 2; i++) {
+            ws[i]->T_ns += p->fl_T; ws[i]->F_ns += p->fl_F; ws[i]->R_ns += p->fl_R; ws[i]->drain_ns += p->fl_drain; ws[i]->wall_ns += p->fl_wall;
+            ws[i]->tflips++; if (p->fl_T > RSX_FP_T_GATE_NS) ws[i]->tflips_over++;
+            for (int k = 0; k < RSX_FP_EV_N; k++) { ws[i]->drain_k[k] += p->fl_drain_k[k]; ws[i]->n_k[k] += p->fl_n_k[k]; }
+        }
+    } else {                                                    /* the sampled flip yields the rates, not model rows */
+        if (p->samp_cp_b >= 4096) { p->copy_rate = (double)p->samp_cp_ns / (double)p->samp_cp_b; p->rates_known = 1; }
+        if (p->samp_scan_b >= 1024) p->scan_rate = (double)p->samp_scan_ns / (double)p->samp_scan_b;
+        if (p->samp_d2_words && p->samp_flip_draws) { p->dec_per_draw = (double)p->samp_d2_ns / (double)p->samp_flip_draws; p->d2_known = 1; }
+    }
+    memset(&p->fl_c, 0, sizeof p->fl_c);
