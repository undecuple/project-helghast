+    if (__builtin_expect(ppu_vmi_ok(ea), 1))
+        return __builtin_bswap32(__atomic_load_n((const ppu_vmi_u32*)(vm_base + ea), __ATOMIC_RELAXED));
+    return vm_read32(a);
+}
+static inline __attribute__((always_inline)) uint64_t ppu_vmi_read64(uint64_t a) {
+    const uint32_t ea = (uint32_t)a;
+    if (__builtin_expect(ppu_vmi_ok(ea), 1))
+        return __builtin_bswap64(__atomic_load_n((const ppu_vmi_u64*)(vm_base + ea), __ATOMIC_RELAXED));
+    return vm_read64(a);
+}
