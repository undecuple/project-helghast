+/* ---- KZ3 patch 1091 begin: inline guest loads (opt-in, KZ3_VM_INLINE=1) ----
+ * Every guest load of the lifted code was a call into vm_read8/16/32/64. Here a load from a page whose byte in
+ * g_ppu_vm_page (one byte per 64 KiB guest page) has the RD bit is a relaxed atomic load from vm_base + ea and a
+ * byte swap: relaxed atomic, so the compiler can neither hoist a poll loop's load out of the loop nor tear it, and on
+ * x86-64 it is one mov. The page-byte gate follows soyjxck/ps3recomp (the Drakengard 3 fork, MIT: ppu_vm_page.h,
+ * ppu_vm_fast.h); RD only here, stores stay out of line. The runtime sets RD (ppu_loader.cpp, vm_fast_init) only
+ * when KZ3_VM_INLINE=1 is set and no read diagnostic is armed (patch 1080's read conditions), and never on the null
+ * page (page 0), the raw SPU window and above (0xE000-0xFFFF: problem-state registers whose loads have side effects)
+ * or the page of the GCM ref word (ppu_hle_inject_base + 0x2008: its reads publish fences, GCM_REFPOLL); those and
+ * every page until then call vm_read* as before. Like 1080's gate, only the first byte's page is tested. */
+#if defined(__GNUC__) && !defined(PPU_VMI_DISABLE)
+extern "C" unsigned char g_ppu_vm_page[65536];
+#define PPU_VM_PAGE_RD 1u
+typedef uint16_t __attribute__((may_alias)) ppu_vmi_u16;
+typedef uint32_t __attribute__((may_alias)) ppu_vmi_u32;
+typedef uint64_t __attribute__((may_alias)) ppu_vmi_u64;
+static inline __attribute__((always_inline)) int ppu_vmi_ok(uint32_t ea) {
+    return __atomic_load_n(&g_ppu_vm_page[ea >> 16], __ATOMIC_RELAXED) & PPU_VM_PAGE_RD;
