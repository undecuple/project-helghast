diff --git a/libs/input/pad_remap.h b/libs/input/pad_remap.h
new file mode 100644
index 00000000..f6bd0bec
--- /dev/null
+++ b/libs/input/pad_remap.h
@@ -0,0 +1,151 @@
+/*
+ * KZ3 patch 4013 (stage 3, ENHANCEMENT, opt-in): pad button remap, pure (no host types, host-testable).
+ *
+ * The remap sits in the port's pad layer, between the host pad and what cellPadGetData hands the game, so the game's
+ * own control scheme options (Standard, Alternate, swap sticks, swap L1/L2 ...) keep working on top of it. It is a
+ * table over the 16 digital buttons, written in PS3 terms: src[g] = the host button that drives game button g
+ * (PRM_NONE = nothing drives it). The host backends already put every pad in PS3 terms (SDL and XInput: A/Cross,
+ * LT/L2, RB/R1 ...), so one table serves PS3, PS4/PS5 and Xbox pads; only the prompt pictures differ per pad.
+ * A value is 0..255 (pressure; a digital button is 0 or 255), so a trigger can drive a shoulder button and back.
+ *
+ * Presets (PRM_DEFAULT_PRESET below is the one a file without a [pad] section gets):
+ *   default = identity, the game's own scheme, unchanged.
+ *   modern  = a modern-shooter layout (spec 2026-10-20) laid on the game's Standard scheme. Where the
+ *             spec puts a button depends on the pad family, so there are two tables, picked per port by the pad type:
+ *             PS family (PS3, PS4, PS5 pads, and a scripted port): fire R1, aim L1, grenade L2;
+ *             Xbox family (Xbox, Switch, other pads): fire RT, aim LT, grenade LB.
+ *             game R1 (fire)        <- PS R1          | Xbox R2 (RT)
+ *             game R3 (zoom/aim)    <- PS L1          | Xbox L2 (LT)
+ *             game R2 (grenade)     <- PS L2          | Xbox L1 (LB)
+ *             game L2 (crouch/cover)<- Circle (B)
+ *             game Circle (use)     <- Square (X)     (Square also stays reload/pick-up: one button, both actions)
+ *             game L1 (melee)       <- R3 (right stick click; the nearest free input)
+ *             Sprint L3, jump Cross (A), weapon switch Triangle (Y), d-pad, Start, Select, sticks stay.
+ *   custom  = keybinds.ini [pad] entries "game button = host button | none", unlisted buttons identity.
+ */
+#ifndef PAD_REMAP_H
+#define PAD_REMAP_H
+
+#include <stdint.h>
+#include <string.h>
+
+#define PRM_N 16
+#define PRM_NONE 0xFFu
+
+/* Button index = bit number of CELL_PAD_CTRL_* (cellPad.h). */
+enum { PRM_SELECT = 0, PRM_L3, PRM_R3, PRM_START, PRM_UP, PRM_RIGHT, PRM_DOWN, PRM_LEFT, PRM_L2, PRM_R2, PRM_L1, PRM_R1,
+       PRM_TRIANGLE, PRM_CIRCLE, PRM_CROSS, PRM_SQUARE };
+static const char* const prm_names[PRM_N] = { "select", "l3", "r3", "start", "up", "right", "down", "left",
+                                              "l2", "r2", "l1", "r1", "triangle", "circle", "cross", "square" };
+
+typedef struct { unsigned char src[PRM_N]; } PadRemap;
+
+enum { PRM_DEFAULT = 0, PRM_MODERN, PRM_CUSTOM, PRM_N_PRESETS };
+/* THE default preset (still to be decided): what a keybinds.ini without a [pad] section, and no file at
+ * all, gives. PRM_DEFAULT = the game's own scheme. Every other place reads this constant. */
+#define PRM_DEFAULT_PRESET PRM_DEFAULT
+enum { PRM_FAM_PS = 0, PRM_FAM_XBOX = 1 };   /* which modern table a pad gets */
+static const char* const prm_preset_names[PRM_N_PRESETS] = { "default", "modern", "custom" };
+
+static int prm_ieq(const char* s, size_t n, const char* m)
+{
+    size_t k;
+    if (strlen(m) != n) return 0;
+    for (k = 0; k < n; k++) {
+        char c = s[k];
+        if (c >= 'A' && c <= 'Z') c = (char)(c + 32);
+        if (c != m[k]) return 0;
+    }
+    return 1;
+}
+
+/* Name -> button index (-1 unknown); "cross"/"x" etc. are not aliased: the PS3 names only. */
+static int prm_button_by_name(const char* s, size_t n)
+{
+    int i;
+    for (i = 0; i < PRM_N; i++) if (prm_ieq(s, n, prm_names[i])) return i;
+    return -1;
+}
+
+static int prm_preset_by_name(const char* s, size_t n)
+{
+    int i;
+    for (i = 0; i < PRM_N_PRESETS; i++) if (prm_ieq(s, n, prm_preset_names[i])) return i;
+    return -1;
+}
+
+static void prm_identity(PadRemap* m)
+{
+    int i;
+    for (i = 0; i < PRM_N; i++) m->src[i] = (unsigned char)i;
+}
+
+static int prm_is_identity(const PadRemap* m)
+{
+    int i;
+    for (i = 0; i < PRM_N; i++) if (m->src[i] != i) return 0;
+    return 1;
+}
+
+/* The table for a preset; `custom` is used for PRM_CUSTOM (NULL = identity). An out-of-range src (hostile file)
+ * reads as none. */
+static void prm_fill(int preset, int family, const PadRemap* custom, PadRemap* m)
+{
+    int i;
+    prm_identity(m);
+    if (preset == PRM_MODERN) {
+        if (family == PRM_FAM_XBOX) {
+            m->src[PRM_R1] = PRM_R2;   /* RT fires */
+            m->src[PRM_R3] = PRM_L2;   /* LT aims */
+            m->src[PRM_R2] = PRM_L1;   /* LB grenade */
+        } else {
+            m->src[PRM_R3] = PRM_L1;   /* L1 aims (R1 fires as before) */
+            m->src[PRM_R2] = PRM_L2;   /* L2 grenade */
+        }
+        m->src[PRM_L2] = PRM_CIRCLE;   /* B / Circle crouches */
+        m->src[PRM_CIRCLE] = PRM_SQUARE;   /* X / Square: use (and, unchanged, reload / pick up) */
+        m->src[PRM_L1] = PRM_R3;       /* melee on the stick click */
+    } else if (preset == PRM_CUSTOM && custom) {
+        *m = *custom;
+        for (i = 0; i < PRM_N; i++) if (m->src[i] >= PRM_N) m->src[i] = PRM_NONE;
+    }
+}
+
+/* 0 for the identity (nothing to redraw), else an FNV-1a hash of the table that is never 0 (prompt cache key). */
+static uint32_t prm_sig(const PadRemap* m)
+{
+    uint32_t h = 2166136261u;
+    int i;
+    if (prm_is_identity(m)) return 0;
+    for (i = 0; i < PRM_N; i++) { h ^= m->src[i]; h *= 16777619u; }
+    return h ? h : 1u;
+}
+
+/* The remap on one report. mask = CELL_PAD_CTRL_* bits, press[b] = 0..255 per button (the caller fills a digital
+ * button's 255 when its bit is set). Game button g takes the bit and the value of host button src[g]. */
+static void prm_apply(const PadRemap* m, unsigned mask, const unsigned char press[PRM_N], unsigned* omask,
+                      unsigned char opress[PRM_N])
+{
+    unsigned o = mask & ~0xFFFFu;
+    int g;
+    for (g = 0; g < PRM_N; g++) {
+        const unsigned s = m->src[g];
+        if (s >= PRM_N) { opress[g] = 0; continue; }
+        opress[g] = press[s];
+        if (mask & (1u << s)) o |= 1u << g;
+    }
+    *omask = o;
+}
+
+/* Just the bits (scripted input). */
+static unsigned prm_apply_mask(const PadRemap* m, unsigned mask)
+{
+    unsigned char p[PRM_N], q[PRM_N];
+    unsigned o;
+    int i;
+    for (i = 0; i < PRM_N; i++) p[i] = (mask >> i) & 1u ? 255 : 0;
+    prm_apply(m, mask, p, &o, q);
+    return o;
+}
+
+#endif
