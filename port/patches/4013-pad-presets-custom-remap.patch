+/* ---- KZ3 patch 4013 (stage 3): the pad remap on a host report ------------------------------------------------ */
+#include "pad_remap.h"
+static inline void pad_host_remap(const PadRemap* m, PadHostState* hs)
+{
+    unsigned char p[PRM_N], q[PRM_N];
+    unsigned o;
+    int i;
+    if (!hs->connected || prm_is_identity(m)) return;
+    p[PRM_UP] = hs->press_up;       p[PRM_RIGHT] = hs->press_right;  p[PRM_DOWN] = hs->press_down;
+    p[PRM_LEFT] = hs->press_left;   p[PRM_L2] = hs->trigger_l2;      p[PRM_R2] = hs->trigger_r2;
+    p[PRM_L1] = hs->press_l1;       p[PRM_R1] = hs->press_r1;        p[PRM_TRIANGLE] = hs->press_triangle;
+    p[PRM_CIRCLE] = hs->press_circle; p[PRM_CROSS] = hs->press_cross; p[PRM_SQUARE] = hs->press_square;
+    p[PRM_SELECT] = p[PRM_L3] = p[PRM_R3] = p[PRM_START] = 0;
+    for (i = 0; i < PRM_N; i++) if (((hs->buttons >> i) & 1u) && !p[i]) p[i] = 255;   /* digital: full pressure */
+    prm_apply(m, hs->buttons, p, &o, q);
+    hs->buttons = (u16)o;
+    hs->press_up = q[PRM_UP];       hs->press_right = q[PRM_RIGHT];  hs->press_down = q[PRM_DOWN];
+    hs->press_left = q[PRM_LEFT];   hs->trigger_l2 = q[PRM_L2];      hs->trigger_r2 = q[PRM_R2];
+    hs->press_l1 = q[PRM_L1];       hs->press_r1 = q[PRM_R1];        hs->press_triangle = q[PRM_TRIANGLE];
+    hs->press_circle = q[PRM_CIRCLE]; hs->press_cross = q[PRM_CROSS]; hs->press_square = q[PRM_SQUARE];
+}
 
 #endif
