+/* The atlas `cur` (BC3, w x h, the glyph set already drawn; `own` = malloc'd copy or the game's source) with the
+ * cells of remapped game buttons replaced by the picture of the pad button that presses them. Returns a new malloc'd
+ * copy (`cur` untouched), or NULL when nothing changes. *n = cells moved. */
+static uint8_t* ld_prompt_remap_cells(const uint8_t* cur, uint32_t w, uint32_t h, uint32_t bytes, int kind, int* n)
+{
+    *n = 0;
+    if (!pad_remap_sig() || bytes < w * h || (w & 3) || (h & 3)) return NULL;
+    const kc_cell* cells = kind == KC_HUD ? kc_hud_cells : kc_menu_cells;
+    const unsigned nc = kind == KC_HUD ? sizeof kc_hud_cells / sizeof kc_hud_cells[0] : sizeof kc_menu_cells / sizeof kc_menu_cells[0];
+    uint8_t* out = (uint8_t*)malloc(bytes);
+    if (!out) return NULL;
+    memcpy(out, cur, bytes);
+    const uint32_t bw = w / 4;
+    for (unsigned c = 0; c < nc; c++) {
+        const kc_cell* t = &cells[c];
+        const char* hn = pad_remap_host_for(t->input);
+        if (!hn || !*hn || !strcmp(hn, t->input)) continue;   /* not a button, none, or unchanged */
+        const kc_cell* sc = NULL;
+        for (unsigned i = 0; i < nc; i++) if (!strcmp(cells[i].input, hn)) { sc = &cells[i]; break; }
+        if (!sc) continue;
+        const int tw = t->r - t->l + 1, th = t->b - t->t + 1, sw = sc->r - sc->l + 1, sh = sc->b - sc->t + 1;
+        if (tw <= 0 || th <= 0 || sw <= 0 || sh <= 0 || t->r >= (int)w || t->b >= (int)h || sc->r >= (int)w || sc->b >= (int)h) continue;
+        uint8_t* cap = (uint8_t*)malloc((size_t)tw * th * 4);
+        if (!cap) continue;
+        for (int y = 0; y < th; y++)   /* the source cell from `cur` (nearest texel when the sizes differ) */
+            for (int x = 0; x < tw; x++) {
+                const int sx = sc->l + (x * sw) / tw, sy = sc->t + (y * sh) / th;
+                uint8_t px[16][4];
+                kc_bc3_decode(cur + ((size_t)(sy / 4) * bw + (size_t)(sx / 4)) * 16, px);
+                memcpy(cap + ((size_t)y * tw + x) * 4, px[(sy & 3) * 4 + (sx & 3)], 4);
+            }
+        for (uint32_t by = t->t / 4; by <= (uint32_t)t->b / 4 && by < h / 4; by++)
+            for (uint32_t bx = t->l / 4; bx <= (uint32_t)t->r / 4 && bx < bw; bx++) {
+                uint8_t* blk = out + ((size_t)by * bw + bx) * 16;
+                uint8_t px[16][4];
+                kc_bc3_decode(blk, px);
+                for (int i = 0; i < 16; i++) {
+                    const int x = (int)bx * 4 + (i & 3), y = (int)by * 4 + (i >> 2);
+                    if (x < t->l || x > t->r || y < t->t || y > t->b) continue;
+                    memcpy(px[i], cap + ((size_t)(y - t->t) * tw + (x - t->l)) * 4, 4);
+                }
+                kc_bc3_encode(px, blk);
+            }
+        free(cap);
+        (*n)++;
+    }
+    if (!*n) { free(out); return NULL; }
+    return out;
 }
