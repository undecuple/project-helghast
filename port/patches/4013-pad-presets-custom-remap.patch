+/* ---------------------------------------------------------------------------
+ * KZ3 patch 4013 (stage 3): pad presets and custom mapping (ENHANCEMENT, opt-in; pad_remap.h)
+ * -----------------------------------------------------------------------*/
+static PadRemap s_remap[2];        /* per pad family (PRM_FAM_*) */
+static int      s_remap_set = 0;
+static uint32_t s_remap_sig[2];    /* 0 = identity (the game's own scheme) */
+
+/* The modern preset's table depends on the pad: PlayStation pads (and a port with no host pad, i.e. a scripted one)
+ * get the PS table, every other pad the Xbox one. KZ3_PAD_FAMILY=ps|xbox forces it (tests). */
+static int pad_remap_family(int dev)
+{
+    static int env = -2;
+    if (env == -2) {
+        const char* e = getenv("KZ3_PAD_FAMILY");
+        env = (e && !strcmp(e, "xbox")) ? PRM_FAM_XBOX : (e && !strcmp(e, "ps")) ? PRM_FAM_PS : -1;
+    }
+    if (env >= 0) return env;
+    switch (dev) {
+    case PAD_DEV_XBOX: case PAD_DEV_SWITCH: case PAD_DEV_OTHER: return PRM_FAM_XBOX;
+    default: return PRM_FAM_PS;
+    }
+}
+
+/* The table the Options row (keybinds.ini [pad]) selects; KZ3_PAD_PRESET=default|modern|custom (tests) before it. */
+static void pad_remap_refresh(void)
+{
+    static int env = -2;
+    PadRemap cust, m[2];
+    int preset = PRM_DEFAULT_PRESET, f;
+    uint32_t sig[2];
+    if (env == -2) {
+        const char* e = getenv("KZ3_PAD_PRESET");
+        env = (e && *e) ? prm_preset_by_name(e, strlen(e)) : -1;
+        if (e && *e) { printf("[pad] KZ3_PAD_PRESET=%s: %s\n", e, env < 0 ? "unknown value, ignored" : "pad layout forced"); fflush(stdout); }
+    }
+    prm_identity(&cust);
+#ifdef _WIN32
+    AcquireSRWLockShared(&s_kb_lock);
+    if (s_kb_ready) { preset = s_kb.padmap; memcpy(cust.src, s_kb.padc, sizeof cust.src); }
+    ReleaseSRWLockShared(&s_kb_lock);
+#endif
+    if (env >= 0) preset = env;
+    for (f = 0; f < 2; f++) { prm_fill(preset, f, &cust, &m[f]); sig[f] = prm_sig(&m[f]); }
+    if (!s_remap_set || sig[0] != s_remap_sig[0] || sig[1] != s_remap_sig[1]) {
+        int g;
+        printf("[pad] layout: %s%s\n", preset >= 0 && preset < PRM_N_PRESETS ? prm_preset_names[preset] : "?",
+               sig[0] || sig[1] ? "" : " (the game's own)");
+        for (f = 0; f < 2; f++)
+            for (g = 0; sig[f] && g < PRM_N; g++)
+                if (m[f].src[g] != g) printf("[pad]   %s pads: game %s <- pad %s\n", f ? "Xbox" : "PS", prm_names[g],
+                                             m[f].src[g] < PRM_N ? prm_names[m[f].src[g]] : "none");
+        fflush(stdout);
+    }
+    s_remap[0] = m[0]; s_remap[1] = m[1];
+    s_remap_sig[0] = sig[0]; s_remap_sig[1] = sig[1];
+    s_remap_set = 1;
+}
+
+/* The remap on every connected host pad (a fresh report each poll, so it is applied once). */
+static void pad_remap_apply_all(void)
+{
+    pad_remap_refresh();
+    if (!s_remap_sig[0] && !s_remap_sig[1]) return;
+    for (int p = 0; p < PAD_MAX_HOST_PORTS; p++) pad_host_remap(&s_remap[pad_remap_family(s_port_dev[p])], &s_host_state[p]);
+}
+
+/* The family the prompts describe: the pad last used; with no pad (keys, nothing) the glyph set's. */
+static int pad_remap_prompt_family(void)
+{
+    int dev = pad_prompt_device();
+    if (dev == PAD_DEV_KEYBOARD || dev == PAD_DEV_NONE) return pad_prompt_set() == PAD_PROMPT_XBOX ? PRM_FAM_XBOX : PRM_FAM_PS;
+    return pad_remap_family(dev);
+}
+
+/* For the prompt atlases (rsx_live_draw.c, patch 4013): 0 = identity, else a hash of the table. */
+unsigned pad_remap_sig(void)
+{
+    return s_remap_sig[pad_remap_prompt_family()];
+}
+
+/* The host button (PS3 name) that presses game button `game_input` ("r1", "cross" ...), "" when none, NULL for a name
+ * that is not a button or while the layout is the game's own. The prompt for a game button shows this one. */
+const char* pad_remap_host_for(const char* game_input)
+{
+    int g;
+    const int f = pad_remap_prompt_family();
+    if (!s_remap_sig[f] || !game_input) return NULL;
+    g = prm_button_by_name(game_input, strlen(game_input));
+    if (g < 0) return NULL;
+    return s_remap[f].src[g] < PRM_N ? prm_names[s_remap[f].src[g]] : "";
+}
