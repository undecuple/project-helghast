--- a/libs/filesystem/edat.c
+++ b/libs/filesystem/edat.c
@@ -18,6 +18,10 @@
  * vectors before anything is decrypted -- see the note in edat.h.
  */
 
+/* KZ3 patch 1164: fseeko/off_t under a strict -std=c11 build (a no-op where _GNU_SOURCE or _DEFAULT_SOURCE is on). */
+#if !defined(_WIN32) && !defined(_POSIX_C_SOURCE) && !defined(_GNU_SOURCE) && !defined(_DEFAULT_SOURCE)
+#  define _POSIX_C_SOURCE 200809L
+#endif
 #include "edat.h"
 
 #include <stdio.h>
@@ -403,6 +407,17 @@
 /* ---------------------------------------------------------------------------
  * EDAT
  * -----------------------------------------------------------------------*/
+/* KZ3 patch 1164 (after project-vekta patch 4015): a 64-bit seek. fseek takes a long, which is 32 bits on Windows: past
+ * 2 GiB (a 3 GB data archive) it fails and every later block read with it. */
+static int edat_seek(FILE* f, uint64_t off)
+{
+#ifdef _WIN32
+    return _fseeki64(f, (__int64)off, SEEK_SET);
+#else
+    return fseeko(f, (off_t)off, SEEK_SET);
+#endif
+}
+
 int edat_is_npd(const char* host_path)
 {
     FILE* f = fopen(host_path, "rb");
