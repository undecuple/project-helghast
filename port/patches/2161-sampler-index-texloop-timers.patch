diff --git a/libs/video/rsx_smp_index.h b/libs/video/rsx_smp_index.h
new file mode 100644
index 00000000..68b1060d
--- /dev/null
+++ b/libs/video/rsx_smp_index.h
@@ -0,0 +1,43 @@
+/* KZ3 patch 2161: open-addressed index over the sampler cache's keys (RSX pass 149).
+ *
+ * sampler_slot() ran a linear memcmp over every cached sampler key (up to MAX_SAMPLERS = 128, 16 bytes each) for every
+ * enabled texture unit that missed the binding row, on the walker thread. Keys are unique in the cache (a key is
+ * only appended when the scan found none), so a hash lookup returns the same slot as the scan: the lowest, and only,
+ * index whose key equals the request. The index stores index + 1 (0 = empty) in a power-of-two table at <= 25 % load,
+ * linear probing, no deletion (the cache never removes keys). Pure C, no allocation. Host test:
+ * tools/smoke/test_smp_index.sh (equivalence with the scan, negative control, micro-benchmark). */
+#ifndef RSX_SMP_INDEX_H
+#define RSX_SMP_INDEX_H
+
+#include <stdint.h>
+#include <string.h>
+
+#define RSX_SMP_IDX_BITS 9u
+#define RSX_SMP_IDX_SIZE (1u << RSX_SMP_IDX_BITS)   /* >= 4 x 128 keys */
+
+static inline uint32_t rsx_smp_key_hash(const uint32_t key[4])
+{
+    uint32_t h = key[0] * 0x9E3779B1u;
+    h = (h ^ (h >> 15)) + key[1] * 0x85EBCA77u;
+    h = (h ^ (h >> 13)) + key[2] * 0xC2B2AE3Du;
+    h = (h ^ (h >> 16)) + key[3] * 0x27D4EB2Fu;
+    h ^= h >> 15; h *= 0x2C1B3C6Du; h ^= h >> 12;
+    return h & (RSX_SMP_IDX_SIZE - 1u);
+}
+/* The cache index holding `key`, or -1. idx[] is zero-initialised; keys[i] are the n cached keys. */
+static inline int rsx_smp_index_find(const uint16_t idx[RSX_SMP_IDX_SIZE], const uint32_t (*keys)[4], const uint32_t key[4])
+{
+    for (uint32_t k = rsx_smp_key_hash(key);; k = (k + 1u) & (RSX_SMP_IDX_SIZE - 1u)) {
+        const uint32_t v = idx[k];
+        if (!v) return -1;
+        if (!memcmp(keys[v - 1u], key, 16)) return (int)(v - 1u);
+    }
+}
+/* Record keys[i] (just appended, not present before). */
+static inline void rsx_smp_index_add(uint16_t idx[RSX_SMP_IDX_SIZE], const uint32_t (*keys)[4], uint32_t i)
+{
+    uint32_t k = rsx_smp_key_hash(keys[i]);
+    while (idx[k]) k = (k + 1u) & (RSX_SMP_IDX_SIZE - 1u);
+    idx[k] = (uint16_t)(i + 1u);
+}
+#endif
