+/* ---------------------------------------------------------------------------
+ * KZ3 patch 3006: PAD_SCRIPT v2 -- scripted pad input with per-event holds,
+ * analog stick/trigger segments and a file form. v1 (PAD_SCRIPT="sec:mask,...")
+ * was digital only, 32 events at most (the rest dropped silently), 40 polls each.
+ *
+ * Grammar (PAD_SCRIPT="..." and PAD_SCRIPT_FILE=path take the same text and add up;
+ * events need not be in time order):
+ *   script := event { sep event }        sep = ',' | space | tab | newline; '#' comments to end of line
+ *   event  := T ':' body [ '/' SECONDS ] T = wall-clock seconds since the first pad poll (float)
+ *   body   := MASK                       digital press, C number (0x4000 or 16384); held 40 polls,
+ *                                        or SECONDS when '/' is given
+ *           | LX ',' LY ',' RX ',' RY [ ',' L2 ',' R2 ]
+ *                                        analog hold: sticks -1..1 (0 centred; LY/RY -1 = up, +1 = down),
+ *                                        triggers 0..1 (pressure; above 0.5 the digital L2/R2 bit is set
+ *                                        too); held SECONDS, default 1 s
+ * Examples:  10:0x4000            CROSS at 10 s for 40 polls (v1, unchanged)
+ *            300:0x0100/3         L2 held 3 s
+ *            430:0,-1,0,0/10      left stick full up for 10 s
+ *            440:0,0,1,0,0,1/2    right stick right and R2 fully pressed for 2 s
+ * Events latch: each fires at the first poll at or after T (a loading screen stops polling) and holds from
+ * then. Digital bits of overlapping events OR together; of overlapping analog holds the latest to fire wins,
+ * and the sticks return to centre when none is active. One log line per fired event ("[cellPad] script
+ * t=..."), at most PAD_SCRIPT_LOG_PER_SEC per wall second. Up to PAD_SCRIPT_MAX events; a WARNING line names
+ * anything dropped past that or unparsable.
+ * -----------------------------------------------------------------------*/
+#define PAD_SCRIPT_MAX         1024
+#define PAD_SCRIPT_HOLD_POLLS  40
+#define PAD_SCRIPT_LOG_PER_SEC 20
+
+typedef struct {
+    double t;              /* fire at the first poll at or after this second */
+    double hold_s;         /* < 0: digital for PAD_SCRIPT_HOLD_POLLS polls; else seconds */
+    unsigned mask;         /* digital: (DIGITAL2 << 8) | DIGITAL1 */
+    int analog;            /* 1: ax[] = lx ly rx ry l2 r2 as 0..255 */
+    unsigned char ax[6];
+    int fired; double fired_at; int polls_left;
+} PadScriptEvent;
+
+typedef struct {
+    PadScriptEvent ev[PAD_SCRIPT_MAX];
+    int n, dropped, bad;
+    int log_sec, log_n, log_suppressed;
+} PadScript;
+
+static const char* pad_script_skip(const char* p)          /* separators and comments */
+{
+    for (;;) {
+        while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n' || *p == ',') p++;
+        if (*p != '#') return p;
+        while (*p && *p != '\n') p++;
+    }
+}
+
+static const char* pad_script_blank(const char* p) { while (*p == ' ' || *p == '\t') p++; return p; }
+
+/* A number at p: hex through strtoul (MSVCRT's strtod has no hex form), else strtod. 0 = no number. */
+static int pad_script_number(const char* p, const char** end, double* out)
+{
+    const char* q = (*p == '+' || *p == '-') ? p + 1 : p;
+    char* e;
+    if (q[0] == '0' && (q[1] == 'x' || q[1] == 'X')) {
+        unsigned long v = strtoul(p, &e, 16);
+        if (e == p) return 0;
+        *out = (double)v; *end = e; return 1;
+    }
+    double v = strtod(p, &e);
+    if (e == p) return 0;
+    *out = v; *end = e; return 1;
+}
+
+static unsigned char pad_script_axis(double v, int trigger)
+{
+    double b = trigger ? v * 255.0 : 128.0 + v * 128.0;
+    if (b < 0) b = 0;
+    if (b > 255) b = 255;
+    return (unsigned char)(b + 0.5);
+}
+
+/* Parse `text` (an env value or a file's contents) and append its events to s. Returns the number added;
+ * s->bad counts tokens it could not read, s->dropped the events past PAD_SCRIPT_MAX. */
+static int pad_script_parse(PadScript* s, const char* text)
+{
+    const char* p = pad_script_skip(text);
+    int added = 0;
+    while (*p) {
+        const char* end; const char* tok0 = 0;
+        double t = 0, dur = -1, v[6];
+        int nv = 0, ok = 1;
+        if (!pad_script_number(p, &end, &t)) ok = 0;
+        else { p = pad_script_blank(end); if (*p != ':') ok = 0; else p = pad_script_blank(p + 1); }
+        while (ok) {   /* p ends right after the last number read, so the terminator check below sees it */
+            const char* q;
+            if (nv == 6 || !pad_script_number(p, &end, &v[nv])) { ok = 0; break; }
+            if (nv == 0) tok0 = p;
+            nv++; p = end;
+            q = pad_script_blank(p);
+            if (*q != ',') break;
+            /* a comma continues the list unless the next number is a time (followed by ':') */
+            q = pad_script_blank(q + 1);
+            { double peek; const char* e2;
+              if (!pad_script_number(q, &e2, &peek) || *pad_script_blank(e2) == ':') break; }
+            p = q;
+        }
+        if (ok) {
+            const char* q = pad_script_blank(p);
+            if (*q == '/') {
+                q = pad_script_blank(q + 1);
+                if (!pad_script_number(q, &end, &dur) || dur < 0) ok = 0; else p = end;
+            }
+        }
+        if (ok && nv != 1 && nv != 4 && nv != 6) ok = 0;
+        if (ok && *p && *p != ',' && *p != ' ' && *p != '\t' && *p != '\r' && *p != '\n' && *p != '#') ok = 0;
+        if (!ok) {   /* skip the token and count it */
+            s->bad++;
+            while (*p && *p != ',' && *p != ' ' && *p != '\t' && *p != '\r' && *p != '\n') p++;
+            p = pad_script_skip(p);
+            continue;
+        }
+        if (s->n >= PAD_SCRIPT_MAX) { s->dropped++; p = pad_script_skip(p); continue; }
+        { PadScriptEvent* e = &s->ev[s->n++];
+          memset(e, 0, sizeof *e);
+          e->t = t; e->hold_s = dur;
+          if (nv == 1) e->mask = (unsigned)strtoul(tok0, 0, 0);      /* as v1: base 0 */
+          else { int i; e->analog = 1; if (dur < 0) e->hold_s = 1.0;
+                 for (i = 0; i < nv; i++) e->ax[i] = pad_script_axis(v[i], i >= 4); }
+          added++; }
+        p = pad_script_skip(p);
+    }
+    return added;
+}
+
+/* One poll at wall time `now` (seconds): OR the digital bits of the active events into *mask, copy the latest
+ * active analog hold into ax[6] (*ax_set = 1). Returns the number of events that fired at this poll. */
+static int pad_script_poll(PadScript* s, double now, unsigned* mask, unsigned char ax[6], int* ax_set)
+{
+    int i, fired = 0; double ax_t = -1;
+    *ax_set = 0;
+    for (i = 0; i < s->n; i++) {
+        PadScriptEvent* e = &s->ev[i];
+        int active;
+        if (!e->fired) {
+            int sec;
+            if (now < e->t) continue;
+            e->fired = 1; e->fired_at = now; e->polls_left = PAD_SCRIPT_HOLD_POLLS; fired++;
+            sec = (int)now;
+            if (sec != s->log_sec) {
+                if (s->log_suppressed)
+                    printf("[cellPad] script t=%ds: %d more event(s) fired (log limit)\n", s->log_sec, s->log_suppressed);
+                s->log_sec = sec; s->log_n = 0; s->log_suppressed = 0;
+            }
+            if (s->log_n++ < PAD_SCRIPT_LOG_PER_SEC) {
+                if (e->analog)
+                    printf("[cellPad] script t=%.1fs sticks l=(%u,%u) r=(%u,%u) l2=%u r2=%u for %.2fs (at %.1fs)\n",
+                           e->t, e->ax[0], e->ax[1], e->ax[2], e->ax[3], e->ax[4], e->ax[5], e->hold_s, now);
+                else if (e->hold_s < 0)
+                    printf("[cellPad] script t=%.1fs press 0x%04X for %d polls (at %.1fs)\n",
+                           e->t, e->mask, PAD_SCRIPT_HOLD_POLLS, now);
+                else
+                    printf("[cellPad] script t=%.1fs press 0x%04X for %.2fs (at %.1fs)\n", e->t, e->mask, e->hold_s, now);
+                fflush(stdout);
+            } else s->log_suppressed++;
+        }
+        if (e->hold_s < 0) { active = e->polls_left > 0; if (active) e->polls_left--; }
+        else active = (now - e->fired_at) <= e->hold_s;
+        if (!active) continue;
+        if (!e->analog) *mask |= e->mask;
+        else if (e->fired_at >= ax_t) { ax_t = e->fired_at; memcpy(ax, e->ax, 6); *ax_set = 1; }
+    }
+    if (*ax_set) { if (ax[4] > 127) *mask |= 0x0100; if (ax[5] > 127) *mask |= 0x0200; }
+    return fired;
+}
+
+static char* pad_script_read_file(const char* path)        /* malloc'd, NUL-terminated; NULL if unreadable */
+{
+    FILE* f = fopen(path, "rb");
+    size_t cap = 1 << 16, len = 0; char* buf;
+    if (!f) return NULL;
+    buf = (char*)malloc(cap);
+    while (buf) {
+        size_t r = fread(buf + len, 1, cap - len - 1, f);
+        len += r;
+        if (len < cap - 1) break;
+        { char* nb = (char*)realloc(buf, cap * 2); if (!nb) { free(buf); buf = NULL; break; } buf = nb; cap *= 2; }
+    }
+    fclose(f);
+    if (buf) buf[len] = 0;
+    return buf;
+}
