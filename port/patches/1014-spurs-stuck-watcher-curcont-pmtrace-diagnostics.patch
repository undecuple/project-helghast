+/* KZ3 patch 1013 (diagnostic, SPURS_STUCK_MS, default 3000; 0 = off): one watcher thread for every
+ * instance. Patch 1011 ran this check inside the kernel threads, each looking at the OTHER instances,
+ * so a stuck HiPrio run went unseen while LoPrio's only thread sat in its endless wid 9 run.
+ * [spurs-stuck]: a policy-module run that has not returned for SPURS_STUCK_MS.
+ * [spurs-curcont]: a wklCurrentContention byte (+0x20+wid) that is nonzero while no run of that
+ * workload is in progress (the HLE sets it before a run and clears it after). */
+static DWORD WINAPI spurs_watch_thread(LPVOID p)
+{
+    (void)p;
+    int sm = 3000;
+    { const char* e = getenv("SPURS_STUCK_MS"); if (e) sm = atoi(e); }
+    if (sm <= 0) return 0;
+    u64 s_t_start = GetTickCount64();   /* t= below: ms since the first cellSpursInitialize */
+    static u64 cc_since[MAX_SPURS_INST][16], cc_rep[MAX_SPURS_INST][16];
+    for (;;) {
+        Sleep(50);
+        u64 now = GetTickCount64();
+        for (int j = 0; j < MAX_SPURS_INST; j++) {
+            u32 ea = s_inst[j].ea;
+            if (!ea) continue;
+            u64 t0 = s_run_t0[j];
+            u32 rw = s_run_wid[j];
+            if (t0) {
+                u64 d = now - t0;
+                if (d >= (u64)sm && now - s_run_rep[j] >= 5000) {
+                    s_run_rep[j] = now;
+                    extern void* spu_pm_ctx_peek(uint32_t wid, uint32_t spu_num);
+                    extern void spu_pm_ctx_describe(void* ctx, char* out, int n);
+                    char b[512] = "";
+                    spu_pm_ctx_describe(spu_pm_ctx_peek(rw, 0), b, sizeof b);
+                    /* where the run spends its time: 300 pc samples, 1 ms apart, top 4 */
+                    extern uint32_t spu_pm_ctx_pc(void* ctx);
+                    void* cx = spu_pm_ctx_peek(rw, 0);
+                    /* arm a 600-event trace of this context (first two reports per instance) */
+                    { extern void* volatile g_kz3_trace_ctx; extern volatile long g_kz3_trace_n;
+                      static int s_tr[MAX_SPURS_INST];
+                      if (cx && !g_kz3_trace_ctx && s_tr[j] < 2) { s_tr[j]++; g_kz3_trace_n = 600; g_kz3_trace_ctx = cx; } }
+                    u32 pcs[8] = {0}, cnt[8] = {0};
+                    for (int k = 0; k < 300 && cx; k++) {
+                        u32 pc = spu_pm_ctx_pc(cx); int m;
+                        for (m = 0; m < 8 && cnt[m] && pcs[m] != pc; m++) ;
+                        if (m < 8) { pcs[m] = pc; cnt[m]++; }
+                        Sleep(1);
+                    }
+                    char h[160] = ""; int ho = 0;
+                    for (int m = 0; m < 8 && cnt[m]; m++)
+                        ho += snprintf(h + ho, sizeof h - ho, " 0x%05X:%u", pcs[m], cnt[m]);
+                    fprintf(stderr, "[spurs-stuck] t=%llu \"%s\" wid=%u PM run not returned for %llu ms: %s pcs:%s\n",
+                            (unsigned long long)(now - s_t_start), s_inst[j].prefix, rw, (unsigned long long)d, b, h);
+                    fflush(stderr);
+                }
+            }
+            for (u32 w = 0; w < 16; w++) {
+                u8 cc = *(vm_base + ea + SPURS_WKL_CURCONT + w);
+                int running = t0 && rw == w;
+                if (!cc || running) { cc_since[j][w] = 0; continue; }
+                if (!cc_since[j][w]) { cc_since[j][w] = now; continue; }
+                if (now - cc_since[j][w] >= 1000 && now - cc_rep[j][w] >= 10000) {
+                    cc_rep[j][w] = now;
+                    fprintf(stderr, "[spurs-curcont] t=%llu \"%s\" wid=%u contention=%u for %llu ms with no run of it "
+                            "(running wid=%d) ready=%u state=%u\n", (unsigned long long)(now - s_t_start), s_inst[j].prefix, w, cc,
+                            (unsigned long long)(now - cc_since[j][w]), t0 ? (int)rw : -1,
+                            *(vm_base + ea + SPURS_WKL_READY1 + w), *(vm_base + ea + SPURS_WKL_STATE1 + w));
+                    fflush(stderr);
+                }
+            }
+        }
+    }
+    return 0;
+}
