+/* KZ3 patch 1013 (diagnostic): a short event trace of one SPU context, armed by the
+ * [spurs-stuck] watcher (cellSpurs.c): indirect branches and channel reads/writes. */
+void* volatile g_kz3_trace_ctx = 0;
+volatile long g_kz3_trace_n = 0;
+static void kz3_trace(spu_context* ctx, const char* what, uint32_t ch, uint32_t v)
+{
+    if ((void*)ctx != g_kz3_trace_ctx) return;
+    long n = __atomic_sub_fetch(&g_kz3_trace_n, 1, __ATOMIC_RELAXED);
+    if (n < 0) { g_kz3_trace_ctx = 0; return; }
+    fprintf(stderr, "[pmtrace] %s pc=0x%05X ch=%u v=0x%08X ev=0x%X/0x%X ie=%u parked=0x%X sstat=0x%X 12A0=%02X%02X 12C0=%02X%02X%02X%02X\n",
+            what, ctx->pc & SPU_LS_MASK, ch, v, ctx->event_status, ctx->event_mask, ctx->int_enable,
+            ctx->list_stall_mask, ctx->list_stall_stat, ctx->ls[0x12A2], ctx->ls[0x12A3],
+            ctx->ls[0x12C0], ctx->ls[0x12C1], ctx->ls[0x12C2], ctx->ls[0x12C3]);
+}
+static void spu_wrch_impl(spu_context* ctx, uint32_t channel, u128 value);
