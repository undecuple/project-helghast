+/* KZ3 patch 1013 (diagnostic): the SPURS instance lines (set by cellSpurs.c). An SPU atomic store
+ * that changes a wklCurrentContention byte (+0x20..+0x2F) is logged: only the HLE kernel should write
+ * those, so a change here is a stale-copy write-back. */
+uint32_t g_kz3_spurs_line[4];
+static void kz3_curcont_check(spu_context* ctx, uint32_t ea, const uint8_t* mem, const uint8_t* ls, const char* how)
+{
+    uint32_t line = ea & ~127u;
+    if (!line || (line != g_kz3_spurs_line[0] && line != g_kz3_spurs_line[1] &&
+                  line != g_kz3_spurs_line[2] && line != g_kz3_spurs_line[3])) return;
+    if (memcmp(mem + 0x20, ls + 0x20, 16) == 0) return;
+    static long s_n = 0;
+    long n = __atomic_add_fetch(&s_n, 1, __ATOMIC_RELAXED);
+    if (n > 64) return;
+    char b[160]; int o = 0;
+    for (int i = 0; i < 16; i++)
+        if (mem[0x20 + i] != ls[0x20 + i])
+            o += snprintf(b + o, sizeof b - o, " wid%d:%u->%u", i, mem[0x20 + i], ls[0x20 + i]);
+    fprintf(stderr, "[spurs-curcont] %s img=%d pc=0x%05X lr=0x%05X line=0x%08X changes contention:%s\n",
+            how, ctx->image_id, ctx->pc & SPU_LS_MASK, ctx->gpr[0]._u32[0] & SPU_LS_MASK, line, b);
+    fflush(stderr);
+}
