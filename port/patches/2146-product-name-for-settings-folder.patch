                           if (w_ > 0) o += (size_t)w_; } while (0)
-    PKB_PUT("# Project Helghast key bindings. Written with the defaults on the first start; edit and save, the game\n"
+    PKB_PUT("# " PS3RECOMP_PRODUCT_NAME " key bindings. Written with the defaults on the first start; edit and save, the game\n"
