 static void ts_unlock(void) { InterlockedExchange(&s_ts_lock, 0); }
 
+/* KZ3 patch 1066: cellSpursJoinTaskset returned at once, so a game that shuts a taskset down, joins it and creates a
+ * new one at the same address (KZ3's Bink: two tasksets at fixed EAs, re-created at every movie switch) had the old
+ * task (same taskset EA, same task id) still alive on its host thread next to the new one. Both wait in WAIT_SIGNAL
+ * on the same SIGNALLED bit, so the old one could consume the new task's first signal (or a quit signal and the new
+ * movie's signal merged into one latched bit), the new task waited forever and the PPU's Bink wait loop (0xCB8424,
+ * usleep(400) at lr 0xCB8594) never ended: the intermittent menu-movie stall. The old task's exit also cleared the new
+ * task's ready/enabled bits and running mark. Now each task thread remembers the taskset generation it was started
+ * in; Join waits (bounded) for the taskset's running, not parked, tasks to finish, then bumps the generation. A
+ * parked task of an older generation never consumes a signal again (it stays parked: on real SPURS a shut-down
+ * taskset's waiting tasks are never resumed) and its exit, if any, leaves the new tasks' state alone.
+ * KZ3_JOIN_TASKSET_OLD=1 = the old behaviour; KZ3_JOIN_TASKSET_MS = the wait bound (default 1000). */
+static _Thread_local uint32_t t_task_ts, t_task_gen;
+static int ts_join_old(void) { static int v = -1; if (v < 0) { const char* e = getenv("KZ3_JOIN_TASKSET_OLD"); v = (e && *e == '1'); } return v; }
+static int ts_find(uint32_t taskset_ea)
+{
+    for (int i = 0; i < TS_TRACK; i++) if (s_ts_run[i].ea == taskset_ea) return i;
+    return -1;
+}
+/* 1 when the calling task thread belongs to an older generation of taskset_ea (call under ts_lock). */
+static int ts_stale_locked(uint32_t taskset_ea)
+{
+    if (ts_join_old() || !taskset_ea || t_task_ts != taskset_ea) return 0;
+    int i = ts_find(taskset_ea);
+    return i >= 0 && s_ts_run[i].gen != t_task_gen;
+}
+static int ts_stale(uint32_t taskset_ea) { ts_lock(); int r = ts_stale_locked(taskset_ea); ts_unlock(); return r; }
+static void ts_parked_add(uint32_t taskset_ea, int d)
+{
+    if (ts_join_old()) return;
+    ts_lock();
+    int i = ts_find(taskset_ea);
+    if (i >= 0 && !ts_stale_locked(taskset_ea)) s_ts_run[i].parked += d;
+    ts_unlock();
+}
+/* The calling host thread runs a task of taskset_ea's current generation (spu_async_run; host tests). */
+void spu_taskset_bind_thread(uint32_t taskset_ea)
+{
+    if (!taskset_ea) return;
+    ts_lock(); int i = ts_find(taskset_ea);
+    t_task_ts = taskset_ea; t_task_gen = i >= 0 ? s_ts_run[i].gen : 0;
+    ts_unlock();
+}
+int spu_taskset_join_wait(uint32_t taskset_ea)
+{
+    if (ts_join_old() || !taskset_ea) return -1;
+    static unsigned max_ms = 0;
+    if (!max_ms) { const char* e = getenv("KZ3_JOIN_TASKSET_MS"); max_ms = e && atoi(e) > 0 ? (unsigned)atoi(e) : 1000u; }
+    unsigned waited = 0; int busy = 0, parked = 0, marks = 0;
+    for (;;) {
+        ts_lock();
+        int i = ts_find(taskset_ea);
+        marks = 0; parked = 0;
+        if (i >= 0) {
+            for (int b = 0; b < 16; b++) marks += __builtin_popcount(s_ts_run[i].running[b]);
+            parked = s_ts_run[i].parked;
+        }
+        busy = marks - parked;
+        if (busy <= 0 || waited >= max_ms) {
+            if (i >= 0) {                       /* new generation: older tasks are cut off */
+                s_ts_run[i].gen++;
+                s_ts_run[i].parked = 0;
+                memset(s_ts_run[i].running, 0, sizeof s_ts_run[i].running);
+            }
+            ts_unlock();
+            break;
+        }
+        ts_unlock();
+        Sleep(1); waited++;
+    }
+    static volatile LONG n;
+    LONG k = InterlockedIncrement(&n);
+    if (k <= 32 || (k % 64) == 0 || busy > 0)
+        fprintf(stderr, "[ts-join] #%ld taskset 0x%08X: waited %u ms, %d running, %d parked task(s) cut off%s\n",
+                (long)k, taskset_ea, waited, busy > 0 ? busy : 0, parked, busy > 0 ? " (TIMEOUT)" : "");
+    return busy > 0 ? busy : 0;
+}
