+++ b/libs/video/rsx_tex_lru.h
@@ -0,0 +1,51 @@
+/* KZ3 patch 2075: exact LRU order over the live-draw texture cache in O(1).
+ *
+ * The cache picked its eviction victim by scanning every entry for the smallest last_use_serial: 8,192 entries
+ * (~850 KB of texcache_t) per miss once the cache is full. KZ3's SPU jobs write per-object 8x8 fp16 parameter
+ * blocks into a ring in main memory, so every frame binds a few hundred of them at offsets the cache has not seen
+ * (K4: 2,400 new entries a second); each one paid the full scan. This list keeps the same order the serials give
+ * (touch = move to the front, victim = the back), so the victim is the one the scan would have found.
+ *
+ * Intrusive doubly linked list over entry indices; the caller owns the link array (one per entry).
+ * Pure C, no allocation, no locking (the walker thread owns the cache). Host test: tools/smoke/test_tex_lru.sh. */
+#ifndef RSX_TEX_LRU_H
+#define RSX_TEX_LRU_H
+
+#include <stdint.h>
+
+#define RSX_TEX_LRU_NIL 0xFFFFFFFFu
+
+typedef struct { uint32_t prev, next; } rsx_tex_lru_link;   /* prev = more recent, next = less recent */
+typedef struct { uint32_t head, tail; } rsx_tex_lru;        /* head = most recent, tail = least recent */
+
+static inline void rsx_tex_lru_init(rsx_tex_lru* l) { l->head = l->tail = RSX_TEX_LRU_NIL; }
+
+static inline void rsx_tex_lru_unlink(rsx_tex_lru* l, rsx_tex_lru_link* k, uint32_t i)
+{
+    const uint32_t p = k[i].prev, n = k[i].next;
+    if (p != RSX_TEX_LRU_NIL) k[p].next = n; else l->head = n;
+    if (n != RSX_TEX_LRU_NIL) k[n].prev = p; else l->tail = p;
+    k[i].prev = k[i].next = RSX_TEX_LRU_NIL;
+}
+
+/* i must not be in the list */
+static inline void rsx_tex_lru_push_front(rsx_tex_lru* l, rsx_tex_lru_link* k, uint32_t i)
+{
+    k[i].prev = RSX_TEX_LRU_NIL;
+    k[i].next = l->head;
+    if (l->head != RSX_TEX_LRU_NIL) k[l->head].prev = i; else l->tail = i;
+    l->head = i;
+}
+
+/* i is in the list: make it the most recent */
+static inline void rsx_tex_lru_touch(rsx_tex_lru* l, rsx_tex_lru_link* k, uint32_t i)
+{
+    if (l->head == i) return;
+    rsx_tex_lru_unlink(l, k, i);
+    rsx_tex_lru_push_front(l, k, i);
+}
+
+/* least recently used entry, RSX_TEX_LRU_NIL when empty */
+static inline uint32_t rsx_tex_lru_victim(const rsx_tex_lru* l) { return l->tail; }
+
+#endif
