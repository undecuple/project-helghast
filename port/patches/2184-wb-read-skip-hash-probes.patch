+/* Patch 2184 (RSX pass 162): LD_WB_READ=1 measures, per written-back main-memory surface, when the walker's guest store
+ * finished and when the first SPU DMA GET of it came (slack = the room a deferred store would have); LD_WB_SKIP=list skips
+ * the guest store of those surfaces (main-memory offsets); LD_WB_HASH=1 hashes the guest bytes of idx0 and idx9 at the
+ * first composite bind of each frame. DIAGNOSTIC, all default off; pure core in rsx_wb_probe.h (host test
+ * tools/smoke/test_wb_probe.sh). The GET/PUT feed comes from the SPU DMA hooks installed in cellGcmSys.c. */
+static rsx_wbp g_wbp;
+static volatile int g_wbp_on = -1;
+static u32 g_wbp_n = 100, g_wbp_frames, g_wbp_lines, g_wbp_lines_max = 20000;
+static volatile u64 g_wbp_anchor;
+static int g_wbs_n = -1;
+static u32 g_wbs_list[RSX_WBP_SKIP_MAX];
+static u64 ld_wbp_now(void)
+{
+    LARGE_INTEGER f, c;
+    QueryPerformanceFrequency(&f); QueryPerformanceCounter(&c);
+    return (u64)(c.QuadPart / f.QuadPart) * 1000000000ull + (u64)(c.QuadPart % f.QuadPart) * 1000000000ull / (u64)f.QuadPart;
+}
+static int ld_wbp_enabled(void)
+{
+    int v = g_wbp_on;
+    if (v < 0) {   /* idempotent: the SPU threads and the walker may both get here first */
+        const char* e = getenv("LD_WB_READ"); v = e && atoi(e) > 0 ? 1 : 0;
+        const char* n = getenv("LD_WB_READ_N"); if (n && atoi(n) > 0) g_wbp_n = (u32)atoi(n);
+        const char* ln = getenv("LD_WB_READ_LINES"); if (ln && atoi(ln) > 0) g_wbp_lines_max = (u32)atoi(ln);
+        if (v) fprintf(stderr, "[wb-read] LD_WB_READ=1 (summary every %u frames, up to %u lines); DIAGNOSTIC\n", g_wbp_n, g_wbp_lines_max);
+        g_wbp_on = v;
+    }
+    return v;
+}
+static int ld_wbs_skip(const surface_t* sf)
+{
+    if (g_wbs_n < 0) {
+        const char* e = getenv("LD_WB_SKIP"); unsigned bad = 0;
+        const int n = e && e[0] ? (int)rsx_wbs_parse(e, g_wbs_list, RSX_WBP_SKIP_MAX, &bad) : 0;
+        if (e && e[0]) fprintf(stderr, "[wb-skip] LD_WB_SKIP=%s -> %d surface offset(s), %u bad token(s); DIAGNOSTIC, the guest bytes stay stale\n", e, n, bad);
+        g_wbs_n = n;
+    }
+    return g_wbs_n && sf->location == 1u && rsx_wbs_has(g_wbs_list, (unsigned)g_wbs_n, sf->offset);
