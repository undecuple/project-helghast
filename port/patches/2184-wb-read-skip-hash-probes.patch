+/* Walker thread, right after a surface's bytes reached guest memory. */
+static volatile u64 g_wbp_batch_t0;   /* start of the latest ld_writeback_batch (walker thread) */
+static void ld_wbp_open(u32 offset, u32 size)
+{
+    rsx_wbp_cycle c;
+    if (!rsx_wbp_store(&g_wbp, offset, size, g_ld_frames, ld_wbp_now(), g_wbp_anchor, &c)) {
+        static u32 nl; if (nl++ < 4) fprintf(stderr, "[wb-read] 0x%08X not tracked (slot table full or extent too large)\n", offset);
+        return;
