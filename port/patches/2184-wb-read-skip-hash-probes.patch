+    rsx_wbp_set_submit(&g_wbp, offset, g_wbp_batch_t0);
+    if (!c.valid || g_wbp_lines >= g_wbp_lines_max) return;
+    g_wbp_lines++;
+    char fg[32] = "-", job[32] = "-", put[32] = "-", wk[32] = "-", z[32] = "";
