diff --git a/libs/video/rsx_wb_probe.h b/libs/video/rsx_wb_probe.h
new file mode 100644
index 00000000..bd9bff0e
--- /dev/null
+++ b/libs/video/rsx_wb_probe.h
@@ -0,0 +1,252 @@
+/* KZ3 patch 2184 (RSX pass 162): measurement switches for the main-memory surface write-backs. DIAGNOSTIC, default off.
+ *   LD_WB_READ=1   per cycle (store k .. store k+1) of every written-back main surface: when the walker's guest store
+ *                  finished, when the first SPU GET of the surface came, how many GETs, how many of them read bytes no
+ *                  SPU PUT had overwritten since the store ("dirty" GETs; for idx3 that is gets_before_zero).
+ *   LD_WB_SKIP=a,b skip the guest store of the surfaces at these main-memory offsets (hex 0x.. or decimal).
+ *   LD_WB_HASH=1   hash of the guest bytes of idx0 and idx9 at the walker's first composite bind of each frame.
+ * Pure bookkeeping (no D3D, no clock of its own): host test tools/smoke/test_wb_probe.sh. All times are ns on one clock
+ * chosen by the caller; the caller subtracts the flip anchor. Thread model: stores come from the walker thread, GETs and
+ * PUTs from SPU threads, so every entry point takes the probe's spinlock. */
+#ifndef RSX_WB_PROBE_H
+#define RSX_WB_PROBE_H
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#define RSX_PATCH_2184 1
+#define RSX_WBP_SLOTS 8u
+#define RSX_WBP_LINE 128u               /* PUT coverage granularity (one SPU cache line) */
+#define RSX_WBP_MAXLINES (0x384000u / RSX_WBP_LINE)   /* the largest surface: 1280x720x4 */
+#define RSX_WBP_SAMPLES 4096u
+#define RSX_WBP_SKIP_MAX 16u
+
+/* ---- LD_WB_SKIP list ---- */
+/* Comma/space separated numbers (strtoul base 0: 0x.. hex or decimal). A token that is not a whole number counts as bad
+ * and is ignored. Returns the number of entries stored (at most cap); *bad (may be NULL) = unparsable tokens. */
+static inline unsigned rsx_wbs_parse(const char* s, uint32_t* out, unsigned cap, unsigned* bad)
+{
+    unsigned n = 0, nb = 0;
+    while (s && *s) {
+        while (*s == ',' || *s == ' ') s++;
+        const char* e = s;
+        while (*e && *e != ',' && *e != ' ') e++;
+        if (e > s) {
+            char tmp[24];
+            const size_t len = (size_t)(e - s);
+            if (len >= sizeof tmp) nb++;
+            else {
+                memcpy(tmp, s, len); tmp[len] = 0;
+                char* end = NULL;
+                const unsigned long v = strtoul(tmp, &end, 0);
+                if (end == tmp || *end || tmp[0] == '-' || v > 0xFFFFFFFFul) nb++;
+                else if (n < cap) out[n++] = (uint32_t)v;
+                else nb++;
+            }
+        }
+        s = e;
+    }
+    if (bad) *bad = nb;
+    return n;
+}
+static inline int rsx_wbs_has(const uint32_t* list, unsigned n, uint32_t off)
+{
+    for (unsigned i = 0; i < n; i++) if (list[i] == off) return 1;
+    return 0;
+}
+
+/* ---- guest byte hash (LD_WB_HASH): 64-bit, 8 bytes per step, tail bytes folded in; not cryptographic ---- */
+static inline uint64_t rsx_wbp_hash64(const uint8_t* p, uint32_t n)
+{
+    uint64_t h = 0xcbf29ce484222325ull ^ n;
+    uint32_t i = 0;
+    for (; i + 8u <= n; i += 8u) {
+        uint64_t w; memcpy(&w, p + i, 8);
+        h = (h ^ w) * 0x100000001b3ull;
+        h ^= h >> 29;
+    }
+    for (; i < n; i++) { h = (h ^ p[i]) * 0x100000001b3ull; }
+    return h ^ (h >> 32);
+}
+
+/* ---- slack bookkeeping ---- */
+typedef struct {
+    uint32_t off, size;       /* main-memory offset and byte extent of the stored surface; 0 = unused slot */
+    int stored;               /* a store happened and its cycle is open */
+    uint32_t frame;           /* frame number of the store */
+    uint64_t store_t, anchor; /* ns: store completion, flip anchor of its frame */
+    uint64_t first_get_t;     /* 0 = none yet */
+    uint32_t gets, dirty_gets;
+    uint32_t pc, img;         /* of the first GET: SPU image id and spu->pc at the DMA (pc may be stale, ASSUMPTION) */
+    uint64_t first_put_t;     /* first PUT overlapping the surface after the store, 0 = none */
+    uint32_t puts;
+    uint64_t first_walker_t;  /* first bind of the surface as a texture by the walker after the store, 0 = none */
+    uint32_t walker_binds;
+    uint64_t submit_t;        /* walker: start of the batch whose copy+wait+store produced this store (0 = unknown) */
+    uint64_t usercmd_t;       /* walker: first 0xEB00 user command queued after the store, 0 = none yet */
+    uint8_t written[RSX_WBP_MAXLINES / 8u + 1u];   /* lines fully overwritten by a PUT since the store */
+    /* statistics since the last summary */
+    uint32_t cycles, read_cycles;
+    double slack_ms[RSX_WBP_SAMPLES];
+    uint32_t nslack;
+} rsx_wbp_slot;
+
+typedef struct { rsx_wbp_slot s[RSX_WBP_SLOTS]; volatile int lock; } rsx_wbp;
+
+/* One closed cycle, for the caller's log line. */
+typedef struct {
+    uint32_t off, frame, gets, dirty_gets, puts, pc, img;
+    uint32_t walker_binds;
+    int valid, has_get, has_put, has_walker, has_submit, has_usercmd;
+    double store_ms, first_get_ms, slack_ms, first_put_ms, first_walker_ms, submit_ms, usercmd_ms, gap_ms, wait_ms;   /* relative to the frame's flip anchor */
+} rsx_wbp_cycle;
+
+static inline void rsx_wbp_lock(rsx_wbp* p) { while (__atomic_exchange_n(&p->lock, 1, __ATOMIC_ACQUIRE)) { } }
+static inline void rsx_wbp_unlock(rsx_wbp* p) { __atomic_store_n(&p->lock, 0, __ATOMIC_RELEASE); }
+static inline void rsx_wbp_init(rsx_wbp* p) { memset(p, 0, sizeof *p); }
+static inline double rsx_wbp_ms(uint64_t t, uint64_t anchor) { return (double)((int64_t)(t - anchor)) / 1e6; }
+
+static inline void rsx_wbp_close(rsx_wbp_slot* s, rsx_wbp_cycle* out)
+{
+    memset(out, 0, sizeof *out);
+    if (!s->stored) return;
+    out->valid = 1; out->off = s->off; out->frame = s->frame; out->gets = s->gets; out->dirty_gets = s->dirty_gets;
+    out->puts = s->puts; out->pc = s->pc; out->img = s->img;
+    out->store_ms = rsx_wbp_ms(s->store_t, s->anchor);
+    s->cycles++;
+    if (s->first_get_t) {
+        out->has_get = 1; out->first_get_ms = rsx_wbp_ms(s->first_get_t, s->anchor);
+        out->slack_ms = (double)((int64_t)(s->first_get_t - s->store_t)) / 1e6;
+        s->read_cycles++;
+        if (s->nslack < RSX_WBP_SAMPLES) s->slack_ms[s->nslack++] = out->slack_ms;
+    }
+    if (s->first_put_t) { out->has_put = 1; out->first_put_ms = rsx_wbp_ms(s->first_put_t, s->anchor); }
+    out->walker_binds = s->walker_binds;
+    if (s->submit_t) { out->has_submit = 1; out->submit_ms = rsx_wbp_ms(s->submit_t, s->anchor); out->wait_ms = (double)((int64_t)(s->store_t - s->submit_t)) / 1e6; }
+    if (s->usercmd_t) {   /* gap = the walker time between the batch start and the 0xEB00 queue: room to hide the GPU wait in */
+        out->has_usercmd = 1; out->usercmd_ms = rsx_wbp_ms(s->usercmd_t, s->anchor);
+        if (s->submit_t) out->gap_ms = (double)((int64_t)(s->usercmd_t - s->submit_t)) / 1e6;
+    }
+    if (s->first_walker_t) { out->has_walker = 1; out->first_walker_ms = rsx_wbp_ms(s->first_walker_t, s->anchor); }
+    s->stored = 0;
+}
+
+/* The walker's guest store of surface [off, off+size) finished at t. Closes the previous cycle of that surface (returned in
+ * *prev when the caller wants a log line) and opens a new one. Returns 0 when the slot table is full. */
+static inline int rsx_wbp_store(rsx_wbp* p, uint32_t off, uint32_t size, uint32_t frame, uint64_t t, uint64_t anchor,
+                                rsx_wbp_cycle* prev)
+{
+    int ok = 1;
+    rsx_wbp_lock(p);
+    rsx_wbp_slot* s = NULL;
+    for (unsigned i = 0; i < RSX_WBP_SLOTS; i++) if (p->s[i].off == off) { s = &p->s[i]; break; }
+    if (!s) for (unsigned i = 0; i < RSX_WBP_SLOTS; i++) if (!p->s[i].off) { s = &p->s[i]; break; }
+    if (!s || !off || size > RSX_WBP_MAXLINES * RSX_WBP_LINE) { ok = 0; if (prev) memset(prev, 0, sizeof *prev); }
+    else {
+        rsx_wbp_cycle tmp;
+        rsx_wbp_close(s, prev ? prev : &tmp);
+        s->off = off; s->size = size; s->stored = 1; s->frame = frame; s->store_t = t; s->anchor = anchor;
+        s->first_get_t = 0; s->gets = s->dirty_gets = 0; s->pc = s->img = 0; s->first_put_t = 0; s->puts = 0;
+        s->first_walker_t = 0; s->walker_binds = 0; s->submit_t = 0; s->usercmd_t = 0;
+        memset(s->written, 0, sizeof s->written);
+    }
+    rsx_wbp_unlock(p);
+    return ok;
+}
+
+/* The batch that produced the store of surface `off` started at t (call right after rsx_wbp_store). */
+static inline void rsx_wbp_set_submit(rsx_wbp* p, uint32_t off, uint64_t t)
+{
+    rsx_wbp_lock(p);
+    for (unsigned i = 0; i < RSX_WBP_SLOTS; i++) if (p->s[i].off == off && p->s[i].stored) p->s[i].submit_t = t ? t : 1;
+    rsx_wbp_unlock(p);
+}
+/* The walker is about to queue the 0xEB00 user command at t: the first one after a store is kept for every open cycle. */
+static inline void rsx_wbp_usercmd(rsx_wbp* p, uint64_t t)
+{
+    rsx_wbp_lock(p);
+    for (unsigned i = 0; i < RSX_WBP_SLOTS; i++) if (p->s[i].off && p->s[i].stored && !p->s[i].usercmd_t) p->s[i].usercmd_t = t ? t : 1;
+    rsx_wbp_unlock(p);
+}
+
+/* A SPU DMA GET of [ea_off, ea_off+len) in main-memory offset space, at t. */
+static inline void rsx_wbp_get(rsx_wbp* p, uint32_t ea_off, uint32_t len, uint64_t t, uint32_t img, uint32_t pc)
+{
+    if (!len) return;
+    const uint64_t g0 = ea_off, g1 = g0 + len;
+    rsx_wbp_lock(p);
+    for (unsigned i = 0; i < RSX_WBP_SLOTS; i++) {
+        rsx_wbp_slot* s = &p->s[i];
+        if (!s->off || !s->stored) continue;
+        const uint64_t s0 = s->off, s1 = s0 + s->size;
+        if (!(g0 < s1 && s0 < g1)) continue;
+        if (!s->first_get_t) { s->first_get_t = t ? t : 1; s->img = img; s->pc = pc; }
+        s->gets++;
+        /* dirty: some overlapped line still holds the stored bytes (not wholly overwritten by a PUT since the store) */
+        const uint64_t a = g0 > s0 ? g0 : s0, b = g1 < s1 ? g1 : s1;
+        int dirty = 0;
+        for (uint64_t l = (a - s0) / RSX_WBP_LINE; l <= (b - 1u - s0) / RSX_WBP_LINE; l++)
+            if (!(s->written[l >> 3] & (1u << (l & 7u)))) { dirty = 1; break; }
+        s->dirty_gets += (uint32_t)dirty;
+    }
+    rsx_wbp_unlock(p);
+}
+
+/* The walker itself binds the surface at [off, off+len) as a texture at t (its own read of the guest bytes: hash + decode). */
+static inline void rsx_wbp_walker(rsx_wbp* p, uint32_t off, uint32_t len, uint64_t t)
+{
+    const uint64_t g0 = off, g1 = g0 + (len ? len : 1u);
+    rsx_wbp_lock(p);
+    for (unsigned i = 0; i < RSX_WBP_SLOTS; i++) {
+        rsx_wbp_slot* s = &p->s[i];
+        if (!s->off || !s->stored) continue;
+        if (!(g0 < (uint64_t)s->off + s->size && s->off < g1)) continue;
+        if (!s->first_walker_t) s->first_walker_t = t ? t : 1;
+        s->walker_binds++;
+    }
+    rsx_wbp_unlock(p);
+}
+
+/* A SPU DMA PUT of [ea_off, ea_off+len) at t: marks the lines it covers completely. */
+static inline void rsx_wbp_put(rsx_wbp* p, uint32_t ea_off, uint32_t len, uint64_t t)
+{
+    if (!len) return;
+    const uint64_t g0 = ea_off, g1 = g0 + len;
+    rsx_wbp_lock(p);
+    for (unsigned i = 0; i < RSX_WBP_SLOTS; i++) {
+        rsx_wbp_slot* s = &p->s[i];
+        if (!s->off || !s->stored) continue;
+        const uint64_t s0 = s->off, s1 = s0 + s->size;
+        if (!(g0 < s1 && s0 < g1)) continue;
+        if (!s->first_put_t) s->first_put_t = t ? t : 1;
+        s->puts++;
+        const uint64_t a = g0 > s0 ? g0 : s0, b = g1 < s1 ? g1 : s1;
+        /* line l spans [s0 + l*LINE, s0 + (l+1)*LINE); covered when a <= its start and its end <= b */
+        uint64_t l = (a - s0 + RSX_WBP_LINE - 1u) / RSX_WBP_LINE;
+        for (; (l + 1u) * RSX_WBP_LINE <= b - s0 && l < RSX_WBP_MAXLINES; l++) s->written[l >> 3] |= (uint8_t)(1u << (l & 7u));
+    }
+    rsx_wbp_unlock(p);
+}
+
+static int rsx_wbp_dcmp(const void* a, const void* b) { const double x = *(const double*)a, y = *(const double*)b; return (x > y) - (x < y); }
+
+/* Summary of one slot since the last reset (then resets the statistics). Returns 0 for an empty/unused slot.
+ * median/min/max of slack (first GET - store done, ms) over the cycles that were read. */
+static inline int rsx_wbp_summary(rsx_wbp* p, unsigned slot, uint32_t* off, uint32_t* cycles, uint32_t* read_cycles,
+                                  double* med, double* mn, double* mx)
+{
+    rsx_wbp_lock(p);
+    rsx_wbp_slot* s = &p->s[slot % RSX_WBP_SLOTS];
+    const int ok = s->off && s->cycles;
+    if (ok) {
+        *off = s->off; *cycles = s->cycles; *read_cycles = s->read_cycles;
+        if (s->nslack) {
+            qsort(s->slack_ms, s->nslack, sizeof s->slack_ms[0], rsx_wbp_dcmp);
+            *mn = s->slack_ms[0]; *mx = s->slack_ms[s->nslack - 1u];
+            *med = (s->nslack & 1u) ? s->slack_ms[s->nslack / 2u]
+                                    : 0.5 * (s->slack_ms[s->nslack / 2u - 1u] + s->slack_ms[s->nslack / 2u]);
+        } else *med = *mn = *mx = 0.0;
+    }
+    s->cycles = s->read_cycles = s->nslack = 0;
+    rsx_wbp_unlock(p);
+    return ok;
+}
+#endif
