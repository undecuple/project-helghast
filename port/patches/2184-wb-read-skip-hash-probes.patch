+/* Any thread: a SPU GET/PUT of main memory (offset space of the surface table). */
+void rsx_live_draw_wbp_get(u32 location, u32 offset, u32 size, u32 img, u32 pc)
+{
+    if (location != 1u || !ld_wbp_enabled()) return;
+    rsx_wbp_get(&g_wbp, offset, size, ld_wbp_now(), img, pc);
+}
+void rsx_live_draw_wbp_put(u32 location, u32 offset, u32 size)
+{
+    if (location != 1u || !ld_wbp_enabled()) return;
+    rsx_wbp_put(&g_wbp, offset, size, ld_wbp_now());
