+/* KZ3 patch 5003: sys_net_if_ctl (NID 0x27FB339D = ps3_compute_nid("sys_net_if_ctl")), (s32 prefix, s32 cmd,
+ * void* arg, s32 len), the interface query KZ3 1.14 calls four times at 0x4d51bc..0x4d5258 into a table it has
+ * already filled with defaults, discarding each result. Not modelled: fail like every other call here with errno
+ * ENETDOWN (BSD 50), so nothing is written into the caller's buffer. */
+int32_t sys_net_if_ctl(int32_t prefix, int32_t cmd, uint32_t arg, int32_t len)
+{
+    (void)prefix; (void)cmd; (void)arg; (void)len;
+    return fail(50);
+}
