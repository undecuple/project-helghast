 }
+
+/* ---- KZ3 patch 5003: the twelve sceNpCommerce2 imports KZ3 1.14 adds that had no definition here --------------
+ * NIDs equal ps3_compute_nid(name) (checked: tools/assets/test_imports114.py). Offline there is no store: requests
+ * fail the way CreateSessionStart above already does. KZ3 1.14's store code (0x179600-0x17ae60) tests only the sign
+ * of every result here and parks its store state machine in its error state (state 4, code kept) on a negative one,
+ * so the store UI stays hidden; the exact code value does not matter to it (rizin pdg of 0x17ad30, 0x1795c8,
+ * 0x17a3cc). ASSUMPTION: the 0x800244xx values in sceNpCommerce2.h are this tree's, not checked against an SDK
+ * header (RPCS3 keeps sceNpCommerce2 errors at 0x800230xx). */
+static int s_bgdl_available = 0;   /* SDK: a local per-title setting, no network involved */
+
+/* (bool* bgdlAvailability): KZ3 ignores the return value at 0x17ade8 and reads the bool, so it must be written. */
+s32 sceNpCommerce2GetBGDLAvailability(u32 bgdlAvailability)
+{
+    if (!bgdlAvailability) return SCE_NP_COMMERCE2_ERROR_INVALID_ARGUMENT;
+    vm_write8(bgdlAvailability, (u8)s_bgdl_available);
+    return CELL_OK;
+}
+
+/* (bool bgdlAvailability) */
+s32 sceNpCommerce2SetBGDLAvailability(u32 bgdlAvailability)
+{
+    s_bgdl_available = (bgdlAvailability & 0xFF) != 0;
+    return CELL_OK;
+}
