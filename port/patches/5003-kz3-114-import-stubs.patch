 {
     return np_drm_is_available(k_licensee, drm_path);
 }
+
+/* ---- KZ3 patch 5003: three sceNp imports KZ3 1.14 adds (NIDs = ps3_compute_nid(name)) ------------------------ */
+
+/* (const char* content_id). KZ3 1.14 at 0x528d88 maps the result: 0 -> 0, LICENSE_NOT_FOUND (0x80029521) or a
+ * positive value -> 1, any other negative -> 2 (rizin pdg). Its EBOOT carries the disc content id
+ * UP9000-BCUS98234_00 next to the digital NPUA70167 one; the disc is the full game, so report the upgrade license as
+ * present (CELL_OK). ASSUMPTION: 0 is "licensed" (RPCS3 returns CELL_OK when the license is found and
+ * SCE_NP_DRM_ERROR_LICENSE_NOT_FOUND otherwise; the game's own folding of 0x80029521 with "not 0" fits that). */
+s32 sceNpDrmVerifyUpgradeLicense(u32 content_id)
+{
+    if (!content_id) return SCE_NP_ERROR_INVALID_ARGUMENT;
+    return CELL_OK;
+}
+
+/* (void): opens the store's purchase flow for a trial. Not available offline. KZ3 1.14 discards the result
+ * (0x528e14). ASSUMPTION: SCE_NP_ERROR_OFFLINE is the fitting code; no SDK header here lists this function's errors. */
+s32 sceNpDrmExecuteGamePurchase(void)
+{
+    return SCE_NP_ERROR_OFFLINE;
+}
