+/*
+ * KZ3 patch 5003: sys_crashdump, the one-function library KZ3 1.14 imports.
+ *
+ * NID 0xB20F87B3 = ps3_compute_nid("sys_crash_dump_set_user_log_area") (found by hashing candidate names; checked by
+ * tools/assets/test_imports114.py). KZ3 1.14 calls it at 0x8d094 as (u8 index, entry*) with entry holding a guest
+ * address and size, and treats 0 as success. A crash dump is never written here, so the area is accepted and
+ * ignored.
+ */
+#include <stdint.h>
+
+int32_t sys_crash_dump_set_user_log_area(uint32_t index, uint32_t new_entry)
+{
+    (void)index; (void)new_entry;
+    return 0;   /* CELL_OK */
+}
