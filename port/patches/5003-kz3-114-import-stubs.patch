+/* ---- KZ3 patch 5003: the two presence "2" variants KZ3 1.14 imports (NIDs = ps3_compute_nid(name)). They follow
+ * their version-1 siblings above: no friends offline, own presence accepted. KZ3 1.14 breaks out of its friend loop
+ * on a negative GetFriendPresenceByIndex2 (0x1748fc, rizin pdg). */
+s32 sceNpBasicGetFriendPresenceByIndex2(u32 index, u32 user, u32 presence, u32 options)
+{
+    (void)index; (void)user; (void)presence; (void)options;
+    if (!s_initialized)
+        return (s32)SCE_NP_BASIC_ERROR_NOT_INITIALIZED;
