diff --git a/runtime/diag/kz3_wait_acct.c b/runtime/diag/kz3_wait_acct.c
new file mode 100644
index 00000000..b8cb8164
--- /dev/null
+++ b/runtime/diag/kz3_wait_acct.c
@@ -0,0 +1,326 @@
+/* KZ3 patch 1032 (diagnostic, opt-in): per-thread wait accounting. See kz3_wait_acct.h.
+ *
+ * Each host thread owns one record; only that thread writes its slots (no locks on the
+ * hot path), the printer thread reads them racily and prints differences against its own
+ * snapshot. A torn read can misplace one sample in one window; the totals stay right. */
+#include "kz3_wait_acct.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#ifdef _WIN32
+#  include <windows.h>
+#else
+#  include <pthread.h>
+#  include <time.h>
+#  include <unistd.h>
+#endif
+
+int g_kz3_wacct = -1;
+
+enum { WA_SLOTS = 1024, WA_THREADS = 96 };
+typedef struct { volatile uint64_t key; volatile uint64_t ns; volatile uint64_t n; } wa_slot;
+typedef struct {
+    char name[40];
+    unsigned long ostid;
+    int depth;
+    volatile uint64_t top_ns[KZ3_WA_NKIND], top_n[KZ3_WA_NKIND];
+    int job_img; uint64_t job_t0;
+    wa_slot tab[WA_SLOTS];
+    /* printer-owned snapshot */
+    uint64_t p_ns[WA_SLOTS], p_n[WA_SLOTS], p_top_ns[KZ3_WA_NKIND], p_top_n[KZ3_WA_NKIND];
+} wa_thr;
+
+static wa_thr* s_thr[WA_THREADS];
+static volatile long s_nthr = 0;
+static volatile long s_flips = 0;
+static uint64_t s_t0;
+
+#ifdef _WIN32
+static DWORD s_tls = TLS_OUT_OF_INDEXES;
+static LARGE_INTEGER s_qf;
+uint64_t kz3_wacct_now(void)
+{
+    LARGE_INTEGER c; QueryPerformanceCounter(&c);
+    return (uint64_t)((double)c.QuadPart * 1e9 / (double)s_qf.QuadPart);
+}
+static wa_thr* tls_get(void) { return (wa_thr*)TlsGetValue(s_tls); }
+static void tls_set(wa_thr* t) { TlsSetValue(s_tls, t); }
+static unsigned long os_tid(void) { return (unsigned long)GetCurrentThreadId(); }
+#else
+static __thread wa_thr* s_me;
+uint64_t kz3_wacct_now(void)
+{
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+static wa_thr* tls_get(void) { return s_me; }
+static void tls_set(wa_thr* t) { s_me = t; }
+static unsigned long os_tid(void) { return (unsigned long)pthread_self(); }
+#endif
+
+static wa_thr* me(void)
+{
+    wa_thr* t = tls_get();
+    if (t) return t;
+    long i = __sync_fetch_and_add(&s_nthr, 1);
+    if (i >= WA_THREADS) return NULL;
+    t = (wa_thr*)calloc(1, sizeof *t);
+    if (!t) return NULL;
+    t->ostid = os_tid();
+    s_thr[i] = t;
+    tls_set(t);
+    return t;
+}
+
+static wa_slot* slot(wa_thr* t, int kind, uint32_t site)
+{
+    uint64_t key = ((uint64_t)(kind + 1) << 32) | site;
+    uint32_t h = (uint32_t)((key * 0x9E3779B97F4A7C15ull) >> 54) & (WA_SLOTS - 1);
+    for (int p = 0; p < WA_SLOTS - 1; p++) {
+        wa_slot* s = &t->tab[(h + p) & (WA_SLOTS - 1)];
+        if (s->key == key) return s;
+        if (!s->key) { s->key = key; return s; }
+    }
+    return NULL;
+}
+
+static void add(wa_thr* t, int kind, uint32_t site, uint64_t ns, uint64_t n)
+{
+    wa_slot* s = slot(t, kind, site);
+    if (s) { s->ns += ns; s->n += n; }
+}
+
+uint64_t kz3_wacct_begin_slow(void)
+{
+    wa_thr* t = me();
+    if (!t) return 0;
+    t->depth++;
+    uint64_t v = kz3_wacct_now();
+    return v ? v : 1;
+}
+
+void kz3_wacct_end(int kind, uint32_t site, uint64_t t0)
+{
+    if (!t0) return;
+    wa_thr* t = tls_get();
+    if (!t) return;
+    uint64_t d = kz3_wacct_now() - t0;
+    add(t, kind, site, d, 1);
+    if (--t->depth == 0) { t->top_ns[kind] += d; t->top_n[kind]++; }
+}
+
+void kz3_wacct_note(int kind, uint32_t site, uint64_t ns)
+{
+    if (!kz3_wacct_on()) return;
+    wa_thr* t = me();
+    if (t) add(t, kind, site, ns, 1);
+}
+
+void kz3_wacct_job(int image)
+{
+    if (!kz3_wacct_on()) return;
+    wa_thr* t = me();
+    if (!t || t->job_img == image) return;
+    uint64_t now = kz3_wacct_now();
+    if (t->job_img) add(t, KZ3_WA_JOB, (uint32_t)t->job_img, now - t->job_t0, 0);
+    t->job_img = image; t->job_t0 = now;
+    if (image) add(t, KZ3_WA_JOB, (uint32_t)image, 0, 1);
+}
+
+/* Names this host thread. If a record of that name exists already, this thread takes
+ * it over: short-lived threads that run one after another (the per-pass policy-module
+ * workers) then share one record instead of using one each. The previous owner must
+ * be finished (true for the workers: the kernel joins them each pass). */
+void kz3_wacct_name(const char* name)
+{
+    if (!kz3_wacct_on()) return;
+    static volatile long lock = 0;
+    while (__sync_lock_test_and_set(&lock, 1)) { }
+    long nt = s_nthr; if (nt > WA_THREADS) nt = WA_THREADS;
+    for (long i = 0; i < nt; i++)
+        if (s_thr[i] && strncmp(s_thr[i]->name, name, sizeof s_thr[i]->name - 1) == 0) {
+            s_thr[i]->ostid = os_tid(); tls_set(s_thr[i]);
+            __sync_lock_release(&lock);
+            return;
+        }
+    wa_thr* t = tls_get();
+    if (!t) t = me();
+    if (t) strncpy(t->name, name, sizeof t->name - 1);
+    __sync_lock_release(&lock);
+}
+
+void kz3_wacct_flip(void) { if (g_kz3_wacct > 0) __sync_fetch_and_add(&s_flips, 1); }
+
+/* ---- names ---------------------------------------------------------------------- */
+/* Set by ppu_hle.cpp when it registers its first import: programs that link the runtime without the HLE
+ * module (native unit tests, host smoke tests) leave it NULL and print NIDs. */
+const char* (*g_kz3_wacct_hle_name)(uint32_t nid) = 0;
+#ifdef _WIN32
+const char* ppu_thread_name_for_os_tid(unsigned long os_tid);   /* sys_ppu_thread.c */
+#endif
+
+static const char* sc_name(uint32_t n)
+{
+    switch (n) {
+    case 43: return "ppu_thread_yield";  case 44: return "ppu_thread_join";
+    case 85: return "event_flag_wait";   case 87: return "event_flag_set";
+    case 92: return "semaphore_wait";    case 94: return "semaphore_post";
+    case 97: return "lwmutex_lock";      case 98: return "lwmutex_unlock";
+    case 102: return "mutex_lock";       case 104: return "mutex_unlock";
+    case 107: return "cond_wait";        case 108: return "cond_signal";
+    case 113: return "lwcond_queue_wait";
+    case 130: return "event_queue_receive"; case 134: return "event_port_send";
+    case 138: return "event_port_send";  case 141: return "timer_usleep";
+    case 142: return "timer_sleep";
+    default: return NULL;
+    }
+}
+
+static const char* kind_name[KZ3_WA_NKIND] = {
+    "hle", "sc", "usleep", "label", "ksleep", "pmrun", "job", "kgap", "kskip", "park" };
+
+static void site_str(int kind, uint32_t site, char* o, size_t n)
+{
+    const char* nm = NULL;
+    switch (kind) {
+    case KZ3_WA_HLE:
+        if (g_kz3_wacct_hle_name) nm = g_kz3_wacct_hle_name(site);
+        if (nm) snprintf(o, n, "%s", nm); else snprintf(o, n, "nid%08X", site);
+        return;
+    case KZ3_WA_SC:
+        nm = sc_name(site);
+        if (nm) snprintf(o, n, "%s", nm); else snprintf(o, n, "sc%u", site);
+        return;
+    case KZ3_WA_USLEEP: snprintf(o, n, "lr%08X", site); return;
+    case KZ3_WA_LABEL:  snprintf(o, n, "label%u", site); return;
+    case KZ3_WA_PMRUN: case KZ3_WA_KGAP: case KZ3_WA_KSKIP: snprintf(o, n, "wid%u", site); return;
+    case KZ3_WA_JOB:    snprintf(o, n, "ovl%u", site); return;
+    default:            snprintf(o, n, "%u", site); return;
+    }
+}
+
+static void thr_name(wa_thr* t, char* o, size_t n)
+{
+    if (t->name[0]) { snprintf(o, n, "%s", t->name); return; }
+#ifdef _WIN32
+    const char* g = ppu_thread_name_for_os_tid(t->ostid);
+    if (g && *g) { snprintf(o, n, "ppu:%s", g); return; }
+#endif
+    snprintf(o, n, "host%lu", t->ostid);
+}
+
+/* ---- printer ---------------------------------------------------------------------- */
+static void print_window(double t_s, long flips)
+{
+    fprintf(stderr, "[wacct] ---- t=%.1fs window=%dms flips=%ld\n", t_s, g_kz3_wacct, flips);
+    long nt = s_nthr; if (nt > WA_THREADS) nt = WA_THREADS;
+    for (long i = 0; i < nt; i++) {
+        wa_thr* t = s_thr[i];
+        if (!t) continue;
+        uint64_t dtop[KZ3_WA_NKIND], dtopn[KZ3_WA_NKIND], tot = 0;
+        for (int k = 0; k < KZ3_WA_NKIND; k++) {
+            uint64_t a = t->top_ns[k], b = t->top_n[k];
+            dtop[k] = a - t->p_top_ns[k]; dtopn[k] = b - t->p_top_n[k];
+            t->p_top_ns[k] = a; t->p_top_n[k] = b; tot += dtop[k];
+        }
+        enum { TOPN = 12 };
+        int best[TOPN]; uint64_t bns[TOPN], bn[TOPN]; int nb = 0;
+        uint64_t any = 0, skips = 0;
+        uint32_t gs[6]; uint64_t gns[6], gn[6]; int ng = 0;
+        for (int s = 0; s < WA_SLOTS; s++) {
+            uint64_t key = t->tab[s].key;
+            if (!key) continue;
+            uint64_t a = t->tab[s].ns, b = t->tab[s].n;
+            uint64_t dn = a - t->p_ns[s], dc = b - t->p_n[s];
+            t->p_ns[s] = a; t->p_n[s] = b;
+            if (!dn && !dc) continue;
+            any += dn + dc;
+            if ((int)(key >> 32) - 1 == KZ3_WA_KSKIP) { skips += dc; continue; }
+            if ((int)(key >> 32) - 1 == KZ3_WA_KGAP) {   /* gaps: own field, by count */
+                if (ng < 6) { gs[ng] = (uint32_t)key; gns[ng] = dn; gn[ng] = dc; ng++; }
+                else { int lo = 0; for (int q = 1; q < 6; q++) if (gn[q] < gn[lo]) lo = q;
+                       if (dc > gn[lo]) { gs[lo] = (uint32_t)key; gns[lo] = dn; gn[lo] = dc; } }
+                continue;
+            }
+            /* insertion into the top list by ns (count as tie-break) */
+            int pos = nb;
+            while (pos > 0 && (bns[pos - 1] < dn || (bns[pos - 1] == dn && bn[pos - 1] < dc))) pos--;
+            if (pos >= TOPN) continue;
+            int last = nb < TOPN ? nb : TOPN - 1;
+            for (int q = last; q > pos; q--) { best[q] = best[q - 1]; bns[q] = bns[q - 1]; bn[q] = bn[q - 1]; }
+            best[pos] = s; bns[pos] = dn; bn[pos] = dc;
+            if (nb < TOPN) nb++;
+        }
+        if (!any && !tot) continue;
+        char nm[64], line[2000]; int o = 0;
+        thr_name(t, nm, sizeof nm);
+        o += snprintf(line + o, sizeof line - o, "[wacct] thr=%s wait=%llums", nm, (unsigned long long)(tot / 1000000ull));
+        for (int k = 0; k < KZ3_WA_NKIND; k++)
+            if (dtop[k] >= 500000ull || (dtopn[k] && k == KZ3_WA_PMRUN))
+                o += snprintf(line + o, sizeof line - o, " %s=%llu/%llu", kind_name[k],
+                              (unsigned long long)(dtop[k] / 1000000ull), (unsigned long long)dtopn[k]);
+        if (skips) o += snprintf(line + o, sizeof line - o, " kskip=%llu", (unsigned long long)skips);
+        for (int g = 0; g < ng; g++)
+            o += snprintf(line + o, sizeof line - o, " gap:wid%u=%.1fms*%llu", gs[g],
+                          gn[g] ? (double)gns[g] / 1e6 / (double)gn[g] : 0.0, (unsigned long long)gn[g]);
+        o += snprintf(line + o, sizeof line - o, " |");
+        for (int b = 0; b < nb && o < (int)sizeof line - 80; b++) {
+            uint64_t key = t->tab[best[b]].key;
+            int kind = (int)(key >> 32) - 1; char st[48];
+            site_str(kind, (uint32_t)key, st, sizeof st);
+            o += snprintf(line + o, sizeof line - o, " %s:%s=%.1fms/%llu", kind_name[kind], st,
+                          (double)bns[b] / 1e6, (unsigned long long)bn[b]);
+        }
+        fprintf(stderr, "%s\n", line);
+    }
+    fflush(stderr);
+}
+
+#ifdef _WIN32
+static DWORD WINAPI printer(LPVOID p)
+#else
+static void* printer(void* p)
+#endif
+{
+    (void)p;
+    long last_flips = 0;
+    for (;;) {
+#ifdef _WIN32
+        Sleep((DWORD)g_kz3_wacct);
+#else
+        usleep((useconds_t)g_kz3_wacct * 1000u);
+#endif
+        long f = s_flips;
+        print_window((double)(kz3_wacct_now() - s_t0) / 1e9, f - last_flips);
+        last_flips = f;
+    }
+    return 0;
+}
+
+int kz3_wacct_init(void)
+{
+    static volatile long once = 0;
+    if (__sync_val_compare_and_swap(&once, 0, 1) != 0) {
+        while (*(volatile int*)&g_kz3_wacct < 0) { /* another thread is initialising */ }
+        return g_kz3_wacct;
+    }
+    const char* e = getenv("KZ3_WAIT_ACCT");
+    int ms = e ? atoi(e) : 0;
+    if (ms < 0) ms = 0;
+    if (ms > 0 && ms < 100) ms = 1000;   /* KZ3_WAIT_ACCT=1 means "on, 1 s windows" */
+#ifdef _WIN32
+    QueryPerformanceFrequency(&s_qf);
+    if (ms) { s_tls = TlsAlloc(); if (s_tls == TLS_OUT_OF_INDEXES) ms = 0; }
+#endif
+    s_t0 = kz3_wacct_now();
+    if (ms) {
+        fprintf(stderr, "[wacct] on: %d ms windows (KZ3 patch 1032)\n", ms);
+        g_kz3_wacct = ms;
+#ifdef _WIN32
+        CreateThread(NULL, 1u << 18, printer, NULL, 0, NULL);
+#else
+        pthread_t th; pthread_create(&th, NULL, printer, NULL);
+#endif
+    } else g_kz3_wacct = 0;
+    return g_kz3_wacct;
+}
diff --git a/runtime/diag/kz3_wait_acct.h b/runtime/diag/kz3_wait_acct.h
new file mode 100644
index 00000000..777bbede
--- /dev/null
+++ b/runtime/diag/kz3_wait_acct.h
@@ -0,0 +1,48 @@
+/* KZ3 patch 1032 (diagnostic, opt-in): per-thread wait accounting.
+ *
+ * KZ3_WAIT_ACCT=<ms> (unset/0 = off): every host thread that runs guest work keeps
+ * cumulative host time per (kind, site); a printer thread prints the deltas every <ms>
+ * ms (`[wacct]` lines). Kinds: HLE import calls (site = NID), lv2 syscalls (site =
+ * number), sys_timer_usleep (site = guest lr), GPU label waits, SPURS kernel sleeps,
+ * policy-module runs (site = wid), resident job modules (site = overlay image), GCM
+ * FIFO parks. Only outermost brackets count towards a thread's "wait" total (a usleep
+ * inside a label wait is listed but not added twice). */
+#ifndef KZ3_WAIT_ACCT_H
+#define KZ3_WAIT_ACCT_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum {
+    KZ3_WA_HLE = 0,   /* HLE import, site = NID              */
+    KZ3_WA_SC,        /* lv2 syscall, site = number          */
+    KZ3_WA_USLEEP,    /* sys_timer_usleep, site = guest lr   */
+    KZ3_WA_LABEL,     /* wait_label 0x640E0, site = index    */
+    KZ3_WA_KSLEEP,    /* SPURS kernel pass sleep, site = 0   */
+    KZ3_WA_PMRUN,     /* policy module run, site = wid       */
+    KZ3_WA_JOB,       /* job module resident, site = image   */
+    KZ3_WA_KGAP,      /* kernel: end of a run -> next run of the same wid, site = wid (not a wait of this thread) */
+    KZ3_WA_KSKIP,     /* kernel: idle-backoff skip, site = wid (count only) */
+    KZ3_WA_PARK,      /* GCM FIFO park, walker waited for the patch (site 0) */
+    KZ3_WA_NKIND
+};
+
+extern int g_kz3_wacct;                     /* -1 = not read yet, 0 = off, else window ms */
+int      kz3_wacct_init(void);
+uint64_t kz3_wacct_now(void);               /* ns */
+uint64_t kz3_wacct_begin_slow(void);
+void     kz3_wacct_end(int kind, uint32_t site, uint64_t t0);
+void     kz3_wacct_note(int kind, uint32_t site, uint64_t ns);   /* not a bracket: listed, not summed */
+void     kz3_wacct_job(int image);          /* SPU host thread: job module now resident (0 = none) */
+void     kz3_wacct_name(const char* name);  /* name this host thread */
+void     kz3_wacct_flip(void);
+
+static inline int kz3_wacct_on(void) { return g_kz3_wacct < 0 ? kz3_wacct_init() : g_kz3_wacct; }
+/* Returns 0 when off; kz3_wacct_end ignores t0 == 0. */
+static inline uint64_t kz3_wacct_begin(void) { return kz3_wacct_on() ? kz3_wacct_begin_slow() : 0; }
+
+#ifdef __cplusplus
+}
+#endif
+#endif
