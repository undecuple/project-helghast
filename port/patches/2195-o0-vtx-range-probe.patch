 extern rsx_o0 g_rsx_o0;   /* cellGcmSys.c */
+
+/* ---- [o0-vtx] (patch 2195): vertex-array fetch cost by source range -------------------------------------------------- */
+/* RSX_O0=1 + the range RSX_O0_VTX_RANGE=lo,hi (default 0xC0B00000..0xC1000000, the Skinning SPU job's output in RSX local
+ * memory, SPU pass 162). Per draw with vertex data (cache hit or fetch) the source spans of its attributes are classified:
+ * a draw with ANY span overlapping the range goes to side 0 ("range"), every other draw to side 1; spans of the draw
+ * that could not be derived (no stable base) are counted in nospan and the draw goes to side 1 unless a derived span
+ * hits. Location 0 spans are addressed 0xC0000000 + offset, location 1 spans by their raw io offset (ASSUMPTION: only
+ * location 0 is meant to match a 0xC.... range). Costs are QPC ticks of the draw's three vertex stages: hash = the draw
+ * cache lookup (key, validation = the source bytes compared; bytes = the validated bytes), conv = ref building, remap and
+ * fetch/convert (payload bytes), up = ring copy / device-cache fill (bytes copied into the ring or staging). Draws dropped
+ * before the copy are not counted. Distinct ranges per flip: the (loc, offset, length) of each range span, table keyed
+ * by the flip number (flip_n at the draw), so a range seen again in the same flip is a reuse. */
+#define RSX_O0V_TAB 8192u   /* power of two; > 4096 distinct spans in one flip = overflow (counted) */
+#define RSX_O0V_SPANS 16
+typedef struct { unsigned loc, off, len; } rsx_o0v_span;
+typedef struct {
+    long long draws, mixed, nospan_draws, nospan_spans, hit, miss, fetches;
+    long long b_hash, b_conv, b_up, t_hash, t_conv, t_up, span_bytes;
+} rsx_o0v_side;
+typedef struct {
+    rsx_o0v_side s[2];                       /* [0] range, [1] other */
+    long long flips_seen, dist_sum, dist_max, reuse_n, reused_ranges, ovf;   /* folded per flip */
+    long long ranges_sum;                    /* range spans seen (distinct + reuses) */
+} rsx_o0v_ctr;
+typedef struct {
+    unsigned long long lo, hi;
+    rsx_o0v_ctr c;
+    unsigned cur_ep; int have_ep; long long cur_dist, cur_reuse, cur_reused_ranges;
+    struct { unsigned long long key; unsigned ep, n; } tab[RSX_O0V_TAB];
+} rsx_o0v;
+
+/* "lo,hi" (decimal or 0x hex). 1 = ok. lo < hi, hi <= 2^32 required. */
+static inline int rsx_o0v_parse(const char* str, unsigned long long* lo, unsigned long long* hi)
+{
+    if (!str || !*str) return 0;
+    char* e1 = NULL; char* e2 = NULL;
+    const unsigned long long a = strtoull(str, &e1, 0);
+    if (e1 == str || *e1 != ',') return 0;
+    const unsigned long long b = strtoull(e1 + 1, &e2, 0);
+    if (e2 == e1 + 1 || *e2) return 0;
+    if (a >= b || b > 0x100000000ull) return 0;
+    *lo = a; *hi = b;
+    return 1;
+}
+static inline void rsx_o0v_init(rsx_o0v* v, const char* env)
+{
+    v->lo = 0xC0B00000ull; v->hi = 0xC1000000ull;
+    if (env && *env && !rsx_o0v_parse(env, &v->lo, &v->hi)) {
+        v->lo = 0xC0B00000ull; v->hi = 0xC1000000ull;
+        fprintf(stderr, "[o0-vtx] RSX_O0_VTX_RANGE=\"%s\" is not lo,hi (lo < hi <= 0x100000000): using the default\n", env);
+    }
+}
+static inline int rsx_o0v_in_range(const rsx_o0v* v, unsigned loc, unsigned off, unsigned len)
+{
+    const unsigned long long a = (loc == 0 ? 0xC0000000ull : 0ull) + off, b = a + len;
+    return len && a < v->hi && b > v->lo;
+}
+static inline void rsx_o0v_fold(rsx_o0v* v)
+{
+    if (!v->have_ep) return;
+    v->c.flips_seen++; v->c.dist_sum += v->cur_dist; if (v->cur_dist > v->c.dist_max) v->c.dist_max = v->cur_dist;
+    v->c.reuse_n += v->cur_reuse; v->c.reused_ranges += v->cur_reused_ranges;
+    v->cur_dist = v->cur_reuse = v->cur_reused_ranges = 0;
+}
+/* One draw. `ep` = the flip number, spans = what the caller derived (nspans may be 0), nospan = attributes it could not
+ * derive a span for. Times are ticks, bytes as described above. Called with the o0 lock held by the wrapper below. */
+static inline void rsx_o0v_draw_nolock(rsx_o0v* v, unsigned ep, const rsx_o0v_span* sp, unsigned nsp, unsigned nospan,
+                                       int vc_hit, long long t_hash, long long t_conv, long long t_up,
+                                       long long b_hash, long long b_conv, long long b_up)
+{
+    if (!v->have_ep || ep != v->cur_ep) { rsx_o0v_fold(v); v->cur_ep = ep; v->have_ep = 1; }
+    int in = 0, other = 0; long long inb = 0;
+    for (unsigned i = 0; i < nsp; i++) {
+        if (rsx_o0v_in_range(v, sp[i].loc, sp[i].off, sp[i].len)) {
+            in++; inb += sp[i].len;
+            const unsigned long long key = (((unsigned long long)(sp[i].loc & 1u) << 63) | ((unsigned long long)sp[i].off << 31)
+                                            | sp[i].len) + 1ull;
+            unsigned h = (unsigned)((key * 0x9E3779B97F4A7C15ull) >> 40) & (RSX_O0V_TAB - 1u);
+            int done = 0;
+            for (unsigned k = 0; k < RSX_O0V_TAB && !done; k++, h = (h + 1u) & (RSX_O0V_TAB - 1u)) {
+                if (v->tab[h].ep == ep + 1u && v->tab[h].key == key) {
+                    v->cur_reuse++; if (v->tab[h].n++ == 1) v->cur_reused_ranges++; done = 1;
+                } else if (v->tab[h].ep != ep + 1u) {   /* empty for this flip */
+                    if (v->cur_dist >= (long long)RSX_O0V_TAB / 2) { v->c.ovf++; done = 1; break; }
+                    v->tab[h].key = key; v->tab[h].ep = ep + 1u; v->tab[h].n = 1; v->cur_dist++; done = 1;
+                }
+            }
+            v->c.ranges_sum++;
+        } else other++;
+    }
+    rsx_o0v_side* s = &v->c.s[in ? 0 : 1];
+    s->draws++; if (in && other) s->mixed++;
+    if (nospan) { s->nospan_draws++; s->nospan_spans += nospan; }
+    if (vc_hit) s->hit++; else { s->miss++; s->fetches++; }
+    s->b_hash += b_hash; s->b_conv += b_conv; s->b_up += b_up;
+    s->t_hash += t_hash; s->t_conv += t_conv; s->t_up += t_up;
+    s->span_bytes += inb;
+}
+static inline void rsx_o0v_draw(rsx_o0v* v, rsx_o0* o, unsigned ep, const rsx_o0v_span* sp, unsigned nsp, unsigned nospan,
+                                int vc_hit, long long t_hash, long long t_conv, long long t_up,
+                                long long b_hash, long long b_conv, long long b_up)
+{
+    rsx_o0_lock(o);
+    rsx_o0v_draw_nolock(v, ep, sp, nsp, nospan, vc_hit, t_hash, t_conv, t_up, b_hash, b_conv, b_up);
+    rsx_o0_unlock(o);
+}
+/* The line: deltas of one period (c, p = counter snapshots), per flip = / flips. tk = ms per tick. `flips` is the number of
+ * flips in the period (flip_n delta); 0 prints per-period totals (flips=0, per-flip fields are the totals). */
+static inline int rsx_o0v_fmt(char* out, size_t n, double t, double tk, long long flips, unsigned long long lo,
+                              unsigned long long hi, const rsx_o0v_ctr* c, const rsx_o0v_ctr* p)
+{
+    const double f = flips > 0 ? (double)flips : 1.0;
+    int o = snprintf(out, n, "[o0-vtx] t=%.0f flips=%lld range=0x%08llX..0x%08llX", t, flips, lo, hi);
+    static const char* nm[2] = { "in", "out" };
+    for (int i = 0; i < 2 && o > 0 && (size_t)o < n; i++) {
+        const rsx_o0v_side* a = &c->s[i]; const rsx_o0v_side* b = &p->s[i];
+        o += snprintf(out + o, n - (size_t)o,
+            " | %s draws=%.1f mixed=%.1f fetches=%.1f vc_hit=%.1f vc_miss=%.1f nospan=%.1f"
+            " hashB=%.0f convB=%.0f upB=%.0f hash_ms=%.3f conv_ms=%.3f up_ms=%.3f",
+            nm[i], (a->draws - b->draws) / f, (a->mixed - b->mixed) / f, (a->fetches - b->fetches) / f, (a->hit - b->hit) / f,
+            (a->miss - b->miss) / f, (a->nospan_draws - b->nospan_draws) / f, (double)(a->b_hash - b->b_hash) / f,
+            (double)(a->b_conv - b->b_conv) / f, (double)(a->b_up - b->b_up) / f, (double)(a->t_hash - b->t_hash) * tk / f,
+            (double)(a->t_conv - b->t_conv) * tk / f, (double)(a->t_up - b->t_up) * tk / f);
+    }
+    if (o > 0 && (size_t)o < n) {
+        const long long fl = c->flips_seen - p->flips_seen;
+        o += snprintf(out + o, n - (size_t)o,
+            " | ranges per_flip_mean=%.2f max=%lld range_span_B=%.0f reuses=%.2f reused_ranges=%.2f reused_in_flip=%d ovf=%lld",
+            fl > 0 ? (double)(c->dist_sum - p->dist_sum) / (double)fl : 0.0, c->dist_max,
+            (double)(c->s[0].span_bytes - p->s[0].span_bytes) / f, (double)(c->reuse_n - p->reuse_n) / f,
+            (double)(c->reused_ranges - p->reused_ranges) / f, (c->reuse_n - p->reuse_n) > 0 ? 1 : 0, c->ovf - p->ovf);
+    }
+    return o;
+}
+extern rsx_o0v g_rsx_o0v;   /* cellGcmSys.c */
 #endif
