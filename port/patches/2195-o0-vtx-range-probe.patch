diff --git a/libs/video/rsx_o0.h b/libs/video/rsx_o0.h
index c9233242..84a93beb 100644
--- a/libs/video/rsx_o0.h
+++ b/libs/video/rsx_o0.h
@@ -10,6 +10,7 @@
 #define RSX_O0_H
 #include <stdint.h>
 #include <stdio.h>
+#include <stdlib.h>
 #include <string.h>
 
 /* ---- exclusive buckets -------------------------------------------------------------------------------------------- */
@@ -329,4 +330,139 @@ static inline int rsx_o0_fmt_wbov(char* out, size_t n, double t, const rsx_o0* c
         c->rd_ov_age[1][1] - p->rd_ov_age[1][1], c->rd_ov_age[1][2] - p->rd_ov_age[1][2]);
