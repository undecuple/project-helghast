+/* --- patch 2006: pipeline state streams for depth bounds and per-face stencil masks ---------------------
+ * D3D12_GRAPHICS_PIPELINE_STATE_DESC cannot express either: depth bounds needs DEPTH_STENCIL1
+ * (DepthBoundsTestEnable), per-face read/write masks need DEPTH_STENCIL2 (Agility SDK 1.606+,
+ * D3D12_OPTIONS14). MinGW-w64 14 headers lack DEPTH_STENCIL2 and ID3D12GraphicsCommandList8, so the two
+ * are declared here with the SDK layout. */
+typedef struct {
+    D3D12_STENCIL_OP StencilFailOp, StencilDepthFailOp, StencilPassOp;
+    D3D12_COMPARISON_FUNC StencilFunc;
+    UINT8 StencilReadMask, StencilWriteMask;
+} ld_depth_stencilop_desc1;
+typedef struct {
+    BOOL DepthEnable;
+    D3D12_DEPTH_WRITE_MASK DepthWriteMask;
+    D3D12_COMPARISON_FUNC DepthFunc;
+    BOOL StencilEnable;
+    ld_depth_stencilop_desc1 FrontFace, BackFace;
+    BOOL DepthBoundsTestEnable;
+} ld_depth_stencil_desc2;
+typedef struct { DXGI_FORMAT RTFormats[8]; UINT NumRenderTargets; } ld_rt_format_array;   /* D3D12_RT_FORMAT_ARRAY */
+#define LD_SUBOBJECT_DEPTH_STENCIL2 26   /* D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DEPTH_STENCIL2 */
+/* ID3D12GraphicsCommandList8 {ee936ef9-599d-4d28-938e-23c4ad05ce51} (GUID checked in vkd3d-proton's
+ * d3d12core.dll); its one new method follows the ID3D12GraphicsCommandList7 vtable. */
+static const GUID ld_IID_ID3D12GraphicsCommandList8 =
+    { 0xee936ef9, 0x599d, 0x4d28, { 0x93, 0x8e, 0x23, 0xc4, 0xad, 0x05, 0xce, 0x51 } };
+typedef void (STDMETHODCALLTYPE* ld_om_set_front_back_ref_fn)(void* self, UINT front, UINT back);
+
+/* Pipeline state stream subobject: type tag, then the payload at its natural alignment; each subobject
+ * pointer-aligned (the d3dx12 CD3DX12_PIPELINE_STATE_STREAM_SUBOBJECT layout). */
+#define LD_PSS(T) struct { __attribute__((aligned(8))) D3D12_PIPELINE_STATE_SUBOBJECT_TYPE type; T inner; }
+
+static void ld_caps_init(void)
+{
+    memset(&g_ld_caps, 0, sizeof(g_ld_caps));
+    if (getenv("LD_NO_PSO_STREAM")) {
+        fprintf(stderr, "[caps] LD_NO_PSO_STREAM: depth bounds and per-face stencil masks off\n");
+        return;
+    }
+    if (FAILED(g.dev->lpVtbl->QueryInterface(g.dev, &IID_ID3D12Device2, (void**)&g_ld_caps.dev2)))
+        g_ld_caps.dev2 = NULL;
+    D3D12_FEATURE_DATA_D3D12_OPTIONS2 o2;
+    memset(&o2, 0, sizeof(o2));
+    const int have_o2 = SUCCEEDED(g.dev->lpVtbl->CheckFeatureSupport(
+        g.dev, D3D12_FEATURE_D3D12_OPTIONS2, &o2, sizeof(o2)));
+    D3D12_FEATURE_DATA_D3D12_OPTIONS14 o14;
+    memset(&o14, 0, sizeof(o14));
+    const int have_o14 = SUCCEEDED(g.dev->lpVtbl->CheckFeatureSupport(
+        g.dev, D3D12_FEATURE_D3D12_OPTIONS14, &o14, sizeof(o14)));
+    if (FAILED(g.list->lpVtbl->QueryInterface(g.list, &IID_ID3D12GraphicsCommandList1,
+                                                 (void**)&g_ld_caps.list1)))
+        g_ld_caps.list1 = NULL;
+    if (FAILED(g.list->lpVtbl->QueryInterface(g.list, &ld_IID_ID3D12GraphicsCommandList8,
+                                                 &g_ld_caps.list8)))
+        g_ld_caps.list8 = NULL;
+    g_ld_caps.depth_bounds = g_ld_caps.dev2 && g_ld_caps.list1 && have_o2 && o2.DepthBoundsTestSupported;
+    g_ld_caps.per_face_stencil = g_ld_caps.dev2 && g_ld_caps.list8 && have_o14 &&
+                                 o14.IndependentFrontAndBackStencilRefMaskSupported;
+    D3D12_FEATURE_DATA_D3D12_OPTIONS13 o13;
+    memset(&o13, 0, sizeof(o13));
+    g_ld_alpha_factor = SUCCEEDED(g.dev->lpVtbl->CheckFeatureSupport(
+        g.dev, D3D12_FEATURE_D3D12_OPTIONS13, &o13, sizeof(o13))) && o13.AlphaBlendFactorSupported;
+    fprintf(stderr, "[caps] alpha-blend-factor=%d\n", g_ld_alpha_factor);
+    fprintf(stderr, "[caps] device2=%d list1=%d list8=%d depth-bounds=%d per-face-stencil=%d\n",
+            g_ld_caps.dev2 != NULL, g_ld_caps.list1 != NULL, g_ld_caps.list8 != NULL,
+            g_ld_caps.depth_bounds, g_ld_caps.per_face_stencil);
+}
+
+static float ld_half(u32 h)
+{
+    const u32 e = (h >> 10) & 0x1Fu, m = h & 0x3FFu;
+    float v;
+    if (e == 0) v = (float)m / 16777216.0f;              /* subnormal: m * 2^-24 */
+    else if (e == 31) v = 65504.0f;                      /* inf/NaN: clamp */
+    else { const u32 bits = ((e + 112u) << 23) | (m << 13); memcpy(&v, &bits, 4); }
+    return (h & 0x8000u) ? -v : v;
+}
+
+/* Blend colour (CONSTANT_COLOR / CONSTANT_ALPHA factors). Live-draw never set it, so D3D12 used the
+ * command list default. Patch 2006: from SET_BLEND_COLOR (and BLEND_COLOR2 on FP16 surfaces). */
+static void ld_set_blend_factor(int fp16)
+{
+    const u32 c = rsx_dsp_reg(&g.rsx, M_BLEND_COLOR);
+    float f[4];
+    if (fp16) {
+        const u32 c2 = rsx_dsp_reg(&g.rsx, M_BLEND_COLOR2);
+        f[0] = ld_half(c & 0xFFFFu); f[1] = ld_half(c >> 16);
+        f[2] = ld_half(c2 & 0xFFFFu); f[3] = ld_half(c2 >> 16);
+    } else {
+        f[0] = (float)((c >> 16) & 0xFFu) / 255.0f; f[1] = (float)((c >> 8) & 0xFFu) / 255.0f;
+        f[2] = (float)(c & 0xFFu) / 255.0f;         f[3] = (float)(c >> 24) / 255.0f;
+    }
+    g.list->lpVtbl->OMSetBlendFactor(g.list, f);
+}
+
+/* Front and back stencil reference. Two-sided stencil has its own back reference (0x354); without
+ * ID3D12GraphicsCommandList8 both faces use the front one. */
+static void ld_set_stencil_refs(void)
+{
+    const u32 front = rsx_dsp_reg(&g.rsx, M_STENCIL_FUNC_REF) & 0xFFu;
+    u32 back = front;
+    if ((rsx_dsp_reg(&g.rsx, M_TWO_SIDED_STENCIL) & 1u) && g.rsx.seen[M_BACK_STENCIL_FUNC_REF >> 2])
+        back = rsx_dsp_reg(&g.rsx, M_BACK_STENCIL_FUNC_REF) & 0xFFu;
+    if (back != front && g_ld_caps.per_face_stencil && g_ld_caps.list8) {
+        enum { LD_LIST7_SLOTS = sizeof(ID3D12GraphicsCommandList7Vtbl) / sizeof(void*) };
+        void** vtbl = *(void***)g_ld_caps.list8;
+        ((ld_om_set_front_back_ref_fn)vtbl[LD_LIST7_SLOTS])(g_ld_caps.list8, front, back);
+        return;
+    }
+    if (back != front && !g_ld_caps.logged_face_fallback++)
+        fprintf(stderr, "[stencil] back reference %02X != front %02X; device has no per-face reference, "
+                "using the front one\n", back, front);
+    g.list->lpVtbl->OMSetStencilRef(g.list, front);
+}
+
+/* Create the PSO; through a pipeline state stream when depth bounds or per-face stencil masks are on. */
+static HRESULT ld_create_pso(const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd, const render_state_t* rs,
+                             ID3D12PipelineState** out)
+{
+    if (!(rs->depth_bounds || rs->stencil_per_face) || !g_ld_caps.dev2 || !pd->DSVFormat)
+        return g.dev->lpVtbl->CreateGraphicsPipelineState(g.dev, pd, &IID_ID3D12PipelineState, (void**)out);
+    struct {
+        LD_PSS(ID3D12RootSignature*) root;
+        LD_PSS(D3D12_SHADER_BYTECODE) vs;
+        LD_PSS(D3D12_SHADER_BYTECODE) ps;
+        LD_PSS(D3D12_INPUT_LAYOUT_DESC) il;
+        LD_PSS(D3D12_BLEND_DESC) blend;
+        LD_PSS(UINT) sample_mask;
+        LD_PSS(D3D12_RASTERIZER_DESC) rast;
+        LD_PSS(D3D12_PRIMITIVE_TOPOLOGY_TYPE) topo;
+        LD_PSS(ld_rt_format_array) rtv;
+        LD_PSS(DXGI_FORMAT) dsv;
+        LD_PSS(DXGI_SAMPLE_DESC) sample;
+        LD_PSS(ld_depth_stencil_desc2) ds;   /* DEPTH_STENCIL2, or DEPTH_STENCIL1 (a prefix of it) */
+    } st;
+    memset(&st, 0, sizeof(st));
+    st.root.type = D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_ROOT_SIGNATURE;   st.root.inner = pd->pRootSignature;
+    st.vs.type = D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_VS;                 st.vs.inner = pd->VS;
+    st.ps.type = D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_PS;                 st.ps.inner = pd->PS;
+    st.il.type = D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_INPUT_LAYOUT;       st.il.inner = pd->InputLayout;
+    st.blend.type = D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_BLEND;           st.blend.inner = pd->BlendState;
+    st.sample_mask.type = D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_SAMPLE_MASK; st.sample_mask.inner = pd->SampleMask;
+    st.rast.type = D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_RASTERIZER;       st.rast.inner = pd->RasterizerState;
+    st.topo.type = D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_PRIMITIVE_TOPOLOGY; st.topo.inner = pd->PrimitiveTopologyType;
+    st.rtv.type = D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_RENDER_TARGET_FORMATS;
+    st.rtv.inner.NumRenderTargets = pd->NumRenderTargets;
