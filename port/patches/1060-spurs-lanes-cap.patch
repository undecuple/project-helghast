+            /* KZ3 patch 1060: KZ3_SPURS_LANES=n (1..6, default 0 = the instance's nSpus) raises that cap on the
+             * host: the workload's own maxContention still applies (KZ3's frame job workload declares 5, the
+             * mixer 1), the PM contexts are per (wid, spuNum) up to 6, and the game's per-SPU rows are sized by
+             * its maxContention, not by nSpus. SPU pass 46: HiPrio has nSpus=2 so wid 1 ran on 2 lanes while
+             * both kernel threads sat 72 % in pmrun; 4 lanes is the A/B. */
+            { static int s_lanes = -1;
+              if (s_lanes < 0) { const char* e = getenv("KZ3_SPURS_LANES"); s_lanes = e ? atoi(e) : 0;
+                                 if (s_lanes < 0) s_lanes = 0; if (s_lanes > 6) s_lanes = 6; }
+              u8 cap = (u8)(s_lanes > (int)si->nspus ? s_lanes : (int)si->nspus);
+              if (si->nspus >= 1 && maxcont > cap) maxcont = cap; }
             /* Do NOT exceed the workload's own contention: per-SPU rows in
