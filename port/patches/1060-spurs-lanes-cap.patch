KZ3 patch 1060 (SPU pass 46): two opt-in SPURS parallelism switches for the level's SPU chain. KZ3_SPURS_LANES=n (1..6, default 0 = unchanged) raises patch 1034's lane cap from the instance's nSpus to n for the concurrent virtual SPUs of a policy-module run (the workload's own maxContention still applies; the frame job workload declares 5, HiPrio has nSpus=2). KZ3_SPURS_NSPUS=n (1..6, default 0) gives an instance n virtual SPUs when the game asked for fewer (kernel threads and lane cap follow; the game never reads the count back). Pass 46: LANES=4 alone hung wid 7's lanes 2-3 (rows sized by nSpus); NSPUS is the next experiment.

--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -548,6 +548,16 @@
 
     si->ea    = spurs_ea;
     si->nspus = (nspus > 0 && nspus <= CELL_SPURS_MAX_SPU) ? nspus : 1;
+    /* KZ3 patch 1060: KZ3_SPURS_NSPUS=n (1..6, default 0 = the game's value): the instance gets n virtual SPUs
+     * when the game asked for fewer, so the kernel threads and the lane cap follow n. KZ3 creates HiPrio and LoPrio
+     * with nSpus=2 each and never reads the count back (no cellSpursGetNumSpuThread import), so its per-SPU rows
+     * follow its own constant; SPU pass 46: raising only the lanes (KZ3_SPURS_LANES=4) hung wid 7's lanes 2-3. */
+    { static int s_ns = -1;
+      if (s_ns < 0) { const char* e = getenv("KZ3_SPURS_NSPUS"); s_ns = e ? atoi(e) : 0;
+                      if (s_ns < 0) s_ns = 0; if (s_ns > 6) s_ns = 6; }
+      if (s_ns > (int)si->nspus) {
+          printf("[cellSpurs] KZ3_SPURS_NSPUS: \"%s\" nSpus %u -> %d\n", prefix, si->nspus, s_ns);
+          si->nspus = (u32)s_ns; } }
     memset(si->prefix, 0, sizeof(si->prefix));
     if (prefix) memcpy(si->prefix, prefix, 15);
 
@@ -2215,7 +2225,16 @@
