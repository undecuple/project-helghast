diff --git a/libs/video/rsx_upscale.c b/libs/video/rsx_upscale.c
new file mode 100644
index 0000000..d42705c
--- /dev/null
+++ b/libs/video/rsx_upscale.c
@@ -0,0 +1,192 @@
+/* rsx_upscale.c -- the upscaler interface (KZ3 patch 2145): backend choice, size and quality math, the off path.
+ * Game-agnostic. See rsx_upscale.h. The FSR 1 constants/HLSL are in rsx_upscale_fsr1.c, the D3D12 passes in
+ * rsx_upscale_d3d12.c. */
+#include "rsx_upscale.h"
+
+#include <ctype.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+extern const rsx_upscale_ops rsx_upscale_fsr1_d3d12_ops;   /* rsx_upscale_d3d12.c */
+#endif
+
+struct rsx_upscale {
+    rsx_upscale_backend backend;
+    float sharpness;
+    void* be;
+    const rsx_upscale_ops* ops;
+    void (*retire)(void*, void*);
+    void* retire_user;
+    int tapped;
+    uint64_t passes;
+};
+
+static const rsx_upscale_ops* g_test_ops;
+void rsx_upscale_set_test_ops(const rsx_upscale_ops* ops) { g_test_ops = ops; }
+
+static const char* const k_names[RSX_UPSCALE_BACKEND_COUNT] = { "none", "fsr1", "dlaa", "dlss", "fsr3", "xess" };
+
+const char* rsx_upscale_backend_name(rsx_upscale_backend b)
+{
+    return (unsigned)b < RSX_UPSCALE_BACKEND_COUNT ? k_names[b] : "none";
+}
+
+static int ieq(const char* a, const char* b)
+{
+    for (; *a && *b; a++, b++)
+        if (tolower((unsigned char)*a) != tolower((unsigned char)*b)) return 0;
+    return *a == *b;
+}
+
+rsx_upscale_backend rsx_upscale_parse_backend(const char* s)
+{
+    if (!s || !*s) return RSX_UPSCALE_NONE;
+    for (int i = 0; i < RSX_UPSCALE_BACKEND_COUNT; i++)
+        if (ieq(s, k_names[i])) return (rsx_upscale_backend)i;
+    if (ieq(s, "fsr") || ieq(s, "fsr 1") || ieq(s, "fsr_1")) return RSX_UPSCALE_FSR1;
+    return RSX_UPSCALE_NONE;   /* "0", "off", "false", anything unknown */
+}
+
+int rsx_upscale_backend_implemented(rsx_upscale_backend b)
+{
+    return b == RSX_UPSCALE_NONE || b == RSX_UPSCALE_FSR1;
+}
+
+float rsx_upscale_clamp_sharpness(float s)
+{
+    if (!(s == s)) return RSX_UPSCALE_SHARPNESS_DEFAULT;   /* NaN */
+    if (s < 0.0f) return 0.0f;
+    if (s > RSX_UPSCALE_SHARPNESS_MAX) return RSX_UPSCALE_SHARPNESS_MAX;
+    return s;
+}
+
+void rsx_upscale_config_from_env(rsx_upscale_config* out)
+{
+    const char* e = getenv("RSX_UPSCALE");
+    const char* sh = getenv("RSX_UPSCALE_SHARPNESS");
+    out->backend = rsx_upscale_parse_backend(e);
+    out->sharpness = RSX_UPSCALE_SHARPNESS_DEFAULT;
+    if (sh && *sh) {
+        char* end = NULL;
+        const double v = strtod(sh, &end);
+        if (end && end != sh) out->sharpness = rsx_upscale_clamp_sharpness((float)v);
+        else fprintf(stderr, "[upscale] RSX_UPSCALE_SHARPNESS=\"%s\" is not a number: %.1f\n", sh, out->sharpness);
+    }
+    if (e && *e && out->backend == RSX_UPSCALE_NONE && !ieq(e, "none") && !ieq(e, "off") && !ieq(e, "0"))
+        fprintf(stderr, "[upscale] RSX_UPSCALE=\"%s\" is not a backend (none, fsr1): no upscaler\n", e);
+    if (!rsx_upscale_backend_implemented(out->backend)) {
+        fprintf(stderr, "[upscale] backend %s is not implemented yet: no upscaler\n", rsx_upscale_backend_name(out->backend));
+        out->backend = RSX_UPSCALE_NONE;
+    }
+}
+
+float rsx_upscale_quality_ratio(rsx_upscale_quality q)
+{
+    switch (q) {
+    case RSX_UPSCALE_Q_ULTRA_QUALITY: return 1.3f;
+    case RSX_UPSCALE_Q_QUALITY:       return 1.5f;
+    case RSX_UPSCALE_Q_BALANCED:      return 1.7f;
+    case RSX_UPSCALE_Q_PERFORMANCE:   return 2.0f;
+    default:                          return 1.0f;
+    }
+}
+
+static const char* const k_qnames[RSX_UPSCALE_Q_COUNT] = { "native", "ultra-quality", "quality", "balanced", "performance" };
+const char* rsx_upscale_quality_name(rsx_upscale_quality q)
+{
+    return (unsigned)q < RSX_UPSCALE_Q_COUNT ? k_qnames[q] : "native";
+}
+int rsx_upscale_parse_quality(const char* s)
+{
+    if (!s) return -1;
+    for (int i = 0; i < RSX_UPSCALE_Q_COUNT; i++)
+        if (ieq(s, k_qnames[i])) return i;
+    return -1;
+}
+
+void rsx_upscale_render_size(rsx_upscale_quality q, uint32_t out_w, uint32_t out_h, uint32_t* rw, uint32_t* rh)
+{
+    const double r = (double)rsx_upscale_quality_ratio(q);
+    uint32_t w = (uint32_t)((double)out_w / r), h = (uint32_t)((double)out_h / r);
+    if (out_w && !w) w = 1;
+    if (out_h && !h) h = 1;
+    if (rw) *rw = w;
+    if (rh) *rh = h;
+}
+
+/* ---- context ---- */
+
+rsx_upscale* rsx_upscale_create(const rsx_upscale_config* cfg, void* device)
+{
+    if (!cfg || cfg->backend == RSX_UPSCALE_NONE || !rsx_upscale_backend_implemented(cfg->backend)) return NULL;
+    const rsx_upscale_ops* ops = g_test_ops;
+#ifdef _WIN32
+    if (!ops && cfg->backend == RSX_UPSCALE_FSR1) ops = &rsx_upscale_fsr1_d3d12_ops;
+#endif
+    if (!ops) {
+        fprintf(stderr, "[upscale] %s has no backend in this build: no upscaler\n", rsx_upscale_backend_name(cfg->backend));
+        return NULL;
+    }
+    rsx_upscale* u = (rsx_upscale*)calloc(1, sizeof *u);
+    if (!u) return NULL;
+    u->backend = cfg->backend;
+    u->sharpness = rsx_upscale_clamp_sharpness(cfg->sharpness);
+    u->ops = ops;
+    u->be = ops->create(device, cfg);
+    if (!u->be) {
+        fprintf(stderr, "[upscale] %s backend failed to initialise: no upscaler\n", rsx_upscale_backend_name(cfg->backend));
+        free(u);
+        return NULL;
+    }
+    fprintf(stderr, "[upscale] backend %s, sharpness %.2f stops\n", rsx_upscale_backend_name(u->backend), u->sharpness);
+    return u;
+}
+
+void rsx_upscale_destroy(rsx_upscale* u)
+{
+    if (!u) return;
+    if (u->be && u->ops) u->ops->destroy(u->be, u->retire, u->retire_user);
+    free(u);
+}
+
+rsx_upscale_backend rsx_upscale_get_backend(const rsx_upscale* u) { return u ? u->backend : RSX_UPSCALE_NONE; }
+
+void rsx_upscale_set_retire(rsx_upscale* u, void (*retire)(void*, void*), void* user)
+{
+    if (!u) return;
+    u->retire = retire;
+    u->retire_user = user;
+}
+
+int rsx_upscale_wants_pass(const rsx_upscale* u, uint32_t in_w, uint32_t in_h, uint32_t out_w, uint32_t out_h)
+{
+    if (!u || u->backend == RSX_UPSCALE_NONE || u->tapped) return 0;
+    if (!in_w || !in_h || !out_w || !out_h) return 0;
+    return out_w >= in_w && out_h >= in_h && (out_w > in_w || out_h > in_h);
+}
+
+int rsx_upscale_evaluate(rsx_upscale* u, const rsx_upscale_eval* e, rsx_upscale_result* res)
+{
+    if (!u || !e || !res) return 0;
+    if (!rsx_upscale_wants_pass(u, e->input.width, e->input.height, e->output_width, e->output_height)) return 0;
+    if (!e->cmd_list || !e->input.resource) return 0;
+    const float sh = e->sharpness < 0.0f ? u->sharpness : rsx_upscale_clamp_sharpness(e->sharpness);
+    memset(res, 0, sizeof *res);
+    if (!u->ops->evaluate(u->be, e, sh, res, u->retire, u->retire_user)) return 0;
+    u->passes++;
+    return 1;
+}
+
+int rsx_upscale_pre_hud(rsx_upscale* u, const rsx_upscale_eval* e, rsx_upscale_result* res)
+{
+    const int ok = rsx_upscale_evaluate(u, e, res);
+    if (ok) u->tapped = 1;
+    return ok;
+}
+
+int rsx_upscale_tapped(const rsx_upscale* u) { return u ? u->tapped : 0; }
+void rsx_upscale_frame_end(rsx_upscale* u) { if (u) u->tapped = 0; }
+uint64_t rsx_upscale_passes(const rsx_upscale* u) { return u ? u->passes : 0; }
diff --git a/libs/video/rsx_upscale.h b/libs/video/rsx_upscale.h
new file mode 100644
index 0000000..c2c9e78
--- /dev/null
+++ b/libs/video/rsx_upscale.h
@@ -0,0 +1,155 @@
+/* rsx_upscale.h -- one upscaler interface for the renderer (KZ3 patch 2145, RSX pass 134).
+ *
+ * A game's renderer draws its picture at a "render size" and wants it at an "output size" (the window). This module is
+ * the single place that decides whether an upscaler runs and which one; backends plug in behind it. Nothing here knows
+ * a game: the caller passes plain handles and sizes. Backends:
+ *
+ *   NONE   no pass at all (the default): rsx_upscale_create returns NULL, every call below accepts NULL and does
+ *          nothing, so a renderer's only cost is one NULL test and its picture stays bit-identical.
+ *   FSR1   AMD FidelityFX Super Resolution 1 (EASU upscale + RCAS sharpen), two D3D12 compute passes, MIT, vendored
+ *          under fsr1/ (see fsr1/README.txt and fsr1/LICENSE.txt). Spatial: ignores depth, motion, jitter, exposure.
+ *   DLAA, DLSS, FSR3, XESS   reserved ids (temporal; they need depth, motion vectors, jitter); not implemented, a
+ *          request for one logs and falls back to NONE.
+ *
+ * Handles are opaque (void*): for the D3D12 backend they are ID3D12Resource*, ID3D12GraphicsCommandList*, ID3D12Device*
+ * and DXGI_FORMAT / D3D12_RESOURCE_STATES values, so a Vulkan backend can reuse this header with its own meaning.
+ *
+ * Environment (read once by rsx_upscale_config_from_env):
+ *   RSX_UPSCALE=fsr1|none        backend (default none)
+ *   RSX_UPSCALE_SHARPNESS=0..2   FSR 1 RCAS sharpness in stops of reduction (0 = sharpest; default 0.2, AMD's sample)
+ *
+ * The pre-HUD tap. FSR 1 is designed to run on the 3D scene, before the HUD is drawn, so the HUD stays crisp. Whether
+ * that is possible depends on the game's frame: each game wires it itself.
+ *   - A game that composes scene and HUD into one image (Killzone 3: one 720p image) cannot tap; it calls
+ *     rsx_upscale_evaluate once on the final image at present, and the HUD is upscaled with the scene.
+ *   - A game whose HUD is a separate pass calls rsx_upscale_pre_hud with the scene colour just before its first HUD
+ *     draw, draws the HUD into the result at output size, and the present step then sees rsx_upscale_tapped() == 1 and
+ *     runs no second pass. rsx_upscale_frame_end() clears the flag; call it once per presented frame.
+ */
+#ifndef RSX_UPSCALE_H
+#define RSX_UPSCALE_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum {
+    RSX_UPSCALE_NONE = 0,
+    RSX_UPSCALE_FSR1,
+    RSX_UPSCALE_DLAA,      /* reserved */
+    RSX_UPSCALE_DLSS,      /* reserved */
+    RSX_UPSCALE_FSR3,      /* reserved */
+    RSX_UPSCALE_XESS,      /* reserved */
+    RSX_UPSCALE_BACKEND_COUNT
+} rsx_upscale_backend;
+
+/* Quality modes as AMD defines them for FSR (scale factor per axis, display / render). */
+typedef enum {
+    RSX_UPSCALE_Q_NATIVE = 0,     /* 1.0x  (DLAA, or FSR 1 as a pure sharpen of an equal-size image: not run) */
+    RSX_UPSCALE_Q_ULTRA_QUALITY,  /* 1.3x */
+    RSX_UPSCALE_Q_QUALITY,        /* 1.5x */
+    RSX_UPSCALE_Q_BALANCED,       /* 1.7x */
+    RSX_UPSCALE_Q_PERFORMANCE,    /* 2.0x */
+    RSX_UPSCALE_Q_COUNT
+} rsx_upscale_quality;
+
+#define RSX_UPSCALE_SHARPNESS_DEFAULT 0.2f
+#define RSX_UPSCALE_SHARPNESS_MAX     2.0f
+
+typedef struct {
+    rsx_upscale_backend backend;
+    float sharpness;              /* RCAS stops, 0..2 */
+} rsx_upscale_config;
+
+/* An image the caller owns. resource = ID3D12Resource*; format = DXGI_FORMAT; state = D3D12_RESOURCE_STATES the
+ * resource is in when evaluate is called (it is back in that state when evaluate returns). */
+typedef struct {
+    void*    resource;
+    uint32_t width, height;
+    uint32_t format;
+    uint32_t state;
+} rsx_upscale_image;
+
+typedef struct {
+    void* cmd_list;                    /* ID3D12GraphicsCommandList*, open, direct queue */
+    rsx_upscale_image input;           /* colour to upscale (a texture the caller made; any sampleable 2D format) */
+    rsx_upscale_image output;          /* resource == NULL: the upscaler's own target (returned in the result); else a
+                                        * UAV-capable texture in UNORDERED_ACCESS state of exactly the output size */
+    uint32_t output_width, output_height;
+    float sharpness;                   /* < 0: the configured value */
+    /* Ignored by FSR 1 (reserved for the temporal backends): */
+    const rsx_upscale_image* depth;
+    const rsx_upscale_image* motion_vectors;
+    const rsx_upscale_image* exposure;
+    const rsx_upscale_image* reactive_mask;
+    float jitter_x, jitter_y;          /* pixels, render size */
+    float frame_time_ms;
+    int   reset_history;
+} rsx_upscale_eval;
+
+typedef struct {
+    void*    resource;                 /* the upscaled image (UNORDERED_ACCESS state; transition it before sampling) */
+    uint32_t width, height;
+    uint32_t format;
+    uint32_t state;
+} rsx_upscale_result;
+
+typedef struct rsx_upscale rsx_upscale;
+
+/* ---- pure helpers (no device) ---- */
+const char* rsx_upscale_backend_name(rsx_upscale_backend b);
+rsx_upscale_backend rsx_upscale_parse_backend(const char* s);        /* NULL / "" / unknown -> NONE */
+int   rsx_upscale_backend_implemented(rsx_upscale_backend b);        /* NONE and FSR1 */
+void  rsx_upscale_config_from_env(rsx_upscale_config* out);          /* a reserved/unimplemented backend -> NONE + log */
+float rsx_upscale_clamp_sharpness(float stops);                      /* NaN -> default, then 0..2 */
+float rsx_upscale_quality_ratio(rsx_upscale_quality q);              /* display / render, per axis */
+const char* rsx_upscale_quality_name(rsx_upscale_quality q);
+int   rsx_upscale_parse_quality(const char* s);                      /* -1 when unknown */
+/* The render size for an output size and a quality mode: out / ratio per axis, truncated, at least 1.
+ * ASSUMPTION: truncation, as FidelityFX FSR 2's ffxFsr2GetRenderResolutionFromQualityMode does; FSR 1's own docs only
+ * give the ratios. */
+void  rsx_upscale_render_size(rsx_upscale_quality q, uint32_t out_w, uint32_t out_h, uint32_t* render_w, uint32_t* render_h);
+/* FSR 1 shader constants (FsrEasuCon / FsrRcasCon of the vendored ffx_fsr1.h): EASU 16 words, RCAS 4 words. */
+void  rsx_upscale_fsr1_constants(uint32_t in_w, uint32_t in_h, uint32_t out_w, uint32_t out_h, float sharpness,
+                                 uint32_t easu[16], uint32_t rcas[4]);
+/* The complete HLSL (ffx_a.h + ffx_fsr1.h + the entry point) of one FSR 1 pass for D3DCompile (cs_5_0, entry
+ * "mainCS"): the caller defines SAMPLE_EASU=1 or SAMPLE_RCAS=1. malloc'ed, NUL-terminated; free() it. */
+char* rsx_upscale_fsr1_hlsl_source(size_t* len);
+
+/* ---- context ---- */
+/* NONE (or a backend that failed to initialise) -> NULL. device = ID3D12Device*. */
+rsx_upscale* rsx_upscale_create(const rsx_upscale_config* cfg, void* device);
+void  rsx_upscale_destroy(rsx_upscale* u);                           /* the caller has drained the GPU */
+rsx_upscale_backend rsx_upscale_get_backend(const rsx_upscale* u);   /* NULL -> NONE */
+/* The caller's way to free a resource the GPU may still use (e.g. a deferred release); without it resources are
+ * released at once, which is only safe after a GPU drain. */
+void  rsx_upscale_set_retire(rsx_upscale* u, void (*retire)(void* resource, void* user), void* user);
+/* 1 when a pass would run for this size pair now: a backend is up, the output is larger than the input in at least one
+ * axis and not smaller in the other (FSR 1 only enlarges), and the pre-HUD tap has not already run this frame. */
+int   rsx_upscale_wants_pass(const rsx_upscale* u, uint32_t in_w, uint32_t in_h, uint32_t out_w, uint32_t out_h);
+/* Records the passes on e->cmd_list. 1 = recorded and *res filled; 0 = nothing recorded (NULL, size not wanted, or a
+ * failure: the caller presents the unscaled image as before). */
+int   rsx_upscale_evaluate(rsx_upscale* u, const rsx_upscale_eval* e, rsx_upscale_result* res);
+/* The pre-HUD tap (see the top comment): evaluate + remember that this frame is already upscaled. */
+int   rsx_upscale_pre_hud(rsx_upscale* u, const rsx_upscale_eval* e, rsx_upscale_result* res);
+int   rsx_upscale_tapped(const rsx_upscale* u);
+void  rsx_upscale_frame_end(rsx_upscale* u);
+/* Counters for logs and tests. */
+uint64_t rsx_upscale_passes(const rsx_upscale* u);                   /* evaluate calls that recorded */
+
+/* ---- backend table (internal; the host test installs a fake) ---- */
+typedef struct {
+    void* (*create)(void* device, const rsx_upscale_config* cfg);    /* NULL = failed */
+    void  (*destroy)(void* be, void (*retire)(void*, void*), void* user);
+    int   (*evaluate)(void* be, const rsx_upscale_eval* e, float sharpness, rsx_upscale_result* res,
+                      void (*retire)(void*, void*), void* user);
+} rsx_upscale_ops;
+void rsx_upscale_set_test_ops(const rsx_upscale_ops* ops);           /* NULL = the real ones; tests only */
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/libs/video/rsx_upscale_d3d12.c b/libs/video/rsx_upscale_d3d12.c
new file mode 100644
index 0000000..ad5227d
--- /dev/null
+++ b/libs/video/rsx_upscale_d3d12.c
@@ -0,0 +1,269 @@
+/* rsx_upscale_d3d12.c -- the FSR 1 backend of rsx_upscale.h as two D3D12 compute passes (KZ3 patch 2145).
+ * EASU (edge-adaptive upscale) reads the input colour and writes an output-size texture; RCAS (sharpen) reads that and
+ * writes the second texture, which is the result. Both are AMD's FidelityFX FSR 1 code (MIT, see fsr1/) compiled with
+ * D3DCompile (cs_5_0) the way the renderer compiles its other HLSL: no new run-time dependency. Game-agnostic: the
+ * caller gives the command list, the input texture and its state. IIDs come from dxguid (linked by the exe). */
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <d3d12.h>
+#include <d3dcompiler.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "rsx_upscale.h"
+
+#define UP_RING 16u        /* evaluations in flight: 2 passes x 2 descriptors each */
+#define UP_FMT  DXGI_FORMAT_R8G8B8A8_UNORM
+
+typedef struct {
+    ID3D12Device* dev;
+    ID3D12RootSignature* rs;
+    ID3D12PipelineState* pso[2];            /* 0 EASU, 1 RCAS */
+    ID3D12DescriptorHeap* heap;
+    UINT step;
+    UINT ring;
+    ID3D12Resource* tex[2];                 /* EASU result, RCAS result (both UNORDERED_ACCESS between uses) */
+    UINT tw, th;
+} up_fsr1;
+
+static void up_release_tex(up_fsr1* f, void (*retire)(void*, void*), void* user)
+{
+    for (int i = 0; i < 2; i++) {
+        if (!f->tex[i]) continue;
+        if (retire) retire(f->tex[i], user);      /* the caller owns the release (deferred until the GPU is done) */
+        else f->tex[i]->lpVtbl->Release(f->tex[i]);
+        f->tex[i] = NULL;
+    }
+    f->tw = f->th = 0;
+}
+
+static int up_make_tex(up_fsr1* f, UINT w, UINT h)
+{
+    D3D12_HEAP_PROPERTIES hp = {0};
+    hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC rd = {0};
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    rd.Width = w; rd.Height = h; rd.DepthOrArraySize = 1; rd.MipLevels = 1;
+    rd.Format = UP_FMT; rd.SampleDesc.Count = 1;
+    rd.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    for (int i = 0; i < 2; i++) {
+        const HRESULT hr = f->dev->lpVtbl->CreateCommittedResource(f->dev, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+            D3D12_RESOURCE_STATE_UNORDERED_ACCESS, NULL, &IID_ID3D12Resource, (void**)&f->tex[i]);
+        if (FAILED(hr)) {
+            fprintf(stderr, "[upscale] CreateCommittedResource %ux%u failed hr=0x%08lX\n", w, h, (unsigned long)hr);
+            for (int k = 0; k < 2; k++) if (f->tex[k]) { f->tex[k]->lpVtbl->Release(f->tex[k]); f->tex[k] = NULL; }
+            return 0;
+        }
+    }
+    f->tw = w; f->th = h;
+    return 1;
+}
+
+static ID3DBlob* up_compile(const char* src, size_t len, const char* define)
+{
+    D3D_SHADER_MACRO mac[2] = { { define, "1" }, { NULL, NULL } };
+    ID3DBlob* cs = NULL; ID3DBlob* err = NULL;
+    const HRESULT hr = D3DCompile(src, len, "fsr1", mac, NULL, "mainCS", "cs_5_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &cs, &err);
+    if (FAILED(hr))
+        fprintf(stderr, "[upscale] %s compile failed hr=0x%08lX: %.400s\n", define, (unsigned long)hr,
+                err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "");
+    if (err) err->lpVtbl->Release(err);
+    return FAILED(hr) ? NULL : cs;
+}
+
+static void up_free(up_fsr1* f, void (*retire)(void*, void*), void* user)
+{
+    up_release_tex(f, retire, user);
+    if (f->heap) f->heap->lpVtbl->Release(f->heap);
+    for (int i = 0; i < 2; i++) if (f->pso[i]) f->pso[i]->lpVtbl->Release(f->pso[i]);
+    if (f->rs) f->rs->lpVtbl->Release(f->rs);
+    if (f->dev) f->dev->lpVtbl->Release(f->dev);
+    free(f);
+}
+
+static void* up_create(void* device, const rsx_upscale_config* cfg)
+{
+    (void)cfg;
+    if (!device) return NULL;
+    up_fsr1* f = (up_fsr1*)calloc(1, sizeof *f);
+    if (!f) return NULL;
+    f->dev = (ID3D12Device*)device;
+    f->dev->lpVtbl->AddRef(f->dev);
+
+    size_t len = 0;
+    char* src = rsx_upscale_fsr1_hlsl_source(&len);
+    ID3DBlob* cs[2] = { NULL, NULL };
+    if (src) { cs[0] = up_compile(src, len, "SAMPLE_EASU"); cs[1] = up_compile(src, len, "SAMPLE_RCAS"); }
+    free(src);
+    int ok = cs[0] && cs[1];
+
+    if (ok) {
+        D3D12_DESCRIPTOR_RANGE rg[2] = {0};
+        rg[0].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV; rg[0].NumDescriptors = 1;
+        rg[0].OffsetInDescriptorsFromTableStart = D3D12_DESCRIPTOR_RANGE_OFFSET_APPEND;
+        rg[1].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV; rg[1].NumDescriptors = 1;
+        rg[1].OffsetInDescriptorsFromTableStart = D3D12_DESCRIPTOR_RANGE_OFFSET_APPEND;
+        D3D12_ROOT_PARAMETER rp[2] = {0};
+        rp[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+        rp[0].Constants.Num32BitValues = 20;
+        rp[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+        rp[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+        rp[1].DescriptorTable.NumDescriptorRanges = 2;
+        rp[1].DescriptorTable.pDescriptorRanges = rg;
+        rp[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+        D3D12_STATIC_SAMPLER_DESC ss = {0};
+        ss.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+        ss.AddressU = ss.AddressV = ss.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+        ss.MaxLOD = D3D12_FLOAT32_MAX;
+        ss.ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+        D3D12_ROOT_SIGNATURE_DESC rd = {0};
+        rd.NumParameters = 2; rd.pParameters = rp;
+        rd.NumStaticSamplers = 1; rd.pStaticSamplers = &ss;
+        ID3DBlob* sig = NULL; ID3DBlob* err = NULL;
+        HRESULT hr = D3D12SerializeRootSignature(&rd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err);
+        if (err) err->lpVtbl->Release(err);
+        if (SUCCEEDED(hr)) {
+            hr = f->dev->lpVtbl->CreateRootSignature(f->dev, 0, sig->lpVtbl->GetBufferPointer(sig),
+                    sig->lpVtbl->GetBufferSize(sig), &IID_ID3D12RootSignature, (void**)&f->rs);
+            sig->lpVtbl->Release(sig);
+        }
+        ok = SUCCEEDED(hr);
+        for (int i = 0; i < 2 && ok; i++) {
+            D3D12_COMPUTE_PIPELINE_STATE_DESC pd = {0};
+            pd.pRootSignature = f->rs;
+            pd.CS.pShaderBytecode = cs[i]->lpVtbl->GetBufferPointer(cs[i]);
+            pd.CS.BytecodeLength = cs[i]->lpVtbl->GetBufferSize(cs[i]);
+            ok = SUCCEEDED(f->dev->lpVtbl->CreateComputePipelineState(f->dev, &pd, &IID_ID3D12PipelineState, (void**)&f->pso[i]));
+        }
+    }
+    for (int i = 0; i < 2; i++) if (cs[i]) cs[i]->lpVtbl->Release(cs[i]);
+    if (ok) {
+        D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+        hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+        hd.NumDescriptors = UP_RING * 4u;
+        hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+        ok = SUCCEEDED(f->dev->lpVtbl->CreateDescriptorHeap(f->dev, &hd, &IID_ID3D12DescriptorHeap, (void**)&f->heap));
+        f->step = f->dev->lpVtbl->GetDescriptorHandleIncrementSize(f->dev, D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    }
+    if (!ok) { up_free(f, NULL, NULL); return NULL; }
+    return f;
+}
+
+static void up_destroy(void* be, void (*retire)(void*, void*), void* user) { up_free((up_fsr1*)be, retire, user); }
+
+static D3D12_RESOURCE_BARRIER up_tr(ID3D12Resource* r, D3D12_RESOURCE_STATES from, D3D12_RESOURCE_STATES to)
+{
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = r;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = from;
+    b.Transition.StateAfter = to;
+    return b;
+}
+
+static void up_view(up_fsr1* f, UINT slot, ID3D12Resource* srv, DXGI_FORMAT srv_fmt, ID3D12Resource* uav)
+{
+    D3D12_CPU_DESCRIPTOR_HANDLE h;
+    f->heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(f->heap, &h);
+    h.ptr += (SIZE_T)slot * f->step;
+    D3D12_SHADER_RESOURCE_VIEW_DESC sv = {0};
+    sv.Format = srv_fmt;
+    sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    sv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    sv.Texture2D.MipLevels = 1;
+    f->dev->lpVtbl->CreateShaderResourceView(f->dev, srv, &sv, h);
+    h.ptr += f->step;
+    D3D12_UNORDERED_ACCESS_VIEW_DESC uv = {0};
+    uv.Format = UP_FMT;
+    uv.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+    f->dev->lpVtbl->CreateUnorderedAccessView(f->dev, uav, NULL, &uv, h);
+}
+
+static void up_dispatch(up_fsr1* f, ID3D12GraphicsCommandList* cl, int pass, UINT slot, const UINT c[20], UINT w, UINT h)
+{
+    D3D12_GPU_DESCRIPTOR_HANDLE g;
+    f->heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(f->heap, &g);
+    g.ptr += (UINT64)slot * f->step;
+    cl->lpVtbl->SetPipelineState(cl, f->pso[pass]);
+    cl->lpVtbl->SetComputeRootSignature(cl, f->rs);
+    cl->lpVtbl->SetComputeRoot32BitConstants(cl, 0, 20, c, 0);
+    cl->lpVtbl->SetComputeRootDescriptorTable(cl, 1, g);
+    cl->lpVtbl->Dispatch(cl, (w + 15u) / 16u, (h + 15u) / 16u, 1);
+}
+
+static int up_evaluate(void* be, const rsx_upscale_eval* e, float sharp, rsx_upscale_result* res,
+                       void (*retire)(void*, void*), void* user)
+{
+    up_fsr1* f = (up_fsr1*)be;
+    ID3D12GraphicsCommandList* cl = (ID3D12GraphicsCommandList*)e->cmd_list;
+    ID3D12Resource* in = (ID3D12Resource*)e->input.resource;
+    const UINT ow = e->output_width, oh = e->output_height;
+    ID3D12Resource* out;
+    if (e->output.resource) {
+        if (e->output.width != ow || e->output.height != oh) return 0;
+        out = (ID3D12Resource*)e->output.resource;
+    } else {
+        if (f->tw != ow || f->th != oh) {
+            up_release_tex(f, retire, user);
+            if (!up_make_tex(f, ow, oh)) return 0;
+            fprintf(stderr, "[upscale] fsr1 targets %ux%u (input %ux%u)\n", ow, oh, e->input.width, e->input.height);
+        }
+        out = f->tex[1];
+    }
+    /* Caller-provided output: the intermediate still needs a target of the output size, also when the textures exist at
+     * another size (e.g. made by an at-present evaluation before a window resize). From the Killzone 2 port's patch 6052. */
+    if (!f->tex[0] || f->tw != ow || f->th != oh) {
+        up_release_tex(f, retire, user);
+        if (!up_make_tex(f, ow, oh)) return 0;
+    }
+    ID3D12Resource* mid = f->tex[0];
+    D3D12_RESOURCE_DESC id;
+    in->lpVtbl->GetDesc(in, &id);
+    const DXGI_FORMAT ifmt = e->input.format ? (DXGI_FORMAT)e->input.format : id.Format;
+
+    UINT cE[20], cR[20];
+    uint32_t easu[16], rcas[4];
+    rsx_upscale_fsr1_constants(e->input.width, e->input.height, ow, oh, sharp, easu, rcas);
+    memcpy(cE, easu, sizeof easu);
+    cE[16] = ow; cE[17] = oh; cE[18] = cE[19] = 0;
+    memset(cR, 0, sizeof cR);
+    memcpy(cR, rcas, sizeof rcas);
+    cR[16] = ow; cR[17] = oh;
+
+    const UINT slot = (f->ring++ % UP_RING) * 4u;
+    up_view(f, slot, in, ifmt, mid);
+    up_view(f, slot + 2u, mid, UP_FMT, out);
+
+    const D3D12_RESOURCE_STATES nps = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+    const D3D12_RESOURCE_STATES ist = (D3D12_RESOURCE_STATES)e->input.state;
+    ID3D12DescriptorHeap* heaps[1] = { f->heap };
+    cl->lpVtbl->SetDescriptorHeaps(cl, 1, heaps);
+
+    D3D12_RESOURCE_BARRIER b[2];
+    UINT nb = 0;
+    if (ist != nps) b[nb++] = up_tr(in, ist, nps);
+    if (nb) cl->lpVtbl->ResourceBarrier(cl, nb, b);
+    up_dispatch(f, cl, 0, slot, cE, ow, oh);
+
+    nb = 0;
+    b[nb++] = up_tr(mid, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nps);
+    cl->lpVtbl->ResourceBarrier(cl, nb, b);
+    up_dispatch(f, cl, 1, slot + 2u, cR, ow, oh);
+
+    nb = 0;
+    b[nb++] = up_tr(mid, nps, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    if (ist != nps) b[nb++] = up_tr(in, nps, ist);
+    cl->lpVtbl->ResourceBarrier(cl, nb, b);
+
+    res->resource = out;
+    res->width = ow; res->height = oh;
+    res->format = (uint32_t)UP_FMT;
+    res->state = (uint32_t)D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    return 1;
+}
+
+const rsx_upscale_ops rsx_upscale_fsr1_d3d12_ops = { up_create, up_destroy, up_evaluate };
+#endif /* _WIN32 */
diff --git a/libs/video/rsx_upscale_fsr1.c b/libs/video/rsx_upscale_fsr1.c
new file mode 100644
index 0000000..5a87cf4
--- /dev/null
+++ b/libs/video/rsx_upscale_fsr1.c
@@ -0,0 +1,102 @@
+/* rsx_upscale_fsr1.c -- FSR 1 constants and shader source (KZ3 patch 2145). Portable C.
+ * Uses AMD's FidelityFX FSR 1 headers (MIT, Copyright (c) 2021 Advanced Micro Devices, Inc.; vendored unmodified in
+ * fsr1/, see fsr1/README.txt): ffx_a.h/ffx_fsr1.h in their CPU mode compute the constants, and the same files' text
+ * (fsr1_embed.h) is the GPU code. The headers define many short macros (AF1, AU1, ...) and unused statics, so they
+ * live in this translation unit alone. */
+#include "rsx_upscale.h"
+
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#if defined(__GNUC__)
+#pragma GCC diagnostic ignored "-Wunused-function"
+#pragma GCC diagnostic ignored "-Wunused-variable"
+#pragma GCC diagnostic ignored "-Wignored-qualifiers"
+#endif
+
+#define A_CPU 1
+#include "fsr1/ffx_a.h"
+#include "fsr1/ffx_fsr1.h"
+#include "fsr1/fsr1_embed.h"
+
+void rsx_upscale_fsr1_constants(uint32_t in_w, uint32_t in_h, uint32_t out_w, uint32_t out_h, float sharpness,
+                                uint32_t easu[16], uint32_t rcas[4])
+{
+    AU1 c0[4], c1[4], c2[4], c3[4], r[4];
+    /* Whole texture is the viewport: input viewport size == input resource size. */
+    FsrEasuCon(c0, c1, c2, c3, (AF1)in_w, (AF1)in_h, (AF1)in_w, (AF1)in_h, (AF1)out_w, (AF1)out_h);
+    FsrRcasCon(r, sharpness);
+    for (int i = 0; i < 4; i++) {
+        easu[i] = c0[i]; easu[4 + i] = c1[i]; easu[8 + i] = c2[i]; easu[12 + i] = c3[i];
+        rcas[i] = r[i];
+    }
+}
+
+/* The pass wrapper: the structure of the FSR sample's FSR_Pass.hlsl "slow fallback" (32-bit) path, with our constant
+ * block (Dims = output size, the guard against the 16x16-tile overhang) and a clamped RCAS load. */
+static const char k_pre[] =
+    "cbuffer cb : register(b0)\n{\n  uint4 Const0;\n  uint4 Const1;\n  uint4 Const2;\n  uint4 Const3;\n  uint4 Dims;\n};\n"
+    "#ifndef SAMPLE_EASU\n#define SAMPLE_EASU 0\n#endif\n#ifndef SAMPLE_RCAS\n#define SAMPLE_RCAS 0\n#endif\n"
+    "#define A_GPU 1\n#define A_HLSL 1\n"
+    "SamplerState samLinearClamp : register(s0);\n";
+static const char k_mid[] =
+    "Texture2D InputTexture : register(t0);\n"
+    "RWTexture2D<float4> OutputTexture : register(u0);\n"
+    "#if SAMPLE_EASU\n"
+    "#define FSR_EASU_F 1\n"
+    "AF4 FsrEasuRF(AF2 p) { return InputTexture.GatherRed(samLinearClamp, p, int2(0, 0)); }\n"
+    "AF4 FsrEasuGF(AF2 p) { return InputTexture.GatherGreen(samLinearClamp, p, int2(0, 0)); }\n"
+    "AF4 FsrEasuBF(AF2 p) { return InputTexture.GatherBlue(samLinearClamp, p, int2(0, 0)); }\n"
+    "#endif\n"
+    "#if SAMPLE_RCAS\n"
+    "#define FSR_RCAS_F 1\n"
+    "AF4 FsrRcasLoadF(ASU2 p) { return InputTexture.Load(int3(clamp(int2(p), int2(0, 0), int2(Dims.xy) - 1), 0)); }\n"
+    "void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}\n"
+    "#endif\n";
+static const char k_post[] =
+    "void CurrFilter(uint2 pos)\n{\n"
+    "  if (pos.x >= Dims.x || pos.y >= Dims.y) return;\n"
+    "  AF3 c;\n"
+    "#if SAMPLE_EASU\n"
+    "  FsrEasuF(c, pos, Const0, Const1, Const2, Const3);\n"
+    "#endif\n"
+    "#if SAMPLE_RCAS\n"
+    "  FsrRcasF(c.r, c.g, c.b, pos, Const0);\n"
+    "#endif\n"
+    "  OutputTexture[pos] = float4(c, 1);\n}\n"
+    "[numthreads(64, 1, 1)]\n"
+    "void mainCS(uint3 LocalThreadId : SV_GroupThreadID, uint3 WorkGroupId : SV_GroupID)\n{\n"
+    "  AU2 gxy = ARmp8x8(LocalThreadId.x) + AU2(WorkGroupId.x << 4u, WorkGroupId.y << 4u);\n"
+    "  CurrFilter(gxy);\n  gxy.x += 8u;\n  CurrFilter(gxy);\n  gxy.y += 8u;\n  CurrFilter(gxy);\n  gxy.x -= 8u;\n  CurrFilter(gxy);\n}\n";
+
+static size_t lines_len(const char* const* l, size_t n)
+{
+    size_t t = 0;
+    for (size_t i = 0; i < n; i++) t += strlen(l[i]) + 1;
+    return t;
+}
+static char* put_lines(char* p, const char* const* l, size_t n)
+{
+    for (size_t i = 0; i < n; i++) { const size_t k = strlen(l[i]); memcpy(p, l[i], k); p += k; *p++ = '\n'; }
+    return p;
+}
+
+char* rsx_upscale_fsr1_hlsl_source(size_t* len)
+{
+    const size_t na = sizeof rsx_fsr1_ffx_a_lines / sizeof rsx_fsr1_ffx_a_lines[0];
+    const size_t nf = sizeof rsx_fsr1_ffx_fsr1_lines / sizeof rsx_fsr1_ffx_fsr1_lines[0];
+    const size_t total = sizeof k_pre - 1 + lines_len(rsx_fsr1_ffx_a_lines, na) + sizeof k_mid - 1 +
+                         lines_len(rsx_fsr1_ffx_fsr1_lines, nf) + sizeof k_post - 1;
+    char* s = (char*)malloc(total + 1);
+    if (!s) return NULL;
+    char* p = s;
+    memcpy(p, k_pre, sizeof k_pre - 1); p += sizeof k_pre - 1;
+    p = put_lines(p, rsx_fsr1_ffx_a_lines, na);
+    memcpy(p, k_mid, sizeof k_mid - 1); p += sizeof k_mid - 1;
+    p = put_lines(p, rsx_fsr1_ffx_fsr1_lines, nf);
+    memcpy(p, k_post, sizeof k_post - 1); p += sizeof k_post - 1;
+    *p = 0;
+    if (len) *len = (size_t)(p - s);
+    return s;
+}
