diff --git a/libs/input/pad_host.h b/libs/input/pad_host.h
index 845b2acf..456308cb 100644
--- a/libs/input/pad_host.h
+++ b/libs/input/pad_host.h
@@ -419,4 +419,82 @@ static const char* const pad_sdl_env_hints[] PAD_HOST_UNUSED = {
 };
 #define PAD_SDL_HINT_OVERRIDE 2   /* SDL_HintPriority SDL_HINT_OVERRIDE */
 
+/* ---- KZ3 patch 4011 (stage 2): the device prompts are drawn for --------------------------------------------
+ * The "last device" is the keyboard/mouse or the pad type of the port whose input arrived last (SDL_GetGamepadType at
+ * open; the XInput backend = Xbox; a port with no host pad behind it, e.g. PAD_SCRIPT's, counts as a PS3 pad). Before
+ * any input it is the first connected host pad, else nothing (= the game's own PS3 prompts, as before 2039).
+ * PAD_PROMPT_* are the glyph sets of rsx_prompt_glyphs.h (patch 2090: PG_PS3, PG_PS4, PG_XBOX, PG_KBM). */
+enum { PAD_DEV_NONE = 0, PAD_DEV_KEYBOARD, PAD_DEV_PS3, PAD_DEV_PS4, PAD_DEV_PS5, PAD_DEV_XBOX, PAD_DEV_SWITCH,
+       PAD_DEV_OTHER, PAD_DEV_N };
+enum { PAD_PROMPT_PS3 = 0, PAD_PROMPT_PS4 = 1, PAD_PROMPT_XBOX = 2, PAD_PROMPT_KBM = 3 };
+
+/* SDL_GamepadType -> device. */
+static inline int pad_dev_from_sdl_type(int t)
+{
+    switch (t) {
+    case 2: case 3: return PAD_DEV_XBOX;            /* Xbox 360, Xbox One / Series */
+    case 4:         return PAD_DEV_PS3;
+    case 5:         return PAD_DEV_PS4;
+    case 6:         return PAD_DEV_PS5;
+    case 7: case 8: case 9: case 10: return PAD_DEV_SWITCH;   /* Switch Pro, Joy-Con L/R/pair */
+    default:        return PAD_DEV_OTHER;           /* unknown / standard gamepad */
+    }
+}
+
+static inline const char* pad_dev_name(int d)
+{
+    static const char* const n[PAD_DEV_N] = { "none", "keyboard", "PS3 pad", "PS4 pad", "PS5 pad", "Xbox pad",
+                                              "Switch pad", "other pad" };
+    return d >= 0 && d < PAD_DEV_N ? n[d] : "?";
+}
+
+/* Glyph set for a device. Switch and unknown pads keep the game's PS3 shapes (ASSUMPTION: the Xbox letters would sit
+ * on the wrong buttons of a Switch pad, whose south button reads B; no Switch set yet). */
+static inline int pad_prompt_set_for_device(int d)
+{
+    switch (d) {
+    case PAD_DEV_KEYBOARD: return PAD_PROMPT_KBM;
+    case PAD_DEV_PS4: case PAD_DEV_PS5: return PAD_PROMPT_PS4;
+    case PAD_DEV_XBOX: return PAD_PROMPT_XBOX;
+    default: return PAD_PROMPT_PS3;
+    }
+}
+
+/* A button, a trigger past the L2/R2 threshold or a stick well off centre: the player is using this pad (the same
+ * stick test 2038 used for "the pad is the last device again"). */
+static inline int pad_host_input_active(const PadHostState* hs)
+{
+    if (!hs->connected) return 0;
+    if (hs->buttons) return 1;
+    if (hs->trigger_l2 > PAD_HOST_TRIGGER_THRESHOLD || hs->trigger_r2 > PAD_HOST_TRIGGER_THRESHOLD) return 1;
+    return hs->analog_lx < 64 || hs->analog_lx > 192 || hs->analog_ly < 64 || hs->analog_ly > 192 ||
+           hs->analog_rx < 64 || hs->analog_rx > 192 || hs->analog_ry < 64 || hs->analog_ry > 192;
+}
+
+typedef struct { int dev; int port; } PadLastDevice;   /* port -1 = keyboard / none */
+
+/* One poll: the keys first, then every pad port with input (a pad wins over the keys in the same poll, as in 2038).
+ * port_dev[p] = the host pad behind port p (PAD_DEV_NONE: none, e.g. a scripted port). Returns 1 when it changed. */
+static inline int pad_last_device_update(PadLastDevice* l, int keys_active, const PadHostState* hs, const int* port_dev,
+                                         int nports)
+{
+    PadLastDevice o = *l;
+    if (keys_active) { l->dev = PAD_DEV_KEYBOARD; l->port = -1; }
+    for (int p = 0; p < nports; p++)
+        if (pad_host_input_active(&hs[p])) { l->dev = port_dev[p] ? port_dev[p] : PAD_DEV_PS3; l->port = p; }
+    return l->dev != o.dev || l->port != o.port;
+}
+
+/* The device prompts follow: the last one, else the first connected host pad, else none. *port gets its port. */
+static inline int pad_last_device_current(const PadLastDevice* l, const PadHostState* hs, const int* port_dev, int nports,
+                                          int* port)
+{
+    if (l->dev != PAD_DEV_NONE) { if (port) *port = l->port; return l->dev; }
+    for (int p = 0; p < nports; p++)
+        if (hs[p].connected && port_dev[p]) { if (port) *port = p; return port_dev[p]; }
+    if (port) *port = -1;
+    return PAD_DEV_NONE;
+}
+
+
 #endif
