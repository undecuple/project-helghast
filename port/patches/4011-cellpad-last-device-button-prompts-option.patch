+/* ---------------------------------------------------------------------------
+ * KZ3 patch 4011 (stage 2): the device the button prompts are drawn for
+ * -----------------------------------------------------------------------*/
+static void pad_prompt_track(void)
+{
+    static int said = 0;
+    int keys = s_keys_active;
+    s_keys_active = 0;
+    if (pad_last_device_update(&s_last_dev, keys, s_host_state, s_port_dev, PAD_MAX_HOST_PORTS) && said < 40) {
+        said++;
+        printf("[pad] last input: %s%s (port %d)\n", pad_dev_name(s_last_dev.dev),
+               s_last_dev.port >= 0 && s_port_motion[s_last_dev.port] ? ", motion sensors" : "", s_last_dev.port);
+        fflush(stdout);
+    }
+}
+
+/* PAD_DEV_* of the device the prompts follow (the last input; before any, the first connected host pad). */
+int pad_prompt_device(void)
+{
+    return pad_last_device_current(&s_last_dev, s_host_state, s_port_dev, PAD_MAX_HOST_PORTS, NULL);
+}
+
+/* 1 when that device has working motion sensors (a pad whose accelerometer or gyro 4010 turned on); 0 for the
+ * keyboard, XInput pads, pads without sensors and no device. For the motion tips (port/net/kz3_text_overrides.h). */
+int pad_prompt_motion(void)
+{
+    int port = -1;
+    int dev = pad_last_device_current(&s_last_dev, s_host_state, s_port_dev, PAD_MAX_HOST_PORTS, &port);
+    if (dev == PAD_DEV_KEYBOARD || port < 0 || port >= PAD_MAX_HOST_PORTS) return 0;
+    return s_port_motion[port];
+}
+
+/* The glyph set (PAD_PROMPT_* = rsx_prompt_glyphs.h PG_*) the prompt atlases are drawn with: the Options row's choice,
+ * KZ3_PROMPTS=auto|ps3|ps4|xbox|keyboard (tests) before it; Auto = the device of pad_prompt_device. */
+int pad_prompt_set(void)
+{
+    static int env = -2;
+    if (env == -2) {
+        const char* e = getenv("KZ3_PROMPTS");
+        env = (e && *e) ? pad_kb_prompts_by_name(e, strlen(e)) : -1;
+        if (e && *e) { printf("[pad] KZ3_PROMPTS=%s: %s\n", e, env < 0 ? "unknown value, ignored" : "button prompts forced"); fflush(stdout); }
+    }
+#ifdef _WIN32
+    int opt = env >= 0 ? env : pad_kb_prompts_option();
+#else
+    int opt = env >= 0 ? env : PKB_PROMPTS_AUTO;
+#endif
+    switch (opt) {
+    case PKB_PROMPTS_PS3: return PAD_PROMPT_PS3;
+    case PKB_PROMPTS_PS4: return PAD_PROMPT_PS4;
+    case PKB_PROMPTS_XBOX: return PAD_PROMPT_XBOX;
+    case PKB_PROMPTS_KEYBOARD: return PAD_PROMPT_KBM;
+    default: break;
+    }
+    int dev = pad_prompt_device();
+#ifdef _WIN32
+    if (pad_kb_auto_keyboard(dev == PAD_DEV_KEYBOARD)) return PAD_PROMPT_KBM;
+#endif
+    if (dev == PAD_DEV_KEYBOARD) {   /* keycaps forced off: the pad that is plugged in */
+        PadLastDevice none = { PAD_DEV_NONE, -1 };
+        dev = pad_last_device_current(&none, s_host_state, s_port_dev, PAD_MAX_HOST_PORTS, NULL);
+    }
+    return pad_prompt_set_for_device(dev);
+}
+
+#ifdef _WIN32
+/* For 2039's keycap prompts: 1 when the prompts are keycaps (pad_prompt_set; was "the last input was a key"). */
+int pad_kb_last_device_keyboard(void)
+{
+    return pad_prompt_set() == PAD_PROMPT_KBM;
+}
+#endif
