     if (!en || !g.ready || !size) return 0;
     const u64 r0 = offset, r1 = r0 + size;
-    u32 done = 0;
+    u32 done = 0, idx[64], n = 0;
     for (u32 i = 0; i < g.n_surfaces; i++) {
         const surface_t* sf = &g.surfaces[i];
         if (!sf->tex || sf->location != location) continue;
@@ -10120,8 +10269,9 @@ u32 rsx_live_draw_writeback_range(u32 location, u32 offset, u32 size)
         if (gp < sf->w * texel) continue;
         const u64 s0 = sf->offset, s1 = s0 + (u64)gp * (sf->h - 1u) + (u64)sf->w * texel;
         if (!(s0 < r1 && r0 < s1)) continue;
-        done += (u32)ld_writeback_surface(i, offset, size);
+        if (n < 64) idx[n++] = i;   /* patch 2018: batched */
     }
+    done = ld_writeback_batch(idx, n, offset, size);
     return done;
 }
 
@@ -10139,16 +10289,22 @@ u32 rsx_live_draw_before_guest_sync(void)
     static int en = -1;
     if (en < 0) { const char* e = getenv("LD_MAIN_SURFACE_WRITEBACK"); en = e ? atoi(e) : 1; }
     if (!en || !g.ready) return 0;
-    u32 done = 0;
-    for (u32 i = 0; i < g.n_surfaces; i++)
