-        if (n++ < 8 || (n & 1023u) == 0)
-            fprintf(stderr, "[main-surface-writeback] %u surface(s) at a guest sync point (frame %u, total %llu)\n",
-                    done, g_ld_frames, (unsigned long long)total);
+        static u32 nlog;
+        if (nlog++ < 8 || (nlog & 1023u) == 0) {
+            double us = 0; u32 b = 0, sfc = 0, w = 0;
+            rsx_live_draw_debug_writeback_stats(&us, &b, &sfc, &w);
+            fprintf(stderr, "[main-surface-writeback] %u surface(s) at a guest sync point (frame %u, total %llu; "
+                    "all write-backs: %u batches, %u GPU waits, %.0f us avg)\n",
+                    done, g_ld_frames, (unsigned long long)total, b, w, b ? us / b : 0.0);
