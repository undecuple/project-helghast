-            done += (u32)ld_writeback_surface(i, g.surfaces[i].offset, 0);
+            idx[n++] = i;
+    if (!n) return 0;
+    const u32 done = ld_writeback_batch(idx, n, 0, 0);   /* patch 2018: one GPU wait */
