+/* KZ3 patch 1009 diagnostic, GCM_PARK_TRACE=1: the last 8 placeholder parks the walker
+ * went through (park words, put, both KZ3 contexts' `current`, a snapshot of the
+ * sub-block), dumped with a diff against memory now when a park times out. */
+#define KZ3_PT_N 8
+#define KZ3_PT_SNAP 0x900
+typedef struct { u32 park, tgt, refs, put, t_ms, cur0, cur1, ret_from, ret_cur1, ret_t; u8 snap[KZ3_PT_SNAP]; } kz3_pt;
+static kz3_pt s_pt[KZ3_PT_N]; static unsigned s_pt_n = 0;
+static u32 gcm_ea2io(u32 ea);
+static int kz3_pt_on(void) { static int on = -1; if (on < 0) on = getenv("GCM_PARK_TRACE") ? 1 : 0; return on; }
+static u32 kz3_ctx_cur(int which) { u32 g = vm_read32(0x0133163Cu); if (!g) return 0;
+    u32 c = vm_read32(g + (which ? 0xF0u : 0x10u) + 8u); return c ? gcm_ea2io(c) : 0; }
+static u32 kz3_pt_ms(void) { return (u32)(get_timestamp_ns() / 1000000ull); }
+static void kz3_pt_jump(u32 from, u32 tgt, u32 put) {
+    if (!kz3_pt_on()) return;
+    u32 fea = gcm_io2ea(from); if (!fea) return;
+    if (vm_read32(fea + 8) == vm_read32(fea) && vm_read32(fea + 4) < 16u) {   /* P[0] == P[2]: patched placeholder */
+        kz3_pt* e = &s_pt[s_pt_n++ % KZ3_PT_N]; memset(e, 0, sizeof *e);
+        e->park = from; e->tgt = tgt; e->refs = vm_read32(fea + 4); e->put = put;
+        e->t_ms = kz3_pt_ms(); e->cur0 = kz3_ctx_cur(0); e->cur1 = kz3_ctx_cur(1);
+        for (u32 i = 0; i < KZ3_PT_SNAP; i += 4) { u32 ea = gcm_io2ea(tgt + i); u32 v = ea ? vm_read32(ea) : 0; memcpy(e->snap + i, &v, 4); }
+        return;
+    }
+    if (s_pt_n) { kz3_pt* e = &s_pt[(s_pt_n - 1) % KZ3_PT_N];
+        if (tgt == e->park + 0xC && !e->ret_from) { e->ret_from = from; e->ret_cur1 = kz3_ctx_cur(1); e->ret_t = kz3_pt_ms(); } }
+}
+static void kz3_pt_ctx(const char* tag) {
+    u32 g = vm_read32(0x0133163Cu); if (!g) return;
+    for (int w = 0; w < 2; w++) { u32 c = g + (w ? 0xF0u : 0x10u);
+        u32 b = vm_read32(c), en = vm_read32(c + 4), cu = vm_read32(c + 8), pp = vm_read32(c + 0x70), r = vm_read32(c + 0x74);
+        fprintf(stderr, "[park-ctx] %s t=%u ctx%d@%08X begin=%08X(io %08X) end=%08X cur=%08X(io %08X) P=%08X(io %08X) ret=%08X\n",
+                tag, kz3_pt_ms(), w, c, b, gcm_ea2io(b), en, cu, gcm_ea2io(cu), pp, gcm_ea2io(pp), r); }
+    fprintf(stderr, "[park-ctx] %s G+5B0=%08X G+5B8=%08X label480=%08X label490=%08X label4A0=%08X get=%08X\n", tag,
+            vm_read32(g + 0x5B0), vm_read32(g + 0x5B8), vm_read32(0x20000480u), vm_read32(0x20000490u), vm_read32(0x200004A0u), s_fifo_getoff);
+}
+static void kz3_pt_dump(void) {
+    if (!kz3_pt_on()) return;
+    unsigned first = s_pt_n > KZ3_PT_N ? s_pt_n - KZ3_PT_N : 0;
+    for (unsigned k = first; k < s_pt_n; k++) { kz3_pt* e = &s_pt[k % KZ3_PT_N];
+        u32 nch = 0, lo = 0xFFFFFFFFu, hi = 0, term_then = 0xFFFFFFFFu, term_now = 0xFFFFFFFFu, back = 0x20000000u | (e->park + 0xC);
+        for (u32 i = 0; i < KZ3_PT_SNAP; i += 4) { u32 ea = gcm_io2ea(e->tgt + i); u32 v = ea ? vm_read32(ea) : 0, o; memcpy(&o, e->snap + i, 4);
+            if (v != o) { nch++; if (i < lo) lo = i; hi = i; }
+            if (o == back && term_then == 0xFFFFFFFFu) term_then = i;
+            if (v == back && term_now == 0xFFFFFFFFu) term_now = i; }
+        fprintf(stderr, "[park-trace] #%u t=%u park=%08X refs=%u -> %08X put=%08X cur0=%08X cur1=%08X | ret from %08X t=%u cur1=%08X | term then +%X now +%X | %u words changed since [+%X..+%X] now t=%u\n",
+                k, e->t_ms, e->park, e->refs, e->tgt, e->put, e->cur0, e->cur1, e->ret_from, e->ret_t, e->ret_cur1,
+                term_then, term_now, nch, lo, hi, kz3_pt_ms()); }
+    kz3_pt_ctx("timeout");
+    fflush(stderr);
+}
