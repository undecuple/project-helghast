+/* KZ3 patch 1011: the persistent PM contexts at file scope, so a stuck run can be
+ * described from another thread (cellSpurs.c [spurs-stuck]). */
+static spu_context* g_pm_ctx_tab[16][6];
+void* spu_pm_ctx_peek(uint32_t wid, uint32_t spu_num)
+{
+    return (wid < 16 && spu_num < 6) ? (void*)g_pm_ctx_tab[wid][spu_num] : NULL;
+}
+void spu_pm_ctx_describe(void* p, char* out, int n)
+{
+    spu_context* c = (spu_context*)p;
+    if (!c) { snprintf(out, n, "no context"); return; }
+    uint32_t w[8];
+    static const uint32_t at[8] = { 0x1520, 0x1560, 0x12A0, 0x12C0, 0x12F0, 0x1320, 0x1330, 0x1420 };
+    for (int i = 0; i < 8; i++) { uint32_t t; memcpy(&t, (const uint8_t*)c->ls + at[i], 4); w[i] = __builtin_bswap32(t); }
+    snprintf(out, n, "img=%d pc=0x%05X lr=0x%05X sp=0x%05X status=0x%X depth=%u tagstat=0x%X evstat=0x%X"
+             " LS1520=%08X 1560=%08X 12A0=%08X 12C0=%08X 12F0=%08X 1320=%08X 1330=%08X 1420=%08X",
+             c->image_id, c->pc & SPU_LS_MASK, c->gpr[0]._u32[0] & SPU_LS_MASK, c->gpr[1]._u32[0] & SPU_LS_MASK,
+             c->status, c->host_depth, c->mfc_tag_status, c->event_status,
+             w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7]);
+}
