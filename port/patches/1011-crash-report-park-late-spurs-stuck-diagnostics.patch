 extern "C" ppu_context* volatile g_ppu_main_ctx = nullptr;
+#ifdef _WIN32
+/* KZ3 patch 1011: last-chance crash report. A host access violation the VM's own
+ * handlers do not claim used to end the process with exit code 0xC0000005 and no
+ * output (KZ3 after the intro movie). Print the code, the fault address, the RIP
+ * and up to 24 host frames as RVAs (nm/addr2line on the exe) plus the guest
+ * function each one belongs to, and the thread's guest context. Report only: it
+ * returns EXCEPTION_CONTINUE_SEARCH, so the process ends exactly as before.
+ * PS3_NO_CRASH_REPORT=1 leaves the filter out. */
+extern "C" uint32_t    g_last_hle_nid;
+extern "C" const char* g_last_hle_name;
+static LONG WINAPI ppu_crash_report(EXCEPTION_POINTERS* ep)
+{
+    static volatile LONG s_once = 0;
+    if (InterlockedExchange(&s_once, 1)) return EXCEPTION_CONTINUE_SEARCH;
+    EXCEPTION_RECORD* er = ep->ExceptionRecord;
+    char* mbase = (char*)GetModuleHandleA(NULL);
+    fprintf(stderr, "\n[CRASH] code=0x%08lX rip rva=0x%llX guest-fn=0x%08X tid=%lu last HLE 0x%08X (%s)\n",
+            (unsigned long)er->ExceptionCode, (unsigned long long)((char*)er->ExceptionAddress - mbase),
+            ppu_prof_resolve_host(er->ExceptionAddress), (unsigned long)GetCurrentThreadId(),
+            g_last_hle_nid, g_last_hle_name ? g_last_hle_name : "");
+    if (er->ExceptionCode == EXCEPTION_ACCESS_VIOLATION && er->NumberParameters >= 2)
+        fprintf(stderr, "[CRASH] %s of host 0x%llX (vm_base %p, guest 0x%llX)\n",
+                er->ExceptionInformation[0] == 1 ? "write" : er->ExceptionInformation[0] == 8 ? "execute" : "read",
+                (unsigned long long)er->ExceptionInformation[1], (void*)vm_base,
+                (unsigned long long)(er->ExceptionInformation[1] - (uintptr_t)vm_base));
+    if (g_active_ctx)
+        fprintf(stderr, "[CRASH] guest cia=0x%08X lr=0x%08X ctr=0x%08X r1=0x%08X r3=0x%08X r4=0x%08X r5=0x%08X r31=0x%08X\n",
+                (uint32_t)g_active_ctx->cia, (uint32_t)g_active_ctx->lr, (uint32_t)g_active_ctx->ctr,
+                (uint32_t)g_active_ctx->gpr[1], (uint32_t)g_active_ctx->gpr[3], (uint32_t)g_active_ctx->gpr[4],
+                (uint32_t)g_active_ctx->gpr[5], (uint32_t)g_active_ctx->gpr[31]);
+    CONTEXT c = *ep->ContextRecord;
+    fprintf(stderr, "[CRASH] rax=%llX rbx=%llX rcx=%llX rdx=%llX rsi=%llX rdi=%llX r8=%llX r9=%llX\n",
+            (unsigned long long)c.Rax, (unsigned long long)c.Rbx, (unsigned long long)c.Rcx, (unsigned long long)c.Rdx,
+            (unsigned long long)c.Rsi, (unsigned long long)c.Rdi, (unsigned long long)c.R8, (unsigned long long)c.R9);
+    /* Walk the faulting thread's stack from its own context (RtlCaptureStackBackTrace
+     * here would start in the filter's dispatcher frames). */
+    for (int i = 0; i < 24 && c.Rip; i++) {
+        DWORD64 img = 0; PRUNTIME_FUNCTION rf = RtlLookupFunctionEntry(c.Rip, &img, NULL);
+        fprintf(stderr, "[CRASH]   #%-2d rva=0x%llX guest-fn=0x%08X\n", i,
+                (unsigned long long)((char*)c.Rip - mbase), ppu_prof_resolve_host((void*)c.Rip));
+        if (!rf) { c.Rip = *(DWORD64*)c.Rsp; c.Rsp += 8; continue; }
+        void* hd = NULL; DWORD64 ef = 0;
+        RtlVirtualUnwind(UNW_FLAG_NHANDLER, img, c.Rip, rf, &c, &hd, &ef, NULL);
+    }
+    fflush(stderr); fflush(stdout);
+    return EXCEPTION_CONTINUE_SEARCH;
+}
+#endif
 
