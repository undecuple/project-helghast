KZ3 patch 2165 (RSX pass 153): pipeline template format v2. rsx_pt_rec gains vp_branch_bits (register 0x1FF8 as patch 2100
hashes it into the key for vertex programs that test branch bits). ld_pt_note stores xi->vp_branch_bits, ld_pt_build copies it into
xi.vp_branch_bits before the ld_pso_key_tail check, so records drawn with nonzero bits no longer fail the prewarm key check
(vertex programs that test branch bits failed the key check: 20 of 371 records in one capture). RSX_PT_VERSION 1 -> 2, record 556 -> 560 bytes; v1 files are refused
("another format version ... re-export with LD_PSO_TEMPLATE_OUT"). Field placed after rs_words (ASSUMPTION: the field's offset is a
choice made here; any reader of v2 files must use the same place). Host test tools/smoke/test_pso_template.sh (round trip, v1 refusal,
key-check negative control).

diff --git a/libs/video/rsx_pso_template.h b/libs/video/rsx_pso_template.h
--- a/libs/video/rsx_pso_template.h
+++ b/libs/video/rsx_pso_template.h
@@ -26,7 +26,7 @@
 #include <string.h>
 
 #define RSX_PT_MAGIC     0x54505A4Bu   /* bytes "KZPT" */
-#define RSX_PT_VERSION   1u
+#define RSX_PT_VERSION   2u   /* v2 (patch 2165): rsx_pt_rec has vp_branch_bits; v1 files are another format and are refused */
 /* Bump when the meaning of a record or the way the walker derives the pipeline key changes: a file with another
  * key version is ignored (its keys would never match, its records would build pipelines nothing asks for). */
 #define RSX_PT_KEYVER    1u
@@ -54,6 +54,7 @@
     uint32_t shadow_mask, argb_mask, unnorm_mask, flags;
     uint32_t layout_mask, layout_stride, layout_count;
     uint32_t rs_words;                  /* used words of rs[] (sizeof the walker's render state / 4) */
+    uint32_t vp_branch_bits;            /* v2: register 0x1FF8 as hashed into the key (0 when the VP tests no branch bits) */
     uint8_t  shadow_zfunc[16];
     uint16_t argb_remap[16];
     uint32_t unnorm_dim[16][2];
