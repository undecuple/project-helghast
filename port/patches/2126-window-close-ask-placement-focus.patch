+static void rsx_wm_focus_note(int focused, int minimized, const char* why)
+{
+    if (focused == s_wm_focused && minimized == s_wm_min) return;
+    s_wm_focused = focused; s_wm_min = minimized;
+    printf("[focus] %s: %s%s\n", why, focused ? "focused" : "not focused", minimized ? ", minimised" : "");
+    fflush(stdout);
+    if (s_wm_focus) s_wm_focus(focused, minimized);
+}
