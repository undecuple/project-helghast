+/* rsx_dm_ini_value, with the blanks after '=' dropped */
+static inline int rsx_wp_value(const char* t, const char* key, char* out, size_t cap)
+{
+    size_t i = 0;
+    if (!rsx_dm_ini_value(t, key, out, cap)) return 0;
+    while (out[i] == ' ' || out[i] == '\t') i++;
+    if (i) memmove(out, out + i, strlen(out + i) + 1);
+    return 1;
+}
+
+/* ---- Close (item 1) ----------------------------------------------------------------------------------------------
+ * Sources: USER = WM_SYSCOMMAND SC_CLOSE (the X button, Alt+F4, the system menu's and the taskbar's Close);
+ * SCRIPT = a bare WM_CLOSE (KZ3_TEST_CLOSE, tools/release/shaders.py, any outside tool, the exit dialog's own Yes);
+ * ENDSESSION = WM_ENDSESSION (logoff, shutdown). Only USER may ask. */
+enum { RSX_CLOSE_SRC_USER = 0, RSX_CLOSE_SRC_SCRIPT = 1, RSX_CLOSE_SRC_ENDSESSION = 2 };
+enum { RSX_CLOSE_NOW = 0, RSX_CLOSE_ASK_MENU = 1, RSX_CLOSE_ASK_PAUSE = 2 };
+typedef struct {
+    int off;        /* KZ3_CLOSE_ASK=0 */
+    int ui;         /* the port tracks the game's menus (2098's GUM context and frame tick) and the dialog rows are in */
+    int menu;       /* a GUM page has the focus */
+    int ask_page;   /* that page is one with the exit dialog (main menu, pause menu: it registered from its OnPageOn) */
+    int busy;       /* an ask is in flight or the dialog is up: a second X closes */
+    int fault;      /* the crash / fatal-error path */
+} rsx_close_ctx;
+static inline int rsx_close_decide(int src, const rsx_close_ctx* c)
+{
+    if (src != RSX_CLOSE_SRC_USER || c->off || c->fault || !c->ui || c->busy) return RSX_CLOSE_NOW;
+    if (c->menu) return c->ask_page ? RSX_CLOSE_ASK_MENU : RSX_CLOSE_NOW;   /* loading screen, movie, other pages */
+    return RSX_CLOSE_ASK_PAUSE;                                              /* play: pause menu first */
+}
+static inline const char* rsx_close_name(int d)
+{
+    return d == RSX_CLOSE_ASK_MENU ? "ask (dialog on this page)" : d == RSX_CLOSE_ASK_PAUSE ? "ask (pause menu, then dialog)" : "close now";
+}
+static inline const char* rsx_close_src_name(int s)
+{
+    return s == RSX_CLOSE_SRC_USER ? "X / Alt+F4 / system menu" : s == RSX_CLOSE_SRC_ENDSESSION ? "end of session" : "WM_CLOSE";
+}
+
+/* ---- When unfocused (item 3) -------------------------------------------------------------------------------------- */
+enum { RSX_UNF_KEEP = 0, RSX_UNF_MUTE = 1, RSX_UNF_PAUSE = 2 };
+static inline const char* rsx_unf_name(int v) { return v == RSX_UNF_MUTE ? "mute" : v == RSX_UNF_PAUSE ? "pause" : "keep"; }
+static inline int rsx_unf_parse(const char* s)   /* -1 unreadable */
+{
+    size_t n;
+    if (!s) return -1;
+    n = strlen(s);
+    while (n && (*s == ' ' || *s == '\t')) { s++; n--; }
+    while (n && (s[n - 1] == ' ' || s[n - 1] == '\t' || s[n - 1] == '\r')) n--;
+    if (rsx_dm_ieq(s, n, "keep") || rsx_dm_ieq(s, n, "run") || rsx_dm_ieq(s, n, "keep running")) return RSX_UNF_KEEP;
+    if (rsx_dm_ieq(s, n, "mute")) return RSX_UNF_MUTE;
+    if (rsx_dm_ieq(s, n, "pause")) return RSX_UNF_PAUSE;
+    return -1;
+}
+static inline int rsx_dm_ini_unfocused(const char* t)
+{
+    char v[32];
+    return rsx_dm_ini_value(t, "unfocused", v, sizeof v) ? rsx_unf_parse(v) : -1;
+}
+/* Mute while the window is not the foreground one or is minimised (the port's own output only). */
+static inline int rsx_unf_muted(int setting, int focused, int minimized) { return setting == RSX_UNF_MUTE && (!focused || minimized); }
+/* Pause: once, on the change from focused to not focused, and only in play (no game menu up, nothing pending). */
+static inline int rsx_unf_pause_now(int setting, int was_focused, int focused, int in_play)
+{
+    return setting == RSX_UNF_PAUSE && was_focused && !focused && in_play;
+}
+
+/* ---- Maximize (item 4) and F11 (item 5) --------------------------------------------------------------------------- */
+enum { RSX_MAX_BORDERLESS = 1, RSX_MAX_WINDOW = 0 };
+static inline int rsx_dm_ini_maximize(const char* t)   /* 1 borderless, 0 window (2062's maximize), -1 missing */
+{
+    char v[32];
+    size_t n;
+    const char* p = v;
+    if (!rsx_wp_value(t, "maximize", v, sizeof v)) return -1;
+    n = strlen(v);
+    if (rsx_dm_ieq(p, n, "borderless") || rsx_dm_ieq(p, n, "on") || !strcmp(v, "1")) return RSX_MAX_BORDERLESS;
+    if (rsx_dm_ieq(p, n, "window") || rsx_dm_ieq(p, n, "off") || !strcmp(v, "0")) return RSX_MAX_WINDOW;
+    return -1;
+}
+/* F11 toggles like Alt+Enter unless keybinds.ini gives F11 to an action (then the action only). */
+static inline int rsx_f11_toggles(int f11_bound) { return !f11_bound; }
+
+/* ---- Window placement (item 2) ------------------------------------------------------------------------------------ */
+typedef struct {
+    int valid;
+    int x, y;           /* the window's outer top-left, virtual-screen pixels */
+    int w, h;           /* client size */
+    int maximized;
+    char mon[40];       /* monitor device name (MONITORINFOEX szDevice) */
+    int ml, mt, mr, mb; /* that monitor's rectangle when saved */
+} rsx_wp;
+typedef struct {
+    const char* name;
+    int ml, mt, mr, mb; /* monitor rectangle */
+    int wl, wt, wr, wb; /* work area */
+    int primary;
+} rsx_wp_mon;
+
+static inline int rsx_wp_int(const char* t, const char* key, int* out)
+{
+    char v[32];
+    char* e;
+    long x;
+    if (!rsx_dm_ini_value(t, key, v, sizeof v)) return 0;
+    x = strtol(v, &e, 10);
+    if (e == v || x < -100000 || x > 100000) return 0;
+    *out = (int)x;
+    return 1;
+}
+/* 1 with a usable placement (client at least 160x90); 0 = none (first start, or a hand-edited file). */
+static inline int rsx_wp_ini_read(const char* t, rsx_wp* wp)
+{
+    char v[64];
+    memset(wp, 0, sizeof *wp);
+    if (!rsx_wp_int(t, "window_x", &wp->x) || !rsx_wp_int(t, "window_y", &wp->y) || !rsx_wp_int(t, "window_width", &wp->w) ||
+        !rsx_wp_int(t, "window_height", &wp->h) || wp->w < 160 || wp->h < 90)
+        return 0;
+    rsx_wp_int(t, "window_maximized", &wp->maximized);
+    wp->maximized = wp->maximized != 0;
+    if (rsx_wp_value(t, "window_monitor", v, sizeof v)) {
+        size_t n = strlen(v);
+        if (n >= sizeof wp->mon) n = sizeof wp->mon - 1;
+        memcpy(wp->mon, v, n); wp->mon[n] = 0;
+    }
+    if (rsx_wp_value(t, "window_monitor_rect", v, sizeof v) &&
+        sscanf(v, "%d , %d , %d , %d", &wp->ml, &wp->mt, &wp->mr, &wp->mb) != 4)
+        wp->ml = wp->mt = wp->mr = wp->mb = 0;
+    wp->valid = 1;
+    return 1;
+}
+static inline int rsx_wp_ini_write(char* buf, size_t n, const rsx_wp* wp)
+{
+    if (!wp->valid) return snprintf(buf, n, "%s", "");
+    return snprintf(buf, n,
+                    "# window_* = the windowed window as it was last left (client size, outer top-left, monitor and its\n"
+                    "# rectangle, maximized 0 | 1). A missing or changed monitor puts the window on the primary one, centred.\n"
+                    "# KZ3_WINDOW_SIZE and KZ3_DISPLAY win for one run (then this is neither read nor written).\n"
+                    "window_x = %d\nwindow_y = %d\nwindow_width = %d\nwindow_height = %d\nwindow_maximized = %d\n"
+                    "window_monitor = %s\nwindow_monitor_rect = %d,%d,%d,%d\n",
+                    wp->x, wp->y, wp->w, wp->h, wp->maximized ? 1 : 0, wp->mon, wp->ml, wp->mt, wp->mr, wp->mb);
+}
+
+/* Where the saved window comes back: out[0..3] = outer x, y and client w, h, for a frame of fw x fh around the client.
+ * Returns the monitor index used and sets *fallback (1 = the saved monitor is gone or changed: primary, centred).
+ * The client keeps its aspect when it must shrink to fit the work area, and never goes under minw x minh.
+ * -1 = no monitors. */
+static inline int rsx_wp_resolve(const rsx_wp* wp, const rsx_wp_mon* m, int nm, int fw, int fh, int minw, int minh,
+                                 int out[4], int* fallback)
+{
+    int i, k = -1, ww, wh, cw = wp->w, ch = wp->h;
+    if (nm <= 0) return -1;
+    for (i = 0; i < nm && k < 0; i++)
+        if (m[i].name && wp->mon[0] && !strcmp(m[i].name, wp->mon) && m[i].ml == wp->ml && m[i].mt == wp->mt &&
+            m[i].mr == wp->mr && m[i].mb == wp->mb)
+            k = i;
+    *fallback = k < 0;
+    if (k < 0) {
+        for (i = 0; i < nm && k < 0; i++) if (m[i].primary) k = i;
+        if (k < 0) k = 0;
+    }
+    ww = m[k].wr - m[k].wl; wh = m[k].wb - m[k].wt;
+    if (cw + fw > ww || ch + fh > wh) {      /* shrink, keeping the aspect, to the largest that fits */
+        const int mw = ww - fw, mh = wh - fh;
+        if (mw > 0 && mh > 0) {
+            int nw = mw, nh = (int)((long long)mw * ch / cw);
+            if (nh > mh) { nh = mh; nw = (int)((long long)mh * cw / ch); }
+            cw = nw; ch = nh;
+        }
+    }
+    if (cw < minw) cw = minw;
+    if (ch < minh) ch = minh;
+    out[2] = cw; out[3] = ch;
+    if (*fallback) {
+        out[0] = m[k].wl + (ww - (cw + fw)) / 2;
+        out[1] = m[k].wt + (wh - (ch + fh)) / 2;
+    } else {
+        int x = wp->x, y = wp->y;
+        if (x + cw + fw > m[k].wr) x = m[k].wr - (cw + fw);
+        if (y + ch + fh > m[k].wb) y = m[k].wb - (ch + fh);
+        if (x < m[k].wl) x = m[k].wl;
+        if (y < m[k].wt) y = m[k].wt;
+        out[0] = x; out[1] = y;
+    }
+    return k;
+}
+
+#endif /* RSX_WINDOW_PLACE_H */
