+static int rsx_wm_msg(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp, LRESULT* res)
+{
+    if (msg == WM_SYSCOMMAND) {
+        const unsigned sc = (unsigned)(wp & 0xFFF0);
+        if (sc == SC_CLOSE) {
+            if (s_wm_close_ask && s_wm_close_ask(RSX_CLOSE_SRC_USER)) { *res = 0; return 1; }
+            return 0;                                    /* DefWindowProc -> WM_CLOSE -> closes */
+        }
+        if (sc == SC_MAXIMIZE && s_wm_max_bl && s_dm_applied == RSX_DM_WINDOWED) {
+            rsx_wp_capture("maximize", 0);
+            rsx_dm_apply(rsx_dm_set(&s_dm, RSX_DM_BORDERLESS), "Maximize -> borderless");
+            rsx_dm_save_now();
+            *res = 0;
+            return 1;
+        }
+        if (sc == SC_RESTORE && s_dm_applied == RSX_DM_BORDERLESS && !IsIconic(hwnd)) {
+            rsx_dm_apply(rsx_dm_set(&s_dm, RSX_DM_WINDOWED), "Restore -> windowed");
+            rsx_dm_save_now();
+            *res = 0;
+            return 1;
+        }
+        return 0;
+    }
+    if ((msg == WM_KEYDOWN || msg == WM_SYSKEYDOWN) && wp == VK_F11) {
+        static int said;
+        const int bound = pad_kb_vk_bound ? pad_kb_vk_bound(VK_F11) : 0;
+        if (!rsx_f11_toggles(bound)) {
+            if (!said++) { printf("[display] F11 is bound in keybinds.ini: it is that action only, no fullscreen toggle\n"); fflush(stdout); }
+            return 0;
+        }
+        if (!(lp & (1 << 30))) {                         /* not an auto-repeat; the same path as Alt+Enter */
+            rsx_dm_apply(rsx_dm_toggle(&s_dm), "F11");
+            rsx_dm_save_now();
+        }
+        *res = 0;
+        return 1;
+    }
+    if (msg == WM_EXITSIZEMOVE) { rsx_wp_capture("moved/sized", 1); return 0; }
+    if (msg == WM_SIZE) {
+        if (wp == SIZE_MINIMIZED) rsx_wm_focus_note(0, 1, "minimised");
+        else {
+            const int mx = wp == SIZE_MAXIMIZED;
+            if (s_wm_min) rsx_wm_focus_note(GetForegroundWindow() == hwnd, 0, "restored");
+            if (mx != s_wp_was_max && s_dm_applied == RSX_DM_WINDOWED) { s_wp_was_max = mx; rsx_wp_capture(mx ? "maximized" : "unmaximized", 1); }
+        }
+        return 0;
+    }
+    if (msg == WM_ACTIVATEAPP) { rsx_wm_focus_note(wp != 0, IsIconic(hwnd) ? 1 : 0, wp ? "activated" : "deactivated"); return 0; }
+    if (msg == WM_QUERYENDSESSION) { *res = TRUE; return 1; }
+    if (msg == WM_ENDSESSION) {
+        if (wp) {
+            rsx_wp_capture("end of session", 1);
+            printf("[window] end of session: closing\n"); fflush(stdout);
+            s_state.window_closed = 1;
+        }
+        *res = 0;
+        return 1;
+    }
+    return 0;
+}
