+/*
+ * KZ3 patch 2126 (RSX pass 120): window management rules, platform-free (host test: tools/smoke/test_window_place.sh).
+ * ENHANCEMENTs (display/comfort):
+ *   - close asks first: which close requests open the game's own exit dialog and which close at once (rsx_close_decide);
+ *   - the window is remembered: windowed client size, position, monitor and maximized state in display.ini [display]
+ *     (rsx_wp_ini_read / rsx_wp_ini_write) and where it comes back (rsx_wp_resolve: the saved monitor when it is still
+ *     there with the same rectangle, else the primary one, centred; always clamped to the work area);
+ *   - "When unfocused" = keep running | mute | pause (rsx_unf_*), never suspending the guest or its clock;
+ *   - maximize -> borderless (display.ini maximize = borderless | window).
+ * The Win32 side is in rsx_null_backend.c (KZ3's window), the game side (dialog, pause, mute) in port/kz3/main.cpp.
+ */
+#ifndef RSX_WINDOW_PLACE_H
+#define RSX_WINDOW_PLACE_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "rsx_display_mode.h"   /* rsx_dm_ini_value, rsx_dm_ieq, rsx_dm_trim */
