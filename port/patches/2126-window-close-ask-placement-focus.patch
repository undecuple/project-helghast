+/* At creation: the saved placement -> outer x, y, w, h (1 = use them). */
+static int rsx_wp_initial(int* x, int* y, int* ow, int* oh)
+{
+    rsx_wp_mons ms;
+    int out[4], fb = 0, k, fw, fh;
+    const char* ws = getenv("KZ3_WINDOW_SIZE");
+    const char* dm = getenv("KZ3_DISPLAY");
+    s_wp_env = (ws && *ws) || (dm && *dm);
+    if (s_wp_env || !s_wp_cfg.valid) return 0;
+    memset(&ms, 0, sizeof ms);
+    EnumDisplayMonitors(NULL, NULL, rsx_wp_enum, (LPARAM)&ms);
+    rsx_win_frame_size(&fw, &fh);
+    k = rsx_wp_resolve(&s_wp_cfg, ms.m, ms.n, fw, fh, 320, 180, out, &fb);
+    if (k < 0) return 0;
+    *x = out[0]; *y = out[1]; *ow = out[2] + fw; *oh = out[3] + fh;
+    printf("[window] restored from display.ini: client %dx%d at %d,%d on %s%s%s\n", out[2], out[3], out[0], out[1],
+           ms.names[k], fb ? " (saved monitor gone or changed: primary, centred)" : "", s_wp_cfg.maximized ? ", maximized" : "");
+    return 1;
+}
