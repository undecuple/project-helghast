+typedef struct { rsx_wp_mon m[16]; char names[16][40]; int n; } rsx_wp_mons;
+static BOOL CALLBACK rsx_wp_enum(HMONITOR mon, HDC dc, LPRECT r, LPARAM lp)
+{
+    rsx_wp_mons* s = (rsx_wp_mons*)lp;
+    MONITORINFOEXA mi;
+    (void)dc; (void)r;
+    if (s->n >= 16) return FALSE;
+    mi.cbSize = sizeof mi;
+    if (!GetMonitorInfoA(mon, (MONITORINFO*)&mi)) return TRUE;
+    snprintf(s->names[s->n], sizeof s->names[0], "%s", mi.szDevice);
+    s->m[s->n].name = s->names[s->n];
+    s->m[s->n].ml = mi.rcMonitor.left; s->m[s->n].mt = mi.rcMonitor.top; s->m[s->n].mr = mi.rcMonitor.right; s->m[s->n].mb = mi.rcMonitor.bottom;
+    s->m[s->n].wl = mi.rcWork.left; s->m[s->n].wt = mi.rcWork.top; s->m[s->n].wr = mi.rcWork.right; s->m[s->n].wb = mi.rcWork.bottom;
+    s->m[s->n].primary = (mi.dwFlags & MONITORINFOF_PRIMARY) != 0;
+    s->n++;
+    return TRUE;
+}
