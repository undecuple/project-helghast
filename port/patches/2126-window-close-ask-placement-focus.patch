+static SRWLOCK s_wp_lock = SRWLOCK_INIT;
+static int s_wp_env;                          /* KZ3_WINDOW_SIZE or KZ3_DISPLAY: neither restored nor saved */
+static int s_wp_was_max;
+static int s_wm_max_bl = RSX_MAX_BORDERLESS;
+static int (*s_wm_close_ask)(int src);
+static void (*s_wm_focus)(int focused, int minimized);
