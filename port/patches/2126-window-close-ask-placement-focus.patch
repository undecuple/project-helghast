+/* The windowed window as it is now -> s_wp_cur; save = write display.ini. Maximized keeps the last normal rectangle. */
+static void rsx_wp_capture(const char* why, int save)
+{
+    HWND h = s_state.hwnd;
+    rsx_wp w;
+    if (!h || s_dm_applied != RSX_DM_WINDOWED || IsIconic(h)) return;
+    AcquireSRWLockShared(&s_wp_lock);
+    w = s_wp_cur;
+    ReleaseSRWLockShared(&s_wp_lock);
+    if (IsZoomed(h)) w.maximized = 1;
+    else {
+        RECT wr, cr;
+        HMONITOR mon = MonitorFromWindow(h, MONITOR_DEFAULTTONEAREST);
+        MONITORINFOEXA mi;
+        mi.cbSize = sizeof mi;
+        if (!GetWindowRect(h, &wr) || !GetClientRect(h, &cr) || cr.right < 160 || cr.bottom < 90) return;
+        w.x = wr.left; w.y = wr.top; w.w = cr.right; w.h = cr.bottom; w.maximized = 0;
+        if (mon && GetMonitorInfoA(mon, (MONITORINFO*)&mi)) {
+            snprintf(w.mon, sizeof w.mon, "%s", mi.szDevice);
+            w.ml = mi.rcMonitor.left; w.mt = mi.rcMonitor.top; w.mr = mi.rcMonitor.right; w.mb = mi.rcMonitor.bottom;
+        }
+        w.valid = 1;
+    }
+    AcquireSRWLockExclusive(&s_wp_lock);
+    s_wp_cur = w;
+    ReleaseSRWLockExclusive(&s_wp_lock);
+    printf("[window] %s: %dx%d at %d,%d on %s%s%s\n", why, w.w, w.h, w.x, w.y, w.mon[0] ? w.mon : "?",
+           w.maximized ? ", maximized" : "", s_wp_env ? " (KZ3_WINDOW_SIZE/KZ3_DISPLAY: not saved)" : "");
+    fflush(stdout);
+    if (save && !s_wp_env && s_dm_save) s_dm_save(s_dm.mode, s_dm_scaling, s_dm_filter, s_dm_vsync);
+}
