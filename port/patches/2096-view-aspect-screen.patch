+/* patch 2096: KZ3_ASPECT (read once; the default is screen) */
+int rsx_display_get_aspect(void)
+{
+    static int v = -2;
+    if (v == -2) {
+        const int p = rsx_dm_parse_aspect(getenv("KZ3_ASPECT"));
+        v = p >= 0 ? p : RSX_DM_ASPECT_SCREEN;
+        printf("[display] view aspect %s (KZ3_ASPECT%s%s)\n", rsx_dm_aspect_name(v), getenv("KZ3_ASPECT") ? "=" : " unset",
+               getenv("KZ3_ASPECT") ? getenv("KZ3_ASPECT") : "");
+        fflush(stdout);
+    }
+    return v;
+}
