  * into the letterbox rectangle with linear filtering, bb back to PRESENT. Returns 0 (nothing recorded) when the pass
  * cannot run; the caller then copies. */
+/* patch 2096 (KZ3_ASPECT=screen): the camera hook (port/kz3/main.cpp) asks for the view aspect and notes each camera
+ * set up with it; a frame presented within 3 presents of such a note is stretched to the whole client (its image was
+ * drawn for that aspect), any other frame keeps the Image scaling setting. */
+int rsx_display_get_aspect(void);   /* rsx_null_backend.c */
+static volatile LONG g_dm_present_n, g_dm_wide_n = -1000;
+double rsx_display_view_ratio(void)
+{
+    if (rsx_display_get_aspect() != RSX_DM_ASPECT_SCREEN) return 1.0;
+    return rsx_dm_aspect_ratio(g_dm_bb_w, g_dm_bb_h);
+}
+void rsx_display_note_wide(void) { g_dm_wide_n = g_dm_present_n; }
+static int ld_dm_scaling_now(void)
+{
+    return (g_dm_present_n - g_dm_wide_n <= 3 && rsx_display_view_ratio() != 1.0) ? RSX_DM_STRETCH : g_dm_scaling;
+}
