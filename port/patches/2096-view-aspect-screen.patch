KZ3 patch 2096 (RSX pass 91): view aspect (KZ3_ASPECT, ENHANCEMENT, default screen). The camera hook in
port/kz3/main.cpp (GameViewGame::vf22 @0x007E5908 re-registered in the indirect-call map) sets the game's camera up
for the client's aspect; this patch gives it the aspect (rsx_display_view_ratio), stretches frames drawn with that
camera to the whole client (rsx_display_note_wide), and frees the window's aspect (KZ3_WINDOW_SIZE at its own aspect,
free drag/maximize). KZ3_ASPECT=16:9 (off, 0) = patch 2095/2062 behaviour.
diff -ruN a/libs/video/rsx_display_mode.h b/libs/video/rsx_display_mode.h
--- a/libs/video/rsx_display_mode.h	2026-10-21 07:01:17.231990921 -0500
+++ b/libs/video/rsx_display_mode.h	2026-10-21 07:01:44.041007612 -0500
@@ -322,4 +322,34 @@
     return out;
 }
 
+/* KZ3 patch 2096: view aspect (KZ3_ASPECT, ENHANCEMENT, default screen). Screen = the game's camera is set up for the
+ * window's (or the screen's) own aspect (port/kz3/main.cpp hooks GameViewGame::vf22 @0x007E5908: Hor+ above 16:9,
+ * Vert+ below) and every frame drawn with that camera is stretched to the whole client (the guest image stays
+ * 1280x720, its pixels are no longer square), so the scene fills the screen undistorted; other frames (menus,
+ * movies) keep the Image scaling setting. 16:9 (also "off", "0") = the PS3 picture, patch 2095 behaviour. */
+enum { RSX_DM_ASPECT_SCREEN = 0, RSX_DM_ASPECT_16_9 = 1 };
+static inline int rsx_dm_parse_aspect(const char* s)
+{
+    if (!s || !*s) return -1;
+    const size_t n = strlen(s);
+    if (rsx_dm_ieq(s, n, "screen") || rsx_dm_ieq(s, n, "window") || rsx_dm_ieq(s, n, "auto") || !strcmp(s, "1"))
+        return RSX_DM_ASPECT_SCREEN;
+    if (rsx_dm_ieq(s, n, "16:9") || rsx_dm_ieq(s, n, "16x9") || rsx_dm_ieq(s, n, "off") || !strcmp(s, "0"))
+        return RSX_DM_ASPECT_16_9;
+    return -1;
+}
+static inline const char* rsx_dm_aspect_name(int v) { return v == RSX_DM_ASPECT_16_9 ? "16:9" : "screen"; }
+/* The aspect factor the camera hook applies, r = view aspect / (16/9): 1 = unchanged (also for a client within 0.2 %
+ * of 16:9, so a 1280x720 or 1920x1080 window keeps the PS3 numbers bit for bit). */
+static inline double rsx_dm_aspect_ratio(unsigned w, unsigned h)
+{
+    if (!w || !h) return 1.0;
+    const double r = ((double)w / (double)h) / (16.0 / 9.0);
+    return (r > 0.998 && r < 1.002) ? 1.0 : r;
+}
+/* Camera hook scale for one GameViewGame::vf22 result: the frustum width aspect (the store to Camera+0x68) gets r;
+ * every other use divides tan(horizontal FOV / 2) by it to get the vertical FOV and gets min(r, 1): the vertical FOV
+ * stays the PS3's when the view is wider than 16:9 (Hor+), the horizontal FOV stays when it is narrower (Vert+). */
+static inline double rsx_dm_aspect_scale(double r, int frustum_width) { return frustum_width ? r : (r < 1.0 ? r : 1.0); }
+
 #endif /* RSX_DISPLAY_MODE_H */
