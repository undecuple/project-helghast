diff --git a/libs/video/rsx_diag_delay.h b/libs/video/rsx_diag_delay.h
new file mode 100644
index 00000000..4c6863bb
--- /dev/null
+++ b/libs/video/rsx_diag_delay.h
@@ -0,0 +1,99 @@
+/* KZ3 patch 2210 (RSX pass 174): KZ3_DIAG_DELAY=main:N|walk:N, the delay-injection switch (N in ms, default off, diagnostic,
+ * never shipped). Pure C: the caller owns the instance and supplies the clock; a host test builds it with a fake clock.
+ *
+ * A QPC busy-wait of N ms, once per frame: "main" at the guest thread's flip call (gcm_flip_request, the thread that issues the
+ * flip: its host thread id is printed at the first hit), "walk" once per flip on the walker thread (the live-draw flip
+ * callback). Purpose: the conversion slope dFrame/dDelay (U3 of fps-path-60): run N = 0, 1, 2, 4 ms and read the frame time.
+ * A busy-wait (not a sleep) so the thread keeps its core and the delay is the elapsed time, which the line reports as measured.
+ * Both sides may be given, comma separated (main:2,walk:1). Any malformed spec turns the switch off with a line saying why. */
+#ifndef RSX_DIAG_DELAY_H
+#define RSX_DIAG_DELAY_H
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+enum { RSX_DD_MAIN = 0, RSX_DD_WALK = 1, RSX_DD_N = 2 };
+typedef struct {
+    double ms[RSX_DD_N];                   /* requested delay per side; 0 = off */
+    unsigned long long count[RSX_DD_N];    /* injections (relaxed atomics) */
+    unsigned long long ticks[RSX_DD_N];    /* measured elapsed ticks summed */
+    unsigned long long p_count[RSX_DD_N], p_ticks[RSX_DD_N];
+    long long t_last;                      /* ticks of the last report (compare-exchanged, one printer per period) */
+    long long freq;
+    long long (*now)(void);
+    unsigned first_tid[RSX_DD_N];
+    int on;
+    char err[96];
+} rsx_dd;
+
+/* spec -> ms per side; 0 on success (at least one side > 0), -1 malformed (err filled). Unset or empty = -2 (off, no message). */
+static inline int rsx_dd_parse(const char* s, double out[RSX_DD_N], char* err, size_t ecap)
+{
+    out[0] = out[1] = 0.0;
+    if (!s || !*s) return -2;
+    const char* p = s;
+    while (*p) {
+        int side;
+        if (!strncmp(p, "main:", 5)) { side = RSX_DD_MAIN; p += 5; }
+        else if (!strncmp(p, "walk:", 5)) { side = RSX_DD_WALK; p += 5; }
+        else { snprintf(err, ecap, "expected main:N or walk:N at '%.12s'", p); return -1; }
+        char* e = NULL;
+        const double v = strtod(p, &e);
+        if (e == p || v < 0.0 || v > 1000.0) { snprintf(err, ecap, "bad N (0..1000 ms) at '%.12s'", p); return -1; }
+        out[side] = v;
+        p = e;
+        if (*p == ',') p++;
+        else if (*p) { snprintf(err, ecap, "trailing text '%.12s'", p); return -1; }
+    }
+    if (out[0] <= 0.0 && out[1] <= 0.0) { snprintf(err, ecap, "N must be > 0"); return -1; }
+    return 0;
+}
+static inline int rsx_dd_init(rsx_dd* d, const char* spec, long long freq, long long (*now)(void), char* msg, size_t cap)
+{
+    memset(d, 0, sizeof *d);
+    d->freq = freq; d->now = now;
+    const int r = rsx_dd_parse(spec, d->ms, d->err, sizeof d->err);
+    if (r == 0) {
+        d->on = 1;
+        snprintf(msg, cap, "[diag-delay] on (KZ3_DIAG_DELAY=%s, patch 2210): busy-wait main=%.3f ms once per guest flip call, walk=%.3f ms once per walker flip; diagnostic only", spec, d->ms[0], d->ms[1]);
+    } else if (r == -1) {
+        snprintf(msg, cap, "[diag-delay] KZ3_DIAG_DELAY=%s ignored: %s (use main:N or walk:N, N in ms)", spec, d->err);
+    } else if (cap) msg[0] = 0;
+    return d->on;
+}
+/* inject the delay of one side now; returns the measured ticks (0 when the side is off). `tid` is remembered at the first hit. */
+static inline long long rsx_dd_inject(rsx_dd* d, int side, unsigned tid)
+{
+    if (!d->on || side < 0 || side >= RSX_DD_N || d->ms[side] <= 0.0) return 0;
+    const long long t0 = d->now(), want = (long long)(d->ms[side] * (double)d->freq / 1000.0);
+    long long t = t0;
+    while (t - t0 < want) t = d->now();
+    const long long el = t - t0;
+    if (__atomic_fetch_add(&d->count[side], 1ull, __ATOMIC_RELAXED) == 0) d->first_tid[side] = tid;
+    __atomic_fetch_add(&d->ticks[side], (unsigned long long)el, __ATOMIC_RELAXED);
+    return el;
+}
+/* once a second at most: line into b, length returned, 0 when none due (or another thread took the period) */
+static inline size_t rsx_dd_tick(rsx_dd* d, char* b, size_t cap)
+{
+    if (!d->on) return 0;
+    const long long now = d->now();
+    long long last = __atomic_load_n(&d->t_last, __ATOMIC_RELAXED);
+    if (last == 0) { __atomic_compare_exchange_n(&d->t_last, &last, now, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED); return 0; }
+    if (now - last < d->freq) return 0;
+    if (!__atomic_compare_exchange_n(&d->t_last, &last, now, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) return 0;
+    size_t n = 0;
+    n += (size_t)snprintf(b + n, cap - n, "[diag-delay] %.2fs", (double)(now - last) / (double)d->freq);
+    static const char* const nm[RSX_DD_N] = { "main", "walk" };
+    for (int s = 0; s < RSX_DD_N; s++) {
+        if (d->ms[s] <= 0.0 || n >= cap) continue;
+        const unsigned long long c = __atomic_load_n(&d->count[s], __ATOMIC_RELAXED), t = __atomic_load_n(&d->ticks[s], __ATOMIC_RELAXED);
+        const unsigned long long dc = c - d->p_count[s], dt = t - d->p_ticks[s];
+        n += (size_t)snprintf(b + n, cap - n, " | %s: count=%llu mean injected=%.3f ms (asked %.3f, total %llu, tid %u)", nm[s], dc,
+                              dc ? (double)dt * 1000.0 / (double)d->freq / (double)dc : 0.0, d->ms[s], c, d->first_tid[s]);
+        d->p_count[s] = c; d->p_ticks[s] = t;
+    }
+    return n < cap ? n : cap - 1;
+}
+#endif
