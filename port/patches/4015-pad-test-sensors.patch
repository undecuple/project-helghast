KZ3 patch 4015 (diagnostics, network pass 28: the network error on the settings pages; every switch unset = no change).
KZ3_PAD_MOTION=0: the host pad's motion sensors are never turned on (the game reads a DS3 at rest).
KZ3_PAD_TEST_SENSORS=X,Y,Z,G[,J] (test only): fixed SIXAXIS words (+-J counts of noise per read) on port 0 while the game has
SENSOR_ON, and the prompts and motion tips see a DualShock 4 with sensors, so an Xvfb run looks like a held DS4.
KZ3_WATCH32=EA[,EA...] (test only): logs every change of up to 16 guest words, checked on each SENSOR_ON pad read; an entry
*EA+OFF watches the word at OFF from the pointer stored at EA (network pass 44).

--- a/libs/input/cellPad.c
+++ b/libs/input/cellPad.c
@@ -753,7 +753,13 @@
  * opened the pad decides whether it can report motion at all). */
 static void pad_sdl_open_log(int p, PadSdlGamepad* gc, uint32_t id, unsigned long long now)
 {
-    pad_sensor_open(&s_sdl_sensors[p], now, pad_sdl_has_sensor, pad_sdl_enable_sensor, gc);
+    {   /* 4015: KZ3_PAD_MOTION=0 leaves the pad's sensors off (SDL's default): the game then reads a DS3 at rest */
+        static int motion = -1;
+        if (motion < 0) { const char* e = getenv("KZ3_PAD_MOTION"); motion = !(e && !strcmp(e, "0"));
+                          if (!motion) { printf("[pad] KZ3_PAD_MOTION=0: motion sensors left off\n"); fflush(stdout); } }
+        if (motion) pad_sensor_open(&s_sdl_sensors[p], now, pad_sdl_has_sensor, pad_sdl_enable_sensor, gc);
+        else memset(&s_sdl_sensors[p], 0, sizeof s_sdl_sensors[p]);
+    }
     s_port_dev[p] = pad_dev_from_sdl_type(PSDL(SDL_GetGamepadType)(gc));   /* 4011: prompts */
     const char* name = PSDL(SDL_GetGamepadName)(gc);
     printf("[pad] port %d: %s (%s), face %s/%s/%s/%s, sensors %s\n", p,
@@ -1045,8 +1051,17 @@
 }
 
 /* PAD_DEV_* of the device the prompts follow (the last input; before any, the first connected host pad). */
+/* 4015 (test only): KZ3_PAD_TEST_SENSORS set = the prompts and motion tips see a DualShock 4 with sensors on port 0. */
+static int pad_test_ds4(void)
+{
+    static int t = -1;
+    if (t < 0) { const char* e = getenv("KZ3_PAD_TEST_SENSORS"); t = e && *e ? 1 : 0; }
+    return t;
+}
+
 int pad_prompt_device(void)
 {
+    if (pad_test_ds4()) return PAD_DEV_PS4;
     return pad_last_device_current(&s_last_dev, s_host_state, s_port_dev, PAD_MAX_HOST_PORTS, NULL);
 }
 
