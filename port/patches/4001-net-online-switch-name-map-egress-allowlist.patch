diff --git a/libs/network/net_policy.c b/libs/network/net_policy.c
new file mode 100644
index 00000000..067d3401
--- /dev/null
+++ b/libs/network/net_policy.c
@@ -0,0 +1,170 @@
+/*
+ * ps3recomp - network policy (see net_policy.h). KZ3 patch 4001.
+ */
+#include "net_policy.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+
+static int s_online = -1;          /* -1: not read yet */
+static int s_np_signed_in = 0;
+static int s_strict = 0;
+
+static struct { char name[PS3_NET_POLICY_NAME_MAX + 1]; uint8_t ip[4]; } s_map[PS3_NET_POLICY_MAX_NAMES];
+static int s_nmap;
+static char s_deny[PS3_NET_POLICY_MAX_NAMES][PS3_NET_POLICY_NAME_MAX + 1];
+static int s_ndeny;
+static struct { uint8_t ip[4]; uint16_t lo, hi; int protos; } s_allow[PS3_NET_POLICY_MAX_ALLOW];
+static int s_nallow;
+
+/* Refusals already logged: (proto, ip, port). Guarded by a spin flag (connect/sendto run on many threads). */
+#define LOGGED_MAX 64
+static struct { int proto; uint8_t ip[4]; uint16_t port; } s_logged[LOGGED_MAX];
+static unsigned s_nlogged;
+static int s_logged_full_said;
+static volatile char s_log_lock;
+
+static void log_lock(void)   { while (__atomic_test_and_set(&s_log_lock, __ATOMIC_ACQUIRE)) { } }
+static void log_unlock(void) { __atomic_clear(&s_log_lock, __ATOMIC_RELEASE); }
+
+int ps3_net_online(void)
+{
+    int v = __atomic_load_n(&s_online, __ATOMIC_ACQUIRE);
+    if (v < 0) {
+        const char* e = getenv("KZ3_ONLINE");
+        v = (e && *e && strcmp(e, "0") != 0) ? 1 : 0;
+        __atomic_store_n(&s_online, v, __ATOMIC_RELEASE);
+        printf("[net] %s\n", v ? "online (KZ3_ONLINE)" : "offline (KZ3_ONLINE unset): no real sockets");
+    }
+    return v;
+}
+
+void ps3_net_set_online(int on) { __atomic_store_n(&s_online, on ? 1 : 0, __ATOMIC_RELEASE); }
+
+int  ps3_net_np_signed_in(void) { return s_np_signed_in && ps3_net_online(); }
+void ps3_net_set_np_signed_in(int on) { s_np_signed_in = on ? 1 : 0; }
+
+void ps3_net_policy_reset(void)
+{
+    s_strict = 0;
+    s_nmap = s_ndeny = s_nallow = 0;
+    log_lock();
+    s_nlogged = 0;
+    s_logged_full_said = 0;
+    log_unlock();
+}
+
+void ps3_net_policy_set_strict(int on) { s_strict = on ? 1 : 0; }
+int  ps3_net_policy_strict(void) { return s_strict; }
+
+/* A host name as the policy compares it: 1-255 chars of letters, digits, '-', '.', '_'; lowered. */
+static int norm_name(const char* in, char out[PS3_NET_POLICY_NAME_MAX + 1])
+{
+    size_t n = 0;
+    if (!in) return 0;
+    for (; in[n]; n++) {
+        unsigned char c = (unsigned char)in[n];
+        if (n >= PS3_NET_POLICY_NAME_MAX) return 0;
+        if (!(isalnum(c) || c == '-' || c == '.' || c == '_')) return 0;
+        out[n] = (char)tolower(c);
+    }
+    out[n] = 0;
+    while (n > 0 && out[n - 1] == '.') out[--n] = 0;    /* "host." == "host" */
+    return n > 0;
+}
+
+int ps3_net_policy_map_host(const char* name, const uint8_t ip[4])
+{
+    if (s_nmap >= PS3_NET_POLICY_MAX_NAMES || !ip || !norm_name(name, s_map[s_nmap].name)) return -1;
+    memcpy(s_map[s_nmap].ip, ip, 4);
+    s_nmap++;
+    return 0;
+}
+
+int ps3_net_policy_deny_host(const char* suffix)
+{
+    if (s_ndeny >= PS3_NET_POLICY_MAX_NAMES || !norm_name(suffix, s_deny[s_ndeny])) return -1;
+    s_ndeny++;
+    return 0;
+}
+
+int ps3_net_policy_allow(const uint8_t ip[4], uint16_t lo, uint16_t hi, int protos)
+{
+    if (s_nallow >= PS3_NET_POLICY_MAX_ALLOW || !ip || lo > hi || !(protos & 3)) return -1;
+    memcpy(s_allow[s_nallow].ip, ip, 4);
+    s_allow[s_nallow].lo = lo;
+    s_allow[s_nallow].hi = hi;
+    s_allow[s_nallow].protos = protos;
+    s_nallow++;
+    return 0;
+}
+
+static int denied(const char* n)
+{
+    size_t ln = strlen(n);
+    for (int i = 0; i < s_ndeny; i++) {
+        size_t ls = strlen(s_deny[i]);
+        if (ln == ls && !strcmp(n, s_deny[i])) return 1;
+        if (ln > ls && n[ln - ls - 1] == '.' && !strcmp(n + ln - ls, s_deny[i])) return 1;
+    }
+    return 0;
+}
+
+int ps3_net_policy_resolve(const char* name, uint8_t ip[4])
+{
+    char n[PS3_NET_POLICY_NAME_MAX + 1];
+    if (!norm_name(name, n)) return s_strict ? 0 : -1;   /* odd names: the host resolver judges them */
+    if (denied(n)) return 0;
+    for (int i = 0; i < s_nmap; i++)
+        if (!strcmp(n, s_map[i].name)) { memcpy(ip, s_map[i].ip, 4); return 1; }
+    return s_strict ? 0 : -1;
+}
+
+static void log_refusal(int proto, const uint8_t ip[4], uint16_t port)
+{
+    int say = 1;
+    log_lock();
+    for (unsigned i = 0; i < s_nlogged; i++)
+        if (s_logged[i].proto == proto && s_logged[i].port == port && !memcmp(s_logged[i].ip, ip, 4)) { say = 0; break; }
+    if (say) {
+        if (s_nlogged < LOGGED_MAX) {
+            s_logged[s_nlogged].proto = proto;
+            memcpy(s_logged[s_nlogged].ip, ip, 4);
+            s_logged[s_nlogged].port = port;
+            s_nlogged++;
+        } else if (s_logged_full_said) {
+            say = 0;
+        } else {
+            s_logged_full_said = 1;
+        }
+    }
+    unsigned n = s_nlogged;
+    log_unlock();
+    if (say)
+        printf("[net] refused %s %u.%u.%u.%u:%u (not the configured server)%s\n",
+               proto == PS3_NET_PROTO_TCP ? "TCP" : "UDP", ip[0], ip[1], ip[2], ip[3], port,
+               n >= LOGGED_MAX ? "; further refusals not logged" : "");
+}
+
+int ps3_net_policy_check(int proto, const uint8_t ip[4], uint16_t port)
+{
+    if (!s_strict) return 1;
+    if (port != 53) {
+        for (int i = 0; i < s_nallow; i++)
+            if ((s_allow[i].protos & proto) && !memcmp(s_allow[i].ip, ip, 4) &&
+                port >= s_allow[i].lo && port <= s_allow[i].hi)
+                return 1;
+    }
+    log_refusal(proto, ip, port);
+    return 0;
+}
+
+unsigned ps3_net_policy_refusals_logged(void)
+{
+    log_lock();
+    unsigned n = s_nlogged;
+    log_unlock();
+    return n;
+}
diff --git a/libs/network/net_policy.h b/libs/network/net_policy.h
new file mode 100644
index 00000000..4c54e329
--- /dev/null
+++ b/libs/network/net_policy.h
@@ -0,0 +1,71 @@
+/*
+ * ps3recomp - network policy: the online switch, a host-name map and an egress allowlist.
+ *
+ * One place decides whether a title may touch the real network at all, and if so, where it may go:
+ *
+ *   ps3_net_online()       the single online switch, read once from the environment (off by default).
+ *                          Every path that can open a real socket (sys_net, cellHttp, NetCtl's state, psnr)
+ *                          asks it; off means the offline model everywhere.
+ *   strict mode            off until a port turns it on. When on, gethostbyname/cellHttp resolve only names
+ *                          in the map (everything else is HOST_NOT_FOUND, nothing reaches the host resolver),
+ *                          and connect/sendto reach only allowlisted (address, port, protocol) destinations.
+ *                          Port 53 (DNS) is always refused in strict mode, whatever the allowlist says, so a
+ *                          title's own resolver cannot leak names to the internet. Each refused destination
+ *                          is logged once.
+ *   denied names           refused even outside strict mode (telemetry hosts).
+ *
+ * A port fills the map and the allowlist at start-up (single-threaded), before the title runs; afterwards the
+ * tables are only read. KZ3 patch 4001.
+ */
+#ifndef PS3_NET_POLICY_H
+#define PS3_NET_POLICY_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define PS3_NET_PROTO_TCP 1
+#define PS3_NET_PROTO_UDP 2
+
+#define PS3_NET_POLICY_MAX_NAMES 16
+#define PS3_NET_POLICY_MAX_ALLOW 16
+#define PS3_NET_POLICY_NAME_MAX  255   /* longest host name the policy compares (DNS limit) */
+
+/* The online switch. KZ3: the environment variable KZ3_ONLINE (any non-empty value except "0"); the upstream
+ * form of this patch reads PS3_NET_ONLINE. Read once, then cached. */
+int  ps3_net_online(void);
+void ps3_net_set_online(int on);          /* psnr's --psnr, tests: overrides the environment */
+
+/* NP sign-in without psnr: a port that has its own server (KZ3: a Medius server) reports the NP manager
+ * ONLINE through this flag. Never set while offline. */
+int  ps3_net_np_signed_in(void);
+void ps3_net_set_np_signed_in(int on);
+
+void ps3_net_policy_reset(void);          /* tests: empty tables, strict off */
+void ps3_net_policy_set_strict(int on);
+int  ps3_net_policy_strict(void);
+
+/* name -> IPv4 (network order). Case-insensitive, exact. 0 on success, -1 if invalid or the table is full. */
+int  ps3_net_policy_map_host(const char* name, const uint8_t ip[4]);
+/* Refuse `suffix` and every sub-domain of it ("scee.com" covers "a.scee.com"). 0 / -1 as above. */
+int  ps3_net_policy_deny_host(const char* suffix);
+/* Allow ip:[lo,hi] for `protos` (PS3_NET_PROTO_* bits). 0 / -1 as above. */
+int  ps3_net_policy_allow(const uint8_t ip[4], uint16_t lo, uint16_t hi, int protos);
+
+/* Resolve `name` by the policy. 1: mapped, ip filled. 0: refused (denied, or unmapped in strict mode).
+ * -1: no decision (not strict, not denied): the caller may use the host resolver. */
+int  ps3_net_policy_resolve(const char* name, uint8_t ip[4]);
+/* May a socket of `proto` reach ip:port (network-order ip, host-order port)? 1 yes, 0 no.
+ * Outside strict mode always 1. */
+int  ps3_net_policy_check(int proto, const uint8_t ip[4], uint16_t port);
+
+/* Refusals logged so far (tests). */
+unsigned ps3_net_policy_refusals_logged(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3_NET_POLICY_H */
