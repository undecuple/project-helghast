@@ -988,16 +995,37 @@ uint32_t sys_net_bnet_gethostbyname(const char* name)
     const char* host = GUEST_PTR(EA(name), const char*);
     uint32_t h = scratch(&s_hostent_ea, HOSTENT_SCRATCH);
     struct addrinfo hints, *res = NULL;
+    struct sockaddr_in mapped;
+    const struct sockaddr_in* sa;
+    uint8_t mip[4];
     if (!host || !h) return 0;
+    if (strnlen(host, 256) >= 256) {   /* guest string: bounded before anything reads it */
+        if (scratch(&s_h_errno_ea, 4)) vm_write32(s_h_errno_ea, SYS_NET_HOST_NOT_FOUND);
