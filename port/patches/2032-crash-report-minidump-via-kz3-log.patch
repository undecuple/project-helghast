-                if (!ok) DeleteFileA(dmp);
-                fprintf(stderr, "[CRASH] minidump %s\n", ok ? "written" : "NOT written");
-            }
-        }
+        fprintf(stderr, "[CRASH] crash file %s\n", crash && *crash ? crash : "(not written)");
+        fflush(stderr);
+        /* KZ3 patch 2032: the minidump through kz3_log_write_minidump (helper thread, dbghelp loaded at init, the
