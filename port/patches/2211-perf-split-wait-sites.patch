diff --git a/libs/video/rsx_wait_split.h b/libs/video/rsx_wait_split.h
new file mode 100644
index 0000000..063e6f1
--- /dev/null
+++ b/libs/video/rsx_wait_split.h
@@ -0,0 +1,49 @@
+/* KZ3 patch 2211 (RSX pass 175): the walker's fence waits by call site, and the [perf-split-w] line. Pure C (time is passed in).
+ * The [perf-split] buckets charge every fence wait to X_WAITO (`wait_other`, inside `other`) or RBWAIT; this says WHICH wait it
+ * was, and checks that the printed buckets add up to the walk. Counted with RSX_PERF=1 (a counter, nothing changes otherwise).
+ * Findings of the round (the RE notes "Pass 175"):
+ *  - wb_sync (the write-back sync time in [perf-walk]) CONTAINS the deferred-store drain's fence wait (WBD_DRAIN) and so does
+ *    gpuwait (all fence waits) and wait_other: one wait, four counters. The line prints them side by side.
+ *  - gpu= is the RSX_PERF_GPU=1 poller's wall time per submitted list (submit to the poll that saw the fence), not GPU execution. */
+#ifndef RSX_WAIT_SPLIT_H
+#define RSX_WAIT_SPLIT_H
+#include "rsx_o0.h"
+enum {
+    RSX_WS_WBD_DRAIN = 0,   /* ld_wbd_wait: a deferred write-back store waits for its list (LD_WB_DEFER drains, any reason) */
+    RSX_WS_PRESENT_SLOT,    /* ld_flush present path: the slot N-1 fence before the walker records frame N+1 */
+    RSX_WS_RING,            /* descriptor / pixel-constant ring wrap (ld_rm_*, LD_RING_FENCE_WAIT) */
+    RSX_WS_IDLE,            /* ld_wait_idle: CPU writes outside the rings */
+    RSX_WS_RESIZE,          /* display resize: every list that used a back buffer */
+    RSX_WS_VERIFY,          /* LD_WB_DEFER_VERIFY readback at the original point */
+    RSX_WS_FLUSH_RB,        /* ld_flush LD_FLUSH_READBACK (bucket RBWAIT) */
+    RSX_WS_FLUSH_OTHER,     /* ld_flush, any other reason (bucket X_WAITO) */
+    RSX_WS_N
+};
+static const char* const rsx_ws_name[RSX_WS_N] = { "wbdrain", "pslot", "ring", "idle", "resize", "verify", "flush_rb", "flush_other" };
+
+/* ms/flip per site -> the line. b[] = the window's split buckets in ms/flip (RSX_SB_*), walk = their ms/flip total.
+ * waits = all sites; gap = waits - (wait_other + rbwait): a wait outside the walker pass, or a timer that does not cover one.
+ * sum = named buckets (decode..park) + every bucket the main line folds into `other`; diff = walk - sum (0 by construction,
+ * so a non-zero diff means the buckets were not read from one window). unwait = `other` minus wait_other: the unnamed time
+ * that is not a fence wait. */
+static inline int rsx_ws_fmt(char* out, size_t n, double t, long long flips, const double* ws_ms, const double* ws_cnt,
+                             const double* b, double walk, double gpuwait, double wb_sync, double gpu, double gpu_lists)
+{
+    double waits = 0, rest = 0;
+    for (int i = 0; i < RSX_WS_N; i++) waits += ws_ms[i];
+    rest = b[RSX_SB_OTHER];
+    for (int i = RSX_SB_NAMED; i < RSX_SB_N; i++) rest += b[i];
+    const double named = rsx_split_named_sum(b), sum = named + rest;
+    const double wait_other = b[RSX_SB_X_WAITO], rbwait = b[RSX_SB_RBWAIT];
+    int o = snprintf(out, n, "[perf-split-w] t=%.0f flips=%lld", t, flips);
+    for (int i = 0; i < RSX_WS_N && o > 0 && (size_t)o < n; i++)
+        o += snprintf(out + o, n - (size_t)o, " %s=%.2f/%.2f", rsx_ws_name[i], ws_ms[i], ws_cnt[i]);   /* ms per flip / waits per flip */
+    if (o > 0 && (size_t)o < n)
+        o += snprintf(out + o, n - (size_t)o,
+            " waits=%.2f | wait_other=%.2f rbwait=%.2f gap=%.2f unwait=%.2f | gpuwait=%.2f wb_sync=%.2f"
+            " | named=%.2f rest=%.2f sum=%.2f walk=%.2f diff=%.2f | gpu=%.2f lists=%.2f",
+            waits, wait_other, rbwait, waits - wait_other - rbwait, rest - wait_other, gpuwait, wb_sync,
+            named, rest, sum, walk, walk - sum, gpu, gpu_lists);
+    return o;
+}
+#endif
