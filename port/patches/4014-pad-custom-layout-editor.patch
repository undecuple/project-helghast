+/* KZ3 patch 4014: the Custom layout page's capture of the next pad button (pad_remap_ui.h). Runs on the raw host
+ * reports, before the remap. While a capture runs, and until every pad button and key is up afterwards, the game
+ * gets neither pad nor keys (it would act on the very press that is meant for the page). KZ3_PM_TEST_BTN=<ps3 button
+ * name> answers a waiting capture after 0.7 s (Xvfb runs have no pad). */
+static void pad_map_edit_poll(void)
+{
+#ifdef _WIN32
+    static int tb = -2;
+    unsigned mask = 0;
+    int p, esc = 0, del = 0, changed;
+    unsigned long long now = GetTickCount64();
+    AcquireSRWLockExclusive(&s_kb_lock);
+    if (!s_kb_ready || !pmu_busy(&s_kb_ui.pm)) { ReleaseSRWLockExclusive(&s_kb_lock); return; }
+    if (tb == -2) {
+        const char* e = getenv("KZ3_PM_TEST_BTN");
+        tb = e && *e ? prm_button_by_name(e, strlen(e)) : -1;
+        if (e && *e) { printf("[pad] KZ3_PM_TEST_BTN=%s -> %s\n", e, tb >= 0 ? "used for the page's captures" : "unknown button"); fflush(stdout); }
+    }
+    for (p = 0; p < PAD_MAX_HOST_PORTS; p++) if (s_host_state[p].connected) mask |= s_host_state[p].buttons;
+    if (pad_host_window_focused()) {
+        esc = (GetAsyncKeyState(0x1B) & 0x8000) != 0;
+        del = (GetAsyncKeyState(0x2E) & 0x8000) != 0;
+    }
+    if (tb >= 0 && s_kb_ui.pm.phase == PMU_WAIT && now - s_kb_ui.pm.t_wait >= 700) mask = 1u << tb;
+    changed = pmu_step(&s_kb_ui.pm, &s_kb.padmap, s_kb.padc, mask, esc, del, now);
+    if (changed) pad_kb_save();
+    if (pmu_busy(&s_kb_ui.pm)) {
+        for (p = 0; p < PAD_MAX_HOST_PORTS; p++) {
+            PadHostState* hs = &s_host_state[p];
+            hs->buttons = 0; hs->press_up = hs->press_right = hs->press_down = hs->press_left = 0;
+            hs->trigger_l2 = hs->trigger_r2 = 0; hs->press_l1 = hs->press_r1 = 0;
+            hs->press_triangle = hs->press_circle = hs->press_cross = hs->press_square = 0;
+            hs->analog_lx = hs->analog_ly = hs->analog_rx = hs->analog_ry = 128;
+        }
+        s_kb_state.buttons = 0; s_kb_state.dirs = 0;
+    }
+    ReleaseSRWLockExclusive(&s_kb_lock);
+#endif
+}
