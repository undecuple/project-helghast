     ppu_resv_break_line(ea);   /* upstream #381: line-granule PPU reservations */
     spu_coh_wake_watches(line);   /* upstream v0.18.0 */
+    const int pf = spu_coh_prefetch_on();
     SPU_COH_FOR_EACH(ch, i) {
+        if (pf) spu_coh_prefetch_ahead(ch, i);
         spu_context* c = __atomic_load_n(&ch->slot[i], __ATOMIC_ACQUIRE);
         if (!c || (const void*)c == self) continue;
         if (spu_resv_kill(c, line)) {           /* patch 1056: CAS under the line's stripe */
