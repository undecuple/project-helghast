+/* patch 2109: the file with the fov key too */
+static inline int rsx_dm_ini_write_ext2(char* buf, size_t n, int mode, int scaling, int filter, int vsync, int motion_blur,
+                                        int fps, int fov)
+{
+    char f[16];
+    int o = rsx_dm_ini_write_ext(buf, n, mode, scaling, filter, vsync, motion_blur, fps);
+    if (o < 0 || (size_t)o >= n) return o;
+    const int k = snprintf(buf + o, n - (size_t)o,
+                           "# fov = default | 70..110: first-person horizontal field of view in degrees at 16:9 (campaign only; off in multiplayer).\n"
+                           "fov = %s\n", rsx_dm_fov_name(fov, f, sizeof f));
+    return k < 0 ? k : o + k;
+}
