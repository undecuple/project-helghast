+/* KZ3 patch 2109 (RSX pass 103): field of view (ENHANCEMENT, opt-in; port/kz3/main.cpp applies it in the camera
+ * writer). 0 = default (the game's own); else the horizontal FOV in degrees at 16:9 for the first-person view, 70-110 in
+ * steps of 5 (the row's values; a hand-edited file may hold any whole number in that range). */
+#define RSX_DM_FOV_MIN 70
+#define RSX_DM_FOV_MAX 110
+static inline int rsx_dm_parse_fov(const char* s)   /* 0 default, 70..110, -1 unreadable */
+{
+    size_t n;
+    if (!rsx_dm_trim(&s, &n)) return -1;
+    if (rsx_dm_ieq(s, n, "default") || rsx_dm_ieq(s, n, "off")) return 0;
+    int v = 0;
+    for (size_t i = 0; i < n; i++) {
+        if (s[i] < '0' || s[i] > '9' || i > 3) return -1;
+        v = v * 10 + (s[i] - '0');
+    }
+    return v >= RSX_DM_FOV_MIN && v <= RSX_DM_FOV_MAX ? v : -1;
+}
+static inline const char* rsx_dm_fov_name(int v, char* buf, size_t n)
+{
+    if (v < RSX_DM_FOV_MIN || v > RSX_DM_FOV_MAX) return "default";
+    snprintf(buf, n, "%d", v);
+    return buf;
+}
+static inline int rsx_dm_ini_fov(const char* t)   /* 0 default, 70..110, -1 missing or unreadable */
+{
+    char v[32];
+    return rsx_dm_ini_value(t, "fov", v, sizeof v) ? rsx_dm_parse_fov(v) : -1;
+}
