diff --git a/libs/video/rsx_tex_writer.h b/libs/video/rsx_tex_writer.h
new file mode 100644
index 0000000..aaf4c9e
--- /dev/null
+++ b/libs/video/rsx_tex_writer.h
@@ -0,0 +1,23 @@
+/* KZ3 patch 2083: the LD_TEX_WRITER diagnostic's per-page write stamp (patch 2081 kept the source tag and the frame in
+ * two arrays written by separate stores from any thread, and judged "tracked write lost" by newest frame >
+ * last-hash frame, so a tracked write in the hash's own frame read as an untracked writer).
+ * One u64 per 64 KB page, written with one aligned store: frame (24 bits) << 40 | mark sequence (32) << 8 | source
+ * tag (8). The sequence is a global counter taken at every mark; an entry records the counter just before its hash
+ * reads the guest bytes, so a mark with a later sequence came after the hash began (its bytes may be missing from
+ * that hash: a tracked write the bitmap lost), and an earlier one was already in the hash.
+ * Host test: tools/smoke/test_tex_writer.sh. */
+#pragma once
+#include <stdint.h>
+
+static inline uint64_t ld_ws_pack(uint32_t frame, uint32_t seq, uint32_t src)
+{
+    return ((uint64_t)(frame & 0xFFFFFFu) << 40) | ((uint64_t)seq << 8) | (src & 0xFFu);
+}
+static inline uint32_t ld_ws_frame(uint64_t v) { return (uint32_t)(v >> 40); }
+static inline uint32_t ld_ws_seq(uint64_t v) { return (uint32_t)(v >> 8); }
+static inline uint32_t ld_ws_src(uint64_t v) { return (uint32_t)(v & 0xFFu); }
+/* Was the mark v made after the hash that recorded hash_seq? (wrap-safe; v == 0: never marked) */
+static inline int ld_ws_after(uint64_t v, uint32_t hash_seq)
+{
+    return v != 0 && (int32_t)(ld_ws_seq(v) - hash_seq) > 0;
+}
