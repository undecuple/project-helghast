--- a/runtime/spu/spu_context.h
+++ b/runtime/spu/spu_context.h
@@ -620,6 +620,19 @@ static SPU_NOINLINE_COLD void spu_ls_read_probe(const spu_context* ctx, uint32_t
     }
 }
 
+/* KZ3 patch 1035: the hot LS accessors and SPU helpers are forced inline. Plain `static inline` was not
+ * enough: in the large lifted functions GCC's growth limits left out-of-line copies (SPU pass 21 profile:
+ * spu_ls_read128 1.2 %, spu_shufb 5.3 % of the level's SPURS thread samples). Since v0.18.0 the LS
+ * accessors' diagnostics sit behind one gate per direction upstream (edf994c0), which covers 1035's
+ * old WWS-probe range test. */
+#if defined(__GNUC__) || defined(__clang__)
+#  define SPU_HOT static inline __attribute__((always_inline))
+#elif defined(_MSC_VER)
+#  define SPU_HOT static __forceinline
+#else
+#  define SPU_HOT static inline
+#endif
+
 /* The read diagnostics, then g_spu_ls_rdiag recomputed: it drops to 0 once
  * none is armed (the first call also settles g_spu_ls_watch_n). */
 static SPU_NOINLINE_COLD void spu_ls_read_diag(const spu_context* ctx, uint32_t lsa)
@@ -631,7 +644,7 @@ static SPU_NOINLINE_COLD void spu_ls_read_diag(const spu_context* ctx, uint32_t
     g_spu_ls_rdiag = g_spu_ls_probe || spu_ls_wws_probe_on() || g_spu_ls_watch_n != 0;
 }
 
