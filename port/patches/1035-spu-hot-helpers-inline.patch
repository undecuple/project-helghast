+/* KZ3 patch 1035: fused multiply-add without the libm call. Without -mfma, fmaf is MinGW's software
+ * routine (with frexp/ldexp inside; ~3 % of the level's SPURS samples in SPU pass 21). The product of two
+ * floats is exact in double, so s = a*b + c has one double rounding; rounding s to float then equals the
+ * correctly rounded fused result unless s sits exactly on a float rounding midpoint (low 29 bits
+ * 0x10000000) or outside the normal float range (zero, subnormal, overflow, inf, NaN): those rare cases
+ * still call fmaf, so the result is bit-identical to the old fmaf path.
+ * ASSUMPTION: the host rounding mode is round-to-nearest without DAZ (nothing in the runtime changes MXCSR). */
+SPU_HOT float spu__fmaf(float a, float b, float c) {
+#if defined(__FMA__)
+    return __builtin_fmaf(a, b, c);
+#else
+    const double s = (double)a * (double)b + (double)c;
+    uint64_t u; memcpy(&u, &s, sizeof u);
+    const uint32_t e = (uint32_t)(u >> 52) & 0x7FFu;
+    if (__builtin_expect((u & 0x1FFFFFFFull) != 0x10000000ull && e - (1023u - 126u) < 254u, 1))
+        return (float)s;
+    return fmaf(a, b, c);
+#endif
+}
+SPU_HOT u128 spu_fma(u128 a, u128 b, u128 c)  { u128 r; for(int i=0;i<4;i++) r._f32[i]=spu__fmaf(a._f32[i], b._f32[i], c._f32[i]); return r; }
+SPU_HOT u128 spu_fms(u128 a, u128 b, u128 c)  { u128 r; for(int i=0;i<4;i++) r._f32[i]=spu__fmaf(a._f32[i], b._f32[i], -c._f32[i]); return r; }
+SPU_HOT u128 spu_fnms(u128 a, u128 b, u128 c) { u128 r; for(int i=0;i<4;i++) r._f32[i]=spu__fmaf(a._f32[i], -b._f32[i], c._f32[i]); return r; }
 static inline u128 spu_fceq(u128 a, u128 b) { u128 r; for(int i=0;i<4;i++) r._u32[i]=(a._f32[i]==b._f32[i])?0xFFFFFFFFu:0; return r; }
 static inline u128 spu_fcgt(u128 a, u128 b) { u128 r; for(int i=0;i<4;i++) r._u32[i]=(a._f32[i]>b._f32[i])?0xFFFFFFFFu:0; return r; }
 
