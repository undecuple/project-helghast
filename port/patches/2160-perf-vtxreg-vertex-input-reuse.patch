+/* KZ3 patch 2160 (RSX pass 148): RSX_PERF_VTXREG=1, inside the RSX_PERF_PROF=A,B window (RSX_PERF=1): do the vertex
+ * fetch/convert inputs repeat between consecutive fetched draws? Counters only (a cached flag test per draw when off);
+ * the classes and what they can and cannot know are in rsx_vtx_reg.h. The key is built like 2047's (ld_vc_key) but
+ * without its eligibility counters; source spans like ld_vc_spans (index range + each used attribute's element range). */
+static rsx_vr_prev g_ld_vrp; static rsx_vr_stat g_ld_vrs;
+static int ld_vr_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_PERF_VTXREG"); on = (e && *e && *e != '0') ? 1 : 0;
+                  if (on) fprintf(stderr, "[perf-vtxreg] vertex input reuse counters on (RSX_PERF_VTXREG=1, patch 2160)\n"); }
+    return on;
+}
+static const u8* ld_vr_ptr_cb(void* ctx, const rsx_vr_span* sp) { (void)ctx; return (const u8*)guest_ptr(sp->loc, sp->off, sp->len); }
+static int ld_vr_written_cb(void* ctx, const rsx_vr_span* sp, u32 since) { (void)ctx; return ld_vc_span_written((const ld_vc_span*)sp, since); }
+static void ld_vr_draw(u32 prim, const rsx_vertex_layout_plan* layout, int served)
+{
+    if (!ld_vr_on() || !rsx_perf_walk_on()) return;
+    g_ld_vrs.draws++;
+    if (served) { g_ld_vrs.hits++; g_ld_vrs.hit_verts += dc.n_verts; return; }
+    if (!dc.fetch_ok || !ld_vertex_compact_payload()) { g_ld_vrs.skipped++; return; }
+    static u32 key[RSX_VR_KEY_MAX];
+    if (2u * (dc.n_arr + dc.n_idx) + 16u * 10u + 32u > RSX_VR_KEY_MAX) { g_ld_vrs.skipped++; return; }
+    u32 n = 0;
+    key[n++] = prim; key[n++] = layout->mask; key[n++] = layout->stride; key[n++] = layout->count;
+    key[n++] = rsx_dsp_vertex_data_base_offset(&g.rsx); key[n++] = rsx_dsp_vertex_data_base_index(&g.rsx);
+    key[n++] = rsx_dsp_reg(&g.rsx, 0x1FC0);
+    for (u32 slot = 0; slot < layout->count; slot++) {
+        const u32 attr = layout->attrs[slot];
+        rsx_dsp_vertex_attr d; rsx_dsp_get_vertex_attr(&g.rsx, attr, &d);
+        key[n++] = attr; key[n++] = d.type; key[n++] = d.size; key[n++] = d.stride; key[n++] = d.frequency;
+        key[n++] = d.offset; key[n++] = d.location;
+        if (!d.type || !d.size) { float dv[4]; rsx_dsp_vertex_default(&g.rsx, attr, dv); memcpy(key + n, dv, 16); n += 4; }
+    }
+    const u32 attr_n = n;
+    key[n++] = dc.n_arr;
+    for (u32 i = 0; i < dc.n_arr; i++) { key[n++] = dc.arr[i].first; key[n++] = dc.arr[i].count; }
+    key[n++] = dc.n_idx;
+    rsx_vr_span sp[RSX_VR_SPANS]; u32 ns = 0; int ok = !(dc.inl || dc.inl_bytes);
+    if (dc.n_idx) {
+        rsx_dsp_index_array ia; rsx_dsp_get_index_array(&g.rsx, &ia);
+        key[n++] = ia.location; key[n++] = ia.offset; key[n++] = (u32)ia.is_u32;
+        for (u32 i = 0; i < dc.n_idx; i++) { key[n++] = dc.idx[i].first; key[n++] = dc.idx[i].count; }
+        const u32 esz = ia.is_u32 ? 4u : 2u;
+        u64 lo = ~0ull, hi = 0;
+        for (u32 i = 0; i < dc.n_idx; i++) {
+            if (!dc.idx[i].count) continue;
+            const u64 a = (u64)ia.offset + (u64)dc.idx[i].first * esz, b = a + (u64)dc.idx[i].count * esz;
+            if (a < lo) lo = a;
+            if (b > hi) hi = b;
+        }
+        if (hi > lo) {
+            if (hi > 0x100000000ull || ia.location > 1u) ok = 0;
+            else { sp[ns].loc = ia.location; sp[ns].off = (u32)lo; sp[ns].len = (u32)(hi - lo); ns++; }
+        }
+    }
+    for (u32 slot = 0; slot < dc.layout.count && ok; slot++) {
+        const rsx_vertex_fetch_attr* f = &dc.fetch_plan.attr[dc.layout.attrs[slot]];
+        if (!f->desc.type || !f->desc.size) continue;
+        if (!f->stable_base || f->desc.location > 1u || ns >= RSX_VR_SPANS) { ok = 0; break; }
+        const u64 a = (u64)dc.fetch_plan.base_offset + f->desc.offset + (u64)f->stable_first * f->stride;
+        const u64 b = (u64)dc.fetch_plan.base_offset + f->desc.offset + (u64)f->stable_last * f->stride + f->elem_size;
+        if (b > 0x100000000ull || b <= a) { ok = 0; break; }
+        sp[ns].loc = f->desc.location; sp[ns].off = (u32)a; sp[ns].len = (u32)(b - a); ns++;
+    }
+    rsx_vr_fetched(&g_ld_vrp, &g_ld_vrs, key, n, attr_n, sp, ok ? ns : 0u, dc.n_verts, g_ld_frames, ld_vr_ptr_cb,
+                   ld_vr_written_cb, NULL);
+}
+static void ld_vr_report(void)
+{
+    if (!ld_vr_on() || !g_ld_vrs.draws) return;
+    static const char* const nm[RSX_VR_N] = { "new-attr", "range", "same-clean", "same-page-fp", "chg-tracked", "chg-untracked", "unknown" };
+    const rsx_vr_stat* s = &g_ld_vrs;
+    const double nd = (double)s->draws, nf = s->fetched ? (double)s->fetched : 1.0, nv = s->verts ? (double)s->verts : 1.0;
+    fprintf(stderr, "[perf-vtxreg] draws %llu: cache-served %.1f%% (%llu verts), fetched %.1f%% (%llu verts), skipped %llu |"
+                    " fetched draws (%% of draws | %% of fetched verts):", (unsigned long long)s->draws, 100.0 * (double)s->hits / nd,
+            (unsigned long long)s->hit_verts, 100.0 * (double)s->fetched / nd, (unsigned long long)s->verts, (unsigned long long)s->skipped);
+    for (int c = 0; c < RSX_VR_N; c++)
+        fprintf(stderr, " %s %.1f|%.1f", nm[c], 100.0 * (double)s->cls[c] / nd, 100.0 * (double)s->cls_verts[c] / nv);
+    fprintf(stderr, " | compared %llu KB\n", (unsigned long long)(s->cmp_bytes >> 10)); (void)nf;
+    memset(&g_ld_vrs, 0, sizeof g_ld_vrs);   /* the previous-draw memo survives (it is the same stream) */
+}
