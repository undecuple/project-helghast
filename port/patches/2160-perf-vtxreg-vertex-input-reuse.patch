diff -ruN a/libs/video/rsx_vtx_reg.h b/libs/video/rsx_vtx_reg.h
--- a/libs/video/rsx_vtx_reg.h	1969-12-31 18:00:00.000000000 -0600
+++ b/libs/video/rsx_vtx_reg.h	2026-11-10 22:40:34.898436991 -0600
@@ -0,0 +1,99 @@
+/* KZ3 patch 2160 (RSX pass 148): RSX_PERF_VTXREG=1 counters, the pure core. Do vertex fetch/convert inputs repeat between
+ * consecutive fetched draws, and could the source bytes have changed? Counters only: no decision reads it.
+ *
+ * Per fetched draw (a draw the device vertex cache did not serve) the caller passes the fetch key (attribute words first,
+ * then the batch/index words), the source spans (index range + each used attribute's element range from the fetch plan)
+ * and the vertex count. The previous fetched draw's key, spans and a COPY of its source bytes are kept, so "unchanged"
+ * is a real byte compare, not the page notes: tracked writers (64 KB page bitmap + stamps, the same test the 2047/2092
+ * cache uses) are asked separately, which shows what the page notes alone could and could not tell:
+ *   NEW_ATTR      attribute words differ (format/stride/offset/location/base/layout), or no previous draw
+ *   RANGE         attribute words equal, batches or source spans differ (other mesh range, other index bytes)
+ *   SAME_CLEAN    key and spans equal, bytes identical, no tracked write       -> a converted-vertex cache could replay it
+ *   SAME_PAGE_FP  key and spans equal, bytes identical, a tracked write noted on a page (64 KB granularity, live bitmap
+ *                 covers the whole frame, so a write before the previous draw also counts: an upper bound)
+ *   CHG_TRACKED   bytes differ and a tracked writer noted the pages
+ *   CHG_UNTRACKED bytes differ and nothing noted it (PPU stores recompiled code makes: only a compare can see them)
+ *   UNKNOWN       not classifiable (inline vertices, no span, source too big for the copy, no guest pointer, no copy yet)
+ * Not knowable here: a write BETWEEN two draws of the same frame (the bitmap has frame granularity); the byte compare
+ * covers it, but only for draws that actually fetched (cache-served draws have no fetch plan and are counted apart). */
+#ifndef RSX_VTX_REG_H
+#define RSX_VTX_REG_H
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define RSX_VR_KEY_MAX 1200u
+#define RSX_VR_SPANS 17u
+#define RSX_VR_COPY_MAX (8u << 20)
+
+typedef struct { uint32_t loc, off, len; } rsx_vr_span;   /* same layout as rsx_vd_span */
+enum { RSX_VR_NEW_ATTR, RSX_VR_RANGE, RSX_VR_SAME_CLEAN, RSX_VR_SAME_PAGE_FP, RSX_VR_CHG_TRACKED, RSX_VR_CHG_UNTRACKED,
+       RSX_VR_UNKNOWN, RSX_VR_N };
+typedef const uint8_t* (*rsx_vr_ptr_fn)(void* ctx, const rsx_vr_span* sp);
+typedef int (*rsx_vr_written_fn)(void* ctx, const rsx_vr_span* sp, uint32_t since_frame);
+
+typedef struct {
+    int have, have_copy;
+    uint32_t key[RSX_VR_KEY_MAX]; uint32_t key_n, attr_n;
+    rsx_vr_span spans[RSX_VR_SPANS]; uint32_t n_spans;
+    uint32_t frame;
+    uint8_t* copy; uint32_t copy_cap, copy_bytes;
+} rsx_vr_prev;
+typedef struct {
+    uint64_t draws, hits, fetched, verts, hit_verts, skipped;
+    uint64_t cls[RSX_VR_N], cls_verts[RSX_VR_N];
+    uint64_t cmp_bytes;
+} rsx_vr_stat;
+
+/* spans: n_spans 0 = unclassifiable. Returns the class. */
+static inline int rsx_vr_fetched(rsx_vr_prev* p, rsx_vr_stat* st, const uint32_t* key, uint32_t key_n, uint32_t attr_n,
+                                 const rsx_vr_span* spans, uint32_t n_spans, uint32_t verts, uint32_t frame,
+                                 rsx_vr_ptr_fn ptr, rsx_vr_written_fn written, void* ctx)
+{
+    int cls;
+    uint32_t total = 0;
+    for (uint32_t i = 0; i < n_spans; i++) total += spans[i].len;
+    const int classifiable = n_spans > 0 && n_spans <= RSX_VR_SPANS && total <= RSX_VR_COPY_MAX && key_n <= RSX_VR_KEY_MAX;
+    if (!p->have || p->attr_n != attr_n || memcmp(p->key, key, (size_t)attr_n * 4u)) cls = RSX_VR_NEW_ATTR;
+    else if (p->key_n != key_n || memcmp(p->key, key, (size_t)key_n * 4u) || p->n_spans != n_spans ||
+             (n_spans && memcmp(p->spans, spans, (size_t)n_spans * sizeof spans[0]))) cls = RSX_VR_RANGE;
+    else if (!classifiable || !p->have_copy) cls = RSX_VR_UNKNOWN;
+    else {
+        int same = 1, ok = 1;
+        uint32_t o = 0;
+        for (uint32_t i = 0; i < n_spans && ok; i++) {
+            const uint8_t* b = ptr(ctx, &spans[i]);
+            if (!b) { ok = 0; break; }
+            if (memcmp(b, p->copy + o, spans[i].len)) same = 0;
+            o += spans[i].len; st->cmp_bytes += spans[i].len;
+        }
+        int wr = 0;
+        for (uint32_t i = 0; i < n_spans && ok; i++) if (written(ctx, &spans[i], p->frame)) wr = 1;
+        cls = !ok ? RSX_VR_UNKNOWN : same ? (wr ? RSX_VR_SAME_PAGE_FP : RSX_VR_SAME_CLEAN)
+                                          : (wr ? RSX_VR_CHG_TRACKED : RSX_VR_CHG_UNTRACKED);
+    }
+    st->fetched++; st->verts += verts; st->cls[cls]++; st->cls_verts[cls] += verts;
+    /* keep this draw as the previous one */
+    if (key_n <= RSX_VR_KEY_MAX) { memcpy(p->key, key, (size_t)key_n * 4u); p->key_n = key_n; p->attr_n = attr_n; p->have = 1; }
+    else p->have = 0;
+    p->n_spans = n_spans <= RSX_VR_SPANS ? n_spans : 0;
+    if (p->n_spans) memcpy(p->spans, spans, (size_t)n_spans * sizeof spans[0]);
+    p->frame = frame; p->have_copy = 0;
+    if (classifiable && p->have) {
+        if (p->copy_cap < total) {
+            uint8_t* n = (uint8_t*)realloc(p->copy, total);
+            if (n) { p->copy = n; p->copy_cap = total; }
+        }
+        if (p->copy_cap >= total) {
+            uint32_t o = 0; int ok = 1;
+            for (uint32_t i = 0; i < n_spans; i++) {
+                const uint8_t* b = ptr(ctx, &spans[i]);
+                if (!b) { ok = 0; break; }
+                memcpy(p->copy + o, b, spans[i].len); o += spans[i].len;
+            }
+            p->have_copy = ok; p->copy_bytes = o;
+        }
+    }
+    return cls;
+}
+#endif
