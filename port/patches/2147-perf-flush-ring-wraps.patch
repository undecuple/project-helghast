+/* The [perf-flush] line (patch 2045): flushes by reason (n/ms) and the texture upload half; patch 2147 appends the
+ * ring wraps of the period: every wrap of a transient ring submits and waits for the whole queue, so the counts
+ * are the flush counts of vring/cbring/pscbring/upring and descring split by ring (srv table ring, sampler ring).
+ * d = the period's counters, tk = ticks to ms. Never writes past n. */
+static void gcm_perf_flush_line(char* fl, size_t n, double tnow, const long long* d, double tk)
+{
+    static const char* const rn[12] = { "present", "ref", "vring", "cbring", "retire", "movie",
+                                        "mpresent", "readback", "pscbring", "descring", "shutdown",
+                                        "upring" };   /* patch 2142 */
+    int fo = snprintf(fl, n, "[perf-flush] t=%.0fs tex-up %.1fms |", tnow, d[RSX_PERF_W_TEX_UP_T] * tk);
+    for (int r = 0; r < 12 && fo >= 0 && (size_t)fo < n - 40; r++)
+        if (d[RSX_PERF_W_FLUSH_N0 + r])
+            fo += snprintf(fl + fo, n - (size_t)fo, " %s %lld/%.1fms", rn[r],
+                           d[RSX_PERF_W_FLUSH_N0 + r], d[RSX_PERF_W_FLUSH_T0 + r] * tk);
+    if (fo >= 0 && (size_t)fo < n)
+        snprintf(fl + fo, n - (size_t)fo, " | wraps srv %lld smp %lld up %lld vtx %lld cb %lld pscb %lld",
+                 d[RSX_PERF_W_WRAP_SRV], d[RSX_PERF_W_WRAP_SMP], d[RSX_PERF_W_FLUSH_N0 + 11],
+                 d[RSX_PERF_W_FLUSH_N0 + 2], d[RSX_PERF_W_FLUSH_N0 + 3], d[RSX_PERF_W_FLUSH_N0 + 8]);
+}
+
 /* GCM_GET_EQ_PUT=1: see where get is published at the end of a pass. */
 static int gcm_get_eq_put(void)
 {
