+/* KZ3_MOUSE_FEED (patch 2108, tests): a thread that adds the events' counts at a constant speed per wall time
+ * (pad_mouse.h pad_mouse_feed_owed), so a run measures the look against a steady hand, which KZ3_MOUSE_SCRIPT (a share
+ * per look update) cannot. Starts at the first look take; logs its start and its total. */
+static PadMouseEv s_fev[PAD_MOUSE_SCRIPT_MAX];
+static int        s_nfev = -1;
+int pad_mouse_feed_active(void)
+{
+    if (s_nfev < 0) {
+        int bad = 0;
+        const char* e = getenv("KZ3_MOUSE_FEED");
+        s_nfev = e && *e ? pad_mouse_script_parse(e, s_fev, PAD_MOUSE_SCRIPT_MAX, &bad) : 0;
+        if (e && *e)
+            fprintf(stderr, "[mouse] feed: %d event(s) (counts per second, seconds), %d unreadable\n", s_nfev, bad);
+    }
+    return s_nfev > 0;
+}
+#ifdef _WIN32
+static DWORD WINAPI pm_feed_thread(LPVOID unused)
+{
+    (void)unused;
+    LARGE_INTEGER qf, q0, q;
+    QueryPerformanceFrequency(&qf);
+    QueryPerformanceCounter(&q0);
+    long long sx[PAD_MOUSE_SCRIPT_MAX] = {0}, sy[PAD_MOUSE_SCRIPT_MAX] = {0}, tx = 0, ty = 0;
+    double end = 0.0;
+    for (int i = 0; i < s_nfev; i++) if (s_fev[i].t + s_fev[i].left > end) end = s_fev[i].t + s_fev[i].left;
+    for (;;) {
+        QueryPerformanceCounter(&q);
+        const double el = (double)(q.QuadPart - q0.QuadPart) / (double)qf.QuadPart;
+        int ax = 0, ay = 0;
+        for (int i = 0; i < s_nfev; i++) {
+            const long long ox = pad_mouse_feed_owed(s_fev[i].dx, s_fev[i].t, s_fev[i].left, el);
+            const long long oy = pad_mouse_feed_owed(s_fev[i].dy, s_fev[i].t, s_fev[i].left, el);
+            ax += (int)(ox - sx[i]); ay += (int)(oy - sy[i]);
+            sx[i] = ox; sy[i] = oy;
+        }
+        if (ax || ay) { pad_mouse_add(ax, ay); tx += ax; ty += ay; }
+        if (el > end) break;
+        Sleep(1);
+    }
+    fprintf(stderr, "[mouse] feed done: %lld,%lld counts\n", tx, ty);
+    return 0;
+}
+static void pm_feed_start(void)
+{
+    static volatile LONG s_started;
+    if (s_started || !pad_mouse_feed_active() || InterlockedExchange(&s_started, 1)) return;
+    HANDLE h = CreateThread(NULL, 0, pm_feed_thread, NULL, 0, NULL);
+    if (h) CloseHandle(h);
+    fprintf(stderr, "[mouse] feed started%s\n", h ? "" : ": CreateThread failed");
+}
+#else
+static void pm_feed_start(void) { (void)pad_mouse_feed_active(); }
+#endif
