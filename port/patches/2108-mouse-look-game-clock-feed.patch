+/* KZ3_MOUSE_FEED (tests, patch 2108): "T:CX,CY*D" feeds CX,CY counts per second of wall time for D seconds from T
+ * seconds after the first look take, through pad_mouse_add (so they get arrival times like Raw Input). Several events
+ * add up. pad_mouse_feed_due: the counts event e owes by `el` seconds since the first take (sent = already fed). */
+static inline long long pad_mouse_feed_owed(double rate, double t, double dur, double el)
+{
+    double s = el - t;
+    if (s <= 0.0) return 0;
+    if (s > dur) s = dur;
+    return (long long)(rate * s);
+}
