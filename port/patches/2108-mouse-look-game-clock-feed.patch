+/* Patch 2108 (RSX pass 103): look counts on the game's clock. KZ3's look update runs once per logic slot (1/15 s of
+ * game time, the RE notes s.6.2), but the slot runs at whatever wall time the frame loop reaches it, so a
+ * take of "everything since the last take" hands each slot a wall-time share that swings with the frame cadence
+ * (RSX pass 102: 0, 1 or 2 presented frames between updates). pad_look_acc_add_at stamps each add with its arrival
+ * time on the guest timebase; pad_look_acc_take_until hands out only the counts that arrived up to `cut` (the host
+ * time the caller maps the simulated slot to) and keeps the later ones for the next update, so equal slots get equal
+ * wall-time windows. Same idle/drop rule as pad_look_acc_take. */
+static inline void pad_look_acc_add_at(PadLookAcc* a, int dx, int dy, unsigned frame, unsigned long long tb)
+{
+    pad_look_acc_add(a, dx, dy, frame);
+    if (!dx && !dy) return;
+    if (a->qn) {
+        const int t = (a->qh + a->qn - 1) % PAD_LOOK_Q;
+        if (a->qn == PAD_LOOK_Q || (tb >= a->q[t].tb && tb - a->q[t].tb < PAD_LOOK_MERGE_TB) || tb < a->q[t].tb) {
+            a->q[t].dx += dx;
+            a->q[t].dy += dy;
+            if (tb > a->q[t].tb) a->q[t].tb = tb;
+            return;
+        }
+    }
+    const int i = (a->qh + a->qn) % PAD_LOOK_Q;
+    a->q[i].tb = tb;
+    a->q[i].dx = dx;
+    a->q[i].dy = dy;
+    a->qn++;
+}
+static inline void pad_look_acc_take_until(PadLookAcc* a, unsigned frame, unsigned long long cut, int* dx, int* dy,
+                                           long long* dropped)
+{
+    pad_look_acc_age(a, frame);
+    while (a->qn && a->q[a->qh].tb <= cut) { a->qh = (a->qh + 1) % PAD_LOOK_Q; a->qn--; }
+    long long kx = 0, ky = 0;   /* still kept: arrived after cut */
+    for (int k = 0; k < a->qn; k++) { kx += a->q[(a->qh + k) % PAD_LOOK_Q].dx; ky += a->q[(a->qh + k) % PAD_LOOK_Q].dy; }
+    long long x = a->dx - kx, y = a->dy - ky;
+    if (x > 0x7FFFFFFF) x = 0x7FFFFFFF; else if (x < -0x7FFFFFFF) x = -0x7FFFFFFF;
+    if (y > 0x7FFFFFFF) y = 0x7FFFFFFF; else if (y < -0x7FFFFFFF) y = -0x7FFFFFFF;
+    *dx = (int)x;
+    *dy = (int)y;
+    if (dropped) *dropped = a->dropped;
+    a->dx = kx;
+    a->dy = ky;
+    a->dropped = 0;
+    a->take_frame = frame;
+    a->taken = 1;
+}
