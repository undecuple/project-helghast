+/* KZ3 patch 2107: motion blur (on | off; the post chain's MotionBlur job, default on = the game's look) and the frame
+ * rate limit (30 | 60 | 120; default 30 = the game's own; ENHANCEMENT, gameplay timing: above 30 opt-in with a warning). */
+enum { RSX_DM_FPS_30 = 30, RSX_DM_FPS_60 = 60, RSX_DM_FPS_120 = 120 };
+static inline int rsx_dm_parse_fps(const char* s)
+{
+    size_t n;
+    if (!rsx_dm_trim(&s, &n)) return -1;
+    if (rsx_dm_ieq(s, n, "30")) return RSX_DM_FPS_30;
+    if (rsx_dm_ieq(s, n, "60")) return RSX_DM_FPS_60;
+    if (rsx_dm_ieq(s, n, "120")) return RSX_DM_FPS_120;
+    return -1;
+}
+static inline const char* rsx_dm_fps_name(int v) { return v == RSX_DM_FPS_120 ? "120" : v == RSX_DM_FPS_60 ? "60" : "30"; }
+static inline int rsx_dm_ini_motion_blur(const char* t)    /* 1 on, 0 off, -1 missing or unreadable */
+{
+    char v[32];
+    return rsx_dm_ini_value(t, "motion_blur", v, sizeof v) ? rsx_dm_parse_vsync(v) : -1;
+}
+static inline int rsx_dm_ini_fps(const char* t)            /* 30 | 60 | 120, -1 missing or unreadable */
+{
+    char v[32];
+    return rsx_dm_ini_value(t, "fps_limit", v, sizeof v) ? rsx_dm_parse_fps(v) : -1;
+}
+/* The guest vblank tick for a limit, in ms. KZ3 releases a frame on every 2nd vblank (its handler sets RSX label 72, the
+ * frame waits on it), so the vblank rate sets the cap: 16 ms (62.5 Hz, the port's tick before 2107) = 30, 8 = 60, 4 = 120. */
+static inline unsigned rsx_dm_fps_vblank_ms(int fps) { return fps == RSX_DM_FPS_120 ? 4u : fps == RSX_DM_FPS_60 ? 8u : 16u; }
+
+static inline int rsx_dm_ini_write_ext(char* buf, size_t n, int mode, int scaling, int filter, int vsync, int motion_blur, int fps)
+{
+    return snprintf(buf, n,
+                    "# Project Helghast display settings (Options > Display; Alt+Enter toggles the mode).\n"
+                    "# mode = windowed | borderless | fullscreen, scaling = fit | stretch, filter = bilinear | nearest, vsync = on | off.\n"
+                    "# motion_blur = on | off. fps_limit = 30 | 60 | 120: 30 is the game's own; above 30 can break gameplay timing.\n"
+                    "# KZ3_DISPLAY, KZ3_DISPLAY_SCALING, KZ3_DISPLAY_FILTER, KZ3_MOTION_BLUR, KZ3_FPS_LIMIT override them for one run.\n"
+                    "[display]\nmode = %s\nscaling = %s\nfilter = %s\nvsync = %s\nmotion_blur = %s\nfps_limit = %s\n",
+                    rsx_dm_name(mode), rsx_dm_scaling_name(scaling), rsx_dm_filter_name(filter), rsx_dm_vsync_name(vsync),
+                    rsx_dm_vsync_name(motion_blur != 0), rsx_dm_fps_name(fps));
+}
