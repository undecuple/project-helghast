+/* Patch 2111 (RSX pass 104; ENHANCEMENT): the shown cursor over the client area is the menu pointer in the game's
+ * colours (pad_cursor_art.h), made once at the window's DPI; KZ3_GAME_CURSOR=0 keeps the system arrow. */
+#include "pad_cursor_art.h"
+static HCURSOR pm_cursor(HWND hwnd)
+{
+    static HCURSOR c;
+    static int tried;
+    if (tried) return c ? c : LoadCursor(NULL, IDC_ARROW);
+    tried = 1;
+    const char* e = getenv("KZ3_GAME_CURSOR");
+    if (e && *e == '0') return LoadCursor(NULL, IDC_ARROW);
+    UINT dpi = 96;
+    HMODULE u = GetModuleHandleA("user32.dll");
+    typedef UINT (WINAPI *GetDpiForWindowFn)(HWND);
+    GetDpiForWindowFn gd = u ? (GetDpiForWindowFn)(void*)GetProcAddress(u, "GetDpiForWindow") : NULL;
+    if (gd && hwnd) { const UINT v = gd(hwnd); if (v >= 96) dpi = v; }
+    const int size = MulDiv(32, (int)dpi, 96);
+    BITMAPV5HEADER bh;
+    memset(&bh, 0, sizeof bh);
+    bh.bV5Size = sizeof bh; bh.bV5Width = size; bh.bV5Height = -size; bh.bV5Planes = 1; bh.bV5BitCount = 32;
+    bh.bV5Compression = BI_BITFIELDS; bh.bV5RedMask = 0x00FF0000; bh.bV5GreenMask = 0x0000FF00;
+    bh.bV5BlueMask = 0x000000FF; bh.bV5AlphaMask = 0xFF000000;
+    void* bits = NULL;
+    HDC dc = GetDC(NULL);
+    HBITMAP col = CreateDIBSection(dc, (BITMAPINFO*)&bh, DIB_RGB_COLORS, &bits, NULL, 0);
+    ReleaseDC(NULL, dc);
+    HBITMAP mask = CreateBitmap(size, size, 1, 1, NULL);
+    if (col && bits && mask) {
+        pad_cursor_render((uint32_t*)bits, size);
+        ICONINFO ii = { FALSE, 1, 1, mask, col };
+        c = (HCURSOR)CreateIconIndirect(&ii);
+    }
+    if (col) DeleteObject(col);
+    if (mask) DeleteObject(mask);
+    fprintf(stderr, "[mouse] menu pointer: %s (%d px, %u dpi)\n", c ? "game style" : "system arrow (create failed)", size, dpi);
+    return c ? c : LoadCursor(NULL, IDC_ARROW);
+}
 static void pm_apply(HWND hwnd, const char* why)
 {
     const int over = pm_cursor_over_client(hwnd);
