+/* Draw one keycap into the RGBA cell (cw x ch, row stride cw). Style: the game's own shoulder-button cells (L1/R1:
+ * near-black rounded body, a lighter rim, bold white letters). */
+static void kc_draw_cap(uint8_t* cell, int cw, int ch, const char* text, int vk)
+{
+    memset(cell, 0, (size_t)cw * ch * 4);
+    const float m = 1.0f, hx = cw * 0.5f - m, hy = ch * 0.5f - m, cx = cw * 0.5f, cy = ch * 0.5f;
+    const float r = (cw < ch ? cw : ch) * 0.22f;
+    for (int y = 0; y < ch; y++) for (int x = 0; x < cw; x++) {
+        const float d = kc_rbox(x + 0.5f, y + 0.5f, cx, cy, hx, hy, r);
+        const float cov = kc_clamp01(0.5f - d);
+        if (cov <= 0) continue;
+        const float t = (float)y / (ch - 1);                 /* 0 top, 1 bottom */
+        const float body = 46.f - 34.f * t;                  /* #2E -> #0C */
+        const float rim = kc_clamp01(1.0f - fabsf(d + 1.0f));   /* a 1 px ring just inside the edge */
+        const float rc = 150.f - 80.f * t;
+        const float v = body * (1 - rim) + rc * rim;
+        uint8_t* p = cell + ((size_t)y * cw + x) * 4;
+        p[0] = p[1] = p[2] = (uint8_t)v; p[3] = (uint8_t)(cov * 242.f);
+    }
+    /* the face: text or picture, re-centred on its ink */
+    const int iw = cw - 5 > 4 ? cw - 5 : 4, ih = ch - 5 > 4 ? ch - 5 : 4;
+    unsigned char* mk = (unsigned char*)calloc((size_t)iw * ih, 1);
+    if (!mk) return;
+    int ok = kc_picture(vk, mk, iw, ih);
+    if (!ok && text && text[0]) {
+        const size_t len = strlen(text);
+        int cap = (int)(ih * (len <= 1 ? 0.62f : len <= 3 ? 0.52f : 0.50f) + 0.5f);   /* the face shrinks long names to the width */
+        ok = g_kc_src.text_mask(text, cap, mk, iw, ih);
+    }
+    if (ok) {
+        int x0 = iw, x1 = -1, y0 = ih, y1 = -1;
+        for (int y = 0; y < ih; y++) for (int x = 0; x < iw; x++)
+            if (mk[y * iw + x] > 24) { if (x < x0) x0 = x; if (x > x1) x1 = x; if (y < y0) y0 = y; if (y > y1) y1 = y; }
+        if (x1 >= x0) {
+            const int ox = (cw - (x1 - x0 + 1)) / 2 - x0, oy = (ch - (y1 - y0 + 1)) / 2 - y0;
+            for (int y = 0; y < ih; y++) for (int x = 0; x < iw; x++) {
+                const int tx = x + ox, ty = y + oy;
+                if (tx < 0 || ty < 0 || tx >= cw || ty >= ch || !mk[y * iw + x]) continue;
+                kc_over(cell + ((size_t)ty * cw + tx) * 4, 240.f, 240.f, 240.f, mk[y * iw + x] / 255.f);
+            }
+        }
+    }
+    free(mk);
+}
