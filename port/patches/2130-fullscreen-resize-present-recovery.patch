+/* KZ3 patch 2130 (RSX pass 124): a fullscreen transition needs ResizeBuffers before the next Present, also at an
+ * unchanged size. DXGI (SetFullscreenState remarks): "For the flip presentation model, after you transition the display
+ * state to full screen, you must call ResizeTarget to ensure that your call to IDXGISwapChain1::Present1 succeeds";
+ * the buffers follow with ResizeBuffers (D3D12 samples: WM_SIZE -> ResizeBuffers). 2095 resized only on a size change,
+ * and a borderless window is already the output's size, so the first Present after SetFullscreenState(TRUE) went out on
+ * the un-resized chain and failed with DXGI_ERROR_INVALID_CALL (the player's logs: Options -> fullscreen, and a fresh
+ * start with display.ini fullscreen at frame 0). g_dm_force_resize makes the next present resize regardless of size.
+ * g_dm_present_failed tells rsx_null_backend.c that exclusive fullscreen was dropped after a failed Present. */
+static int g_dm_force_resize;
+static volatile LONG g_dm_present_failed;
 
 /* patch 2103: VSync. The swap chain is created with DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING whenever the factory reports
  * DXGI_FEATURE_PRESENT_ALLOW_TEARING (harmless with vsync on). ResizeBuffers must repeat the flag. */
@@ -15357,9 +15367,21 @@
 {
     u32 w, h;
