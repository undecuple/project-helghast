+        /* patch 2130, test: LD_TEST_PRESENT_FAIL=N makes the Present of frame N return DXGI_ERROR_INVALID_CALL
+         * without presenting (the failure of the player's logs), so the recovery path runs under Proton, whose DXGI
+         * never failed there (run r90-fs). */
+        static long s_fail_at = -2;
+        if (s_fail_at == -2) { const char* e = getenv("LD_TEST_PRESENT_FAIL"); s_fail_at = e && *e ? atol(e) : -1; }
         const HRESULT present_hr = s_nopresent ? S_OK
+            : (s_fail_at >= 0 && (long)g_ld_frames == s_fail_at) ? DXGI_ERROR_INVALID_CALL
             : ld_present_swap();
         rsx_perf_add(RSX_PERF_SWAP_T, rsx_perf_now() - swap0);
         if (SUCCEEDED(present_hr))
@@ -17826,8 +17892,32 @@
                     (unsigned long)present_hr, g_ld_frames,
                     target, g.surfaces[target].w, g.surfaces[target].h,
