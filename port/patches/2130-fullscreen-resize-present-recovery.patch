-            ld_dump_dred("Present", present_hr);
-            g.ready = 0;
+            /* patch 2130: a failed Present on a live device is a swap-chain state error (DXGI_ERROR_INVALID_CALL after
+             * a fullscreen transition), not a lost renderer: leave exclusive fullscreen, resize the buffers at the
+             * next present and keep drawing. Only a removed device stops the renderer (the old path for every
+             * failure: one bad Present sent all later draws to the null backend for the rest of the session). */
+            const HRESULT removed = g.dev->lpVtbl->GetDeviceRemovedReason(g.dev);
+            static u32 s_pf_lines;
+            BOOL fs_now = FALSE;
+            g.swap->lpVtbl->GetFullscreenState(g.swap, &fs_now, NULL);
+            fprintf(stderr, "[d3d-fail] Present: back buffers %ux%u, exclusive fullscreen %s, device %s (hr=0x%08lX)\n",
+                    g_dm_bb_w, g_dm_bb_h, fs_now ? "on" : "off", removed == S_OK ? "alive" : "removed", (unsigned long)removed);
+            if (removed == S_OK) {
+                if (fs_now || g_dm_fs) {
+                    const HRESULT ls = g.swap->lpVtbl->SetFullscreenState(g.swap, FALSE, NULL);
+                    g_dm_fs = 0;
+                    InterlockedExchange(&g_dm_present_failed, 1);
+                    fprintf(stderr, "[display] Present failed in exclusive fullscreen: SetFullscreenState(FALSE) hr=0x%08lX, "
+                            "borderless from here, renderer kept\n", (unsigned long)ls);
+                }
+                g_dm_force_resize = 1;
+                if (s_pf_lines++ < 8)
+                    fprintf(stderr, "[display] Present failed on a live device: swap chain resized at the next present, "
+                            "renderer kept (%u failures)\n", s_pf_lines);
+            } else {
+                ld_dump_dred("Present", present_hr);
+                g.ready = 0;
+            }
         }
     }
