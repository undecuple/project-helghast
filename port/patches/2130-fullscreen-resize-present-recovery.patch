     BOOL cur = FALSE;
     g.swap->lpVtbl->GetFullscreenState(g.swap, &cur, NULL);
-    if ((cur != FALSE) == (on != 0)) { g_dm_fs = on != 0; return 1; }
+    if ((cur != FALSE) == (on != 0)) {
