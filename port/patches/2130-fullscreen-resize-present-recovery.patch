+    }
     const HRESULT hr = g.swap->lpVtbl->SetFullscreenState(g.swap, on ? TRUE : FALSE, NULL);
     g.swap->lpVtbl->GetFullscreenState(g.swap, &cur, NULL);
     g_dm_fs = cur != FALSE;
