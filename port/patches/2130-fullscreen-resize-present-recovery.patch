 }
 
+/* patch 2130: 1 once after a failed Present made the renderer leave exclusive fullscreen (rsx_null_backend.c then
+ * shows borderless for the session and says so); 0 otherwise. */
+int rsx_live_draw_take_present_failure(void)
+{
+    return InterlockedExchange(&g_dm_present_failed, 0) != 0;
+}
