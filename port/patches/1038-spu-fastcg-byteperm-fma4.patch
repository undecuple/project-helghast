+            const __m128 r4 = _mm_movelh_ps(_mm_cvtpd_ps(sl), _mm_cvtpd_ps(sh));
+            u128 r; memcpy(&r, &r4, 16); return r;
+        }
+    }
+    u128 r;
+    for (int i = 0; i < 4; i++)
