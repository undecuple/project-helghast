+ * spu__fmaf (one double rounding of the exact product sum, then to float), plus an exact-zero sum taken
+ * inline: a double sum of two doubles is 0 only when it is exactly 0, and the sign rule is the same as the
+ * fused one. The level profile (spu-27a) had 19 % of the audio job's (ovl260) host samples inside MinGW's
+ * fmaf: the mixer's silent buffers made every sum an exact zero, which the scalar rule sent to fmaf.
+ * A lane outside the rule (float subnormal/overflow range, NaN/inf, a rounding midpoint) runs all four
+ * lanes through spu__fmaf as before. KZ3_SPU_FASTCG=0 keeps the old per-lane path. */
+#if defined(__SSE4_1__) && !defined(__FMA__)
+SPU_HOT u128 spu__fma4(u128 a, u128 b, u128 c, int negb, int negc) {
+    if (__builtin_expect(!g_kz3_spu_slowcg, 1)) {
