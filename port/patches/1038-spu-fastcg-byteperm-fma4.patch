+/* KZ3 patch 1038 (SPU pass 27): the quadword byte shifts/rotates as one pshufb. The byte loops below
+ * (16 iterations through memory, ~30-50 host instructions each, GCC does not vectorise them) were a generic
+ * cost of every lifted job. Result SPU byte i takes source SPU byte t = i + d (d = sh for left shifts and
+ * rotates, -sh for the rotqm right shifts); a rotate wraps t mod 16, a shift yields 0 when t leaves 0..15.
+ * Host byte h holds SPU byte h ^ 3 (SPU_W), so the pshufb index of host byte h is (t ^ 3), or 0x80 (zero).
+ * With a constant shift the index folds to a constant. g_kz3_spu_slowcg (KZ3_SPU_FASTCG=0, read by the
+ * runtime at start) keeps the old loops for A/B runs. */
+#if defined(__SSE4_1__)
+extern int g_kz3_spu_slowcg;
+SPU_HOT u128 spu__byteperm(u128 a, int d, int wrap) {
+    const __m128i iv = _mm_setr_epi8(3,2,1,0, 7,6,5,4, 11,10,9,8, 15,14,13,12);   /* SPU byte of host byte h */
+    __m128i t = _mm_add_epi8(iv, _mm_set1_epi8((char)d));
+    __m128i idx;
+    if (wrap) idx = _mm_xor_si128(_mm_and_si128(t, _mm_set1_epi8(0x0F)), _mm_set1_epi8(3));
+    else {
+        /* d in -31..31, so t in -31..46: out of range is t < 0 or t > 15 */
+        const __m128i out = _mm_or_si128(_mm_cmpgt_epi8(t, _mm_set1_epi8(15)), _mm_cmplt_epi8(t, _mm_setzero_si128()));
+        idx = _mm_or_si128(_mm_xor_si128(t, _mm_set1_epi8(3)), out);
+    }
+    __m128i A; memcpy(&A, &a, 16);
+    A = _mm_shuffle_epi8(A, idx);
+    u128 r; memcpy(&r, &A, 16); return r;
+}
+#  define SPU_FASTPERM(expr) if (__builtin_expect(!g_kz3_spu_slowcg, 1)) return (expr)
+#else
+#  define SPU_FASTPERM(expr) ((void)0)
+#endif
+static inline u128 spu_shlqbyi(u128 a, int sh) { u128 r=spu_zero(); sh&=0x1F; SPU_FASTPERM(sh>=16 ? r : spu__byteperm(a, sh, 0)); for(int i=0;i<16;i++){ int s=i+sh; if(s<16) r._u8[SPU_W(i)]=a._u8[SPU_W(s)]; } return r; }
