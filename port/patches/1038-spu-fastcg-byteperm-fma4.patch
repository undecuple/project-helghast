+    return r;
+}
+SPU_HOT u128 spu_fma(u128 a, u128 b, u128 c)  { return spu__fma4(a, b, c, 0, 0); }
+SPU_HOT u128 spu_fms(u128 a, u128 b, u128 c)  { return spu__fma4(a, b, c, 0, 1); }
