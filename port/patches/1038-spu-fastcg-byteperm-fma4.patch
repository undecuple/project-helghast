+        const __m128i m29 = _mm_set1_epi64x(0x1FFFFFFFll), mid = _mm_set1_epi64x(0x10000000ll);
+        const __m128d al = _mm_and_pd(sl, absm), ah = _mm_and_pd(sh, absm);
+        const __m128d okl = _mm_or_pd(_mm_andnot_pd(_mm_castsi128_pd(_mm_cmpeq_epi64(_mm_and_si128(_mm_castpd_si128(sl), m29), mid)),
+                                                    _mm_and_pd(_mm_cmpge_pd(al, lo), _mm_cmplt_pd(al, hi))), _mm_cmpeq_pd(sl, z));
+        const __m128d okh = _mm_or_pd(_mm_andnot_pd(_mm_castsi128_pd(_mm_cmpeq_epi64(_mm_and_si128(_mm_castpd_si128(sh), m29), mid)),
