+        if (timeout_us) { uint64_t m = (timeout_us + 999) / 1000; wms = m > 0xFFFFFFFEull ? 0xFFFFFFFEu : (DWORD)m; }
+        if (WaitForSingleObject(sl->sem, wms) == WAIT_TIMEOUT) {
+            /* Withdraw our registration. If a signaller already took it, its
+             * count is on the way: consume it and report the wakeup. */
+            int withdrawn = 0;
+            for (;;) {
+                long w = sl->waiters;
+                if (w <= 0) break;
+                if (_InterlockedCompareExchange(&sl->waiters, w - 1, w) == w) { withdrawn = 1; break; }
+            }
+            if (withdrawn) result = 0x8001000Bu;
+            else WaitForSingleObject(sl->sem, INFINITE);
+        }
+        lwm_acquire(ms, 0);
         vm_write32(lwmutex + LWM_OWNER, own);
         vm_write32(lwmutex + LWM_RECUR, rc ? rc : 1);
     }
-    ctx->gpr[3] = 0;
+#endif
+    ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)result;
 }
 
