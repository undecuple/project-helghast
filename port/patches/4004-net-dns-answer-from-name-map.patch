+/* KZ3 4004: the DNS answer (RFC 1035 wire format). Only the question is read: header (12 bytes), one QNAME of
+ * plain labels (no compression pointers, at most 253 characters), QTYPE, QCLASS. */
+size_t ps3_net_policy_dns_answer(const uint8_t* q, size_t qlen, uint8_t* out, size_t cap)
+{
+    char name[256];
+    size_t off = 12, nl = 0;
+    if (!s_strict || !q || !out || qlen < 12 + 5 || qlen > PS3_NET_DNS_MAX || cap < PS3_NET_DNS_MAX) return 0;
+    if ((q[2] & 0x80) || (q[2] & 0x78) != 0) return 0;          /* a response, or not a standard query */
+    if (q[4] != 0 || q[5] != 1) return 0;                        /* exactly one question */
+    for (;;) {
+        if (off >= qlen) return 0;
+        uint8_t l = q[off++];
+        if (l == 0) break;
+        if (l > 63 || off + l > qlen || nl + l + 1 > 253) return 0;   /* also refuses compression (0xC0) */
+        if (nl) name[nl++] = '.';
+        for (uint8_t i = 0; i < l; i++) {
+            char ch = (char)q[off + i];
+            if (!ch) return 0;
+            name[nl++] = ch;
+        }
+        off += l;
+    }
+    name[nl] = 0;
+    if (off + 4 > qlen) return 0;
+    uint16_t qtype = (uint16_t)(q[off] << 8 | q[off + 1]), qclass = (uint16_t)(q[off + 2] << 8 | q[off + 3]);
+    size_t qend = off + 4;
+    uint8_t ip[4];
+    int mapped = nl && ps3_net_policy_resolve(name, ip) == 1;
+    int answer = mapped && (qclass == 1 || qclass == 255) && (qtype == 1 || qtype == 255);
+    memcpy(out, q, qend);                                        /* id, flags, counts, question */
+    out[2] = (uint8_t)(0x80 | (q[2] & 0x01));                    /* QR, opcode 0, RD copied */
+    out[3] = (uint8_t)(0x80 | (mapped ? 0 : 3));                 /* RA, NOERROR / NXDOMAIN */
+    out[6] = 0; out[7] = (uint8_t)answer;                        /* ANCOUNT */
+    out[8] = out[9] = out[10] = out[11] = 0;                     /* NSCOUNT, ARCOUNT */
+    size_t n = qend;
+    if (answer) {
+        static const uint8_t rr[12] = { 0xC0, 0x0C, 0, 1, 0, 1, 0, 0, 0, 60, 0, 4 };
+        memcpy(out + n, rr, sizeof(rr)); n += sizeof(rr);
+        memcpy(out + n, ip, 4); n += 4;
+    }
+    static unsigned said;                                        /* a resolver retries: log the first 32 */
+    if (said < 32)
+        printf("[net] DNS %s (type %u) -> %s (answered locally, nothing sent)%s\n", name, (unsigned)qtype,
+               answer ? "server" : mapped ? "no record" : "not found", ++said == 32 ? "; further answers not logged" : "");
+    return n;
+}
