+/* KZ3 4004: a strict-mode DNS query: answered from the name map into the socket's pending reply. */
+static int32_t dns_local(int32_t s, const void* buf, uint32_t len, const struct sockaddr_in* to)
+{
+    uint8_t q[PS3_NET_DNS_MAX];
+    if (len > sizeof(q)) return (int32_t)len;                  /* not a plain DNS query: dropped, nothing sent */
+    vm_memcpy_from(q, EA(buf), len);
+    size_t n = ps3_net_policy_dns_answer(q, len, s_sockets[s].dns_buf, sizeof(s_sockets[s].dns_buf));
+    if (n) { s_sockets[s].dns_len = (uint16_t)n; s_sockets[s].dns_from = *to; }
+    return (int32_t)len;
+}
+
+static int dns_take(int32_t s, void* buf, uint32_t len, struct sockaddr_in* from)
+{
+    uint32_t n = s_sockets[s].dns_len;
+    if (n > len) n = len;                                       /* datagram semantics: the rest is dropped */
+    vm_memcpy_to(EA(buf), s_sockets[s].dns_buf, n);
+    if (from) *from = s_sockets[s].dns_from;
+    s_sockets[s].dns_len = 0;
+    return (int)n;
+}
+
+static int dns_intercept(int32_t s, const struct sockaddr_in* a)
+{
+    return ps3_net_policy_strict() && !s_sockets[s].stream && !s_sockets[s].p2p && ntohs(a->sin_port) == 53;
+}
