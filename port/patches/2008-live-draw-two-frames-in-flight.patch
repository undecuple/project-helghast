 /* ---------------------------------------------------------------------------
  * command list submit/wait (simple synchronous model, like the harness)
  * -----------------------------------------------------------------------*/
+static void ld_fr_load(u32 i)
+{
+    struct ld_frame_slot* f = &g.fr[i];
+    g.alloc = f->alloc;
+    g.upload = f->upload; g.upload_mapped = f->upload_mapped;
+    g.vb = f->vb; g.vb_mapped = f->vb_mapped;
+    g.ib = f->ib; g.ib_mapped = f->ib_mapped;
+    g.cb = f->cb; g.cb_mapped = f->cb_mapped;
+    g.ps_cb = f->ps_cb; g.ps_cb_mapped = f->ps_cb_mapped;
+    g.srv_heap = f->srv_heap; g.smp_heap = f->smp_heap;
+    g.fr_cur = i;
+}
+static void ld_fr_store(u32 i)
+{
+    struct ld_frame_slot* f = &g.fr[i];
+    f->alloc = g.alloc;
+    f->upload = g.upload; f->upload_mapped = g.upload_mapped;
+    f->vb = g.vb; f->vb_mapped = g.vb_mapped;
+    f->ib = g.ib; f->ib_mapped = g.ib_mapped;
+    f->cb = g.cb; f->cb_mapped = g.cb_mapped;
+    f->ps_cb = g.ps_cb; f->ps_cb_mapped = g.ps_cb_mapped;
+    f->srv_heap = g.srv_heap; f->smp_heap = g.smp_heap;
+}
+/* Block until the queue fence reaches v. 0 on a D3D12 failure. */
+static int ld_wait_fence(u64 v)
+{
+    if (!v || g.fence->lpVtbl->GetCompletedValue(g.fence) >= v) return 1;
+    const HRESULT event_hr =
+        g.fence->lpVtbl->SetEventOnCompletion(g.fence, v, g.fence_event);
+    if (FAILED(event_hr)) {
+        fprintf(stderr,
+                "[d3d-fail] fence SetEventOnCompletion hr=0x%08lX frame=%u\n",
+                (unsigned long)event_hr, g_ld_frames);
+        ld_dump_dred("SetEventOnCompletion", event_hr);
+        g.ready = 0;
+        return 0;
+    }
+    const long long w0 = rsx_perf_now();
+    WaitForSingleObject(g.fence_event, INFINITE);
+    rsx_perf_add(RSX_PERF_GPUWAIT_T, rsx_perf_now() - w0);
+    return 1;
+}
+static void ld_fr_release_retired(u32 i)
+{
+    struct ld_frame_slot* f = &g.fr[i];
+    for (u32 k = 0; k < f->n_retired; k++)
+        f->retired[k]->lpVtbl->Release(f->retired[k]);
+    f->n_retired = 0;
+}
+/* CPU writes into a buffer outside the per-frame rings (movie upload at
+ * offset 0) must not race a frame still in flight. */
+static void ld_wait_idle(void)
+{
+    if (g.ready && g.fif_n > 1) ld_wait_fence(g.fence_value);
+}
