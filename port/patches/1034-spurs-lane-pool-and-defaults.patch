+/* KZ3 patch 1034: persistent lane workers. A workload with maxContention > 1 ran lanes 1..N-1 on
+ * threads created and joined every pass (one CreateThread per lane per ~3 ms run). Each kernel
+ * thread now keeps up to 7 lane threads that wait on an event, run one policy-module pass for the
+ * lane they are given, and signal completion; the kernel joins them as before. Policy-module contexts
+ * are per (wid, spuNum) in spurs_policy.c, not per host thread, so a lane thread may serve any
+ * workload. KZ3_SPURS_LANE_POOL=0: the old per-pass threads. */
+struct kz3_lane {
+    HANDLE th, go, done;
+    struct spurs_pm_worker_arg a;
+    int kt; const char* prefix;
+};
+static DWORD WINAPI kz3_lane_thread(LPVOID p)
+{
+#ifdef _WIN32
+    { ULONG g = 256 * 1024; SetThreadStackGuarantee(&g); }
+#endif
+    struct kz3_lane* L = (struct kz3_lane*)p;
+    if (kz3_wacct_on()) { char nm[40]; snprintf(nm, sizeof nm, "pm-worker:%s/k%d/spu%u", L->prefix, L->kt, (unsigned)L->a.spu_num); kz3_wacct_name(nm); }
+    for (;;) {
+        WaitForSingleObject(L->go, INFINITE);
+        const uint64_t wa0 = kz3_wacct_begin();
+        spu_run_policy_module(L->a.fn, L->a.image_id, L->a.pm, L->a.pm_size,
+                              L->a.arg, L->a.wid, L->a.ea, L->a.spu_num);
+        kz3_wacct_job(0);
+        kz3_wacct_end(KZ3_WA_PMRUN, L->a.wid, wa0);
+        SetEvent(L->done);
+    }
+    return 0;
+}
