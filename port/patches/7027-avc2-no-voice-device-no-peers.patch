     return CELL_OK;
 }
 
@@ -49,6 +55,7 @@ s32 cellSysutilAvc2LoadAsync(u16 ctxId, u32 container, u32 callback, u32 userdat
     (void)ctxId; (void)container; (void)initParam;
     s_cb = callback;
     s_userdata = userdata;
+    s_avc2_loaded = 1;
     printf("[cellSysutilAvc2] LoadAsync: voice chat up, silent\n");
     avc2_event(AVC2_EVENT_LOAD_SUCCEEDED);
     return CELL_OK;
@@ -62,19 +69,28 @@ s32 cellSysutilAvc2Load(u16 ctxId, u32 container, u32 callback, u32 userdata, u3
     (void)ctxId; (void)container; (void)initParam;
     s_cb = callback;
     s_userdata = userdata;
+    s_avc2_loaded = 1;   /* patch 7027: the state the other calls check */
     printf("[cellSysutilAvc2] Load: voice chat up, silent\n");
     avc2_event(AVC2_EVENT_LOAD_SUCCEEDED);
     return CELL_OK;
 }
 
+/* patch 7027: NOT_INITIALIZED if not loaded, else unloads (UNLOAD_SUCCEEDED through the callback, as upstream). */
 s32 cellSysutilAvc2Unload(void)
 {
-    avc2_event(AVC2_EVENT_UNLOAD_SUCCEEDED);
+    if (!s_avc2_loaded) return AVC2_ERR_NOT_INITIALIZED;
+    s_avc2_loaded = s_avc2_joined = s_avc2_streaming = 0;   /* synchronous: no event; UnloadAsync raises it */
     return CELL_OK;
 }
 
-/* Settings of a chat that carries no audio: accepted. (CellSysutilAvc2AttributeId, CellSysutilAvc2Attribute*) */
-s32 cellSysutilAvc2SetAttribute(u32 attr) { (void)attr; return CELL_OK; }
+/* (CellSysutilAvc2Attribute* attr): NULL is INVALID_ARGUMENT, NOT_INITIALIZED before Load, else OK (no device to apply
+ * it to; patch 7027). */
+s32 cellSysutilAvc2SetAttribute(u32 attr)
+{
+    if (!s_avc2_loaded) return AVC2_ERR_NOT_INITIALIZED;
+    return attr ? CELL_OK : AVC2_ERR_INVALID_ARGUMENT;
+}
+/* Settings of a chat that carries no audio: accepted. */
 s32 cellSysutilAvc2SetSpeakerVolumeLevel(u32 level) { (void)level; return CELL_OK; }
 s32 cellSysutilAvc2SetSpeakerMuting(u8 muting) { (void)muting; return CELL_OK; }
 s32 cellSysutilAvc2SetVoiceMuting(u8 muting) { (void)muting; return CELL_OK; }
@@ -83,6 +99,7 @@ s32 cellSysutilAvc2StopVoiceDetection(void) { return CELL_OK; }
 
 s32 cellSysutilAvc2UnloadAsync(void)
 {
+    s_avc2_loaded = s_avc2_joined = s_avc2_streaming = 0;   /* patch 7027 */
     avc2_event(AVC2_EVENT_UNLOAD_SUCCEEDED);
     return CELL_OK;
 }
@@ -91,18 +108,67 @@ s32 cellSysutilAvc2UnloadAsync(void)
 s32 cellSysutilAvc2JoinChatRequest(u32 roomId)
 {
     (void)roomId;
+    s_avc2_joined = 1;
     avc2_event(AVC2_EVENT_JOIN_SUCCEEDED);
     return CELL_OK;
 }
 
 s32 cellSysutilAvc2LeaveChatRequest(void)
 {
+    s_avc2_joined = s_avc2_streaming = 0;
     avc2_event(AVC2_EVENT_LEAVE_SUCCEEDED);
     return CELL_OK;
 }
 
-s32 cellSysutilAvc2StartStreaming(void) { return CELL_OK; }
-s32 cellSysutilAvc2StopStreaming(void)  { return CELL_OK; }
+/* The state check shared by everything that needs a joined chat. */
+static s32 avc2_need_chat(void)
+{
+    if (!s_avc2_loaded) return AVC2_ERR_NOT_INITIALIZED;
+    return s_avc2_joined ? CELL_OK : AVC2_ERR_NOT_ACTIVE;
+}
+
+s32 cellSysutilAvc2StartStreaming(void)
+{
+    s32 r = avc2_need_chat();
+    if (r == CELL_OK) s_avc2_streaming = 1;
+    return r;
+}
+
+s32 cellSysutilAvc2StopStreaming(void)
+{
+    s32 r = avc2_need_chat();
+    if (r == CELL_OK) s_avc2_streaming = 0;
+    return r;
+}
+
+/* (const CellSysutilAvc2StreamingTarget* target) */
+s32 cellSysutilAvc2SetStreamingTarget(u32 target)
+{
+    s32 r = avc2_need_chat();
+    return r == CELL_OK && !target ? AVC2_ERR_INVALID_ARGUMENT : r;
+}
+
+/* (u16 playerId, u8 muting) / (u16 playerId, u8* muting) / (u16 playerId, CellSysutilAvc2PlayerInfo* info): no players. */
+s32 cellSysutilAvc2SetPlayerVoiceMuting(u16 playerId, u8 muting)
+{
+    (void)playerId; (void)muting;
+    s32 r = avc2_need_chat();
+    return r == CELL_OK ? AVC2_ERR_INVALID_ARGUMENT : r;
+}
+
+s32 cellSysutilAvc2GetPlayerVoiceMuting(u16 playerId, u32 muting)
+{
+    (void)playerId; (void)muting;
+    s32 r = avc2_need_chat();
+    return r == CELL_OK ? AVC2_ERR_INVALID_ARGUMENT : r;
+}
+
+s32 cellSysutilAvc2GetPlayerInfo(u16 playerId, u32 info)
+{
+    (void)playerId; (void)info;
+    s32 r = avc2_need_chat();
+    return r == CELL_OK ? AVC2_ERR_INVALID_ARGUMENT : r;
+}
 
 s32 cellSysutilAvc2EnableVoiceDetection(u8 enable, u8 level) { (void)enable; (void)level; return CELL_OK; }
 
