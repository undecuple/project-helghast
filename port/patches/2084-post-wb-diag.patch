+/* KZ3 patch 2084: LD_POST_WB_DIAG, SPU DMA GETs of RSX-visible memory -> rsx_live_draw_note_spu_read
+ * (same EA -> location/offset rule as gcm_note_pages_ea, one 1 MB IO page at a time). */
+extern void spu_set_guest_read_hook(void (*hook)(uint32_t ea, uint32_t size)) __attribute__((weak));
+static void gcm_spu_read_ea(uint32_t ea, uint32_t size)
+{
+    u64 a = ea;
+    const u64 end = (u64)ea + size;
+    while (a < end) {
+        const u64 next = (a | 0xFFFFFull) + 1u;
+        const u32 n = (u32)((next < end ? next : end) - a);
+        const u32 e = (u32)a;
+        if (e >= s_config.localAddress && e - s_config.localAddress < s_config.localSize) {
+            rsx_live_draw_note_spu_read(0u, e - s_config.localAddress, n);
+        } else {
+            const u16 io_page = s_io_address_table[e >> 20];
+            if (io_page != 0xFFFF)
+                rsx_live_draw_note_spu_read(1u, ((u32)io_page << 20) | (e & 0xFFFFFu), n);
+        }
+        a = next;
+    }
+}
