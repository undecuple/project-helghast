+/* Patch 2084 diagnostic, LD_POST_WB_DIAG=N (frames per report, 1 = 60): which SPU DMA reads (GETs) of a
+ * live surface's guest bytes saw the RSX's last write. Per surface record and report window: GPU writes
+ * (draw/clear/copy/blit/resolve notes), write-backs to guest memory, and the SPU GETs that overlapped it,
+ * split at the moment of the GET into fresh (no GPU write since the last write-back), stale (the GPU wrote
+ * since the last write-back; an earlier one ran), never (the GPU wrote; no write-back ever ran on this
+ * record) and nogpu (the record was never drawn to). Local surfaces count too (the sync-point write-back
+ * of patch 2017 covers main memory only). Off: the SPU read hook is not even installed (cellGcmSys.c). */
+static int g_ld_pwd = -1;
+static volatile LONG g_ld_pwd_get[MAX_SURFACES][4];
+static u32 g_ld_pwd_gpu[MAX_SURFACES], g_ld_pwd_wb[MAX_SURFACES];
+static u32 g_ld_pwd_gpu_life[MAX_SURFACES], g_ld_pwd_wb_life[MAX_SURFACES], g_ld_pwd_key[MAX_SURFACES];
+static u32 g_ld_pwd_frames, g_ld_pwd_lines;
+static int ld_pwd_enabled(void)
+{
+    if (g_ld_pwd < 0) { const char* e = getenv("LD_POST_WB_DIAG"); g_ld_pwd = e ? atoi(e) : 0; if (g_ld_pwd == 1) g_ld_pwd = 60; }
+    return g_ld_pwd > 0;
+}
+static void ld_pwd_rekey(u32 i)   /* a reused record starts over */
+{
+    const u32 key = g.surfaces[i].offset ^ (g.surfaces[i].location << 31) ^ (g.surfaces[i].w << 16) ^ g.surfaces[i].h;
+    if (g_ld_pwd_key[i] == key) return;
+    g_ld_pwd_key[i] = key; g_ld_pwd_gpu_life[i] = g_ld_pwd_wb_life[i] = 0;
+}
+static void ld_pwd_note_gpu_write(u32 i)
+{
+    if (!ld_pwd_enabled()) return;
+    ld_pwd_rekey(i); g_ld_pwd_gpu[i]++; g_ld_pwd_gpu_life[i]++;
+}
+static void ld_pwd_note_writeback(u32 i)
+{
+    if (!ld_pwd_enabled()) return;
+    ld_pwd_rekey(i); g_ld_pwd_wb[i]++; g_ld_pwd_wb_life[i]++;
+}
+/* Any thread (SPU DMA): reads only; the counters are atomic. */
+void rsx_live_draw_note_spu_read(u32 location, u32 offset, u32 size)
+{
+    if (!ld_pwd_enabled() || !size) return;
+    const u64 r0 = offset, r1 = r0 + size;
+    const u32 n = g.n_surfaces < MAX_SURFACES ? g.n_surfaces : MAX_SURFACES;
+    for (u32 i = 0; i < n; i++) {
+        const surface_t* sf = &g.surfaces[i];
+        if (!sf->tex || sf->location != location || !sf->w || !sf->h) continue;
+        const u32 texel = sf->fmt == DXGI_FORMAT_R16G16B16A16_FLOAT ? 8u : 4u;
+        const u32 gp = sf->pitch ? sf->pitch : sf->w * texel;
+        const u64 s0 = sf->offset, s1 = s0 + (u64)gp * (sf->h - 1u) + (u64)sf->w * texel;
+        if (!(s0 < r1 && r0 < s1)) continue;
+        const int k = !g_ld_pwd_gpu_life[i] ? 3 : !sf->gv_gpu_dirty ? 0 : g_ld_pwd_wb_life[i] ? 1 : 2;
+        InterlockedIncrement(&g_ld_pwd_get[i][k]);
+    }
+}
+static void ld_pwd_flip(void)
+{
+    if (!ld_pwd_enabled() || ++g_ld_pwd_frames % (u32)g_ld_pwd) return;
+    for (u32 i = 0; i < MAX_SURFACES && i < g.n_surfaces; i++) {
+        LONG c[4];
+        for (int k = 0; k < 4; k++) c[k] = InterlockedExchange(&g_ld_pwd_get[i][k], 0);
+        const surface_t* sf = &g.surfaces[i];
+        if ((c[0] | c[1] | c[2] | c[3]) && g_ld_pwd_lines < 4000) {
+            g_ld_pwd_lines++;
+            fprintf(stderr, "[post-wb] f%u surf %u:0x%08X %ux%u fmt=%d pitch=%u gpu=%u wb=%u life gpu=%u wb=%u "
+                    "spu_get fresh=%ld stale=%ld never=%ld nogpu=%ld dirty_now=%u\n",
+                    g_ld_pwd_frames, sf->location, sf->offset, sf->w, sf->h, (int)sf->fmt, sf->pitch,
+                    g_ld_pwd_gpu[i], g_ld_pwd_wb[i], g_ld_pwd_gpu_life[i], g_ld_pwd_wb_life[i],
+                    (long)c[0], (long)c[1], (long)c[2], (long)c[3], (u32)sf->gv_gpu_dirty);
+        }
+        g_ld_pwd_gpu[i] = g_ld_pwd_wb[i] = 0;
+    }
+}
