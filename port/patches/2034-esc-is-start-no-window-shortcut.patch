KZ3 patch 2034: Esc is the pad's START, not a window-destroy shortcut (RSX pass 35: Esc should open
the menu). Both window procedures (null backend, which hosts the live-draw swapchain, and the D3D12 backend)
destroyed the window on Esc and set window_closed; kz3.exe then kept running without a window. Esc now goes
through cellPad.c's keyboard map as CELL_PAD_CTRL_START (Enter stays START), so in game it opens the pause menu
and in menus it does what the game's START does. Closing the window stays WM_CLOSE (X button, Alt+F4, a scripted
WM_CLOSE); port/kz3/main.cpp turns window_closed into a clean shutdown (live-draw shutdown, log flush, exit 0).
Upstream candidate: a title cannot use Esc while the backend eats it, and an accidental Esc ends the session.

Rebased on ps3recomp v0.19.0 (shared v0.19 group C): upstream #612 (24c702ae) made the keyboard fallback portable (PADKEY_* per source: XInput, macOS, SDL); Esc is PADKEY_ESCAPE in each, and the Vulkan backend's SDL Esc-to-quit goes too.

diff --git a/libs/input/cellPad.c b/libs/input/cellPad.c
index 5f8a2fa2..bdbe0162 100644
--- a/libs/input/cellPad.c
+++ b/libs/input/cellPad.c
@@ -205,7 +205,7 @@ static void pad_rumble_levels(u8 small_on, u8 large, u16* lo, u16* hi)
  * disable it entirely.
  *
  * Arrows = d-pad, Z/X/A/S = cross/circle/square/triangle, Q/W = L1/R1,
- * 1/2 = L2/R2, Enter = START, Tab = SELECT. The left stick mirrors the d-pad
+ * 1/2 = L2/R2, Enter and Esc = START, Tab = SELECT. The left stick mirrors the d-pad
  * so a title that reads the stick instead is playable too.
  *
  * Where the keys come from: GetAsyncKeyState with the XInput backend; on macOS
@@ -237,6 +237,7 @@ static int pad_key_down(int key) { return (GetAsyncKeyState(key) & 0x8000) != 0;
 #define PADKEY_2 '2'
 #define PADKEY_RETURN VK_RETURN
 #define PADKEY_TAB VK_TAB
+#define PADKEY_ESCAPE VK_ESCAPE
 #elif defined(__APPLE__) && !defined(PS3RECOMP_PAD_KEYBOARD_SDL)
 /* macOS: virtual key codes (Carbon HIToolbox/Events.h kVK_*), polled with CGEventSourceKeyState,
  * which needs no event tap and no window. "Focused" is NSApplication.isActive of this process,
@@ -273,6 +274,7 @@ static int pad_key_down(int key)
 #define PADKEY_2 19
 #define PADKEY_RETURN 36
 #define PADKEY_TAB 48
+#define PADKEY_ESCAPE 53
 #elif PAD_BACKEND_SDL2
 /* Everywhere else the keyboard is SDL's: scancodes are physical keys, like the macOS codes above. The state is kept
  * current by whoever pumps SDL's events (the window of the RSX backend); without a video subsystem nothing is ever
@@ -299,6 +301,7 @@ static int pad_key_down(int key)
 #define PADKEY_2 SDL_SCANCODE_2
 #define PADKEY_RETURN SDL_SCANCODE_RETURN
 #define PADKEY_TAB SDL_SCANCODE_TAB
+#define PADKEY_ESCAPE SDL_SCANCODE_ESCAPE
 #endif
 
 static void pad_poll_keyboard(void)
@@ -318,6 +321,8 @@ static void pad_poll_keyboard(void)
         return;
     }
 
+    /* KZ3 patch 2034: Esc = START too, so Esc opens the pause menu in game and acts as the game's own
+     * back/resume in menus (the window procedures no longer close the window on Esc). */
     static const struct { int vk; u16 btn; } map[] = {
         { PADKEY_UP,     CELL_PAD_CTRL_UP },      { PADKEY_DOWN,  CELL_PAD_CTRL_DOWN },
         { PADKEY_LEFT,   CELL_PAD_CTRL_LEFT },    { PADKEY_RIGHT, CELL_PAD_CTRL_RIGHT },
@@ -326,6 +331,7 @@ static void pad_poll_keyboard(void)
         { PADKEY_Q,      CELL_PAD_CTRL_L1 },      { PADKEY_W,     CELL_PAD_CTRL_R1 },
         { PADKEY_1,      CELL_PAD_CTRL_L2 },      { PADKEY_2,     CELL_PAD_CTRL_R2 },
         { PADKEY_RETURN, CELL_PAD_CTRL_START },   { PADKEY_TAB,   CELL_PAD_CTRL_SELECT },
+        { PADKEY_ESCAPE, CELL_PAD_CTRL_START },
     };
 
     u16 btns = 0;
