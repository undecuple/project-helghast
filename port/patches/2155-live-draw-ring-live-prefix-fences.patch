--- a/libs/video/rsx_ring_marks.h
+++ b/libs/video/rsx_ring_marks.h
@@ -63,3 +63,17 @@
+/* Patch 2155: cached descriptors and delayed constant bindings can read an earlier allocation in a
+ * later command list, even when used is unchanged. Conservatively retain the whole allocated current
+ * prefix through every submit. Old-generation tails remain protected by their original marks.
+ * This avoids per-draw tracking at the cost of potentially longer waits than exact per-use marks. */
+static inline int rsx_rm_submit_live(rsx_ring_marks* m, uint64_t used, uint64_t fence)
+{
+    const int result = rsx_rm_submit(m, used, fence);
+    if (m->cur_end) {
+        m->cur[0].start = 0; m->cur[0].end = m->cur_end; m->cur[0].fence = m->last_fence;
+        m->cur_n = 1;
+    }
+    return result;
+}
+
 /* The cursor restarts at 0. The caller has submitted the open list first (so every byte written is marked).
  * New old list = this generation's marks + the old marks beyond where this generation reached. */
 static inline void rsx_rm_wrap(rsx_ring_marks* m)
