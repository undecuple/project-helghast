+/* ---- KZ3 patch 1071 (SPU pass 56): SPU extended-range singles on the lanes the host gets wrong ----
+ * The SPU single-precision unit is not IEEE (SPU ISA v1.2 section 9.1): biased exponent 255 is an ordinary binade
+ * (no Inf/NaN, Smax = 0x7FFFFFFF), exponent 0 is zero, results truncate and saturate at +-Smax. The host ops below
+ * read an exponent-255 word as Inf/NaN, so e.g. the normalise idiom x * fi(x, frsqest(x)) with x = 0 gives NaN here
+ * (frsqest(0) = exponent 255, fi keeps it, 0 * that = NaN) where the SPU gives 0. KZ3 met it twice: the TextureStreaming
+ * job's NaN scores (pass 55) and the animation job job_011c8080's bone matrices 0x7FF50000/0xFFF50000 (pass 56, the
+ * K2 Hammer camera). This patch keeps every existing fast path and its rounding, and only recomputes a lane exactly
+ * when an operand or the host result has exponent 255; the exact lane code is NoahBPeterson's from
+ * sp00nznet/ps3recomp PR #287 ("spu: hardware-exact float semantics", spu__sf_pack/split/sum, fa/fm/fma lanes, the key
+ * compares, cflts lanes and the integer fi), used here only on those lanes. g_kz3_spu_xr = 0 (KZ3_SPU_XR=0) keeps the
+ * host results (A/B); it is read only when such a lane occurs. */
+extern int g_kz3_spu_xr;
+#if defined(__SSE2__)
+#include <emmintrin.h>
+#endif
+static inline uint32_t spu__sf_pack(uint32_t sign, unsigned __int128 sig, int e2) {
+    const uint64_t hi = (uint64_t)(sig >> 64), lo = (uint64_t)sig;
+    const int top = hi ? 127 - __builtin_clzll(hi) : 63 - __builtin_clzll(lo);
+    const int biased = top + e2 + 127;
+    if (biased > 255) return sign | 0x7FFFFFFFu;
+    if (biased < 1)   return 0;
+    const uint32_t m24 = top >= 23 ? (uint32_t)(sig >> (top - 23)) : (uint32_t)(sig << (23 - top));
+    return sign | ((uint32_t)biased << 23) | (m24 & 0x7FFFFFu);
+}
+static inline int spu__sf_split(uint32_t x, uint32_t* sig, int* e2) {
+    const uint32_t be = (x >> 23) & 0xFFu;
+    if (!be) return 0;
+    *sig = (x & 0x7FFFFFu) | 0x800000u;
+    *e2 = (int)be - 150;
+    return 1;
+}
+static inline uint32_t spu__sf_sum(uint32_t s1, uint64_t m1, int e1, uint32_t s2, uint64_t m2, int e2) {
+    if (e1 < e2) { uint32_t ts = s1; s1 = s2; s2 = ts; uint64_t tm = m1; m1 = m2; m2 = tm; int te = e1; e1 = e2; e2 = te; }
+    const int d = e1 - e2;
+    if (d > 79) {
+        if (s1 == s2) return spu__sf_pack(s1, m1, e1);
+        return spu__sf_pack(s1, ((unsigned __int128)m1 << 1) - 1, e1 - 1);
+    }
+    const unsigned __int128 a = (unsigned __int128)m1 << d, b = m2;
+    if (s1 == s2) return spu__sf_pack(s1, a + b, e2);
+    if (a == b) return 0;
+    return a > b ? spu__sf_pack(s1, a - b, e2) : spu__sf_pack(s2, b - a, e2);
+}
+static inline uint32_t spu__fa_lane(uint32_t x, uint32_t y) {
+    uint32_t mx, my; int ex, ey;
+    const int nx = spu__sf_split(x, &mx, &ex), ny = spu__sf_split(y, &my, &ey);
+    if (!nx) return ny ? y : 0;
+    if (!ny) return x;
+    return spu__sf_sum(x & 0x80000000u, mx, ex, y & 0x80000000u, my, ey);
+}
+static inline uint32_t spu__fm_lane(uint32_t x, uint32_t y) {
+    uint32_t mx, my; int ex, ey;
+    if (!spu__sf_split(x, &mx, &ex) || !spu__sf_split(y, &my, &ey)) return 0;
+    return spu__sf_pack((x ^ y) & 0x80000000u, (uint64_t)mx * my, ex + ey);
+}
+static inline uint32_t spu__fma_lane(uint32_t x, uint32_t y, uint32_t z, uint32_t negp, uint32_t negc) {
+    uint32_t mx, my, mz; int ex, ey, ez;
+    const int np = spu__sf_split(x, &mx, &ex) & spu__sf_split(y, &my, &ey);
+    const int nz = spu__sf_split(z, &mz, &ez);
+    const uint32_t sp = ((x ^ y) & 0x80000000u) ^ negp, sz = (z & 0x80000000u) ^ negc;
+    if (!np) return nz ? (sz | (z & 0x7FFFFFFFu)) : 0;
+    const uint64_t p = (uint64_t)mx * my;
+    if (!nz) return spu__sf_pack(sp, p, ex + ey);
+    return spu__sf_sum(sp, p, ex + ey, sz, mz, ez);
+}
+static inline int64_t spu__sf_key(uint32_t x) {
+    if (!(x & 0x7F800000u)) return 0;
+    const int64_t m = x & 0x7FFFFFFFu;
+    return (x & 0x80000000u) ? -m : m;
+}
+static inline int64_t spu__sf_mag(uint32_t x) { return (x & 0x7F800000u) ? (int64_t)(x & 0x7FFFFFFFu) : 0; }
+static inline uint32_t spu__cfl_lane(uint32_t x, int scale, int is_unsigned) {
+    uint32_t m; int e;
+    if (!spu__sf_split(x, &m, &e)) return 0;
+    const int sh = e + scale, neg = (x >> 31) != 0;
+    if (is_unsigned) {
+        if (neg) return 0;
+        if (sh >= 9) return 0xFFFFFFFFu;
+        return sh >= 0 ? m << sh : (sh <= -24 ? 0 : m >> -sh);
+    }
+    if (sh >= 8) return neg ? 0x80000000u : 0x7FFFFFFFu;
+    const uint32_t v = sh >= 0 ? m << sh : (sh <= -24 ? 0 : m >> -sh);
+    return neg ? 0u - v : v;
+}
+/* PR #287's integer fi (ISA p. 219), used for an exponent-255 estimate. */
+static inline uint32_t spu__fi_lane(uint32_t ra, uint32_t est) {
+    const uint32_t sign = est & 0x80000000u;
+    int exp = (int)((est >> 23) & 0xFFu);
+    const uint64_t base = (est >> 10) & 0x1FFFu, step = est & 0x3FFu, y = ra & 0x7FFFFu;
+    if (exp == 0) return 0;
+    uint64_t m = ((((uint64_t)1 << 13) | base) << 19) - step * y;
+    if (m < ((uint64_t)1 << 32)) { m <<= 1; if (--exp == 0) return 0; }
+    return sign | ((uint32_t)exp << 23) | (uint32_t)((m >> 9) & 0x7FFFFFu);
+}
+/* Bit i set when word i has biased exponent 255. */
+static inline unsigned spu__xr_mask(u128 v) {
+#if defined(__SSE2__)
+    __m128i V; memcpy(&V, &v, 16);
+    const __m128i e = _mm_set1_epi32(0x7F800000);
+    return (unsigned)_mm_movemask_ps(_mm_castsi128_ps(_mm_cmpeq_epi32(_mm_and_si128(V, e), e)));
+#else
+    unsigned m = 0; for (int i = 0; i < 4; i++) m |= ((v._u32[i] & 0x7F800000u) == 0x7F800000u) << i; return m;
+#endif
+}
+#define SPU_XR_FIXM(mask, r, a, b, expr) do { const unsigned _m = (mask); \
+    if (__builtin_expect(_m != 0, 0) && g_kz3_spu_xr) for (int _i = 0; _i < 4; _i++) if (_m >> _i & 1) { \
+        const uint32_t x = (a)._u32[_i], y = (b)._u32[_i]; (void)x; (void)y; (r)._u32[_i] = (expr); } } while (0)
+/* float result: an exponent-255 operand or result lane is recomputed */
+#define SPU_XR_FIX2(r, a, b, expr) SPU_XR_FIXM(spu__xr_mask(a) | spu__xr_mask(b) | spu__xr_mask(r), r, a, b, expr)
