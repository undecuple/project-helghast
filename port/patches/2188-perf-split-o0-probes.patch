+/* KZ3 patch 2188 (command-thread overhaul O0): the shared walker-split line and the O0 live counters. Pure C (no OS calls,
+ * time is passed in), so tools/smoke builds and tests it on the host. Everything is default off:
+ *   RSX_PERF_SPLIT=1  [perf-split] (the line format is shared with the Killzone 2 port): exclusive buckets that add up to the
+ *                     walker's pass time. A stack of "which bucket owns the clock" charges every tick to the innermost
+ *                     open bucket, so nesting never double-counts and the buckets sum to walk by construction; the time
+ *                     with no bucket open is `other`, printed so a missing timer shows up.
+ *   RSX_O0=1          the O0 counters ([o0-state], [o0-4b], [o0-ref], [o0-seg], [o0-tex], [o0-tex-src], [o0-wbov]).
+ * The instance (g_rsx_o0) lives in cellGcmSys.c. */
+#ifndef RSX_O0_H
+#define RSX_O0_H
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+/* ---- exclusive buckets -------------------------------------------------------------------------------------------- */
+enum {
+    RSX_SB_OTHER = 0,      /* no bucket open: lock, pass entry/exit, and the whole pass when the split is off */
+    RSX_SB_DECODE_F,       /* CG side: the FIFO word loop in cellGcmSys.c, header parse, legacy gcm_3d_method */
+    RSX_SB_DECODE_D,       /* dispatch: rsx_dispatch_method, minus the sink callbacks it calls */
+    RSX_SB_TEX,            /* the texture loop (binds, hash, decode, upload) */
+    RSX_SB_PSO,            /* get_pso, translation included */
+    RSX_SB_DESC,           /* descriptors: SRV/sampler tables, barriers, RTV/DSV, SetDescriptorHeaps */
+    RSX_SB_VPLAN,          /* the vertex plan: layout, refs, remap */
+    RSX_SB_FILL,           /* vertex fetch/convert, ring copy, index write, constant uploads */
+    RSX_SB_REC,            /* D3D12 list calls of a draw (viewport .. DrawIndexedInstanced) */
+    RSX_SB_WB,             /* write-back stores, NV0039/NV3089 moves */
+    RSX_SB_RBWAIT,         /* fence waits of readback flushes */
+    RSX_SB_SUBMIT,         /* ExecuteCommandLists + Signal */
+    RSX_SB_PARK,           /* the walker waiting for FIFO work */
+    RSX_SB_NAMED,          /* first bucket that folds into `other` in the shared line */
+    RSX_SB_X_PRE = RSX_SB_NAMED, RSX_SB_X_SURF, RSX_SB_X_POST,   /* the unnamed parts of one draw */
+    RSX_SB_X_DRAW,         /* sink_end outside every named bucket and X_PRE/SURF/POST */
+    RSX_SB_X_CLEAR, RSX_SB_X_FLIP, RSX_SB_X_REPORT, RSX_SB_X_SINK,   /* other sink callbacks; FLIP = sink_flip (present) */
+    RSX_SB_X_SEMA,         /* NV406E semaphore commands (the write-back inside them is WB) */
+    RSX_SB_X_FLIPW,        /* the in-FIFO 0xFEADxxxx flip word */
+    RSX_SB_X_WAITO,        /* fence waits of flushes that are not readbacks */
+    RSX_SB_N
+};
+#define RSX_SPLIT_DEPTH 24
+
+typedef struct {
+    long long acc[RSX_SB_N];   /* ticks of this pass (flushed to the global counters at the pass end) */
+    long long last;
+    int cur, sp;
+    int stk[RSX_SPLIT_DEPTH];
+    unsigned long long unwound, overflow;
+} rsx_split;
+
+static inline void rsx_split_begin(rsx_split* s, long long now)
+{
+    memset(s->acc, 0, sizeof s->acc);
+    s->last = now; s->cur = RSX_SB_OTHER; s->sp = 0;
+}
+static inline void rsx_split_charge(rsx_split* s, long long now)
+{
+    s->acc[s->cur] += now - s->last; s->last = now;
+}
+/* Open bucket b; the returned token is passed to pop (0 = nothing opened). */
+static inline int rsx_split_push(rsx_split* s, int b, long long now)
+{
+    if (s->sp >= RSX_SPLIT_DEPTH) { s->overflow++; return 0; }
+    rsx_split_charge(s, now);
+    s->stk[s->sp++] = s->cur; s->cur = b;
+    return s->sp;
+}
+/* Close the bucket opened with `tok`, and anything opened after it that was never closed (an early return). A token that
+ * was already unwound (tok > sp) is ignored. */
+static inline void rsx_split_pop(rsx_split* s, int tok, long long now)
+{
+    if (tok <= 0 || tok > s->sp) return;
+    rsx_split_charge(s, now);
+    if (s->sp > tok) s->unwound += (unsigned long long)(s->sp - tok);
+    s->sp = tok - 1; s->cur = s->stk[s->sp];
+}
+/* Set the bucket that owns the clock when nothing is open (the walker loop's own work = DECODE_F). */
+static inline void rsx_split_base(rsx_split* s, int b, long long now)
+{
+    rsx_split_charge(s, now);
+    if (s->sp) { s->unwound += (unsigned long long)s->sp; s->sp = 0; }
+    s->cur = b;
+}
+static inline void rsx_split_end(rsx_split* s, long long now) { rsx_split_charge(s, now); s->sp = 0; s->cur = RSX_SB_OTHER; }
+static inline long long rsx_split_total(const rsx_split* s)
+{
+    long long t = 0; for (int i = 0; i < RSX_SB_N; i++) t += s->acc[i]; return t;
+}
+
+/* ---- the [perf-split] line ---------------------------------------------------------------------------------------- */
+/* One window's values in ms per flip. b[] is indexed by RSX_SB_*; the line folds decode_f + decode_d into `decode` and
+ * every bucket from RSX_SB_NAMED up, plus the base, into `other` = walk - the named buckets (so it also absorbs what no
+ * timer covers). gpu < 0 prints -1 (no GPU poller). `bar` < 0 leaves bar= out (the ordered-thread line). */
+static inline double rsx_split_named_sum(const double* b)
+{
+    double s = 0;
+    for (int i = RSX_SB_DECODE_F; i < RSX_SB_NAMED; i++) s += b[i];
+    return s;
+}
+static inline int rsx_split_fmt(char* out, size_t n, const char* tag, double t, long long flips, double frame, double walk,
+                                const double* b, double gpu, double bar)
+{
+    const double decode = b[RSX_SB_DECODE_F] + b[RSX_SB_DECODE_D];
+    const double other = walk - rsx_split_named_sum(b);
+    int o = snprintf(out, n,
+        "[%s] t=%.0f flips=%lld frame=%.2f walk=%.2f decode=%.2f tex=%.2f pso=%.2f desc=%.2f vplan=%.2f fill=%.2f rec=%.2f"
+        " wb=%.2f rbwait=%.2f submit=%.2f park=%.2f other=%.2f gpu=%.2f",
+        tag, t, flips, frame, walk, decode, b[RSX_SB_TEX], b[RSX_SB_PSO], b[RSX_SB_DESC], b[RSX_SB_VPLAN], b[RSX_SB_FILL],
+        b[RSX_SB_REC], b[RSX_SB_WB], b[RSX_SB_RBWAIT], b[RSX_SB_SUBMIT], b[RSX_SB_PARK], other, gpu);
+    if (bar >= 0 && o > 0 && (size_t)o < n) o += snprintf(out + o, n - (size_t)o, " bar=%.2f", bar);
+    return o;
+}
+/* The two extra lines: decode split, and what is inside `other`. */
+static inline int rsx_split_fmt_d(char* out, size_t n, double t, const double* b)
+{
+    return snprintf(out, n, "[perf-split-d] t=%.0f decode_f=%.2f decode_d=%.2f", t, b[RSX_SB_DECODE_F], b[RSX_SB_DECODE_D]);
+}
+static inline int rsx_split_fmt_o(char* out, size_t n, double t, const double* b, unsigned long long unwound,
+                                  unsigned long long overflow)
+{
+    return snprintf(out, n,
+        "[perf-split-o] t=%.0f base=%.2f pre=%.2f surf=%.2f post=%.2f draw_rest=%.2f clear=%.2f flip=%.2f report=%.2f sink=%.2f"
+        " sema=%.2f flipword=%.2f wait_other=%.2f unwound=%llu overflow=%llu",
+        t, b[RSX_SB_OTHER], b[RSX_SB_X_PRE], b[RSX_SB_X_SURF], b[RSX_SB_X_POST], b[RSX_SB_X_DRAW], b[RSX_SB_X_CLEAR],
+        b[RSX_SB_X_FLIP], b[RSX_SB_X_REPORT], b[RSX_SB_X_SINK], b[RSX_SB_X_SEMA], b[RSX_SB_X_FLIPW], b[RSX_SB_X_WAITO],
+        unwound, overflow);
+}
+
+/* ---- the O0 counters ---------------------------------------------------------------------------------------------- */
+enum { RSX_O0_RK_RENDERER = 0, RSX_O0_RK_NV0039, RSX_O0_RK_N };
+#define RSX_O0_PASSES 64
+#define RSX_O0_WBR 64
+#define RSX_O0_TEXN 2048   /* texture source table (power of two) */
+typedef struct { unsigned long long key, binds, hashed, changed, written; } rsx_o0_tsrc;
+typedef struct { unsigned loc, off, end, flip, mask; int live, idx3; } rsx_o0_wbr;
+#define RSX_O0_IDX3 0x01892400u   /* post-chain surface idx3 (re-data E1: read by Upsample add and DoF when far DoF is on) */
+
+typedef struct rsx_o0 {
+    volatile int on;
+    volatile int lock;
+    /* legacy s_state reader probe */
+    long long m3d, m3d_legacy, be_flush, be_draw, be_clear; int be_seen, legacy_live;
+    /* 0x4B release */
+    long long q_n, q_idle, q_unk, q_backlog_sum, q_backlog_max, q_lag_n, q_lag_sum, q_lag_max, q_per_n, q_per_sum, q_last_t;
+    struct { long long t; unsigned put; } pass[RSX_O0_PASSES]; unsigned pass_n;
+    /* ref queue and reports */
+    long long ref_push, ref_depth_sum, ref_depth_max, ref_over, ref_pub, ref_pub_sum;
+    long long rep_n, rep_zpass, rep_real, rep_real_ne, rep_dflt;
+    /* segments and ring recycle */
+    long long seg_calls, seg_acted, ring_drain, ring_cb;
+    /* textures */
+    long long t_binds[2], t_hashed[2], t_changed[2], t_written[2][2];   /* [loc]; t_written[loc][changed] = tracker flagged */
+    rsx_o0_tsrc tsrc[RSX_O0_TEXN];
+    /* write-back destinations vs later reads */
+    unsigned flip_n; rsx_o0_wbr wb[RSX_O0_WBR]; unsigned wb_i;
+    long long wb_stores, wb_bytes, wb_stores_read, wb_stores_never, wb_idx3, rd_idx3[RSX_O0_RK_N], rd_n[RSX_O0_RK_N], rd_ov[RSX_O0_RK_N], rd_ov_age[RSX_O0_RK_N][3];
+} rsx_o0;
+
+static inline void rsx_o0_lock(rsx_o0* o) { while (__atomic_exchange_n(&o->lock, 1, __ATOMIC_ACQUIRE)) { } }
+static inline void rsx_o0_unlock(rsx_o0* o) { __atomic_store_n(&o->lock, 0, __ATOMIC_RELEASE); }
+#define RSX_O0_ADD(f, v) __atomic_fetch_add(&(f), (long long)(v), __ATOMIC_RELAXED)
+
+static inline void rsx_o0_max(long long* f, long long v)
+{
+    long long c = __atomic_load_n(f, __ATOMIC_RELAXED);
+    while (v > c && !__atomic_compare_exchange_n(f, &c, v, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) { }
+}
+
+/* A walker pass starts with this put (called once per pass). */
+static inline void rsx_o0_pass(rsx_o0* o, unsigned put, long long now)
+{
+    const unsigned i = o->pass_n++ % RSX_O0_PASSES;
+    o->pass[i].t = now; o->pass[i].put = put;
+}
+/* The label 0x4B release was written at FIFO offset `at` (the command's own offset), `next` the get after it, `put` the
+ * live PUT register. Idle-at-put = the walker has caught up with put right after the write (backlog 0). The release lag
+ * is the time since the first pass whose put had already passed `at` (ASSUMPTION: the pass ring has not wrapped; a put
+ * that wrapped is not newer than `at` and ends the scan, so the lag can only be short, never long). */
+static inline void rsx_o0_q4b(rsx_o0* o, unsigned at, unsigned next, unsigned put, long long now)
+{
+    RSX_O0_ADD(o->q_n, 1);
+    if (put >= next) {
+        const long long bl = (long long)(put - next);
+        if (bl == 0) RSX_O0_ADD(o->q_idle, 1);
+        RSX_O0_ADD(o->q_backlog_sum, bl); rsx_o0_max(&o->q_backlog_max, bl);
+    } else RSX_O0_ADD(o->q_unk, 1);
+    long long t_vis = -1;
+    for (unsigned k = 0; k < RSX_O0_PASSES && k < o->pass_n; k++) {
+        const unsigned i = (o->pass_n - 1u - k) % RSX_O0_PASSES;
+        if (o->pass[i].put > at) t_vis = o->pass[i].t; else break;
+    }
+    if (t_vis >= 0 && now >= t_vis) { RSX_O0_ADD(o->q_lag_n, 1); RSX_O0_ADD(o->q_lag_sum, now - t_vis); rsx_o0_max(&o->q_lag_max, now - t_vis); }
+    if (o->q_last_t) { RSX_O0_ADD(o->q_per_n, 1); RSX_O0_ADD(o->q_per_sum, now - o->q_last_t); }
+    o->q_last_t = now;
+}
+
+/* Texture sources: key = (location, offset). */
+static inline rsx_o0_tsrc* rsx_o0_tfind(rsx_o0* o, unsigned loc, unsigned off)
+{
+    const unsigned long long key = ((unsigned long long)(loc & 1u) << 32 | off) + 1ull;
+    unsigned h = (unsigned)((key * 0x9E3779B97F4A7C15ull) >> 40) & (RSX_O0_TEXN - 1u);
+    for (unsigned k = 0; k < RSX_O0_TEXN; k++, h = (h + 1u) & (RSX_O0_TEXN - 1u)) {
+        if (o->tsrc[h].key == key) return &o->tsrc[h];
+        if (!o->tsrc[h].key) { o->tsrc[h].key = key; return &o->tsrc[h]; }
+    }
+    return NULL;   /* full: only the per-location totals still count */
+}
+static inline void rsx_o0_tex_bind(rsx_o0* o, unsigned loc, unsigned off)
+{
+    rsx_o0_lock(o);
+    o->t_binds[loc & 1u]++;
+    rsx_o0_tsrc* e = rsx_o0_tfind(o, loc, off); if (e) e->binds++;
+    rsx_o0_unlock(o);
+}
+/* A content hash was computed for this bind; `written` = the write tracker had flagged the texture, `changed` = the hash
+ * differs from the cached one. */
+static inline void rsx_o0_tex_hash(rsx_o0* o, unsigned loc, unsigned off, int changed, int written)
+{
+    rsx_o0_lock(o);
+    o->t_hashed[loc & 1u]++;
+    if (changed) o->t_changed[loc & 1u]++;
+    o->t_written[loc & 1u][changed ? 1 : 0] += written ? 1 : 0;
+    rsx_o0_tsrc* e = rsx_o0_tfind(o, loc, off);
+    if (e) { e->hashed++; e->changed += changed ? 1u : 0u; e->written += written ? 1u : 0u; }
+    rsx_o0_unlock(o);
+}
+/* Top n sources by hashed count; clears the table. Returns the number of lines written to out. */
+static inline int rsx_o0_tsrc_top(rsx_o0* o, char* out, size_t n, double t, int top)
+{
+    rsx_o0_lock(o);
+    int o_n = snprintf(out, n, "[o0-tex-src] t=%.0f", t);
+    for (int r = 0; r < top; r++) {
+        int best = -1;
+        for (int i = 0; i < RSX_O0_TEXN; i++)
+            if (o->tsrc[i].key && (best < 0 || o->tsrc[i].hashed > o->tsrc[best].hashed)) best = i;
+        if (best < 0 || !o->tsrc[best].hashed || o_n < 0 || (size_t)o_n >= n) break;
+        const unsigned long long k = o->tsrc[best].key - 1ull;
+        o_n += snprintf(out + o_n, n - (size_t)o_n, " %u:0x%08X=%llu/%llu/%llu", (unsigned)(k >> 32), (unsigned)k,
+                        o->tsrc[best].hashed, o->tsrc[best].changed, o->tsrc[best].written);
+        o->tsrc[best].hashed = 0;   /* printed: out of the next round of this scan */
+    }
+    memset(o->tsrc, 0, sizeof o->tsrc);
+    rsx_o0_unlock(o);
+    return o_n;
+}
+
+/* Write-back stores and the reads that overlap them later. A read is overlapping when a store of the last 64 overlaps its
+ * (location, range); age = flips between the store and the read (0, 1, 2+). A store is "read" once any read overlapped it
+ * and "never" when its slot is reused unread. SPU/PPU reads of the destination are LD_WB_READ's job (patch 2184). */
+static inline void rsx_o0_wb_store(rsx_o0* o, unsigned loc, unsigned off, unsigned bytes)
+{
+    rsx_o0_lock(o);
+    rsx_o0_wbr* w = &o->wb[o->wb_i++ % RSX_O0_WBR];
+    if (w->live) { if (w->mask) o->wb_stores_read++; else o->wb_stores_never++; }
+    w->loc = loc & 1u; w->off = off; w->end = off + bytes; w->flip = o->flip_n; w->mask = 0; w->live = 1; w->idx3 = off <= RSX_O0_IDX3 && RSX_O0_IDX3 < off + bytes; o->wb_idx3 += w->idx3;
+    o->wb_stores++; o->wb_bytes += bytes;
+    rsx_o0_unlock(o);
+}
+static inline void rsx_o0_read(rsx_o0* o, int kind, unsigned loc, unsigned off, unsigned bytes)
+{
+    if (kind < 0 || kind >= RSX_O0_RK_N || !bytes) return;
+    const unsigned end = off + bytes;
+    rsx_o0_lock(o);
+    o->rd_n[kind]++;
+    int hit = 0; unsigned age = 0;
+    for (unsigned i = 0; i < RSX_O0_WBR; i++) {
+        rsx_o0_wbr* w = &o->wb[i];
+        if (!w->live || w->loc != (loc & 1u) || off >= w->end || end <= w->off) continue;
+        w->mask |= 1u << kind;
+        if (w->idx3) o->rd_idx3[kind]++;   /* a read of a write-back range that holds idx3 */
+        if (!hit) age = o->flip_n - w->flip; else if (o->flip_n - w->flip < age) age = o->flip_n - w->flip;
+        hit = 1;
+    }
+    if (hit) { o->rd_ov[kind]++; o->rd_ov_age[kind][age > 2 ? 2 : age]++; }
+    rsx_o0_unlock(o);
+}
+
+/* ---- the O0 lines (deltas of one period; `p` = the previous snapshot, filled by the caller with a plain copy) ----------- */
+static inline double rsx_o0_div(long long a, long long b) { return b > 0 ? (double)a / (double)b : 0.0; }
+static inline int rsx_o0_fmt_state(char* out, size_t n, double t, const rsx_o0* c, const rsx_o0* p)
+{
+    return snprintf(out, n, "[o0-state] t=%.0f m3d=%lld legacy_calls=%lld legacy_live=%d backend_set=%d be_flush=%lld be_draw=%lld be_clear=%lld",
+                    t, c->m3d - p->m3d, c->m3d_legacy - p->m3d_legacy, c->legacy_live, c->be_seen, c->be_flush - p->be_flush,
+                    c->be_draw - p->be_draw, c->be_clear - p->be_clear);
+}
+static inline int rsx_o0_fmt_4b(char* out, size_t n, double t, double tk, const rsx_o0* c, const rsx_o0* p)
+{
+    const long long N = c->q_n - p->q_n, I = c->q_idle - p->q_idle;
+    return snprintf(out, n,
+        "[o0-4b] t=%.0f writes=%lld idle_at_put=%lld idle_frac=%.2f backlog_mean=%.0fB backlog_max=%lldB put_behind=%lld"
+        " lag_n=%lld lag_mean=%.2fms lag_max=%.2fms period_mean=%.2fms",
+        t, N, I, rsx_o0_div(I, N), rsx_o0_div(c->q_backlog_sum - p->q_backlog_sum, N - (c->q_unk - p->q_unk)), c->q_backlog_max,
+        c->q_unk - p->q_unk, c->q_lag_n - p->q_lag_n, rsx_o0_div(c->q_lag_sum - p->q_lag_sum, c->q_lag_n - p->q_lag_n) * tk,
+        (double)c->q_lag_max * tk, rsx_o0_div(c->q_per_sum - p->q_per_sum, c->q_per_n - p->q_per_n) * tk);
+}
+static inline int rsx_o0_fmt_ref(char* out, size_t n, double t, const rsx_o0* c, const rsx_o0* p)
+{
+    return snprintf(out, n,
+        "[o0-ref] t=%.0f push=%lld depth_mean=%.2f depth_max=%lld overflow=%lld published=%lld pub_depth_mean=%.2f"
+        " reports=%lld zpass=%lld answered_real=%lld real_differs=%lld answered_default=%lld",
+        t, c->ref_push - p->ref_push, rsx_o0_div(c->ref_depth_sum - p->ref_depth_sum, c->ref_push - p->ref_push),
+        c->ref_depth_max, c->ref_over - p->ref_over, c->ref_pub - p->ref_pub,
+        rsx_o0_div(c->ref_pub_sum - p->ref_pub_sum, c->ref_pub - p->ref_pub), c->rep_n - p->rep_n, c->rep_zpass - p->rep_zpass,
+        c->rep_real - p->rep_real, c->rep_real_ne - p->rep_real_ne, c->rep_dflt - p->rep_dflt);
+}
+static inline int rsx_o0_fmt_seg(char* out, size_t n, double t, const rsx_o0* c, const rsx_o0* p)
+{
+    return snprintf(out, n, "[o0-seg] t=%.0f next_segment=%lld acted=%lld title_ring_recycle_drain=%lld cb_recycle=%lld",
+                    t, c->seg_calls - p->seg_calls, c->seg_acted - p->seg_acted, c->ring_drain - p->ring_drain, c->ring_cb - p->ring_cb);
+}
+static inline int rsx_o0_fmt_tex(char* out, size_t n, double t, const rsx_o0* c, const rsx_o0* p)
+{
+    return snprintf(out, n,
+        "[o0-tex] t=%.0f loc0 binds=%lld hashed=%lld changed=%lld written_changed=%lld written_same=%lld"
+        " | loc1 binds=%lld hashed=%lld changed=%lld written_changed=%lld written_same=%lld",
+        t, c->t_binds[0] - p->t_binds[0], c->t_hashed[0] - p->t_hashed[0], c->t_changed[0] - p->t_changed[0],
+        c->t_written[0][1] - p->t_written[0][1], c->t_written[0][0] - p->t_written[0][0],
+        c->t_binds[1] - p->t_binds[1], c->t_hashed[1] - p->t_hashed[1], c->t_changed[1] - p->t_changed[1],
+        c->t_written[1][1] - p->t_written[1][1], c->t_written[1][0] - p->t_written[1][0]);
+}
+static inline int rsx_o0_fmt_wbov(char* out, size_t n, double t, const rsx_o0* c, const rsx_o0* p)
+{
