+        "[o0-wbov] t=%.0f wb_stores=%lld wb_bytes=%lld stores_read=%lld stores_never_read=%lld"
+        " idx3_stores=%lld idx3_read_by_renderer=%lld idx3_read_by_nv0039=%lld | renderer reads=%lld overlap=%lld age0/1/2+=%lld/%lld/%lld | nv0039 reads=%lld overlap=%lld age0/1/2+=%lld/%lld/%lld",
+        t, c->wb_stores - p->wb_stores, c->wb_bytes - p->wb_bytes, c->wb_stores_read - p->wb_stores_read,
+        c->wb_stores_never - p->wb_stores_never, c->wb_idx3 - p->wb_idx3, c->rd_idx3[0] - p->rd_idx3[0], c->rd_idx3[1] - p->rd_idx3[1],
+        c->rd_n[0] - p->rd_n[0], c->rd_ov[0] - p->rd_ov[0], c->rd_ov_age[0][0] - p->rd_ov_age[0][0],
+        c->rd_ov_age[0][1] - p->rd_ov_age[0][1], c->rd_ov_age[0][2] - p->rd_ov_age[0][2],
+        c->rd_n[1] - p->rd_n[1], c->rd_ov[1] - p->rd_ov[1], c->rd_ov_age[1][0] - p->rd_ov_age[1][0],
+        c->rd_ov_age[1][1] - p->rd_ov_age[1][1], c->rd_ov_age[1][2] - p->rd_ov_age[1][2]);
+}
