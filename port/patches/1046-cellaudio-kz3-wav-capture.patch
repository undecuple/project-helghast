KZ3 patch 1046 (SPU pass 34): KZ3_AUDIO_WAV=<file> writes the final cellAudio mix as a float32 WAV with a [audio-wav] start line (sample 0's host time) and samples-vs-elapsed drift lines; checker tools/spu/audio_check.py.

Rebased on ps3recomp v0.18.0 (SPU pass 108): context only (upstream v0.18.0 changed lines around the hunks; same change).

diff --git a/libs/audio/cellAudio.c b/libs/audio/cellAudio.c
index 02b751b2..546f0004 100644
--- a/libs/audio/cellAudio.c
+++ b/libs/audio/cellAudio.c
@@ -19,6 +19,7 @@
 #include <string.h>
 #include <stdlib.h>
 #include <stdint.h>
+#include <time.h>   /* KZ3 patch 1046: wall clock of the WAV capture start */
 #include <math.h>
 #include "ps3emu/log_first.h"
 #include "ps3emu/thread_name.h"
@@ -623,6 +624,50 @@ static unsigned __stdcall audio_mix_thread_func(void* arg)
         { static FILE* _wf = (FILE*)-1;
           if (_wf == (FILE*)-1) { const char* e = getenv("AUDIO_WAV"); _wf = e ? fopen(e, "wb") : NULL; }
           if (_wf) fwrite(s_mix_buffer, sizeof(float), CELL_AUDIO_BLOCK_SAMPLES * 2, _wf); }
+        /* KZ3 patch 1046 (SPU pass 34): KZ3_AUDIO_WAV=<file>: the same final mix (after the +-1 clamp, what
+         * audio_backend_submit hands the device) as a WAV (RIFF, format 3 = IEEE float32, 2 ch, 48 kHz; the
+         * header sizes are fixed up every 10 s and at exit so a killed run still has a readable file). One
+         * "[audio-wav] start" line gives sample 0's host time (QPC microseconds, the clock of the mixer's pacing)
+         * and the wall clock; a "[audio-wav] t=" line every 10 s gives samples written vs expected from the
+         * elapsed time (drift). Checker: tools/spu/audio_check.py. kz3-audio-wav begin */
+        { static FILE* _kf = (FILE*)-1; static unsigned long long _kblocks; static LARGE_INTEGER _kq0, _kqf;
+          if (_kf == (FILE*)-1) {
+              const char* e = getenv("KZ3_AUDIO_WAV"); _kf = e ? fopen(e, "wb") : NULL;
+              if (_kf) {
+                  static const unsigned char hdr[44] = { 'R','I','F','F', 0,0,0,0, 'W','A','V','E', 'f','m','t',' ', 16,0,0,0,
+                      3,0, 2,0, 0x80,0xBB,0,0, 0x00,0xDC,0x05,0x00, 8,0, 32,0, 'd','a','t','a', 0,0,0,0 };
+                  fwrite(hdr, 1, sizeof hdr, _kf);
+                  QueryPerformanceCounter(&_kq0); QueryPerformanceFrequency(&_kqf);
+                  { time_t wt = time(NULL); char wb[32] = "?"; struct tm* tmv = gmtime(&wt);
+                    if (tmv) strftime(wb, sizeof wb, "%Y-%m-%dT%H:%M:%SZ", tmv);
+                    fprintf(stderr, "[audio-wav] start sample 0 at host_us=%llu (QPC) wall=%s audio_start_us=%llu "
+                            "rate=%u ch=2 fmt=float32 block=%u file=%s\n",
+                            (unsigned long long)(_kq0.QuadPart * 1000000LL / _kqf.QuadPart), wb,
+                            (unsigned long long)s_audio_start_us, (unsigned)CELL_AUDIO_SAMPLE_RATE,
+                            (unsigned)CELL_AUDIO_BLOCK_SAMPLES, e); }
+              } else if (e) fprintf(stderr, "[audio-wav] cannot open %s\n", e);
+          }
+          if (_kf) {
+              fwrite(s_mix_buffer, sizeof(float), CELL_AUDIO_BLOCK_SAMPLES * 2, _kf);
+              _kblocks++;
+              if (_kblocks % (10u * CELL_AUDIO_SAMPLE_RATE / CELL_AUDIO_BLOCK_SAMPLES) == 0) {
+                  unsigned long long samples = _kblocks * CELL_AUDIO_BLOCK_SAMPLES, bytes = samples * 8ULL;
+                  unsigned char sz[4]; LARGE_INTEGER now; QueryPerformanceCounter(&now);
+                  unsigned long long us = (unsigned long long)((now.QuadPart - _kq0.QuadPart) * 1000000LL / _kqf.QuadPart);
+                  unsigned long long expect = us * CELL_AUDIO_SAMPLE_RATE / 1000000ULL;
+                  unsigned long long riff = bytes + 36ULL; if (riff > 0xFFFFFFFFULL) riff = 0xFFFFFFFFULL;
+                  unsigned long long data = bytes; if (data > 0xFFFFFFFFULL) data = 0xFFFFFFFFULL;
+                  sz[0] = (unsigned char)riff; sz[1] = (unsigned char)(riff >> 8); sz[2] = (unsigned char)(riff >> 16); sz[3] = (unsigned char)(riff >> 24);
+                  fseek(_kf, 4, SEEK_SET); fwrite(sz, 1, 4, _kf);
+                  sz[0] = (unsigned char)data; sz[1] = (unsigned char)(data >> 8); sz[2] = (unsigned char)(data >> 16); sz[3] = (unsigned char)(data >> 24);
+                  fseek(_kf, 40, SEEK_SET); fwrite(sz, 1, 4, _kf);
+                  fseek(_kf, 0, SEEK_END); fflush(_kf);
+                  fprintf(stderr, "[audio-wav] t=%.3f samples=%llu expected=%llu drift=%+lld (%.1f ms)\n", us / 1e6, samples,
+                          expect, (long long)samples - (long long)expect,
+                          ((double)samples - (double)expect) * 1000.0 / CELL_AUDIO_SAMPLE_RATE);
+              }
+          } }
+        /* kz3-audio-wav end */
         audio_backend_submit(s_mix_buffer, CELL_AUDIO_BLOCK_SAMPLES);
         /* AUDIO_RATE=1: blocks mixed vs real time, and frames dropped. */
         { static int on = -1; if (on < 0) on = getenv("AUDIO_RATE") ? 1 : 0;
