+    def emit_overrides_header(self) -> str:
+        """ppu_overrides.h: one `<name>__lifted` declaration and one
+        PPU_OVERRIDE_<addr> define per --overrides entry. Only the host's
+        replacement TU includes it, so an override change rebuilds that TU
+        and the one chunk that defines the lifted body, nothing else."""
+        hdr = getattr(self, "header_name", "ppu_recomp.h")
+        lines = ["/* Auto-generated by ppu_lifter.py -- do not edit by hand. */",
+                 "#pragma once",
+                 f'#include "{hdr}"',
+                 "/* --overrides: the host defines each <name>; its lifted body is <name>__lifted. */"]
+        for func in self.functions:
+            if func.start_addr in self.overrides:
+                lines.append(f"void {func.name}__lifted(ppu_context* ctx); /* --overrides: host defines {func.name} */")
+                lines.append(f"#define PPU_OVERRIDE_{func.start_addr:08X} 1")
+        lines.append("")
+        return "\n".join(lines)
