 /* Diagnostic gates polled on every receive (~140k/s in GH3): read once. */
 static int s_ps3_waitbt = -1, s_ydkj_sputask = -1, s_ydkj_spurs_ready = -1, s_ydkj_fakecomplete = -1, s_ydkj_hle_draw = -1;
 
+/* KZ3 patch 1023: see SEMDUMP_LR in sys_event_queue_receive. */
+static volatile uint32_t s_sd_r[4];
+static uint32_t sd_rd32(uint32_t ea) { extern uint8_t* vm_base; const uint8_t* p = vm_base + ea; return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3]; }
+static void kz3_semdump_region(const char* tag, uint32_t ea, uint32_t len)
+{
+    extern uint8_t* vm_base;
+    if (!vm_base || ea < 0x10000u || ea >= 0xF0000000u) return;
+    for (uint32_t o = 0; o < len; o += 32) {
+        uint32_t w[8]; int nz = 0;
+        for (int k = 0; k < 8; k++) { w[k] = sd_rd32(ea + o + 4u * k); nz |= (w[k] != 0); }
+        if (!nz) continue;
+        fprintf(stderr, "[semdump] %s 0x%08X+%03X: %08X %08X %08X %08X %08X %08X %08X %08X\n", tag, ea, o,
+                w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7]);
+    }
+}
+static void kz3_semdump_now(const char* why)
+{
+    uint32_t r28 = s_sd_r[0], r29 = s_sd_r[1], r30 = s_sd_r[2], r31 = s_sd_r[3];
+    fprintf(stderr, "[semdump] %s r28=0x%08X r29=0x%08X r30=0x%08X r31=0x%08X\n", why, r28, r29, r30, r31);
+    kz3_semdump_region("sem", r30, 0x10);
+    kz3_semdump_region("r29", r29, 0x380);
+    kz3_semdump_region("r28", r28, 0x100);
+    if (r29 >= 0x10000u && r29 < 0xF0000000u)
+        for (int i = 0; i < 4; i++) {
+            uint32_t p = sd_rd32(r29 + 0x90u + 4u * i);
+            char tag[16]; snprintf(tag, sizeof tag, "sem%d", i);
+            kz3_semdump_region(tag, p, 0x10);
+        }
+    fflush(stderr);
+}
+#ifdef _WIN32
+static DWORD WINAPI kz3_semdump_thread(LPVOID p) { (void)p; for (;;) { Sleep(30000); kz3_semdump_now("periodic"); } return 0; }
+#endif
+void kz3_semdump_note(uint32_t r28, uint32_t r29, uint32_t r30, uint32_t r31, uint32_t q, unsigned tid)
+{
+    static volatile LONG started = 0;
+    s_sd_r[0] = r28; s_sd_r[1] = r29; s_sd_r[2] = r30; s_sd_r[3] = r31;
+    char why[48]; snprintf(why, sizeof why, "receive q=%u tid=%u", q, tid);
+    kz3_semdump_now(why);
+#ifdef _WIN32
+    if (!InterlockedExchange(&started, 1)) CreateThread(NULL, 0, kz3_semdump_thread, NULL, 0, NULL);
+#else
+    (void)started;
+#endif
+}
