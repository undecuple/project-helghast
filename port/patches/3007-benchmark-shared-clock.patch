KZ3 patch 3007: stamp scripted-pad delivery and guest flip events from the
same ps3_ms_now monotonic clock at their production points.  The benchmark can
therefore align input delivery with the flip window directly, without treating
cross-thread log-write order as timing evidence.

diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -4907,7 +4907,8 @@
           if (!t0) t0 = now;
           ++n;
           if (n <= 400ull || (n % 10ull) == 0)
-              fprintf(stderr, "[flip] %llu at %llu ms%c", n, now - t0, 10);
+              fprintf(stderr, "[flip] %llu at %llu ms host=%llu ms%c",
+                      n, now - t0, now, 10);
       } }
 
     { /* KZ3 patch 2025: conditional-render counters every 256 flips (only once live-draw has seen a report). */
diff --git a/libs/input/cellPad.c b/libs/input/cellPad.c
--- a/libs/input/cellPad.c
+++ b/libs/input/cellPad.c
@@ -1872,14 +1872,18 @@
                 s->log_sec = sec; s->log_n = 0; s->log_suppressed = 0;
             }
             if (s->log_n++ < PAD_SCRIPT_LOG_PER_SEC) {
+                extern unsigned long long ps3_ms_now(void);
+                const unsigned long long host_ms = ps3_ms_now();
                 if (e->analog)
-                    printf("[cellPad] script t=%.1fs sticks l=(%u,%u) r=(%u,%u) l2=%u r2=%u for %.2fs (at %.1fs)\n",
-                           e->t, e->ax[0], e->ax[1], e->ax[2], e->ax[3], e->ax[4], e->ax[5], e->hold_s, now);
+                    printf("[cellPad] script t=%.1fs sticks l=(%u,%u) r=(%u,%u) l2=%u r2=%u for %.2fs (at %.1fs) host=%llu ms\n",
+                           e->t, e->ax[0], e->ax[1], e->ax[2], e->ax[3], e->ax[4], e->ax[5],
+                           e->hold_s, now, host_ms);
                 else if (e->hold_s < 0)
-                    printf("[cellPad] script t=%.1fs press 0x%04X for %d polls (at %.1fs)\n",
-                           e->t, e->mask, PAD_SCRIPT_HOLD_POLLS, now);
+                    printf("[cellPad] script t=%.1fs press 0x%04X for %d polls (at %.1fs) host=%llu ms\n",
+                           e->t, e->mask, PAD_SCRIPT_HOLD_POLLS, now, host_ms);
                 else
-                    printf("[cellPad] script t=%.1fs press 0x%04X for %.2fs (at %.1fs)\n", e->t, e->mask, e->hold_s, now);
+                    printf("[cellPad] script t=%.1fs press 0x%04X for %.2fs (at %.1fs) host=%llu ms\n",
+                           e->t, e->mask, e->hold_s, now, host_ms);
                 fflush(stdout);
             } else s->log_suppressed++;
         }
