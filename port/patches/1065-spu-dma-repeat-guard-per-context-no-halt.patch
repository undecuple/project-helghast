-          s_last_ea = (uint32_t)ea; s_last_lsa = lsa; s_rep = 0; s_since = 0;
-      }
-#undef s_last_ea
-#undef s_last_lsa
-#undef s_rep
-#undef s_since
-    }
+          if (mfc->rep_n >= s_limit) {
+              mfc->rep_n = 0;   /* re-arm: the chain may run this job again */
+              extern void spu_halt(spu_context*);
+              fprintf(stderr, "[spu-dma] img=%d pc=0x%05X: %u identical "
+                      "transfers to ea=0x%08X -- halting the SPU (SPU_DMA_REPEAT_LIMIT)\n",
+                      spu->image_id, (uint32_t)spu->pc & SPU_LS_MASK, s_limit,
+                      (uint32_t)ea);
+              fflush(stderr);
+              spu_halt(spu);
+          }
+      } else { mfc->rep_ea = (uint32_t)ea; mfc->rep_lsa = lsa; mfc->rep_n = 0; } }
 
     /* Mark tag as in-progress */
     mfc->tag_completed &= ~(1u << tag);
