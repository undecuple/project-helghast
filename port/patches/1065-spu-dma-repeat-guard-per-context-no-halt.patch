index be76e649..3837abfa 100644
--- a/runtime/spu/spu_dma.h
+++ b/runtime/spu/spu_dma.h
@@ -116,6 +116,9 @@ typedef struct mfc_engine {
 
     /* Per-tag completion tracking (bitmask: bit N = tag N completed) */
     uint32_t    tag_completed;
+
+    /* KZ3 patch 1065: the repeat guard's state, per context (was process-wide statics). */
+    uint32_t    rep_ea, rep_lsa, rep_n;
 } mfc_engine;
 
