diff --git a/libs/video/rsx_texloop_split.h b/libs/video/rsx_texloop_split.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_texloop_split.h
@@ -0,0 +1,88 @@
+/* KZ3 patch 2205 (RSX pass 174): the per-draw texture loop sub-timers of RSX_PERF_DRAW=1, sampled. Pure C (no OS calls, no
+ * globals other than the instance the caller owns), so tools/smoke/test_texloop_split.c builds it on the host. Diagnostics only.
+ *
+ * Why sampled: patches 2161/2135 timed the loop's parts with a QPC pair around every use, on every draw. The loop has up to
+ * 16 units, so that is up to ~40 pairs per draw (~25 ns each) on a ~20 us draw. This one times only every RSX_TLS_PERIOD-th
+ * draw (the draw counter and a fixed-seed generator pick it, not a clock: deterministic) and scales: the report multiplies each
+ * sampled sum by draws / sampled, so a row reads as us per draw over ALL draws, directly comparable to the other [perf-draw] rows. A draw that
+ * is not sampled pays one int test per site (rsx_tls.act == 0) and no clock read. Buckets are leaf stages, none nested in
+ * another (LOOP is the whole loop incl. vertex textures; "other" = LOOP minus the leaves; DESC runs after the loop). A
+ * count-only bucket (EN) holds the enabled units.
+ * Which draw of a block: one draw in each block of RSX_TLS_PERIOD consecutive draws is timed, at a pseudo-random offset (a fixed
+ * LCG seed, high bits), not at a fixed phase. A fixed phase aliases with any draw pattern whose period divides 16 (a frame of
+ * N x 16 draws, a repeated 8-draw group): the same draws are timed every time and the scaled row is biased. The first draw of a
+ * window is always timed (offset 0 for the first block), so a window shorter than a block still has a sample.
+ * Cost of the probe: a sampled draw pays about 18 clock reads (~0.5 us) inside the t1 span of ld_pd_draw, so [perf-draw]'s own
+ * mean and p95 move a little on those draws (1 in 16); and every leaf includes its own pair's overhead, so "other" (loop minus the
+ * listed leaves) is an upper bound of the untimed work, not a measurement of it. */
+#ifndef RSX_TEXLOOP_SPLIT_H
+#define RSX_TEXLOOP_SPLIT_H
+
+#include <stdint.h>
+
+#define RSX_TLS_PERIOD 16u
+enum {
+    RSX_TLS_EN,      /* count only: texture units enabled and bound by the draw (popcount of the loop's texture_mask) */
+    RSX_TLS_L1,      /* row check on every unit (rsx_tex_l1_hit), as RSX_PERF_W_TL_L1_T */
+    RSX_TLS_GET,     /* register decode of a unit that missed the row (ld_tex_get) */
+    RSX_TLS_SMP,     /* sampler key + slot */
+    RSX_TLS_PLAIN,   /* plain texture-cache bind (texture_srv_slot / _entry: keycap, hash decision, decode, LRU) */
+    RSX_TLS_ZSNAP,   /* zdepth_snapshot */
+    RSX_TLS_SWIN,    /* surface_window */
+    RSX_TLS_RG16,    /* ld_surface_rg16 */
+    RSX_TLS_DESC,    /* descriptor writes after the loop: srv_table + sampler_table */
+    RSX_TLS_LOOP,    /* the whole texture loop (RSX_PERF_W_D_TEXLOOP_T's span) */
+    RSX_TLS_NB
+};
+typedef struct {
+    int act;                           /* the current draw is sampled: the timer sites read the clock only when set */
+    uint32_t rng;                      /* the block-offset generator (never reset: a window reset keeps the stream) */
+    uint32_t pick;                     /* the sampled offset inside the current block */
+    uint64_t draws, sampled;           /* draws seen / sampled */
+    long long ticks[RSX_TLS_NB];       /* summed clock ticks of the sampled draws (EN: unused) */
+    uint64_t cnt[RSX_TLS_NB];          /* calls (EN: units) of the sampled draws */
+} rsx_tls;
+
+static inline void rsx_tls_reset(rsx_tls* t)
+{
+    t->act = 0; t->draws = t->sampled = 0; t->pick = 0;
+    for (int i = 0; i < RSX_TLS_NB; i++) { t->ticks[i] = 0; t->cnt[i] = 0; }
+}
+/* One call per draw, before the draw runs: picks the sampled ones (one per block of RSX_TLS_PERIOD draws, the first draw of a
+ * window always). The offset is the high bits of an LCG scaled by multiply-shift (any period, unbiased). */
+static inline int rsx_tls_begin(rsx_tls* t)
+{
+    if (t->draws % RSX_TLS_PERIOD == 0 && t->draws) {
+        t->rng = t->rng * 1664525u + 1013904223u;
+        t->pick = (uint32_t)(((uint64_t)t->rng * RSX_TLS_PERIOD) >> 32);
+    }
+    t->act = (t->draws % RSX_TLS_PERIOD) == t->pick;
+    t->draws++;
+    if (t->act) t->sampled++;
+    return t->act;
+}
+static inline void rsx_tls_end(rsx_tls* t) { t->act = 0; }
+static inline void rsx_tls_add(rsx_tls* t, int b, long long ticks)
+{
+    if (ticks < 0) ticks = 0;
+    t->ticks[b] += ticks; t->cnt[b]++;
+}
+static inline void rsx_tls_count(rsx_tls* t, int b, uint64_t n) { t->cnt[b] += n; }
+/* sampled -> all draws */
+static inline double rsx_tls_scale(const rsx_tls* t) { return t->sampled ? (double)t->draws / (double)t->sampled : 0.0; }
+/* One row, per draw over all draws: microseconds, calls (EN: units). */
+static inline void rsx_tls_row(const rsx_tls* t, int b, double us_per_tick, double* us_draw, double* calls_draw)
+{
+    const double s = rsx_tls_scale(t), n = t->draws ? (double)t->draws : 1.0;
+    *us_draw = (double)t->ticks[b] * us_per_tick * s / n;
+    *calls_draw = (double)t->cnt[b] * s / n;
+}
+/* LOOP minus the leaf buckets inside it (L1..RG16; DESC is after the loop). */
+static inline double rsx_tls_other_us(const rsx_tls* t, double us_per_tick)
+{
+    double lo, c, p = 0.0;
+    rsx_tls_row(t, RSX_TLS_LOOP, us_per_tick, &lo, &c);
+    for (int b = RSX_TLS_L1; b <= RSX_TLS_RG16; b++) { double u; rsx_tls_row(t, b, us_per_tick, &u, &c); p += u; }
+    return lo - p;
+}
+#endif
