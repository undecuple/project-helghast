+/* ---------------------------------------------------------------------------
+ * Patch 2164: LD_SYNC_HIST=1 (renderer step 0, probe P4). The classifier is rsx_sync_hist.h (host-tested); this
+ * file feeds it from the walker thread: draws (sink_end_impl), NV0039 copies (nv0039_copy), NV406E 0x6C releases
+ * (the walker's semaphore block), NV4097 0x1D70/0x1D74 releases (rsx_commands.c), flips (ld_present_body's
+ * before-sync write-back; KZ3 flips through 0xE944), reports (0x1800) and SET_REFERENCE (0x50). One line per
+ * LD_SYNC_HIST_N flips (default 100) and a summary at exit, on stderr. Off: one load + branch per hook.
+ * -----------------------------------------------------------------------*/
+static rsx_sh s_sh;
+static void gcm_sh_summary(void)
+{
+    char line[2048];
+    if (!g_rsx_sh_on) return;
+    g_rsx_sh_on = 0;
+    if (s_sh.win.flips) { rsx_sh_line(&s_sh, line, sizeof line); fprintf(stderr, "%s\n", line); }
+    rsx_sh_fmt(&s_sh.tot, "summary", line, sizeof line);
+    fprintf(stderr, "%s\n", line);
+}
+void rsx_sync_hist_draw(void) { if (g_rsx_sh_on) rsx_sh_draw(&s_sh); }
+void rsx_sync_hist_event(int kind, unsigned dirty)
+{
+    if (!g_rsx_sh_on) return;
+    if (rsx_sh_event(&s_sh, kind, dirty)) {
+        char line[2048];
+        rsx_sh_line(&s_sh, line, sizeof line);
+        fprintf(stderr, "%s\n", line);
+    }
+}
+
+/* ---------------------------------------------------------------------------
+ * Patch 2164: LD_FIFO_CAPTURE=dir (+ LD_FIFO_CAPTURE_FRAME=start,count, default 0,1): renderer step 0 capture writer
+ * (format and reader: rsx_fifo_capture.h). Frames are flips
+ * the walker consumed (sink_flip, the 0xFEAD word, E920/E924). The file <dir>/fifo-capture.kz3fc holds GAME DATA: dir
+ * must have a "work" path segment, never commit it. Capture slows the walker (every guest_ptr range is hashed),
+ * so a capture window is not a timing run. ASSUMPTION: the images of item (e) are a best-effort snapshot taken while
+ * the guest runs; the RANGE records, not the images, are the authority for what a draw read.
+ * -----------------------------------------------------------------------*/
+static rsx_fc_writer s_fc;
+static SRWLOCK s_fc_lock = SRWLOCK_INIT;
+static int s_fc_cfg_done, s_fc_state;            /* state: 0 waiting for the window, 1 open, 2 closed */
+static u32 s_fc_start, s_fc_count, s_fc_frames, s_fc_pass, s_fc_last_off = 0xFFFFFFFFu, s_fc_last_hdr;
+static char s_fc_path[400];
+static uint8_t s_fc_seen_blk[8192];              /* 64 KB blocks of the 4 GB guest space already imaged */
+
+static int gcm_fcap_work_segment(const char* p)
+{
+    for (const char* q = p; *q; ) {
+        const char* e = q;
+        while (*e && *e != '/' && *e != '\\') e++;
+        if (e - q == 4 && (q[0] | 0x20) == 'w' && (q[1] | 0x20) == 'o' && (q[2] | 0x20) == 'r' && (q[3] | 0x20) == 'k') return 1;
+        q = *e ? e + 1 : e;
+    }
+    return 0;
+}
+int rsx_fcap_configured(void)
+{
+    if (s_fc_cfg_done) return g_rsx_fcap_cfg;
+    s_fc_cfg_done = 1;
+    const char* dir = getenv("LD_FIFO_CAPTURE");
+    if (!dir || !*dir) return 0;
+    if (!gcm_fcap_work_segment(dir)) {
+        fprintf(stderr, "[fifo-capture] refused: LD_FIFO_CAPTURE=%s has no 'work' path segment (captures hold game data); capture off\n", dir);
+        return 0;
+    }
+    const char* fr = getenv("LD_FIFO_CAPTURE_FRAME");
+    unsigned a = 0, b = 1;
+    if (fr && *fr && sscanf(fr, "%u,%u", &a, &b) != 2) { a = 0; b = 1; }
+    if (!b) b = 1;
+    s_fc_start = a; s_fc_count = b;
+#ifdef _WIN32
+    CreateDirectoryA(dir, NULL);
+#else
+    mkdir(dir, 0777);
+#endif
+    snprintf(s_fc_path, sizeof s_fc_path, "%s/fifo-capture.kz3fc", dir);
+    g_rsx_fcap_cfg = 1;
+    fprintf(stderr, "[fifo-capture] configured: %s frames %u..%u (LD_FIFO_CAPTURE, patch 2164, format v%u)\n", s_fc_path,
+            s_fc_start, s_fc_start + s_fc_count - 1u, RSX_FC_VERSION);
+    return 1;
+}
+
+static int gcm_fcap_blk_zero(const uint8_t* p, size_t n)
+{
+    for (size_t i = 0; i + 8 <= n; i += 8) { uint64_t v; memcpy(&v, p + i, 8); if (v) return 0; }
+    return 1;
+}
+/* Item (e): non-zero 64 KB blocks of [ea, ea+len) as IMAGE records (each block once). Caller holds s_fc_lock. */
+static void gcm_fcap_image_locked(u32 ea, u32 len)
+{
+    extern u8* vm_base;
+    const u64 vmsz = ppu_vm_size ? ppu_vm_size : VM_TOTAL_SIZE;
+    for (u64 a = (u64)ea & ~0xFFFFull; a < (u64)ea + len; a += 0x10000) {
+        if (a + 0x10000 > vmsz) break;
+        const u32 blk = (u32)(a >> 16);
+        if (s_fc_seen_blk[blk >> 3] & (1u << (blk & 7))) continue;
+        s_fc_seen_blk[blk >> 3] |= (uint8_t)(1u << (blk & 7));
+        if (gcm_fcap_blk_zero(vm_base + a, 0x10000)) continue;
+        uint8_t head[12];
+        rsx_fc_put32(head, RSX_FC_EA); rsx_fc_put32(head + 4, (u32)a); rsx_fc_put32(head + 8, 0x10000u);
+        rsx_fc_w_rec2(&s_fc, RSX_FC_IMAGE, head, sizeof head, vm_base + a, 0x10000u);
+    }
+}
+static void gcm_fcap_atexit(void);
+static void gcm_fcap_open_locked(void)
+{
+    extern u8* vm_base;
+    s_fc_state = 2;                                   /* closed unless the open below succeeds */
+    if (!vm_base) return;
+    if (rsx_fc_w_open(&s_fc, s_fc_path, s_fc_start, s_fc_count) != 0) {
+        fprintf(stderr, "[fifo-capture] cannot create %s; capture off\n", s_fc_path);
+        return;
+    }
+    memset(s_fc_seen_blk, 0, sizeof s_fc_seen_blk);
+    rsx_fc_buf b = {0};
+    const u32 vmsz = (u32)(ppu_vm_size ? ppu_vm_size : VM_TOTAL_SIZE);
+    u32 n_io = 0;
+    for (u32 p = 0; p < 65536; p++) if (s_ea_address_table[p] != 0xFFFF) n_io++;
+    rsx_fc_buf_u32(&b, s_config.localAddress); rsx_fc_buf_u32(&b, s_config.localSize); rsx_fc_buf_u32(&b, vmsz);
+    rsx_fc_buf_u32(&b, vm_read32(GCM_CONTROL_GUEST_ADDR + 0)); rsx_fc_buf_u32(&b, s_fifo_getoff); rsx_fc_buf_u32(&b, s_fifo_calloff);
+    rsx_fc_buf_u32(&b, GCM_LABEL_GUEST_BASE); rsx_fc_buf_u32(&b, GCM_CONTROL_GUEST_ADDR); rsx_fc_buf_u32(&b, n_io);
+    for (u32 p = 0; p < 65536; p++) if (s_ea_address_table[p] != 0xFFFF) rsx_fc_buf_u32(&b, (p << 16) | s_ea_address_table[p]);
+    for (u32 i = 0; i < CELL_GCM_MAX_DISPLAY_BUFFER_NUM; i++) {
+        rsx_fc_buf_u32(&b, (u32)s_display_buffer_set[i]); rsx_fc_buf_u32(&b, s_display_buffers[i].offset);
+        rsx_fc_buf_u32(&b, s_display_buffers[i].pitch); rsx_fc_buf_u32(&b, s_display_buffers[i].width);
+        rsx_fc_buf_u32(&b, s_display_buffers[i].height);
+    }
+    if (!b.err) rsx_fc_w_rec(&s_fc, RSX_FC_CONFIG, b.p, b.n);
+    rsx_fc_buf_free(&b);
+    for (u32 p = 0; p < 65536; p++)                  /* every IO-mapped 1 MB page of main memory */
+        if (s_ea_address_table[p] != 0xFFFF) gcm_fcap_image_locked((u32)s_ea_address_table[p] << 20, 0x100000u);
+    if (s_config.localSize) gcm_fcap_image_locked(s_config.localAddress, s_config.localSize);   /* the RSX local window */
+    gcm_fcap_image_locked(GCM_LABEL_GUEST_BASE & ~0xFFFFu, 0x10000u);                            /* labels */
+    gcm_fcap_image_locked(GCM_CONTROL_GUEST_ADDR & ~0xFFFFu, 0x10000u);                          /* control register page */
+    { u32 v[2] = { s_fc_frames, 1u }; rsx_fc_w_words(&s_fc, RSX_FC_FRAME, v, 2); }
+    s_fc_state = 1; s_fc_last_off = 0xFFFFFFFFu;
+    atexit(gcm_fcap_atexit);
+    g_rsx_fcap_on = 1;
+    fprintf(stderr, "[fifo-capture] open at frame %u: config + images written (%llu payload bytes so far)\n", s_fc_frames,
+            (unsigned long long)s_fc.payload_bytes);
+}
+static void gcm_fcap_close_locked(void)
+{
+    if (s_fc_state != 1) return;
+    g_rsx_fcap_on = 0;
+    { u32 v[2] = { s_fc_frames, 0u }; rsx_fc_w_words(&s_fc, RSX_FC_FRAME, v, 2); }
+    const unsigned long long recs = s_fc.seq, bytes = s_fc.payload_bytes, nr = s_fc.n_range, nrb = s_fc.n_range_bytes;
+    const int rc = rsx_fc_w_close(&s_fc);
+    s_fc_state = 2;
+    fprintf(stderr, "[fifo-capture] closed at frame %u: %s, %llu records, %.1f MB payload, %llu guest ranges (%.1f MB of bytes)%s\n",
+            s_fc_frames, s_fc_path, recs, (double)bytes / 1048576.0, nr, (double)nrb / 1048576.0, rc ? " WRITE ERROR" : "");
+}
+static void gcm_fcap_atexit(void)
+{
+    AcquireSRWLockExclusive(&s_fc_lock);
+    gcm_fcap_close_locked();
+    ReleaseSRWLockExclusive(&s_fc_lock);
+}
+static void gcm_fcap_update_locked(void)
+{
+    if (s_fc_state == 0 && s_fc_frames >= s_fc_start && s_fc_frames - s_fc_start < s_fc_count) gcm_fcap_open_locked();
+    else if (s_fc_state == 1 && s_fc_frames - s_fc_start >= s_fc_count) gcm_fcap_close_locked();
+}
+static void gcm_fcap_pass_begin(u32 put)
+{
+    if (s_fc_state == 2) return;
+    AcquireSRWLockExclusive(&s_fc_lock);
+    gcm_fcap_update_locked();
+    if (s_fc_state == 1) { u32 v[4] = { put, s_fifo_getoff, s_fifo_calloff, ++s_fc_pass }; rsx_fc_w_words(&s_fc, RSX_FC_PASS, v, 4); }
+    ReleaseSRWLockExclusive(&s_fc_lock);
+}
+static void gcm_fcap_nop_run(u32 getoff, u32 words)
+{
+    AcquireSRWLockExclusive(&s_fc_lock);
+    if (s_fc_state == 1) { u32 v[4] = { getoff, 0u, 1u, words }; rsx_fc_w_words(&s_fc, RSX_FC_CMD, v, 4); s_fc_last_off = 0xFFFFFFFFu; }
+    ReleaseSRWLockExclusive(&s_fc_lock);
+}
+/* CMD with header 0 = a run of NOP words: payload is (getoff, 0, 1, run_words). Any other header: (getoff, header, n, n words). */
+static void gcm_fcap_cmd(u32 getoff, u32 w_raw, int is_method)
+{
+    static u32 words[0x800];
+    AcquireSRWLockExclusive(&s_fc_lock);
+    if (s_fc_state == 1 && !(s_fc_last_off == getoff && s_fc_last_hdr == w_raw)) {
+        s_fc_last_off = getoff; s_fc_last_hdr = w_raw;
+        if (w_raw == 0) {
+            u32 v[4] = { getoff, 0u, 1u, 1u }; rsx_fc_w_words(&s_fc, RSX_FC_CMD, v, 4);
+        } else {
+            u32 n = is_method ? (w_raw >> 18) & 0x7FFu : 0u, got = 0;
+            for (; got < n; got++) { const u32 ea = gcm_io2ea(getoff + 4u + got * 4u); if (!ea) break; words[got] = vm_read32(ea); }
+            rsx_fc_buf b = {0};
+            rsx_fc_buf_u32(&b, getoff); rsx_fc_buf_u32(&b, w_raw); rsx_fc_buf_u32(&b, got);
+            for (u32 i = 0; i < got; i++) rsx_fc_buf_u32(&b, words[i]);
+            if (!b.err) rsx_fc_w_rec(&s_fc, RSX_FC_CMD, b.p, b.n);
+            rsx_fc_buf_free(&b);
+        }
+    }
+    ReleaseSRWLockExclusive(&s_fc_lock);
+}
+static void gcm_fcap_pass_end(const char* why, u32 getoff, u32 calloff)
+{
+    uint8_t b[24] = {0};
+    AcquireSRWLockExclusive(&s_fc_lock);
+    if (s_fc_state == 1) {
+        rsx_fc_put32(b, getoff); rsx_fc_put32(b + 4, calloff);
+        if (why) strncpy((char*)b + 8, why, 15);
+        rsx_fc_w_rec(&s_fc, RSX_FC_PASS_END, b, sizeof b);
+    }
+    ReleaseSRWLockExclusive(&s_fc_lock);
+}
+static void gcm_fcap_copy_geom(u32 kind, u32 a, u32 b_, u32 c, u32 d, u32 e, u32 f, u32 g, u32 h, u32 i, u32 j, u32 k)
+{
+    uint8_t p[48];
+    const u32 v[12] = { kind, a, b_, c, d, e, f, g, h, i, j, k };
+    for (int q = 0; q < 12; q++) rsx_fc_put32(p + q * 4, v[q]);
+    AcquireSRWLockExclusive(&s_fc_lock);
+    if (s_fc_state == 1) rsx_fc_w_rec(&s_fc, RSX_FC_COPY, p, sizeof p);
+    ReleaseSRWLockExclusive(&s_fc_lock);
+}
+/* NV3089: phase 0 = before the blit (the source surface as a walker read, bytes), 1 = after (the result span as a
+ * digest, and the COPY record: 12 common words then in_off, in_fmt, in_sz, in_uv, out_pt, out_sz, clip_pt, clip_sz,
+ * dst_offset, dst_dma, dst colour format, ds_dx, dt_dy, fmt, op). The source extent is the whole input surface
+ * (in_pitch x in_height), an over-approximation of what the blit reads. */
+static void gcm_fcap_nv3089(int phase)
+{
+    extern u8* vm_base;
+    const u64 vmsz = ppu_vm_size ? ppu_vm_size : VM_TOTAL_SIZE;
+    const u32 in_pitch = s_nv3089.in_fmt & 0xFFFFu, in_h = s_nv3089.in_sz >> 16;
+    const u32 out_w = s_nv3089.out_sz & 0xFFFFu, out_h = s_nv3089.out_sz >> 16;
+    const u32 out_x = s_nv3089.out_pt & 0xFFFFu, out_y = s_nv3089.out_pt >> 16;
+    const u32 dst_pitch = s_gcm2d.pitch >> 16;
+    const int sl = s_nv3089.src_dma != 0xFEED0001u, dl = s_gcm2d.dst_dma != 0xFEED0001u;
+    const u32 src = cellGcmResolveLocated(sl, s_nv3089.in_off), dst = cellGcmResolveLocated(dl, s_gcm2d.dst_offset);
+    if (!vm_base) return;
+    if (phase == 0) {
+        const u64 len = (u64)in_pitch * in_h;
+        if (src && len && (u64)src + len <= vmsz && len <= (64u << 20)) rsx_fcap_range(RSX_FC_RD_WALKER, RSX_FC_EA, src, vm_base + src, (u32)len, 1);
+        return;
+    }
+    if (!out_w || !out_h || !dst_pitch) return;
+    const u64 start = (u64)dst + (u64)out_y * dst_pitch + (u64)out_x * 4u, len = (u64)(out_h - 1u) * dst_pitch + (u64)out_w * 4u;
