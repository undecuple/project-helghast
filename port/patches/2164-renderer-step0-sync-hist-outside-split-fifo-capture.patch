diff --git a/libs/video/rsx_sync_hist.h b/libs/video/rsx_sync_hist.h
new file mode 100644
index 00000000..ef65e22f
--- /dev/null
+++ b/libs/video/rsx_sync_hist.h
@@ -0,0 +1,190 @@
+/* KZ3 patch 2164 (renderer step 0, probe P4): LD_SYNC_HIST=1 sync-point histogram classifier.
+ *
+ * Pure C, no globals: the walker's hooks (cellGcmSys.c) feed events, the host test feeds a synthetic stream.
+ * Question it answers (a design question): how many resolve points does a flip
+ * hold, and how many draws sit between two of them? A worker thread that records draws can run ahead only up to the
+ * next resolve point, so the draws per interval bound what a front/worker split can overlap.
+ *
+ * Events and their classes:
+ *   RSX_SH_DRAW      a draw recorded (sink_end_impl, groups_executed++). Counted, never a sync point.
+ *   RSX_SH_NV0039    an NV0039 copy that reached its write-back call (cellGcmSys.c nv0039_copy). RESOLVE point (all tier);
+ *                    `dirty` = the write-back wrote something (a real GPU wait): hard tier too.
+ *   RSX_SH_REL406E   NV406E RELEASE 0x6C label write in the walker. RESOLVE point (all tier); dirty = the main-surface
+ *                    write-back at that sync point had a non-empty dirty set: hard tier too.
+ *   RSX_SH_REL4097   NV4097 0x1D70 / 0x1D74 release (rsx_commands.c). Same classes as REL406E.
+ *   RSX_SH_FLIP      a flip. Always ends the frame; a RESOLVE point only when the main-surface write-back at the flip
+ *                    had a non-empty dirty set (so it is in both tiers only when dirty).
+ *   RSX_SH_REPORT    GET_REPORT 0x1800. Information only (counted, closes a chunk, not a resolve point).
+ *   RSX_SH_REF       NV406E SET_REFERENCE 0x50. Information only (counted, closes a chunk, not a resolve point).
+ * "all" tier = NV0039 + REL406E + REL4097 (dirty or not) + dirty FLIP. It over-counts: the guest does not wait on
+ * every release. "hard" tier = the dirty ones only: those pay a write-back and a GPU wait today.
+ *
+ * A draw interval is the number of draws since the previous resolve point of that tier (or since the previous flip
+ * when no resolve point lies between): an interval closes at every resolve point and at every flip.
+ * Chunk estimate (design section 3): a chunk seals at every sync event (any kind above except DRAW) and every
+ * RSX_SH_CHUNK_DRAWS draws; a seal with no draw open adds no chunk. */
+#ifndef RSX_SYNC_HIST_H
+#define RSX_SYNC_HIST_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+enum { RSX_SH_DRAW = 0, RSX_SH_NV0039, RSX_SH_REL406E, RSX_SH_REL4097, RSX_SH_FLIP, RSX_SH_REPORT, RSX_SH_REF,
+       RSX_SH_KINDS };
+enum { RSX_SH_CHUNK_DRAWS = 128, RSX_SH_BUCKETS = 11, RSX_SH_TIERS = 2 };   /* tier 0 = all, 1 = hard */
+
+typedef struct rsx_sh_acc {
+    uint64_t flips, draws;
+    uint64_t ev[RSX_SH_KINDS];          /* events by kind (dirty or not) */
+    uint64_t dirty[RSX_SH_KINDS];       /* of which dirty */
+    uint64_t rp[RSX_SH_TIERS];          /* resolve points by tier */
+    uint64_t rp_max[RSX_SH_TIERS];      /* most resolve points in one flip */
+    uint64_t iv_n[RSX_SH_TIERS], iv_sum[RSX_SH_TIERS], iv_max[RSX_SH_TIERS];
+    uint64_t iv_hist[RSX_SH_TIERS][RSX_SH_BUCKETS];
+    uint64_t chunks, chunk_max;         /* chunks, most chunks in one flip */
+} rsx_sh_acc;
+
+typedef struct rsx_sh {
+    rsx_sh_acc win, tot;                /* window since the last line, whole run */
+    /* state of the open frame */
+    uint32_t since_rp[RSX_SH_TIERS];    /* draws since the last resolve point of the tier */
+    uint32_t frame_rp[RSX_SH_TIERS];
+    uint32_t open_draws;                /* draws in the open chunk */
+    uint32_t frame_chunks;
+    uint32_t every;                     /* flips per line */
+    uint64_t line_from;                 /* first flip of the window */
+} rsx_sh;
+
+/* Bucket: 0, 1, 2-3, 4-7, ... 512+ (11 buckets). */
+static inline unsigned rsx_sh_bucket(uint32_t n)
+{
+    unsigned b = 0;
+    if (!n) return 0;
+    while (n) { b++; n >>= 1; }          /* n=1 -> 1, 2-3 -> 2, 4-7 -> 3 ... */
+    return b >= RSX_SH_BUCKETS ? RSX_SH_BUCKETS - 1 : b;
+}
+
+static inline void rsx_sh_init(rsx_sh* s, uint32_t every_flips)
+{
+    memset(s, 0, sizeof *s);
+    s->every = every_flips ? every_flips : 100;
+}
+
+static inline void rsx_sh_iv(rsx_sh* s, int t)
+{
+    const uint32_t n = s->since_rp[t];
+    rsx_sh_acc* a[2] = { &s->win, &s->tot };
+    for (int i = 0; i < 2; i++) {
+        a[i]->iv_n[t]++; a[i]->iv_sum[t] += n;
+        if (n > a[i]->iv_max[t]) a[i]->iv_max[t] = n;
+        a[i]->iv_hist[t][rsx_sh_bucket(n)]++;
+    }
+    s->since_rp[t] = 0;
+}
+
+static inline void rsx_sh_seal(rsx_sh* s)
+{
+    if (s->open_draws) { s->frame_chunks++; s->open_draws = 0; }
+}
+
+static inline void rsx_sh_draw(rsx_sh* s)
+{
+    s->win.draws++; s->tot.draws++;
+    for (int t = 0; t < RSX_SH_TIERS; t++) s->since_rp[t]++;
+    if (++s->open_draws >= RSX_SH_CHUNK_DRAWS) rsx_sh_seal(s);
+}
+
+/* Returns 1 when a window of `every` flips just closed (the caller formats and prints with rsx_sh_line, which also
+ * resets the window). `dirty` is meaningful for NV0039, REL406E, REL4097 and FLIP. */
+static inline int rsx_sh_event(rsx_sh* s, int kind, unsigned dirty)
+{
+    if (kind <= RSX_SH_DRAW || kind >= RSX_SH_KINDS) return 0;
+    dirty = dirty ? 1u : 0u;
+    rsx_sh_acc* a[2] = { &s->win, &s->tot };
+    for (int i = 0; i < 2; i++) { a[i]->ev[kind]++; if (dirty) a[i]->dirty[kind]++; }
+    rsx_sh_seal(s);                                   /* every sync event seals the open chunk */
+    int all_rp = 0, hard_rp = 0;
+    switch (kind) {
+    case RSX_SH_NV0039: case RSX_SH_REL406E: case RSX_SH_REL4097: all_rp = 1; hard_rp = (int)dirty; break;
+    case RSX_SH_FLIP:                                  all_rp = (int)dirty; hard_rp = (int)dirty; break;
+    default: break;
+    }
+    const int is_flip = kind == RSX_SH_FLIP;
+    const int rp[RSX_SH_TIERS] = { all_rp, hard_rp };
+    for (int t = 0; t < RSX_SH_TIERS; t++) {
+        if (rp[t]) {
+            s->frame_rp[t]++;
+            for (int i = 0; i < 2; i++) a[i]->rp[t]++;
+        }
+        if (rp[t] || is_flip) rsx_sh_iv(s, t);
+    }
+    if (!is_flip) return 0;
+    for (int i = 0; i < 2; i++) {
+        a[i]->flips++;
+        for (int t = 0; t < RSX_SH_TIERS; t++) if (s->frame_rp[t] > a[i]->rp_max[t]) a[i]->rp_max[t] = s->frame_rp[t];
+        a[i]->chunks += s->frame_chunks;
+        if (s->frame_chunks > a[i]->chunk_max) a[i]->chunk_max = s->frame_chunks;
+    }
+    for (int t = 0; t < RSX_SH_TIERS; t++) s->frame_rp[t] = 0;
+    s->frame_chunks = 0;
+    return s->win.flips >= s->every;
+}
+
+/* Interval percentile from the bucket histogram: upper edge of the bucket holding the p-th percentile (0 for the
+ * zero bucket, 2^b - 1 otherwise; the last bucket prints its lower edge with a '+' in the line). */
+static inline uint32_t rsx_sh_pct(const rsx_sh_acc* a, int t, unsigned pct)
+{
+    uint64_t need = (a->iv_n[t] * pct + 99) / 100, run = 0;
+    if (!a->iv_n[t]) return 0;
+    if (!need) need = 1;
+    for (unsigned b = 0; b < RSX_SH_BUCKETS; b++) {
+        run += a->iv_hist[t][b];
+        if (run >= need) return b == 0 ? 0u : (b >= RSX_SH_BUCKETS - 1 ? 512u : (1u << b) - 1u);
+    }
+    return 512u;
+}
+
+/* One line for an accumulator. `tag` = "flips A-B" or "summary"; per-flip means are over a->flips. */
+static inline int rsx_sh_fmt(const rsx_sh_acc* a, const char* tag, char* out, size_t n)
+{
+    const double f = a->flips ? (double)a->flips : 1.0;
+    int o = snprintf(out, n,
+        "[sync-hist] %s flips %llu draws %llu (%.0f/flip) | resolve/flip all %.2f (max %llu) hard %.2f (max %llu)"
+        " | per flip: nv0039 %.2f (dirty %.2f) rel406e %.2f (dirty %.2f) rel4097 %.2f (dirty %.2f) flip-dirty %.2f"
+        " | info/flip: report %.2f ref %.2f",
+        tag, (unsigned long long)a->flips, (unsigned long long)a->draws, (double)a->draws / f,
+        (double)a->rp[0] / f, (unsigned long long)a->rp_max[0], (double)a->rp[1] / f, (unsigned long long)a->rp_max[1],
+        (double)a->ev[RSX_SH_NV0039] / f, (double)a->dirty[RSX_SH_NV0039] / f,
+        (double)a->ev[RSX_SH_REL406E] / f, (double)a->dirty[RSX_SH_REL406E] / f,
+        (double)a->ev[RSX_SH_REL4097] / f, (double)a->dirty[RSX_SH_REL4097] / f,
+        (double)a->dirty[RSX_SH_FLIP] / f, (double)a->ev[RSX_SH_REPORT] / f, (double)a->ev[RSX_SH_REF] / f);
+    for (int t = 0; t < RSX_SH_TIERS && o > 0 && (size_t)o < n; t++) {
+        o += snprintf(out + o, n - (size_t)o, " | draws/interval %s n %llu mean %.1f p50 %u p90 %u max %llu hist",
+                      t == 0 ? "all" : "hard", (unsigned long long)a->iv_n[t],
+                      a->iv_n[t] ? (double)a->iv_sum[t] / (double)a->iv_n[t] : 0.0, rsx_sh_pct(a, t, 50),
+                      rsx_sh_pct(a, t, 90), (unsigned long long)a->iv_max[t]);
+        for (unsigned b = 0; b < RSX_SH_BUCKETS && o > 0 && (size_t)o < n; b++)
+            o += snprintf(out + o, n - (size_t)o, "%s%llu", b ? "," : "[", (unsigned long long)a->iv_hist[t][b]);
+        if (o > 0 && (size_t)o < n) o += snprintf(out + o, n - (size_t)o, "]");
+    }
+    if (o > 0 && (size_t)o < n)
+        o += snprintf(out + o, n - (size_t)o, " | chunks/flip %.1f (max %llu) draws/chunk %.1f",
+                      (double)a->chunks / f, (unsigned long long)a->chunk_max,
+                      a->chunks ? (double)a->draws / (double)a->chunks : 0.0);
+    return o;
+}
+
+/* Window line ("window A-B": flips A..B of the run, 0-based), then reset the window. */
+static inline int rsx_sh_line(rsx_sh* s, char* out, size_t n)
+{
+    char tag[64];
+    snprintf(tag, sizeof tag, "window %llu-%llu", (unsigned long long)s->line_from,
+             (unsigned long long)(s->line_from + (s->win.flips ? s->win.flips - 1 : 0)));
+    const int o = rsx_sh_fmt(&s->win, tag, out, n);
+    s->line_from += s->win.flips;
+    memset(&s->win, 0, sizeof s->win);
+    return o;
+}
+
+#endif
diff --git a/libs/video/rsx_fifo_capture.h b/libs/video/rsx_fifo_capture.h
new file mode 100644
index 00000000..fb3e6947
--- /dev/null
+++ b/libs/video/rsx_fifo_capture.h
@@ -0,0 +1,264 @@
+/* KZ3 patch 2164 (renderer step 0): FIFO capture file format and its writer/reader. Pure C (stdio only), no game
+ * data, no globals: cellGcmSys.c drives the writer under LD_FIFO_CAPTURE=dir, the host test round-trips it, and the
+ * replay harness of the next round (LD_FIFO_REPLAY, tools/smoke/test_log_replay.c) reads it.
+ * Layout detail: rsx_fifo_capture.h.
+ *
+ * A capture holds GAME DATA (guest memory images and bytes the renderer read). It is written only under work/ and is
+ * never committed; cellGcmSys.c refuses a directory that has no "work" path segment.
+ *
+ * FILE  = header (32 bytes) , record* , END record.
+ *   header: char magic[8] = "KZ3FIFOC"; u32 version; u32 header_size = 32; u32 frame_start; u32 frame_count;
+ *           u32 reserved = 0.  All integers little endian, whatever the host.
+ * RECORD = u32 type; u32 len; u64 seq; u64 check; u8 payload[len].
+ *   seq   = 0,1,2,... strictly increasing by exactly 1 over the file (a dropped or reordered record is an error).
+ *   check = FNV-1a 64 over (type, len, seq as little-endian bytes) then the payload.
+ *   The END record's payload is u64 record_count (records before it) and u64 total_payload_bytes; a file without a
+ *   valid END (truncated, crashed) reads as an error, never as a short capture.
+ * Version history: 1 = this layout.
+ *
+ * Record payloads (u32 fields little endian; "w32" = a 32-bit FIFO / guest word as the guest sees it, numeric value):
+ *   RSX_FC_CONFIG (1)    u32 local_addr, local_size, vm_size, put, getoff, calloff, label_base, ctrl_addr, n_io;
+ *                        n_io x u32 (io_page << 16 | ea_page)  [1 MB IO page -> 1 MB EA page];
+ *                        8 x (u32 set, offset, pitch, width, height)  [display buffers].
+ *   RSX_FC_IMAGE (2)     u32 space, addr, len; bytes.  Initial memory (item e), 64 KB blocks, all-zero blocks left out.
+ *                        space RSX_FC_EA only (addr is a guest effective address).
+ *   RSX_FC_PASS (3)      u32 put, getoff, calloff, pass_no.  A walker pass starts (gcm_rsx_process_fifo_unlocked).
+ *   RSX_FC_CMD (4)       u32 getoff, header_word, n; n x w32 payload.  The command the walker consumed at getoff (item a),
+ *                        after park/patch resolution; a retry of the same getoff (blocked acquire, park re-read) is
+ *                        dropped when its header word is unchanged.  n = 0 for control words (JUMP/CALL/RET/flip word).
+ *   RSX_FC_PASS_END (5)  u32 getoff, calloff; char why[16] (NUL padded: caught-up, flip, park-wait, ...).
+ *   RSX_FC_RANGE (6)     u32 kind, space, addr, len, flags, reserved; u64 fnv1a(bytes); bytes if flags & HAS_BYTES.
+ *                        kind RD_RENDERER = a read through guest_ptr (item b; space/addr = location/offset, len =
+ *                        min_bytes: ASSUMPTION the renderer reads at most that), RD_WALKER / WR_WALKER = the walker's own
+ *                        NV0039/NV3089 source read and destination result (item c; space EA).  Bytes are written the
+ *                        first time a (space, addr, len) is seen and again whenever its digest differs from the last
+ *                        recorded one; otherwise only the digest is recorded.
+ *   RSX_FC_WORD (7)      u32 dir (0 read, 1 write), tag, ea, value.  A guest word the walker read or wrote outside the
+ *                        renderer (labels, get, ref, report words, ring recycle writes, acquire compares: item c).
+ *   RSX_FC_COPY (8)      u32 kind (0 NV0039, 1 NV3089), src_ea, dst_ea, line_len, line_count, pitch_in, pitch_out,
+ *                        format, wb, aux0 (src dma), aux1 (dst dma), aux2 (0).  The geometry of a walker copy; its source
+ *                        bytes and result are the RANGE records around it.  kind 1 (NV3089) continues with 15 more words:
+ *                        in_off, in_fmt, in_sz, in_uv, out_pt, out_sz, clip_pt, clip_sz, dst_offset, dst_dma, dst colour
+ *                        format, ds_dx, dt_dy, fmt, op (line_len/line_count = out_w/out_h).
+ *   RSX_FC_FLIP (9)      u32 buffer, source (0 sink_flip, 1 FEAD word, 2 E920/E924), frame (flips seen so far).
+ *   RSX_FC_SPU_NOTE (10) u32 location, offset, size, async (1 = any-thread SPU DMA note, 0 = walker-side note), thread.
+ *   RSX_FC_DRAIN (11)    u32 tail, head, overflow.  ld_gv_drain ran (item d); the notes between two drains were
+ *                        consumed by it.
+ *   RSX_FC_FRAME (12)    u32 frame, begin (1) or end (0).
+ *   RSX_FC_END (13)      see above. */
+#ifndef RSX_FIFO_CAPTURE_H
+#define RSX_FIFO_CAPTURE_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define RSX_FC_MAGIC "KZ3FIFOC"
+#define RSX_FC_VERSION 1u
+#define RSX_FC_HEADER_SIZE 32u
+#define RSX_FC_REC_HEAD 24u
+
+enum {
+    RSX_FC_CONFIG = 1, RSX_FC_IMAGE, RSX_FC_PASS, RSX_FC_CMD, RSX_FC_PASS_END, RSX_FC_RANGE, RSX_FC_WORD,
+    RSX_FC_COPY, RSX_FC_FLIP, RSX_FC_SPU_NOTE, RSX_FC_DRAIN, RSX_FC_FRAME, RSX_FC_END
+};
+enum { RSX_FC_EA = 0, RSX_FC_LOCAL = 1, RSX_FC_MAIN = 2 };                /* address spaces of a RANGE */
+enum { RSX_FC_RD_RENDERER = 0, RSX_FC_RD_WALKER = 1, RSX_FC_WR_WALKER = 2 };
+enum { RSX_FC_F_NULLPTR = 1, RSX_FC_F_BYTES = 2 };
+enum { RSX_FC_RANGE_HEAD = 32 };
+
+/* ---- little endian helpers ---- */
+static inline void rsx_fc_put32(uint8_t* p, uint32_t v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24); }
+static inline void rsx_fc_put64(uint8_t* p, uint64_t v) { rsx_fc_put32(p, (uint32_t)v); rsx_fc_put32(p + 4, (uint32_t)(v >> 32)); }
+static inline uint32_t rsx_fc_get32(const uint8_t* p) { return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24; }
+static inline uint64_t rsx_fc_get64(const uint8_t* p) { return (uint64_t)rsx_fc_get32(p) | (uint64_t)rsx_fc_get32(p + 4) << 32; }
+
+static inline uint64_t rsx_fc_fnv(uint64_t h, const void* data, size_t n)
+{
+    const uint8_t* p = (const uint8_t*)data;
+    for (size_t i = 0; i < n; i++) { h ^= p[i]; h *= 1099511628211ull; }
+    return h;
+}
+#define RSX_FC_FNV_SEED 14695981039346656037ull
+
+/* ---- payload builder (a growing buffer of little endian u32s) ---- */
+typedef struct rsx_fc_buf { uint8_t* p; uint32_t n, cap; int err; } rsx_fc_buf;
+static inline void rsx_fc_buf_free(rsx_fc_buf* b) { free(b->p); memset(b, 0, sizeof *b); }
+static inline void rsx_fc_buf_u32(rsx_fc_buf* b, uint32_t v)
+{
+    if (b->err) return;
+    if (b->n + 4 > b->cap) {
+        uint32_t nc = b->cap ? b->cap * 2 : 256;
+        uint8_t* np = (uint8_t*)realloc(b->p, nc);
+        if (!np) { b->err = 1; return; }
+        b->p = np; b->cap = nc;
+    }
+    rsx_fc_put32(b->p + b->n, v); b->n += 4;
+}
+
+/* ---- writer ---- */
+enum { RSX_FC_DEDUPE_CAP = 1 << 16 };
+typedef struct rsx_fc_slot { uint64_t fnv; uint32_t space, addr, len, used; } rsx_fc_slot;
+typedef struct rsx_fc_writer {
+    FILE* f;
+    uint64_t seq, payload_bytes;
+    int err;                             /* sticky: a failed write; close reports it */
+    rsx_fc_slot* dedupe;                 /* RSX_FC_DEDUPE_CAP slots, open addressing, 8 probes */
+    uint64_t n_range, n_range_bytes;     /* statistics */
+} rsx_fc_writer;
+
+static inline int rsx_fc_w_open(rsx_fc_writer* w, const char* path, uint32_t frame_start, uint32_t frame_count)
+{
+    uint8_t h[RSX_FC_HEADER_SIZE] = {0};
+    memset(w, 0, sizeof *w);
+    w->f = fopen(path, "wb");
+    if (!w->f) return -1;
+    setvbuf(w->f, NULL, _IOFBF, 1u << 20);
+    w->dedupe = (rsx_fc_slot*)calloc(RSX_FC_DEDUPE_CAP, sizeof(rsx_fc_slot));
+    if (!w->dedupe) { fclose(w->f); w->f = NULL; return -1; }
+    memcpy(h, RSX_FC_MAGIC, 8);
+    rsx_fc_put32(h + 8, RSX_FC_VERSION); rsx_fc_put32(h + 12, RSX_FC_HEADER_SIZE);
+    rsx_fc_put32(h + 16, frame_start); rsx_fc_put32(h + 20, frame_count);
+    if (fwrite(h, 1, sizeof h, w->f) != sizeof h) w->err = 1;
+    return 0;
+}
+
+/* One record whose payload is head[hlen] followed by tail[tlen] (either may be empty). */
+static inline int rsx_fc_w_rec2(rsx_fc_writer* w, uint32_t type, const void* head, uint32_t hlen, const void* tail, uint32_t tlen)
+{
+    uint8_t rh[RSX_FC_REC_HEAD], t8[16];
+    const uint32_t len = hlen + tlen;
+    if (!w->f) return -1;
+    rsx_fc_put32(t8, type); rsx_fc_put32(t8 + 4, len); rsx_fc_put64(t8 + 8, w->seq);
+    uint64_t h = rsx_fc_fnv(RSX_FC_FNV_SEED, t8, sizeof t8);
+    if (hlen) h = rsx_fc_fnv(h, head, hlen);
+    if (tlen) h = rsx_fc_fnv(h, tail, tlen);
+    memcpy(rh, t8, 16); rsx_fc_put64(rh + 16, h);
+    if (fwrite(rh, 1, sizeof rh, w->f) != sizeof rh) w->err = 1;
+    if (hlen && fwrite(head, 1, hlen, w->f) != hlen) w->err = 1;
+    if (tlen && fwrite(tail, 1, tlen, w->f) != tlen) w->err = 1;
+    w->seq++; w->payload_bytes += len;
+    return w->err ? -1 : 0;
+}
+static inline int rsx_fc_w_rec(rsx_fc_writer* w, uint32_t type, const void* payload, uint32_t len)
+{
+    return rsx_fc_w_rec2(w, type, payload, len, NULL, 0);
+}
+static inline int rsx_fc_w_words(rsx_fc_writer* w, uint32_t type, const uint32_t* v, unsigned n)
+{
+    uint8_t b[64];
+    if (n > 16) return -1;
+    for (unsigned i = 0; i < n; i++) rsx_fc_put32(b + i * 4, v[i]);
+    return rsx_fc_w_rec(w, type, b, n * 4);
+}
+
+/* A RANGE record. ptr == NULL = the lookup failed (flag NULLPTR, no digest). with_bytes = 0 records the digest only
+ * (walker destinations: both replay paths recompute them). Returns 1 when the bytes were written. */
+static inline int rsx_fc_w_range(rsx_fc_writer* w, uint32_t kind, uint32_t space, uint32_t addr, const void* ptr, uint32_t len, int with_bytes)
+{
+    uint8_t head[RSX_FC_RANGE_HEAD] = {0};
+    uint32_t flags = 0;
+    uint64_t fnv = 0;
+    int bytes = 0;
+    if (!ptr) flags |= RSX_FC_F_NULLPTR;
+    else {
+        fnv = rsx_fc_fnv(RSX_FC_FNV_SEED, ptr, len);
+        if (with_bytes) {
+            const uint64_t k = ((uint64_t)space * 0x9E3779B97F4A7C15ull) ^ ((uint64_t)addr << 20) ^ ((uint64_t)len * 0xC2B2AE3D27D4EB4Full);
+            const uint32_t base = (uint32_t)(k ^ (k >> 29)) & (RSX_FC_DEDUPE_CAP - 1);
+            rsx_fc_slot* hit = NULL;
+            rsx_fc_slot* free_slot = NULL;
+            for (unsigned i = 0; i < 8; i++) {
+                rsx_fc_slot* s = &w->dedupe[(base + i) & (RSX_FC_DEDUPE_CAP - 1)];
+                if (s->used && s->space == space && s->addr == addr && s->len == len) { hit = s; break; }
+                if (!s->used && !free_slot) free_slot = s;
+            }
+            if (!hit) hit = free_slot ? free_slot : &w->dedupe[base];   /* full neighbourhood: evict, the bytes get rewritten */
+            if (!(hit->used && hit->space == space && hit->addr == addr && hit->len == len && hit->fnv == fnv)) {
+                bytes = 1; flags |= RSX_FC_F_BYTES;
+            }
+            hit->used = 1; hit->space = space; hit->addr = addr; hit->len = len; hit->fnv = fnv;
+        }
+    }
+    rsx_fc_put32(head, kind); rsx_fc_put32(head + 4, space); rsx_fc_put32(head + 8, addr); rsx_fc_put32(head + 12, len);
+    rsx_fc_put32(head + 16, flags); rsx_fc_put64(head + 24, fnv);
+    w->n_range++;
+    if (bytes) w->n_range_bytes += len;
+    rsx_fc_w_rec2(w, RSX_FC_RANGE, head, sizeof head, bytes ? ptr : NULL, bytes ? len : 0);
+    return bytes;
+}
+
+/* Writes END and closes. Returns 0 when every write succeeded. */
+static inline int rsx_fc_w_close(rsx_fc_writer* w)
+{
+    uint8_t e[16];
+    int rc = 0;
+    if (!w->f) return -1;
+    rsx_fc_put64(e, w->seq); rsx_fc_put64(e + 8, w->payload_bytes);
+    rsx_fc_w_rec(w, RSX_FC_END, e, sizeof e);
+    if (fclose(w->f) != 0) w->err = 1;
+    rc = w->err ? -1 : 0;
+    w->f = NULL; free(w->dedupe); w->dedupe = NULL;
+    return rc;
+}
+
+/* ---- reader ---- */
+typedef struct rsx_fc_reader {
+    FILE* f;
+    uint8_t* buf; size_t cap;
+    uint64_t next_seq, payload_bytes;
+    uint32_t version, frame_start, frame_count;
+    int ended;
+} rsx_fc_reader;
+typedef struct rsx_fc_rec { uint32_t type, len; uint64_t seq; const uint8_t* p; } rsx_fc_rec;
+
+/* 0 ok; -1 cannot open / short header; -2 bad magic; -3 unsupported version. */
+static inline int rsx_fc_r_open(rsx_fc_reader* r, const char* path)
+{
+    uint8_t h[RSX_FC_HEADER_SIZE];
+    memset(r, 0, sizeof *r);
+    r->f = fopen(path, "rb");
+    if (!r->f) return -1;
+    if (fread(h, 1, sizeof h, r->f) != sizeof h) { fclose(r->f); r->f = NULL; return -1; }
+    if (memcmp(h, RSX_FC_MAGIC, 8) != 0) { fclose(r->f); r->f = NULL; return -2; }
+    r->version = rsx_fc_get32(h + 8);
+    if (r->version != RSX_FC_VERSION || rsx_fc_get32(h + 12) != RSX_FC_HEADER_SIZE) { fclose(r->f); r->f = NULL; return -3; }
+    r->frame_start = rsx_fc_get32(h + 16); r->frame_count = rsx_fc_get32(h + 20);
+    return 0;
+}
+
+/* 1 = a record in *rec (valid until the next call); 0 = clean end (END record read and its counts match);
+ * -1 truncated; -2 checksum mismatch; -3 sequence break; -4 END counts disagree with what was read; -5 out of memory. */
+static inline int rsx_fc_r_next(rsx_fc_reader* r, rsx_fc_rec* rec)
+{
+    uint8_t rh[RSX_FC_REC_HEAD];
+    if (r->ended) return 0;
+    if (fread(rh, 1, sizeof rh, r->f) != sizeof rh) return -1;
+    const uint32_t type = rsx_fc_get32(rh), len = rsx_fc_get32(rh + 4);
+    const uint64_t seq = rsx_fc_get64(rh + 8), check = rsx_fc_get64(rh + 16);
+    if (len > (1u << 28)) return -2;     /* a corrupt length: never allocate on its word alone */
+    if ((size_t)len + 1 > r->cap) {
+        size_t nc = (size_t)len + 1 + 4096;
+        uint8_t* nb = (uint8_t*)realloc(r->buf, nc);
+        if (!nb) return -5;
+        r->buf = nb; r->cap = nc;
+    }
+    if (len && fread(r->buf, 1, len, r->f) != len) return -1;
+    uint64_t h = rsx_fc_fnv(RSX_FC_FNV_SEED, rh, 16);
+    h = rsx_fc_fnv(h, r->buf, len);
+    if (h != check) return -2;
+    if (seq != r->next_seq) return -3;
+    r->next_seq++;
+    rec->type = type; rec->len = len; rec->seq = seq; rec->p = r->buf;
+    if (type == RSX_FC_END) {
+        r->ended = 1;
+        if (len != 16 || rsx_fc_get64(r->buf) != seq || rsx_fc_get64(r->buf + 8) != r->payload_bytes) return -4;
+        return 0;
+    }
+    r->payload_bytes += len;
+    return 1;
+}
+static inline void rsx_fc_r_close(rsx_fc_reader* r) { if (r->f) fclose(r->f); free(r->buf); memset(r, 0, sizeof *r); }
+
+#endif
