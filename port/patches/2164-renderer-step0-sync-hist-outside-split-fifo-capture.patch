+void rsx_fcap_spu_note(u32 location, u32 offset, u32 size, int async)
+{
+    if (!g_rsx_fcap_on) return;
+    const u32 v[5] = { location, offset, size, (u32)async, (u32)GetCurrentThreadId() };
+    AcquireSRWLockExclusive(&s_fc_lock);
+    if (s_fc_state == 1) rsx_fc_w_words(&s_fc, RSX_FC_SPU_NOTE, v, 5);
+    ReleaseSRWLockExclusive(&s_fc_lock);
+}
+void rsx_fcap_drain(u32 tail, u32 head, u32 overflow)
+{
+    if (!g_rsx_fcap_on) return;
+    const u32 v[3] = { tail, head, overflow };
