diff -ruN a/libs/video/rsx_live_draw.c b/libs/video/rsx_live_draw.c
--- a/libs/video/rsx_live_draw.c	2026-10-29 09:08:01.549223401 -0500
+++ b/libs/video/rsx_live_draw.c	2026-10-29 09:08:01.552223469 -0500
