 static ID3D12Resource* create_texture_mipped(DXGI_FORMAT fmt, const tex_level_t* lv, u32 n)
 {
     if (n == 0) return NULL;
@@ -2428,7 +2445,23 @@
     rd.Width = lv[0].w; rd.Height = lv[0].h; rd.DepthOrArraySize = 1;
     rd.MipLevels = (u16)n; rd.Format = fmt; rd.SampleDesc.Count = 1;
     ID3D12Resource* tex = NULL;
-    if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+    if (g_ld_tex_reuse) {   /* patch 2035 */
+        D3D12_RESOURCE_DESC cur;
+        g_ld_tex_reuse->lpVtbl->GetDesc(g_ld_tex_reuse, &cur);
+        if (cur.Dimension == rd.Dimension && cur.Width == rd.Width && cur.Height == rd.Height &&
+            cur.DepthOrArraySize == 1 && cur.MipLevels == rd.MipLevels && cur.Format == rd.Format &&
+            cur.SampleDesc.Count == 1) {
+            tex = g_ld_tex_reuse;
+            D3D12_RESOURCE_BARRIER b0 = {0};
+            b0.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION; b0.Transition.pResource = tex;
+            b0.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+            b0.Transition.StateBefore = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+            b0.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+            g.list->lpVtbl->ResourceBarrier(g.list, 1, &b0);
+        }
+    }
+    if (!tex &&
+        FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &rd,
                                                       D3D12_RESOURCE_STATE_COPY_DEST, NULL,
                                                       &IID_ID3D12Resource, (void**)&tex)))
         return NULL;
