--- /dev/null
+++ b/runtime/ppu/kz3_lwcond_fifo.h
@@ -0,0 +1,166 @@
+/* KZ3 patch 1059 (upstream candidate; design from Killzone 2's patch 6005): per-waiter FIFO for sys_lwcond.
+ *
+ * A guest lwcond wait parks the calling host thread in a FIFO node that lives on the waiter's stack; a signal
+ * marks the oldest queued node (signal), every node queued at the time (signal_all) or the named thread's node
+ * (signal_to) as woken and pulses one condition variable. lv2 wakes the threads that were queued at the time of
+ * the signal and never one that queued later. The counting semaphore that patch 0003 used instead let a thread
+ * woken by signal_all go straight back to waiting and take the count meant for another waiter, which then slept
+ * on (Killzone 2's FIOS media-thread startup hang; the same code ran here). Platform-neutral so the host test
+ * tools/spu/test_lwcond_fifo.c can build it on Linux with pthreads; ppu_sysprx.cpp uses the Windows half. */
+#ifndef KZ3_LWCOND_FIFO_H
+#define KZ3_LWCOND_FIFO_H
+#include <stdint.h>
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <pthread.h>
+#include <time.h>
+#include <errno.h>
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct kz3_lwc_waiter { struct kz3_lwc_waiter* next; uint32_t tid; volatile int woken; };
+
+struct kz3_lwc_queue {
+#ifdef _WIN32
+    SRWLOCK lock; CONDITION_VARIABLE cv;    /* zero-initialised = SRWLOCK_INIT / CONDITION_VARIABLE_INIT */
+#else
+    pthread_mutex_t lock; pthread_cond_t cv;
+#endif
+    struct kz3_lwc_waiter* head; struct kz3_lwc_waiter* tail;
+    long waiters;                           /* queued nodes (diagnostics) */
+    int inited;
+};
+
+static inline void kz3_lwc_lock(struct kz3_lwc_queue* q)
+{
+#ifdef _WIN32
+    AcquireSRWLockExclusive(&q->lock);
+#else
+    pthread_mutex_lock(&q->lock);
+#endif
+}
+static inline void kz3_lwc_unlock(struct kz3_lwc_queue* q)
+{
+#ifdef _WIN32
+    ReleaseSRWLockExclusive(&q->lock);
+#else
+    pthread_mutex_unlock(&q->lock);
+#endif
+}
+
+/* Once per queue object (idempotent). The sync objects persist across guest create/destroy like the old
+ * semaphore did; kz3_lwc_reset empties the queue for a fresh guest lwcond in the same slot. */
+static inline void kz3_lwc_init(struct kz3_lwc_queue* q)
+{
+    if (q->inited) return;
+#ifdef _WIN32
+    InitializeSRWLock(&q->lock); InitializeConditionVariable(&q->cv);
+#else
+    pthread_condattr_t ca; pthread_condattr_init(&ca);
+    pthread_condattr_setclock(&ca, CLOCK_MONOTONIC);
+    pthread_mutex_init(&q->lock, NULL); pthread_cond_init(&q->cv, &ca);
+    pthread_condattr_destroy(&ca);
+#endif
+    q->head = q->tail = 0; q->waiters = 0; q->inited = 1;
+}
+static inline void kz3_lwc_reset(struct kz3_lwc_queue* q)
+{
+    kz3_lwc_init(q);
+    kz3_lwc_lock(q); q->head = q->tail = 0; q->waiters = 0; kz3_lwc_unlock(q);
+}
+
+/* Queue the caller's node. Call BEFORE dropping the guest lwmutex, so a signal sent under that mutex finds it. */
+static inline void kz3_lwc_enqueue(struct kz3_lwc_queue* q, struct kz3_lwc_waiter* w, uint32_t tid)
+{
+    w->next = 0; w->tid = tid; w->woken = 0;
+    kz3_lwc_lock(q);
+    if (q->tail) q->tail->next = w; else q->head = w;
+    q->tail = w; q->waiters++;
+    kz3_lwc_unlock(q);
+}
+
+static inline void kz3_lwc_unlink_locked(struct kz3_lwc_queue* q, struct kz3_lwc_waiter* w)
+{
+    struct kz3_lwc_waiter** pp = &q->head; struct kz3_lwc_waiter* prev = 0;
+    while (*pp && *pp != w) { prev = *pp; pp = &(*pp)->next; }
+    if (!*pp) return;
+    *pp = w->next;
+    if (q->tail == w) q->tail = prev;
+    q->waiters--;
+}
+
+/* Block until the node is woken or timeout_ms (< 0 = forever) passes. Returns 1 woken, 0 timed out (the node
+ * is unlinked; a signal that lands first still counts as the wakeup). */
+static inline int kz3_lwc_wait(struct kz3_lwc_queue* q, struct kz3_lwc_waiter* w, int64_t timeout_ms)
+{
+#ifdef _WIN32
+    ULONGLONG deadline = timeout_ms >= 0 ? GetTickCount64() + (ULONGLONG)timeout_ms : 0;
+    AcquireSRWLockExclusive(&q->lock);
+    while (!w->woken) {
+        DWORD ms = INFINITE;
+        if (timeout_ms >= 0) {
+            ULONGLONG now = GetTickCount64();
+            if (now >= deadline) break;
+            ms = (DWORD)((deadline - now) > 0xFFFFFFFEull ? 0xFFFFFFFEu : (deadline - now));
+        }
+        SleepConditionVariableSRW(&q->cv, &q->lock, ms, 0);
+    }
+    int woken = w->woken;
+    if (!woken) kz3_lwc_unlink_locked(q, w);
+    ReleaseSRWLockExclusive(&q->lock);
+    return woken;
+#else
+    struct timespec dl;
+    if (timeout_ms >= 0) {
+        clock_gettime(CLOCK_MONOTONIC, &dl);
+        dl.tv_sec += timeout_ms / 1000; dl.tv_nsec += (timeout_ms % 1000) * 1000000L;
+        if (dl.tv_nsec >= 1000000000L) { dl.tv_sec++; dl.tv_nsec -= 1000000000L; }
+    }
+    pthread_mutex_lock(&q->lock);
+    while (!w->woken) {
+        if (timeout_ms >= 0) { if (pthread_cond_timedwait(&q->cv, &q->lock, &dl) == ETIMEDOUT) break; }
+        else pthread_cond_wait(&q->cv, &q->lock);
+    }
+    int woken = w->woken;
+    if (!woken) kz3_lwc_unlink_locked(q, w);
+    pthread_mutex_unlock(&q->lock);
+    return woken;
+#endif
+}
+
+/* signal (all = 0, to_tid = 0): the oldest queued waiter; signal_all: every waiter queued now; signal_to: the
+ * named thread if it is queued, else the oldest (the old code woke "one waiter, which one not modelled").
+ * Returns how many were woken (0: nobody waiting, lv2 drops the signal). */
+static inline int kz3_lwc_wake(struct kz3_lwc_queue* q, int all, uint32_t to_tid)
+{
+    int n = 0;
+    kz3_lwc_lock(q);
+    struct kz3_lwc_waiter* w = q->head;
+    if (to_tid)
+        for (struct kz3_lwc_waiter* x = q->head; x; x = x->next) if (x->tid == to_tid) { w = x; break; }
+    while (w) {
+        struct kz3_lwc_waiter* nx = w->next;
+        kz3_lwc_unlink_locked(q, w);
+        w->woken = 1; n++;
+        if (!all) break;
+        w = nx;
+    }
+    kz3_lwc_unlock(q);
+    if (n) {
+#ifdef _WIN32
+        WakeAllConditionVariable(&q->cv);
+#else
+        pthread_cond_broadcast(&q->cv);
+#endif
+    }
+    return n;
+}
+
+#ifdef __cplusplus
+}
+#endif
+#endif
