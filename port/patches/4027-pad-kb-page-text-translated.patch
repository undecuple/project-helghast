  * player's language and active preset; pass 38); `label` is the port's own fallback (file comments, host tests) and
  * the page text for the eight stick directions and Start, which have no string of their own in the game. */
 typedef struct { const char* input; const char* label; const char* button; } PadKbRow;
+
+/* KZ3 patch 4027 (network pass 45): the page text in the game's language. PAD_KB_TR(key, en) gives the text for a key of
+ * the port's table (port/text/port_ui.tsv: kb.row.<input>, kb.hint_*, kb.capture, kb.timeout, kb.conflict) or `en`;
+ * cellPad.c points it at the port's lookup (g_pad_kb_tr), everything else keeps English. {0}..{2} are filled by
+ * pad_kb_fmt. */
+#ifndef PAD_KB_TR
+#define PAD_KB_TR(key, en) (en)
+#endif
+static void pad_kb_fmt(char* out, size_t n, const char* t, const char* a0, const char* a1, const char* a2)
+{
+    const char* a[3] = { a0 ? a0 : "", a1 ? a1 : "", a2 ? a2 : "" };
+    size_t w = 0;
+    if (!n) return;
+    for (; t && *t; t++) {
+        if (t[0] == '{' && t[1] >= '0' && t[1] <= '2' && t[2] == '}') {
+            for (const char* s = a[t[1] - '0']; *s && w + 1 < n; s++) out[w++] = *s;
+            t += 2;
+        } else if (w + 1 < n) out[w++] = *t;
+    }
+    out[w] = 0;
+}
 static const PadKbRow pad_kb_rows[] = {
     { "ls_up", "Move forward", 0 },       { "ls_down", "Move back", 0 },
     { "ls_left", "Strafe left", 0 },      { "ls_right", "Strafe right", 0 },
@@ -643,6 +664,18 @@
     { "back", "Back (menus)", 0 },        /* patch 2106 */
 };
 #define PKB_N_ROWS ((int)(sizeof pad_kb_rows / sizeof pad_kb_rows[0]))
+static const char* pad_kb_rows_button_of(int r) { return pad_kb_rows[r].button; }   /* 4027 */
+static const char* pad_kb_rows_label_of(int r) { return pad_kb_rows[r].label; }
+static const char* pad_kb_rows_input_of(int r) { return pad_kb_rows[r].input; }
+/* A row's label: the port's text for the rows the game has no word for (sticks, Start, Back), else the English
+ * fallback (the page shows the game's own action name for button rows). */
+static const char* pad_kb_row_label(int r)
+{
+    char key[40];
+    if (pad_kb_rows_button_of(r)) return pad_kb_rows_label_of(r);
+    snprintf(key, sizeof key, "kb.row.%s", pad_kb_rows_input_of(r));
+    return PAD_KB_TR(key, pad_kb_rows_label_of(r));
+}
 
