+/* Patch 2059 (RSX pass 59): one rule for an A8R8G8B8 read of a Z24S8 zeta address, used by the texture bind
+ * AND the PSO. Patch 2044's rule (the zeta wins when its depth was written after the last real colour write to a
+ * colour surface at the same address, the draw's own target excluded) lived only in the bind, while get_pso
+ * tagged every such unit ZALIAS_ARGB, so the shader rebuilt depth bytes (rsx_fp_apply_depth_argb: .x taken as
+ * depth, split into A,R,G) from the COLOUR texel whenever the bind had picked the colour surface, and skipped that
+ * unit's gamma decode. In KZ3 the 320x180 blur ping-pong 0x2980000 / 0x2DA0000 shares its addresses with the
+ * level's shadow-map zetas: once a level has run, every blur pass (pause screen, and the main menu after a quit)
+ * rebuilt bytes from colour, near-black became (1,1,1)/255, the sRGB output (2055) lifted it to 13/255, the next
+ * pass to 64/255: the orange wash, the blocks and the black holes. A fresh-boot menu has no zeta there.
+ * cg_out / ci_out (optional): the newest colour alias' colour_gen and slot (-1 none), for the bind's log. */
+static int ld_argb_zeta_pref(const rsx_dsp_texture* t, u32 target, u32* cg_out, int* ci_out)
+{
+    u32 cg = 0; int ci = -1;
+    if (cg_out) *cg_out = 0;
+    if (ci_out) *ci_out = -1;
+    static int aoff = -1;
+    if (aoff < 0) aoff = getenv("LD_NO_ZETA_ARGB_PREFER") ? 1 : 0;   /* patch 2044: colour alias first */
+    const int zi = zdepth_index_at(t->location, t->offset);
+    if (aoff || zi < 0) return 0;
+    for (u32 i = 0; i < g.n_surfaces; i++)
+        if (g.surfaces[i].location == t->location && g.surfaces[i].offset == t->offset &&
+            i != target && g.surfaces[i].colour_gen >= cg) { cg = g.surfaces[i].colour_gen; ci = (int)i; }
+    if (cg_out) *cg_out = cg;
+    if (ci_out) *ci_out = ci;
+    return g.zdepths[zi].zwrite_gen > cg;
+}
+/* The kind the shader must be built for: ZALIAS_ARGB only when the bind takes the zeta, i.e. the zeta is
+ * preferred, or no colour surface (the draw's own target included: the bind then samples a feedback copy of it)
+ * sits at the address. LD_NO_ARGB_BIND_MATCH=1 = the old PSO tagging (A/B). */
+static u32 current_surface(void);
+static int ld_shader_zalias_kind(const rsx_dsp_texture* t)
+{
+    const int k = tex_zalias_kind(t);
+    if (k != ZALIAS_ARGB) return k;
+    const u32 target = current_surface();   /* the draw's colour target, as the bind sees it */
+    static int old = -1;
+    if (old < 0) old = getenv("LD_NO_ARGB_BIND_MATCH") ? 1 : 0;
+    if (old || ld_argb_zeta_pref(t, target, NULL, NULL)) return k;
+    for (u32 i = 0; i < g.n_surfaces; i++)
+        if (g.surfaces[i].location == t->location && g.surfaces[i].offset == t->offset) {
+            static u32 n = 0;
+            if (n < 16) { n++;
+                fprintf(stderr, "[zeta-argb] f=%u pso unit reads colour %u:0x%08X %ux%u (slot %u), no depth rebuild\n",
+                        g_ld_frames, t->location, t->offset, t->width, t->height, i); }
+            return ZALIAS_NONE;
+        }
+    return k;
+}
