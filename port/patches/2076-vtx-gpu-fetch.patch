+        fprintf(stderr, "[vtx-gpu] %s (LD_VTX_GPU=%s) max-block=%uMB\n", g_vg.on ? "on" : "off", e ? e : "unset",
+                g_vg.max_block >> 20);
+    }
+    return g_vg.on;
+}
