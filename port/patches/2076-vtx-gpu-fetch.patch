+static int ld_vtx_gpu_on(void)
+{
+    if (g_vg.on < 0) {
+        const char* e = getenv("LD_VTX_GPU");
+        const char* mb = getenv("LD_VTX_GPU_MB");
+        g_vg.on = (e && e[0] == '1') ? 1 : 0;
