diff --git a/libs/video/rsx_vtx_gpu.h b/libs/video/rsx_vtx_gpu.h
new file mode 100644
index 00000000..a5c7f330
--- /dev/null
+++ b/libs/video/rsx_vtx_gpu.h
@@ -0,0 +1,215 @@
+/*
+ * KZ3 patch 2076: GPU-side vertex fetch for the live renderer (LD_VTX_GPU, default off).
+ *
+ * The CPU path decodes every attribute of every unique vertex into float4 slots (rsx_vertex_fetch_many) and
+ * uploads 16 bytes per slot. In this mode a draw uploads the raw guest bytes its attributes span instead, plus a
+ * 512-byte attribute table, and the vertex shader decodes them: the per-vertex payload is one u32, the element
+ * index (vertex_id + base_index) & 0xFFFFF of the unique reference.
+ *
+ * Block layout (one per draw, in the vertex upload ring, bound as the root SRV t20, ByteAddressBuffer vg_raw):
+ *   [0, 512)  16 rows of rsx_vg_attr: uint4 {base, stride, fmt, lim}, float4 default
+ *   [512, ..) the merged raw spans, each placed so its host address and block offset agree mod 4
+ * Attribute i of element e reads at base + e * stride (u32 arithmetic, wraps like the C code), clamped to lim (the
+ * last element's address), so a reference outside the draw's span stays inside the block (root SRVs have no
+ * bounds check). fmt = type | n << 4, n = min(size, 4); fmt 0 = the row's default (disabled attribute, or a
+ * register the layout does not feed: (0,0,0,1), as the compact CPU path).
+ *
+ * Exactness: FLOAT and HALF are built from the bits (same integer steps as rsx_compact_be_f16), UINT8 and SINT16
+ * are exact integer conversions, and the three formats with a division (UNORM8 x/255, SNORM16 x/32767, CMP32
+ * x/1023 and z/511) read a table filled at start-up by rsx_vertex_decode_element itself (t21, vg_lut), so the
+ * shader's values are the CPU path's bit for bit by construction. The decode is written once, in the common
+ * subset of C and HLSL, inside RSX_VG_SHARED: the host test compiles it as C (RSX_VG_C_REFERENCE) and the
+ * renderer pastes the same text, stringified, into the vertex shader.
+ */
+#ifndef PS3RECOMP_RSX_VTX_GPU_H
+#define PS3RECOMP_RSX_VTX_GPU_H
+
+#include "rsx_vertex_compact.h"   /* not rsx_vertex_formats.h: its DXGI_FORMAT_* macros break dxgiformat.h */
+#include <stdint.h>
+#include <string.h>
+
+#define RSX_VG_TABLE_BYTES 512u
+#define RSX_VG_LUT_UNORM8  0u        /* 256 entries, by byte */
+#define RSX_VG_LUT_SNORM16 256u      /* 65,536 entries, by the raw big-endian u16 */
+#define RSX_VG_LUT_CMPXY   65792u    /* 2,048 entries, by the 11-bit field */
+#define RSX_VG_LUT_CMPZ    67840u    /* 1,024 entries, by the 10-bit field */
+#define RSX_VG_LUT_WORDS   68864u
+
+/* The decode, in the C/HLSL common subset. VG_FN, VG_RAW(a) (the little-endian dword at byte a, a % 4 == 0),
+ * VG_LUT(i) (float i of the table), uint, asint and asfloat come from the including side. The LUT offsets are the
+ * RSX_VG_LUT_* numbers (checked by the host test). Types: 1 SNORM16, 2 FLOAT, 3 HALF, 4 UNORM8, 5 SINT16,
+ * 6 CMP32, 7 UINT8 (rsx_dispatch.h). */
+#define RSX_VG_SHARED(X) X( \
+VG_FN uint vg_b(uint a) { return (VG_RAW(a & 0xFFFFFFFCu) >> ((a & 3u) * 8u)) & 255u; } \
+VG_FN uint vg_be16(uint a) { return (vg_b(a) << 8u) | vg_b(a + 1u); } \
+VG_FN uint vg_be32(uint a) { \
+    uint w = VG_RAW(a & 0xFFFFFFFCu); \
+    if ((a & 3u) != 0u) w = vg_b(a) | (vg_b(a + 1u) << 8u) | (vg_b(a + 2u) << 16u) | (vg_b(a + 3u) << 24u); \
+    return (w >> 24u) | ((w >> 8u) & 0xFF00u) | ((w << 8u) & 0xFF0000u) | (w << 24u); \
+} \
+VG_FN float vg_fetch(uint base, uint stride, uint fmt, uint lim, float dflt, uint e, uint c) { \
+    uint t = fmt & 15u; \
+    uint n = (fmt >> 4u) & 15u; \
+    uint a = base + e * stride; \
+    if (t == 0u) return dflt; \
+    if (a > lim) a = lim; \
+    if (t == 6u) { \
+        uint w = vg_be32(a); \
+        if (c == 0u) return VG_LUT(65792u + (w & 0x7FFu)); \
+        if (c == 1u) return VG_LUT(65792u + ((w >> 11u) & 0x7FFu)); \
+        if (c == 2u) return VG_LUT(67840u + (w >> 22u)); \
+        return 1.0f; \
+    } \
+    if (c >= n) return c == 3u ? 1.0f : 0.0f; \
+    if (t == 2u) return asfloat(vg_be32(a + c * 4u)); \
+    if (t == 3u) { \
+        uint h = vg_be16(a + c * 2u); \
+        uint x = h & 0x7C00u; \
+        uint mag = ((h & 0x7FFFu) << 13u) + (x == 0x7C00u ? (224u << 23u) : (112u << 23u)); \
+        return asfloat(((h & 0x8000u) << 16u) | (x != 0u ? mag : 0u)); \
+    } \
+    if (t == 4u) return VG_LUT(vg_b(a + c)); \
+    if (t == 7u) return (float)vg_b(a + c); \
+    if (t == 1u) return VG_LUT(256u + vg_be16(a + c * 2u)); \
+    if (t == 5u) return (float)(asint(vg_be16(a + c * 2u) << 16u) >> 16); \
+    return 0.0f; \
+} )
+#define RSX_VG_CODE(...) __VA_ARGS__
+#define RSX_VG_TEXT(...) #__VA_ARGS__
+
+/* What the vertex shader declares (HLSL): the two buffers, the macros the shared code uses, the code, and the
+ * per-attribute float4 reader. */
+#define RSX_VG_HLSL \
+    "ByteAddressBuffer vg_raw : register(t20);\n" \
+    "ByteAddressBuffer vg_lut : register(t21);\n" \
+    "#define VG_FN\n" \
+    "#define VG_RAW(a) vg_raw.Load(a)\n" \
+    "#define VG_LUT(i) asfloat(vg_lut.Load((i) * 4u))\n" \
+    RSX_VG_SHARED(RSX_VG_TEXT) "\n" \
+    "float4 vg_attr(uint i, uint e) {\n" \
+    "    uint r = i * 32u;\n" \
+    "    uint b = vg_raw.Load(r); uint s = vg_raw.Load(r + 4u); uint f = vg_raw.Load(r + 8u); uint l = vg_raw.Load(r + 12u);\n" \
+    "    return float4(vg_fetch(b, s, f, l, asfloat(vg_raw.Load(r + 16u)), e, 0u),\n" \
+    "                  vg_fetch(b, s, f, l, asfloat(vg_raw.Load(r + 20u)), e, 1u),\n" \
+    "                  vg_fetch(b, s, f, l, asfloat(vg_raw.Load(r + 24u)), e, 2u),\n" \
+    "                  vg_fetch(b, s, f, l, asfloat(vg_raw.Load(r + 28u)), e, 3u));\n" \
+    "}\n"
+
+/* One table row (the shader reads it with eight Load: plain Load only, for Wine's vkd3d-shader HLSL compiler). */
+typedef struct rsx_vg_attr { u32 base, stride, fmt, lim; float dflt[4]; } rsx_vg_attr;
+typedef struct rsx_vg_span { const u8* src; u32 bytes; u32 dst; } rsx_vg_span;
+typedef struct rsx_vg_draw {
+    rsx_vg_attr table[RSX_DSP_NUM_VERTEX_ATTR];
+    rsx_vg_span span[RSX_DSP_NUM_VERTEX_ATTR];
+    u32 n_span;
+    u32 block_bytes;   /* table + spans, a multiple of 16 */
+} rsx_vg_draw;
+
+/* Why a draw stays on the CPU path ([vtx-gpu] log columns). */
+enum { RSX_VG_OK = 0, RSX_VG_NO_INPUTS, RSX_VG_DIVIDED, RSX_VG_UNMAPPED, RSX_VG_TYPE, RSX_VG_BIG, RSX_VG_REASONS };
+
+/* The per-vertex payload: the element index every non-divided attribute reads (rsx_vertex_element_index with
+ * frequency <= 1; the host test compares the two). */
+static inline u32 rsx_vg_element(const rsx_vertex_ref* r) { return (r->vertex_id + r->base_index) & 0x000FFFFFu; }
+
+/* Plan one draw from a prepared fetch plan (rsx_vertex_fetch_plan_prepare over the draw's unique refs): every
+ * enabled attribute of the layout needs its whole element range mapped (stable_base), frequency <= 1 and a known
+ * type; otherwise the draw keeps the CPU path and the reason is returned. */
+static inline int rsx_vg_plan(const rsx_vertex_fetch_plan* p, u32 max_block, rsx_vg_draw* d)
+{
+    if (!p->layout.count) return RSX_VG_NO_INPUTS;
+    memset(d->table, 0, sizeof d->table);
+    for (u32 a = 0; a < RSX_DSP_NUM_VERTEX_ATTR; a++) d->table[a].dflt[3] = 1.0f;
+    struct { const u8* src; u64 bytes; } cand[RSX_DSP_NUM_VERTEX_ATTR];
+    u32 nc = 0;
+    for (u32 s = 0; s < p->layout.count; s++) {
+        const u32 a = p->layout.attrs[s];
+        const rsx_vertex_fetch_attr* f = &p->attr[a];
+        if (!f->desc.type || !f->desc.size) { memcpy(d->table[a].dflt, f->default_value, 16); continue; }
+        if (f->desc.frequency > 1) return RSX_VG_DIVIDED;
+        if (f->desc.type < 1 || f->desc.type > 7 || !f->elem_size) return RSX_VG_TYPE;
+        if (!f->stable_base) return RSX_VG_UNMAPPED;
+        const u64 bytes = (u64)(f->stable_last - f->stable_first) * f->stride + f->elem_size;
+        if (bytes > max_block) return RSX_VG_BIG;
+        cand[nc].src = f->stable_base; cand[nc].bytes = bytes; nc++;
+    }
+    for (u32 i = 1; i < nc; i++)   /* by host address, then merge overlapping or touching ranges */
+        for (u32 j = i; j > 0 && cand[j].src < cand[j - 1].src; j--) {
+            const u8* ts = cand[j].src; const u64 tb = cand[j].bytes;
+            cand[j] = cand[j - 1]; cand[j - 1].src = ts; cand[j - 1].bytes = tb;
+        }
+    u64 cursor = RSX_VG_TABLE_BYTES;
+    d->n_span = 0;
+    for (u32 i = 0; i < nc; i++) {
+        rsx_vg_span* last = d->n_span ? &d->span[d->n_span - 1] : NULL;
+        if (last && cand[i].src <= last->src + last->bytes) {
+            const u64 end = (u64)(cand[i].src - last->src) + cand[i].bytes;
+            if (end > last->bytes) { cursor += end - last->bytes; last->bytes = (u32)end; }
+            continue;
+        }
+        cursor = ((cursor + 15u) & ~(u64)15u) + ((uintptr_t)cand[i].src & 3u);
+        rsx_vg_span* sp = &d->span[d->n_span++];
+        sp->src = cand[i].src; sp->bytes = (u32)cand[i].bytes; sp->dst = (u32)cursor;
+        cursor += cand[i].bytes;
+    }
+    cursor = (cursor + 15u) & ~(u64)15u;
+    if (cursor > max_block) return RSX_VG_BIG;
+    d->block_bytes = (u32)cursor;
+    for (u32 s = 0; s < p->layout.count; s++) {
+        const u32 a = p->layout.attrs[s];
+        const rsx_vertex_fetch_attr* f = &p->attr[a];
+        if (!f->desc.type || !f->desc.size) continue;
+        const rsx_vg_span* sp = d->span;
+        while (!(f->stable_base >= sp->src && f->stable_base < sp->src + sp->bytes)) sp++;
+        const u32 first_at = sp->dst + (u32)(f->stable_base - sp->src);
+        rsx_vg_attr* t = &d->table[a];
+        t->stride = f->stride;
+        t->base = first_at - f->stable_first * f->stride;
+        t->lim = first_at + (f->stable_last - f->stable_first) * f->stride;
+        t->fmt = f->desc.type | ((f->desc.size < 4u ? f->desc.size : 4u) << 4);
+    }
+    return RSX_VG_OK;
+}
+
+/* Write the block: table, then the spans (dst must hold d->block_bytes). */
+static inline void rsx_vg_write_block(const rsx_vg_draw* d, u8* dst)
+{
+    memcpy(dst, d->table, sizeof d->table);
+    for (u32 i = 0; i < d->n_span; i++) memcpy(dst + d->span[i].dst, d->span[i].src, d->span[i].bytes);
+}
+
+/* The decode table, filled by the CPU decoder itself (exact by construction). */
+static inline void rsx_vg_lut_build(float* lut)
+{
+    float o[4];
+    u8 b[4] = {0, 0, 0, 0};
+    for (u32 i = 0; i < 256u; i++) {
+        b[0] = (u8)i; rsx_vertex_decode_element(RSX_VTX_TYPE_UNORM8, 1, b, o); lut[RSX_VG_LUT_UNORM8 + i] = o[0];
+    }
+    for (u32 i = 0; i < 65536u; i++) {
+        b[0] = (u8)(i >> 8); b[1] = (u8)i; rsx_vertex_decode_element(RSX_VTX_TYPE_SNORM16, 1, b, o);
+        lut[RSX_VG_LUT_SNORM16 + i] = o[0];
+    }
+    for (u32 i = 0; i < 2048u; i++) {   /* x field = i */
+        b[0] = 0; b[1] = 0; b[2] = (u8)(i >> 8); b[3] = (u8)i;
+        rsx_vertex_decode_element(RSX_VTX_TYPE_CMP32, 1, b, o); lut[RSX_VG_LUT_CMPXY + i] = o[0];
+    }
+    for (u32 i = 0; i < 1024u; i++) {   /* z field = i: bits 22-31 */
+        const u32 w = i << 22;
+        b[0] = (u8)(w >> 24); b[1] = (u8)(w >> 16); b[2] = 0; b[3] = 0;
+        rsx_vertex_decode_element(RSX_VTX_TYPE_CMP32, 1, b, o); lut[RSX_VG_LUT_CMPZ + i] = o[2];
+    }
+}
+
+#ifdef RSX_VG_C_REFERENCE
+/* The shared decode as C, for host tests: the includer defines VG_RAW(a) and VG_LUT(i) first. */
+typedef unsigned int rsx_vg_uint;
+#define uint rsx_vg_uint
+#define VG_FN static inline
+static inline float asfloat(uint w) { float f; memcpy(&f, &w, sizeof f); return f; }
+static inline int asint(uint w) { int i; memcpy(&i, &w, sizeof i); return i; }
+RSX_VG_SHARED(RSX_VG_CODE)
+#undef uint
+#endif
+
+#endif /* PS3RECOMP_RSX_VTX_GPU_H */
