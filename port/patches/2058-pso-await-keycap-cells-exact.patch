+/* RSX pass 57: a block that also holds texels outside every prompt cell. The block keeps its endpoints (colour and
+ * alpha) and those texels' indices, so they decode exactly as before; only the texels inside a cell get new
+ * indices, the nearest of the block's own palette. in[i] = 1 for a texel inside a cell. */
+static void kc_bc3_encode_keep(const uint8_t px[16][4], const uint8_t in[16], uint8_t* b)
+{
+    int al[8]; al[0] = b[0]; al[1] = b[1];
+    if (al[0] > al[1]) for (int k = 0; k < 6; k++) al[2 + k] = ((6 - k) * al[0] + (k + 1) * al[1]) / 7;
+    else { for (int k = 0; k < 4; k++) al[2 + k] = ((4 - k) * al[0] + (k + 1) * al[1]) / 5; al[6] = 0; al[7] = 255; }
+    uint64_t ab = 0; for (int i = 0; i < 6; i++) ab |= (uint64_t)b[2 + i] << (8 * i);
+    int p[4][3];
+    kc_565((uint16_t)(b[8] | (b[9] << 8)), p[0]); kc_565((uint16_t)(b[10] | (b[11] << 8)), p[1]);
+    for (int k = 0; k < 3; k++) { p[2][k] = (2 * p[0][k] + p[1][k]) / 3; p[3][k] = (p[0][k] + 2 * p[1][k]) / 3; }
+    uint32_t cb = (uint32_t)b[12] | ((uint32_t)b[13] << 8) | ((uint32_t)b[14] << 16) | ((uint32_t)b[15] << 24);
+    for (int i = 0; i < 16; i++) {
+        if (!in[i]) continue;
+        int best = 0, bd = 1 << 30;
+        for (int k = 0; k < 8; k++) { int d = abs(al[k] - px[i][3]); if (d < bd) { bd = d; best = k; } }
+        ab = (ab & ~((uint64_t)7 << (3 * i))) | ((uint64_t)best << (3 * i));
+        best = 0; bd = 1 << 30;
+        for (int k = 0; k < 4; k++) {
+            int d0 = p[k][0] - px[i][0], d1 = p[k][1] - px[i][1], d2 = p[k][2] - px[i][2];
+            int d = d0 * d0 * 2 + d1 * d1 * 5 + d2 * d2;
+            if (d < bd) { bd = d; best = k; }
+        }
+        cb = (cb & ~(3u << (2 * i))) | ((uint32_t)best << (2 * i));
+    }
+    for (int i = 0; i < 6; i++) b[2 + i] = (uint8_t)(ab >> (8 * i));
+    b[12] = (uint8_t)cb; b[13] = (uint8_t)(cb >> 8); b[14] = (uint8_t)(cb >> 16); b[15] = (uint8_t)(cb >> 24);
+}
