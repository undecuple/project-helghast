+/*
+ * KZ3 patch 2037: keyboard/mouse -> pad bindings read from a human-readable file (hook C).
+ *
+ * Pure C, no platform headers: the key codes are Windows virtual-key numbers written out, so the parser, the
+ * default table and the writer build and run anywhere (host test: tools/smoke/test_pad_keybinds.sh). cellPad.c
+ * includes this once, reads the file, polls the keys with GetAsyncKeyState and merges the result into port 0.
+ *
+ * File (keybinds.ini), one line per pad input:   <input> = <primary key>[, <secondary key>]
+ *   inputs: up down left right cross circle square triangle l1 r1 l2 r2 l3 r3 start select
+ *           ls_up ls_down ls_left ls_right rs_up rs_down rs_left rs_right  (sticks: any two keys of one stick
+ *           held together give the diagonal, so four keys cover the eight directions)
+ *   keys:   names from pad_kb_keys[] below (A-Z, 0-9, F1-F12, Space, Enter, Escape, ..., Mouse1-Mouse5), case
+ *           does not matter; "none" (or nothing) = unbound.
+ * '#' or ';' starts a comment; a "[keyboard]" header is optional, other sections are skipped (reserved for later
+ * pages: gamepad remap, mouse look). A line with an unknown input, an unknown key or more than two keys is logged
+ * and the bad part ignored; nothing in the file is ever fatal. An input missing from the file keeps its default.
+ */
+#ifndef PAD_KEYBINDS_H
+#define PAD_KEYBINDS_H
+
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+
+#define PKB_SLOTS 2
+
+/* pad bit values = CELL_PAD_CTRL_* as packed in PadHostState.buttons (cellPad.h) */
+enum {
+    PKB_SELECT = 0x0001, PKB_L3 = 0x0002, PKB_R3 = 0x0004, PKB_START = 0x0008,
+    PKB_UP = 0x0010, PKB_RIGHT = 0x0020, PKB_DOWN = 0x0040, PKB_LEFT = 0x0080,
+    PKB_L2 = 0x0100, PKB_R2 = 0x0200, PKB_L1 = 0x0400, PKB_R1 = 0x0800,
+    PKB_TRIANGLE = 0x1000, PKB_CIRCLE = 0x2000, PKB_CROSS = 0x4000, PKB_SQUARE = 0x8000
+};
+
+/* stick directions: bit index in PadKbState.dirs */
+enum { PKB_LS_UP, PKB_LS_DOWN, PKB_LS_LEFT, PKB_LS_RIGHT, PKB_RS_UP, PKB_RS_DOWN, PKB_RS_LEFT, PKB_RS_RIGHT };
+
+typedef struct { const char* name; unsigned short btn; signed char dir; const char* what; } PadKbInput;
+
+/* The order is the file's order. `what` is the Standard preset's main use (the RE notes 5.3). */
+static const PadKbInput pad_kb_inputs[] = {
+    { "up",       PKB_UP,       -1, "d-pad up (zoom mode)" },
+    { "down",     PKB_DOWN,     -1, "d-pad down" },
+    { "left",     PKB_LEFT,     -1, "d-pad left" },
+    { "right",    PKB_RIGHT,    -1, "d-pad right" },
+    { "cross",    PKB_CROSS,    -1, "jump, vault; menu accept" },
+    { "circle",   PKB_CIRCLE,   -1, "use; menu back" },
+    { "square",   PKB_SQUARE,   -1, "reload, pick up weapon" },
+    { "triangle", PKB_TRIANGLE, -1, "next weapon" },
+    { "l1",       PKB_L1,       -1, "close combat" },
+    { "r1",       PKB_R1,       -1, "fire" },
+    { "l2",       PKB_L2,       -1, "crouch, cover, slide" },
+    { "r2",       PKB_R2,       -1, "throw grenade" },
+    { "l3",       PKB_L3,       -1, "sprint" },
+    { "r3",       PKB_R3,       -1, "zoom, flashlight" },
+    { "start",    PKB_START,    -1, "pause menu" },
+    { "select",   PKB_SELECT,   -1, "select" },
+    { "ls_up",    0, PKB_LS_UP,    "move forward (left stick up)" },
+    { "ls_down",  0, PKB_LS_DOWN,  "move back" },
+    { "ls_left",  0, PKB_LS_LEFT,  "strafe left" },
+    { "ls_right", 0, PKB_LS_RIGHT, "strafe right" },
+    { "rs_up",    0, PKB_RS_UP,    "look up (right stick up)" },
+    { "rs_down",  0, PKB_RS_DOWN,  "look down" },
+    { "rs_left",  0, PKB_RS_LEFT,  "turn left" },
+    { "rs_right", 0, PKB_RS_RIGHT, "turn right" },
+};
+#define PKB_N_INPUTS ((int)(sizeof pad_kb_inputs / sizeof pad_kb_inputs[0]))
+
+typedef struct { const char* name; unsigned char vk; } PadKbKey;
+
+/* Windows virtual-key codes. Mouse1-5 = left, right, middle, X1, X2 (GetAsyncKeyState reads them too). */
+static const PadKbKey pad_kb_keys[] = {
+    { "Mouse1", 0x01 }, { "Mouse2", 0x02 }, { "Mouse3", 0x04 }, { "Mouse4", 0x05 }, { "Mouse5", 0x06 },
+    { "Backspace", 0x08 }, { "Tab", 0x09 }, { "Enter", 0x0D }, { "Pause", 0x13 }, { "CapsLock", 0x14 },
+    { "Escape", 0x1B }, { "Space", 0x20 }, { "PageUp", 0x21 }, { "PageDown", 0x22 }, { "End", 0x23 },
+    { "Home", 0x24 }, { "Left", 0x25 }, { "Up", 0x26 }, { "Right", 0x27 }, { "Down", 0x28 },
