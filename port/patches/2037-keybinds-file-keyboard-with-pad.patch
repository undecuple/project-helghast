+    { "O", 0x4F }, { "P", 0x50 }, { "Q", 0x51 }, { "R", 0x52 }, { "S", 0x53 }, { "T", 0x54 }, { "U", 0x55 },
+    { "V", 0x56 }, { "W", 0x57 }, { "X", 0x58 }, { "Y", 0x59 }, { "Z", 0x5A },
+    { "Numpad0", 0x60 }, { "Numpad1", 0x61 }, { "Numpad2", 0x62 }, { "Numpad3", 0x63 }, { "Numpad4", 0x64 },
+    { "Numpad5", 0x65 }, { "Numpad6", 0x66 }, { "Numpad7", 0x67 }, { "Numpad8", 0x68 }, { "Numpad9", 0x69 },
+    { "NumpadMultiply", 0x6A }, { "NumpadAdd", 0x6B }, { "NumpadSubtract", 0x6D }, { "NumpadDecimal", 0x6E },
+    { "NumpadDivide", 0x6F },
+    { "F1", 0x70 }, { "F2", 0x71 }, { "F3", 0x72 }, { "F4", 0x73 }, { "F5", 0x74 }, { "F6", 0x75 },
+    { "F7", 0x76 }, { "F8", 0x77 }, { "F9", 0x78 }, { "F10", 0x79 }, { "F11", 0x7A }, { "F12", 0x7B },
+    { "LeftShift", 0xA0 }, { "RightShift", 0xA1 }, { "LeftCtrl", 0xA2 }, { "RightCtrl", 0xA3 },
+    { "LeftAlt", 0xA4 }, { "RightAlt", 0xA5 },
+    { "Semicolon", 0xBA }, { "Equals", 0xBB }, { "Comma", 0xBC }, { "Minus", 0xBD }, { "Period", 0xBE },
+    { "Slash", 0xBF }, { "Grave", 0xC0 }, { "LeftBracket", 0xDB }, { "Backslash", 0xDC },
+    { "RightBracket", 0xDD }, { "Apostrophe", 0xDE },
+};
+#define PKB_N_KEYS ((int)(sizeof pad_kb_keys / sizeof pad_kb_keys[0]))
+
+/* key[i][s] = virtual-key code of input i, slot s (0 = unbound). */
+typedef struct { unsigned char key[PKB_N_INPUTS][PKB_SLOTS]; } PadKeybinds;
+
+/* What the keys add to the pad this poll. */
+typedef struct { unsigned short buttons; unsigned char dirs; } PadKbState;
+
+typedef void (*PadKbLog)(void* ctx, const char* msg);
+
+static int pad_kb_ieq(const char* a, size_t na, const char* b)
+{
+    size_t i;
+    if (strlen(b) != na) return 0;
+    for (i = 0; i < na; i++) {
+        char x = a[i], y = b[i];
+        if (x >= 'A' && x <= 'Z') x = (char)(x - 'A' + 'a');
+        if (y >= 'A' && y <= 'Z') y = (char)(y - 'A' + 'a');
+        if (x != y) return 0;
+    }
+    return 1;
+}
+
+static int pad_kb_key_by_name(const char* s, size_t n)   /* -> vk, 0 = "none", -1 = unknown */
+{
+    int i;
+    if (pad_kb_ieq(s, n, "none")) return 0;
+    for (i = 0; i < PKB_N_KEYS; i++)
+        if (pad_kb_ieq(s, n, pad_kb_keys[i].name)) return pad_kb_keys[i].vk;
+    /* a few spellings people type */
+    if (pad_kb_ieq(s, n, "Return")) return 0x0D;
+    if (pad_kb_ieq(s, n, "Esc")) return 0x1B;
+    if (pad_kb_ieq(s, n, "LShift")) return 0xA0;
+    if (pad_kb_ieq(s, n, "RShift")) return 0xA1;
+    if (pad_kb_ieq(s, n, "LCtrl") || pad_kb_ieq(s, n, "LeftControl")) return 0xA2;
+    if (pad_kb_ieq(s, n, "RCtrl") || pad_kb_ieq(s, n, "RightControl")) return 0xA3;
+    if (pad_kb_ieq(s, n, "LAlt")) return 0xA4;
+    if (pad_kb_ieq(s, n, "RAlt")) return 0xA5;
+    if (pad_kb_ieq(s, n, "LeftMouse") || pad_kb_ieq(s, n, "MouseLeft")) return 0x01;
+    if (pad_kb_ieq(s, n, "RightMouse") || pad_kb_ieq(s, n, "MouseRight")) return 0x02;
+    if (pad_kb_ieq(s, n, "MiddleMouse") || pad_kb_ieq(s, n, "MouseMiddle")) return 0x04;
+    return -1;
+}
+
+static const char* pad_kb_key_name(int vk)
+{
+    int i;
+    for (i = 0; i < PKB_N_KEYS; i++)
+        if (pad_kb_keys[i].vk == vk) return pad_kb_keys[i].name;
+    return "none";
+}
+
+static int pad_kb_input_by_name(const char* s, size_t n)
+{
+    int i;
+    for (i = 0; i < PKB_N_INPUTS; i++)
+        if (pad_kb_ieq(s, n, pad_kb_inputs[i].name)) return i;
+    return -1;
+}
+
+/* Defaults (PC layout on top of the Standard preset; ENHANCEMENT). Mouse look is not wired yet, so the
+ * right stick is on I/J/K/L and the numpad. */
+static void pad_kb_defaults(PadKeybinds* kb)
+{
+    static const struct { const char* in; unsigned char a, b; } d[] = {
+        { "up", 0x26, 0 }, { "down", 0x28, 0 }, { "left", 0x25, 0 }, { "right", 0x27, 0 },
+        { "cross", 0x20, 0x0D },       /* Space, Enter */
+        { "circle", 0x45, 0x08 },      /* E, Backspace */
+        { "square", 0x52, 0 },         /* R */
+        { "triangle", 0x51, 0 },       /* Q */
+        { "l1", 0x46, 0 },             /* F */
+        { "r1", 0x01, 0x4F },          /* Mouse1, O */
+        { "l2", 0x43, 0xA2 },          /* C, LeftCtrl */
+        { "r2", 0x47, 0 },             /* G */
+        { "l3", 0xA0, 0 },             /* LeftShift */
+        { "r3", 0x02, 0x56 },          /* Mouse2, V */
+        { "start", 0x1B, 0x50 },       /* Escape, P */
+        { "select", 0x09, 0 },         /* Tab */
+        { "ls_up", 0x57, 0 }, { "ls_down", 0x53, 0 }, { "ls_left", 0x41, 0 }, { "ls_right", 0x44, 0 },
+        { "rs_up", 0x49, 0x68 }, { "rs_down", 0x4B, 0x62 }, { "rs_left", 0x4A, 0x64 }, { "rs_right", 0x4C, 0x66 },
+    };
+    unsigned i;
+    memset(kb, 0, sizeof *kb);
+    for (i = 0; i < sizeof d / sizeof d[0]; i++) {
+        int k = pad_kb_input_by_name(d[i].in, strlen(d[i].in));
+        if (k >= 0) { kb->key[k][0] = d[i].a; kb->key[k][1] = d[i].b; }
+    }
+}
+
+static void pad_kb_logf(PadKbLog log, void* ctx, int line, const char* what, const char* s, size_t n)
+{
+    char m[200];
+    if (!log) return;
+    if (n > 60) n = 60;
+    snprintf(m, sizeof m, "line %d: %s '%.*s' (ignored)", line, what, (int)n, s);
+    log(ctx, m);
+}
+
+static int pad_kb_space(char c) { return c == ' ' || c == '\t' || c == '\r'; }
+
+/* Parse `text` over the bindings already in *kb (start from pad_kb_defaults). Returns the number of problems
+ * logged (0 = clean file). Never fails. */
+static int pad_kb_parse(PadKeybinds* kb, const char* text, PadKbLog log, void* ctx)
+{
+    const char* p = text;
+    int line = 0, bad = 0, in_kb = 1;
+    if (!text) return 0;
+    if ((unsigned char)p[0] == 0xEF && (unsigned char)p[1] == 0xBB && (unsigned char)p[2] == 0xBF) p += 3;
+    while (*p) {
+        const char* e = p;
+        const char *a, *b, *eq, *c;
+        while (*e && *e != '\n') e++;
+        line++;
+        /* strip the comment and the blanks around the line */
+        for (c = p; c < e && *c != '#' && *c != ';'; c++) {}
+        a = p; b = c;
+        while (a < b && pad_kb_space(*a)) a++;
+        while (b > a && pad_kb_space(b[-1])) b--;
+        if (a < b) {
+            if (*a == '[') {
+                const char* r = memchr(a, ']', (size_t)(b - a));
+                if (!r) { pad_kb_logf(log, ctx, line, "broken section header", a, (size_t)(b - a)); bad++; in_kb = 0; }
+                else {
+                    in_kb = pad_kb_ieq(a + 1, (size_t)(r - a - 1), "keyboard");
+                    if (!in_kb) { pad_kb_logf(log, ctx, line, "section not read by this version", a, (size_t)(r - a + 1)); }
+                }
+            } else if (in_kb) {
+                eq = memchr(a, '=', (size_t)(b - a));
+                if (!eq) { pad_kb_logf(log, ctx, line, "no '=' in", a, (size_t)(b - a)); bad++; }
+                else {
+                    const char* ne = eq;
+                    int in;
+                    while (ne > a && pad_kb_space(ne[-1])) ne--;
+                    in = pad_kb_input_by_name(a, (size_t)(ne - a));
+                    if (in < 0) { pad_kb_logf(log, ctx, line, "unknown pad input", a, (size_t)(ne - a)); bad++; }
+                    else {
+                        unsigned char got[PKB_SLOTS] = { 0 };
+                        int ng = 0, nbad = 0, nnone = 0;
+                        const char* t = eq + 1;
+                        while (t < b) {
+                            const char* te;
+                            const char* tb;
+                            int vk;
+                            while (t < b && (pad_kb_space(*t) || *t == ',')) t++;
+                            if (t >= b) break;
+                            tb = t;
+                            for (te = t; te < b && *te != ','; te++) {}
+                            t = te;
+                            while (te > tb && pad_kb_space(te[-1])) te--;
+                            vk = pad_kb_key_by_name(tb, (size_t)(te - tb));
+                            if (vk < 0) { pad_kb_logf(log, ctx, line, "unknown key", tb, (size_t)(te - tb)); bad++; nbad++; }
+                            else if (vk == 0) nnone++;
+                            else if (ng >= PKB_SLOTS) { pad_kb_logf(log, ctx, line, "more than two keys, extra key", tb, (size_t)(te - tb)); bad++; }
+                            else got[ng++] = (unsigned char)vk;
+                        }
+                        if (ng == 0 && nbad > 0 && nnone == 0) {
+                            pad_kb_logf(log, ctx, line, "no usable key, default kept for", a, (size_t)(ne - a));
+                        } else {
+                            kb->key[in][0] = got[0];
+                            kb->key[in][1] = got[1];
+                        }
+                    }
+                }
+            }
+        }
+        p = *e ? e + 1 : e;
+    }
+    return bad;
+}
+
+/* Is `vk` held? The poller supplies the host query (GetAsyncKeyState on Windows, a table in the test). */
+typedef int (*PadKbDown)(void* ctx, int vk);
+
+static PadKbState pad_kb_eval(const PadKeybinds* kb, PadKbDown down, void* ctx)
+{
+    PadKbState st = { 0, 0 };
+    int i, s;
+    for (i = 0; i < PKB_N_INPUTS; i++)
+        for (s = 0; s < PKB_SLOTS; s++)
+            if (kb->key[i][s] && down(ctx, kb->key[i][s])) {
+                if (pad_kb_inputs[i].dir >= 0) st.dirs |= (unsigned char)(1u << pad_kb_inputs[i].dir);
+                else st.buttons |= pad_kb_inputs[i].btn;
+                break;
+            }
+    return st;
+}
+
+/* Stick axis from two opposite directions: both or neither = centre (128), else 0 or 255 (full deflection, also
+ * on a diagonal; ASSUMPTION: the game's own dead zone and response curve want the raw range like a DS3 corner). */
+static unsigned char pad_kb_axis(unsigned char dirs, int neg, int pos)
+{
+    int n = (dirs >> neg) & 1, q = (dirs >> pos) & 1;
+    return (unsigned char)(n == q ? 128 : n ? 0 : 255);
+}
+
+/* Write the bindings as the file's text. Returns the length (like snprintf; > n-1 = truncated). */
+static int pad_kb_format(const PadKeybinds* kb, char* buf, size_t n)
+{
+    size_t o = 0;
+    int i;
+#define PKB_PUT(...) do { int w_ = snprintf(buf + (o < n ? o : n), o < n ? n - o : 0, __VA_ARGS__); \
+                          if (w_ > 0) o += (size_t)w_; } while (0)
+    PKB_PUT("# Project Helghast key bindings. Written with the defaults on the first start; edit and save, the game\n"
+            "# reads it again within two seconds. Delete this file to get the defaults back.\n"
+            "#\n"
+            "#   <pad input> = <primary key>, <secondary key>      (\"none\" or nothing = unbound)\n"
+            "#\n"
+            "# Keys: A-Z 0-9 F1-F12 Space Enter Escape Tab Backspace CapsLock LeftShift RightShift LeftCtrl\n"
+            "#   RightCtrl LeftAlt RightAlt Up Down Left Right Insert Delete Home End PageUp PageDown Pause\n"
+            "#   Numpad0-Numpad9 NumpadAdd NumpadSubtract NumpadMultiply NumpadDivide NumpadDecimal Semicolon\n"
+            "#   Equals Comma Minus Period Slash Grave LeftBracket RightBracket Backslash Apostrophe\n"
+            "#   Mouse1 (left) Mouse2 (right) Mouse3 (middle) Mouse4 Mouse5\n"
+            "# Sticks: hold two keys of one stick for a diagonal. A pad plugged in works at the same time.\n"
+            "# The uses listed are those of the Standard controller preset (Options > Controls).\n"
+            "\n[keyboard]\n");
+    for (i = 0; i < PKB_N_INPUTS; i++) {
+        char v[64];
+        if (!kb->key[i][0] && !kb->key[i][1]) snprintf(v, sizeof v, "none");
+        else if (!kb->key[i][1]) snprintf(v, sizeof v, "%s", pad_kb_key_name(kb->key[i][0]));
+        else if (!kb->key[i][0]) snprintf(v, sizeof v, "none, %s", pad_kb_key_name(kb->key[i][1]));
+        else snprintf(v, sizeof v, "%s, %s", pad_kb_key_name(kb->key[i][0]), pad_kb_key_name(kb->key[i][1]));
+        PKB_PUT("%-9s= %-22s# %s\n", pad_kb_inputs[i].name, v, pad_kb_inputs[i].what);
+    }
+#undef PKB_PUT
+    return (int)o;
+}
+
+/* kz3-install.ini (written by the installer / portable zip, read by tools/release/launch.py read_ini): is
+ * [install] portable = 1? Same rule as launch.py: portable only when the value is exactly "1". */
+static int pad_kb_ini_portable(const char* text)
+{
+    const char* p = text;
+    int in_install = 0;
+    if (!text) return 0;
+    while (*p) {
+        const char* e = p;
+        const char *a, *b;
+        while (*e && *e != '\n') e++;
+        a = p; b = e;
+        while (a < b && pad_kb_space(*a)) a++;
+        while (b > a && pad_kb_space(b[-1])) b--;
+        if (a < b && *a == '[') {
+            const char* r = memchr(a, ']', (size_t)(b - a));
+            in_install = r && r - a - 1 == 7 && memcmp(a + 1, "install", 7) == 0;   /* configparser: case-sensitive */
+        } else if (in_install && a < b && *a != '#' && *a != ';') {
+            const char* eq = a;
+            while (eq < b && *eq != '=' && *eq != ':') eq++;
+            if (eq < b) {
+                const char* ke = eq;
+                const char* v = eq + 1;
+                while (ke > a && pad_kb_space(ke[-1])) ke--;
+                while (v < b && pad_kb_space(*v)) v++;
+                if (pad_kb_ieq(a, (size_t)(ke - a), "portable")) return (b - v == 1 && *v == '1');
+            }
+        }
+        p = *e ? e + 1 : e;
+    }
+    return 0;
+}
