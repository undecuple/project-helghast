+/* Patch 2203: decode_d is timed on 1 word in RSX_SPLIT_DSAMPLE (a push/pop pair on every word added several ms per flip of
+ * phantom to the decode bucket). d0 is acc[DECODE_D] before the sampled word; the word's own decode_d time d is multiplied
+ * by `scale` and the (scale-1)*d extra is taken from the bucket that owned the clock (the unsampled words' time sat there),
+ * so the buckets still add up to the walk. scale 1 = off.
+ * The extra is credited to decode_d at once, but its debit from that bucket is only applied at the pass end (rsx_split_settle),
+ * clamped to what the bucket accumulated this pass (a per-pass bucket never goes below 0, so no per-flip value prints
+ * negative); the part that did not fit stays in owed[] and is debited from a later pass, so the total is kept and only
+ * what is still owed when the run ends is missing. (Debiting at the sample instead cannot work on short passes: the
+ * unsampled words' time of earlier passes is already flushed and the pass-local bucket is too small.) */
+#define RSX_SPLIT_DSAMPLE 32
+static inline void rsx_split_scale_d(rsx_split* s, long long d0, int scale, long long* owed)
+{
+    const long long d = s->acc[RSX_SB_DECODE_D] - d0;
+    if (scale <= 1 || d <= 0 || s->cur == RSX_SB_DECODE_D) return;
+    s->acc[RSX_SB_DECODE_D] += d * (scale - 1);
+    owed[s->cur] += d * (scale - 1);
+}
+/* Debit owed[] from the pass's buckets, never below 0; call once per pass after rsx_split_end, before the flush. */
+static inline void rsx_split_settle(rsx_split* s, long long* owed)
+{
+    for (int i = 0; i < RSX_SB_N; i++) {
+        if (owed[i] <= 0) continue;
+        const long long have = s->acc[i] > 0 ? s->acc[i] : 0, mv = owed[i] < have ? owed[i] : have;
+        s->acc[i] -= mv; owed[i] -= mv;
+    }
+}
+/* The sampler: every word bumps *words (the per-pass count, flushed as a delta) and *phase (the sampler's own counter, which
+ * persists across walk passes: a per-pass phase never samples a pass of fewer than RSX_SPLIT_DSAMPLE words and always
+ * samples the same positions of a longer one). 1 in RSX_SPLIT_DSAMPLE is timed (dsel), opens decode_d and remembers
+ * acc[DECODE_D] in *d0. */
+static inline int rsx_split_dsel(unsigned long long* phase, unsigned long long* words, unsigned long long* timed)   /* 1 = time this word; no clock read otherwise */
+{
+    ++*words;
+    if ((++*phase & (RSX_SPLIT_DSAMPLE - 1u)) != 0) return 0;
+    ++*timed;
+    return 1;
+}
+static inline int rsx_split_dpush(rsx_split* s, long long* d0, long long now)   /* call only when dsel said 1 */
+{
+    *d0 = s->acc[RSX_SB_DECODE_D];
+    return rsx_split_push(s, RSX_SB_DECODE_D, now);
+}
+static inline void rsx_split_dpop(rsx_split* s, int tok, long long d0, int scale, long long* owed, long long now)
+{
+    rsx_split_pop(s, tok, now);
+    rsx_split_scale_d(s, d0, scale, owed);
+}
+/* [perf-split-cost]: what the split itself cost in calls (words seen, commands, words that paid a timer pair). */
+static inline int rsx_split_fmt_cost(char* out, size_t n, double t, long long flips, unsigned long long words,
+                                     unsigned long long cmds, unsigned long long timed)
+{
+    const double f = flips > 0 ? (double)flips : 1.0;
+    return snprintf(out, n, "[perf-split-cost] t=%.0f words=%.0f commands=%.0f timed_words=%.0f sample=1/%d per_flip",
+                    t, (double)words / f, (double)cmds / f, (double)timed / f, RSX_SPLIT_DSAMPLE);
+}
