+/* KZ3 patch 1074: the ReadyCount imports as atomic updates of the instance byte, the value the kernel and the
+ * policy modules use. The WWS job-manager PM swaps its own readyCount to 0 when its list runs dry and CASes it back
+ * (SPU-side cellSpursReadyCountSwap/CompareAndSwap at PM LS 0x3868/0x37C0, GETLLAR/PUTLLC on the instance line), so
+ * the host copy (s_workloads[].readyCount) the old imports returned and compared against goes stale; and a plain byte
+ * store between the PM's GETLLAR and PUTLLC compare was lost. Here: the byte is read and written under the line's
+ * stripe lock, peer reservations are broken, the host copy follows, and idle SPUs are woken. mode 0 store, 1 swap,
+ * 2 compare-and-swap; returns the old byte. */
+static u32 kz3_ready_update(u32 ea, u32 wid, int mode, u32 compare, u32 value)
+{
+    const uint64_t m = spu_ll_mask(ea, 128);
+    spu_ll_lock_mask(m);
+    volatile u8* b = vm_base + ea + SPURS_WKL_READY1 + wid;
+    const u8 old = *b;
+    const int wr = mode != 2 || old == (u8)compare;
+    if (wr) *b = (u8)value;
+    s_kz3_ready_calls[mode][wid]++; if (wr && old != (u8)value) s_kz3_ready_chg[mode][wid]++;   /* patch 1049 */
+    if (wr) { s_workloads[wid].readyCount = value; spu_coh_notify_write(ea); }
+    spu_ll_unlock_mask(m);
+    if (wr) kz3_kern_wake_ea(ea);
+    return old;
+}
