diff --git a/runtime/spu/spurs_kern_sched.h b/runtime/spu/spurs_kern_sched.h
new file mode 100644
index 00000000..b9686c14
--- /dev/null
+++ b/runtime/spu/spurs_kern_sched.h
@@ -0,0 +1,159 @@
+/* KZ3 patch 1074: the SPURS kernel's workload selection and the idle SPUs' wake, for the per-SPU kernel threads of
+ * libs/spurs/cellSpurs.c (kz3_spu_loop) and the selectWorkload answer to a running policy module (kz3_kern_poll).
+ *
+ * The selection rule and its weight are ported from ps3recomp PR #213 (libs/spurs/spurs_kernel.c, kselect) by
+ * NoahBPeterson (MIT), which models the SPURS1 kernel checked against firmware libsre under RPCS3. Adapted to this
+ * runtime: the instance is read and updated by the caller under the instance line's lock-line stripe (the PM's own
+ * GETLLAR/PUTLLC on the same line then fail and retry, as on hardware), the system service is not modelled (no
+ * workload qualifies = idle), and pending contention (the poll's switch bookkeeping) is not kept.
+ *
+ * A workload qualifies on SPU n when it is runnable (enabled, state 2, a module of this instance), its priority byte
+ * for SPU n (wklInfo +0x18+n) is not 0, its current contention is below maxContention, and it is wanted: signalled,
+ * the workload flag's receiver with the flag at 0, or readyCount != 0 and readyCount + idleSpuCount > contention.
+ * idle_admits (KZ3 pass 58, ASSUMPTION, see below): idleSpuCount > contention alone also qualifies, below every
+ * wanted workload (no "wanted" weight bit). Nothing else ever runs: a workload nobody signalled ready keeps no SPU (the port's old kernel ran every enabled
+ * workload on an idle cadence with maxContention lanes, which with the game's real 5/1 SPUs spun 25 host threads).
+ * Weight, most significant first: wanted (signal, flag, readyCount > contention), the SPU's priority (0x10 - p), is
+ * the workload this SPU ran last, below its minimum contention, fewer SPUs on it, same module uniqueId; ties go to
+ * the lowest wid. Pure C on a byte image of the instance, so tools/spu/test_spurs_kern.sh checks it on the host. */
+/* idle_admits: PR #213's rule (and the RPCS3 kernel it was checked against) needs readyCount != 0, idleSpuCount
+ * only adds SPUs to a workload that has a ready count. KZ3 calls cellSpursRequestIdleSpu(wid, 7) for every job
+ * manager while its kicks already ask for 8 SPUs (above maxContention 5), which would make the request a no-op; and
+ * with readyCount-only admission its first jm_generic list strands at boot (SPU pass 58: the PMs drain the ready
+ * count to 0 while one job runs, the running PM is then told to switch, nothing kicks again). ASSUMPTION tested
+ * (KZ3_SPURS_IDLE_ADMIT=1): an idle SPU (no wanted workload) runs a workload that requested idle SPUs, up to that
+ * count. Run spu-58-gate3 with it: worse (14 flips), so it stays an opt-in experiment. */
+#ifndef SPURS_KERN_SCHED_H
+#define SPURS_KERN_SCHED_H
+#include <stdint.h>
+
+#define KZ3_KSEL_NONE      0x20u   /* no workload: the SPU idles (SPURS_SYS_SERVICE_WID in the firmware) */
+#define KZ3_POLL_READY     1u      /* poll status: readyCount > contention */
+#define KZ3_POLL_SIGNAL    2u
+#define KZ3_POLL_FLAG      4u
+
+enum {
+    KZ3_K_READY1 = 0x00, KZ3_K_IDLE2 = 0x10, KZ3_K_CURCONT = 0x20, KZ3_K_MINCONT = 0x40, KZ3_K_MAXCONT = 0x50,
+    KZ3_K_FLAG = 0x60 /* be u32 flag at +0x0C */, KZ3_K_SIGNAL1 = 0x70 /* be u16, bit 15-wid */,
+    KZ3_K_FLAG_RCV = 0x77, KZ3_K_STATE1 = 0x80, KZ3_K_ENABLED = 0xB0, KZ3_K_INFO1 = 0xB00, KZ3_K_INFO_SZ = 0x20,
+};
+
+static inline uint32_t kz3_k_be32(const uint8_t* p) { return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3]; }
+
+/* Workloads runnable on this instance: `mine` (host table: a module added to this instance) & enabled & state 2. */
+static inline uint16_t kz3_k_runnable(const uint8_t* S, uint16_t mine)
+{
+    const uint16_t en = (uint16_t)(kz3_k_be32(S + KZ3_K_ENABLED) >> 16);
+    uint16_t r = 0;
+    for (uint32_t i = 0; i < 16; i++)
+        if ((mine & en & (0x8000u >> i)) && S[KZ3_K_STATE1 + i] == 2) r |= (uint16_t)(0x8000u >> i);
+    return r;
+}
+
+/* Select a workload for SPU spu_num. S = the instance (big-endian bytes). cur = the workload this SPU ran last
+ * (kernel select) or runs now (poll), KZ3_KSEL_NONE if none. poll = 0: the kernel between modules: the pick's
+ * contention is raised and its signal taken. poll = 1: a running module asks (cellSpursModulePoll): this SPU's own
+ * unit is left out of cur's contention, nothing is written except the signal when the answer is cur. The caller
+ * holds the instance line's stripe lock. Returns the wid or KZ3_KSEL_NONE; *status = KZ3_POLL_* of the pick. */
+static inline uint32_t kz3_ksel(uint8_t* S, uint16_t mine, uint32_t spu_num, uint32_t cur, int poll, int idle_admits,
+                                uint32_t* status)
+{
+    const uint16_t runnable = kz3_k_runnable(S, mine);
+    const uint16_t sig = (uint16_t)(S[KZ3_K_SIGNAL1] << 8 | S[KZ3_K_SIGNAL1 + 1]);
+    const uint32_t flag = kz3_k_be32(S + KZ3_K_FLAG + 0x0C);
+    const uint8_t rcv = S[KZ3_K_FLAG_RCV];
+    const uint8_t cur_uid = cur < 16 ? S[KZ3_K_INFO1 + cur * KZ3_K_INFO_SZ + 0x14] : 0xFF;
+    uint32_t sel = KZ3_KSEL_NONE, st = 0, best = 0;
+    for (uint32_t i = 0; i < 16; i++) {
+        if (!(runnable & (0x8000u >> i))) continue;
+        const uint8_t* info = S + KZ3_K_INFO1 + i * KZ3_K_INFO_SZ;
+        const uint8_t p = spu_num < 8 ? info[0x18 + spu_num] : 0;
+        if (!p) continue;
+        uint32_t cont = S[KZ3_K_CURCONT + i];
+        if (poll && i == cur && cont) cont--;                     /* this SPU's own unit */
+        if (S[KZ3_K_MAXCONT + i] <= cont) continue;
+        const uint32_t ready = S[KZ3_K_READY1 + i] > 8 ? 8u : S[KZ3_K_READY1 + i];
+        const uint32_t idle = S[KZ3_K_IDLE2 + i] > 8 ? 8u : S[KZ3_K_IDLE2 + i];
+        const int wsig = (sig & (0x8000u >> i)) != 0;
+        const int wflag = flag == 0 && rcv == i;
+        if (!(wflag || wsig || (ready && ready + idle > cont) || (idle_admits && idle > cont))) continue;
+        uint32_t w = (wflag || wsig || ready > cont) ? 0x8000u : 0;
+        w |= (uint32_t)((0x10u - (p > 0x0F ? 0x0F : p)) & 0x7F) << 8;
+        w |= i == cur ? 0x80u : 0;
+        w |= (cont > 0 && S[KZ3_K_MINCONT + i] > cont) ? 0x40u : 0;
+        w |= (uint32_t)((8u - (cont > 8 ? 8u : cont)) & 0x0F) << 2;
+        w |= info[0x14] == cur_uid ? 0x02u : 0;
+        w |= 1;
+        if (w > best) {
+            best = w; sel = i;
+            st = (ready > cont ? KZ3_POLL_READY : 0) | (wsig ? KZ3_POLL_SIGNAL : 0) | (wflag ? KZ3_POLL_FLAG : 0);
+        }
+    }
+    if (sel < 16 && (!poll || sel == cur)) {
+        S[KZ3_K_SIGNAL1 + (sel >> 3)] &= (uint8_t)~(0x80u >> (sel & 7));   /* this SPU takes the signal */
+        if (sel == rcv && flag == 0) { S[KZ3_K_FLAG + 0x0C] = S[KZ3_K_FLAG + 0x0D] = S[KZ3_K_FLAG + 0x0E] = S[KZ3_K_FLAG + 0x0F] = 0xFF; }
+    }
+    if (sel < 16 && !poll) S[KZ3_K_CURCONT + sel]++;
+    if (status) *status = st;
+    return sel;
+}
+
+/* The SPU leaves workload wid (its module returned to the kernel). Caller holds the stripe lock. */
+static inline void kz3_kleave(uint8_t* S, uint32_t wid)
+{
+    if (wid < 16 && S[KZ3_K_CURCONT + wid]) S[KZ3_K_CURCONT + wid]--;
+}
+
+/* Idle SPUs of one instance. A real idle SPU waits for its reservation on the instance line to be lost; here an
+ * idle kernel thread sleeps on a condition variable woken by everything the runtime sees change the instance (the
+ * ReadyCount imports, a PUTLLC on an instance line, another SPU leaving a workload, cellSpursWakeUp), and re-reads
+ * the instance at most `ms` later for the guest's own plain stores (PPU code updates readyCount and the signal bits
+ * with inlined lwarx/stwcx., which do not pass through the runtime). gen is read before the instance is evaluated,
+ * so a wake between the evaluation and the wait is never lost. */
+#ifdef _WIN32
+#include <windows.h>
+typedef struct { SRWLOCK lk; CONDITION_VARIABLE cv; volatile LONG gen; } kz3_kwake;
+static inline void kz3_kwake_init(kz3_kwake* w) { InitializeSRWLock(&w->lk); InitializeConditionVariable(&w->cv); w->gen = 0; }
+static inline uint32_t kz3_kwake_gen(kz3_kwake* w) { return (uint32_t)__atomic_load_n(&w->gen, __ATOMIC_ACQUIRE); }
+static inline void kz3_kwake_signal(kz3_kwake* w)
+{
+    AcquireSRWLockExclusive(&w->lk); __atomic_add_fetch(&w->gen, 1, __ATOMIC_ACQ_REL); ReleaseSRWLockExclusive(&w->lk);
+    WakeAllConditionVariable(&w->cv);
+}
+/* Returns 1 when woken (gen moved), 0 on the timeout. */
+static inline int kz3_kwake_wait(kz3_kwake* w, uint32_t seen, unsigned ms)
+{
+    int woke = 1;
+    AcquireSRWLockExclusive(&w->lk);
+    if ((uint32_t)w->gen == seen) { SleepConditionVariableSRW(&w->cv, &w->lk, ms, 0); woke = (uint32_t)w->gen != seen; }
+    ReleaseSRWLockExclusive(&w->lk);
+    return woke;
+}
+#else
+#include <pthread.h>
+#include <time.h>
+typedef struct { pthread_mutex_t lk; pthread_cond_t cv; volatile uint32_t gen; } kz3_kwake;
+static inline void kz3_kwake_init(kz3_kwake* w) { pthread_mutex_init(&w->lk, 0); pthread_cond_init(&w->cv, 0); w->gen = 0; }
+static inline uint32_t kz3_kwake_gen(kz3_kwake* w) { return __atomic_load_n(&w->gen, __ATOMIC_ACQUIRE); }
+static inline void kz3_kwake_signal(kz3_kwake* w)
+{
+    pthread_mutex_lock(&w->lk); __atomic_add_fetch(&w->gen, 1, __ATOMIC_ACQ_REL); pthread_cond_broadcast(&w->cv);
+    pthread_mutex_unlock(&w->lk);
+}
+static inline int kz3_kwake_wait(kz3_kwake* w, uint32_t seen, unsigned ms)
+{
+    int woke = 1;
+    pthread_mutex_lock(&w->lk);
+    if (w->gen == seen) {
+        struct timespec t; clock_gettime(CLOCK_REALTIME, &t);
+        t.tv_sec += ms / 1000; t.tv_nsec += (long)(ms % 1000) * 1000000L;
+        if (t.tv_nsec >= 1000000000L) { t.tv_sec++; t.tv_nsec -= 1000000000L; }
+        while (w->gen == seen && pthread_cond_timedwait(&w->cv, &w->lk, &t) == 0) {}
+        woke = w->gen != seen;
+    }
+    pthread_mutex_unlock(&w->lk);
+    return woke;
+}
+#endif
+
+#endif
