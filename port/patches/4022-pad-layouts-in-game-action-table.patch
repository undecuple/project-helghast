+/*
+ * KZ3 patch 4022 (stage 3, ENHANCEMENT, opt-in): the pad layouts on the game's own action table, pure
+ * (guest memory through two callbacks, host-testable: tools/net/test_pad_actions.c).
+ *
+ * Why: patch 4013 remapped the pad BUTTONS before the game read them, so menus saw the remap too
+ * (Modern put Back on Square, Circle crouched in menus) and vehicles, jetpack, exo and turrets got buttons nobody
+ * chose (Modern: jetpack climb on R3, vehicle reverse on Circle). The game has its own layer for this: every
+ * gameplay action asks ControlScheme::GetActionBinding (v1.00 0x4C79B4, 1.14 0x4D40B8) for its button, and that
+ * reads the active control scheme's action table in the PlayerProfile (the RE notes 5.3-5.4):
+ *   profile = *(u32*)(Game + 0x76C) (v1.00 Game 0x1587880 -> 0x1587FEC; 1.14 Game 0x15FCF80 -> 0x15FD6FC, read by
+ *             the prompt resolver 0x82B588 `lwz r4,0x77c(r25)`),
+ *   block p = profile + 0x1D0 * player, +0xD4 s32 active ControllerConfig ID (1 Standard, 2 Alternate, 3/4 Move/AGP),
+ *             +0xE0 u8 IsMotionControl, +0xE4 s32[84] action -> EButton (0 Tri 1 Circle 2 Cross 3 Square 4 L2 5 R2
+ *             6 L1 7 R1 8 Start 9 Select 10 L3 11 R3 12 Up 13 Right 14 Down 15 Left, 16/17 Move, 20 AGP, -1 none).
+ * Menus read the pad slot directly (not the table), and the game's prompt resolver (0x808D00 / 0x82B4D8) asks the same
+ * GetActionBinding: so a layout written into this table moves gameplay actions and their prompts and leaves every menu
+ * (Cross confirm, Circle back) alone. The swap options (swap sticks, L1/L2, R1/R2) still apply after the table.
+ *
+ * The tables below are the engine's own for Standard and Alternate (the 0x4C2A80 default table with each scheme's
+ * ButtonMappings, the RE notes 5.3; Standard cross-checked byte for byte against a v1.00 PROFILE.DAT).
+ * ASSUMPTION: unchanged in 1.14 (same lump); pab_note_game_table() logs the comparison the first time a block is seen.
+ *
+ * Presets (the [pad] preset of keybinds.ini, pad_remap.h):
+ *   default = the game's table, untouched (a table this file wrote earlier is put back).
+ *   modern  = Killzone Shadow Fall's PS4 default layout (network pass 35), on-foot actions only:
+ *             vehicles / exo / mounted and AA guns keep the scheme's own (they are laid out for the triggers already).
+ *             In PS3 terms; one table for every pad (the host layer reports an Xbox pad as RT = R2, LT = L2, RB = R1,
+ *             LB = L1, A/B/X/Y = Cross/Circle/Square/Triangle, so Xbox gets RT fire, LT aim, RB grenade):
+ *               action                                                  button   Shadow Fall
+ *               PrimaryFire, SecondaryFire, GrabRightHand               R2       R2 fire
+ *               ZoomSwitch (aim), GrabLeftHand                          L2       L2 aim
+ *               QuickThrow (grenade)                                    R1       R1 grenade
+ *               Crouch, Slide, Cover, JetpackClimb                      Circle   Circle crouch (Use, DoItNow stay there:
+ *                                                                                Circle interact)
+ *               CloseCombat (melee), TriggerC4                          R3       R3 melee (ToggleFlashlight stays R3)
+ *             Unchanged: Reload / PickupWeapon Square, Jump / Vault / JetpackBoost Cross, NextWeapon Triangle, Sprint L3,
+ *             d-pad Up = Direction (PlanPath) / Sniper zoom (the game's own objective pointer; MP: objectives), Select =
+ *             Objectives.
+ *             No KZ3 equivalent (the RE notes s.29): Shadow Fall's d-pad down alt-fire toggle (KZ3's SecondaryFire is
+ *             a second action on the fire button in every scheme of the game, and d-pad Down is its Sidearm quick
+ *             select, so SecondaryFire stays with fire). JetpackClimb joins crouch as in the game's Alternate scheme
+ *             (L2 there), not aim. L1 has no on-foot action left.
+ *             pab_modern_r34 is network pass 34's Modern (kept only to recognise a table saved under it).
+ *   custom  = keybinds.ini's per-button table (src[g] = the pad button that does what game button g did): an action
+ *             the scheme puts on button g goes to src[g] (none -> unbound).
+ * Suicide (22) and StandUp (23) are never written (the game's own ApplyControllerConfig skips them too).
+ */
+#ifndef PAD_ACTIONS_H
+#define PAD_ACTIONS_H
+
+#include <stdint.h>
+#include <string.h>
+
+#define PAB_N 84
+#define PAB_BLOCK_STRIDE 0x1D0u
+#define PAB_OFF_ID 0xD4u
+#define PAB_OFF_MOTION 0xE0u
+#define PAB_OFF_TABLE 0xE4u
+
+/* EButton ids */
+enum { PAB_TRI = 0, PAB_CIRCLE, PAB_CROSS, PAB_SQUARE, PAB_L2, PAB_R2, PAB_L1, PAB_R1, PAB_START, PAB_SELECT, PAB_L3,
+       PAB_R3, PAB_UP, PAB_RIGHT, PAB_DOWN, PAB_LEFT };
+
+/* Standard (ID 1) and Alternate (ID 2), EDeviceFunction 0..83. */
+static const signed char pab_std[PAB_N] = {
+    7, 7, 11, 12, 10, 2, 1, 3, -1, 5, 3, 20, 4, 4, 4, 2, -1, 0, 1, 11, 6, 6, 2, 3, 12, -1, -1, -1, 2, 16, 6, 7, -1, 5,
+    7, 6, 7, 2, 3, 1, 15, 13, 1, 11, 10, 5, 4, 2, 3, 6, 7, 6, 4, 5, 6, 4, 6, 7, 11, 0, 2, 10, 6, 0, 7, 6, 7, 6, 11, 6,
+    2, 12, 14, 15, 13, 9, 8, 9, 15, 14, 13, 12, -1, -1 };
+static const signed char pab_alt[PAB_N] = {
+    7, 7, 6, 12, 10, 2, 1, 3, -1, 5, 3, 20, 4, 4, 4, 2, -1, 0, 1, 11, 11, 6, 2, 3, 12, -1, -1, -1, 2, 16, 6, 7, -1, 5,
+    7, 5, 7, 2, 3, 1, 15, 13, 1, 6, 10, 5, 4, 2, 3, 6, 7, 6, 4, 5, 6, 4, 5, 7, 6, 0, 2, 10, 5, 0, 5, 7, 5, 7, 6, 4, 2,
+    12, 14, 15, 13, 9, 8, 9, 15, 14, 13, 12, -1, -1 };
+
+/* EDeviceFunction ids the presets name */
+enum { PAB_A_PRIMARYFIRE = 0, PAB_A_SECONDARYFIRE = 1, PAB_A_ZOOMSWITCH = 2, PAB_A_USE = 6, PAB_A_QUICKTHROW = 9,
+       PAB_A_CROUCH = 12, PAB_A_SLIDE = 13, PAB_A_COVER = 14, PAB_A_DOITNOW = 18, PAB_A_FLASHLIGHT = 19,
+       PAB_A_CLOSECOMBAT = 20, PAB_A_TRIGGERC4 = 21, PAB_A_SUICIDE = 22, PAB_A_STANDUP = 23, PAB_A_GRABLEFT = 30,
+       PAB_A_GRABRIGHT = 31, PAB_A_JETPACKCLIMB = 69 };
+
+static int pab_skip(int a) { return a == PAB_A_SUICIDE || a == PAB_A_STANDUP; }
+
+/* The scheme's own table; NULL for Move/AGP schemes and unknown ids (left alone). */
+static const signed char* pab_base(int32_t id)
+{
+    return id == 1 ? pab_std : id == 2 ? pab_alt : (const signed char*)0;
+}
+
+/* Shadow Fall's PS4 default layout (network pass 35). `family` (PRM_FAM_*) is kept in the signature for the callers:
+ * the layout is the same for every pad (Xbox RT/LT/RB arrive as R2/L2/R1). */
+static void pab_modern(const signed char* base, int family, int32_t out[PAB_N])
+{
+    int a;
+    (void)family;
+    for (a = 0; a < PAB_N; a++) out[a] = base[a];
+    out[PAB_A_PRIMARYFIRE] = out[PAB_A_SECONDARYFIRE] = out[PAB_A_GRABRIGHT] = PAB_R2;
+    out[PAB_A_ZOOMSWITCH] = out[PAB_A_GRABLEFT] = PAB_L2;
+    out[PAB_A_QUICKTHROW] = PAB_R1;
+    out[PAB_A_CROUCH] = out[PAB_A_SLIDE] = out[PAB_A_COVER] = out[PAB_A_JETPACKCLIMB] = PAB_CIRCLE;
+    out[PAB_A_USE] = out[PAB_A_DOITNOW] = PAB_CIRCLE;
+    out[PAB_A_CLOSECOMBAT] = out[PAB_A_TRIGGERC4] = PAB_R3;
+}
+
+/* Net pass 34's Modern (family 0 PS: fire R1, aim L1, grenade L2; 1 Xbox: fire R2, aim L2, grenade L1; crouch Circle,
+ * use Square, melee R3). Not offered any more: only recognised, so Default can put the scheme's own table back over a
+ * profile saved while it was in use. */
+static void pab_modern_r34(const signed char* base, int family, int32_t out[PAB_N])
+{
+    const int fire = family ? PAB_R2 : PAB_R1, aim = family ? PAB_L2 : PAB_L1, nade = family ? PAB_L1 : PAB_L2;
+    int a;
+    for (a = 0; a < PAB_N; a++) out[a] = base[a];
+    out[PAB_A_PRIMARYFIRE] = out[PAB_A_SECONDARYFIRE] = out[PAB_A_GRABRIGHT] = fire;
+    out[PAB_A_ZOOMSWITCH] = out[PAB_A_FLASHLIGHT] = out[PAB_A_GRABLEFT] = out[PAB_A_JETPACKCLIMB] = aim;
+    out[PAB_A_QUICKTHROW] = nade;
+    out[PAB_A_CROUCH] = out[PAB_A_SLIDE] = out[PAB_A_COVER] = PAB_CIRCLE;
+    out[PAB_A_USE] = out[PAB_A_DOITNOW] = PAB_SQUARE;
+    out[PAB_A_CLOSECOMBAT] = out[PAB_A_TRIGGERC4] = PAB_R3;
+}
+
+/* src[g] = the pad button (0..15, CELL_PAD_CTRL bit order of pad_remap.h) that does game button g's job, >= 16 none.
+ * pad_remap.h numbers buttons by CELL_PAD_CTRL bit (select l3 r3 start up right down left l2 r2 l1 r1 tri circle cross
+ * square), EButton by icon id: convert both ways. */
+static const signed char pab_eb_to_bit[16] = { 12, 13, 14, 15, 8, 9, 10, 11, 3, 0, 1, 2, 4, 5, 6, 7 };
+static const signed char pab_bit_to_eb[16] = { 9, 10, 11, 8, 12, 13, 14, 15, 4, 5, 6, 7, 0, 1, 2, 3 };
+
+static void pab_custom(const signed char* base, const unsigned char src[16], int32_t out[PAB_N])
+{
+    int a;
+    for (a = 0; a < PAB_N; a++) {
+        const int b = base[a];
+        out[a] = b;
+        if (b >= 0 && b < 16) {
+            const unsigned s = src[pab_eb_to_bit[b]];
+            out[a] = s < 16 ? pab_bit_to_eb[s] : -1;
+        }
+    }
+}
+
+static void pab_from_base(const signed char* base, int32_t out[PAB_N])
+{
+    int a;
+    for (a = 0; a < PAB_N; a++) out[a] = base[a];
+}
+
+/* Equal on every action a preset may write. */
+static int pab_same(const int32_t* x, const int32_t* y)
+{
+    int a;
+    for (a = 0; a < PAB_N; a++) if (!pab_skip(a) && x[a] != y[a]) return 0;
+    return 1;
+}
+
+static int pab_diffs(const int32_t* x, const signed char* base)
+{
+    int a, n = 0;
+    for (a = 0; a < PAB_N; a++) if (!pab_skip(a) && x[a] != base[a]) n++;
+    return n;
+}
+
+/* A table the game could hold: every entry -1..20 (a block that is not one, e.g. a player slot the profile does not
+ * have, is never written). */
+static int pab_plausible(const int32_t* t)
+{
+    int a;
+    for (a = 0; a < PAB_N; a++) if (t[a] < -1 || t[a] > 20) return 0;
+    return 1;
+}
+
+/* Which EBOOT is loaded: GetActionBinding's code words identify it (no build-time version needed). */
+typedef uint32_t (*pab_rd32_fn)(uint32_t ea);
+typedef uint8_t (*pab_rd8_fn)(uint32_t ea);
+typedef void (*pab_wr32_fn)(uint32_t ea, uint32_t v);
+
+typedef struct { const char* name; uint32_t fn, w0, w_tab, off_tab, w_mot, off_mot, profile_ptr; } PabVersion;
+static const PabVersion pab_versions[2] = {
+    /* v1.00: sldi r6,r5,5 ... addic r5,r3,0xd4 ... lbz r6,0xe0(r3) */
+    { "1.00", 0x004C79B4u, 0x78A62EA4u, 0x30A300D4u, 0x1Cu, 0x88C300E0u, 0x2Cu, 0x01587FECu },
+    /* 1.14: ori r6,r4,0 ... addic r7,r3,0xd4 ... lbz r8,0xe0(r3) */
+    { "1.14", 0x004D40B8u, 0x60860000u, 0x30E300D4u, 0x28u, 0x890300E0u, 0x38u, 0x015FD6FCu },
+};
+
+/* -1 = neither (another game or a changed EBOOT: the layouts stay off). */
+static int pab_detect(pab_rd32_fn rd32)
+{
+    int v;
+    for (v = 0; v < 2; v++) {
+        const PabVersion* p = &pab_versions[v];
+        if (rd32(p->fn) == p->w0 && rd32(p->fn + p->off_tab) == p->w_tab && rd32(p->fn + p->off_mot) == p->w_mot) return v;
+    }
+    return -1;
+}
+
+/* What one block should hold. kbd = the keyboard is the device in use (keys name game buttons: they keep the game's
+ * table). Returns 0 when the block is left alone. */
+static int pab_want(int preset, int family, int kbd, const signed char* base, const unsigned char custom_src[16],
+                    int32_t out[PAB_N])
+{
+    if (!base) return 0;
+    if (kbd || preset == 0) pab_from_base(base, out);
+    else if (preset == 1) pab_modern(base, family, out);
+    else if (preset == 2 && custom_src) pab_custom(base, custom_src, out);
+    else pab_from_base(base, out);
+    return 1;
+}
+
+/* A table this file could have written for this scheme (so putting the scheme's own back is safe). */
+static int pab_ours(const int32_t* cur, const signed char* base, const unsigned char custom_src[16], const int32_t* last)
+{
+    int32_t t[PAB_N];
+    int f;
+    pab_modern(base, 0, t);
+    if (pab_same(cur, t)) return 1;
+    for (f = 0; f < 2; f++) { pab_modern_r34(base, f, t); if (pab_same(cur, t)) return 1; }
+    if (custom_src) { pab_custom(base, custom_src, t); if (pab_same(cur, t)) return 1; }
+    return last && pab_same(cur, last);
+}
+
+/* Result of one block's sync */
+enum { PAB_NONE = 0, PAB_WROTE = 1, PAB_RESTORED = 2, PAB_FOREIGN = 3, PAB_BAD = 4 };
+
+/* One block: read, decide, write. `last` (PAB_N, may hold anything; last[0] == INT32_MIN = none) is what this file
+ * wrote last into this block and is updated. */
+static int pab_sync_block(uint32_t blk, int preset, int family, int kbd, const unsigned char custom_src[16],
+                          int32_t* last, pab_rd32_fn rd32, pab_rd8_fn rd8, pab_wr32_fn wr32, int32_t* id_out)
+{
+    int32_t cur[PAB_N], want[PAB_N];
+    const signed char* base;
+    int a;
+    const int32_t id = (int32_t)rd32(blk + PAB_OFF_ID);
+    if (id_out) *id_out = id;
+    if (rd8(blk + PAB_OFF_MOTION) != 0) return PAB_NONE;
+    base = pab_base(id);
+    if (!base) return PAB_NONE;
+    for (a = 0; a < PAB_N; a++) cur[a] = (int32_t)rd32(blk + PAB_OFF_TABLE + 4u * (uint32_t)a);
+    if (!pab_plausible(cur)) return PAB_BAD;
+    if (!pab_want(preset, family, kbd, base, custom_src, want)) return PAB_NONE;
+    if (pab_same(cur, want)) return PAB_NONE;
+    {
+        int32_t b[PAB_N];
+        pab_from_base(base, b);
+        if (pab_same(want, b) && !pab_ours(cur, base, custom_src, last[0] == INT32_MIN ? (const int32_t*)0 : last))
+            return PAB_FOREIGN;   /* the game's own table (or one we do not know): leave it */
+        for (a = 0; a < PAB_N; a++)
+            if (!pab_skip(a) && cur[a] != want[a]) wr32(blk + PAB_OFF_TABLE + 4u * (uint32_t)a, (uint32_t)want[a]);
+        memcpy(last, want, sizeof want);
+        return pab_same(want, b) ? PAB_RESTORED : PAB_WROTE;
+    }
+}
+
+#endif
