+static void pad_actions_sync(void)
+{
+    static int ver = -2, off = -1;
+    static int32_t last[2][PAB_N] = { { INT32_MIN }, { INT32_MIN } };
+    static int said[2][3];
+    unsigned char cust[16];
+    uint32_t prof;
+    int p, kbd;
+    if (off < 0) { const char* e = getenv("KZ3_PAD_ACTIONS"); off = e && !strcmp(e, "0"); }
