+        fflush(stdout);
+    }
+    if (ver < 0) return;
+    prof = vm_read32(pab_versions[ver].profile_ptr);
+    if (!prof || prof >= 0x40000000u) return;
+    for (p = 0; p < 16; p++) cust[p] = s_remap[0].src[p];
+    kbd = pad_prompt_device() == PAD_DEV_KEYBOARD;
+    for (p = 0; p < 2; p++) {
+        int32_t id = 0;
+        const uint32_t blk = prof + PAB_BLOCK_STRIDE * (uint32_t)p;
+        const int fam = pad_remap_family(s_port_dev[p]);
+        int r;
+        if (!said[p][0] && p == 0) {   /* once: is the game's table the one this file knows? (ASSUMPTION check for 1.14) */
+            const int32_t sid = (int32_t)vm_read32(blk + PAB_OFF_ID);
+            const signed char* b = pab_base(sid);
+            if (b) {
+                int32_t t[PAB_N];
+                for (int a = 0; a < PAB_N; a++) t[a] = (int32_t)vm_read32(blk + PAB_OFF_TABLE + 4u * (uint32_t)a);
