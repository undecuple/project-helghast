+                fflush(stdout);
+                said[p][0] = 1;
+            }
+        }
+        r = pab_sync_block(blk, s_remap_preset, fam, kbd, s_remap_preset == PRM_CUSTOM ? cust : NULL, last[p], pab_rd32,
+                           pab_rd8, pab_wr32, &id);
+        if (r == PAB_WROTE || r == PAB_RESTORED) {
+            printf("[pad] player %d: %s (scheme %d, %s%s)\n", p + 1,
+                   r == PAB_RESTORED ? "the scheme's own action table back" : "action table set", (int)id,
+                   kbd ? "keyboard in use" : prm_preset_names[s_remap_preset < PRM_N_PRESETS ? s_remap_preset : 0],
+                   kbd || r == PAB_RESTORED ? "" : fam ? ", Xbox pad" : ", PlayStation pad");
+            fflush(stdout);
+        } else if ((r == PAB_FOREIGN || r == PAB_BAD) && !said[p][r - 2]) {
+            said[p][r - 2] = 1;
+            printf("[pad] player %d: %s, not changed\n", p + 1,
+                   r == PAB_BAD ? "the action table does not look like one" : "an action table the port did not write");
+            fflush(stdout);
+        }
+    }
+}
