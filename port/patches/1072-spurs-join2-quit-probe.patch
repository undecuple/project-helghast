+/* KZ3 patch 1072 (SPU pass 57, KZ3_JOIN2_PROBE=1, logs only): the T7 quit stalls in cellSpursJoinTask2 (Havok pool dtor,
+ * the RE notes s.7). A registry of the live task threads (taskset, id, generation, image, start time, SPU
+ * context seen by rdch/rchcnt, per-channel read counts) and a ring of the last task starts/exits, dumped by the
+ * JoinTask2 spin with the taskset's bitsets and exit entry. Separates a live task waiting (cause 1) from a stale
+ * enabled bit (cause 2). Off: one global int test per rdch/rchcnt. */
+int g_kz3_j2_on = -1;
+void (*g_kz3_j2_note)(spu_context* ctx, uint32_t ch) = 0;   /* called by spu_rdch / spu_rchcnt when set */
+void spu_j2_note(spu_context* ctx, uint32_t ch);
+int kz3_j2_on(void)
+{
+    if (g_kz3_j2_on < 0) {
+        const char* e = getenv("KZ3_JOIN2_PROBE");
+        g_kz3_j2_on = (e && *e == '1');
+        if (g_kz3_j2_on) g_kz3_j2_note = spu_j2_note;
+    }
+    return g_kz3_j2_on;
+}
+typedef struct {
+    volatile LONG used;
+    unsigned long tid;
+    uint32_t ts, id, gen, image;
+    unsigned long long t0;
+    spu_context* ctx;
+    unsigned long long rd[64], n;
+} j2_slot;
+#define J2_SLOTS 64
+static j2_slot s_j2[J2_SLOTS];
+static _Thread_local j2_slot* t_j2;
+typedef struct { unsigned long long ms; uint32_t ts, id, kind, gen; int32_t rc; unsigned long tid; } j2_ev;
+#define J2_EVS 96
+static j2_ev s_j2ev[J2_EVS];
+static volatile LONG s_j2ev_n;
+static unsigned long long j2_ms(void)
+{
+#ifdef _WIN32
+    return GetTickCount64();
+#else
+    struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return (unsigned long long)t.tv_sec * 1000ull + t.tv_nsec / 1000000;
+#endif
+}
+static unsigned long j2_tid(void)
+{
+#ifdef _WIN32
+    return (unsigned long)GetCurrentThreadId();
+#else
+    return (unsigned long)pthread_self();
+#endif
+}
+/* kind: 1 start, 2 exit, 3 exit of a cut-off (stale) task, 4 not started */
+static void j2_event(uint32_t ts, uint32_t id, uint32_t kind, int32_t rc)
+{
+    LONG k = InterlockedIncrement(&s_j2ev_n) - 1;
+    j2_ev* e = &s_j2ev[k % J2_EVS];
+    e->ms = j2_ms(); e->ts = ts; e->id = id; e->kind = kind; e->rc = rc; e->tid = j2_tid(); e->gen = t_task_gen;
+}
+static void j2_start(uint32_t ts, uint32_t id, int image)
+{
+    if (!kz3_j2_on() || !ts) return;
+    j2_event(ts, id, 1, 0);
+    for (int i = 0; i < J2_SLOTS; i++) {
+        if (InterlockedCompareExchange(&s_j2[i].used, 1, 0) == 0) {
+            j2_slot* s = &s_j2[i];
+            s->tid = j2_tid(); s->ts = ts; s->id = id; s->gen = t_task_gen; s->image = (uint32_t)image;
+            s->t0 = j2_ms(); s->ctx = NULL; s->n = 0; memset(s->rd, 0, sizeof s->rd);
+            t_j2 = s;
+            return;
+        }
+    }
+}
+static void j2_end(void)
+{
+    if (t_j2) { InterlockedExchange(&t_j2->used, 0); t_j2 = NULL; }
+}
+/* From spu_rdch / spu_rchcnt (spu_channels.c, through g_kz3_j2_note) while the probe is on. */
+void spu_j2_note(spu_context* ctx, uint32_t ch)
+{
+    j2_slot* s = t_j2;
+    if (!s) return;
+    s->ctx = ctx; s->n++;
+    if (ch < 64) s->rd[ch]++;
+}
+static void j2_hex(const char* tag, uint32_t ea, uint32_t n)
+{
+    extern uint8_t* vm_base;
+    char b[160]; int o = 0;
+    for (uint32_t i = 0; i < n && o < (int)sizeof b - 4; i++) o += snprintf(b + o, sizeof b - o, "%02X%s", vm_base[ea + i], (i & 3) == 3 ? " " : "");
+    fprintf(stderr, "[j2] %s @0x%08X: %s\n", tag, ea, b);
+}
+/* JoinTask2 spin dump (cellSpurs.c), taskset ts, waited-for task id. */
+void spu_j2_dump(uint32_t ts, uint32_t id, unsigned spins)
+{
+    extern uint8_t* vm_base;
+    if (!kz3_j2_on() || !vm_base || !ts) return;
+    unsigned long long now = j2_ms();
+    fprintf(stderr, "[j2] JoinTask2 ts=0x%08X id=%u spins=%u tid=%lu\n", ts, id, spins, j2_tid());
+    j2_hex("ready +0x10", ts + 0x10, 16); j2_hex("pending +0x20", ts + 0x20, 16); j2_hex("enabled +0x30", ts + 0x30, 16);
+    j2_hex("size +0x1890", ts + 0x1890, 4);
+    for (uint32_t t = 0; t < 8; t++) { char tag[32]; snprintf(tag, sizeof tag, "exit[%u]", t); j2_hex(tag, ts + 0x1980 + 16 * t, 16); }
+    for (uint32_t t = 0; t < 8; t++) { char tag[32]; snprintf(tag, sizeof tag, "task_info[%u]", t); j2_hex(tag, ts + 0x80 + 0x30 * t, 0x30); }
+    ts_lock();
+    int i = ts_find(ts);
+    if (i >= 0) {
+        int marks = 0; for (int b = 0; b < 16; b++) marks += __builtin_popcount(s_ts_run[i].running[b]);
+        fprintf(stderr, "[j2] ts_run: gen=%u parked=%d running-marks=%d byte0=0x%02X\n", (unsigned)s_ts_run[i].gen,
+                s_ts_run[i].parked, marks, s_ts_run[i].running[0]);
+    } else fprintf(stderr, "[j2] ts_run: taskset not tracked\n");
+    ts_unlock();
+    int live = 0;
+    for (int k = 0; k < J2_SLOTS; k++) {
+        j2_slot* s = &s_j2[k];
+        if (!s->used) continue;
+        live++;
+        spu_context* c = s->ctx;
+        char rd[400]; int o = 0;
+        for (int ch = 0; ch < 64 && o < (int)sizeof rd - 32; ch++)
+            if (s->rd[ch]) o += snprintf(rd + o, sizeof rd - o, " %s%d=%llu", ch >= 32 ? "cnt" : "rd", ch & 31, s->rd[ch]);
+        fprintf(stderr, "[j2] live task thread tid=%lu ts=0x%08X id=%u gen=%u image=%u age=%llu ms ch-ops=%llu%s\n",
+                s->tid, s->ts, s->id, s->gen, s->image, now - s->t0, s->n, rd);
+        if (c) {
+            fprintf(stderr, "[j2]   ctx pc=0x%05X lr=0x%05X sp=0x%05X r3=0x%08X status=0x%X stop=0x%X ev_mask=0x%X ev_stat=0x%X "
+                    "resv_valid=%d resv_ea=0x%08X\n", c->pc & 0x3FFFFu, c->gpr[0]._u32[0] & 0x3FFFFu, c->gpr[1]._u32[0] & 0x3FFFFu,
+                    c->gpr[3]._u32[0], c->status, c->stop_code, c->event_mask, c->event_status, c->resv_valid, c->resv_ea);
+            if (c->resv_valid && c->resv_ea) j2_hex("  resv line", c->resv_ea, 32);
+        }
+    }
+    fprintf(stderr, "[j2] %d live task thread(s); last task events (ms before now, kind 1 start 2 exit 3 stale-exit 4 not started):\n", live);
+    LONG n = s_j2ev_n; LONG from = n > J2_EVS ? n - J2_EVS : 0;
+    for (LONG k = from; k < n; k++) {
+        j2_ev* e = &s_j2ev[k % J2_EVS];
+        if (e->ts != ts && (n - k) > 24) continue;   /* other tasksets: only the last 24 */
+        fprintf(stderr, "[j2]   -%llu ms ts=0x%08X id=%u kind=%u rc=%d tid=%lu gen=%u\n", now - e->ms, e->ts, e->id, e->kind,
+                e->rc, e->tid, e->gen);
+    }
+    fflush(stderr);
+}
+
 static void spu_taskset_mark(uint32_t taskset_ea, uint32_t t, int on)
 {
     if (!taskset_ea || t >= 128 || s_ts_held) return;   /* held: caller set it */
@@ -868,6 +1004,7 @@ static void spu_async_run(spu_async_job* j)
 {
     spu_taskset_mark(j->taskset_ea, j->taskid, 1);
     spu_taskset_bind_thread(j->taskset_ea);   /* KZ3 patch 1066 */
+    j2_start(j->taskset_ea, j->taskid, j->image_id);   /* KZ3 patch 1072 */
     /* Persistent per-taskset LS: acquire (+serialize) the taskset's LS, or fall
      * back to a fresh per-dispatch LS when disabled / no taskset. */
     spu_ts_ls_slot* ts_slot = NULL;
@@ -1207,6 +1344,8 @@ static void spu_async_run(spu_async_job* j)
             fprintf(stderr, "[spu_workload] async image=%d RETURNED rc=%d "
                     "(job ran to completion, did not loop)\n", j->image_id, rc);
             spu_serial_release();
+            if (j->taskset_ea && g_kz3_j2_on == 1)   /* KZ3 patch 1072 */
+                j2_event(j->taskset_ea, j->taskid, ts_stale(j->taskset_ea) ? 3 : 2, rc);
             if (j->taskset_ea) spu_taskset_task_exited(j->taskset_ea, j->taskid, rc);
         }
         /* Persistent LS is retained in its taskset slot for the next task; a
@@ -1220,6 +1359,7 @@ static void spu_async_run(spu_async_job* j)
         pthread_mutex_unlock(&ts_slot->lock);
 #endif
     }
+    j2_end();   /* KZ3 patch 1072 */
     free(j);
 }
 
