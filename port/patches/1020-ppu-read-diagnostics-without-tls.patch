 /* Tracks the most recent vm_read32 {addr,value} on this thread, so PPU_WVAL can
  * report the SOURCE a copied value came from (poison propagation vs true origin). */
+/* KZ3 patch 1020: the per-read diagnostics below used thread-locals, which MinGW GCC turns into
+ * emulated TLS (__emutls_get_address + mcfgthread lookups) -- two to four calls on EVERY guest read.
+ * The level load's byte-wise hashing (lookup2 at 0x000111F8) spent ~70 % of its samples there.
+ * The hot-read spin detectors now run only with PPU_READ_DIAG=1; the PT last-read capture only when
+ * PT is set. A plain cached static, read once. */
+static int s_ppu_read_diag = -1;
+static inline int ppu_read_diag(void)
+{
+    if (__builtin_expect(s_ppu_read_diag < 0, 0)) s_ppu_read_diag = getenv("PPU_READ_DIAG") ? 1 : 0;
+    return s_ppu_read_diag;
+}
