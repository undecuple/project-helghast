diff --git a/runtime/ppu/ppu_setjmp.h b/runtime/ppu/ppu_setjmp.h
new file mode 100644
index 00000000..f4b882aa
--- /dev/null
+++ b/runtime/ppu/ppu_setjmp.h
@@ -0,0 +1,90 @@
+/* ppu_setjmp.h -- host frames for guest setjmp/longjmp (KZ3 patch 1116, SPU pass 101).
+ *
+ * A lifted function cannot leave its host frame, so a lifted guest longjmp restores the guest registers from
+ * the jmp_buf and then RETURNS to its lifted caller (on the console it never returns). The lifter's
+ * --setjmp/--longjmp marks fix that in the generated code:
+ *   - every `bl` to a function marked setjmp becomes PPU_SJ_CALL: a host setjmp is taken first and recorded
+ *     on this thread under the guest jmp_buf address (r3 rounded up to 16, as the PS3 libc setjmp does), the
+ *     guest r1 and the host frame;
+ *   - a function marked longjmp is emitted as <name>__ljbody plus a wrapper <name> that runs the body (guest
+ *     registers restored, r3 = the longjmp value) and calls ppu_sj_longjmp, which host-longjmps to the record
+ *     of that jmp_buf. Control lands back at the call site, which goes on with the lifted code after the `bl`
+ *     with r3 != 0, as on the console.
+ *   - no record (or KZ3_LJMP=0): the longjmp returns as before and logs it.
+ * The host jump is the frameless form on MinGW x64 (_setjmp(buf, NULL): longjmp restores registers only, no
+ * RtlUnwindEx over lifted frames; same reason as SPU_SETJMP, patch 1099), _setjmp/_longjmp (no signal mask)
+ * elsewhere. Host frames between the setjmp site and the longjmp run no cleanups, as with the guest's own
+ * longjmp; the runtime's per-thread counters a skipped frame leaves (ps3_indirect_call dispatch depth, vcall sp)
+ * are restored at the landing. */
+#ifndef PPU_SETJMP_H
+#define PPU_SETJMP_H
+
+#include <setjmp.h>
+#include <stdint.h>
+
+#if defined(_WIN64) && defined(__MINGW64__)
+#  define PPU_SJ_HOST_SETJMP(b)    _setjmp((b), NULL)
+#  define PPU_SJ_HOST_LONGJMP(b, v) longjmp((b), (v))
+#elif defined(_WIN32)
+#  define PPU_SJ_HOST_SETJMP(b)    setjmp(b)
+#  define PPU_SJ_HOST_LONGJMP(b, v) longjmp((b), (v))
+#else
+#  define PPU_SJ_HOST_SETJMP(b)    _setjmp(b)
+#  define PPU_SJ_HOST_LONGJMP(b, v) _longjmp((b), (v))
+#endif
+
+#if defined(_MSC_VER) && !defined(__clang__)
+#  include <intrin.h>
+#  define PPU_SJ_FRAME() _AddressOfReturnAddress()
+#else
+#  define PPU_SJ_FRAME() __builtin_frame_address(0)
+#endif
+
+#ifndef PPU_SJ_MAX
+#  define PPU_SJ_MAX 64   /* live setjmp records per thread (Lua: one per nested pcall) */
+#endif
+
+struct ppu_context;
+
+typedef struct ppu_sj_rec {
+    jmp_buf   hb;          /* host frame of the call site */
+    uint32_t  jb;          /* guest jmp_buf, (r3 + 15) & ~15; 0 = free slot */
+    uint32_t  raw_jb;      /* r3 at the call */
+    uint64_t  r1;          /* guest r1 at the call (= the r1 setjmp saves) */
+    uintptr_t key;         /* host stack the record belongs to (ppu_sj_stack_key) */
+    uintptr_t hframe;      /* host frame address of the lifted caller */
+    int       depth0, vsp0;/* ps3_indirect_call dispatch depth, vcall sp at the call */
+    uint32_t  site;        /* guest address of the `bl` */
+    int32_t   status_off;  /* -1, or the offset from raw_jb of a status word the log prints (Lua: 0x220) */
+} ppu_sj_rec;
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Record the call site; NULL = no record (switch off, or PPU_SJ_MAX live records): plain call. */
+ppu_sj_rec* ppu_sj_push(struct ppu_context* ctx, uint32_t site, int32_t status_off, void* hframe);
+/* At a landing: restores the runtime counters of the record being landed on, counts and logs. */
+void ppu_sj_landed(struct ppu_context* ctx);
+/* Called by a lifted longjmp's wrapper after its body: jb_arg = r3 at the longjmp's entry. Does not return when
+ * a record matches; returns (old behaviour) otherwise. */
+void ppu_sj_longjmp(struct ppu_context* ctx, uint64_t jb_arg);
+/* Host stack identity: a coroutine layer that runs guest code on several host stacks of one thread (and is not
+ * Windows fibers, which the default key follows through the TEB stack base) sets this to name the current one. */
+extern uintptr_t (*ppu_sj_stack_key_fn)(void);
+/* Counters (any thread): landings, longjmps with no record, pushes refused (table full). */
+unsigned long long ppu_sj_stat(int which);
+#ifdef __cplusplus
+}
+#endif
+
+/* The call-site form the lifter emits for `bl <setjmp>`. The host setjmp must be in the lifted caller's own
+ * frame, hence a macro. The guest state lives in *ctx and is not cached across the call by the lifted code
+ * (its _cs_ entry copies do not change after the prologue), so nothing is lost by the host jump. */
+#define PPU_SJ_CALL(ctx, fn, site, soff) do {                                              \
+        ppu_sj_rec* _sj_r = ppu_sj_push((ctx), (site), (soff), PPU_SJ_FRAME());        \
+        if (!_sj_r) { fn(ctx); break; }                                                    \
+        if (PPU_SJ_HOST_SETJMP(_sj_r->hb) == 0) fn(ctx);                                   \
+        else ppu_sj_landed(ctx);                                                           \
+    } while (0)
+
+#endif /* PPU_SETJMP_H */
diff --git a/runtime/ppu/ppu_setjmp_rt.inc b/runtime/ppu/ppu_setjmp_rt.inc
new file mode 100644
index 00000000..7d841e22
--- /dev/null
+++ b/runtime/ppu/ppu_setjmp_rt.inc
@@ -0,0 +1,113 @@
+/* ppu_setjmp_rt.inc -- the runtime half of ppu_setjmp.h (KZ3 patch 1116, SPU pass 101). Included at the end of
+ * ppu_loader.cpp (it needs ppu_context, vm_read32, g_trampoline_fn and the dispatch-depth / vcall-sp slots);
+ * tools/spu/test_r101_setjmp.sh includes it with stubs.
+ *
+ * Records: a per-thread table (PPU_THREAD_LOCAL, i.e. __thread: never one table shared by threads, the patch
+ * 1012 lesson). Live records never move (the host jmp_buf stays where its setjmp wrote it); a dead record is
+ * freed in place (jb = 0) and free slots are popped from the top. A record is dead when, on the same host stack
+ * (key), its guest frame is gone (its r1 below the current one: the guest stack grows down), its host frame is
+ * gone (frame address below the current one), or the same frame sets the same jmp_buf again. A longjmp only
+ * takes a record whose host frame is still live and whose r1 equals the r1 the guest longjmp restored. */
+#include "ppu_setjmp.h"
+
+#ifndef PPU_SJ_ENV
+#  define PPU_SJ_ENV "KZ3_LJMP"   /* =0: the call sites call plainly and longjmp returns (the old behaviour) */
+#endif
+
+static PPU_THREAD_LOCAL ppu_sj_rec  t_sj[PPU_SJ_MAX];
+static PPU_THREAD_LOCAL int         t_sj_n;      /* slots in use from the bottom (live or freed) */
+static PPU_THREAD_LOCAL ppu_sj_rec* t_sj_land;   /* the record ppu_sj_longjmp is landing on */
+static unsigned long long g_sj_stat[3];          /* caught, unmatched, full (atomic adds) */
+extern "C" uintptr_t (*ppu_sj_stack_key_fn)(void) = nullptr;
+
+static int ppu_sj_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv(PPU_SJ_ENV); on = !(e && e[0] == '0'); }
+    return on;
+}
+
+static uintptr_t ppu_sj_key(void)
+{
+    if (ppu_sj_stack_key_fn) return ppu_sj_stack_key_fn();
+#if defined(_WIN32) && !defined(PPU_SJ_NO_TEB)
+    return (uintptr_t)((NT_TIB*)NtCurrentTeb())->StackBase;   /* per Windows fiber: SwitchToFiber updates it */
+#else
+    return 0;
+#endif
+}
+
+extern "C" unsigned long long ppu_sj_stat(int which)
+{
+    return (which >= 0 && which < 3) ? __atomic_load_n(&g_sj_stat[which], __ATOMIC_RELAXED) : 0;
+}
+
+extern "C" ppu_sj_rec* ppu_sj_push(ppu_context* ctx, uint32_t site, int32_t status_off, void* hframe)
+{
+    if (!ppu_sj_on()) return nullptr;
+    const uintptr_t key = ppu_sj_key(), hf = (uintptr_t)hframe;
+    const uint64_t r1 = ctx->gpr[1];
+    const uint32_t raw = (uint32_t)ctx->gpr[3], jb = (uint32_t)((raw + 0xFu) & ~0xFu);
+    for (int i = 0; i < t_sj_n; i++) {
+        ppu_sj_rec* r = &t_sj[i];
+        if (!r->jb || r->key != key) continue;
+        if (r->r1 < r1 || r->hframe < hf || (r->hframe == hf && r->jb == jb)) r->jb = 0;
+    }
+    while (t_sj_n > 0 && !t_sj[t_sj_n - 1].jb) t_sj_n--;
+    if (t_sj_n >= PPU_SJ_MAX) {
+        if (__atomic_add_fetch(&g_sj_stat[2], 1, __ATOMIC_RELAXED) <= 8)
+            fprintf(stderr, "[ljmp] setjmp site 0x%08X: %d live records on this thread, not recorded\n", site, t_sj_n);
+        return nullptr;
+    }
+    ppu_sj_rec* r = &t_sj[t_sj_n++];
+    r->jb = jb; r->raw_jb = raw; r->r1 = r1; r->key = key; r->hframe = hf;
+    r->depth0 = *ps3_ppu_dispatch_depth_slot(); r->vsp0 = *ps3_ppu_vcall_sp_slot();
+    r->site = site; r->status_off = status_off;
+    return r;
+}
+
+extern "C" void ppu_sj_landed(ppu_context* ctx)
+{
+    ppu_sj_rec* r = t_sj_land;
+    t_sj_land = nullptr;
+    if (!r) return;   /* cannot happen: only ppu_sj_longjmp jumps here */
+    *ps3_ppu_dispatch_depth_slot() = r->depth0;
+    *ps3_ppu_vcall_sp_slot() = r->vsp0;
+    const unsigned long long n = __atomic_add_fetch(&g_sj_stat[0], 1, __ATOMIC_RELAXED);
+    if (n <= 64 || n % 1000 == 0) {
+        const int32_t val = (int32_t)ctx->gpr[3];
+        const int32_t st = r->status_off >= 0 ? (int32_t)vm_read32((uint64_t)r->raw_jb + (uint32_t)r->status_off) : val;
+        fprintf(stderr, "[ljmp] caught status=%d (#%llu, val=%d, site 0x%08X, jmp_buf 0x%08X)\n", st, n, val, r->site, r->jb);
+    }
+}
+
+extern "C" void ppu_sj_longjmp(ppu_context* ctx, uint64_t jb_arg)
+{
+    if (!ppu_sj_on()) return;
+    const uint32_t jb = (uint32_t)((jb_arg + 0xFu) & ~0xFull);
+    const uintptr_t key = ppu_sj_key();
+    char here;
+    const uintptr_t hsp = (uintptr_t)&here;
+    int found = -1, r1_off = 0;
+    for (int i = t_sj_n - 1; i >= 0; i--) {
+        ppu_sj_rec* r = &t_sj[i];
+        if (r->jb != jb || r->key != key) continue;
+        if (r->hframe <= hsp) { r->jb = 0; continue; }          /* its host frame returned: stale */
+        if (r->r1 != ctx->gpr[1]) { r1_off = 1; continue; }     /* the guest buffer was set again elsewhere */
+        found = i;
+        break;
+    }
+    if (found < 0) {
+        if (__atomic_add_fetch(&g_sj_stat[1], 1, __ATOMIC_RELAXED) <= 16)
+            fprintf(stderr, "[ljmp] longjmp to jmp_buf 0x%08X with no host frame (records=%d%s) -- returns as before\n",
+                    jb, t_sj_n, r1_off ? ", r1 mismatch" : "");
+        return;
+    }
+    /* The frames between are gone: free the same-stack records above the target. */
+    for (int i = found + 1; i < t_sj_n; i++)
+        if (t_sj[i].key == key) t_sj[i].jb = 0;
+    while (t_sj_n > found + 1 && !t_sj[t_sj_n - 1].jb) t_sj_n--;
+    t_sj_land = &t_sj[found];
+    g_trampoline_fn = nullptr;   /* a continuation queued by a skipped frame must not run at the landing */
+    PPU_SJ_HOST_LONGJMP(t_sj[found].hb, 1);
+}
