+/* KZ3 patch 2027: CPU-visible ZPASS report values.
+ *
+ * Patch 2025 used the occlusion queries only for GPU predication; the report value the title reads from
+ * guest memory stayed the walker's "visible" 0xFFFF. KZ3's coronas (CoronaResource: QueryOffset,
+ * FadeInTime, FadeOutTime) read their report back to fade the glow in and out, so every corona -- even one
+ * whose light sits behind a wall -- stayed at full intensity.
+ *
+ * Now each PENDING report (one query segment since its clear) is also resolved into a READBACK buffer
+ * ring at GET_REPORT time. Entries are stamped with the queue fence value at the next command-list
+ * submit, and the end of every flush copies the counts of entries whose fence has passed into the guest
+ * report (CellGcmReportData.value, big-endian, at IO offset + 8). Never a wait: the present flush already
+ * waits for frame N-1, so a frame's counts land one frame later -- what a PS3 title sees when it reads last
+ * frame's report. At walk time the walker writes the slot's last real count (0xFFFF before the first one;
+ * 0 for NEVER: no draw since the clear), so a read before the readback lands sees the previous frame.
+ * Off with LD_COND_RENDER=0 (whole path) or LD_OQ_READBACK=0 (this part only).
+ * ASSUMPTION: the surface is rendered at the guest resolution, so the D3D12 sample count is the RSX count. */
+#define LD_RB_N 4096u
+static struct {
+    int on;                       /* -1 = not decided yet */
+    ID3D12Resource* buf;          /* LD_RB_N x u64, READBACK heap, mapped for good */
+    const volatile u64* map;
+    u64 head, tail, unsubmitted;  /* ring indices, monotonic: [tail, unsubmitted) stamped, [unsubmitted, head) not */
+    struct { u64 fence; u32 off; u8 guest; } e[LD_RB_N];
+    u64 n_queued, n_written, n_zero, n_dropped, n_never, n_walk_last;
+} g_rb = { .on = -1 };
+
+static int ld_rb_enabled(void)
+{
+    if (g_rb.on >= 0) return g_rb.on;
+    const char* e = getenv("LD_OQ_READBACK");
+    g_rb.on = !(e && e[0] == '0');
+    if (!g_rb.on) { fprintf(stderr, "[report-readback] off (LD_OQ_READBACK=0)\n"); return 0; }
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = (UINT64)LD_RB_N * 8u;
+    bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+    bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1;
+    bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    void* m = NULL;
+    if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&g_rb.buf)) ||
+        FAILED(g_rb.buf->lpVtbl->Map(g_rb.buf, 0, NULL, &m)) || !m) {
+        fprintf(stderr, "[report-readback] readback buffer failed: off\n");
+        g_rb.on = 0; return 0;
+    }
+    g_rb.map = (const volatile u64*)m;
+    fprintf(stderr, "[report-readback] on: %u entries\n", LD_RB_N);
+    return 1;
+}
+
+/* After Signal(v): every entry queued since the last submit completes with fence v. */
+static void ld_rb_stamp(u64 v)
+{
+    for (; g_rb.unsubmitted < g_rb.head; g_rb.unsubmitted++) g_rb.e[g_rb.unsubmitted % LD_RB_N].fence = v;
+}
+
+static int ld_oq_slot(u32 off, int create);
+static const u8* guest_ptr(u32 location, u32 offset, u32 min_bytes);
+/* Copy finished counts into the guest reports. Never waits. */
+static void ld_rb_drain(void)
+{
+    if (g_rb.on != 1 || g_rb.tail == g_rb.unsubmitted) return;
+    const u64 done = g.fence->lpVtbl->GetCompletedValue(g.fence);
+    while (g_rb.tail < g_rb.unsubmitted) {
+        const u32 k = (u32)(g_rb.tail % LD_RB_N);
+        if (g_rb.e[k].fence > done) break;
+        const u64 c = g_rb.map[k];
+        const u32 v = c > 0xFFFFFFFFull ? 0xFFFFFFFFu : (u32)c;
+        const int i = ld_oq_slot(g_rb.e[k].off, 0);
+        if (i >= 0) { g_oq.slot[i].val = v; g_oq.slot[i].has_val = 1; }
+        if (g_rb.e[k].guest) {
+            u8* p = (u8*)guest_ptr(1u, g_rb.e[k].off, 16u);   /* location 1: IO offset in main memory */
+            if (p) {
+                p[8] = (u8)(v >> 24); p[9] = (u8)(v >> 16); p[10] = (u8)(v >> 8); p[11] = (u8)v;
+                g_rb.n_written++; if (!v) g_rb.n_zero++;
+            }
+        }
+        g_rb.tail++;
+    }
+}
+
+/* Walker hook (cellGcmSys, type-1 report in main memory, called after sink_report for the same GET_REPORT):
+ * the value to write now. Marks the queued readback as one that goes to the guest. */
+u32 rsx_live_draw_report_value(u32 off, u32 dflt)
+{
+    if (!g.ready || g_oq.on != 1) return dflt;
+    const int i = ld_oq_slot(off & 0xFFFFFFu, 0);
+    if (i < 0) return dflt;
+    if (g_oq.slot[i].state == OQ_NEVER) { g_rb.n_never++; return 0u; }
+    if (g_oq.slot[i].state != OQ_PENDING) return dflt;
+    if (g_oq.slot[i].rb) { g_rb.e[(g_oq.slot[i].rb - 1u) % LD_RB_N].guest = 1; g_oq.slot[i].rb = 0; }
+    if (!g_oq.slot[i].has_val) return dflt;
+    g_rb.n_walk_last++;
+    return g_oq.slot[i].val;
+}
+
+void rsx_live_draw_debug_report_readback_stats(u64 out[6])
+{
+    out[0] = g_rb.n_queued; out[1] = g_rb.n_written; out[2] = g_rb.n_zero;
+    out[3] = g_rb.n_dropped; out[4] = g_rb.n_never; out[5] = g_rb.n_walk_last;
+}
+
 static int ld_oq_enabled(void)
 {
     if (g_oq.on >= 0) return g_oq.on;
@@ -8832,7 +8941,18 @@ static void sink_report(void* user, const rsx_dispatch* r, u32 method, u32 arg)
     if (i < 0) return;
     if ((arg >> 24) != 1u || g_oq.segs > 1) g_oq.slot[i].state = OQ_ALWAYS;
     else if (g_oq.segs == 0) g_oq.slot[i].state = OQ_NEVER;
-    else { g_oq.slot[i].state = OQ_PENDING; g_oq.slot[i].serial = g_oq.last_serial; }
+    else {
+        g_oq.slot[i].state = OQ_PENDING; g_oq.slot[i].serial = g_oq.last_serial; g_oq.slot[i].rb = 0;
+        if (ld_rb_enabled()) {   /* patch 2027: the count for the guest, a frame later */
+            if (g_rb.head - g_rb.tail >= LD_RB_N) { g_rb.n_dropped++; return; }
+            const u64 h = g_rb.head++;
+            g_rb.e[h % LD_RB_N].fence = 0; g_rb.e[h % LD_RB_N].off = arg & 0xFFFFFFu; g_rb.e[h % LD_RB_N].guest = 0;
+            g.list->lpVtbl->ResolveQueryData(g.list, g_oq.heap, D3D12_QUERY_TYPE_OCCLUSION,
+                (UINT)(g_oq.last_serial % LD_OQ_N), 1, g_rb.buf, (UINT64)(h % LD_RB_N) * 8u);
+            g_oq.slot[i].rb = h + 1u;
+            g_rb.n_queued++;
+        }
+    }
 }
 
