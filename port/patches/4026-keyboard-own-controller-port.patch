diff -ruN a/libs/input/pad_kbport.h b/libs/input/pad_kbport.h
--- a/libs/input/pad_kbport.h
+++ b/libs/input/pad_kbport.h
@@ -0,0 +1,96 @@
+/* KZ3 patch 4026 (network pass 43): keyboard and mouse as their own controller, so split-screen co-op needs one pad
+ * only.
+ *
+ * Before: the keys were OR'ed into port 0 (patch 2037), so one pad + keyboard was one controller and the co-op gate
+ * (mainmenu.gum CoopSelected: settings controller/numactivecontrollers < 2 -> dlg_controlerror) refused.
+ *
+ * The game (1.14 addresses; 1.00 in pkp_versions): numactivecontrollers = Game+0x840 (0x004D73CC, read by the
+ * settings writer 0x008CF6D0 under the name at 0x00EDDB14), counted by GameInput::UpdatePads 0x004D6308 over 7 slots
+ * at Game+0x18 + i*0x90 whose device is connected (slot+0x80 byte) and of type 0 (standard pad; type 4 counted at
+ * +0x844). The slot's player: int32 at slot+0x84 (Game+0x9C + i*0x90), -1 = none (0x004D17FC sets all 7 to -1).
+ * Players are given out by 0x004D5ED0 each frame: nplayers = 1, or 2 when the session [0x0141C030] exists and
+ * [Game+0x778]+0x100 (the split-screen game) is set; player p keeps its slot while connected (3 s grace when it is
+ * lost), else gets the first connected standard slot without a player, in slot order. GameInput::CopyPadStateForPlayer
+ * 0x004D0528 reads a player's pad through that map (0x004D0418). So player 1 = the first connected port, player 2
+ * (co-op) = the next one. PadDriver::ThreadBody 0x00073D40 polls ports 0..6 (cellPadPeriphGetInfo, cellPadGetData).
+ *
+ * Rule (automatic, no setting): while a host pad is connected, the keyboard is reported as one more controller on the
+ * first port without a pad. Its keys go to that port only once the game has given that slot a player (the co-op
+ * player 2, or player 1 when the pad is gone); until then (every single-player game and all menus outside a co-op
+ * session) they go into the port of the game's player 1, as before 4026. So one player on pad + keyboard plays as
+ * today, and the co-op gate sees two controllers. With no pad, the keys are port 0 alone as before. An EBOOT not
+ * recognised (another title, a changed binary): no own port, as before. KZ3_KB_OWN_PORT=0 turns it off.
+ * Platform-free (host test tools/net/test_kb_port.c). */
+#ifndef PAD_KBPORT_H
+#define PAD_KBPORT_H
+#include <stdint.h>
+
+#define PKP_SLOTS 7
+
+typedef uint32_t (*pkp_rd32_fn)(uint32_t ea);
+
+typedef struct {
+    const char* name;
+    uint32_t chk_addr[2], chk_word[2];   /* two words of the player-assignment function 0x004D5ED0 (1.14) */
+    uint32_t base;                       /* the GameInput/Game object */
+    uint32_t player_off;                 /* base + player_off + i * 0x90 = slot i's player (int32, -1 none) */
+    uint32_t conn_off;                   /* base + conn_off + i * 0x90 = slot i connected (byte) */
+} PkpVersion;
+
+static const PkpVersion pkp_versions[2] = {
+    /* 1.00 0x004C8FD4: lwz r4,0x94(r3) at +0x74, lwz r3,0x768(r30) at +0x40 */
+    { "1.00", { 0x004C9048u, 0x004C9014u }, { 0x80830094u, 0x807E0768u }, 0x01587880u, 0x94u, 0x90u },
+    /* 1.14 0x004D5ED0: lwz r4,0x9c(r3) at +0x74, lwz r3,0x778(r30) at +0x40 */
+    { "1.14", { 0x004D5F44u, 0x004D5F10u }, { 0x8083009Cu, 0x807E0778u }, 0x015FCF80u, 0x9Cu, 0x98u },
+};
+
+/* -1 = neither EBOOT. */
+static inline int pkp_detect(pkp_rd32_fn rd32)
+{
+    for (int v = 0; v < 2; v++) {
+        const PkpVersion* p = &pkp_versions[v];
+        if (rd32(p->chk_addr[0]) == p->chk_word[0] && rd32(p->chk_addr[1]) == p->chk_word[1]) return v;
+    }
+    return -1;
+}
+
+/* The game's player per slot. Returns 0 when the table is not set up yet (boot: zeroed memory reads as player 0
+ * everywhere; once set up at least PKP_SLOTS - 4 slots hold -1, since at most players 0..3 exist). */
+static inline int pkp_players(int ver, pkp_rd32_fn rd32, int player[PKP_SLOTS])
+{
+    int none = 0;
+    if (ver < 0) return 0;
+    for (int i = 0; i < PKP_SLOTS; i++) {
+        int32_t p = (int32_t)rd32(pkp_versions[ver].base + pkp_versions[ver].player_off + (uint32_t)i * 0x90u);
+        if (p < -1 || p > 3) return 0;
+        player[i] = p;
+        if (p == -1) none++;
+    }
+    return none >= PKP_SLOTS - 4;
+}
+
+typedef struct {
+    int kb_port;     /* the keyboard's own port (reported connected), -1 = none */
+    int target;      /* the port the keys are added to */
+    int exclusive;   /* 1: target == kb_port (the game gave the keyboard's slot a player) */
+} PkpRoute;
+
+/* pad_on[i]: a host pad on port i (before the keys); nports usable ports; player = pkp_players' table or NULL. */
+static inline PkpRoute pkp_route(const int* pad_on, int nports, const int* player)
+{
+    PkpRoute r = { -1, 0, 0 };
+    int any = 0, kb = -1;
+    if (nports > PKP_SLOTS) nports = PKP_SLOTS;
+    for (int i = 0; i < nports; i++) {
+        if (pad_on[i]) any = 1;
+        else if (kb < 0) kb = i;
+    }
+    if (!any || !player || kb < 0) return r;   /* no pad, unknown EBOOT, every port taken: as before */
+    r.kb_port = kb;
+    if (player[kb] >= 0) { r.target = kb; r.exclusive = 1; return r; }
+    for (int i = 0; i < nports; i++)
+        if (player[i] == 0 && pad_on[i]) { r.target = i; return r; }
+    return r;   /* no player 1 yet: port 0, as before */
+}
+
+#endif
