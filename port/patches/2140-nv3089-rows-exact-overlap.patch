@@ -1613,8 +1615,8 @@ static void nv3089_blit_body(void)
         tiled_done = 1;   /* every row went through the tiling; no per-pixel loop */
     } else if (nv3089_rows_on() && s_nv3089.ds_dx == 0x100000u && s_nv3089.dt_dy == 0x100000u) {
         extern u8* vm_base;
-        rows_done = nv3089_rows_copy(vm_base, src, in_pitch, u0, v0, dst, dst_pitch, out_x, out_y, out_w, out_h,
-                                     cx0, cx1, cy0, cy1, bpp, &nv_bytes, nv3089_dst_plain);
+        rows_done = nv3089_rows_copy_x(vm_base, src, in_pitch, u0, v0, dst, dst_pitch, out_x, out_y, out_w, out_h,
