+/* KZ3 patch 1085 (diagnostic, opt-in): event trace. When g_kz3_wtrace is set (port/spu/kz3_frame_trace.c,
+ * KZ3_FRAME_TRACE) every accounted bracket and note, every job-module change, every flip and every WWS job call
+ * (PM -> job entry -> back) is also passed to it with its host times (ns, kz3_wacct_now) and the calling thread's
+ * wacct name. Kinds beyond KZ3_WA_NKIND: */
+enum {
+    KZ3_WT_FLIP = 32,
+    KZ3_WT_JOBCALL = 33,     /* site = image | runJobNum << 16 */
+    KZ3_WT_UCMD_QUEUE = 34,  /* GCM walker queued a user command (site = cmd) */
+    KZ3_WT_UCMD_DELIVER = 35 /* a PPU thread's pump runs its handler (site = cmd) */
+};
+extern void (*g_kz3_wtrace)(const char* thr, int kind, uint32_t site, uint64_t t0, uint64_t t1);
+void kz3_wacct_trace(int kind, uint32_t site, uint64_t t0, uint64_t t1);  /* patch 1085 */
+uint64_t kz3_wacct_base(void);                                            /* patch 1085: KZ3_PROF's time zero (ns) */
 
 extern int g_kz3_wacct;                     /* -1 = not read yet, 0 = off, else window ms */
 int      kz3_wacct_init(void);
