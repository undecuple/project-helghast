+void kz3_jobcall_open(spu_context* ctx, uint32_t lr)
+{
+    const uint32_t jn = ((uint32_t)ctx->ls[0x12E2] << 8) | ctx->ls[0x12E3];
+    t_kz3_jc.t0 = kz3_wacct_now();
+    t_kz3_jc.lr = lr;
+    t_kz3_jc.depth = ctx->host_depth;
+    t_kz3_jc.site = jn << 16;   /* the image is known once the overlay matched: taken at the close */
+}
+void kz3_jobcall_close(spu_context* ctx, uint32_t pc)
+{
+    if (!t_kz3_jc.t0 || (pc & SPU_LS_MASK) != t_kz3_jc.lr || ctx->host_depth != t_kz3_jc.depth) return;
+    kz3_wacct_trace(33 /* KZ3_WT_JOBCALL */, t_kz3_jc.site | (uint32_t)(ctx->resident_ovl & 0xFFFF), t_kz3_jc.t0,
+                    kz3_wacct_now());
+    t_kz3_jc.t0 = 0;
+}
