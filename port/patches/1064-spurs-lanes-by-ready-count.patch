+/* KZ3 patch 1064 (SPU pass 48): per wid, how many dispatches saw each ready count (0..7+) before the pass consumed
+ * one unit, and how many lanes each dispatch ran; KZ3_SPURS_LANES_READY=1 caps the lanes of a kicked dispatch at that
+ * ready count (SPURS semantics: readyCount = the number of SPUs the workload asks for, up to maxContention; the
+ * runtime ran maxContention lanes for every kick, which with the game's real HiPrio count of 5 (patch 1062) ran five
+ * job-manager lanes per list and hung the menu). Printed every 10 s next to the [spurs-ready] line. */
+static long s_kz3_lanes_rc[CELL_SPURS_MAX_WORKLOAD][8], s_kz3_lanes_n[CELL_SPURS_MAX_WORKLOAD][8];
+static int kz3_lanes_ready_on(void)
+{
+    static int s = -1;
+    if (s < 0) { const char* e = getenv("KZ3_SPURS_LANES_READY"); s = (e && *e == '1') ? 1 : 0; }
+    return s;
+}
+static void kz3_lanes_report(unsigned long long t_s)
+{
+    char line[480]; int o = 0;
+    for (u32 w = 0; w < CELL_SPURS_MAX_WORKLOAD; w++) {
+        long c = 0; for (int k = 0; k < 8; k++) c += s_kz3_lanes_rc[w][k];
+        if (!c || o >= (int)sizeof line - 80) continue;
+        o += snprintf(line + o, sizeof line - (size_t)o, " w%u:rc", w);
+        for (int k = 0; k < 8; k++) if (s_kz3_lanes_rc[w][k]) o += snprintf(line + o, sizeof line - (size_t)o, " %d=%ld", k, s_kz3_lanes_rc[w][k]);
+        o += snprintf(line + o, sizeof line - (size_t)o, " lanes");
+        for (int k = 0; k < 8; k++) if (s_kz3_lanes_n[w][k]) o += snprintf(line + o, sizeof line - (size_t)o, " %d=%ld", k, s_kz3_lanes_n[w][k]);
+    }
+    fprintf(stderr, "[spurs-lanes] t=%llus%s (dispatches by ready count before the pass / by lanes run)%s\n", t_s,
+            o ? line : " none", kz3_lanes_ready_on() ? " [KZ3_SPURS_LANES_READY]" : "");
+}
