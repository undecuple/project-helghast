@@ -0,0 +1,145 @@
+/* KZ3 patch 2187 (stutter Task 0): vblank/flip timing statistics for the RSX_ATTRIB=1 attribution lines. Pure C
+ * (no OS calls: the caller passes QPC ticks), so tools/smoke builds it on the host. All counters are updated only when
+ * the caller found the switch on; with it off nothing here runs.
+ *
+ * One window (10 s) is reported by one reader thread (the frame thread) with rsx_sd_vb_report, which also resets it.
+ * Writers: the frame thread (ticks, passes, lateness, flip completion), the thread that delivers the guest's vblank
+ * handler (a guest thread at an HLE boundary or the interrupt thread), the walker (flip marker). Sample arrays take
+ * an atomic index; a writer racing the reset may drop or misplace one sample (a diagnostic, not an accounting). */
+#ifndef RSX_STUTTER_DIAG_H
+#define RSX_STUTTER_DIAG_H
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define RSX_SD_CAP 8192u
+typedef struct { double v[RSX_SD_CAP]; atomic_uint n; } rsx_sd_samples;
+
+typedef struct {
+    double n, p50, p95, max;
+} rsx_sd_stat;
+
+static void rsx_sd_add(rsx_sd_samples* s, double v)
+{
+    const unsigned i = atomic_fetch_add_explicit(&s->n, 1u, memory_order_relaxed);
+    if (i < RSX_SD_CAP) s->v[i] = v;
+}
+
+static int rsx_sd_cmp(const void* a, const void* b)
+{
+    const double x = *(const double*)a, y = *(const double*)b;
+    return x < y ? -1 : x > y;
+}
+
+/* Statistics of the window's samples (nearest rank: the smallest value with at least q of the samples at or below
+ * it), then reset. n counts every add, also those past the capacity. */
+static rsx_sd_stat rsx_sd_take(rsx_sd_samples* s)
+{
+    static double tmp[RSX_SD_CAP];   /* one reader */
+    rsx_sd_stat r = {0, 0, 0, 0};
+    unsigned n = atomic_exchange(&s->n, 0u);
+    r.n = n;
+    if (n > RSX_SD_CAP) n = RSX_SD_CAP;
+    if (!n) return r;
+    memcpy(tmp, s->v, n * sizeof(double));
+    qsort(tmp, n, sizeof(double), rsx_sd_cmp);
+    unsigned i50 = (n + 1u) / 2u, i95 = (unsigned)((19u * n + 19u) / 20u);   /* ceil(q n) */
+    if (i50 < 1) i50 = 1;
+    if (i95 < 1) i95 = 1;
+    r.p50 = tmp[i50 - 1u];
+    r.p95 = tmp[i95 - 1u];
+    r.max = tmp[n - 1u];
+    return r;
+}
+
+typedef struct {
+    rsx_sd_samples late_ms;       /* each fired tick: QPC now minus its ideal time */
+    rsx_sd_samples deliver_ms;    /* oldest tick not yet delivered to the guest handler -> delivery */
+    rsx_sd_samples flip_ms;       /* flip marker executed by the drain -> completion by the vblank beat */
+    atomic_ullong ticks;          /* vblank ticks fired (frame thread) */
+    atomic_ullong calls;          /* guest vblank handler calls */
+    atomic_ullong passes;         /* frame-thread passes that fired at least one tick */
+    atomic_ullong burst_passes;   /* passes that fired two or more ticks */
+    atomic_ullong burst_ticks;    /* ticks past the first, summed over burst passes */
+    atomic_uint   max_fired;
+    atomic_uint   max_merged;     /* most ticks one handler call stood for */
+    atomic_uint   since_call;     /* ticks since the previous handler call */
+    atomic_llong  oldest_tick;    /* QPC of the oldest undelivered tick, 0 = none */
+    atomic_llong  marker_qpc;     /* QPC of the oldest unmatched flip marker, 0 = none */
+    atomic_ullong poll_waiting, poll_done;   /* cellGcmGetFlipStatus results */
+    atomic_ullong ref_pub_last;   /* gcm_ref_publish_one counter at the last report */
+} rsx_sd_vb;
+
+static double rsx_sd_ms(int64_t dq, int64_t freq) { return freq > 0 ? 1000.0 * (double)dq / (double)freq : 0.0; }
+
+static void rsx_sd_tick(rsx_sd_vb* v, int64_t qpc)
+{
+    atomic_fetch_add(&v->ticks, 1u);
+    atomic_fetch_add(&v->since_call, 1u);
+    int64_t z = 0;
+    atomic_compare_exchange_strong(&v->oldest_tick, &z, qpc);
+}
+
+static void rsx_sd_late(rsx_sd_vb* v, int64_t qpc_now, int64_t qpc_ideal, int64_t freq)
+{
+    rsx_sd_add(&v->late_ms, rsx_sd_ms(qpc_now - qpc_ideal, freq));
+}
+
+static void rsx_sd_pass(rsx_sd_vb* v, unsigned fired)
+{
+    if (!fired) return;
+    atomic_fetch_add(&v->passes, 1u);
+    if (fired >= 2u) {
+        atomic_fetch_add(&v->burst_passes, 1u);
+        atomic_fetch_add(&v->burst_ticks, fired - 1u);
+    }
+    unsigned m = atomic_load(&v->max_fired);
+    while (fired > m && !atomic_compare_exchange_weak(&v->max_fired, &m, fired)) {}
+}
+
+static void rsx_sd_deliver(rsx_sd_vb* v, int64_t qpc_now, int64_t freq)
+{
+    atomic_fetch_add(&v->calls, 1u);
+    const unsigned merged = atomic_exchange(&v->since_call, 0u);
+    unsigned m = atomic_load(&v->max_merged);
+    while (merged > m && !atomic_compare_exchange_weak(&v->max_merged, &m, merged)) {}
+    const int64_t t = atomic_exchange(&v->oldest_tick, 0);
+    if (t) rsx_sd_add(&v->deliver_ms, rsx_sd_ms(qpc_now - t, freq));
+}
+
+static void rsx_sd_marker(rsx_sd_vb* v, int64_t qpc)
+{
+    int64_t z = 0;
+    atomic_compare_exchange_strong(&v->marker_qpc, &z, qpc);
+}
+
+static void rsx_sd_flip_done(rsx_sd_vb* v, int64_t qpc_now, int64_t freq)
+{
+    const int64_t t = atomic_exchange(&v->marker_qpc, 0);
+    if (t) rsx_sd_add(&v->flip_ms, rsx_sd_ms(qpc_now - t, freq));
+}
+
+/* The [vblank] line for the window that ended at qpc_now (win_s seconds long); resets the window. ref_pub_total is
+ * the running count of gcm_ref_publish_one calls (the per-second figure is its difference since the last report). */
+static int rsx_sd_report(rsx_sd_vb* v, char* buf, size_t cap, int64_t qpc_now, double win_s, unsigned long long ref_pub_total)
+{
+    const rsx_sd_stat l = rsx_sd_take(&v->late_ms), d = rsx_sd_take(&v->deliver_ms), f = rsx_sd_take(&v->flip_ms);
+    const unsigned long long ticks = atomic_exchange(&v->ticks, 0ull), calls = atomic_exchange(&v->calls, 0ull);
+    const unsigned long long passes = atomic_exchange(&v->passes, 0ull), bp = atomic_exchange(&v->burst_passes, 0ull),
+                             bt = atomic_exchange(&v->burst_ticks, 0ull);
+    const unsigned mf = atomic_exchange(&v->max_fired, 0u), mm = atomic_exchange(&v->max_merged, 0u);
+    const unsigned long long pw = atomic_exchange(&v->poll_waiting, 0ull), pd = atomic_exchange(&v->poll_done, 0ull);
+    const unsigned long long rp = ref_pub_total - atomic_exchange(&v->ref_pub_last, ref_pub_total);
+    const double w = win_s > 0 ? win_s : 1.0;
+    return snprintf(buf, cap,
+        "[vblank] qpc=%lld win=%.1fs ticks=%llu late_ms p50=%.2f p95=%.2f max=%.2f | passes=%llu burst_passes=%llu "
+        "burst_ticks=%llu max_fired=%u | handler_calls=%llu ticks_per_call=%.2f max_merged=%u tick_to_handler_ms "
+        "n=%.0f p50=%.2f p95=%.2f max=%.2f | flip_marker_to_done_ms n=%.0f p50=%.2f p95=%.2f max=%.2f | "
+        "ref_publish_per_s=%.1f | flip_status_polls waiting=%llu done=%llu",
+        (long long)qpc_now, win_s, ticks, l.p50, l.p95, l.max, passes, bp, bt, mf, calls,
+        calls ? (double)ticks / (double)calls : 0.0, mm, d.n, d.p50, d.p95, d.max, f.n, f.p50, f.p95, f.max,
+        (double)rp / w, pw, pd);
+}
+#endif

