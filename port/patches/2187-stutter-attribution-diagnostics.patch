+++ b/libs/video/rsx_present_stream.h
@@ -0,0 +1,89 @@
+/* KZ3 patch 2187 (stutter Task 0): whole-run per-present QPC stream. Pure C (no OS calls), so tools/smoke builds it on
+ * the host.
+ *
+ * Idea and shape from Killzone 2 patch 6073 (same author, MIT; port/patches/6073-present-qpc-stream-whole-run.patch):
+ * upstream's ld_present_measure_record dumped the ring once at guest frame 2293 and a run ended by a kill never reached
+ * the shutdown dump. With RSX_PRESENT_QPC_STREAM=1 the CSV is opened at init and each batch of RSX_PS_BATCH samples is
+ * appended and flushed when it fills (on the present thread, after that present's QPC was read), so a kill loses at
+ * most the last RSX_PS_BATCH - 1 presents. The stream file has a second comment line
+ *   # clock qpc=<ticks> filetime=<100 ns since 1601 UTC>
+ * tying the QPC to the wall clock. Columns are those of the shutdown dump (present_id,guest_frame,qpc, plus the five
+ * schedule columns with RSX_SCHEDULE_DIAG). A sample the ring already overwrote is never fabricated. */
+#ifndef RSX_PRESENT_STREAM_H
+#define RSX_PRESENT_STREAM_H
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+
+#define RSX_PS_BATCH 64u
+
+typedef struct {
+    uint64_t present_id;
+    uint32_t guest_frame;
+    int64_t  qpc;
+    uint64_t process_kernel_100ns, process_user_100ns, present_thread_kernel_100ns, present_thread_user_100ns;
+    uint32_t present_thread_id;
+} rsx_ps_sample;
+
+typedef struct {
+    FILE* f;
+    uint64_t written;      /* presents already in the file (ids 1..written, minus ones the ring lost) */
+    atomic_flag lock;
+    int diag;              /* schedule columns */
+} rsx_ps_stream;
+
+static void rsx_ps_columns(FILE* f, int diag)
+{
+    if (diag)
+        fprintf(f, "present_id,guest_frame,qpc,process_kernel_100ns,process_user_100ns,"
+                   "present_thread_kernel_100ns,present_thread_user_100ns,present_thread_id\n");
+    else
+        fprintf(f, "present_id,guest_frame,qpc\n");
+}
+
+static void rsx_ps_row(FILE* f, int diag, const rsx_ps_sample* s)
+{
+    if (diag)
+        fprintf(f, "%llu,%u,%lld,%llu,%llu,%llu,%llu,%u\n", (unsigned long long)s->present_id, s->guest_frame,
+                (long long)s->qpc, (unsigned long long)s->process_kernel_100ns,
+                (unsigned long long)s->process_user_100ns, (unsigned long long)s->present_thread_kernel_100ns,
+                (unsigned long long)s->present_thread_user_100ns, s->present_thread_id);
+    else
+        fprintf(f, "%llu,%u,%lld\n", (unsigned long long)s->present_id, s->guest_frame, (long long)s->qpc);
+}
+
+/* Takes ownership of f (already open for writing). clock_qpc/filetime tie the QPC to the wall clock. */
+static void rsx_ps_open(rsx_ps_stream* st, FILE* f, int64_t freq, int64_t clock_qpc, uint64_t filetime, int diag)
+{
+    st->f = f;
+    st->written = 0;
+    st->diag = diag;
+    atomic_flag_clear(&st->lock);
+    fprintf(f, "# qpc_frequency=%lld\n", (long long)freq);
+    fprintf(f, "# clock qpc=%lld filetime=%llu\n", (long long)clock_qpc, (unsigned long long)filetime);
+    rsx_ps_columns(f, diag);
+    fflush(f);
+}
+
+/* Write the samples recorded since the last flush; ring has cap entries (power of two), total presents so far. */
+static void rsx_ps_flush(rsx_ps_stream* st, const rsx_ps_sample* ring, uint32_t cap, uint64_t total)
+{
+    while (atomic_flag_test_and_set_explicit(&st->lock, memory_order_acquire)) {}
+    if (st->f) {
+        uint64_t id = st->written + 1u;
+        if (total > cap && id < total - cap + 1u) id = total - cap + 1u;
+        for (; id <= total; ++id) {
+            const rsx_ps_sample* s = &ring[(id - 1u) & (cap - 1u)];
+            if (s->present_id == id) rsx_ps_row(st->f, st->diag, s);
+        }
+        st->written = total;
+        fflush(st->f);
+    }
+    atomic_flag_clear_explicit(&st->lock, memory_order_release);
+}
+
+static int rsx_ps_due(const rsx_ps_stream* st, uint64_t total)
+{
+    return st->f && total - st->written >= RSX_PS_BATCH;
+}
+#endif
