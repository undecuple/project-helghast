diff -ruN a/libs/input/cam_interp.h b/libs/input/cam_interp.h
--- /dev/null
+++ b/libs/input/cam_interp.h
@@ -0,0 +1,80 @@
+/* cam_interp.h (KZ3 patch 2114, RSX pass 107): render-time interpolation of a camera pose between two fixed-step
+ * simulation states, pure C, no runtime state (host test tools/smoke/test_cam_interp.c).
+ *
+ * A pose is 4 rows of 4 floats as the game stores it (rows 0-2 = the rotation basis, row 3 = the position; the 4th
+ * column is not used by the rotation). cam_interp_pose writes lerp(prev, cur, alpha) with rows 0-2 re-orthonormalised
+ * (Gram-Schmidt from the forward row 1, row 0 next, row 2 rebuilt with the handedness of the input) and row 3 lerped.
+ * For the per-step rotations of a turning view (< 0.3 rad) the lerped heading differs from the exact slerp by less
+ * than 0.2 % of the step (host test). cam_interp_cut tells when two states must not be blended (a cut). */
+#ifndef KZ3_CAM_INTERP_H
+#define KZ3_CAM_INTERP_H
+#include <math.h>
+
+enum {
+    CAM_CUT_NONE = 0,
+    CAM_CUT_INVALID = 1,   /* a pose has non-finite values or a basis that is not orthonormal */
+    CAM_CUT_MOVE = 2,      /* the position moved more than max_move between the states (fallback teleport test) */
+    CAM_CUT_TURN = 3       /* the forward row turned more than max_turn radians between the states (fallback) */
+};
+
+static inline float cam_dot3(const float* a, const float* b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; }
+
+/* 1 when rows 0-2 are finite, unit length and orthogonal within tol and row 3 is finite. */
+static inline int cam_pose_ok(const float m[4][4], float tol)
+{
+    for (int i = 0; i < 4; i++)
+        for (int j = 0; j < 3; j++)
+            if (!isfinite(m[i][j])) return 0;
+    for (int i = 0; i < 3; i++) {
+        if (fabsf(cam_dot3(m[i], m[i]) - 1.0f) > tol) return 0;
+        for (int j = i + 1; j < 3; j++)
+            if (fabsf(cam_dot3(m[i], m[j])) > tol) return 0;
+    }
+    return 1;
+}
+
+static inline int cam_interp_cut(const float prev[4][4], const float cur[4][4], float max_move, float max_turn)
+{
+    if (!cam_pose_ok(prev, 1e-2f) || !cam_pose_ok(cur, 1e-2f)) return CAM_CUT_INVALID;
+    float d[3] = {cur[3][0] - prev[3][0], cur[3][1] - prev[3][1], cur[3][2] - prev[3][2]};
+    if (cam_dot3(d, d) > max_move * max_move) return CAM_CUT_MOVE;
+    float c = cam_dot3(prev[1], cur[1]);
+    if (c > 1.0f) c = 1.0f;
+    if (c < -1.0f) c = -1.0f;
+    if (acosf(c) > max_turn) return CAM_CUT_TURN;
+    return CAM_CUT_NONE;
+}
+
+static inline void cam_norm3(float* v)
+{
+    const float l = sqrtf(cam_dot3(v, v));
+    if (l > 1e-12f) { v[0] /= l; v[1] /= l; v[2] /= l; }
+}
+
+/* out may alias neither input. alpha is clamped to [0, 1]; the 4th column is copied from cur. */
+static inline void cam_interp_pose(const float prev[4][4], const float cur[4][4], float alpha, float out[4][4])
+{
+    if (!(alpha >= 0.0f)) alpha = 0.0f;   /* also NaN */
+    if (alpha > 1.0f) alpha = 1.0f;
+    const float b = 1.0f - alpha;
+    for (int i = 0; i < 4; i++) {
+        for (int j = 0; j < 3; j++) out[i][j] = b * prev[i][j] + alpha * cur[i][j];
+        out[i][3] = cur[i][3];
+    }
+    float hand[3];
+    hand[0] = out[0][1] * out[1][2] - out[0][2] * out[1][1];
+    hand[1] = out[0][2] * out[1][0] - out[0][0] * out[1][2];
+    hand[2] = out[0][0] * out[1][1] - out[0][1] * out[1][0];
+    const float s = cam_dot3(hand, out[2]) < 0.0f ? -1.0f : 1.0f;   /* row 2 = s * (row 0 x row 1), as in the input */
+    cam_norm3(out[1]);
+    const float p = cam_dot3(out[0], out[1]);
+    for (int j = 0; j < 3; j++) out[0][j] -= p * out[1][j];
+    cam_norm3(out[0]);
+    out[2][0] = s * (out[0][1] * out[1][2] - out[0][2] * out[1][1]);
+    out[2][1] = s * (out[0][2] * out[1][0] - out[0][0] * out[1][2]);
+    out[2][2] = s * (out[0][0] * out[1][1] - out[0][1] * out[1][0]);
+}
+
+/* Heading of a pose's forward row (row 1) in a z-up world, radians. */
+static inline float cam_pose_yaw(const float m[4][4]) { return atan2f(m[1][1], m[1][0]); }
+#endif
