KZ3 patch 2036: pitch-linear B8 textures upload directly as R8_UNORM (RSX pass 35). The Bink movie planes
(1280x720 Y, 640x360 U and V, rewritten at 29.97 fps in the menus and cinematics; RE pass 72's texture table) were
decoded texel by texel into RGBA8 with the remap applied every time their content changed. They now go to an R8
resource as they are (a strided copy only when the pitch differs from the width), and write_texture_srv expresses
the remap as the SRV's component mapping (B8 reads A = 1, R = G = B = the byte). With patch 2035 the update lands in
the same resource. LD_B8_DIRECT=0 restores the RGBA8 decode; [tex-hash] gains b8-direct=N per 256 frames.
Upstream candidate (general: any title playing Bink/USM through B8 planes).

--- a/libs/video/rsx_live_draw.c
+++ b/libs/video/rsx_live_draw.c
@@ -2429,6 +2429,7 @@
  * Cube, 3D and vertex textures keep the old path. Counted in [tex-hash] as inplace=N. */
 static ID3D12Resource* g_ld_tex_reuse;
 static unsigned long long g_ld_tex_inplace_n;
+static unsigned long long g_ld_b8_direct_n;   /* patch 2036 */
 static int ld_tex_inplace_on(void)
 {
     static int on = -1;
@@ -2784,13 +2785,15 @@
     }
     if (rsx_perf_enabled() && (g_ld_frames % 256u) == 255u) {
         fprintf(stderr, "[tex-hash] span=%d frame=%u hashes=%llu skipped=%llu bytes=%.1fMB changes=%llu tracked=%llu"
-                        " untracked=%llu flip-flags=%llu inplace=%llu\n",
+                        " untracked=%llu flip-flags=%llu inplace=%llu b8-direct=%llu\n",
                 ld_tex_hash_span(), g_ld_frames, (unsigned long long)g_ld_th.hashes,
                 (unsigned long long)g_ld_th.skipped, (double)g_ld_th.hashed_bytes / 1048576.0,
                 (unsigned long long)g_ld_th.changes, (unsigned long long)g_ld_th.tracked,
-                (unsigned long long)g_ld_th.untracked, (unsigned long long)g_ld_th.flip_flags, g_ld_tex_inplace_n);
+                (unsigned long long)g_ld_th.untracked, (unsigned long long)g_ld_th.flip_flags, g_ld_tex_inplace_n,
+                g_ld_b8_direct_n);
         memset(&g_ld_th, 0, sizeof g_ld_th);
         g_ld_tex_inplace_n = 0;
+        g_ld_b8_direct_n = 0;
     }
 }
 
@@ -3041,6 +3044,31 @@
     return mapping;
 }
 
+/* KZ3 patch 2036: pitch-linear B8 textures (the Bink movie planes: 1280x720 Y, 640x360 U/V, rewritten at the movie's
+ * 29.97 fps) are uploaded as they are, one byte per texel into an R8_UNORM resource, instead of being decoded texel
+ * by texel into RGBA8 with the remap applied. write_texture_srv sees the R8 resource and puts the remap into the
+ * SRV's component mapping: B8 reads as A = 1, R = G = B = the byte (decode_texel), so a remap select of A becomes
+ * FORCE_1, any other select the R8 channel, op 0 / op 1 FORCE_0 / FORCE_1. A quarter of the upload, no per-texel
+ * loop. LD_B8_DIRECT=0 restores the RGBA8 decode. */
+static int ld_b8_direct_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LD_B8_DIRECT"); on = (e && e[0] == '0') ? 0 : 1; }
+    return on;
+}
+static u32 ld_r8_mapping(u32 remap)
+{
+    static const u32 out2comp[4] = { 1, 2, 3, 0 };
+    u32 m = 1u << 12;
+    for (u32 out = 0; out < 4; out++) {
+        const u32 comp = out2comp[out];
+        const u32 op = (remap >> (8 + comp * 2)) & 3;
+        const u32 sel = (remap >> (comp * 2)) & 3;
+        const u32 v = op == 0 ? 4u : op == 1 ? 5u : sel == 0 ? 5u : 0u;
+        m |= v << (3 * out);
+    }
+    return m;
+}
 static ID3D12Resource* decode_guest_texture(const rsx_dsp_texture* t, u32 remap)
 {
     const u32 base_fmt = t->format & TEX_FMT_BASE_MASK & ~(u32)TEX_FMT_UNNORM;
@@ -3065,6 +3093,27 @@
      * symptom on the same mechanism. */
     if (linear) n_mips = 1;
 
+    if (base_fmt == TEX_FMT_B8 && linear && !t->cubemap && ld_b8_direct_on()) {   /* patch 2036 */
+        const u32 pitch = t->pitch ? t->pitch : w;
+        if (pitch >= w) {
+            const u8* src = guest_ptr(t->location, t->offset, pitch * (h - 1) + w);
+            if (src) {
+                u8* tmp = NULL;
+                if (pitch != w) {
+                    tmp = (u8*)malloc((size_t)w * h);
+                    if (!tmp) return NULL;
+                    for (u32 y = 0; y < h; y++) memcpy(tmp + (size_t)y * w, src + (size_t)y * pitch, w);
+                }
+                tex_level_t lv;
+                lv.w = w; lv.h = h; lv.data = tmp ? tmp : src; lv.row_bytes = w; lv.rows = h;
+                ID3D12Resource* r = create_texture_mipped(DXGI_FORMAT_R8_UNORM, &lv, 1);
+                free(tmp);
+                g_ld_b8_direct_n++;
+                return r;
+            }
+        }
+    }
+
     if (base_fmt == TEX_FMT_DXT1 || base_fmt == TEX_FMT_DXT23 ||
         base_fmt == TEX_FMT_DXT45) {
         const DXGI_FORMAT dxgi = base_fmt == TEX_FMT_DXT1 ? DXGI_FORMAT_BC1_UNORM
@@ -3386,7 +3435,19 @@
         g.dev->lpVtbl->CreateShaderResourceView(
             g.dev, entry->tex, &desc, srv_cpu(SRV_TEXTURE_BASE + index));
     } else {
-        srv_write(SRV_TEXTURE_BASE + index, entry->tex);
+        D3D12_RESOURCE_DESC rd;   /* patch 2036: an R8 resource is a direct B8 upload */
+        entry->tex->lpVtbl->GetDesc(entry->tex, &rd);
+        if (rd.Format == DXGI_FORMAT_R8_UNORM && rd.Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE2D) {
+            D3D12_SHADER_RESOURCE_VIEW_DESC desc = {0};
+            desc.Format = DXGI_FORMAT_R8_UNORM;
+            desc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+            desc.Shader4ComponentMapping = ld_r8_mapping(entry->remap);
+            desc.Texture2D.MipLevels = (UINT)-1;
+            g.dev->lpVtbl->CreateShaderResourceView(
+                g.dev, entry->tex, &desc, srv_cpu(SRV_TEXTURE_BASE + index));
+        } else {
+            srv_write(SRV_TEXTURE_BASE + index, entry->tex);
+        }
     }
 }
 
