  * at LS 0x3000 (below it is the SPURS kernel/policy/context, 0x290..0x2FFF). */
 #define SPU_TASKSET_TASK_LO 0x3000u
 
+/* KZ3 patch 1043 (SPU pass 30): skip a streamed overlay module at its entry (A/B aid for KZ3's SPU
+ * visibility culling jobs, KZ3_SPU_SKIP_OVL / KZ3_CULL_AB in the port's generated registration). When the
+ * job manager (image 2) branches into a code module whose image id is marked here, and the link register
+ * points back below the module buffer (i.e. this is the manager's call of the module's entry, not a call
+ * inside the module), the branch is redirected to the link: the module "returns" at once and does no work.
+ * Tested on both dispatch paths (spu_dispatch_mt.c fast path and the resolver below); one global load on the
+ * fast path when nothing is marked. kz3-ovl-skip begin */
+#define KZ3_OVL_SKIP_MAX 512u   /* image ids: ELFs 1..43, policy modules, job modules 200..290 */
+int g_spu_ovl_skip_any = 0;
+static uint8_t s_ovl_skip[KZ3_OVL_SKIP_MAX];
+void spu_overlay_set_skip(int image_id, int on)
+{
+    if (image_id <= 0 || image_id >= (int)KZ3_OVL_SKIP_MAX) return;
+    s_ovl_skip[image_id] = (uint8_t)(on != 0);
+    g_spu_ovl_skip_any = 0;
+    for (unsigned i = 0; i < KZ3_OVL_SKIP_MAX; i++) if (s_ovl_skip[i]) g_spu_ovl_skip_any = 1;
+}
+/* Returns 1 after redirecting ctx->pc to the link register (masked). Call only when g_spu_ovl_skip_any. */
+int spu_overlay_skip_entry(spu_context* ctx, int img)
+{
+    uint32_t pc = ctx->pc & SPU_LS_MASK;
+    if (img <= 0 || img >= (int)KZ3_OVL_SKIP_MAX || !s_ovl_skip[img]) return 0;
+    if (ctx->image_id != 2 || pc < 0x4000 || pc >= 0x3E000) return 0;
+    uint32_t link = ctx->gpr[0]._u32[0] & SPU_LS_MASK;
+    if (link >= 0x4000) return 0;                 /* a call inside the module: not its entry */
+    static unsigned s_n[KZ3_OVL_SKIP_MAX];
+    if (s_n[img]++ < 2)
+        fprintf(stderr, "[spu-ovl-skip] image %d entry pc=0x%05X skipped, returning to link 0x%05X (%u so far)\n",
+                img, pc, link, s_n[img]);
+    ctx->pc = link;
+    return 1;
+}
+/* kz3-ovl-skip end */
+
 /* Content-signature variant: FMOD COPIES codec overlays to the heap before
