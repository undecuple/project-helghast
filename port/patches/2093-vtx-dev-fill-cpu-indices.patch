+/* Patch 2093: a fill's bytes come only from CPU memory. *buf, *cap = a scratch for the draw's u32 indices, grown to
+ * `bytes` (1 = ready). The topology indices are built there, then copied to the index ring and the staging block:
+ * both are UPLOAD-heap mappings (write-combined), which are written but never read (2092 copied ring -> staging,
+ * 4.8 ms/frame for 2.5 MB on K4). Staging block layout: payload | pad to vb_r | indices; ring_ib (optional) gets
+ * the indices too. */
+static inline int rsx_vd_scratch(uint32_t** buf, uint32_t* cap, uint32_t bytes)
+{
+    if (*cap >= bytes) return 1;
+    uint32_t* n = (uint32_t*)realloc(*buf, bytes);
+    if (!n) return 0;
+    *buf = n; *cap = bytes;
+    return 1;
+}
+static inline void rsx_vd_stage_write(uint8_t* stage, uint8_t* ring_ib, const void* vb, uint32_t vb_bytes, uint32_t vb_r,
+                                      const uint32_t* ix, uint32_t ib_bytes)
+{
+    memcpy(stage, vb, vb_bytes);
+    if (ib_bytes) { memcpy(stage + vb_r, ix, ib_bytes); if (ring_ib) memcpy(ring_ib, ix, ib_bytes); }
+}
