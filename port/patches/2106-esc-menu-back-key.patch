+/* Patch 2106: two inputs may share a key when one is menu-only and the other is start or circle (the menu input wins
+ * in menus, the other in play; menu Back = Circle anyway). Every other shared key is a conflict. */
+static int pad_kb_share_ok(int a, int b)
+{
+    const int ma = pad_kb_inputs[a].dir == PKB_DIR_MENU, mb = pad_kb_inputs[b].dir == PKB_DIR_MENU;
+    const int o = ma ? b : a;
+    if (ma == mb) return 0;
+    return pad_kb_inputs[o].btn == PKB_START || pad_kb_inputs[o].btn == PKB_CIRCLE;
+}
+/* 1 when vk, bound to input `in`, is also bound to an input it may not share with */
+static int pad_kb_key_conflicts(const PadKeybinds* kb, int in, int vk)
+{
+    int i;
+    if (!vk || in < 0) return 0;
+    for (i = 0; i < PKB_N_INPUTS; i++)
+        if (i != in && (kb->key[i][0] == vk || kb->key[i][1] == vk) && !pad_kb_share_ok(in, i)) return 1;
+    return 0;
+}
 
