+static int pad_kb_menu_key(const PadKeybinds* kb, int vk)
+{
+    int i;
+    if (!vk) return 0;
+    for (i = 0; i < PKB_N_INPUTS; i++)
+        if (pad_kb_inputs[i].dir == PKB_DIR_MENU && (kb->key[i][0] == vk || kb->key[i][1] == vk)) return 1;
+    return 0;
