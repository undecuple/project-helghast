gcm/live-draw: NV0039 buffer copy (cellGcmSetTransferData) on subchannel 1, with texture invalidation and surface write-back.

Symptom (Killzone 3, RPCS3 capture of the first level, pass 18): libgcm's cellGcmSetTransferData (KZ3 0x008D2DAC)
emits NV0039 on subchannel 1 (0x2184 x2 DMA in/out, 0x230C x8 OFFSET_IN..BUFFER_NOTIFY, FORMAT 0x101). Once per
frame KZ3 copies its 1280x720 scene target (local 0x1300000, 0x384000 bytes, one line) into main memory (IO
offset 0x1310400). The walker routed subchannel 1 to the 3D engine (a Twisted Metal workaround), so the copy never
ran and its eight words were processed as NV4097 0x30C..0x328 (ALPHA_REF, BLEND_ENABLE, BLEND_FUNC, BLEND_COLOR,
BLEND_EQUATION, COLOR_MASK, STENCIL_TEST_ENABLE).

Fix:
- cellGcmSys walker: SET_OBJECT bindings are recorded per subchannel. On subchannel 1, NV0039's own methods
  (0x180/0x184/0x188, 0x30C..0x328) go to a new NV0039 engine; all other methods still go to NV4097, and binding
  subchannel 1 to the same handle as subchannel 0 turns the split off. GCM_SUBCH1_NV0039=0 restores the old routing.
- NV0039 engine: DMA in/out (0xFEED0000 local, 0xFEED0001 main), signed pitches, LINE_LENGTH_IN x LINE_COUNT,
  FORMAT increments (1/1 = memmove per line; others byte-strided, ASSUMPTION), BUFFER_NOTIFY triggers. Notifier
  writes are not implemented (logged). Range-checked against the 4 GB guest space.
- Before copying out of local memory, rsx_live_draw_writeback_range writes every live colour surface overlapping
  the source back into guest memory (GPU readback; A8R8G8B8 as A,R,G,B bytes, the inverse of the texture decode;
  FP16/FP32 big-endian). Surfaces now remember their guest pitch. LD_NV0039_WRITEBACK=0 disables.
- After the copy, rsx_live_draw_note_guest_write marks cached textures / vertex textures overlapping the
  destination so their next bind re-hashes even within the same frame (texture entries record their span).
  Vertex data needs nothing (uploaded per draw).
- Diagnostics: NV0039_DBG=<N> logs the first N copies; copies #1, 2, 4, 8, ... print running totals.

Verified with tools/smoke/test_nv0039.c under Proton (main->local copy then draw, same-frame overwrite and redraw,
local->main with pitches, negative pitch, FP16 and RGBA8 surfaces copied out, all bit-exact).

Rebased on ps3recomp v0.17.0 (SPU pass 95): partly absorbed: the surface pitch field is #395's.

Rebased on ps3recomp v0.18.0 (SPU pass 108): SET_OBJECT memo inside upstream's wdiag-gated block; nv0039 exclusion added to upstream's gcm_3d_method dispatch.

diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
index d7133a18..27442759 100644
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -1401,8 +1401,133 @@ static void nv3089_blit(void)
                out_w, out_h, f, src, in_pitch, dst, dst_pitch, out_x, out_y); } }
 }
 
+/* ---------------------------------------------------------------------------
+ * Patch 2015: NV0039 buffer copy (memory-to-memory format, libgcm subchannel 1).
+ *
+ * cellGcmSetTransferData (Killzone 3: 0x008D2DAC) emits on subchannel 1:
+ *   0x0184 count 2  SET_CONTEXT_DMA_BUFFER_IN / _OUT (0xFEED0000 local,
+ *                   0xFEED0001 main)
+ *   0x030C count 8  OFFSET_IN, OFFSET_OUT, PITCH_IN, PITCH_OUT,
+ *                   LINE_LENGTH_IN, LINE_COUNT, FORMAT, BUFFER_NOTIFY
+ * in chunks of at most 0x7FF lines, FORMAT 0x101 (in/out increment 1).
+ * BUFFER_NOTIFY triggers the copy. Pitches are signed. 0x0180 is the notify
+ * DMA; notifier writes are not implemented (cellGcmSetTransferData passes 0).
+ *
+ * Before this, subchannel 1 went to the 3D engine by default (Twisted Metal
+ * binds NV4097 there), so every copy was dropped and its words landed on
+ * NV4097 0x30C..0x328: ALPHA_REF, BLEND_ENABLE, BLEND_FUNC_SFACTOR/DFACTOR,
+ * BLEND_COLOR, BLEND_EQUATION, COLOR_MASK (= FORMAT 0x101) and
+ * STENCIL_TEST_ENABLE (ASSUMPTION: without visible effect on live-draw).
+ * -----------------------------------------------------------------------*/
+static u32 s_subch_obj[8];
+static u8  s_subch_obj_set[8];
+static struct {
+    u32 notify_dma, src_dma, dst_dma;
+    u32 off_in, off_out;
+    s32 pitch_in, pitch_out;
+    u32 line_len, line_count, format;
+} s_nv0039 = { 0, 0xFEED0000u, 0xFEED0000u, 0, 0, 0, 0, 0, 0, 0x101u };
+static unsigned long long s_nv0039_copies, s_nv0039_bytes, s_nv0039_dir[4], s_nv0039_marked, s_nv0039_wb;
+
+/* Does method `m` on subchannel 1 belong to NV0039? Only NV0039's own method
+ * numbers are claimed, so a title that drives NV4097 through subchannel 1
+ * (texture offsets, SET_SHADER_PROGRAM) keeps working; a SET_OBJECT that binds
+ * subchannel 1 to the same handle as subchannel 0 turns it off entirely.
+ * GCM_SUBCH1_NV0039=0 restores the old routing. */
+static int gcm_subch1_nv0039(u32 m)
+{
+    static int en = -1;
+    if (en < 0) { const char* e = getenv("GCM_SUBCH1_NV0039"); en = e ? atoi(e) : 1; }
+    if (!en) return 0;
+    if (s_subch_obj_set[0] && s_subch_obj_set[1] && s_subch_obj[0] == s_subch_obj[1]) return 0;
+    return m == 0x0180u || m == 0x0184u || m == 0x0188u || (m >= 0x030Cu && m <= 0x0328u);
+}
+
+static void nv0039_copy(u32 notify)
+{
+    const u32 len = s_nv0039.line_len, n = s_nv0039.line_count;
+    u32 in_inc = s_nv0039.format & 0xFFu, out_inc = (s_nv0039.format >> 8) & 0xFFu;
+    if (!in_inc) in_inc = 1;
+    if (!out_inc) out_inc = 1;
+    if (!len || !n) return;
+    const int sl = s_nv0039.src_dma != 0xFEED0001u, dl = s_nv0039.dst_dma != 0xFEED0001u;
+    const u32 src = cellGcmResolveLocated(sl, s_nv0039.off_in);
+    const u32 dst = cellGcmResolveLocated(dl, s_nv0039.off_out);
+    const s64 pin = s_nv0039.pitch_in, pout = s_nv0039.pitch_out;
+    extern u8* vm_base;
+    if (!vm_base || !src || !dst) return;
+    const s64 last_in = (s64)src + (s64)(n - 1) * pin, last_out = (s64)dst + (s64)(n - 1) * pout;
+    const s64 lo_in = last_in < (s64)src ? last_in : (s64)src, hi_in = (last_in > (s64)src ? last_in : (s64)src) + (s64)len * in_inc;
+    const s64 lo_out = last_out < (s64)dst ? last_out : (s64)dst, hi_out = (last_out > (s64)dst ? last_out : (s64)dst) + (s64)len * out_inc;
+    if (lo_in < 0 || lo_out < 0 || hi_in > 0x100000000ll || hi_out > 0x100000000ll) {
+        static int bad; if (bad++ < 8)
+            printf("[NV0039] copy out of range: src=0x%08X pitch %d dst=0x%08X pitch %d %ux%u%c",
+                   src, (int)pin, dst, (int)pout, len, n, 10);
+        return;
+    }
+    /* A copy out of a surface the live renderer drew: its pixels exist only on
+     * the GPU. Write the surface back into guest memory first (Killzone 3 copies
+     * its 1280x720 scene target to main memory once per frame, RPCS3 capture,
+     * ASSUMPTION: for SPU post-processing), then copy in guest memory. No GPU
+     * surface is created at the destination (unlike NV3089): the CPU/SPU side
+     * owns that copy, and texture binds re-read it from guest memory. */
+    u32 wb = 0;
+    if (rsx_live_draw_enabled())
+        wb = rsx_live_draw_writeback_range(sl ? 0u : 1u, (u32)(lo_in - (s64)src) + s_nv0039.off_in,
+                                           (u32)(hi_in - lo_in));
+    s_nv0039_wb += wb;
+    for (u32 y = 0; y < n; y++) {
+        u8* d = vm_base + (u32)((s64)dst + (s64)y * pout);
+        const u8* sp = vm_base + (u32)((s64)src + (s64)y * pin);
+        if (in_inc == 1 && out_inc == 1) memmove(d, sp, len);
+        else  /* ASSUMPTION: FORMAT is the byte increment on each side (NV m2mf). */
+            for (u32 x = 0; x < len; x++) d[(size_t)x * out_inc] = sp[(size_t)x * in_inc];
+    }
+    u32 marked = 0;
+    if (rsx_live_draw_enabled())
+        marked = rsx_live_draw_note_guest_write(dl ? 0u : 1u, (u32)(lo_out - (s64)dst) + s_nv0039.off_out,
+                                                (u32)(hi_out - lo_out));
+    s_nv0039_copies++;
+    s_nv0039_bytes += (unsigned long long)len * n;
+    s_nv0039_dir[(sl ? 0 : 2) | (dl ? 0 : 1)]++;
+    s_nv0039_marked += marked;
+    /* NV0039_DBG=<N>: log the first N copies. Copy #1, #2, #4, ... always get a
+     * one-line running total (direction counts: L->L, L->M, M->L, M->M). */
+    { static int cap = -1; static int nd;
+      if (cap < 0) { const char* e = getenv("NV0039_DBG"); cap = e ? atoi(e) : 0; }
+      if (nd < cap) { nd++;
+          printf("[NV0039] %s 0x%08X pitch %d -> %s 0x%08X pitch %d, %u x %u fmt 0x%X notify %u, %u tex marked, %u surf written back%c",
+                 sl ? "local" : "main", s_nv0039.off_in, (int)pin, dl ? "local" : "main",
+                 s_nv0039.off_out, (int)pout, len, n, s_nv0039.format, notify, marked, wb, 10); }
+      if ((s_nv0039_copies & (s_nv0039_copies - 1)) == 0)
+          printf("[NV0039] copies=%llu bytes=%llu L>L=%llu L>M=%llu M>L=%llu M>M=%llu tex-marked=%llu surf-writebacks=%llu%c",
+                 s_nv0039_copies, s_nv0039_bytes, s_nv0039_dir[0], s_nv0039_dir[1], s_nv0039_dir[2],
+                 s_nv0039_dir[3], s_nv0039_marked, s_nv0039_wb, 10); }
+    if (notify) { static int nw; if (nw++ < 4)
+        printf("[NV0039] BUFFER_NOTIFY %u with notify DMA 0x%08X: notifier write not implemented%c",
+               notify, s_nv0039.notify_dma, 10); }
+}
+
+static void nv0039_method(u32 method, u32 data)
+{
+    switch (method) {
+    case 0x0180: s_nv0039.notify_dma = data; return;
+    case 0x0184: s_nv0039.src_dma    = data; return;
+    case 0x0188: s_nv0039.dst_dma    = data; return;
+    case 0x030C: s_nv0039.off_in     = data; return;
+    case 0x0310: s_nv0039.off_out    = data; return;
+    case 0x0314: s_nv0039.pitch_in   = (s32)data; return;
+    case 0x0318: s_nv0039.pitch_out  = (s32)data; return;
+    case 0x031C: s_nv0039.line_len   = data; return;
+    case 0x0320: s_nv0039.line_count = data; return;
+    case 0x0324: s_nv0039.format     = data; return;
+    case 0x0328: nv0039_copy(data); return;
+    }
+}
+
 static void gcm_2d_method(u32 subch, u32 method, u32 data)
 {
+    if (subch == 1) { nv0039_method(method, data); return; }
     /* GCM2D_TRACE=1: histogram of (subchannel, method) actually seen. The
