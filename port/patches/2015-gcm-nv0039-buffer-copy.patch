 void rsx_live_draw_note_inline_transfer(u32 dma, u32 offset, u32 value);
+/* Patch 2015: the guest wrote [offset, offset+size) of `location` (RSX_LOCATION_*)
+ * behind the renderer's back (NV0039 buffer copy). Cached textures and vertex
+ * textures whose source overlaps the range are re-hashed at their next bind,
+ * even within the frame that already hashed them. Returns how many entries
+ * were marked. */
+u32  rsx_live_draw_note_guest_write(u32 location, u32 offset, u32 size);
+/* Patch 2015: before the guest reads [offset, offset+size) of `location`
+ * (an NV0039 copy out of local memory), write every live colour surface that
+ * overlaps it back into guest memory in the RSX layout (A8R8G8B8 as A,R,G,B
+ * bytes; FP16/FP32 big-endian). Blocks on a GPU readback. Returns the number
+ * of surfaces written back. */
+u32  rsx_live_draw_writeback_range(u32 location, u32 offset, u32 size);
 /* 1:1 NV3089 blit whose source is a live GPU surface: copy it on the GPU.
  * Addresses are location-relative byte offsets of the rect's top-left.
  * Returns 1 when handled (the guest-memory copy still runs regardless). */
