+/* Patch 2015 (NV0039 buffer copy): textures are re-hashed once per frame, so a
+ * copy into a texture that was already bound this frame (stream in, draw, copy
+ * the next block over it, draw again) used the stale decode until the next
+ * flip. Mark every cache entry whose guest source overlaps the written range so
+ * its next bind re-hashes and, on a change, re-decodes. Vertex data needs
+ * nothing: it is uploaded from guest memory per draw. An entry with an unknown
+ * span (compressed or exotic formats return 0) counts as overlapping from its
+ * offset onwards (ASSUMPTION: at most 64 MB, the size of local memory). */
+static int ld_range_overlaps(u32 loc_a, u32 off_a, u32 span_a, u32 loc_b, u64 b0, u64 b1)
+{
+    if (loc_a != loc_b) return 0;
+    const u64 a0 = off_a, a1 = a0 + (span_a ? span_a : 0x4000000u);
+    return a0 < b1 && b0 < a1;
+}
+u32 rsx_live_draw_note_guest_write(u32 location, u32 offset, u32 size)
+{
+    if (!g.ready || !size) return 0;
+    const u64 b0 = offset, b1 = b0 + size;
+    const u32 stale = g_ld_frames - 1u;   /* any value != g_ld_frames forces a re-hash */
+    u32 marked = 0;
+    for (u32 i = 0; i < g.n_textures; i++) {
+        texcache_t* e = &g.textures[i];
+        if (e->tex && ld_range_overlaps(e->location, e->offset, e->span, location, b0, b1)) {
+            e->last_hash_frame = stale; marked++;
+        }
+    }
+    for (u32 i = 0; i < g.n_vtex; i++) {
+        vtexcache_t* e = &g.vtex[i];
+        if (e->tex && ld_range_overlaps(e->location, e->offset, e->span, location, b0, b1)) {
+            e->last_hash_frame = stale; marked++;
+        }
+    }
+    return marked;
+}
