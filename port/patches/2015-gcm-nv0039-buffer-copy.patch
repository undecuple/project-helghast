 void rsx_live_draw_note_inline_transfer(u32 dma, u32 offset, u32 value)
 {
 #if defined(YZ_PERF_CLEAN)
@@ -10131,6 +10174,56 @@ int rsx_live_draw_debug_read_surface(u32 location, u32 offset, void* out,
     return ret;
 }
 
+/* Patch 2015: see rsx_live_draw.h. Killzone 3 copies its 1280x720 scene
+ * target (local 0x1300000) to main memory with one NV0039 copy per frame
+ * (RPCS3 capture, pass 18); live-draw never writes surfaces to guest memory,
+ * so the copy moved stale VRAM. LD_NV0039_WRITEBACK=0 disables. */
+u32 rsx_live_draw_writeback_range(u32 location, u32 offset, u32 size)
+{
+    static int en = -1;
+    if (en < 0) { const char* e = getenv("LD_NV0039_WRITEBACK"); en = e ? atoi(e) : 1; }
+    if (!en || !g.ready || !size) return 0;
+    const u64 r0 = offset, r1 = r0 + size;
+    u32 done = 0;
+    for (u32 i = 0; i < g.n_surfaces; i++) {
+        const surface_t* sf = &g.surfaces[i];
+        if (!sf->tex || sf->location != location) continue;
+        const u32 texel = sf->fmt == DXGI_FORMAT_R16G16B16A16_FLOAT ? 8u : 4u;
+        const u32 gp = sf->pitch ? sf->pitch : sf->w * texel;
+        if (gp < sf->w * texel) continue;
+        const u64 s0 = sf->offset, s1 = s0 + (u64)gp * (sf->h - 1u) + (u64)sf->w * texel;
+        if (!(s0 < r1 && r0 < s1)) continue;
+        u8* gm = (u8*)guest_ptr(location, sf->offset, (u32)(s1 - s0));
+        const size_t n = (size_t)sf->w * sf->h * texel;
+        u8* buf = gm ? (u8*)malloc(n) : NULL;
+        if (!buf) continue;
+        u32 w = 0, h = 0;
+        const int got = rsx_live_draw_debug_read_surface(location, sf->offset, buf, (u32)n, &w, &h);
+        if (got == (int)texel && w == sf->w && h == sf->h) {
+            for (u32 y = 0; y < h; y++) {
+                const u8* sp = buf + (size_t)y * w * texel;
+                u8* dp = gm + (size_t)y * gp;
+                for (u32 x = 0; x < w; x++, sp += texel, dp += texel) {
+                    if (sf->fmt == DXGI_FORMAT_R8G8B8A8_UNORM) {        /* host R,G,B,A -> guest A,R,G,B */
+                        dp[0] = sp[3]; dp[1] = sp[0]; dp[2] = sp[1]; dp[3] = sp[2];
+                    } else if (texel == 8) {                           /* LE halves -> BE, X first */
+                        for (u32 c = 0; c < 4; c++) { dp[c * 2] = sp[c * 2 + 1]; dp[c * 2 + 1] = sp[c * 2]; }
+                    } else {                                           /* R32_FLOAT LE -> BE */
+                        dp[0] = sp[3]; dp[1] = sp[2]; dp[2] = sp[1]; dp[3] = sp[0];
+                    }
+                }
+            }
+            done++;
+            static int logged;
+            if (logged++ < 4)
+                fprintf(stderr, "[nv0039-writeback] surface %u:0x%08X %ux%u fmt=%d pitch=%u for copy 0x%08X+0x%X\n",
+                        location, sf->offset, w, h, (int)sf->fmt, gp, offset, size);
+        }
+        free(buf);
+    }
+    return done;
+}
