+#define PAD_MOUSE_WM_FEED (WM_APP + 0x6A)   /* patch 2123: a KZ3_MOUSE_FEED_POST add (wParam dx, lParam dy) */
+static void pm_feed_deliver(int dx, int dy)
+{
+    static int s_post = -1;
+    if (s_post < 0) {
+        const char* e = getenv("KZ3_MOUSE_FEED_POST");
+        s_post = e && e[0] == '1';
+        fprintf(stderr, "[mouse] feed delivery: %s\n", s_post ? "posted to the window's thread (KZ3_MOUSE_FEED_POST=1)"
+                                                             : "direct from the feed thread");
+    }
+    if (s_post && s_hwnd && PostMessageA(s_hwnd, PAD_MOUSE_WM_FEED, (WPARAM)(LONG_PTR)dx, (LPARAM)(LONG_PTR)dy)) return;
+    pad_mouse_add(dx, dy);
+}
