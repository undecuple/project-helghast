+/* Patch 2212 (LD_WB_DEFER_4097, default off): does the sync point that releases `label` (-1 = none) defer its main-memory
+ * write-back? `label` must be the configured one; a release that arrives as NV4097 0x1D70/0x1D74 (is_4097; KZ3 releases 0x4A
+ * that way, NV406E 0x6C is the other path) also needs the switch. Patch 2185 only wired the NV406E path, so the 0x4A release
+ * of KZ3 never deferred and drained the scene-copy fence at once (reason OTHER). Host test: tools/smoke/test_wb_defer.sh. */
+static inline int rsx_wbd_site_defer(int mode, uint32_t cfg_label, int label, int is_4097, int sw4097)
+{
+    if (label < 0 || !mode || (uint32_t)label != cfg_label) return 0;
+    if (is_4097 && !sw4097) return 0;
+    return 1;
+}
+/* ld_writeback_batch: a batch that does not defer has to run after every older pending store (slot ownership, overlap order). */
+static inline int rsx_wbd_batch_drain_first(uint32_t pending, int defer_ok, int mode)
+{
+    return pending && !(defer_ok && mode);
+}
+
+/* Patch 2212, label hold: a release that defers its write-back must not become visible to the PPU/SPU before the bytes land
+ * (the label is the guest's only signal that the surface bytes are final). The label store (ea, val) is held with the queue and
+ * published, in order, as soon as the queue is empty again (any drain, touch or the walker's end of pass). `pending` = the
+ * queue length at the time. Host test: tools/smoke/test_wb_defer.sh. */
+#define RSX_WBD_HOLD_MAX 16
+typedef struct {
+    uint32_t n, ea[RSX_WBD_HOLD_MAX], val[RSX_WBD_HOLD_MAX];
+    uint64_t held, published, flush_by[RSX_WBD_R_N];   /* flush_by[reason]: label stores published by a drain of that reason */
+} rsx_wbd_hold;
+/* 1 = held (the caller must not store the label); 0 = store it now (nothing pending, or the release did not defer). */
+static inline int rsx_wbd_hold_try(rsx_wbd_hold* h, uint32_t pending, int armed, uint32_t ea, uint32_t val)
+{
+    if (!armed || !pending || h->n >= RSX_WBD_HOLD_MAX) return 0;
+    h->ea[h->n] = ea; h->val[h->n] = val; h->n++; h->held++;
+    return 1;
+}
+/* Called after every point that can empty the queue; publishes only when `pending` is 0. Returns the number published. */
+static inline uint32_t rsx_wbd_hold_flush(rsx_wbd_hold* h, uint32_t pending, int reason, void (*publish)(uint32_t ea, uint32_t val))
+{
+    if (pending || !h->n) return 0;
+    const uint32_t n = h->n;
+    for (uint32_t i = 0; i < n; i++) publish(h->ea[i], h->val[i]);
+    h->n = 0; h->published += n;
+    if (reason >= 0 && reason < RSX_WBD_R_N) h->flush_by[reason] += n;
+    return n;
+}
+
 static inline uint32_t rsx_wbd_free_slots(const rsx_wbd* d)
 {
     uint32_t f = 0;
