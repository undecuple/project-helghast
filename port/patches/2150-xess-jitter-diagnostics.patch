+static void ld_xess_diagnostic_draw(const kz3_xess_draw_info* draw, int shifted)
+{
+    if (g_dm_filter != RSX_DM_XESS || !ld_xess_diagnostic_config()->trace_interval) return;
+    if (g_xess_diagnostic_coverage_frame != draw->frame) {
+        memset(&g_xess_diagnostic_coverage, 0, sizeof g_xess_diagnostic_coverage);
+        g_xess_diagnostic_coverage_frame = draw->frame;
+    }
+    kz3_xess_diagnostic_count_draw(
+        &g_xess_diagnostic_coverage, draw, g.width, g.height, g_xess_zframe, g_xess_zslot, shifted,
+        g_xess_jitter_frame == draw->frame && g_xess_diagnostic_sample.active);
+}
+
+static void ld_xess_diagnostic_present(int dispatched)
+{
+    if (g_dm_filter != RSX_DM_XESS) return;
+    const kz3_xess_diagnostic_config* config = ld_xess_diagnostic_config();
+    if (!config->trace_interval || g_ld_frames % config->trace_interval) return;
+    kz3_xess_diagnostic_sample sample = {0};
+    kz3_xess_diagnostic_coverage coverage = {0};
+    if (g_xess_jitter_frame == g_ld_frames) sample = g_xess_diagnostic_sample;
+    if (g_xess_diagnostic_coverage_frame == g_ld_frames) coverage = g_xess_diagnostic_coverage;
+    fprintf(stderr,
+            "[xess-diag] frame=%u dispatch=%s sample=%d held=%d nominal=%.9g/%.9g "
+            "projection=%.9g/%.9g execute=%.9g/%.9g lag-applied=%d "
+            "draws=%u deferred=%u scene=%u other=%u shifted=%u partial-viewport=%u "
+            "depth-disabled=%u depth-mismatch=%u zero-projection=%u unavailable=%u\n",
+            g_ld_frames, dispatched ? "ok" : "fallback", sample.active,
+            g_xess_jitter_frame == g_ld_frames ? g_xess_diagnostic_held : 0,
+            sample.nominal_x, sample.nominal_y, sample.projection_x, sample.projection_y,
+            sample.execute_x, sample.execute_y, sample.lag_applied,
+            coverage.draws, coverage.deferred, coverage.scene, coverage.other, coverage.shifted,
+            coverage.partial_viewport, coverage.depth_disabled, coverage.depth_mismatch,
+            coverage.zero_projection, coverage.unavailable);
+}
