+/* One-run diagnostics: pattern defaults to halton, all four axis scales to 1, lag and trace interval to 0.
+ * The KZ3_XESS_* variable names and accepted values are documented in docs/XESS.md. */
+static const kz3_xess_diagnostic_config* ld_xess_diagnostic_config(void)
+{
+    static int read;
+    static kz3_xess_diagnostic_config config;
+    if (!read) {
+        read = 1;
+        config = kz3_xess_diagnostic_defaults();
+        const char* pattern = getenv("KZ3_XESS_JITTER_PATTERN");
+        if (pattern && strcmp(pattern, "halton") != 0) {
+            if (strcmp(pattern, "two-phase") == 0) {
+                config.two_phase = 1;
+            } else {
+                fprintf(stderr, "[xess-diag] invalid KZ3_XESS_JITTER_PATTERN='%.64s'; using halton\n", pattern);
+            }
+        }
+        static const char* const scale_names[] = {
+            "KZ3_XESS_PROJECTION_SCALE_X", "KZ3_XESS_PROJECTION_SCALE_Y",
+            "KZ3_XESS_EXECUTE_SCALE_X", "KZ3_XESS_EXECUTE_SCALE_Y"
+        };
+        float* scales[] = {
+            &config.projection_scale_x, &config.projection_scale_y,
+            &config.execute_scale_x, &config.execute_scale_y
+        };
+        for (u32 i = 0; i < sizeof(scale_names) / sizeof(scale_names[0]); ++i) {
+            const char* value = getenv(scale_names[i]);
+            if (value && !kz3_xess_diagnostic_parse_scale(value, scales[i]))
+                fprintf(stderr, "[xess-diag] invalid %s='%.64s'; using 1 (expected -2 to 2)\n",
+                        scale_names[i], value);
+        }
+        const char* lag = getenv("KZ3_XESS_EXECUTE_JITTER_LAG");
+        if (lag) {
+            if (strcmp(lag, "1") == 0) config.execute_lag = 1;
+            else if (strcmp(lag, "0") != 0)
+                fprintf(stderr, "[xess-diag] invalid KZ3_XESS_EXECUTE_JITTER_LAG='%.64s'; using 0\n", lag);
+        }
+        const char* interval = getenv("KZ3_XESS_JITTER_TRACE");
+        if (interval && !kz3_xess_diagnostic_parse_interval(interval, &config.trace_interval))
+            fprintf(stderr, "[xess-diag] invalid KZ3_XESS_JITTER_TRACE='%.64s'; using 0 (expected 0 to 60000)\n",
+                    interval);
+        if (kz3_xess_diagnostic_modified(&config) || config.trace_interval)
+            fprintf(stderr,
+                    "[xess-diag] pattern=%s projection-scale=%.3f/%.3f execute-scale=%.3f/%.3f "
+                    "execute-lag=%u trace-interval=%u\n",
+                    config.two_phase ? "two-phase" : "halton",
+                    config.projection_scale_x, config.projection_scale_y,
+                    config.execute_scale_x, config.execute_scale_y,
+                    config.execute_lag, config.trace_interval);
+    }
+    return &config;
+}
