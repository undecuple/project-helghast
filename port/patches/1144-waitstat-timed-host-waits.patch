+++ b/runtime/platform/kz3_waitstat.h
@@ -0,0 +1,52 @@
+/* KZ3 patch 1144 (SPU pass 129): counters for the timed host waits that go through Wine's RtlWaitOnAddress
+ * (SleepConditionVariable* with a finite timeout). The Wine race (patch 1143) needs a wait that ends by timeout while a
+ * waker is mid-wake on the same address, so "how many timed waits, how many ended by timeout" decides which site is exposed.
+ * One line "[waitstat] SITE timed=N timeout=M near..." at the first 4 timed waits, at every power of two below 1024 and at every
+ * 1024th. Cost: two relaxed atomic adds per timed wait (the wait itself is a syscall). */
+#ifndef KZ3_WAITSTAT_H
+#define KZ3_WAITSTAT_H
+#include <stdio.h>
+#include <stdlib.h>
+/* KZ3_WAITSTAT=1 turns the counters on; default off: no prints, no clock reads (one cached getenv). */
+static inline int kz3_waitstat_on(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("KZ3_WAITSTAT"); v = (e && e[0] == '1') ? 1 : 0; }
+    return v;
+}
+#ifdef _WIN32
+#include <windows.h>
+/* Monotonic ns (QPC) for the wake stamps and deadlines of the sites that have no clock of their own. */
+static inline long long kz3_ws_now_ns(void)
+{
+    static LARGE_INTEGER f; LARGE_INTEGER c;
+    if (!kz3_waitstat_on()) return 0;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (long long)(c.QuadPart / f.QuadPart) * 1000000000ll + (long long)(c.QuadPart % f.QuadPart) * 1000000000ll / f.QuadPart;
+}
+#endif
+typedef struct { volatile long timed, timeout, near2, near20, near100, near1k; } kz3_waitstat;
+/* A wait that ended by timeout: `dist_ns` = (time the last waker of the same condition started waking) - (this wait's
+ * deadline), signed. The Wine race needs a waker inside RtlWakeAddressAll while the waiter's timer fires, so waits whose
+ * deadline lies within 2 us / 20 us / 100 us / 1 ms of a wake are the upper bound of the exposure. */
+static inline void kz3_waitstat_near(kz3_waitstat* s, long long dist_ns)
+{
+    if (!kz3_waitstat_on()) return;
+    long long d = dist_ns < 0 ? -dist_ns : dist_ns;
+    if (d < 2000) __atomic_add_fetch(&s->near2, 1, __ATOMIC_RELAXED);
+    if (d < 20000) __atomic_add_fetch(&s->near20, 1, __ATOMIC_RELAXED);
+    if (d < 100000) __atomic_add_fetch(&s->near100, 1, __ATOMIC_RELAXED);
+    if (d < 1000000) __atomic_add_fetch(&s->near1k, 1, __ATOMIC_RELAXED);
+}
+static inline void kz3_waitstat_note(kz3_waitstat* s, const char* site, int timed_out)
+{
+    if (!kz3_waitstat_on()) return;
+    long n = __atomic_add_fetch(&s->timed, 1, __ATOMIC_RELAXED);
+    if (timed_out) __atomic_add_fetch(&s->timeout, 1, __ATOMIC_RELAXED);
+    if (n <= 4 || (n < 1024 && (n & (n - 1)) == 0) || (n & 1023) == 0)
+        fprintf(stderr, "[waitstat] %s timed=%ld timeout=%ld near2us=%ld near20us=%ld near100us=%ld near1ms=%ld\n", site, n,
+                __atomic_load_n(&s->timeout, __ATOMIC_RELAXED), __atomic_load_n(&s->near2, __ATOMIC_RELAXED), __atomic_load_n(&s->near20, __ATOMIC_RELAXED),
+                __atomic_load_n(&s->near100, __ATOMIC_RELAXED), __atomic_load_n(&s->near1k, __ATOMIC_RELAXED));
+}
+#endif
