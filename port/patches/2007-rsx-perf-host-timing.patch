+const char* ppu_thread_name_for_os_tid(unsigned long os_tid)
+{
+#ifdef _WIN32
+    for (int i = 0; i < PPU_THREAD_MAX; i++) {
+        ppu_thread_info* t = &g_ppu_threads[i];
+        if (t->state == PPU_THREAD_STATE_FREE || !t->host_thread) continue;
