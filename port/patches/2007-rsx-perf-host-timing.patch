+/* ---------------------------------------------------------------------------
+ * RSX_PERF=1 (KZ3 patch 2007): per-second host timing, off by default.
+ * [perf]     flips, presents, draws; FIFO walk time (includes live-draw method
+ *            work and any submit it triggers); D3D12 flushes by reason with
+ *            their total and GPU-fence-wait time; present (flush + swap) and
+ *            the IDXGISwapChain::Present call alone; guest ref-register polls.
+ * [perf-thr] process CPU and the busiest host threads (ms of CPU in the last
+ *            second): rsx = FIFO walker/present thread, gcm-init = thread that
+ *            called cellGcmInit, ppu:<name> = guest PPU threads, others by
+ *            start address (+RVA in the exe; resolve with nm/addr2line).
+ * -----------------------------------------------------------------------*/
+static volatile long long g_rsx_perf[RSX_PERF_COUNT];
+_Static_assert(RSX_PERF_USLEEP_GCM_N == 13 && RSX_PERF_USLEEP_GCM_T == 14 && RSX_PERF_USLEEP_OTHER_T == 15,
+               "sys_timer.c mirrors the RSX_PERF_USLEEP_* indices");
+static unsigned long long s_rsx_perf_methods;      /* walker thread only */
+
+int rsx_perf_enabled(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_PERF"); on = (e && *e && *e != '0') ? 1 : 0; }
+    return on;
+}
+long long rsx_perf_now(void)
+{
+    LARGE_INTEGER t; QueryPerformanceCounter(&t); return (long long)t.QuadPart;
+}
+int rsx_perf_on_gcm_thread(void)
+{
+#ifdef _WIN32
+    return s_perf_gcm_tid && GetCurrentThreadId() == s_perf_gcm_tid;
+#else
+    return 0;
+#endif
+}
+/* Real usleep time of the cellGcmInit thread per guest call site (lr), for the
+ * [perf] line's top sites. Only that thread writes; the reporter reads and
+ * clears without a lock (diagnostic: a lost sample cannot change the ranking). */
+enum { RSX_PERF_SITES = 32 };
+static unsigned  s_perf_site_lr[RSX_PERF_SITES];
+static long long s_perf_site_t[RSX_PERF_SITES], s_perf_site_n[RSX_PERF_SITES];
+void rsx_perf_note_gcm_wait(unsigned lr, long long ticks)
+{
+    for (int i = 0; i < RSX_PERF_SITES; i++) {
+        if (s_perf_site_lr[i] == lr || s_perf_site_lr[i] == 0) {
+            s_perf_site_lr[i] = lr; s_perf_site_t[i] += ticks; s_perf_site_n[i]++; return;
+        }
+    }
+}
+void rsx_perf_add(int idx, long long v)
+{
+    if (rsx_perf_enabled() && idx >= 0 && idx < RSX_PERF_COUNT)
+        __atomic_fetch_add(&g_rsx_perf[idx], v, __ATOMIC_RELAXED);
+}
+
+#ifdef _WIN32
+#include <tlhelp32.h>
+extern const char* ppu_thread_name_for_os_tid(unsigned long os_tid);
+typedef LONG (WINAPI *rsx_perf_ntqit_fn)(HANDLE, int, PVOID, ULONG, PULONG);
+
+static void rsx_perf_label(HANDLE h, DWORD tid, char* out, size_t n)
+{
+    static rsx_perf_ntqit_fn ntq;
+    static uintptr_t base, end;
+    if (!base) {
+        base = (uintptr_t)GetModuleHandleA(NULL);
+        const IMAGE_DOS_HEADER* dos = (const IMAGE_DOS_HEADER*)base;
+        const IMAGE_NT_HEADERS* nt = (const IMAGE_NT_HEADERS*)(base + dos->e_lfanew);
+        end = base + nt->OptionalHeader.SizeOfImage;
+        s_ps_end = end;
+        ntq = (rsx_perf_ntqit_fn)(void*)GetProcAddress(GetModuleHandleA("ntdll.dll"),
+                                                       "NtQueryInformationThread");
+    }
+    if (tid == s_perf_rsx_tid) { snprintf(out, n, "rsx"); return; }
+    if (tid == s_perf_gcm_tid) { snprintf(out, n, "gcm-init"); return; }
+    const char* pn = ppu_thread_name_for_os_tid(tid);
+    if (pn) { snprintf(out, n, "ppu:%.24s", pn); return; }
+    uintptr_t sa = 0;
+    if (ntq) ntq(h, 9 /* ThreadQuerySetWin32StartAddress */, &sa, sizeof sa, NULL);
+    if (sa >= base && sa < end) { snprintf(out, n, "%lu@+0x%llx", (unsigned long)tid,
+                                           (unsigned long long)(sa - base)); return; }
+    /* Outside the exe: name the module (wine/vkd3d/driver threads). */
+    HMODULE mod = NULL; char path[MAX_PATH] = "?";
+    if (sa && GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                                 GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, (LPCSTR)sa, &mod))
+        GetModuleFileNameA(mod, path, sizeof path);
+    const char* bn = path;
+    for (const char* q = path; *q; q++) if (*q == '\\' || *q == '/') bn = q + 1;
+    snprintf(out, n, "%lu@%.20s+0x%llx", (unsigned long)tid, bn,
+             (unsigned long long)(sa - (uintptr_t)mod));
+}
+
+/* RSX_PERF_SAMPLE=1: also sample the instruction pointer of the threads that
+ * used >= 300 ms CPU in the previous second (not the rsx thread), every 5 ms
+ * (suspend, read RIP, resume; nothing else while suspended). Every 10 s print
+ * the top 64 256-byte buckets per thread as exe RVAs ("[perf-samp]"); resolve
+ * them offline against the exe's symbols (lifted SPU/PPU functions are named). */
+enum { PS_HOT = 6, PS_SLOTS = 4096 };
+static DWORD     s_ps_tid[PS_HOT];
+static HANDLE    s_ps_h[PS_HOT];
+static char      s_ps_lab[PS_HOT][48];
+static uintptr_t s_ps_key[PS_HOT][PS_SLOTS];
+static unsigned  s_ps_cnt[PS_HOT][PS_SLOTS];
+static unsigned  s_ps_total[PS_HOT], s_ps_other[PS_HOT], s_ps_out[PS_HOT];
+static void rsx_perf_sample_once(void)
+{
+    const uintptr_t base = (uintptr_t)GetModuleHandleA(NULL);
+    for (int i = 0; i < PS_HOT; i++) {
+        if (!s_ps_h[i]) continue;
+        CONTEXT c; memset(&c, 0, sizeof c); c.ContextFlags = CONTEXT_CONTROL;
+        if (SuspendThread(s_ps_h[i]) == (DWORD)-1) continue;
+        const BOOL ok = GetThreadContext(s_ps_h[i], &c);
+        ResumeThread(s_ps_h[i]);
+        if (!ok) continue;
+        s_ps_total[i]++;
+        if ((uintptr_t)c.Rip < base || (s_ps_end && (uintptr_t)c.Rip >= s_ps_end)) { s_ps_out[i]++; continue; }
+        const uintptr_t k = ((uintptr_t)c.Rip - base) >> 8;
+        unsigned h = (unsigned)(k * 2654435761u) & (PS_SLOTS - 1);
+        for (int n = 0; n < PS_SLOTS; n++, h = (h + 1) & (PS_SLOTS - 1)) {
+            if (s_ps_key[i][h] == k) { s_ps_cnt[i][h]++; break; }
+            if (s_ps_cnt[i][h] == 0) { s_ps_key[i][h] = k; s_ps_cnt[i][h] = 1; break; }
+            if (n == PS_SLOTS - 1) s_ps_other[i]++;
+        }
+    }
+}
+static void rsx_perf_sample_report(void)
+{
+    for (int i = 0; i < PS_HOT; i++) {
+        if (!s_ps_total[i]) continue;
+        char line[4096];
+        int off = snprintf(line, sizeof line, "[perf-samp] %s n=%u outside-exe=%u:", s_ps_lab[i],
+                           s_ps_total[i], s_ps_out[i]);
+        for (int t = 0; t < 64 && off < (int)sizeof line - 40; t++) {
+            int b = -1;
+            for (int j = 0; j < PS_SLOTS; j++)
+                if (s_ps_cnt[i][j] && (b < 0 || s_ps_cnt[i][j] > s_ps_cnt[i][b])) b = j;
+            if (b < 0) break;
+            off += snprintf(line + off, sizeof line - off, " %llx=%u",
+                            (unsigned long long)(s_ps_key[i][b] << 8), s_ps_cnt[i][b]);
+            s_ps_cnt[i][b] = 0;
+        }
+        fprintf(stderr, "%s\n", line);
+        memset(s_ps_cnt[i], 0, sizeof s_ps_cnt[i]); memset(s_ps_key[i], 0, sizeof s_ps_key[i]);
+        s_ps_total[i] = s_ps_other[i] = s_ps_out[i] = 0;
+    }
+}
+
+static DWORD WINAPI rsx_perf_thread(LPVOID unused)
+{
+    const char* pse = getenv("RSX_PERF_SAMPLE");
+    const int sampling = pse && *pse && *pse != '0';
+    unsigned secs = 0;
+    (void)unused;
+    enum { MAXT = 512, TOP = 10 };
+    static DWORD tids[MAXT]; static unsigned long long cpu_prev[MAXT]; static int ntids;
+    LARGE_INTEGER f, t0, last, now;
+    QueryPerformanceFrequency(&f); QueryPerformanceCounter(&t0); last = t0;
+    long long prev[RSX_PERF_COUNT] = {0};
+    unsigned long long prev_methods = 0, prev_draws = rsx_perf_draws(), prev_ff = rsx_perf_fifo_flips();
+    const double tk = 1000.0 / (double)f.QuadPart;   /* ticks -> ms */
+    for (;;) {
+        if (sampling) {
+            for (int k = 0; k < 200; k++) { Sleep(5); rsx_perf_sample_once(); }
+            if (++secs % 10 == 0) rsx_perf_sample_report();
+        } else {
+            Sleep(1000);
+        }
+        QueryPerformanceCounter(&now);
+        const double wall = (double)(now.QuadPart - last.QuadPart) * tk;
+        last = now;
+        long long d[RSX_PERF_COUNT];
+        for (int i = 0; i < RSX_PERF_COUNT; i++) {
+            const long long c = __atomic_load_n(&g_rsx_perf[i], __ATOMIC_RELAXED);
+            d[i] = c - prev[i]; prev[i] = c;
+        }
+        const unsigned long long m = s_rsx_perf_methods, dr = rsx_perf_draws();
+        fprintf(stderr,
+            "[perf] t=%.0fs wall=%.0fms flips=%lld fifo-flips=%llu presents=%lld draws=%llu | walk n=%lld %.1fms"
+            " methods=%llu | flush n=%lld (present %lld, ref %lld, other %lld) %.1fms gpuwait %.1fms"
+            " | present %.1fms swap %.1fms | refpoll=%lld | usleep gcm n=%lld %.1fms other %.1fms\n",
+            (double)(now.QuadPart - t0.QuadPart) * tk / 1000.0, wall,
+            d[RSX_PERF_FLIPS], rsx_perf_fifo_flips() - prev_ff, d[RSX_PERF_PRESENT_N], dr - prev_draws,
+            d[RSX_PERF_WALK_N], d[RSX_PERF_WALK_T] * tk, m - prev_methods,
+            d[RSX_PERF_FLUSH_N], d[RSX_PERF_FLUSH_PRESENT_N], d[RSX_PERF_FLUSH_REF_N],
+            d[RSX_PERF_FLUSH_OTHER_N], d[RSX_PERF_FLUSH_T] * tk, d[RSX_PERF_GPUWAIT_T] * tk,
+            d[RSX_PERF_PRESENT_T] * tk, d[RSX_PERF_SWAP_T] * tk, d[RSX_PERF_REFPOLL],
+            d[RSX_PERF_USLEEP_GCM_N], d[RSX_PERF_USLEEP_GCM_T] * tk, d[RSX_PERF_USLEEP_OTHER_T] * tk);
+        prev_methods = m; prev_draws = dr; prev_ff = rsx_perf_fifo_flips();
+        {   /* top 4 usleep sites of the cellGcmInit thread, real ms */
+            char sl[256]; int so = snprintf(sl, sizeof sl, "[perf-wait] gcm usleep by lr:");
+            for (int k = 0; k < 4; k++) {
+                int b = -1;
+                for (int i = 0; i < RSX_PERF_SITES; i++)
+                    if (s_perf_site_lr[i] && s_perf_site_t[i] > 0 && (b < 0 || s_perf_site_t[i] > s_perf_site_t[b])) b = i;
+                if (b < 0) break;
+                so += snprintf(sl + so, sizeof sl - so, " 0x%X=%.0fms/%lld", s_perf_site_lr[b],
+                               s_perf_site_t[b] * tk, s_perf_site_n[b]);
+                s_perf_site_t[b] = -s_perf_site_t[b];          /* mark printed */
+            }
+            for (int i = 0; i < RSX_PERF_SITES; i++) { s_perf_site_t[i] = 0; s_perf_site_n[i] = 0; }
+            fprintf(stderr, "%s\n", sl);
+        }
+
+        /* Host threads: CPU ms in the last period, top TOP. */
+        HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+        if (snap == INVALID_HANDLE_VALUE) continue;
+        THREADENTRY32 te; te.dwSize = sizeof te;
+        const DWORD pid = GetCurrentProcessId();
+        double top_ms[TOP] = {0}; char top_lab[TOP][48]; DWORD top_tid[TOP] = {0}; int ntop = 0, nthr = 0;
+        double total = 0;
+        for (BOOL ok = Thread32First(snap, &te); ok; ok = Thread32Next(snap, &te)) {
+            if (te.th32OwnerProcessID != pid) continue;
+            HANDLE h = OpenThread(THREAD_QUERY_INFORMATION, FALSE, te.th32ThreadID);
+            if (!h) continue;
+            FILETIME c, e, k, u;
+            if (!GetThreadTimes(h, &c, &e, &k, &u)) { CloseHandle(h); continue; }
+            const unsigned long long cpu =
+                (((unsigned long long)k.dwHighDateTime << 32) | k.dwLowDateTime) +
+                (((unsigned long long)u.dwHighDateTime << 32) | u.dwLowDateTime);
+            int slot = -1;
+            for (int i = 0; i < ntids; i++) if (tids[i] == te.th32ThreadID) { slot = i; break; }
+            if (slot < 0 && ntids < MAXT) { slot = ntids++; tids[slot] = te.th32ThreadID; cpu_prev[slot] = 0; }
+            double ms = 0;
+            if (slot >= 0) { ms = (double)(cpu - cpu_prev[slot]) / 10000.0; cpu_prev[slot] = cpu; }
+            nthr++; total += ms;
+            int pos = ntop;
+            while (pos > 0 && top_ms[pos - 1] < ms) pos--;
+            if (pos < TOP) {
+                for (int i = (ntop < TOP ? ntop : TOP - 1); i > pos; i--) {
+                    top_ms[i] = top_ms[i - 1]; memcpy(top_lab[i], top_lab[i - 1], sizeof top_lab[i]);
+                    top_tid[i] = top_tid[i - 1];
+                }
+                top_ms[pos] = ms; top_tid[pos] = te.th32ThreadID;
+                rsx_perf_label(h, te.th32ThreadID, top_lab[pos], sizeof top_lab[pos]);
+                if (ntop < TOP) ntop++;
+            }
+            CloseHandle(h);
+        }
+        CloseHandle(snap);
+        if (sampling) {   /* next second's sample set: threads >= 300 ms, not rsx/self */
+            int hot[TOP], nh = 0;
+            for (int i = 0; i < ntop && nh < PS_HOT; i++)
+                if (top_ms[i] >= 300 && top_tid[i] != s_perf_rsx_tid && top_tid[i] != GetCurrentThreadId())
+                    hot[nh++] = i;
+            for (int j = 0; j < PS_HOT; j++) {   /* drop slots that went cold (keep their counts) */
+                int keep = 0;
+                for (int q = 0; q < nh; q++) if (top_tid[hot[q]] == s_ps_tid[j]) keep = 1;
+                if (!keep && s_ps_h[j]) { CloseHandle(s_ps_h[j]); s_ps_h[j] = NULL; s_ps_tid[j] = 0; }
+            }
+            for (int q = 0; q < nh; q++) {
+                int have = 0, freej = -1;
+                for (int j = 0; j < PS_HOT; j++) {
+                    if (s_ps_tid[j] == top_tid[hot[q]]) have = 1;
+                    if (!s_ps_tid[j] && !s_ps_total[j] && freej < 0) freej = j;
+                }
+                if (have || freej < 0) continue;
+                s_ps_tid[freej] = top_tid[hot[q]];
+                s_ps_h[freej] = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT |
+                                           THREAD_QUERY_INFORMATION, FALSE, top_tid[hot[q]]);
+                memcpy(s_ps_lab[freej], top_lab[hot[q]], sizeof s_ps_lab[freej]);
+            }
+        }
+        char line[1024]; int off = snprintf(line, sizeof line, "[perf-thr] cpu=%.0fms threads=%d:", total, nthr);
+        for (int i = 0; i < ntop && off < (int)sizeof line - 64; i++)
+            off += snprintf(line + off, sizeof line - off, " %s=%.0f", top_lab[i], top_ms[i]);
+        fprintf(stderr, "%s\n", line);
+    }
+    return 0;
+}
