+    RSX_PERF_PRESENT_N, RSX_PERF_PRESENT_T, RSX_PERF_SWAP_T,
+    RSX_PERF_USLEEP_GCM_N, RSX_PERF_USLEEP_GCM_T, RSX_PERF_USLEEP_OTHER_T,
+    RSX_PERF_COUNT
