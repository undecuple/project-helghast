+/* KZ3 patch 2029: submit without waiting. The walker records a whole frame
+ * into one command list and, before 2029, handed it to the GPU only at a sync
+ * point (NV0039 scene copy, main-surface write-back, ring wrap, present), where
+ * it then waited for ALL of it: the GPU idled while the walker recorded, and
+ * the walker idled while the GPU ran. Now the walker also submits (Close,
+ * Execute, Signal, Reset on the same allocator; no wait) every LD_SUBMIT_CHUNK
+ * draws (default 128, 0 = off) and when it goes idle (caught up with put, or
+ * parked: rsx_live_draw_submit_pending from the FIFO walker), so the GPU runs
+ * behind the walker and a sync point waits only for the tail.
+ * Nothing guest-visible moves: the sync points still wait for the GPU before
+ * any guest memory or semaphore is written, so the SPU/PPU never see older
+ * data than before. The per-frame rings, retired textures and readback slots
+ * are recycled only after a fence wait, as before (a no-wait submit does not
+ * reset them). Every draw re-records its whole state (render targets, PSO,
+ * root signature, heaps, viewport), so a new list after a submit loses
+ * nothing; the submit happens before a draw records anything. Not while an
+ * occlusion query is open: a split query counts as two segments, which patch
+ * 2025 treats as "always draw". */
+static int ld_submit_chunk(void)
+{
+    static int n = -1;
+    if (n < 0) { const char* e = getenv("LD_SUBMIT_CHUNK"); n = e ? atoi(e) : 128; if (n < 0) n = 0; }
+    return n;
+}
+static void ld_submit_nowait(void)
+{
+    if (!g.ready || !g_ld_unsubmitted || g_oq.open) return;
+    LDW_T0(t0);
+    const HRESULT close_hr = g.list->lpVtbl->Close(g.list);
+    if (FAILED(close_hr)) {
+        fprintf(stderr, "[d3d-fail] command-list Close (chunk) hr=0x%08lX frame=%u\n",
+                (unsigned long)close_hr, g_ld_frames);
+        ld_dump_dred("Close", close_hr);
+        g.ready = 0;
+        return;
+    }
+    ID3D12CommandList* lists[] = {(ID3D12CommandList*)g.list};
+    g.queue->lpVtbl->ExecuteCommandLists(g.queue, 1, lists);
+    const u64 v = ++g.fence_value;
+    const HRESULT signal_hr = g.queue->lpVtbl->Signal(g.queue, g.fence, v);
+    if (FAILED(signal_hr)) {
+        fprintf(stderr, "[d3d-fail] queue Signal (chunk) hr=0x%08lX frame=%u\n",
+                (unsigned long)signal_hr, g_ld_frames);
+        ld_dump_dred("Signal", signal_hr);
+        g.ready = 0;
+        return;
+    }
+    ld_rb_stamp(v);   /* patch 2027: queued report copies complete with this fence */
+    g.list->lpVtbl->Reset(g.list, g.alloc, NULL);
+    g_ld_unsubmitted = 0;
+    g_ld_chunk_submits++;
+    if (t0) { LDW_ADD(RSX_PERF_W_SUBMIT_T, t0); rsx_perf_add(RSX_PERF_W_CHUNK_N, 1); }
+}
+void rsx_live_draw_submit_pending(void)
+{
+    if (ld_submit_chunk()) ld_submit_nowait();
+}
