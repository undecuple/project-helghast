diff --git a/libs/video/rsx_smp_use.h b/libs/video/rsx_smp_use.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_smp_use.h
@@ -0,0 +1,54 @@
+/* rsx_smp_use.h - KZ3 patch 2213 (LD_SMP_RING_NODRAIN): last-use fence per sampler-ring table.
+ *
+ * The sampler ring (128 tables of 16 samplers, one shader-visible heap per frame slot) is written linearly and recycled
+ * when it is full. The old recycle drained the whole queue (ld_flush(LD_FLUSH_DESCRIPTOR_RING), the "flush_other" wait).
+ * Patch 2155's (range, fence) marks cannot replace it: they keep the whole allocated prefix live through every submit, so
+ * the first reuse waits for the fence of the submit that closed the wrap, which is the drain again. The sampler table
+ * is only read by the draw that bound it (sampler_table() is called once per draw, hit or take), so an exact per-table
+ * stamp is possible: the table is marked UNSUB when a draw of the open command list binds it, the submit hook turns every
+ * UNSUB into that submit's fence, and a table is overwritten only after the fence of its newest binding completed.
+ * Pure bookkeeping, no D3D12 types: tools/smoke/test_smp_nodrain.sh builds it on the host. */
+#ifndef RSX_SMP_USE_H
+#define RSX_SMP_USE_H
+#include <stdint.h>
+#include <string.h>
+#define RSX_PATCH_2213 1
+#define RSX_SMPU_CAP 128u
+#define RSX_SMPU_SLOTS 2u
+#define RSX_SMPU_UNSUB (~(uint64_t)0)   /* bound by a draw of the open (unsubmitted) list */
+
+typedef struct {
+    uint64_t f[RSX_SMPU_SLOTS][RSX_SMPU_CAP];   /* 0 = never bound / retired, UNSUB = in the open list, else the submit's fence */
+    uint64_t unsub_seen;                         /* a table about to be overwritten was still in the open list (no fence to wait for) */
+} rsx_smp_use;
+
+static inline void rsx_smpu_init(rsx_smp_use* u) { memset(u, 0, sizeof *u); }
+/* A draw of the open list binds table `t` of frame slot `slot` (a cache hit counts, it reads the table again). */
+static inline void rsx_smpu_bind(rsx_smp_use* u, uint32_t slot, uint32_t t)
+{
+    if (t < RSX_SMPU_CAP) u->f[slot % RSX_SMPU_SLOTS][t] = RSX_SMPU_UNSUB;
+}
+/* The open list was submitted with `fence`: every table it bound now completes with that fence. */
+static inline void rsx_smpu_submit(rsx_smp_use* u, uint64_t fence)
+{
+    for (uint32_t s = 0; s < RSX_SMPU_SLOTS; s++)
+        for (uint32_t t = 0; t < RSX_SMPU_CAP; t++)
+            /*SUBMIT*/ if (u->f[s][t] == RSX_SMPU_UNSUB) u->f[s][t] = fence;
+}
+/* The cursor is about to overwrite table `t`: the fence that must have completed first (0 = none). A table still in the open list
+ * has no fence: counted, nothing to wait for (the wrap submits first, so this only happens on a reset without a wrap). */
+static inline uint64_t rsx_smpu_need(rsx_smp_use* u, uint32_t slot, uint32_t t)
+{
+    if (t >= RSX_SMPU_CAP) return 0;
+    const uint64_t f = u->f[slot % RSX_SMPU_SLOTS][t];
+    if (f == RSX_SMPU_UNSUB) { u->unsub_seen++; return 0; }
+    return f;
+}
+/* Tables of `slot` below `n` still without a fence (must be 0 right after the wrap's submit). */
+static inline uint32_t rsx_smpu_unsub_count(const rsx_smp_use* u, uint32_t slot, uint32_t n)
+{
+    uint32_t c = 0;
+    for (uint32_t t = 0; t < n && t < RSX_SMPU_CAP; t++) if (u->f[slot % RSX_SMPU_SLOTS][t] == RSX_SMPU_UNSUB) c++;
+    return c;
+}
+#endif
