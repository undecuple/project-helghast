+    const u64 c = g.fence->lpVtbl->GetCompletedValue(g.fence);
+    if (c > g_ld_smpnd_done) g_ld_smpnd_done = c;
+    if (f <= g_ld_smpnd_done) return 1;
+    g_ld_smpnd_waits++;
+    if (rsx_perf_walk_on()) rsx_perf_add(RSX_PERF_W_RFW_DESC_WAIT, 1);
+    if (!ld_wait_fence_s(2 /*RSX_WS_RING*/, f)) return 0;
+    if (f > g_ld_smpnd_done) g_ld_smpnd_done = f;
+    return 1;
+}
+/* Sampler-only wrap without a drain: submit the open list (a query left open cannot be split: 0 = the caller drains as before). */
+static int ld_smp_wrap_nodrain(void)
