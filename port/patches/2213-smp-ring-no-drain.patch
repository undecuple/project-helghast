+                g_ld_smpnd_waits, g_ld_smpnd_fallback, g_ld_smpnd_unsub_wrap, (unsigned long long)g_ld_smpu.unsub_seen);
+    if (rsx_perf_walk_on()) rsx_perf_add(RSX_PERF_W_RFW_DESC_AVOID, 1);
+    return 1;
+}
