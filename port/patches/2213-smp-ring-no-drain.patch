+static int ld_smp_nodrain_on(void)
+{
+    if (g_ld_smpnd_mode < 0) {
+        const char* e = getenv("LD_SMP_RING_NODRAIN");
+        g_ld_smpnd_mode = (e && e[0] && e[0] != '0') ? (e[0] == '2' ? 2 : 1) : 0;
