 static void kz3_pt_dump(void) {
     if (!kz3_pt_on()) return;
@@ -2508,6 +2518,24 @@ s32 cellGcmSetFlipCommand(u32 bufferId) { return gcm_flip_request(bufferId, 0);
  * at ctx->current instead; the drain stops at it and fires the flip there,
  * exactly as it does for the 0xFEAD words a statically-linked libgcm emits.
  * Returns 0 when there is no room or ctx is not a mapped command buffer. */
+/* KZ3 patch 1010: the wrap below is only right for a ring the runtime owns (its
+ * buffer-full callback is ours). A title with its own callback manages its own
+ * buffers: Killzone 3 flips through its draw context D (0x404C96C0), a 0x30000-byte
+ * piece of its IO pool whose `end` moves down as it allocates data from the top, so
+ * `end - cur` is always below GCM_FLIP_WRAP_BYTES. Wrapping it rewound D.current to
+ * the piece's begin in mid-frame: the frame header was rewritten over itself and the
+ * frame ended at +0x2C8, orphaning the frame's draws -- with the Bink fence release in
+ * them, so the next frame waited for it forever in 0x640E0 (the ~16 s stop).
+ * GCM_FLIP_WRAP=0 never wraps, =1 always does (the old behaviour), unset: only ours. */
+static int gcm_flip_wrap_ok(u32 ctx)
+{
+    static int mode = -1;
+    if (mode < 0) { const char* e = getenv("GCM_FLIP_WRAP"); mode = e ? atoi(e) : 2; }
+    if (mode != 2) return mode;
+    const u32 opd = vm_read32(ctx + 0xC);
+    return opd && vm_read32(opd) == GCM_FIFO_CALLBACK_SENTINEL_EA;
+}
