 {
+    /* Patch 2022: LD_NO_ZSNAP_GROW=1 = old behaviour (snapshot keeps its first clip). */
+    static int off = -1;
+    if (off < 0) off = getenv("LD_NO_ZSNAP_GROW") ? 1 : 0;
     zdepth_t* z = &g.zdepths[i];
-    if (!z->snapshot) return;
+    if (off || !z->snapshot) return;
     u32 nw = rt_w < z->w ? rt_w : z->w, nh = rt_h < z->h ? rt_h : z->h;
     if (nw < z->snapshot_w) nw = z->snapshot_w;
     if (nh < z->snapshot_h) nh = z->snapshot_h;
@@ -7887,6 +7890,145 @@ static void write_topology_indices(u32 prim, u32* indices)
