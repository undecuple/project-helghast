+/* Patch 2022: LD_ZPROBE=<n> (off by default) logs up to n draws that bind a
+ * zeta as a texture (patch 2011 aliasing: X16 / DEPTH16 / A8R8G8B8 at a host
+ * zeta) and every depth-export draw (SHADER_CONTROL & 0xE with depth write):
+ * which resource the unit got (snapshot, own zeta -> guest VRAM, no write),
+ * and the values at three texels of the snapshot and of guest VRAM.
+ * LD_ZPROBE_GATE=<file> limits it to while <file> exists. Blocking readbacks:
+ * diagnosis only. */
+typedef struct { u32 unit; rsx_dsp_texture t; int zi; int why; } ld_zp_note_t;
+enum { LD_ZP_SNAP = 0, LD_ZP_SELF, LD_ZP_NOWRITE };
+static ld_zp_note_t g_zp_notes[16];
+static u32 g_zp_n_notes;
+static int ld_zp_active(void)
+{
+    static int lim = -1; static const char* gate = (const char*)-1;
+    if (lim < 0) { const char* e = getenv("LD_ZPROBE"); lim = e ? atoi(e) : 0; }
+    if (lim <= 0) return 0;
+    if (gate == (const char*)-1) gate = getenv("LD_ZPROBE_GATE");
+    if (gate) { FILE* f = fopen(gate, "rb"); if (!f) return 0; fclose(f); }
+    return 1;
+}
+static void ld_zp_note(u32 unit, const rsx_dsp_texture* t, int zi, int why)
+{
+    if (g_zp_n_notes >= 16) return;
+    g_zp_notes[g_zp_n_notes].unit = unit; g_zp_notes[g_zp_n_notes].t = *t;
+    g_zp_notes[g_zp_n_notes].zi = zi; g_zp_notes[g_zp_n_notes].why = why;
+    g_zp_n_notes++;
+}
+/* Read n R32F texels of zeta i's snapshot (blocking). */
+static int ld_zp_read_snapshot(zdepth_t* z, u32 n, const u32* xs, const u32* ys, float* out)
+{
+    if (!z->snapshot || !z->snapshot_valid || n > 4) return 0;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = 512u * 4u;
+    bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+    bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1;
+    bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    ID3D12Resource* rb = NULL;
+    if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&rb)))
+        return 0;
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = z->snapshot;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = z->snapshot_state;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+    for (u32 k = 0; k < n; k++) {
+        D3D12_TEXTURE_COPY_LOCATION src = {0}, dst = {0};
+        src.pResource = z->snapshot; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        dst.pResource = rb; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+        dst.PlacedFootprint.Offset = 512u * k;
+        dst.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R32_FLOAT;
+        dst.PlacedFootprint.Footprint.Width = 1;
+        dst.PlacedFootprint.Footprint.Height = 1;
+        dst.PlacedFootprint.Footprint.Depth = 1;
+        dst.PlacedFootprint.Footprint.RowPitch = 256;
+        const u32 x = xs[k] < z->snapshot_w ? xs[k] : z->snapshot_w - 1u;
+        const u32 y = ys[k] < z->snapshot_h ? ys[k] : z->snapshot_h - 1u;
+        D3D12_BOX box = { x, y, 0, x + 1u, y + 1u, 1 };
+        g.list->lpVtbl->CopyTextureRegion(g.list, &dst, 0, 0, 0, &src, &box);
+    }
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b.Transition.StateAfter = z->snapshot_state;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+    ld_flush(LD_FLUSH_READBACK);
+    int ok = 0; u8* px = NULL; D3D12_RANGE rr = {0, 512u * 4u};
+    if (SUCCEEDED(rb->lpVtbl->Map(rb, 0, &rr, (void**)&px))) {
+        for (u32 k = 0; k < n; k++) memcpy(&out[k], px + 512u * k, 4);
+        D3D12_RANGE wr = {0, 0}; rb->lpVtbl->Unmap(rb, 0, &wr); ok = 1;
+    }
+    rb->lpVtbl->Release(rb);
+    return ok;
+}
+static void ld_zp_points(u32 w, u32 h, u32* xs, u32* ys)
+{
+    for (u32 k = 0; k < 3; k++) { xs[k] = w * (k + 1u) / 4u; ys[k] = h * (k + 1u) / 4u; }
+}
+/* After the draw: log the noted binds and, for a depth-export draw, the zeta it wrote. */
+static void ld_zp_finish(u32 current_zslot, const render_state_t* rs)
+{
+    const u32 ctrl = rsx_dsp_shader_control(&g.rsx);
+    const int dexp = (ctrl & 0xEu) && rs->depth_write;
+    if (!g_zp_n_notes && !dexp) return;
+    if (!ld_zp_active()) { g_zp_n_notes = 0; return; }
+    rsx_dsp_surface sf; rsx_dsp_get_surface(&g.rsx, &sf);
+    {   /* one line per (shader control, colour target) per frame */
+        static u32 seen_frame = ~0u, n_seen = 0; static u64 seen[64];
+        const u64 key = (u64)ctrl << 32 | sf.color_offset[0];
+        if (seen_frame != g_ld_frames) { seen_frame = g_ld_frames; n_seen = 0; }
+        for (u32 k = 0; k < n_seen; k++) if (seen[k] == key) { g_zp_n_notes = 0; return; }
+        if (n_seen < 64) seen[n_seen++] = key;
+    }
+    static u32 used = 0;
+    if (++used > (u32)atoi(getenv("LD_ZPROBE"))) { g_zp_n_notes = 0; return; }
+    fprintf(stderr, "[zprobe] frame=%u ctrl=0x%08X surf=0x%X zeta=%u:0x%X clip=%ux%u zslot=%u "
+            "dtest=%u dwrite=%u dfunc=0x%X\n", g_ld_frames, ctrl, sf.color_offset[0],
+            sf.zeta_location, sf.zeta_offset, sf.clip_w, sf.clip_h, current_zslot,
+            rs->depth_test, rs->depth_write, rs->depth_func);
+    for (u32 k = 0; k < g_zp_n_notes; k++) {
+        const ld_zp_note_t* n = &g_zp_notes[k];
+        u32 xs[3], ys[3]; ld_zp_points(n->t.width, n->t.height, xs, ys);
+        char vals[160] = "", gvs[160] = "";
+        if (n->zi >= 0 && n->why == LD_ZP_SNAP) {
+            zdepth_t* z = &g.zdepths[n->zi]; float f[3];
+            if (ld_zp_read_snapshot(z, 3, xs, ys, f))
+                snprintf(vals, sizeof vals, "snap %ux%u [%.6f %.6f %.6f]",
+                         z->snapshot_w, z->snapshot_h, f[0], f[1], f[2]);
+        }
+        const u32 base = n->t.format & TEX_FMT_BASE_MASK & ~(u32)TEX_FMT_UNNORM;
+        const u32 bpp = base == TEX_FMT_A8R8G8B8 ? 4u : 2u;
+        const u32 pitch = n->t.pitch ? n->t.pitch : n->t.width * bpp;
+        const u8* gm = guest_ptr(n->t.location, n->t.offset, pitch * n->t.height);
+        if (gm) {
+            u32 v[3];
+            for (u32 j = 0; j < 3; j++) {
+                const u8* p = gm + (size_t)ys[j] * pitch + (size_t)xs[j] * bpp;
+                v[j] = bpp == 4 ? ((u32)p[0] << 24 | (u32)p[1] << 16 | (u32)p[2] << 8 | p[3])
+                                : ((u32)p[0] << 8 | p[1]);
+            }
+            snprintf(gvs, sizeof gvs, "vram [%08X %08X %08X]", v[0], v[1], v[2]);
+        }
+        fprintf(stderr, "[zprobe]   unit%u tex %u:0x%X fmt=0x%02X %ux%u pitch=%u remap=0x%04X -> %s zeta#%d "
+                "%s %s\n", n->unit, n->t.location, n->t.offset, n->t.format, n->t.width,
+                n->t.height, n->t.pitch, n->t.remap & 0xFFFFu,
+                n->why == LD_ZP_SNAP ? "snapshot" : n->why == LD_ZP_SELF ? "OWN-ZETA(vram)" : "NO-WRITE(vram)",
+                n->zi, vals, gvs);
+    }
+    g_zp_n_notes = 0;
+    if (dexp && current_zslot) {
+        zdepth_t* z = &g.zdepths[current_zslot - 1];
+        u32 xs[3], ys[3]; float f[3]; ld_zp_points(sf.clip_w, sf.clip_h, xs, ys);
+        if (zdepth_snapshot(current_zslot) && ld_zp_read_snapshot(z, 3, xs, ys, f))
+            fprintf(stderr, "[zprobe]   depth-export wrote zeta#%u %ux%u (snap %ux%u) [%.6f %.6f %.6f]\n",
+                    current_zslot - 1, z->w, z->h, z->snapshot_w, z->snapshot_h, f[0], f[1], f[2]);
+    }
+}
