diff -ruN a/libs/video/rsx_display_mode.h b/libs/video/rsx_display_mode.h
--- a/libs/video/rsx_display_mode.h	1969-12-31 18:00:00.000000000 -0600
+++ b/libs/video/rsx_display_mode.h	2026-10-20 20:17:38.986507855 -0500
@@ -0,0 +1,325 @@
+/*
+ * KZ3 patch 2095 (RSX pass 90): display modes. ENHANCEMENT (display; the feature is on, the default mode is Windowed).
+ *
+ *   Windowed    the normal resizable window (patch 2062 keeps its client at the guest aspect while dragging).
+ *   Borderless  a WS_POPUP window covering the monitor the window is on.
+ *   Fullscreen  DXGI exclusive fullscreen (IDXGISwapChain::SetFullscreenState) on the window's monitor; when DXGI
+ *               refuses it the mode falls back to Borderless for the session (logged).
+ * Alt+Enter toggles Windowed <-> the last fullscreen mode (DXGI's own Alt+Enter is turned off with
+ * MakeWindowAssociation(DXGI_MWA_NO_ALT_ENTER), so there is one behaviour). The swap chain follows the client size
+ * (ResizeBuffers); the guest's 1280x720 image is drawn aspect-correct into it with linear filtering and black bars
+ * (rsx_live_draw.c). The mode comes from KZ3_DISPLAY=windowed|borderless|fullscreen (tests; wins), else display.ini
+ * beside keybinds.ini ([display] mode = ...), else Windowed; the Options > Display rows "Display mode", "Image scaling"
+ * (Fit/Stretch) and "Scaling filter" (Bilinear/Nearest; port/kz3/main.cpp patches common/displaysettings.gum) apply at
+ * once and are saved.
+ *
+ * This header is the platform-free part (host test: tools/smoke/test_display_mode.sh): names, the mode state machine,
+ * the letterbox rectangle, client -> guest mouse mapping, the display.ini text, and the Options row's GUM patch.
+ */
+#ifndef RSX_DISPLAY_MODE_H
+#define RSX_DISPLAY_MODE_H
+
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+enum { RSX_DM_WINDOWED = 0, RSX_DM_BORDERLESS = 1, RSX_DM_FULLSCREEN = 2 };
+
+static inline const char* rsx_dm_name(int m)
+{
+    return m == RSX_DM_BORDERLESS ? "borderless" : m == RSX_DM_FULLSCREEN ? "fullscreen" : "windowed";
+}
+
+static inline int rsx_dm_ieq(const char* a, size_t n, const char* b)   /* a[0..n) == b, ASCII case-insensitive */
+{
+    size_t i;
+    if (strlen(b) != n) return 0;
+    for (i = 0; i < n; i++) {
+        char c = a[i];
+        if (c >= 'A' && c <= 'Z') c = (char)(c + 32);
+        if (c != b[i]) return 0;
+    }
+    return 1;
+}
+
+/* "windowed"/"window", "borderless", "fullscreen"/"exclusive" (any case, surrounding blanks ignored) -> mode, else -1. */
+static inline int rsx_dm_parse(const char* s)
+{
+    size_t n;
+    if (!s) return -1;
+    while (*s == ' ' || *s == '\t') s++;
+    n = strlen(s);
+    while (n && (s[n - 1] == ' ' || s[n - 1] == '\t' || s[n - 1] == '\r' || s[n - 1] == '\n')) n--;
+    if (rsx_dm_ieq(s, n, "windowed") || rsx_dm_ieq(s, n, "window")) return RSX_DM_WINDOWED;
+    if (rsx_dm_ieq(s, n, "borderless")) return RSX_DM_BORDERLESS;
+    if (rsx_dm_ieq(s, n, "fullscreen") || rsx_dm_ieq(s, n, "exclusive")) return RSX_DM_FULLSCREEN;
+    return -1;
+}
+
+/* The mode state machine. `mode` is what the window should be, `last_fs` the fullscreen mode Alt+Enter goes to from
+ * Windowed (Borderless until a fullscreen mode was chosen), `no_exclusive` is set once DXGI refused exclusive
+ * fullscreen: Fullscreen then means Borderless for the rest of the session. */
+typedef struct { int mode, last_fs, no_exclusive; } rsx_dm_state;
+
+static inline int rsx_dm_effective(const rsx_dm_state* s, int m)
+{
+    return (m == RSX_DM_FULLSCREEN && s->no_exclusive) ? RSX_DM_BORDERLESS : m;
+}
+
+static inline void rsx_dm_init(rsx_dm_state* s, int mode)
+{
+    if (mode < RSX_DM_WINDOWED || mode > RSX_DM_FULLSCREEN) mode = RSX_DM_WINDOWED;
+    s->mode = mode;
+    s->last_fs = mode == RSX_DM_WINDOWED ? RSX_DM_BORDERLESS : mode;
+    s->no_exclusive = 0;
+}
+
+/* Choose a mode (the Options row, KZ3_DISPLAY). Returns the mode to apply (Borderless for Fullscreen after a refusal). */
+static inline int rsx_dm_set(rsx_dm_state* s, int mode)
+{
+    if (mode < RSX_DM_WINDOWED || mode > RSX_DM_FULLSCREEN) return rsx_dm_effective(s, s->mode);
+    s->mode = mode;
+    if (mode != RSX_DM_WINDOWED) s->last_fs = mode;
+    return rsx_dm_effective(s, mode);
+}
+
+/* Alt+Enter: Windowed -> the last fullscreen mode, any fullscreen mode -> Windowed. Returns the mode to apply. */
+static inline int rsx_dm_toggle(rsx_dm_state* s)
+{
+    return rsx_dm_set(s, s->mode == RSX_DM_WINDOWED ? s->last_fs : RSX_DM_WINDOWED);
+}
+
+/* DXGI refused exclusive fullscreen: Borderless instead, from now on. Returns the mode to apply. */
+static inline int rsx_dm_exclusive_refused(rsx_dm_state* s)
+{
+    s->no_exclusive = 1;
+    return rsx_dm_effective(s, s->mode);
+}
+
+/* The largest rectangle of the source aspect sw:sh inside a dw x dh target, centred (letterbox: bars top/bottom;
+ * pillarbox: bars left/right). Sizes round to the nearest pixel; the bars split the rest, the odd pixel going to the
+ * right/bottom bar. A zero size gives the whole target. */
+typedef struct { int x, y, w, h; } rsx_dm_rect;
+
+static inline rsx_dm_rect rsx_dm_fit(int sw, int sh, int dw, int dh)
+{
+    rsx_dm_rect r = { 0, 0, dw, dh };
+    long long a, b;
+    if (sw <= 0 || sh <= 0 || dw <= 0 || dh <= 0) return r;
+    a = (long long)dw * sh;   /* target wider than the source when a > b */
+    b = (long long)dh * sw;
+    if (a > b) {
+        r.w = (int)(((long long)dh * sw + sh / 2) / sh);
+        if (r.w > dw) r.w = dw;
+        r.x = (dw - r.w) / 2;
+    } else if (a < b) {
+        r.h = (int)(((long long)dw * sh + sw / 2) / sw);
+        if (r.h > dh) r.h = dh;
+        r.y = (dh - r.h) / 2;
+    }
+    return r;
+}
+
+/* Image scaling (Options row "Image scaling", KZ3_DISPLAY_SCALING): Fit = aspect-correct with bars, Stretch (default) =
+ * the whole client, aspect not kept. Filter (row "Scaling filter", KZ3_DISPLAY_FILTER): Bilinear (default) or Nearest;
+ * Nearest with Fit uses the largest whole-number scale that fits (sharp, even pixels; wider bars), falling back to
+ * the plain fit when even 1x does not fit. Modelled on RPCS3's "stretch to display area" and "output scaling". */
+enum { RSX_DM_FIT = 0, RSX_DM_STRETCH = 1 };
+#define RSX_DM_SCALING_DEFAULT RSX_DM_STRETCH /* interim until the game renders at the screen aspect (RSX pass 91) */
+enum { RSX_DM_BILINEAR = 0, RSX_DM_NEAREST = 1 };
+
+static inline const char* rsx_dm_scaling_name(int v) { return v == RSX_DM_STRETCH ? "stretch" : "fit"; }
+static inline const char* rsx_dm_filter_name(int v) { return v == RSX_DM_NEAREST ? "nearest" : "bilinear"; }
+
+static inline int rsx_dm_trim(const char** s, size_t* n)
+{
+    if (!*s) return 0;
+    while (**s == ' ' || **s == '\t') (*s)++;
+    *n = strlen(*s);
+    while (*n && ((*s)[*n - 1] == ' ' || (*s)[*n - 1] == '\t' || (*s)[*n - 1] == '\r' || (*s)[*n - 1] == '\n')) (*n)--;
+    return 1;
+}
+static inline int rsx_dm_parse_scaling(const char* s)
+{
+    size_t n;
+    if (!rsx_dm_trim(&s, &n)) return -1;
+    if (rsx_dm_ieq(s, n, "fit")) return RSX_DM_FIT;
+    if (rsx_dm_ieq(s, n, "stretch")) return RSX_DM_STRETCH;
+    return -1;
+}
+static inline int rsx_dm_parse_filter(const char* s)
+{
+    size_t n;
+    if (!rsx_dm_trim(&s, &n)) return -1;
+    if (rsx_dm_ieq(s, n, "bilinear") || rsx_dm_ieq(s, n, "linear")) return RSX_DM_BILINEAR;
+    if (rsx_dm_ieq(s, n, "nearest") || rsx_dm_ieq(s, n, "point")) return RSX_DM_NEAREST;
+    return -1;
+}
+
+/* The image rectangle for a scaling and filter choice. */
+static inline rsx_dm_rect rsx_dm_rect_for(int sw, int sh, int dw, int dh, int scaling, int filter)
+{
+    rsx_dm_rect r = { 0, 0, dw, dh };
+    if (scaling == RSX_DM_STRETCH || sw <= 0 || sh <= 0 || dw <= 0 || dh <= 0) return r;
+    if (filter == RSX_DM_NEAREST) {
+        int k = dw / sw < dh / sh ? dw / sw : dh / sh;
+        if (k >= 1) {
+            r.w = k * sw; r.h = k * sh;
+            r.x = (dw - r.w) / 2; r.y = (dh - r.h) / 2;
+            return r;
+        }
+    }
+    return rsx_dm_fit(sw, sh, dw, dh);
+}
+
+/* A client pixel (cx, cy) -> the guest pixel under it (sw x sh image drawn into r). Returns 1 inside the image, 0 on a
+ * bar (the result is then clamped to the nearest edge pixel). Pixel centres map to pixel centres:
+ * g = floor(((c - r.x) + 0.5) * sw / r.w). */
+static inline int rsx_dm_to_guest(const rsx_dm_rect* r, int sw, int sh, int cx, int cy, int* gx, int* gy)
+{
+    int in = cx >= r->x && cx < r->x + r->w && cy >= r->y && cy < r->y + r->h;
+    long long x, y;
+    if (r->w <= 0 || r->h <= 0 || sw <= 0 || sh <= 0) { *gx = cx; *gy = cy; return 0; }
+    x = (2LL * (cx - r->x) + 1) * sw;
+    y = (2LL * (cy - r->y) + 1) * sh;
+    x = x < 0 ? -1 : x / (2LL * r->w);
+    y = y < 0 ? -1 : y / (2LL * r->h);
+    *gx = (int)(x < 0 ? 0 : x >= sw ? sw - 1 : x);
+    *gy = (int)(y < 0 ? 0 : y >= sh ? sh - 1 : y);
+    return in;
+}
+
+/* display.ini: "[display]" then "key = value" lines (mode, scaling, filter); other sections are ignored. The value of
+ * `key` into out (1), or 0 when missing. */
+static inline int rsx_dm_ini_value(const char* t, const char* key, char* out, size_t cap)
+{
+    int in_sec = 0;
+    size_t kl = strlen(key);
+    while (t && *t) {
+        const char* e = strchr(t, '\n');
+        size_t n = e ? (size_t)(e - t) : strlen(t);
+        const char* p = t;
+        while (n && (*p == ' ' || *p == '\t')) { p++; n--; }
+        while (n && (p[n - 1] == '\r' || p[n - 1] == ' ' || p[n - 1] == '\t')) n--;
+        if (n && p[0] == '[') in_sec = rsx_dm_ieq(p, n, "[display]");
+        else if (in_sec && n > kl && rsx_dm_ieq(p, kl, key)) {
+            const char* q = p + kl;
+            size_t m = n - kl;
+            while (m && (*q == ' ' || *q == '\t')) { q++; m--; }
+            if (m && *q == '=') {
+                q++; m--;
+                if (m >= cap) m = cap - 1;
+                memcpy(out, q, m); out[m] = 0;
+                return 1;
+            }
+        }
+        t = e ? e + 1 : NULL;
+    }
+    return 0;
+}
+static inline int rsx_dm_ini_parse(const char* t)          /* the mode, or -1 */
+{
+    char v[32];
+    return rsx_dm_ini_value(t, "mode", v, sizeof v) ? rsx_dm_parse(v) : -1;
+}
+static inline int rsx_dm_ini_scaling(const char* t)        /* the scaling, or -1 */
+{
+    char v[32];
+    return rsx_dm_ini_value(t, "scaling", v, sizeof v) ? rsx_dm_parse_scaling(v) : -1;
+}
+static inline int rsx_dm_ini_filter(const char* t)         /* the filter, or -1 */
+{
+    char v[32];
+    return rsx_dm_ini_value(t, "filter", v, sizeof v) ? rsx_dm_parse_filter(v) : -1;
+}
+
+static inline int rsx_dm_ini_write(char* buf, size_t n, int mode, int scaling, int filter)
+{
+    return snprintf(buf, n,
+                    "# Project Helghast display settings (Options > Display; Alt+Enter toggles the mode).\n"
+                    "# mode = windowed | borderless | fullscreen, scaling = fit | stretch, filter = bilinear | nearest.\n"
+                    "# KZ3_DISPLAY, KZ3_DISPLAY_SCALING, KZ3_DISPLAY_FILTER override them for one run.\n"
+                    "[display]\nmode = %s\nscaling = %s\nfilter = %s\n", rsx_dm_name(mode), rsx_dm_scaling_name(scaling),
+                    rsx_dm_filter_name(filter));
+}
+
+/* The Options row (Options > Display, common/displaysettings.gum): three <select>s (mode, scaling, filter) before the Brightness row, the same
+ * widget as the page's own rows, and three functions in its settingscript. The value goes to the host through the
+ * Keyboard page's Lua bridge (gPlayerProfile:SetTimeZone("kb:display <v>") / GetTimeZone(), port/kz3/main.cpp), which
+ * applies and saves it; OnPageOn selects the current mode. */
+static inline const char* rsx_dm_find(const char* h, size_t n, size_t from, const char* needle)
+{
+    size_t k = strlen(needle), i;
+    for (i = from; i + k <= n; i++)
+        if (!memcmp(h + i, needle, k)) return h + i;
+    return NULL;
+}
+
+/* The page with the row and the functions added (malloc'd, NUL-terminated, *out_n bytes), or NULL when an anchor is
+ * missing (the Brightness listitem, the settingscript CDATA end), the script already has an OnPageOn, or the row is
+ * already there: the page is then served unchanged. */
+static inline char* rsx_dm_patch_gum(const char* in, size_t n, size_t* out_n)
+{
+    static const char rsx_dm_gum_row[] =
+        "<select id=\"slc_kz3_display\" label=\"Display mode\" onchange=\"script(settingscript,KZ3ChangeDisplay)\"\n"
+        "\t\t\t\tdefault-value=\"windowed\">\n"
+        "\t\t\t\t<selectitem value=\"windowed\">Windowed</selectitem>\n"
+        "\t\t\t\t<selectitem value=\"borderless\">Borderless</selectitem>\n"
+        "\t\t\t\t<selectitem value=\"fullscreen\">Fullscreen</selectitem>\n"
+        "\t\t\t</select>\n\n\t\t\t"
+        "<select id=\"slc_kz3_scaling\" label=\"Image scaling\" onchange=\"script(settingscript,KZ3ChangeScaling)\"\n"
+        "\t\t\t\tdefault-value=\"stretch\">\n"
+        "\t\t\t\t<selectitem value=\"fit\">Fit</selectitem>\n"
+        "\t\t\t\t<selectitem value=\"stretch\">Stretch</selectitem>\n"
+        "\t\t\t</select>\n\n\t\t\t"
+        "<select id=\"slc_kz3_filter\" label=\"Scaling filter\" onchange=\"script(settingscript,KZ3ChangeFilter)\"\n"
+        "\t\t\t\tdefault-value=\"bilinear\">\n"
+        "\t\t\t\t<selectitem value=\"bilinear\">Bilinear</selectitem>\n"
+        "\t\t\t\t<selectitem value=\"nearest\">Nearest</selectitem>\n"
+        "\t\t\t</select>\n\n\t\t\t";
+
+    static const char rsx_dm_gum_lua[] =
+        "\n\t\tgKz3Dm = 0\n\t\tfunction KZ3DisplayCmd(c)\n"
+        "\t\t\tgPlayerProfile:SetTimeZone(\"kb:\"..c)\n"
+        "\t\t\treturn gPlayerProfile:GetTimeZone()\n"
+        "\t\tend\n\n"
+        "\t\tfunction OnPageOn()\n"
+        "\t\t\tgRoot:GetTag(\"slc_kz3_display\"):SetValue(KZ3DisplayCmd(\"display\"))\n"
+        "\t\t\tgRoot:GetTag(\"slc_kz3_scaling\"):SetValue(KZ3DisplayCmd(\"scaling\"))\n"
+        "\t\t\tgRoot:GetTag(\"slc_kz3_filter\"):SetValue(KZ3DisplayCmd(\"filter\"))\n\t\t\tgKz3Dm = 1\n"
+        "\t\tend\n\n"
+        "\t\tfunction KZ3ChangeDisplay(e)\n"
+        "\t\t\te:SetHandled(true)\n"
+        "\t\t\tif (gKz3Dm == 1) then KZ3DisplayCmd(\"display \"..e:GetSender():GetValue()) end\n"
+        "\t\tend\n\n"
+        "\t\tfunction KZ3ChangeScaling(e)\n"
+        "\t\t\te:SetHandled(true)\n"
+        "\t\t\tif (gKz3Dm == 1) then KZ3DisplayCmd(\"scaling \"..e:GetSender():GetValue()) end\n"
+        "\t\tend\n\n"
+        "\t\tfunction KZ3ChangeFilter(e)\n"
+        "\t\t\te:SetHandled(true)\n"
+        "\t\t\tif (gKz3Dm == 1) then KZ3DisplayCmd(\"filter \"..e:GetSender():GetValue()) end\n"
+        "\t\tend\n";
+    const char* row = rsx_dm_find(in, n, 0, "<listitem id=\"lst_gamma_screen\"");
+    const char* scr = rsx_dm_find(in, n, 0, "<script id=\"settingscript\">");
+    const char* cd = scr ? rsx_dm_find(in, n, (size_t)(scr - in), "]]>") : NULL;
+    size_t at_row, at_lua, nr = sizeof rsx_dm_gum_row - 1, nl = sizeof rsx_dm_gum_lua - 1, o = 0;
+    char* out;
+    if (!row || !scr || !cd || row > scr || rsx_dm_find(in, n, 0, "function OnPageOn") ||
+        rsx_dm_find(in, n, 0, "slc_kz3_display")) return NULL;
+    at_row = (size_t)(row - in);
+    at_lua = (size_t)(cd - in);
+    out = (char*)malloc(n + nr + nl + 1);
+    if (!out) return NULL;
+    memcpy(out + o, in, at_row); o += at_row;
+    memcpy(out + o, rsx_dm_gum_row, nr); o += nr;
+    memcpy(out + o, in + at_row, at_lua - at_row); o += at_lua - at_row;
+    memcpy(out + o, rsx_dm_gum_lua, nl); o += nl;
+    memcpy(out + o, in + at_lua, n - at_lua); o += n - at_lua;
+    out[o] = 0;
+    *out_n = o;
+    return out;
+}
+
+#endif /* RSX_DISPLAY_MODE_H */
