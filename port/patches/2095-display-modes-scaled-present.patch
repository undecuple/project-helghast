+ * (posted as RSX_DM_WM_SET from the guest's Lua bridge thread) are handled in the window procedure, so a mode change
+ * never races the present. Exclusive fullscreen is the live-draw swap chain's (rsx_live_draw_set_fullscreen).
+ * -----------------------------------------------------------------------*/
+#include "rsx_display_mode.h"
+extern int rsx_live_draw_set_fullscreen(int on);   /* 1 taken, 0 refused, -1 no swap chain yet (rsx_live_draw.c) */
+extern int rsx_live_draw_is_fullscreen(void);
+extern void rsx_live_draw_set_scaling(int scaling, int filter);   /* Fit/Stretch, Bilinear/Nearest */
+
+#define RSX_DM_WM_SET (WM_APP + 0x95)
+#define RSX_DM_WM_SCALE (WM_APP + 0x96)
+static int s_dm_scaling = RSX_DM_SCALING_DEFAULT, s_dm_filter = RSX_DM_BILINEAR;
+static int s_dm_cfg_scaling = -1, s_dm_cfg_filter = -1;
+static rsx_dm_state s_dm;
+static int s_dm_applied = RSX_DM_WINDOWED;        /* what the window is now */
+static int s_dm_env = 0;                          /* KZ3_DISPLAY given: nothing is saved */
+static int s_dm_cfg = -1;                         /* the saved mode (rsx_display_configure) */
+static void (*s_dm_save)(int mode, int scaling, int filter);   /* writes display.ini (port/kz3/main.cpp) */
+static int s_dm_pending = -1;                     /* exclusive fullscreen waits for the swap chain */
+static WINDOWPLACEMENT s_dm_wp;
+static LONG_PTR s_dm_style, s_dm_exstyle;
+static int s_dm_saved;
+static ULONGLONG s_dm_t0;
+static const char* s_dm_script;                   /* KZ3_TEST_DISPLAY */
+
+/* Called by the port before the window exists: what display.ini holds (-1 = none) and how to save the settings. */
+void rsx_display_configure(int saved_mode, int saved_scaling, int saved_filter,
+                           void (*save)(int mode, int scaling, int filter))
+{
+    s_dm_cfg = saved_mode;
+    s_dm_cfg_scaling = saved_scaling;
+    s_dm_cfg_filter = saved_filter;
+    s_dm_save = save;
+}
+
+int rsx_display_get_mode(void) { return s_dm.mode; }
+int rsx_display_get_scaling(void) { return s_dm_scaling; }
+int rsx_display_get_filter(void) { return s_dm_filter; }
+static void rsx_dm_save_now(void) { if (!s_dm_env && s_dm_save) s_dm_save(s_dm.mode, s_dm_scaling, s_dm_filter); }
+
+static void rsx_dm_log_client(const char* why)
+{
+    RECT rc = {0, 0, 0, 0};
+    rsx_dm_rect r;
+    if (s_state.hwnd) GetClientRect(s_state.hwnd, &rc);
+    r = rsx_dm_rect_for((int)s_state.width, (int)s_state.height, rc.right, rc.bottom, s_dm_scaling, s_dm_filter);
+    printf("[display] %s: mode %s (chosen %s), scaling %s, filter %s, client %ldx%ld, image %dx%d at %d,%d\n", why,
+           rsx_dm_name(s_dm_applied), rsx_dm_name(s_dm.mode), rsx_dm_scaling_name(s_dm_scaling),
+           rsx_dm_filter_name(s_dm_filter), (long)rc.right, (long)rc.bottom, r.w, r.h, r.x, r.y);
+    fflush(stdout);
+}
+
+static void rsx_dm_apply(int m, const char* why)
+{
+    HWND h = s_state.hwnd;
+    if (!h) return;
+    if (s_dm_applied == RSX_DM_FULLSCREEN && m != RSX_DM_FULLSCREEN) rsx_live_draw_set_fullscreen(0);
+    if (m == RSX_DM_WINDOWED) {
+        s_dm_pending = -1;
+        if (s_dm_saved) {
+            SetWindowLongPtrA(h, GWL_STYLE, s_dm_style);
+            SetWindowLongPtrA(h, GWL_EXSTYLE, s_dm_exstyle);
+            SetWindowPos(h, HWND_NOTOPMOST, 0, 0, 0, 0,
+                         SWP_NOMOVE | SWP_NOSIZE | SWP_FRAMECHANGED | SWP_NOACTIVATE | SWP_NOOWNERZORDER);
+            SetWindowPlacement(h, &s_dm_wp);
+            s_dm_saved = 0;
+        }
+    } else {
+        HMONITOR mon = MonitorFromWindow(h, MONITOR_DEFAULTTONEAREST);
+        MONITORINFO mi;
+        mi.cbSize = sizeof mi;
+        if (s_dm_applied == RSX_DM_WINDOWED && !s_dm_saved) {
+            s_dm_wp.length = sizeof s_dm_wp;
+            GetWindowPlacement(h, &s_dm_wp);
+            s_dm_style = GetWindowLongPtrA(h, GWL_STYLE);
+            s_dm_exstyle = GetWindowLongPtrA(h, GWL_EXSTYLE);
+            s_dm_saved = 1;
+        }
+        if (mon && GetMonitorInfoA(mon, &mi)) {
+            SetWindowLongPtrA(h, GWL_STYLE,
+                              (s_dm_style & ~(LONG_PTR)(WS_OVERLAPPEDWINDOW | WS_MAXIMIZE | WS_MINIMIZE)) | WS_POPUP |
+                                  WS_VISIBLE);
+            SetWindowPos(h, HWND_TOP, mi.rcMonitor.left, mi.rcMonitor.top, mi.rcMonitor.right - mi.rcMonitor.left,
+                         mi.rcMonitor.bottom - mi.rcMonitor.top, SWP_FRAMECHANGED | SWP_NOOWNERZORDER | SWP_SHOWWINDOW);
+        }
+        if (m == RSX_DM_FULLSCREEN) {
+            const int r = rsx_live_draw_set_fullscreen(1);
+            if (r < 0 && s_present_suppressed) {           /* live draw not up yet: retry at the next pump */
+                s_dm_pending = RSX_DM_FULLSCREEN;
+                s_dm_applied = RSX_DM_BORDERLESS;
+                rsx_dm_log_client("exclusive fullscreen waits for the swap chain");
+                return;
+            }
+            s_dm_pending = -1;
+            if (r <= 0) {
+                m = rsx_dm_exclusive_refused(&s_dm);
+                printf("[display] exclusive fullscreen refused (%s): borderless for this session\n",
+                       r < 0 ? "no live-draw swap chain" : "SetFullscreenState failed");
+            }
+        }
+    }
+    s_dm_applied = m;
+    rsx_dm_log_client(why);
+}
+
+static void rsx_dm_choose(int m, const char* why)    /* a player's choice: apply, then save */
+{
+    rsx_dm_apply(rsx_dm_set(&s_dm, m), why);
+    rsx_dm_save_now();
+}
+
+/* From any thread (the Options row's Lua bridge): the change itself happens on the window's thread. */
+int rsx_display_set_mode(int m)
+{
+    if (m < RSX_DM_WINDOWED || m > RSX_DM_FULLSCREEN || !s_state.hwnd) return 0;
+    return PostMessageA(s_state.hwnd, RSX_DM_WM_SET, (WPARAM)m, 0) ? 1 : 0;
+}
+
+/* Image scaling / filter (-1 = unchanged), from any thread; applied on the window's thread and saved. */
+int rsx_display_set_scaling(int scaling, int filter)
+{
+    if (!s_state.hwnd) return 0;
+    return PostMessageA(s_state.hwnd, RSX_DM_WM_SCALE, (WPARAM)(scaling + 1), (LPARAM)(filter + 1)) ? 1 : 0;
+}
+
+/* A client pixel -> the guest pixel under it, through the letterbox (1 inside the image, 0 on a bar). For the port's
+ * own mouse-driven UI; the game itself reads no cursor position. */
+int rsx_display_client_to_guest(int cx, int cy, int* gx, int* gy)
+{
+    RECT rc = {0, 0, 0, 0};
+    rsx_dm_rect r;
+    if (s_state.hwnd) GetClientRect(s_state.hwnd, &rc);
+    r = rsx_dm_rect_for((int)s_state.width, (int)s_state.height, rc.right, rc.bottom, s_dm_scaling, s_dm_filter);
+    return rsx_dm_to_guest(&r, (int)s_state.width, (int)s_state.height, cx, cy, gx, gy);
+}
+
+static int rsx_dm_wndmsg(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp, LRESULT* res)
+{
+    (void)hwnd;
+    if (msg == WM_SYSKEYDOWN && wp == VK_RETURN && (lp & (1 << 29))) {   /* Alt+Enter */
+        if (!(lp & (1 << 30))) {                                             /* not an auto-repeat */
+            rsx_dm_apply(rsx_dm_toggle(&s_dm), "Alt+Enter");
+            rsx_dm_save_now();
+        }
+        *res = 0;
+        return 1;
+    }
+    if (msg == WM_SYSCHAR && wp == '\r') { *res = 0; return 1; }   /* no beep for Alt+Enter */
+    if (msg == RSX_DM_WM_SET) { rsx_dm_choose((int)wp, "Options"); *res = 0; return 1; }
+    if (msg == RSX_DM_WM_SCALE) {
+        const int sc = (int)wp - 1, f = (int)lp - 1;
+        if (sc == RSX_DM_FIT || sc == RSX_DM_STRETCH) s_dm_scaling = sc;
+        if (f == RSX_DM_BILINEAR || f == RSX_DM_NEAREST) s_dm_filter = f;
+        rsx_live_draw_set_scaling(s_dm_scaling, s_dm_filter);
+        rsx_dm_log_client("Options scaling");
+        rsx_dm_save_now();
+        *res = 0;
+        return 1;
+    }
+    if (msg == WM_ACTIVATEAPP && wp && s_dm_applied == RSX_DM_FULLSCREEN && !rsx_live_draw_is_fullscreen()) {
+        if (rsx_live_draw_set_fullscreen(1) > 0) rsx_dm_log_client("exclusive fullscreen taken back on activation");
+    }
+    return 0;
+}
+
+/* KZ3_TEST_DISPLAY="S:action,S:action,...": at S seconds after the window opened, `altenter` (a WM_SYSKEYDOWN
+ * VK_RETURN with the Alt bit, posted, so the window procedure's own path runs), `windowed|borderless|fullscreen` (as
+ * the Options row), `fit|stretch`, `bilinear|nearest`, `resize=WxH` (client size, windowed), `log`. */
+static void rsx_dm_script_step(void)
+{
+    double t;
+    if (!s_dm_script || !*s_dm_script || !s_state.hwnd) return;
+    t = (double)(GetTickCount64() - s_dm_t0) / 1000.0;
+    while (*s_dm_script) {
+        char* e;
+        double at = strtod(s_dm_script, &e);
+        char act[48];
+        size_t n = 0;
+        if (e == s_dm_script || *e != ':') { s_dm_script = ""; return; }
+        if (t < at) return;
+        e++;
+        while (e[n] && e[n] != ',' && n < sizeof act - 1) { act[n] = e[n]; n++; }
+        act[n] = 0;
+        s_dm_script = e[n] == ',' ? e + n + 1 : e + n;
+        printf("[display] test step at %.1f s: %s\n", t, act);
+        if (!strcmp(act, "altenter")) PostMessageA(s_state.hwnd, WM_SYSKEYDOWN, VK_RETURN, (LPARAM)((1u << 29) | 1u));
+        else if (!strncmp(act, "resize=", 7)) {
+            int w = 0, h = 0;
+            if (rsx_win_parse_size(act + 7, &w, &h) && s_dm_applied == RSX_DM_WINDOWED) {
+                RECT wr = {0, 0, w, h};
+                AdjustWindowRect(&wr, (DWORD)GetWindowLongPtrA(s_state.hwnd, GWL_STYLE), FALSE);
+                SetWindowPos(s_state.hwnd, NULL, 0, 0, wr.right - wr.left, wr.bottom - wr.top,
+                             SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE);
+                rsx_dm_log_client("test resize");
+            }
+        } else if (!strcmp(act, "log")) rsx_dm_log_client("test log");
+        else if (rsx_dm_parse(act) >= 0) rsx_display_set_mode(rsx_dm_parse(act));
+        else if (rsx_dm_parse_scaling(act) >= 0) rsx_display_set_scaling(rsx_dm_parse_scaling(act), -1);
+        else if (rsx_dm_parse_filter(act) >= 0) rsx_display_set_scaling(-1, rsx_dm_parse_filter(act));
+        fflush(stdout);
+    }
+}
+
+static void rsx_dm_init_window(void)
+{
+    const char* e = getenv("KZ3_DISPLAY");
+    int m = e && *e ? rsx_dm_parse(e) : -1;
+    const char* src = "default";
+    if (e && *e && m < 0) printf("[display] KZ3_DISPLAY=%s not understood (windowed|borderless|fullscreen)\n", e);
+    if (m >= 0) { s_dm_env = 1; src = "KZ3_DISPLAY"; }
+    else if (s_dm_cfg >= 0) { m = s_dm_cfg; src = "display.ini"; }
+    else m = RSX_DM_WINDOWED;
+    rsx_dm_init(&s_dm, m);
+    {   /* scaling and filter: env (tests, never saved), else display.ini, else Stretch / Bilinear */
+        const char* es = getenv("KZ3_DISPLAY_SCALING");
+        const char* ef = getenv("KZ3_DISPLAY_FILTER");
+        const int vs = es && *es ? rsx_dm_parse_scaling(es) : -1, vf = ef && *ef ? rsx_dm_parse_filter(ef) : -1;
+        if (es && *es && vs < 0) printf("[display] KZ3_DISPLAY_SCALING=%s not understood (fit|stretch)\n", es);
+        if (ef && *ef && vf < 0) printf("[display] KZ3_DISPLAY_FILTER=%s not understood (bilinear|nearest)\n", ef);
+        if (vs >= 0 || vf >= 0) s_dm_env = 1;
+        s_dm_scaling = vs >= 0 ? vs : s_dm_cfg_scaling >= 0 ? s_dm_cfg_scaling : RSX_DM_SCALING_DEFAULT;
+        s_dm_filter = vf >= 0 ? vf : s_dm_cfg_filter >= 0 ? s_dm_cfg_filter : RSX_DM_BILINEAR;
+    }
+    rsx_live_draw_set_scaling(s_dm_scaling, s_dm_filter);
+    s_dm_t0 = GetTickCount64();
+    s_dm_script = getenv("KZ3_TEST_DISPLAY");
+    printf("[display] mode %s from %s (Alt+Enter toggles windowed / %s), scaling %s, filter %s%s\n", rsx_dm_name(m), src,
+           rsx_dm_name(s_dm.last_fs), rsx_dm_scaling_name(s_dm_scaling), rsx_dm_filter_name(s_dm_filter),
+           s_dm_env ? " (KZ3_DISPLAY*: not saved)" : "");
+    if (m == RSX_DM_FULLSCREEN) {          /* the swap chain does not exist yet: borderless now, exclusive at the */
+        rsx_dm_apply(RSX_DM_BORDERLESS, "start");   /* first pump (live draw is up by then) */
+        s_dm_pending = RSX_DM_FULLSCREEN;
+    } else if (m != RSX_DM_WINDOWED) rsx_dm_apply(m, "start");
+    fflush(stdout);
+}
