KZ3 patch 2183 (RSX pass 161): LD_CEIL=<list>, measurement-only ceiling probes for the frame-rate buckets (default off,
never shipped on, the picture may be wrong). New libs/video/rsx_ceil.h (pure parser + once-read mask, host test
tools/smoke/test_ceil.sh). Tokens: vtx = rsx_vertex_fetch_many returns 1 without converting (plan, refs, remap and the
ring copy still run); texhash = ld_tex_hash_due always "not due" (no per-frame texture hash, so no redecode either);
wb = both guest write-backs off (as LD_NV0039_WRITEBACK=0 LD_MAIN_SURFACE_WRITEBACK=0); rb = only the readback wait gone
(as LD_WB_UNSAFE_NOWAIT=1: the copies are submitted, the stores read the buffers early). wb and rb are shorthands of
switches that already exist, so one variable names every ceiling of a run. Log line [ceil] once at the first use.

diff --git a/libs/video/rsx_ceil.h b/libs/video/rsx_ceil.h
new file mode 100644
index 00000000..7696677a
--- /dev/null
+++ b/libs/video/rsx_ceil.h
@@ -0,0 +1,64 @@
+/* KZ3 patch 2183 (RSX pass 161): LD_CEIL=<list>, measurement-only ceiling switches for the frame-rate buckets.
+ * DIAGNOSTIC: the picture may be wrong; never set in a shipped run. Default off (unset/empty = 0).
+ *   vtx     rsx_vertex_fetch_many returns success without converting (the plan, refs, remap and ring copy still run;
+ *           the reserved ring bytes keep whatever they held). Removes the CPU attribute conversion only.
+ *   texhash ld_tex_hash_due always answers "not due": no per-frame content hash of a bound texture, so nothing is
+ *           re-decoded either (changed textures stay stale). New entries still hash and decode once.
+ *   wb      both guest write-backs off (the same as LD_NV0039_WRITEBACK=0 LD_MAIN_SURFACE_WRITEBACK=0): readback
+ *           copy, wait and store gone, and with them the redecode of the copied bytes.
+ *   rb      only the readback WAIT is gone (the same as LD_WB_UNSAFE_NOWAIT=1): the copies are submitted, the stores
+ *           read the buffers early and so write stale bytes; the CPU store cost stays.
+ * Unknown tokens are reported once and ignored. Pure parser, host test tools/smoke/test_ceil.sh. */
+#ifndef RSX_CEIL_H
+#define RSX_CEIL_H
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define RSX_CEIL_VTX     1u
+#define RSX_CEIL_TEXHASH 2u
+#define RSX_CEIL_WB      4u
+#define RSX_CEIL_RB      8u
+#define RSX_PATCH_2183 1
+#ifndef RSX_CEIL_QUIET_LOG
+#define RSX_CEIL_QUIET_LOG 0   /* a second translation unit defines 1 so the line prints once */
+#endif
+
+/* Mask for a comma/space separated list; *bad = number of unknown tokens (may be NULL). */
+static inline unsigned rsx_ceil_parse(const char* s, unsigned* bad)
+{
+    static const struct { const char* n; unsigned bit; } tab[] = {
+        { "vtx", RSX_CEIL_VTX }, { "texhash", RSX_CEIL_TEXHASH }, { "wb", RSX_CEIL_WB }, { "rb", RSX_CEIL_RB } };
+    unsigned m = 0, nb = 0;
+    while (s && *s) {
+        while (*s == ',' || *s == ' ') s++;
+        const char* e = s;
+        while (*e && *e != ',' && *e != ' ') e++;
+        if (e > s) {
+            unsigned found = 0;
+            for (unsigned i = 0; i < sizeof tab / sizeof tab[0]; i++)
+                if (strlen(tab[i].n) == (size_t)(e - s) && !strncmp(s, tab[i].n, (size_t)(e - s))) { m |= tab[i].bit; found = 1; }
+            if (!found) nb++;
+        }
+        s = e;
+    }
+    if (bad) *bad = nb;
+    return m;
+}
+
+/* The process mask, read once from LD_CEIL (logged once). */
+static inline unsigned rsx_ceil_mask(void)
+{
+    static int have;
+    static unsigned mask;
+    if (!have) {
+        const char* e = getenv("LD_CEIL");
+        unsigned bad = 0;
+        mask = (e && e[0]) ? rsx_ceil_parse(e, &bad) : 0u;
+        if (e && e[0] && !RSX_CEIL_QUIET_LOG)
+            fprintf(stderr, "[ceil] LD_CEIL=%s -> mask 0x%X (%u unknown token(s)); DIAGNOSTIC, picture and timings are not shipping behaviour\n",
+                    e, mask, bad);
+        have = 1;
+    }
+    return mask;
+}
+#endif
