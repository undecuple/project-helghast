+int g_kz3_fma_stats = 0;   /* patch 1040: KZ3_SPU_FMASTATS=1 counts the fma fallback lanes by reason */
+/* Lanes that left patch 1038's inline fma path, by reason: [0] NaN/inf sum, [1] float overflow, [2] float
+ * subnormal result (with FTZ: only the one edge value), [3] rounding midpoint; [4] fallback vectors. Shared by
+ * all SPU host threads (relaxed atomics, slow path only). */
+unsigned long long g_kz3_fma_fb[5];
+void kz3_spu_fma_note(const double s[4], int ftz)
+{
+    for (int i = 0; i < 4; i++) {
+        const double a = __builtin_fabs(s[i]);
+        int k;
+        if (a != a || a == __builtin_inf()) k = 0;
+        else if (a >= 0x1p128) k = 1;
+        else if (a == 0) continue;
+        else if (a < 0x1p-126) k = 2;
+        else {
+            uint64_t u; memcpy(&u, &s[i], 8);
+            if ((u & 0x1FFFFFFFull) != 0x10000000ull) continue;   /* a lane inside the rule */
+            k = 3;
+        }
+        __atomic_fetch_add(&g_kz3_fma_fb[k], 1, __ATOMIC_RELAXED);
+    }
+    (void)ftz;
+    const unsigned long long n = __atomic_add_fetch(&g_kz3_fma_fb[4], 1, __ATOMIC_RELAXED);
+    if ((n & ((1u << 18) - 1)) == 0 && getenv("KZ3_SPU_FMASTATS"))
+        fprintf(stderr, "[spu-fma] fallback vectors=%llu lanes: naninf=%llu overflow=%llu subnormal=%llu midpoint=%llu ftz=%d\n",
+                n, g_kz3_fma_fb[0], g_kz3_fma_fb[1], g_kz3_fma_fb[2], g_kz3_fma_fb[3], g_kz3_spu_slowcg == 0);
+}
