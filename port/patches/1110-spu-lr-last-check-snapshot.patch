 unsigned long g_spu_lr_raise = 0;
 
+/* ===========================================================================
+ * KZ3 patch 1110: the last check for the lock-line event, and its history.
+ *
+ * Only writers that go through spu_coh_notify_write* raise SPU_EVENT_LR as
+ * they land. A store that bypasses them (an HLE memcpy into guest memory, a
+ * device write) is seen only by the snapshot compare in rdch/rchcnt
+ * SPU_RdEventStat (spu_resv_lost_poll), and only while the reservation is
+ * still valid. GETLLAR (same line: snapshot overwritten; other line:
+ * reservation dropped) and PUTLLC (failure, or a drop for another line) ended
+ * the reservation without making that compare, so the event hardware latched
+ * at the store was never raised, and an SPU that then waits for it sleeps.
+ * RPCS3 PR #5435 orders its GETLLAR the same way: a last check for the event
+ * before the old reservation is replaced. KZ3_LR_LASTCHECK=0 = old behaviour.
+ * ===========================================================================*/
+extern uint8_t* vm_base;
+void spu_lr_note(spu_context* c, uint32_t src, uint32_t line)
+{
+    __atomic_fetch_add(&c->lr_raise_n, 1, __ATOMIC_RELAXED);
+    __atomic_store_n(&c->lr_last_src, src, __ATOMIC_RELAXED);
+    __atomic_store_n(&c->lr_last_line, line, __ATOMIC_RELAXED);
+}
+static int spu_lr_lastcheck_on(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("KZ3_LR_LASTCHECK"); v = (e && *e == '0') ? 0 : 1; }
+    return v;
+}
+/* On ctx's own thread (GETLLAR/PUTLLC), so no wake is needed. A notifier
+ * killing the same reservation concurrently loses or wins the same CAS:
+ * the event is raised once. */
+int spu_resv_last_check(spu_context* ctx)
+{
+    if (!spu_lr_lastcheck_on() || !vm_base) return 0;
+    if (__atomic_load_n(&ctx->resv_valid, __ATOMIC_ACQUIRE) != 1) return 0;
+    const uint32_t line = __atomic_load_n(&ctx->resv_ea, __ATOMIC_RELAXED) & ~127u;
+    if (line == 0 || memcmp(vm_base + line, ctx->resv_line, 128) == 0) return 0;
+    int one = 1;
+    if (!__atomic_compare_exchange_n(&ctx->resv_valid, &one, 0, 0, __ATOMIC_SEQ_CST, __ATOMIC_RELAXED))
+        return 0;
+    spu_event_raise(ctx, SPU_EVENT_LR);
+    spu_lr_note(ctx, SPU_LR_SRC_LASTCHECK, line);
+    __atomic_fetch_add(&g_spu_lr_raise, 1, __ATOMIC_RELAXED);
+    return 1;
+}
+
+int spu_lr_snap_on(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("KZ3_LR_SNAP"); v = (e && *e && *e != '0') ? 1 : 0; }
+    return v;
+}
+/* KZ3_LR_SNAP=1: at a stall (a 2 s RdEventStat/RdInMbox park, a GETLLAR spin
+ * of 4M on one line, or any watcher that calls it), one line per registered
+ * SPU context with what decides which way a lock-line wake went wrong:
+ *   never-written  reservation valid, line == snapshot (nobody wrote it)
+ *   missed-wake    reservation gone, LR not pending, LR in the mask (a wake
+ *                  that was never raised, or raised and acked without a re-read)
+ *   unseen-write   reservation valid, line != snapshot (the compare not run yet)
+ *   not-advanced   LR pending and enabled (raised; the SPU has not consumed it)
+ * KZ3_LR_SNAP_N = snapshots per run (default 4). */
+void spu_lr_snapshot(const char* why, const spu_context* who)
+{
+    static int s_left = -1;
+    if (s_left < 0) { const char* e = getenv("KZ3_LR_SNAP_N"); s_left = (e && atoi(e) > 0) ? atoi(e) : 4; }
+    if (__atomic_fetch_sub(&s_left, 1, __ATOMIC_RELAXED) <= 0) return;
+    fprintf(stderr, "[lr-snap] why=%s spu=%X pc=0x%05X lr_raise_total=%lu registry=%u\n", why ? why : "?",
+            who ? who->spu_id : 0xFFu, who ? (unsigned)(who->pc & 0x3FFFFu) : 0u,
+            __atomic_load_n(&g_spu_lr_raise, __ATOMIC_RELAXED), spu_coh_capacity());
+    SPU_COH_FOR_EACH(ch, i) {
+        const spu_context* c = __atomic_load_n(&ch->slot[i], __ATOMIC_ACQUIRE);
+        if (!c) continue;
+        const int v = __atomic_load_n(&c->resv_valid, __ATOMIC_ACQUIRE);
+        const uint32_t ea = c->resv_ea & ~127u, st = spu_event_load(c), mask = c->event_mask;
+        const int diff = (v && vm_base && ea) ? memcmp(vm_base + ea, c->resv_line, 128) != 0 : -1;
+        const char* cls = (st & mask & SPU_EVENT_LR) ? "not-advanced"
+                        : (v && diff == 1)          ? "unseen-write"
+                        : (v && diff == 0)          ? "never-written"
+                        : (mask & SPU_EVENT_LR)     ? "missed-wake" : "no-lr-wait";
+        fprintf(stderr, "[lr-snap]  spu=%X img=%d pc=0x%05X status=%u evmask=0x%X evstat=0x%X"
+                        " resv[v=%d ea=0x%08X diff=%d] atomic_stat=%u lr[n=%u src=%u line=0x%08X acks=%u]"
+                        " putllc[ok_ea=0x%08X fails=%u] getllar=%llu class=%s\n",
+                c->spu_id, c->image_id, (unsigned)(c->pc & 0x3FFFFu), (unsigned)c->status, mask, st,
+                v, ea, diff, c->atomic_stat, c->lr_raise_n, c->lr_last_src, c->lr_last_line, c->lr_ack_n,
+                c->lr_putllc_ok_ea, c->lr_putllc_fail_n, (unsigned long long)c->dbg_getllar, cls);
+        if (v && vm_base && ea) {
+            const uint8_t* m = vm_base + ea;
+            fprintf(stderr, "[lr-snap]   line 0x%08X:", ea);
+            for (int w = 0; w < 32; w++)
+                fprintf(stderr, " %02X%02X%02X%02X", m[4*w], m[4*w+1], m[4*w+2], m[4*w+3]);
+            fprintf(stderr, "\n");
+        }
+    }
+    fflush(stderr);
+}
+
