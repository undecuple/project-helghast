 /* ---- Phase 2: register-variable shifts/rotates ---- */
-static inline u128 spu_shl(u128 a, u128 b)   { u128 r; for(int i=0;i<4;i++){ uint32_t sh=b._u32[i]&0x3F; r._u32[i]=(sh>31)?0:(a._u32[i]<<sh); } return r; }
+#if defined(__SSE4_1__)
+#if defined(__AVX2__)
+#include <immintrin.h>
+#endif
+/* KZ3 patch 1131 (SPU pass 110): shl/rot/rotm/rotma with a per-lane count, without the per-lane store and vector reload
+ * (see spu_fi). x86 shifts by a count >= the lane width give 0 (logical) or the sign (arithmetic), which is the SPU
+ * result for counts 32..63, so no compare is needed: AVX2 shifts each lane by its own count, SSE4.1 shifts the vector
+ * by each lane's count and blends. Same values as the loops (spu__*_ref, tools/spu/test_r110_vec.sh). */
+static inline __m128i spu__vsh32(__m128i a, __m128i s, int op) {   /* op 0 sll, 1 srl, 2 sra; s per lane 0..63 */
+#if defined(__AVX2__)
+    return op == 0 ? _mm_sllv_epi32(a, s) : op == 1 ? _mm_srlv_epi32(a, s) : _mm_srav_epi32(a, s);
+#else
+    const __m128i c0 = _mm_cvtsi32_si128(_mm_cvtsi128_si32(s)), c1 = _mm_cvtsi32_si128(_mm_extract_epi32(s, 1));
+    const __m128i c2 = _mm_cvtsi32_si128(_mm_extract_epi32(s, 2)), c3 = _mm_cvtsi32_si128(_mm_extract_epi32(s, 3));
+    __m128i r0, r1, r2, r3;
+    if (op == 0) { r0 = _mm_sll_epi32(a, c0); r1 = _mm_sll_epi32(a, c1); r2 = _mm_sll_epi32(a, c2); r3 = _mm_sll_epi32(a, c3); }
+    else if (op == 1) { r0 = _mm_srl_epi32(a, c0); r1 = _mm_srl_epi32(a, c1); r2 = _mm_srl_epi32(a, c2); r3 = _mm_srl_epi32(a, c3); }
+    else { r0 = _mm_sra_epi32(a, c0); r1 = _mm_sra_epi32(a, c1); r2 = _mm_sra_epi32(a, c2); r3 = _mm_sra_epi32(a, c3); }
+    return _mm_blend_epi16(_mm_blend_epi16(r0, r1, 0x0C), _mm_blend_epi16(r2, r3, 0xC0), 0xF0);
+#endif
+}
+#define SPU__VSH_FN(name, body) static inline u128 name(u128 a, u128 b) { __m128i A, B, R; memcpy(&A, &a, 16); \
+    memcpy(&B, &b, 16); body; u128 r; memcpy(&r, &R, 16); return r; }
+#endif
+static inline u128 spu__shl_ref(u128 a, u128 b)   { u128 r; for(int i=0;i<4;i++){ uint32_t sh=b._u32[i]&0x3F; r._u32[i]=(sh>31)?0:(a._u32[i]<<sh); } return r; }
 static inline u128 spu_shlh(u128 a, u128 b)  { u128 r; for(int i=0;i<8;i++){ uint32_t sh=b._u16[i]&0x1F; r._u16[i]=(sh>15)?0:(uint16_t)(a._u16[i]<<sh); } return r; }
