+/* KZ3 patch 1131 (SPU pass 110): frest/frsqest without the per-lane store and vector reload (see spu_fi): exponent
+ * arithmetic on four lanes, the table entries fetched by index into a vector (no memory round trip of the result).
+ * Same values as the loops (spu__frest_ref / spu__frsqest_ref, tools/spu/test_r110_vec.sh: all 2^32 inputs). */
+#if defined(__SSE4_1__)
+SPU_HOT u128 spu_frsqest(u128 a) {
+    __m128i A; memcpy(&A, &a, 16);
+    const __m128i e = _mm_and_si128(_mm_srli_epi32(A, 23), _mm_set1_epi32(0xFF));
+    __m128i re = _mm_sub_epi32(_mm_set1_epi32(190), _mm_srli_epi32(_mm_add_epi32(e, _mm_set1_epi32(1)), 1));
+    re = _mm_blendv_epi8(re, _mm_set1_epi32(0xFF), _mm_cmpeq_epi32(e, _mm_setzero_si128()));
+    const __m128i fr = _mm_setr_epi32((int)spu_frsqest_fraction_lut[((uint32_t)_mm_cvtsi128_si32(A) >> 18) & 0x3F],
+                                      (int)spu_frsqest_fraction_lut[((uint32_t)_mm_extract_epi32(A, 1) >> 18) & 0x3F],
+                                      (int)spu_frsqest_fraction_lut[((uint32_t)_mm_extract_epi32(A, 2) >> 18) & 0x3F],
+                                      (int)spu_frsqest_fraction_lut[((uint32_t)_mm_extract_epi32(A, 3) >> 18) & 0x3F]);
+    const __m128i R = _mm_or_si128(_mm_slli_epi32(re, 23), _mm_and_si128(fr, _mm_set1_epi32(0x7FFFFF)));
+    u128 r; memcpy(&r, &R, 16); return r;
+}
+SPU_HOT u128 spu_frest(u128 a) {
+    __m128i A; memcpy(&A, &a, 16);
+    const __m128i sg = _mm_and_si128(A, _mm_set1_epi32((int)0x80000000u));
+    const __m128i e = _mm_and_si128(_mm_srli_epi32(A, 23), _mm_set1_epi32(0xFF));
+    const __m128i re = _mm_max_epi32(_mm_sub_epi32(_mm_set1_epi32(253), e), _mm_setzero_si128());   /* e >= 253 -> 0 */
+    const __m128i fr = _mm_setr_epi32((int)spu_frest_fraction_lut[((uint32_t)_mm_cvtsi128_si32(A) >> 18) & 0x1F],
+                                      (int)spu_frest_fraction_lut[((uint32_t)_mm_extract_epi32(A, 1) >> 18) & 0x1F],
+                                      (int)spu_frest_fraction_lut[((uint32_t)_mm_extract_epi32(A, 2) >> 18) & 0x1F],
+                                      (int)spu_frest_fraction_lut[((uint32_t)_mm_extract_epi32(A, 3) >> 18) & 0x1F]);
+    __m128i R = _mm_or_si128(sg, _mm_or_si128(_mm_slli_epi32(re, 23), _mm_and_si128(fr, _mm_set1_epi32(0x7FFFFF))));
+    R = _mm_blendv_epi8(R, _mm_or_si128(sg, _mm_set1_epi32(0x7FFFFFFF)), _mm_cmpeq_epi32(e, _mm_setzero_si128()));
+    u128 r; memcpy(&r, &R, 16); return r;
+}
+#else
+static inline u128 spu_frsqest(u128 a) { return spu__frsqest_ref(a); }
+static inline u128 spu_frest(u128 a) { return spu__frest_ref(a); }
+#endif
