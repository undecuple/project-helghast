KZ3 patch 2072 (RSX pass 68): frame-pacing metric, the RE notes "Pass 68".
Every successful Present records the interval since the previous one (QueryPerformanceCounter) into a fixed
0.25 ms histogram (to 250 ms + overflow) with a running sum and sum of squares (libs/video/rsx_pace.h, pure C, no
allocation, no lock, no printing on the hot path). Every 10 s of wall time one line is printed and the window reset:
  [pace] t=<ms since first present> n=<frames> p50=<ms> p99=<ms> max=<ms> sd=<ms> low1=<fps>
RSX_PACE=0 turns it off (default on).

--- a/libs/video/rsx_live_draw.c
+++ b/libs/video/rsx_live_draw.c
@@ -128,6 +128,7 @@
 #include "rsx_pso_async.h"
 /* patch 2048: asynchronous PSO build bookkeeping */
 #include "rsx_pso_template.h"   /* patch 2071 */
+#include "rsx_pace.h"           /* patch 2072 */
 #include <sys/stat.h>
 
 #pragma comment(lib, "d3d12.lib")
@@ -726,6 +727,21 @@
 
 static void ld_present_measure_record(u32 guest_frame)
 {
+    /* Patch 2072: per-present interval histogram, one [pace] line per 10 s; RSX_PACE=0 turns it off. */
+    {
+        static int s_pace_on = -1;
+        static rsx_pace s_pace;
+        if (s_pace_on < 0) {
+            const char* e = getenv("RSX_PACE");
+            s_pace_on = (e && *e == '0') ? 0 : 1;
+        }
+        if (s_pace_on) {
+            LARGE_INTEGER pc, pf;
+            QueryPerformanceCounter(&pc);
+            QueryPerformanceFrequency(&pf);
+            rsx_pace_frame(&s_pace, 1000.0 * (double)pc.QuadPart / (double)pf.QuadPart);
+        }
+    }
