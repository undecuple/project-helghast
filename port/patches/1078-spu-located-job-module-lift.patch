@@ -3118,8 +3177,11 @@ void spu_indirect_branch(spu_context* ctx)
         if (!ti && !ctx->resident_task) ti = spu_taskset_task_image(ctx->pc);
         if (ti) ctx->resident_task = ti;
     }
-    /* Use the same ownership order as the interpreter's rejoin probe. */
-    spu_fn fn = spu_lifted_lookup(ctx, ctx->pc);
+    /* Use the same ownership order as the interpreter's rejoin probe (upstream #420): bounded
+     * resident code (authoritative, a miss there stays a miss), task, overlay, primary image. */
+    spu_fn fn = (spu_fn)spu_lifted_lookup(ctx, ctx->pc);
+    if (!fn && !spu_resident_code_owner(ctx, ctx->pc))
+        fn = spu_lookup_located(ctx, ctx->pc);   /* KZ3 patch 1078 */
     /* The job returned through the link register we planted: it is finished.
