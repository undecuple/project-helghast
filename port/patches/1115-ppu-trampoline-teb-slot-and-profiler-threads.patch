KZ3 patch 1115 (SPU pass 100): (1) on MinGW the lifted PPU code reaches g_trampoline_fn (read after every lifted
call: 61k sites) through a pointer to its emulated-TLS storage cached in one TEB TLS slot, instead of a call to
__emutls_get_address; default off since SPU pass 101: -DPPU_TRAMP_TEB=1 builds it (then KZ3_TRAMP_TEB=0 = no slot). (2) profiler: KZ3_PROF_ALL=1 samples
every thread with a thread tag, KZ3_PROF_UNWIND=RVA,... records the caller of samples in those functions.
Notes the RE notes Pass 100.

--- a/tools/ppu_lifter.py
+++ b/tools/ppu_lifter.py
@@ -535,6 +535,38 @@
  * PPU_THREAD_LOCAL comes from ppu_recomp.h, included above. */
 extern "C" PPU_THREAD_LOCAL void (*g_trampoline_fn)(void*);
 
+/* KZ3 patch 1115 (SPU pass 100): on MinGW (emulated TLS: every g_trampoline_fn access was a call to
+ * __emutls_get_address, after every lifted call) the generated code reaches this thread's g_trampoline_fn
+ * through a pointer cached in one Windows TLS slot of the TEB (gs:[0x1480 + 8 * index]): two loads, no call.
+ * The storage stays the TLS variable itself, so runtime code that names it directly sees the same value
+ * (same per-thread semantics). A thread whose slot is still empty, or a process without the fast path
+ * (KZ3_TRAMP_TEB=0, no slot below 64, the self-check failed), takes ppu_tramp_ref_slow(), which returns
+ * &g_trampoline_fn and fills the slot. Default off (the old code); -DPPU_TRAMP_TEB=1 builds this path. */
+#ifndef PPU_TRAMP_TEB   /* SPU pass 101: default off (pass 100 A/B: no gain beyond noise); -DPPU_TRAMP_TEB=1 on */
+#  if defined(_WIN32) && defined(__GNUC__) && !defined(_MSC_VER) && defined(__x86_64__)
+#    define PPU_TRAMP_TEB 0
+#  else
+#    define PPU_TRAMP_TEB 0
+#  endif
+#endif
+#if PPU_TRAMP_TEB
+#ifndef PPU_TRAMP_GS_LOAD   /* the TEB read (a host test supplies an emulated TEB) */
+#  define PPU_TRAMP_GS_LOAD(o, p) __asm__("movq %%gs:(%1), %0" : "=r"(p) : "r"(o))
+#endif
+extern "C" unsigned g_ppu_tramp_slot;   /* TEB byte offset of the slot, 0 = no fast path */
+extern "C" void (**ppu_tramp_ref_slow(void))(void*);
+static inline __attribute__((always_inline)) void (**ppu_tramp_ref(void))(void*) {
+    const unsigned long long o = g_ppu_tramp_slot;
+    if (__builtin_expect(o != 0, 1)) {
+        void* p;
+        PPU_TRAMP_GS_LOAD(o, p);
+        if (__builtin_expect(p != 0, 1)) return (void (**)(void*))p;
+    }
+    return ppu_tramp_ref_slow();
+}
+#define g_trampoline_fn (*ppu_tramp_ref())
+#endif
+
 /* Drain pending trampolines after any call that might set g_trampoline_fn.
  * Converts cross-fragment fallthrough chains into iterative loops. */
 #define DRAIN_TRAMPOLINE(ctx) do { \\
--- a/runtime/ppu/ppu_loader.cpp
+++ b/runtime/ppu/ppu_loader.cpp
@@ -2131,6 +2131,51 @@
 /* Cross-fragment trampoline pointer (matches the lifted header's TLS decl). */
 extern "C" PPU_THREAD_LOCAL void (*g_trampoline_fn)(void*) = nullptr;
 
+/* KZ3 patch 1115 (SPU pass 100): the TEB-slot path to g_trampoline_fn the generated code takes on MinGW
+ * (PPU_TRAMP_TEB in the lifter's source preamble). The slot holds a pointer to this thread's g_trampoline_fn
+ * (its emulated-TLS storage), so both paths reach the same per-thread object. KZ3_TRAMP_TEB=0: no slot (every
+ * access comes here and returns &g_trampoline_fn, the old storage through one more call). */
+#if defined(_WIN32) && defined(__GNUC__) && !defined(_MSC_VER) && defined(__x86_64__)
+extern "C" unsigned g_ppu_tramp_slot = 0;
+static volatile long s_ppu_tramp_state = 0;   /* 0 undecided, 1 deciding, 2 decided */
+static DWORD s_ppu_tramp_idx = TLS_OUT_OF_INDEXES;
+extern "C" void (**ppu_tramp_ref_slow(void))(void*)
+{
+    void (**p)(void*) = &g_trampoline_fn;
+    if (s_ppu_tramp_state != 2) {
+        if (InterlockedCompareExchange(&s_ppu_tramp_state, 1, 0) == 0) {
+            const char* e = getenv("KZ3_TRAMP_TEB");
+            DWORD idx = (e && e[0] == '0') ? TLS_OUT_OF_INDEXES : TlsAlloc();
+            if (idx != TLS_OUT_OF_INDEXES && idx >= 64) { TlsFree(idx); idx = TLS_OUT_OF_INDEXES; }  /* expansion slots: no */
+            s_ppu_tramp_idx = idx;
+            fprintf(stderr, "[tramp] g_trampoline_fn via TEB slot: %s idx=%ld (KZ3 patch 1115)\n",
+                    idx == TLS_OUT_OF_INDEXES ? "off" : "on", idx == TLS_OUT_OF_INDEXES ? -1L : (long)idx);
+            InterlockedExchange(&s_ppu_tramp_state, 2);
+        } else {
+            while (s_ppu_tramp_state != 2) Sleep(0);
+        }
+    }
+    const DWORD idx = s_ppu_tramp_idx;
+    if (idx == TLS_OUT_OF_INDEXES) return p;
+    if (TlsGetValue(idx) != (void*)p) TlsSetValue(idx, (void*)p);
+    if (!g_ppu_tramp_slot) {
+        /* Self-check of the TEB layout (TlsSlots at 0x1480, also under Wine): the raw gs read must see what
+         * TlsSetValue stored, or the fast path stays off. */
+        const unsigned long long off = 0x1480ull + 8ull * idx;
+        void* q;
+        __asm__ __volatile__("movq %%gs:(%1), %0" : "=r"(q) : "r"(off));
+        if (q == (void*)p) g_ppu_tramp_slot = (unsigned)off;
+        else {
+            static volatile long warned = 0;
+            if (InterlockedExchange(&warned, 1) == 0)
+                fprintf(stderr, "[tramp] TEB self-check failed (gs:0x%llx = %p, want %p): fast path off\n", off, q, (void*)p);
+            s_ppu_tramp_idx = TLS_OUT_OF_INDEXES;
+        }
+    }
+    return p;
+}
+#endif
