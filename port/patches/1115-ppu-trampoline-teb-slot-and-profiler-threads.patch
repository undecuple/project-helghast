+/* patch 1115: the exe's function table entry for RVA (binary search, no locks) */
+static const RUNTIME_FUNCTION* pr_func(uint32_t rva)
+{
+    uint32_t lo = 0, hi = s_npdata;
+    while (lo < hi) {
+        uint32_t m = (lo + hi) / 2;
+        if (rva < s_pdata[m].BeginAddress) hi = m;
+        else if (rva >= s_pdata[m].EndAddress) lo = m + 1;
+        else return &s_pdata[m];
+    }
+    return 0;
+}
+static int pr_in_unw(uint32_t begin)
+{
+    for (int i = 0; i < s_nunw; i++) if (s_unw[i] == begin) return 1;
+    return 0;
+}
+/* patch 1115: the first frame outside the KZ3_PROF_UNWIND functions, as an absolute address (0 = none) */
+static uint64_t pr_caller(const CONTEXT* c0, uint64_t base, uint64_t size)
+{
+    if (!s_nunw || c0->Rip < base || c0->Rip >= base + size) return 0;
+    const RUNTIME_FUNCTION* f = pr_func((uint32_t)(c0->Rip - base));
+    if (!f || !pr_in_unw(f->BeginAddress)) return 0;
+    CONTEXT c = *c0;
+    for (int d = 0; d < 8; d++) {
+        void* hd = 0; DWORD64 est = 0;
+        RtlVirtualUnwind(UNW_FLAG_NHANDLER, (DWORD64)base, c.Rip, (PRUNTIME_FUNCTION)f, &c, &hd, &est, NULL);
+        if (c.Rip < base || c.Rip >= base + size) return c.Rip;
+        f = pr_func((uint32_t)(c.Rip - 1 - base));
+        if (!f || !pr_in_unw(f->BeginAddress)) return c.Rip;
+    }
+    return 0;
+}
