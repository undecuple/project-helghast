+    for (BOOL ok = Thread32First(sn, &te); ok && s_nxthr < PR_XTHR; ok = Thread32Next(sn, &te)) {
+        if (te.th32OwnerProcessID != pid || te.th32ThreadID == me) continue;
+        int known = 0;
+        long nt = s_nthr; if (nt > WA_THREADS) nt = WA_THREADS;
+        for (long i = 0; i < nt && !known; i++) if (s_thr[i] && s_thr[i]->hthr && s_thr[i]->ostid == te.th32ThreadID) known = 1;
+        for (int i = 0; i < s_nxthr && !known; i++) if (s_xthr[i].tid == te.th32ThreadID) known = 1;
+        if (known) continue;
+        HANDLE h = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_LIMITED_INFORMATION, FALSE, te.th32ThreadID);
+        if (!h) continue;
+        pr_xthr* x = &s_xthr[s_nxthr];
+        x->tid = te.th32ThreadID; x->h = h;
+        snprintf(x->name, sizeof x->name, "os%lu", x->tid);
+        const char* g = ppu_thread_name_for_os_tid(x->tid);
+        if (g && *g) snprintf(x->name, sizeof x->name, "os%lu ppu:%s", x->tid, g);
+        else if (gtd) {
+            PWSTR w = 0;
+            if (SUCCEEDED(gtd(h, &w)) && w) {
+                char a[32]; int n = WideCharToMultiByte(CP_UTF8, 0, w, -1, a, sizeof a, NULL, NULL);
+                if (n > 1) snprintf(x->name, sizeof x->name, "os%lu %s", x->tid, a);
+                LocalFree(w);
+            }
+        }
+        s_nxthr++;
+    }
+    CloseHandle(sn);
+}
