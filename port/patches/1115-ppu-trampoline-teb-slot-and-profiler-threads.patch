+    typedef HRESULT (WINAPI *gtd_t)(HANDLE, PWSTR*);
+    static gtd_t gtd = 0; static int gtd_done = 0;
+    if (!gtd_done) {
+        HMODULE k = GetModuleHandleA("kernelbase.dll"); if (!k) k = GetModuleHandleA("kernel32.dll");
+        if (k) gtd = (gtd_t)(void*)GetProcAddress(k, "GetThreadDescription");
+        gtd_done = 1;
+    }
