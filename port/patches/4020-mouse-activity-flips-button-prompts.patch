+/* Patch 4020: the mouse-activity rule (pure; pad_mouse.c holds one under its lock). A button (or the wheel) is activity
+ * at once; motion counts only when |dx|+|dy| summed over one PAD_MOUSE_ACT_WINDOW_MS window reaches
+ * PAD_MOUSE_ACT_COUNTS, so a bumped desk (a few counts) leaves the prompts alone. ASSUMPTION: 8 counts in 100 ms is a
+ * pick (a deliberate hand move is dozens of counts at 800 dpi; not measured). */
+#define PAD_MOUSE_ACT_COUNTS     8
+#define PAD_MOUSE_ACT_WINDOW_MS  100
+/* RAWMOUSE usButtonFlags: RI_MOUSE_BUTTON_1..5_DOWN (0x1 0x4 0x10 0x40 0x100), RI_MOUSE_WHEEL, RI_MOUSE_HWHEEL */
+#define PAD_MOUSE_ACT_BUTTON_MASK 0xD55
+typedef struct {
+    unsigned long long start_ms;   /* start of the current motion window */
+    long               sum;        /* |dx|+|dy| in it */
+    int                active;     /* activity since the last take */
+} PadMouseAct;
+static inline void pad_mouse_act_button(PadMouseAct* a) { a->active = 1; }
+static inline void pad_mouse_act_motion(PadMouseAct* a, int dx, int dy, unsigned long long now_ms)
+{
+    if (!dx && !dy) return;
+    if (!a->sum || now_ms - a->start_ms > PAD_MOUSE_ACT_WINDOW_MS) { a->start_ms = now_ms; a->sum = 0; }
+    a->sum += (dx < 0 ? -(long)dx : dx) + (dy < 0 ? -(long)dy : dy);
+    if (a->sum >= PAD_MOUSE_ACT_COUNTS) { a->active = 1; a->sum = 0; }
+}
+static inline int pad_mouse_act_take(PadMouseAct* a) { const int r = a->active; a->active = 0; return r; }
+
 /* The look accumulator (pure; pad_mouse.c holds one under its lock). frame = the guest frame counter now. */
 typedef struct {
     long long dx, dy;      /* counts kept for the next take */
@@ -399,6 +422,12 @@
 int  pad_mouse_menu_take(void* evs /* PadMenuMouseEv[max] */, int max);
 void pad_mouse_menu_script_step(double now);

+/* Patch 4020 (RSX pass 98): raw mouse input as keyboard+mouse activity for the button prompts (cellPad.c
+ * pad_prompt_track). pad_mouse.c's WM_INPUT feeds every raw mouse report in; pad_mouse_activity_take returns 1 once
+ * when a button or enough motion arrived since the last call (the prompts then follow the keyboard+mouse). Needs the
+ * raw input registration that mouse look makes (KZ3_MOUSE_LOOK=0: no raw input, no mouse activity). */
+int pad_mouse_activity_take(void);
+
