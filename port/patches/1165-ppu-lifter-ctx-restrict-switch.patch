--- a/tools/ppu_lifter.py
+++ b/tools/ppu_lifter.py
@@ -358,6 +358,22 @@
 
 """
 
+# KZ3 patch 1165 (after project-vekta patch 3030): KZ3_PPU_CTX_RESTRICT=1 at lift time qualifies each lifted function's ctx
+# parameter PPU_CTX_RESTRICT, and the header defines that as __restrict unless the build defines it (e.g. empty). Off (the
+# default): no qualifier and no header text, the lift is byte-identical to a lift without this patch.
+_CTX_RESTRICT = os.environ.get("KZ3_PPU_CTX_RESTRICT", "") == "1"
+if _CTX_RESTRICT:
+    HEADER_PREAMBLE += """
+/* PPU_CTX_RESTRICT: the qualifier on each lifted function's ctx parameter (KZ3 patch 1165, after project-vekta patch
+ * 3030). The lifted code reaches guest memory through a byte pointer and builds with -fno-strict-aliasing, so without it
+ * the compiler must assume any guest store may have changed ctx->fpr, ctx->vr, ctx->lr and the rest, and reloads them after
+ * each one. Nothing else reaches a context while its function runs: contexts live on host thread stacks, never in guest
+ * memory, and a callee is handed ctx itself. Define it empty at build time to undo it without a relift. */
+#ifndef PPU_CTX_RESTRICT
+#  define PPU_CTX_RESTRICT __restrict
+#endif
+"""
+
 SOURCE_PREAMBLE = """\
 /* Auto-generated by ppu_lifter.py -- do not edit by hand. */
 #include "ppu_recomp.h"
@@ -4324,7 +4340,9 @@
             defname = func.name + "__ljbody"
             weak_body, weak = weak, ""
             lines.append(f"static void {defname}(ppu_context* ctx);")
-        lines.append(f"{'static ' if is_lj else ''}void {weak}{defname}(ppu_context* ctx) {{")
+        # KZ3 patch 1165: not on setjmp/longjmp functions (control re-enters them through the host jump).
+        qual = "PPU_CTX_RESTRICT " if _CTX_RESTRICT and not (uses_sj or is_lj) else ""
+        lines.append(f"{'static ' if is_lj else ''}void {weak}{defname}(ppu_context* {qual}ctx) {{")
         lines.append("    PPU_MM_SNAP")
         for bline in _fuse_cr(func.body_lines):
             lines.append(f"    {bline}" if not bline.endswith(":") else bline)
