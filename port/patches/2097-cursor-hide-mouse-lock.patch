+/* KZ3 patch 2097 (RSX pass 92), ENHANCEMENT: cursor hiding and mouse lock. Pure decision; pad_mouse.c applies it on
+ * the window's thread (WM_SETCURSOR -> SetCursor(NULL) on the client area, ClipCursor to the client rect).
+ *   hide: the game window has the focus, is not minimised, no title-bar drag/resize or system menu is running, the
+ *         window is not closing, and the cursor is over the client area (borderless/fullscreen: the whole window is
+ *         client). Display improvement: on even with mouse look off (KZ3_CURSOR_HIDE=0 keeps the arrow).
+ *   clip: the same conditions (minus the cursor position) and mouse look on. With mouse look off nothing reads the
+ *         mouse, so the pointer stays free to leave the window.
+ * Modes use rsx_display_mode.h's numbers (0 windowed, 1 borderless, 2 fullscreen). */
+typedef struct {
+    int mode;        /* 0 windowed, 1 borderless, 2 exclusive fullscreen */
+    int focused;     /* window active and has the keyboard focus */
+    int minimized;
+    int sizemove;    /* WM_ENTERSIZEMOVE..WM_EXITSIZEMOVE or a menu loop (title-bar drag, frame resize, Alt+Space) */
+    int closing;     /* WM_CLOSE / WM_DESTROY seen */
+    int look_on;     /* KZ3_MOUSE_LOOK */
+    int hide_opt;    /* KZ3_CURSOR_HIDE (1 default) */
+} PadCursorState;
+
+typedef struct { int hide, clip; } PadCursorDo;
+
+/* over_client: the cursor is over the client area (WM_SETCURSOR's HTCLIENT); ignored outside windowed mode. */
+static inline PadCursorDo pad_cursor_decide(const PadCursorState* s, int over_client)
+{
+    PadCursorDo d = {0, 0};
+    const int live = s->focused && !s->minimized && !s->sizemove && !s->closing;
+    d.hide = live && s->hide_opt && (s->mode != 0 || over_client);
+    d.clip = live && s->look_on;
+    return d;
+}
+
