+/* ---- KZ3 patch 4030 (network pass 16): motion sections with the keyboard and mouse (pad_assist.h) ----
+ * The game's valve and charge controllers read the right stick's absolute angle while the grab action is held (profile
+ * byte 0xB6 = 0, which the port forces on a pad without gyro). The mouse only fed the camera and the keys are digital,
+ * so a keyboard player had no gesture. While a human controller is in one of those sections (the post-hooks below
+ * stamp it every update), the mouse drives a virtual right stick and Mouse1 presses the button the game's own action
+ * table gives GrabRightHand. Default on (an input mapping, not a gameplay change); KZ3_MOUSE_STICK=0 turns it off. */
+static PasState s_pas;
+static int pas_mstick_enabled(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("KZ3_MOUSE_STICK"); v = !(e && (!strcmp(e, "0") || !strcmp(e, "off") || !strcmp(e, "no"))); }
+    return v;
+}
+/* The pad button (a hs->buttons bit) the game's action table gives GrabRightHand now; 0 when the table is unknown. */
+static unsigned pas_grab_mask(void)
+{
+    static int ver = -2;
+    uint32_t prof;
+    int32_t eb;
+    if (ver == -2) ver = pab_detect(pab_rd32);
+    if (ver < 0) return 0;
+    prof = vm_read32(pab_versions[ver].profile_ptr);
+    if (!prof || prof >= 0x40000000u) return 0;
+    eb = (int32_t)vm_read32(prof + PAB_OFF_TABLE + 4u * (uint32_t)PAB_A_GRABRIGHT);
+    return eb >= 0 && eb < 16 ? 1u << pab_eb_to_bit[eb] : 0;
+}
+/* Test input (like KZ3_KB_SCRIPT, the same clock: seconds since the first cellPadGetData): KZ3_MOUSE_STICK_FEED="T:dx,dy*SECONDS ..."
+ * feeds dx,dy counts PER SECOND for SECONDS from T into the virtual stick only (KZ3_MOUSE_FEED, the look feed, starts at the
+ * first look take and runs on another clock, which cannot be lined up with a pad script's grab presses). */
+static int pas_test_feed(int* dx, int* dy)
+{
+    static PadMouseEv ev[PAD_MOUSE_SCRIPT_MAX];
+    static long long sx[PAD_MOUSE_SCRIPT_MAX], sy[PAD_MOUSE_SCRIPT_MAX];
+    static int n = -1;
+    double el;
+    int i;
+    if (n < 0) {
+        const char* e = getenv("KZ3_MOUSE_STICK_FEED");
+        int bad = 0;
+        n = e && *e ? pad_mouse_script_parse(e, ev, PAD_MOUSE_SCRIPT_MAX, &bad) : 0;
+        if (e && *e) { printf("[mousestick] KZ3_MOUSE_STICK_FEED: %d event(s), %d unreadable\n", n, bad); fflush(stdout); }
+    }
+    if (n <= 0 || !s_pad_t0_ms) return 0;
+    el = pad_clock(s_pad_t0_ms);
+    for (i = 0; i < n; i++) {
+        const long long ox = pad_mouse_feed_owed(ev[i].dx, ev[i].t, ev[i].left, el), oy = pad_mouse_feed_owed(ev[i].dy, ev[i].t, ev[i].left, el);
+        *dx += (int)(ox - sx[i]); *dy += (int)(oy - sy[i]);
+        sx[i] = ox; sy[i] = oy;
+    }
+    return 1;
+}
+static void pad_assist_poll(CellPadData* data)
+{
+    const unsigned long long now = pad_now_ms();
+    const int vl = pas_valve_live(&s_pas, now), cl = pas_charge_live(&s_pas, now), live = vl || cl;
+    int dx = 0, dy = 0;
+    uint8_t bx, by;
+    if (!pas_mstick_enabled()) return;
+    pad_mouse_stick_take(&dx, &dy);
+    pas_test_feed(&dx, &dy);
+    if (!live) {
+        if (s_pas.mstick_on) { s_pas.mstick_on = 0; memset(&s_pas.stick, 0, sizeof s_pas.stick); printf("[mousestick] section off\n"); fflush(stdout); }
+        return;
+    }
+    if (!s_pas.mstick_on) {
+        s_pas.mstick_on = 1;
+        memset(&s_pas.stick, 0, sizeof s_pas.stick);
+        printf("[mousestick] section on (%s): the mouse is the right stick, Mouse1 holds the grab (action button mask 0x%04X)\n",
+               vl ? "valve" : "charge", pas_grab_mask());
+        fflush(stdout);
+    }
+    pas_stick_add(&s_pas.stick, dx, dy);
+    {
+        const int rx = data->button[CELL_PAD_BTN_OFFSET_ANALOG_RIGHT_X], ry = data->button[CELL_PAD_BTN_OFFSET_ANALOG_RIGHT_Y];
+        /* a real stick or the right-stick keys win: the virtual one only fills an idle stick */
+        if (pas_stick_bytes(&s_pas.stick, &bx, &by) && abs(rx - 128) <= 8 && abs(ry - 128) <= 8) {
+            data->button[CELL_PAD_BTN_OFFSET_ANALOG_RIGHT_X] = bx;
+            data->button[CELL_PAD_BTN_OFFSET_ANALOG_RIGHT_Y] = by;
+        }
+    }
+    if (pad_assist_mouse1()) {
+        const unsigned m = pas_grab_mask();
+        data->button[CELL_PAD_BTN_OFFSET_DIGITAL1] |= (u16)(m & 0xFF);
+        data->button[CELL_PAD_BTN_OFFSET_DIGITAL2] |= (u16)((m >> 8) & 0xFF);
+    }
+}
+/* The hooks (port/spu kz3_gameplay.h KZ3_HOOK_VALVE_ASSIST / KZ3_HOOK_CHARGE_ASSIST, post-hooks on 1.14 0x61AEB4 and
+ * 0x6126E4): vm = vm_base, ctrl = the controller (r3 on entry). They mark the section the pad layer above reads. */
+int pad_assist_valve_post(uint8_t* vm, uint32_t ctrl) { PasView v; return pas_valve_mark(&s_pas, vm, ctrl, pad_now_ms(), &v); }
+int pad_assist_charge_post(uint8_t* vm, uint32_t ctrl) { PasView v; return pas_charge_mark(&s_pas, vm, ctrl, pad_now_ms(), &v); }
+
