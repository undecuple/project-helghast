+/* Patch 4030: the counts for the virtual right stick of the motion sections (pad_assist.h). A separate sum that
+ * nobody else takes from, so the look code and the stick never compete; the pad layer empties it every poll. */
+static long s_stk_dx, s_stk_dy;
+void pad_mouse_stick_take(int* dx, int* dy)
+{
+    PM_LOCK();
+    *dx = (int)s_stk_dx; *dy = (int)s_stk_dy;
+    s_stk_dx = s_stk_dy = 0;
+    PM_UNLOCK();
+}
+
 void pad_mouse_add(int dx, int dy)
 {
     const unsigned f = s_frame_clock();
     unsigned long long (*clk)(void) = s_time_clock;
     const unsigned long long tb = clk ? clk() : 0;   /* patch 2108: arrival time */
     PM_LOCK();
+    s_stk_dx += dx; s_stk_dy += dy;
+    if (s_stk_dx > 100000) s_stk_dx = 100000; else if (s_stk_dx < -100000) s_stk_dx = -100000;
+    if (s_stk_dy > 100000) s_stk_dy = 100000; else if (s_stk_dy < -100000) s_stk_dy = -100000;
     if (clk) pad_look_acc_add_at(&s_acc, dx, dy, f, tb);
     else pad_look_acc_add(&s_acc, dx, dy, f);
     PM_UNLOCK();
