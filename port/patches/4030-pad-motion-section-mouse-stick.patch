+/* Patch 4030: the counts for the virtual right stick of the motion sections (pad_assist.h). A separate sum that
+ * nobody else takes from, so the look code and the stick never compete; the pad layer empties it every poll. */
+static long s_stk_dx, s_stk_dy;
+void pad_mouse_stick_take(int* dx, int* dy)
+{
