--- /dev/null
+++ b/libs/input/pad_assist.h
@@ -0,0 +1,188 @@
+/* pad_assist.h -- KZ3 patch 4030 (network pass 16). Platform-free logic for the motion sections (valve, charge) with the
+ * keyboard and mouse. Included by cellPad.c; the host test tools/smoke/test_motion_assist.c includes it too (through
+ * pad_assist_drive.h, patch 4031), over a fake guest memory, so nothing here may touch a Windows or ps3recomp symbol.
+ *
+ * Root fix, default on (an input mapping, not a gameplay change): while a human controller updates a Valve or an
+ * ExplosiveLocation, the mouse drives a virtual RIGHT stick (the stick the original code reads when profile byte 0xB6
+ * is 0, which the port forces on a pad without gyro, kz3_sixaxis_filter) and Mouse1 holds the grab action.
+ * Post-hooks (port/spu, ppu_overrides): ValveJoystickController::Update 0x61AEB4 (1.00 0x606884) and the charge
+ * target function 0x6126E4 (1.00 0x5FE0B4) only MARK the section here; the original code then reads the stick.
+ *
+ * Guest layout (big-endian; offsets read from the 1.00 code, 1.14 = +0x14630 for the functions; fields ASSUMPTION
+ * unchanged in 1.14): controller +0x20 entity, +0x108 target hand angle (f32 rad), valve +0x10C/+0x110 grab gains
+ * (0.0 = held, 1.0 = released), charge +0x114 grab byte, +0x118 follower previous; entity +0xE4 resource, valve entity
+ * +0x288 valve angle, +0x290 hand angle (rad); ValveResource +0x18C Min, +0x190 Max, +0x198 MinHand, +0x19C MaxHand
+ * (degrees), +0x1A0 speed (deg/s), +0x1A8 DisableValue; ExplosiveLocationResource +0x190/+0x194 Min/MaxAngle (deg),
+ * +0x198 speed (deg/s), +0x200 ArmRanges (ptr, count; ASSUMPTION), +0x20C ArmStepTime. */
+#ifndef PAD_ASSIST_H
+#define PAD_ASSIST_H
+
+#include <math.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#define PAS_SECTION_MS  250u     /* a section stamp is live this long (hooks run every update, ~33 ms) */
+#define PAS_STICK_GAIN  0.01f    /* virtual stick units per mouse count: 100 counts = full travel */
+#define PAS_STICK_ON    0.25f    /* below this the virtual stick rests (the game's own dead zone is 0.29 after) */
+#define PAS_DEADZONE    0.29f    /* the valve's stick read: radial dead zone (the RE notes s.14.2) */
+#define PAS_MIN_MAG2    0.25f    /* and its own test: x*x + y*y >= 0.25 after the response curve */
+#define PAS_DEG2RAD     0.017453292519943295f
+#define PAS_MAXWIN 4
+
+/* ---- mouse -> right stick ---- */
+typedef struct { float x, y; } PasStick;   /* y positive = down on screen = stick down (byte > 128) */
+static inline void pas_stick_add(PasStick* s, int dx, int dy)
+{
+    float m;
+    s->x += (float)dx * PAS_STICK_GAIN;
+    s->y += (float)dy * PAS_STICK_GAIN;
+    m = sqrtf(s->x * s->x + s->y * s->y);
+    if (m > 1.0f) { s->x /= m; s->y /= m; }
+}
+/* Full travel in the pointed direction above PAS_STICK_ON, else centred: the valve reads an absolute angle, and the
+ * stick magnitude must clear 0.5 after its dead zone, so the magnitude is 1. */
+static inline int pas_stick_bytes(const PasStick* s, uint8_t* bx, uint8_t* by)
+{
+    const float m = sqrtf(s->x * s->x + s->y * s->y);
+    int x, y;
+    if (!(m >= PAS_STICK_ON)) { *bx = *by = 128; return 0; }
+    x = 128 + (int)lroundf(s->x / m * 127.0f);
+    y = 128 + (int)lroundf(s->y / m * 127.0f);
+    *bx = (uint8_t)(x < 0 ? 0 : x > 255 ? 255 : x);
+    *by = (uint8_t)(y < 0 ? 0 : y > 255 ? 255 : y);
+    return 1;
+}
+/* The valve's stick read as the port models it (ASSUMPTION: bytes -> -1..1 by /127, radial dead zone 0.29 rescaled to
+ * 0..1; the real response goes through the look curve 0x4DD198, monotone). Returns 1 when the controller would take
+ * the stick (x*x + y*y >= 0.25) and the angle atan2(x, y) in *ang (0 = up). */
+static inline int pas_game_stick(uint8_t bx, uint8_t by, float* ang)
+{
+    float x = ((float)bx - 128.0f) / 127.0f, y = ((float)by - 128.0f) / 127.0f, m;
+    if (x < -1.0f) x = -1.0f;
+    if (y < -1.0f) y = -1.0f;
+    m = sqrtf(x * x + y * y);
+    if (m <= PAS_DEADZONE) return 0;
+    { const float k = (m - PAS_DEADZONE) / (1.0f - PAS_DEADZONE) / m; x *= k; y *= k; }
+    if (x * x + y * y < PAS_MIN_MAG2) return 0;
+    if (ang) *ang = atan2f(x, -y);   /* stick up is byte 0 = y negative: the angle is measured from up */
+    return 1;
+}
+
+/* ---- guest memory (big-endian) over a host pointer ---- */
+static inline int pas_ptr_ok(uint32_t ea) { return ea >= 0x10000u && ea < 0xF0000000u && !(ea & 3u); }
+static inline uint32_t pas_r32(const uint8_t* vm, uint32_t ea)
+{
+    return ((uint32_t)vm[ea] << 24) | ((uint32_t)vm[ea + 1] << 16) | ((uint32_t)vm[ea + 2] << 8) | vm[ea + 3];
+}
+static inline float pas_rf(const uint8_t* vm, uint32_t ea)
+{
+    const uint32_t u = pas_r32(vm, ea);
+    float f;
+    memcpy(&f, &u, 4);
+    return f;
+}
+static inline void pas_wf(uint8_t* vm, uint32_t ea, float f)
+{
+    uint32_t u;
+    memcpy(&u, &f, 4);
+    vm[ea] = (uint8_t)(u >> 24); vm[ea + 1] = (uint8_t)(u >> 16); vm[ea + 2] = (uint8_t)(u >> 8); vm[ea + 3] = (uint8_t)u;
+}
+
+/* ---- the state the pad layer and the hooks share ---- */
+typedef struct {
+    PasStick stick;
+    unsigned long long valve_ms, charge_ms;   /* last hook call per section (0 = never) */
+    int mstick_on;                     /* 1 while the virtual stick is live (log edge) */
+    uint32_t valve_ent, chg_ent;       /* the entity of the last section line */
+    float v_logn;                      /* valve position at the last progress line */
+} PasState;
+
+static inline int pas_valve_live(const PasState* st, unsigned long long now)
+{
+    return st->valve_ms && now - st->valve_ms <= PAS_SECTION_MS;
+}
+static inline int pas_charge_live(const PasState* st, unsigned long long now)
+{
+    return st->charge_ms && now - st->charge_ms <= PAS_SECTION_MS;
+}
+
+/* What the hooks read from the guest (all range-checked: a value the game never wrote must not walk off the guest). */
+typedef struct {
+    uint32_t ent, res;
+    float ang, hand, n, dis, lo, hi;              /* valve: angle, hand angle (rad), position 0..1, DisableValue, hand limits (rad) */
+    int nwin;                                      /* charge */
+    float cen[PAS_MAXWIN], amn, amx, spd, step;
+    int fresh;                                     /* first sight of this entity: the section line was logged */
+} PasView;
+
+/* Post-hook of ValveJoystickController::Update (this = ctrl): stamps the section, fills *v, logs the section once per
+ * entity. Returns 1 when *v is usable. */
+static inline int pas_valve_mark(PasState* st, const uint8_t* vm, uint32_t ctrl, unsigned long long now, PasView* v)
+{
+    float mn, mx;
+    st->valve_ms = now ? now : 1;
+    if (!pas_ptr_ok(ctrl) || ctrl > 0x3FFFE000u) return 0;
+    v->ent = pas_r32(vm, ctrl + 0x20);
+    if (!pas_ptr_ok(v->ent) || v->ent > 0x3FFFE000u) return 0;
+    v->res = pas_r32(vm, v->ent + 0xE4);
+    if (!pas_ptr_ok(v->res) || v->res > 0x3FFFE000u) return 0;
+    v->ang = pas_rf(vm, v->ent + 0x288);
+    v->hand = pas_rf(vm, v->ent + 0x290);
+    mn = pas_rf(vm, v->res + 0x18C);
+    mx = pas_rf(vm, v->res + 0x190);
+    v->lo = pas_rf(vm, v->res + 0x198) * PAS_DEG2RAD;
+    v->hi = pas_rf(vm, v->res + 0x19C) * PAS_DEG2RAD;
+    v->dis = pas_rf(vm, v->res + 0x1A8);
+    if (!isfinite(v->ang) || !isfinite(mn) || !isfinite(mx) || !(mx > mn)) return 0;
+    v->n = (v->ang - mn * PAS_DEG2RAD) / ((mx - mn) * PAS_DEG2RAD);
+    v->fresh = st->valve_ent != v->ent;
+    if (v->fresh) {
+        st->valve_ent = v->ent;
+        printf("[assist] valve section: entity=0x%08X n=%.3f disable=%.3f dir=%+d handlimit=%.1f/%.1f\n", v->ent, (double)v->n,
+               (double)v->dis, v->dis > v->n ? 1 : -1, (double)(v->lo / PAS_DEG2RAD), (double)(v->hi / PAS_DEG2RAD));
+        st->v_logn = v->n;
+    } else if (fabsf(v->n - st->v_logn) >= 0.05f) {   /* progress: the valve position moved by 5 % of its travel */
+        printf("[assist] valve n=%.3f hand=%.3f grab=%.1f\n", (double)v->n, (double)v->hand, (double)pas_rf(vm, ctrl + 0x10C));
+        st->v_logn = v->n;
+    }
+    return 1;
+}
+
+/* Post-hook of the charge target function (this = ctrl): runs only while the soldier places a charge (the function
+ * itself returns at once when [ctrl+0x24] & 8, so does this). Reads the arm windows of the resource. */
+static inline int pas_charge_mark(PasState* st, const uint8_t* vm, uint32_t ctrl, unsigned long long now, PasView* v)
+{
+    uint32_t arr;
+    int i, cnt;
+    if (!pas_ptr_ok(ctrl) || ctrl > 0x3FFFE000u) return 0;
+    if (pas_r32(vm, ctrl + 0x24) & 8u) return 0;
+    st->charge_ms = now ? now : 1;
+    v->ent = pas_r32(vm, ctrl + 0x20);
+    if (!pas_ptr_ok(v->ent) || v->ent > 0x3FFFE000u) return 0;
+    v->res = pas_r32(vm, v->ent + 0xE4);
+    if (!pas_ptr_ok(v->res) || v->res > 0x3FFFE000u) return 0;
+    v->amn = pas_rf(vm, v->res + 0x190) * PAS_DEG2RAD;
+    v->amx = pas_rf(vm, v->res + 0x194) * PAS_DEG2RAD;
+    v->spd = pas_rf(vm, v->res + 0x198) * PAS_DEG2RAD;
+    arr = pas_r32(vm, v->res + 0x200);
+    cnt = (int)pas_r32(vm, v->res + 0x204);
+    v->step = pas_rf(vm, v->res + 0x20C);
+    v->nwin = 0;
+    if (cnt >= 1 && cnt <= PAS_MAXWIN && pas_ptr_ok(arr) && arr < 0x3FFFE000u)
+        for (i = 0; i < cnt; i++) {
+            const float a = pas_rf(vm, arr + 8u * (uint32_t)i), b = pas_rf(vm, arr + 8u * (uint32_t)i + 4u);
+            if (isfinite(a) && isfinite(b) && b >= a) v->cen[v->nwin++] = 0.5f * (a + b);
+        }
+    v->fresh = st->chg_ent != v->ent;
+    if (v->fresh) {
+        st->chg_ent = v->ent;
+        printf("[assist] charge section: entity=0x%08X windows=%d centres=%.4f/%.4f angle=%.1f..%.1f speed=%.0f step=%.2f\n", v->ent,
+               v->nwin, v->nwin > 0 ? (double)v->cen[0] : 0.0, v->nwin > 1 ? (double)v->cen[1] : 0.0, (double)(v->amn / PAS_DEG2RAD),
+               (double)(v->amx / PAS_DEG2RAD), (double)(v->spd / PAS_DEG2RAD), (double)v->step);
+    }
+    return 1;
+}
+
+#endif
diff --git a/libs/input/pad_mouse.c b/libs/input/pad_mouse.c
index 921e85e..2d21624 100644
--- a/libs/input/pad_mouse.c
