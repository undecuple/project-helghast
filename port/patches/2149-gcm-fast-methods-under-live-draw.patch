KZ3 patch 2149 (RSX pass 138): GCM_FAST_METHODS, method-loop fast path under live draw. Default off.

gcm_word_diag() is split into gcm_word_diag_only() (the GCM_* diagnostic switches, which keep the per-word path) and
gcm_word_live() (live draw / draw engine). Before, any live consumer forced the per-word loop with a gcm_io2ea() translation
and a dozen checks per data word, so the contiguous-page run path never ran in this port. With GCM_FAST_METHODS=1 and no
diagnostic switch, a method header whose data words lie in one 1 MB IO page (subchannel 0, or 1 outside the NV0039 methods,
method != 0, not a sampled RSX_PERF_X command) translates once and loops over the words: live feed, draw engine, driver
methods (0xEB00/0xEB04, 0xE920/0xE924), then gcm_3d_method, per word and in the order of the per-word loop. Other commands
take the old loop. Host test: tools/smoke/test_gcm_fast_methods.sh (synthetic ring with increment and non-increment
headers, identical call streams with the switch off and on).


diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -2823,13 +2823,32 @@
  * drain: the walker hands every data word through these checks, a million a
  * second in God of War HD gameplay, and it used to test each switch on its
  * own for every word. */
-static int gcm_word_diag(void)
+/* Patch 2149 splits it in two: the diagnostic switches (they log or count per word and keep the per-word path) and the
+ * live consumers (live draw, draw engine: they take every word, but need no per-word checks). */
+static int gcm_word_diag_only(void)
 {
     static int on = -1;
     if (on < 0)
         on = (getenv("GCM_SUBCH7") || getenv("GCM_OBJDBG") || getenv("GCM_SUBCH_GATE") || getenv("GCM_WORD_STATS") ||
-              getenv("GCM_VAL_WATCH") || getenv("GCM_METHOD_HIST") || getenv("RSX_LIVE_FEED_DBG") ||
-              rsx_live_draw_enabled() || rsx_draw_engine_enabled()) ? 1 : 0;
+              getenv("GCM_VAL_WATCH") || getenv("GCM_METHOD_HIST") || getenv("RSX_LIVE_FEED_DBG")) ? 1 : 0;
+    return on;
+}
+static int gcm_word_live(void)
+{
+    static int on = -1;
+    if (on < 0) on = (rsx_live_draw_enabled() || rsx_draw_engine_enabled()) ? 1 : 0;
+    return on;
+}
+static int gcm_word_diag(void)
+{
+    return gcm_word_diag_only() || gcm_word_live();
+}
+/* GCM_FAST_METHODS=1 (default off): a method header whose data words lie in one 1 MB IO page is walked with one address
+ * translation and a plain word loop, also under live draw, as long as no diagnostic switch is set. */
+static int gcm_fast_methods(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("GCM_FAST_METHODS"); on = e && *e ? atoi(e) != 0 : 0; }
     return on;
 }
 
@@ -2912,6 +2931,7 @@
