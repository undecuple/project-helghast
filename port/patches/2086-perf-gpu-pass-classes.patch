+/* Patch 2086 (KZ3 RSX pass 83): per-pass-class GPU time, one summary line per second.
+ *
+ * RSX_PERF_GPUPASS=1 turns on patch 2052's GPU timestamps (one stamp after every draw, resolved into a readback
+ * ring) and adds `[perf-gpupass]` once per second: GPU ms per frame by pass class, the top render-target sets and
+ * the top PSOs of that second. This header holds the pure parts (the class rule, the top-N pick) so a host test can
+ * check them without D3D12 (tools/smoke/test_gpupass.sh).
+ *
+ * Classes (ASSUMPTION: a heuristic from the K4 pass table of RSX pass 55, not a guest-side pass id):
+ *   shadow  depth target is Z16, or colour writes are off and render target 0 is square (the 1024x1024 cascades)
+ *   zpre    colour writes off with a depth target (depth pre-pass draws, e.g. the position-only PSO in the scene)
+ *   gbuf    colour on, 2 or more render targets (the 1280x720 G-buffer MRT pass)
+ *   post    colour on, one render target (lighting, half-res, blur, HUD, post)
+ * Colour off = COLOR_MASK has no nonzero byte (the live renderer's rule: any nonzero byte = channel on) and no MRT
+ * slot 1-3 has a COLOR_MASK_MRT nibble set (callers pass the MRT mask already cut to the bound count). */
+#ifndef RSX_GPUPASS_H
+#define RSX_GPUPASS_H
+
+enum { RSX_GP_SHADOW, RSX_GP_ZPRE, RSX_GP_GBUF, RSX_GP_POST, RSX_GP_CLASSES };
+
+static const char* const rsx_gp_class_name[RSX_GP_CLASSES] = {"shadow", "zpre", "gbuf", "post"};
+
+/* zfmt: 1 = Z16, 2 = Z24S8 (CELL_GCM_SURFACE_Z16/Z24S8), 0 = unknown (the main zeta). */
+static inline unsigned rsx_gp_class(unsigned n_mrt, unsigned rt0_w, unsigned rt0_h, int has_zeta, unsigned zfmt,
+                                    unsigned color_mask, unsigned color_mask_mrt)
+{
+    const int colour_off = color_mask == 0u && (n_mrt < 2u || (color_mask_mrt & 0xFFF0u) == 0u);
+    if (has_zeta && (zfmt == 1u || (colour_off && rt0_w == rt0_h && rt0_w >= 256u))) return RSX_GP_SHADOW;
+    if (colour_off && has_zeta) return RSX_GP_ZPRE;
+    if (n_mrt >= 2u) return RSX_GP_GBUF;
+    return RSX_GP_POST;
+}
+
+/* Indices of the k largest positive values of v[0..n) in descending order (ties: lower index first); returns how
+ * many were found (<= k). O(n*k), k is small. */
+static inline unsigned rsx_gp_topn(const double* v, unsigned n, unsigned k, unsigned* out)
+{
+    unsigned got = 0;
+    for (unsigned r = 0; r < k; r++) {
+        int bi = -1; double bm = 0.0;
+        for (unsigned i = 0; i < n; i++) {
+            if (!(v[i] > bm)) continue;
+            int taken = 0;
+            for (unsigned j = 0; j < got; j++) if (out[j] == i) { taken = 1; break; }
+            if (!taken) { bm = v[i]; bi = (int)i; }
+        }
+        if (bi < 0) break;
+        out[got++] = (unsigned)bi;
+    }
+    return got;
+}
+
+#endif
