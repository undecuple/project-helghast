-        "        halves[id.xy] = float2(f16tof32((b.y << 8) | b.z), f16tof32((b.w << 8) | b.x));\n"
+        "        halves[id.xy] = float2(f16tof32((b.w << 8) | b.x), f16tof32((b.y << 8) | b.z));\n"
         "    }\n"
         "}\n";
