diff --git a/runtime/spu/spu_fpmode.h b/runtime/spu/spu_fpmode.h
new file mode 100644
index 00000000..c7114e36
--- /dev/null
+++ b/runtime/spu/spu_fpmode.h
@@ -0,0 +1,44 @@
+/* KZ3 patch 1095 (SPU pass 70): the SPU's single-precision denormal rule for host threads that run SPU code.
+ *
+ * SPU ISA v1.2 s.9.1 (p.195): "Denorms are not supported and are treated as zero. Thus, an operation that would
+ * generate a denorm under IEEE rules instead generates a positive zero. If a denorm is used as an operand, it is
+ * treated as a zero." The SPU helpers use the host's SSE ops under the thread's MXCSR, which stayed at the default
+ * (IEEE gradual underflow): results differed from the SPU (a denormal where the SPU gives 0) and every SSE op with
+ * a denormal operand or result took a microcode assist (26.5 vs 1.5 ns per dependent mul+add pair on an
+ * i7-12700KF, SPU pass 70). Audio DSP produces denormals by design: decaying filter, envelope and reverb tails
+ * settle on a subnormal fixed point under IEEE rounding (SPU pass 28), so KZ3's audio SPU ran its mixer jobs on
+ * assists. MXCSR.FTZ (bit 15) flushes underflowing results to zero, DAZ (bit 6) reads denormal operands as zero.
+ * Residual deviations: x86 FTZ keeps the sign of an underflowed result (-0 for a negative one; the SPU gives +0),
+ * and FTZ/DAZ also act on double precision, where the ISA allows denormal operands to be forced to zero (s.9.2,
+ * DENORM) but keeps denormal results. Header-only so the host test (tools/spu/test_spu_ftz.sh) uses this code.
+ * Opt-in (KZ3_SPU_FTZ=1): in SPU pass 70's K2 pair the audio SPU's job times did not change (the hot mixer loops
+ * see normal values in the game), so the semantic change waits for its own A/B before a default flip. */
+#ifndef SPU_FPMODE_H
+#define SPU_FPMODE_H
+#if defined(__SSE__) || defined(_M_X64) || defined(_M_IX86)
+#include <xmmintrin.h>
+#define SPU_FPMODE_X86 1
+#endif
+
+#define SPU_FPMODE_FTZ_DAZ 0x8040u
+
+/* KZ3_SPU_FTZ: on only when set to a value starting with '1' (opt-in, SPU pass 70: no throughput change measured). */
+static inline int spu_fpmode_env_on(const char* e) { return (e && *e == '1') ? 1 : 0; }
+
+/* This thread's MXCSR gets FTZ|DAZ (rounding mode and exception masks untouched). */
+static inline void spu_fpmode_set_spu(void)
+{
+#ifdef SPU_FPMODE_X86
+    _mm_setcsr(_mm_getcsr() | SPU_FPMODE_FTZ_DAZ);
+#endif
+}
+
+static inline unsigned spu_fpmode_get(void)
+{
+#ifdef SPU_FPMODE_X86
+    return _mm_getcsr();
+#else
+    return 0;
+#endif
+}
+#endif
