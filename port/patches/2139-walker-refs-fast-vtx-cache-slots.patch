+u32 rsx_vertex_refs_from_indices(rsx_vertex_ref* out, const unsigned char* src, u32 count, int is_u32,
+                                 int restart_en, u32 restart_value, u32 base_index)
+{
+    u32 i = 0;
+    if (is_u32) {
+        if (restart_en) {
+            for (; i < count; i++) {
+                u32 w; memcpy(&w, src + (size_t)i * 4u, 4);
+                w = __builtin_bswap32(w);
+                if (w == restart_value) return i;
+                out[i].vertex_id = w; out[i].base_index = base_index;
+            }
+        } else {
+            for (; i < count; i++) {
+                u32 w; memcpy(&w, src + (size_t)i * 4u, 4);
+                out[i].vertex_id = __builtin_bswap32(w); out[i].base_index = base_index;
+            }
+        }
+    } else {
+        if (restart_en) {
+            for (; i < count; i++) {
+                u16 h; memcpy(&h, src + (size_t)i * 2u, 2);
+                const u32 w = (u32)__builtin_bswap16(h);
+                if (w == restart_value) return i;
+                out[i].vertex_id = w; out[i].base_index = base_index;
+            }
+        } else {
+            for (; i < count; i++) {
+                u16 h; memcpy(&h, src + (size_t)i * 2u, 2);
+                out[i].vertex_id = (u32)__builtin_bswap16(h); out[i].base_index = base_index;
+            }
+        }
+    }
+    return i;
+}
