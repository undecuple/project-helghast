@@ -407,6 +418,7 @@ int rsx_vertex_fetch_many(
     if (!plan || (!refs && count) || (!out && plan->layout.stride && count))
         return 0;
     const u32 stride = plan->layout.stride;
+    const int cmp32_batch = rsx_vtx_switch(&rsx_vtx_cmp32_batch, "LD_VTX_CMP32");   /* patch 2073 */
     for (u32 slot = 0; slot < plan->layout.count; slot++) {
         const u32 attr = plan->layout.attrs[slot];
         const rsx_vertex_fetch_attr* fetch = &plan->attr[attr];
@@ -445,6 +457,20 @@ int rsx_vertex_fetch_many(
         case RSX_VTX_TYPE_SINT16:
             RSX_FETCH_LOOP(v[c] = (float)(s16)((src[c * 2] << 8) | src[c * 2 + 1]))
             break;
+        case RSX_VTX_TYPE_CMP32:   /* KZ3 patch 2073: one packed word, LD_VTX_CMP32=1 decodes it in the loop */
+            if (cmp32_batch) {
+                /* the 11/11/10-bit fields sign-extended by shifts: the same integers as
+                 * rsx_vertex_decode_element's "if (x & 0x400) x -= 0x800" */
