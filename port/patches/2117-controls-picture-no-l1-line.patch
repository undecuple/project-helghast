+/* Patch 2117 (RSX pass 110, ENHANCEMENT, display): the game's own picture (KC_CTL, PS3 set) without L1's leader line,
+ * for a layout that gives L1 no on-foot action (Modern; network pass 39: the line pointed at an empty label). The picture
+ * is white line art in the alpha channel (body ~70, buttons and lines ~200-240). The line runs from (103.5, 23.1) to
+ * (133.0, 33.3) (measured on the game's texture, numbers only); every texel within 1.6 px of it, left of the L1 button's
+ * outline (x <= 132), gets the alpha interpolated down its column between the texels just above and below the line,
+ * which is 0 in the empty ground and continues the body's outline where the line crossed it (x 125-131). Only the
+ * blocks holding such texels are decoded and re-encoded (2039's encoder); the rest of the picture is untouched. */
+static int pg_l1_unused(void)
+{
+    return g_kc_have_src && g_kc_src.layout_l1_unused && g_kc_src.layout_l1_unused();
+}
+static void rsx_pg_ctl_erase_l1(uint8_t* bc3, uint32_t w, uint32_t h)
+{
+    enum { X0 = 100, X1 = 132, Y0 = 16, Y1 = 40 };
+    if (w != KC_CTL_W || h != KC_CTL_H) return;
+    /* the alpha of blocks x 100..135, y 16..43 */
+    uint8_t a[Y1 - Y0 + 4][X1 - X0 + 4], b[Y1 - Y0 + 4][X1 - X0 + 4];
+    int changed[(Y1 + 3) / 4 + 1][X1 / 4 + 1];
+    const uint32_t bw = w / 4, bx0 = X0 / 4, bx1 = X1 / 4, by0 = Y0 / 4, by1 = (Y1 + 3) / 4;
+    uint8_t px[16][4];
+    for (uint32_t by = by0; by <= by1; by++)
+        for (uint32_t bx = bx0; bx <= bx1; bx++) {
+            kc_bc3_decode(bc3 + ((size_t)by * bw + bx) * 16, px);
+            for (int i = 0; i < 16; i++) a[by * 4 + (i >> 2) - Y0][bx * 4 + (i & 3) - X0] = px[i][3];
+        }
+    memcpy(b, a, sizeof b);
+    memset(changed, 0, sizeof changed);
+    for (int x = X0; x <= X1; x++) {
+        int t = -1, u = -1;
+        for (int y = Y0 + 1; y < Y1; y++)
+            if (pc_d_seg((float)x, (float)y, 103.5f, 23.1f, 133.0f, 33.3f) <= 1.6f) { if (t < 0) t = y; u = y; }
+        if (t < 0) continue;
+        const int ya = t - 1, yb = u + 1;
+        for (int y = t; y <= u; y++) {
+            const float f = (float)(y - ya) / (float)(yb - ya);
+            const float v = (float)a[ya - Y0][x - X0] * (1.f - f) + (float)a[yb - Y0][x - X0] * f;
+            b[y - Y0][x - X0] = (uint8_t)(v + 0.5f);
+            changed[y / 4][x / 4] = 1;
+        }
+    }
+    for (uint32_t by = by0; by <= by1; by++)
+        for (uint32_t bx = bx0; bx <= bx1; bx++) {
+            if (!changed[by][bx]) continue;
+            uint8_t* blk = bc3 + ((size_t)by * bw + bx) * 16;
+            kc_bc3_decode(blk, px);
+            for (int i = 0; i < 16; i++) px[i][3] = b[by * 4 + (i >> 2) - Y0][bx * 4 + (i & 3) - X0];
+            kc_bc3_encode(px, blk);
+        }
 }
 
