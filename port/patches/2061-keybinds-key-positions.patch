+/* Patch 2061: binding codes are key positions (pad_keybinds.h); s_kb_layout turns them into the active layout's
+ * virtual keys. Rebuilt when the foreground thread's layout (HKL) changes: the poll reads it each time, which sees the
+ * same switch WM_INPUTLANGCHANGE announces without a hook in the window procedure. KZ3_KB_LAYOUT=<KLID> (eight hex
+ * digits, e.g. 0000040C French) loads and uses that layout instead (owners' checks on Windows; ASSUMPTION: Wine's
+ * MapVirtualKeyEx follows the X keymap and ignores the HKL, so under Proton the switch changes nothing). */
+static PadKbLayout s_kb_layout;
+static HKL         s_kb_hkl = NULL;
+static int         s_kb_layout_ok = 0;
+static char        s_kb_label_acp[256][PKB_LABEL];  /* the legends in the ANSI code page (keycaps: TextOutA) */
+
+static int pad_kb_sc_to_vk_win(void* ctx, int sc) { return (int)MapVirtualKeyExW((UINT)sc, 1 /* MAPVK_VSC_TO_VK */, (HKL)ctx); }
+static int pad_kb_sc_name_win(void* ctx, int sc, char* out, size_t n)
+{
+    wchar_t w[PKB_LABEL];
+    int len;
+    (void)ctx;      /* GetKeyNameTextW uses the calling thread's layout: activated around the build (pad_kb_layout_update) */
+    len = GetKeyNameTextW((LONG)((unsigned)sc << 16), w, PKB_LABEL);
+    if (len <= 0 || len >= 4) return 0;          /* a legend is one or two characters; longer = a word, keep ours */
+    w[len] = 0;
+    CharUpperW(w);
+    len = WideCharToMultiByte(CP_UTF8, 0, w, -1, out, (int)n, NULL, NULL);
+    return len > 1 ? len - 1 : 0;
+}
+
+static void pad_kb_layout_update(void)
+{
+    static int forced = -1;
+    static HKL fhkl = NULL;
+    HKL h;
+    if (forced < 0) {
+        const char* e = getenv("KZ3_KB_LAYOUT");
+        forced = 0;
+        if (e && *e) {
+            wchar_t w[16];
+            MultiByteToWideChar(CP_ACP, 0, e, -1, w, 16); w[15] = 0;
+            fhkl = LoadKeyboardLayoutW(w, KLF_NOTELLSHELL);
+            forced = fhkl != NULL;
+            printf("[keybinds] KZ3_KB_LAYOUT=%s -> %s\n", e, forced ? "loaded" : "not loadable, the active layout is used");
+        }
+    }
+    if (forced) h = fhkl;
+    else {
+        HWND fg = GetForegroundWindow();
+        h = GetKeyboardLayout(fg ? GetWindowThreadProcessId(fg, NULL) : 0);
+    }
+    if (s_kb_layout_ok && h == s_kb_hkl) return;
+    {
+        HKL old = GetKeyboardLayout(0);
+        int i, j, sw = h && h != old;
+        if (sw) ActivateKeyboardLayout(h, 0);           /* GetKeyNameTextW reads this thread's layout */
+        pad_kb_layout_build(&s_kb_layout, pad_kb_sc_to_vk_win, pad_kb_sc_name_win, (void*)h);
+        if (sw) ActivateKeyboardLayout(old, 0);
+        for (i = 0; i < 256; i++) {
+            wchar_t w[PKB_LABEL];
+            s_kb_label_acp[i][0] = 0;
+            if (!s_kb_layout.label[i][0]) continue;
+            if (MultiByteToWideChar(CP_UTF8, 0, s_kb_layout.label[i], -1, w, PKB_LABEL) > 0) {
+                BOOL lost = FALSE;
+                if (WideCharToMultiByte(CP_ACP, WC_NO_BEST_FIT_CHARS, w, -1, s_kb_label_acp[i], PKB_LABEL, NULL, &lost) <= 0 || lost)
+                    s_kb_label_acp[i][0] = 0;              /* not in the code page: keycaps keep the port's name */
+            }
+        }
+        s_kb_hkl = h; s_kb_layout_ok = 1;
+        pad_kb_display_layout = &s_kb_layout;
+        {   /* one line per change: the layout and where the default WASD positions are on it */
+            static const unsigned char wasd[4] = { 0x57, 0x41, 0x53, 0x44 };
+            char t[64]; size_t o = 0;
+            for (j = 0; j < 4; j++) {
+                const char* l = s_kb_layout.label[wasd[j]];
+                o += (size_t)snprintf(t + o, sizeof t - o, "%s%s", j ? " " : "", *l ? l : "?");
+                if (o >= sizeof t) break;
+            }
+            printf("[keybinds] layout %08lx: positions W A S D are %s here (vk %02x %02x %02x %02x)\n",
+                   (unsigned long)(uintptr_t)h, t, s_kb_layout.vk[0x57], s_kb_layout.vk[0x41], s_kb_layout.vk[0x53],
+                   s_kb_layout.vk[0x44]);
+            fflush(stdout);
+        }
+    }
+}
+
+static int pad_kb_down_win(void* ctx, int code)
+{
+    int vk = code;
+    (void)ctx;
+    if (code > 0 && code < 256 && s_kb_layout_ok) vk = s_kb_layout.vk[code];
+    return vk && (GetAsyncKeyState(vk) & 0x8000) != 0;
+}
 static int pad_kb_down_none(void* ctx, int vk) { (void)ctx; (void)vk; return 0; }
 
