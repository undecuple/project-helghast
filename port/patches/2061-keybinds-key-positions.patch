+/* ---- patch 2061: key positions ----
+ * The layout-dependent positions: code (US virtual key) and PC/AT set-1 scancode (all non-extended). Oem102 is the
+ * ISO key left of Z (102/105-key boards; no key on a US ANSI board). */
+typedef struct { unsigned char code, sc; } PadKbPosKey;
+static const PadKbPosKey pad_kb_pos_keys[] = {
+    { 0x31, 0x02 }, { 0x32, 0x03 }, { 0x33, 0x04 }, { 0x34, 0x05 }, { 0x35, 0x06 }, { 0x36, 0x07 }, { 0x37, 0x08 },
+    { 0x38, 0x09 }, { 0x39, 0x0A }, { 0x30, 0x0B }, { 0xBD, 0x0C }, { 0xBB, 0x0D },
+    { 0x51, 0x10 }, { 0x57, 0x11 }, { 0x45, 0x12 }, { 0x52, 0x13 }, { 0x54, 0x14 }, { 0x59, 0x15 }, { 0x55, 0x16 },
+    { 0x49, 0x17 }, { 0x4F, 0x18 }, { 0x50, 0x19 }, { 0xDB, 0x1A }, { 0xDD, 0x1B },
+    { 0x41, 0x1E }, { 0x53, 0x1F }, { 0x44, 0x20 }, { 0x46, 0x21 }, { 0x47, 0x22 }, { 0x48, 0x23 }, { 0x4A, 0x24 },
+    { 0x4B, 0x25 }, { 0x4C, 0x26 }, { 0xBA, 0x27 }, { 0xDE, 0x28 }, { 0xC0, 0x29 }, { 0xDC, 0x2B },
+    { 0x5A, 0x2C }, { 0x58, 0x2D }, { 0x43, 0x2E }, { 0x56, 0x2F }, { 0x42, 0x30 }, { 0x4E, 0x31 }, { 0x4D, 0x32 },
+    { 0xBC, 0x33 }, { 0xBE, 0x34 }, { 0xBF, 0x35 }, { 0xE2, 0x56 },
+};
+#define PKB_N_POS ((int)(sizeof pad_kb_pos_keys / sizeof pad_kb_pos_keys[0]))
+
+static int pad_kb_pos_sc(int code)          /* scancode of a layout-dependent position, 0 = layout-independent key */
+{
+    int i;
+    for (i = 0; i < PKB_N_POS; i++) if (pad_kb_pos_keys[i].code == code) return pad_kb_pos_keys[i].sc;
+    return 0;
+}
+
+/* The active keyboard layout as the bindings see it. vk: position code -> the layout's virtual key (0 = no key there);
+ * pos: virtual key -> position code (0 = no position produces it); label: the layout's legend of a position (UTF-8,
+ * "" = use the port's own name). Layout-independent codes map to themselves. */
+#define PKB_LABEL 16
+typedef struct {
+    unsigned char vk[256], pos[256];
+    char label[256][PKB_LABEL];
+} PadKbLayout;
+
+/* The host's layout queries: scancode -> virtual key, and scancode -> legend (UTF-8, upper case; 0 = none).
+ * Windows: MapVirtualKeyExW(MAPVK_VSC_TO_VK) and GetKeyNameTextW (cellPad.c); the host test: a fake table. */
+typedef int (*PadKbScToVk)(void* ctx, int sc);
+typedef int (*PadKbScName)(void* ctx, int sc, char* out, size_t n);
+
+static void pad_kb_layout_us(PadKbLayout* L)   /* identity: the US layout, and the state before any query */
+{
+    int i;
+    memset(L, 0, sizeof *L);
+    for (i = 0; i < 256; i++) { L->vk[i] = (unsigned char)i; L->pos[i] = (unsigned char)i; }
+}
+
+static void pad_kb_layout_build(PadKbLayout* L, PadKbScToVk to_vk, PadKbScName name, void* ctx)
+{
+    int i;
+    pad_kb_layout_us(L);
+    for (i = 0; i < PKB_N_POS; i++) {                    /* letters etc. move with the layout */
+        int c = pad_kb_pos_keys[i].code, v = to_vk ? to_vk(ctx, pad_kb_pos_keys[i].sc) : c;
+        if (v < 0 || v > 255) v = 0;
+        L->vk[c] = (unsigned char)v;
+        L->pos[c] = 0;
+    }
+    for (i = 0; i < PKB_N_POS; i++) L->pos[L->vk[pad_kb_pos_keys[i].code]] = 0;   /* also keys no US key has (OEM_8) */
+    for (i = 0; i < PKB_N_POS; i++) {
+        int c = pad_kb_pos_keys[i].code, v = L->vk[c];
+        if (v && !L->pos[v]) L->pos[v] = (unsigned char)c;
+        if (name && name(ctx, pad_kb_pos_keys[i].sc, L->label[c], PKB_LABEL) <= 0) L->label[c][0] = 0;
+        L->label[c][PKB_LABEL - 1] = 0;
+    }
+}
+
+/* The layout the display functions use (pad_kb_key_short); NULL = the port's own names. Set by the poller. */
+static const PadKbLayout* pad_kb_display_layout = NULL;
+
+/* Does this file text name key positions (written by 2061 or later)? A "keys = positions" line in [keyboard]. */
+static int pad_kb_text_positional(const char* text)
+{
+    const char* p = text;
+    if (!text) return 0;
+    while ((p = strstr(p, "keys")) != NULL) {
+        const char* a = p;
+        const char* q = p + 4;
+        while (a > text && (a[-1] == ' ' || a[-1] == '\t')) a--;
+        if (a == text || a[-1] == '\n') {
+            while (*q == ' ' || *q == '\t') q++;
+            if (*q == '=') {
+                q++;
+                while (*q == ' ' || *q == '\t') q++;
+                if (!strncmp(q, "positions", 9) || !strncmp(q, "Positions", 9)) return 1;
+            }
+        }
+        p += 4;
+    }
+    return 0;
+}
+
+static void pad_kb_defaults(PadKeybinds* kb);
+
+/* A pre-2061 file read into kb holds the virtual keys of the layout active then. Rebind each slot to the position
+ * that layout gives that key, so every key stays where the player put it. An input still on its old default pair is
+ * set to the default positions instead (the old default "W" sat at the US-Z position on AZERTY; nobody chose that).
+ * Returns the number of slots whose code changed. */
+static int pad_kb_migrate(PadKeybinds* kb, const PadKbLayout* L)
+{
+    PadKeybinds d;
+    int i, s, n = 0;
+    pad_kb_defaults(&d);
+    for (i = 0; i < PKB_N_INPUTS; i++) {
+        if (kb->key[i][0] == d.key[i][0] && kb->key[i][1] == d.key[i][1]) continue;
+        for (s = 0; s < PKB_SLOTS; s++) {
+            int v = kb->key[i][s], c = v;
+            if (v && pad_kb_pos_sc(v) && L->pos[v]) c = L->pos[v];  /* a layout key: where it is on this board */
+            if (c != v) { kb->key[i][s] = (unsigned char)c; n++; }
+        }
+    }
+    return n;
+}
