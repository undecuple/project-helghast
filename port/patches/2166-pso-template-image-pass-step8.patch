+/* One-off pass over the loaded image's ranges at step 8, both kinds: fragment programs the image carries sit at 8 mod 16.
+ * Scans only committed, readable parts of each range. Returns the bytes scanned. */
+static size_t ld_pt_scan_image(const rsx_pt_qtab* qt, const u8* base)
+{
+    size_t total = 0;
+    g_pt.cur_img = 1;
+    for (u32 r = 0; r < g_pt.n_img && !g_pt.stop; r++) {
+        const u8* p = base + g_pt.img[r][0];
+        const u8* end = base + g_pt.img[r][1];
+        while (p < end && !g_pt.stop) {
+            MEMORY_BASIC_INFORMATION mi;
+            if (!VirtualQuery(p, &mi, sizeof mi)) break;
+            const u8* re = (const u8*)mi.BaseAddress + mi.RegionSize;
+            if (re > end) re = end;
+            if (mi.State == MEM_COMMIT && (mi.Protect & (PAGE_READONLY | PAGE_READWRITE | PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE |
+                                                          PAGE_WRITECOPY)) && !(mi.Protect & (PAGE_GUARD | PAGE_NOACCESS))) {
+                total += (size_t)(re - p);
+                rsx_pt_scan_step(p, (size_t)(re - p), qt, ld_pt_hit, NULL, 8u, RSX_PT_KIND_VP | RSX_PT_KIND_FP);
+            }
+            p = re;
+        }
+    }
+    g_pt.cur_img = 0;
+    return total;
+}
