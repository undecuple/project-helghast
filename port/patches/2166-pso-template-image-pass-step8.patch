diff --git a/runtime/ppu/ppu_loader.cpp b/runtime/ppu/ppu_loader.cpp
--- a/runtime/ppu/ppu_loader.cpp
+++ b/runtime/ppu/ppu_loader.cpp
@@ -3861,6 +3861,19 @@
 static std::vector<ppu_image_range> g_ppu_image_ranges;
 extern "C" void sys_memory_set_image_query(uint64_t (*query)(uint64_t, uint64_t));
 
+/* Patch 2166: the loaded PT_LOAD ranges (vaddr .. vaddr + max(memsz, filesz)) for finders that look for data the
+ * image itself carries (RSX pipeline template prewarm). Writes up to `max` {begin, end} pairs to out, returns the
+ * number of ranges (0 before an image is loaded). */
+extern "C" uint32_t ppu_image_ranges(uint64_t* out, uint32_t max)
+{
+    uint32_t n = 0;
+    for (const auto& r : g_ppu_image_ranges) {
+        if (n < max && out) { out[2 * n] = r.begin; out[2 * n + 1] = r.end; }
+        n++;
+    }
+    return n < max ? n : max;
+}
+
 static uint64_t ppu_image_overlap_end(uint64_t addr, uint64_t end)
 {
     uint64_t next = addr;
