+/* Patch 2166: the guest address space's host base (the VirtualAlloc'd reservation), or NULL until cellGcm resolved it. */
+static const u8* ld_pt_guest_base(void)
+{
+    const u8* any = g.guest_ptr ? g.guest_ptr(g.guest_user, 0u, 0u, 1u) : NULL;
+    if (!any) any = g.guest_ptr ? g.guest_ptr(g.guest_user, 1u, 0u, 1u) : NULL;
+    if (!any) return NULL;
+    MEMORY_BASIC_INFORMATION mi;
+    if (!VirtualQuery(any, &mi, sizeof mi) || !mi.AllocationBase) return NULL;
+    return (const u8*)mi.AllocationBase;
+}
