diff --git a/b/libs/video/rsx_guest_signal.h b/libs/video/rsx_guest_signal.h
new file mode 100644
index 00000000..444c00a4
--- /dev/null
+++ b/libs/video/rsx_guest_signal.h
@@ -0,0 +1,102 @@
+/* KZ3 patch 2190: the guest-signal funnel.
+ * Every guest-visible effect of the FIFO walker (E1..E14, plus E15..E19 found while anchoring) goes
+ * through gcm_guest_signal*(kind, ...) at the position and with the value it had before. Code motion only: the funnel
+ * writes exactly what the site wrote, in the same order, and emits the fcap record the site emitted (kinds 1..6, 9..14
+ * keep their capture word tag; kinds >= 15 are version-2 annotation words, see rsx_fifo_capture.h). It counts per kind
+ * and per thread: `on` = the thread is inside a walker pass (the R thread), `offr` = any other thread
+ * (guest poll, recycle callback, renderer thread), which writes directly exactly as before and is never queued.
+ *
+ * Pure header (stdint/stdio only) so host tests include it without the runtime. The funnel functions are defined in
+ * rsx_commands.c (linked wherever the walker or the method processor is, including the replay harness).
+ *
+ * Kind classes:  W = one guest word store (gcm_guest_signal);  H = one big-endian word the renderer stores through a host
+ * pointer (gcm_guest_signal_hostbe);  S = a bulk store whose bytes the site writes itself, declared once before it
+ * (gcm_guest_signal_span, ea = guest EA or, for a renderer write-back, (location << 30) | offset);  N = host-state effect
+ * the guest observes through an API or a later poll, no guest-memory store (gcm_guest_signal_note). */
+#ifndef RSX_GUEST_SIGNAL_H
+#define RSX_GUEST_SIGNAL_H
+
+#include <stdint.h>
+#include <stdio.h>
+
+/* Kind numbers 1..6 and 9..14 are the existing FIFO-capture WORD tags (writes, dir 1). 7 and 8 are not funnel kinds (8 is
+ * the acquire compare READ, tag dir 0, still emitted by the walker itself). */
+enum rsx_gs_kind {
+    RSX_GS_NONE = 0,
+    RSX_GS_GET_JUMP = 1,       /* E5  get published at a JUMP out of a segment */
+    RSX_GS_GET_REL = 2,        /* E3  get published ahead of a 0x6C label release */
+    RSX_GS_LABEL = 3,          /* E3  NV406E semaphore release word */
+    RSX_GS_GET_END = 4,        /* E5  get at the pass end */
+    RSX_GS_REPORT = 5,         /* E2  GET_REPORT into main memory (4 words) */
+    RSX_GS_REF = 6,            /* E1  ref publication to the control page (guest poll or pass end) */
+    RSX_GS_SEM_BE = 9,         /* E4  NV4097 0x1D70/0x1D74 semaphore write */
+    RSX_GS_NOTIFY = 10,        /* E4  NV4097 NOTIFY slot (4 words) */
+    RSX_GS_REPORT_RB = 11,     /* E2  report value the renderer's query drain stores into the guest report */
+    RSX_GS_RING_JUMP = 12,     /* E11 recycle / segment-next JUMP word */
+    RSX_GS_CTX_WORD = 13,      /* E11 command-context word (begin / end / current) */
+    RSX_GS_PUT_RECYCLE = 14,   /* E11 put written by a recycle */
+    RSX_GS_RESYNC_LABEL = 15,  /* E12 label release replayed by the resync sweep */
+    RSX_GS_COPY_0039 = 16,     /* E8  NV0039 row copy (immediate) */
+    RSX_GS_COPY_3089 = 17,     /* E9  NV3089 scaled/swizzled image store */
+    RSX_GS_STORE_308A = 18,    /* E9  NV308A inline point store */
+    RSX_GS_SURF_WB = 19,       /* E10 colour-surface write-back */
+    RSX_GS_WBD_DRAIN = 20,     /* E13 deferred (2185) store: surface or NV0039 move */
+    RSX_GS_FLIP = 21,          /* E6  flip request (sink_flip, FEAD word, E920/E924) */
+    RSX_GS_USERCMD = 22,       /* E7  user command (0xEB00 / 0x0B00) */
+    RSX_GS_PRESENT = 23,       /* E14 present */
+    RSX_GS_REF_PUSH = 24,      /* E1  ref queue push (host queue, published later as kind 6) */
+    RSX_GS_REPORT_LOCAL = 25,  /* E2  GET_REPORT into the local report table (host struct) */
+    RSX_GS_N = 26
+};
+#define RSX_GS_FIRST_ANNOT 15u   /* kinds >= this are version-2 annotation records, ignored by the replay's event identity */
+
+typedef struct { const char* name; char cls; unsigned char exempt, range; } rsx_gs_info;
+/* exempt: the lint does not require the site to be walker-path (it may run on a guest thread: ref poll, the title's recycle
+ * callback and the in-pass recycle that emulates it). range: the effect also leaves a fcap RANGE record (WR_WALKER 1 or WR_RENDERER 2). */
+static inline const rsx_gs_info* rsx_gs_info_of(unsigned k)
+{
+    static const rsx_gs_info t[RSX_GS_N] = {
+        [RSX_GS_GET_JUMP] = { "get_jump", 'W', 0, 0 },     [RSX_GS_GET_REL] = { "get_rel", 'W', 0, 0 },
+        [RSX_GS_LABEL] = { "label", 'W', 0, 0 },           [RSX_GS_GET_END] = { "get_end", 'W', 0, 0 },
+        [RSX_GS_REPORT] = { "report", 'W', 0, 0 },         [RSX_GS_REF] = { "ref", 'W', 1, 0 },
+        [RSX_GS_SEM_BE] = { "sem_be", 'W', 0, 0 },         [RSX_GS_NOTIFY] = { "notify", 'W', 0, 0 },
+        [RSX_GS_REPORT_RB] = { "report_rb", 'H', 0, 0 },   [RSX_GS_RING_JUMP] = { "ring_jump", 'W', 1, 0 },
+        [RSX_GS_CTX_WORD] = { "ctx_word", 'W', 1, 0 },     [RSX_GS_PUT_RECYCLE] = { "put_recycle", 'W', 1, 0 },
+        [RSX_GS_RESYNC_LABEL] = { "resync_label", 'W', 0, 0 },
+        [RSX_GS_COPY_0039] = { "copy0039", 'S', 0, 1 },    [RSX_GS_COPY_3089] = { "copy3089", 'S', 0, 1 },
+        [RSX_GS_STORE_308A] = { "store308a", 'W', 0, 0 },  [RSX_GS_SURF_WB] = { "surf_wb", 'S', 0, 2 },
+        [RSX_GS_WBD_DRAIN] = { "wbd_drain", 'S', 0, 0 },   [RSX_GS_FLIP] = { "flip", 'N', 0, 0 },
+        [RSX_GS_USERCMD] = { "usercmd", 'N', 0, 0 },       [RSX_GS_PRESENT] = { "present", 'N', 0, 0 },
+        [RSX_GS_REF_PUSH] = { "ref_push", 'N', 0, 0 },     [RSX_GS_REPORT_LOCAL] = { "report_local", 'N', 0, 0 },
+    };
+    return k > 0 && k < RSX_GS_N && t[k].name ? &t[k] : NULL;
+}
+
+/* counters: [kind][0] = on the walker thread, [kind][1] = off the walker thread (offr) */
+extern unsigned long long g_rsx_gs_n[RSX_GS_N][2];
+/* host tests only: called for every funnel call with (kind, ea, n bytes or 0, on_walker); NULL = off */
+extern void (*g_rsx_gs_trace)(unsigned kind, uint32_t ea, uint32_t n, int on_walker);
+
+/* The walker pass brackets: the thread is "R" between enter and leave (nesting-safe: leave takes enter's return). */
+int  rsx_gs_walker_enter(void);
+void rsx_gs_walker_leave(int prev);
+
+void gcm_guest_signal(unsigned kind, uint32_t ea, uint32_t val);                          /* W */
+void gcm_guest_signal_hostbe(unsigned kind, uint8_t* p, uint32_t tag_ea, uint32_t val);   /* H */
+void gcm_guest_signal_span(unsigned kind, uint32_t ea, uint32_t n);                       /* S */
+void gcm_guest_signal_note(unsigned kind, uint32_t a, uint32_t b);                        /* N */
+
+/* `[gsig] t=.. kind=on/offr ...` per-second delta line (RSX_O0=1), only the kinds that moved. Returns the length. */
+static inline int rsx_gs_fmt(char* out, size_t n, double t, const unsigned long long cur[][2], const unsigned long long prev[][2])
+{
+    int w = snprintf(out, n, "[gsig] t=%.0f", t);
+    for (unsigned k = 1; k < RSX_GS_N && w > 0 && (size_t)w < n; k++) {
+        const rsx_gs_info* i = rsx_gs_info_of(k);
+        const unsigned long long a = cur[k][0] - prev[k][0], b = cur[k][1] - prev[k][1];
+        if (!i || (!a && !b)) continue;
+        w += snprintf(out + w, n - (size_t)w, " %s=%llu/offr=%llu", i->name, a, b);
+    }
+    return w;
+}
+
+#endif
