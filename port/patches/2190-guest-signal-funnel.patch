+/* ---- Patch 2190: the guest-signal funnel. GS_FUNNEL_BEGIN ---------------------------------------------------------
+ * Every guest-visible walker effect is written here, with the value and at the position the call site had. The capture
+ * record a site used to emit by hand is emitted here (kinds 1..6, 9..14 keep their WORD tag; kinds >= 15 are annotation
+ * words). tools/smoke/test_guest_signal_order.py lints that no walker-path function stores to guest memory outside this
+ * region. */
+unsigned long long g_rsx_gs_n[RSX_GS_N][2];
+void (*g_rsx_gs_trace)(unsigned kind, uint32_t ea, uint32_t n, int on_walker);
+static
+#ifdef _MSC_VER
+__declspec(thread)
+#else
+__thread
+#endif
+int t_rsx_gs_walker;
+int rsx_gs_walker_enter(void) { const int p = t_rsx_gs_walker; t_rsx_gs_walker = 1; return p; }
+void rsx_gs_walker_leave(int prev) { t_rsx_gs_walker = prev; }
+static inline void rsx_gs_count(unsigned kind, uint32_t ea, uint32_t n)
+{
+    const int onw = t_rsx_gs_walker;
+    __atomic_fetch_add(&g_rsx_gs_n[kind < RSX_GS_N ? kind : 0][onw ? 0 : 1], 1ull, __ATOMIC_RELAXED);
+    if (__builtin_expect(g_rsx_gs_trace != NULL, 0)) g_rsx_gs_trace(kind, ea, n, onw);
+}
+void gcm_guest_signal(unsigned kind, uint32_t ea, uint32_t val)
+{
+    extern void vm_write32(uint32_t a, uint32_t v);
+    extern volatile int g_rsx_fcap_on; extern void rsx_fcap_word(int dir, u32 tag, u32 ea, u32 value);
+    rsx_gs_count(kind, ea, 4u);
+    vm_write32(ea, val);
+    if (g_rsx_fcap_on) rsx_fcap_word(1, kind, ea, val);
+}
+void gcm_guest_signal_hostbe(unsigned kind, uint8_t* p, uint32_t tag_ea, uint32_t val)
+{
+    extern volatile int g_rsx_fcap_on; extern void rsx_fcap_word(int dir, u32 tag, u32 ea, u32 value);
+    rsx_gs_count(kind, tag_ea, 4u);
+    p[0] = (uint8_t)(val >> 24); p[1] = (uint8_t)(val >> 16); p[2] = (uint8_t)(val >> 8); p[3] = (uint8_t)val;
+    if (g_rsx_fcap_on) rsx_fcap_word(1, kind, tag_ea, val);
+}
+void gcm_guest_signal_span(unsigned kind, uint32_t ea, uint32_t n)
+{
+    extern volatile int g_rsx_fcap_on; extern void rsx_fcap_word(int dir, u32 tag, u32 ea, u32 value);
+    rsx_gs_count(kind, ea, n);
+    if (g_rsx_fcap_on) rsx_fcap_word(1, kind, ea, n);
+}
+void gcm_guest_signal_note(unsigned kind, uint32_t a, uint32_t b)
+{
+    extern volatile int g_rsx_fcap_on; extern void rsx_fcap_word(int dir, u32 tag, u32 ea, u32 value);
+    rsx_gs_count(kind, a, 0u);
+    if (g_rsx_fcap_on) rsx_fcap_word(1, kind, a, b);
+}
+/* GS_FUNNEL_END */
