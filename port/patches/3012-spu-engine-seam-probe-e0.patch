new file mode 100644
--- /dev/null
+++ b/runtime/spu/spu_e0.h
@@ -0,0 +1,128 @@
+/* spu_e0.h -- KZ3 patch 3012: engine-seam probe (walker plan B-E0), pure helpers.
+ *
+ * Everything here is stateless or takes its state by pointer, so a host test can include it alone (no runtime, no
+ * game). The runtime half (hooks, per-second summary, the PPU entry point kz3_e0_resv) is in spu_channels.c.
+ * Switch family KZ3_E0_* (all default off; KZ3_E0=1 turns the probe on): see the RE notes.
+ *
+ * e0_pb: a scanner for NV4097 push-buffer words as an SPU job PUTs them (big-endian words). It counts words, method
+ * headers, draws and per-class data words. A PUT may end inside a method, so the scanner keeps `rem` (data words still
+ * owed) across calls; feed a job's puts to one scanner in order. ASSUMPTION: the first word fed is a header.
+ */
+#ifndef SPU_E0_H
+#define SPU_E0_H
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+enum { E0_C_VCONST, E0_C_VP, E0_C_TEX, E0_C_VARR, E0_C_DRAW, E0_C_OTHER, E0_NC };
+
+struct e0_pb {
+    uint32_t rem, method, noninc;                       /* open method: data words owed, next method, non-increment */
+    uint32_t words, hdrs, data, nops, jmp, call, ret, bad;
+    uint32_t draws;                                     /* SET_BEGIN_END (0x1808) with a non-zero primitive: draw groups */
+    uint32_t darr, didx, inl;                           /* data words of DRAW_ARRAYS 0x1814, DRAW_INDEX_ARRAY 0x1824, INLINE_ARRAY 0x1818 */
+    uint32_t cls[E0_NC];                                /* data words per class */
+};
+
+static inline int e0_class(uint32_t m)
+{
+    if (m >= 0x1F00 && m < 0x2000) return E0_C_VCONST;   /* SET_TRANSFORM_CONSTANT 0x1F00.. */
+    if (m >= 0x0B80 && m < 0x0C00) return E0_C_VP;       /* SET_TRANSFORM_PROGRAM 0x0B80.. */
+    if (m >= 0x1A00 && m < 0x1C00) return E0_C_TEX;      /* texture and sampler registers */
+    if (m >= 0x1680 && m < 0x1700) return E0_C_VARR;     /* vertex data array offsets/formats */
+    if (m == 0x1808 || m == 0x1814 || m == 0x1818 || m == 0x1824) return E0_C_DRAW;
+    return E0_C_OTHER;
+}
+
+static inline void e0_pb_word(struct e0_pb* s, uint32_t w)
+{
+    s->words++;
+    if (s->rem) {
+        const uint32_t m = s->method;
+        s->rem--;
+        s->data++;
+        s->cls[e0_class(m)]++;
+        if (m == 0x1808 && w != 0) s->draws++;
+        else if (m == 0x1814) s->darr++;
+        else if (m == 0x1824) s->didx++;
+        else if (m == 0x1818) s->inl++;
+        if (!s->noninc) s->method = m + 4;
+        return;
+    }
+    if (w == 0) { s->nops++; return; }
+    if ((w & 0xE0000003u) == 0x20000000u || (w & 3u) == 1u) { s->jmp++; return; }   /* old and new JUMP */
+    if ((w & 3u) == 2u) { s->call++; return; }
+    if (w == 0x00020000u) { s->ret++; return; }
+    if ((w & 0xA0030003u) == 0) {                         /* method header: count<<18 | method (4-aligned, 13 bits) */
+        s->rem = (w >> 18) & 0x7FF;
+        s->method = w & 0x1FFC;
+        s->noninc = (w & 0x40000000u) != 0;
+        s->hdrs++;
+        return;
+    }
+    s->bad++;
+}
+
+static inline void e0_pb_feed(struct e0_pb* s, const uint8_t* be, uint32_t nbytes)
+{
+    for (uint32_t i = 0; i + 4 <= nbytes; i += 4)
+        e0_pb_word(s, (uint32_t)be[i] << 24 | (uint32_t)be[i + 1] << 16 | (uint32_t)be[i + 2] << 8 | be[i + 3]);
+}
+
+static inline void e0_pb_add(struct e0_pb* d, const struct e0_pb* s)   /* totals only (not the open-method state) */
+{
+    d->words += s->words; d->hdrs += s->hdrs; d->data += s->data; d->nops += s->nops; d->jmp += s->jmp;
+    d->call += s->call; d->ret += s->ret; d->bad += s->bad; d->draws += s->draws; d->darr += s->darr;
+    d->didx += s->didx; d->inl += s->inl;
+    for (int i = 0; i < E0_NC; i++) d->cls[i] += s->cls[i];
+}
+
+/* "lo,hi" or "lo-hi" seconds (decimal, fractions allowed); returns 1 when parsed. */
+static inline int e0_parse_window(const char* s, double* lo, double* hi)
+{
+    char* d;
+    if (!s || !*s) return 0;
+    const double a = strtod(s, &d);
+    if (d == s || (*d != ',' && *d != '-')) return 0;
+    char* e;
+    const double b = strtod(d + 1, &e);
+    if (e == d + 1 || b < a) return 0;
+    *lo = a; *hi = b;
+    return 1;
+}
+
+/* "lo-hi" hex effective addresses; returns 1 when parsed. */
+static inline int e0_parse_range(const char* s, uint32_t* lo, uint32_t* hi)
+{
+    char* d;
+    if (!s || !*s) return 0;
+    const unsigned long a = strtoul(s, &d, 16);
+    if (d == s || *d != '-') return 0;
+    char* e;
+    const unsigned long b = strtoul(d + 1, &e, 16);
+    if (e == d + 1 || b <= a) return 0;
+    *lo = (uint32_t)a; *hi = (uint32_t)b;
+    return 1;
+}
+
+/* Reserved holes (PPU side, 0x5BB58 callers): a small ring; a PUT inside one carries the reserving caller's link. */
+#define E0_HOLES 256
+struct e0_holes { uint32_t n; struct { uint32_t ea, size, lr; } h[E0_HOLES]; };
+static inline void e0_hole_add(struct e0_holes* t, uint32_t ea, uint32_t size, uint32_t lr)
+{
+    const uint32_t i = t->n++ % E0_HOLES;
+    t->h[i].ea = ea; t->h[i].size = size; t->h[i].lr = lr;
+}
+static inline int e0_hole_find(const struct e0_holes* t, uint32_t ea, uint32_t* lr)   /* newest first */
+{
+    const uint32_t n = t->n < E0_HOLES ? t->n : E0_HOLES;
+    for (uint32_t k = 0; k < n; k++) {
+        const uint32_t i = (t->n - 1 - k) % E0_HOLES;
+        if (ea >= t->h[i].ea && ea - t->h[i].ea < t->h[i].size) { if (lr) *lr = t->h[i].lr; return 1; }
+    }
+    return 0;
+}
+
+/* The master switch: unset, empty or "0" is off. */
+static inline int e0_switch_on(const char* v) { return v && *v && !(v[0] == '0' && !v[1]); }
+#endif
