+spu_fn spu_ib_direct(spu_context* ctx, uint32_t t)
+{
+    extern void (*g_kz3_wtrace)(const char*, int, uint32_t, uint64_t, uint64_t);
+    if (!spu_hop_ok(ctx)) {
+        SPU_HS(ctx->int_enable && (spu_event_load(ctx) & ctx->event_mask) ? 1 : 2);
+        return NULL;
+    }
+    /* the IRQ register restore acts only when the target is the saved resume pc with interrupts enabled */
+    if (ctx->irq_saved && ctx->int_enable && t == (ctx->irq_resume_pc & SPU_LS_MASK)) {
+        SPU_HS(11);
+        return NULL;
+    }
+    if (g_kz3_pmend_ib != 0 || g_kz3_trace_ctx == (void*)ctx) {
+        SPU_HS(12);
+        return NULL;
+    }
+    if (g_kz3_wtrace != 0) {
+        SPU_HS(13);
+        return NULL;
+    }
+    /* patch 1043/1044 skip or entry hook: acts only on the job manager's call of a marked module's entry
+     * (the same test as spu_overlay_skip_entry before it reads the hook) */
+    if (g_spu_ovl_skip_any && ctx->resident_ovl > 0 && ctx->resident_ovl < (int)KZ3_OVL_SKIP_MAX &&
+        s_ovl_skip[ctx->resident_ovl] && ctx->image_id == 2 && t >= 0x4000 && t < 0x3E000 &&
+        (ctx->gpr[0]._u32[0] & SPU_LS_MASK) < 0x4000) {
+        SPU_HS(3);
+        return NULL;
+    }
+    if (ctx->image_id == SPU_RESOLVER_ONLY_IMAGE_ID) {
+        SPU_HS(3);
+        return NULL;
+    }
+    if (ctx->resident_task) {
+        SPU_HS(4);
+        return NULL;
+    }
+    if (t == 0 || t == 0xA00u || t == SPURS_TASKSET_PM_SYSCALL_LS || t == SPU_JOB_RETURN_LS || t == 0x4A40u ||
+        (ctx->policy_mode && (t == SPURS_PM_EXIT_TO_KERNEL_LS || t == SPURS_PM_SELECT_WORKLOAD_LS))) {
+        SPU_HS(5);
+        return NULL;
+    }
+    if (t == ctx->hop_ret_pc) {
+        SPU_HS(6);
+        return NULL;
+    }
+    if (t >= SPU_TASKSET_TASK_LO && (spu_taskset_resident_image(ctx) || spu_taskset_task_image(t))) {
+        SPU_HS(7);
+        return NULL;
+    }
+    for (unsigned slot = 0; slot < 4; ++slot)
+        if (ctx->resident_code[slot].image_id && t >= ctx->resident_code[slot].lsa &&
+            t - ctx->resident_code[slot].lsa < ctx->resident_code[slot].size) {
+            SPU_HS(8);
