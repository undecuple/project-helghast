             rsx_dsp_resolve_vertex_offset(base, a.offset) + source_element * stride,
@@ -13812,6 +13840,12 @@ static void sink_end_impl(void* user, const rsx_dispatch* r)
                   best_gen = sf_i->last_draw_generation;
               }
           } }
+        /* Patch 2102 (diagnostic, LD_FEAT_LOG=1): which texture formats the colour-surface match above took
+         * (upstream PR 508: a DXT texture is never a render target); kind 6 rows, aux = the surface's format. */
