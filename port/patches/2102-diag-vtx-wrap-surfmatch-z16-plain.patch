+/* Patch 2102 (diagnostic, LD_FEAT_LOG=1): a DEPTH16 / DEPTH16_F / X16 texture that is not a host zeta never reaches
+ * decode_texel (decode_guest_texture has no texel size for them: it fails and the cache binds SRV_WHITE). Log what
+ * the guest memory under such a bind holds, so a 16-bit decode can be judged against real data. */
+static int zdepth_index_at(u32 location, u32 offset);
+static void ld_z16_plain_note(const rsx_dsp_texture* t)
+{
+    static int on = -1; static u32 n;
+    if (on < 0) on = getenv("LD_FEAT_LOG") ? 1 : 0;
+    const u32 bf = t->format & TEX_FMT_BASE_MASK & ~(u32)TEX_FMT_UNNORM;
+    if (!on || (bf != TEX_FMT_DEPTH16 && bf != TEX_FMT_DEPTH16_F && bf != TEX_FMT_X16) || n >= 48) return;
+    n++;
+    const u32 w = t->width, h = t->height;
+    unsigned long long nz = 0, tot = 0, sum = 0; u32 mn = 0xFFFF, mx = 0;
+    const u8* p = (w && h && w <= 4096 && h <= 4096) ? guest_ptr(t->location, t->offset, w * h * 2u) : NULL;
+    if (p) for (u32 i = 0; i < w * h; i++) {
+        const u32 v = (u32)(p[i * 2] << 8 | p[i * 2 + 1]);
+        tot++; if (v) nz++; sum += v; if (v < mn) mn = v; if (v > mx) mx = v;
+    }
+    fprintf(stderr, "[z16-plain] f=%u %u:0x%08X fmt=0x%02X %ux%u remap=0x%04X dim=%u zeta_at=%d bytes=%s nonzero=%llu/%llu min=0x%04X max=0x%04X mean=%llu\n",
+            g_ld_frames, t->location, t->offset, t->format, w, h, t->remap & 0xFFFFu, t->dimension,
+            zdepth_index_at(t->location, t->offset), p ? "mapped" : "unmapped", nz, tot, p ? mn : 0, mx, tot ? sum / tot : 0);
+}
+
