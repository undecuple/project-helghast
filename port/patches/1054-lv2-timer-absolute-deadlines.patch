diff --git a/runtime/syscalls/sys_timer_sched.h b/runtime/syscalls/sys_timer_sched.h
new file mode 100644
index 00000000..fbb678c1
--- /dev/null
+++ b/runtime/syscalls/sys_timer_sched.h
@@ -0,0 +1,85 @@
+/*
+ * ps3recomp - periodic timer schedule arithmetic (KZ3 patch 1054)
+ *
+ * Pure integer arithmetic for lv2 periodic timers (sys_timer_start with a
+ * period): deadlines are ABSOLUTE, deadline(n) = base + n * period, computed
+ * from the tick number n in microseconds and converted to host counter ticks
+ * (QPC) each time, so a period that is not a whole number of counter ticks or
+ * of milliseconds never accumulates rounding error, and a late wake does not
+ * push the following deadlines back (no drift).
+ *
+ * Catch-up policy (lv2_tsched_fire): after the event for deadline n is sent,
+ * the next deadline is n + 1. If the thread woke so late that more than
+ * `catchup` further deadlines have already passed, the missed ones are SKIPPED:
+ * n jumps to the first deadline strictly after `now`, keeping the original
+ * phase (base + k * period). A short hiccup (<= catchup periods) is recovered by
+ * firing the missed deadlines back to back, so titles that count ticks keep the
+ * count; a long stall does not turn into a burst of stale events (the guest
+ * queue would mostly drop them anyway). catchup = 0 never bursts.
+ *
+ * Header-only and free of OS calls so the host test (tools/spu/test_timer_sched.c
+ * in the KZ3 repo) builds it on Linux.
+ */
+#ifndef PS3RECOMP_SYS_TIMER_SCHED_H
+#define PS3RECOMP_SYS_TIMER_SCHED_H
+
+#include <stdint.h>
+
+typedef struct lv2_tsched {
+    int64_t  base;       /* counter value of tick 0 (the start) */
+    int64_t  freq;       /* counter ticks per second (> 0) */
+    uint64_t period_us;  /* period in microseconds (> 0) */
+    uint64_t n;          /* number of the next deadline to wait for (>= 1) */
+} lv2_tsched;
+
+/* us -> counter ticks (split multiply: no overflow while us / 1e6 * freq fits in 64 bits) */
+static inline int64_t lv2_tsched_us_to_ticks(uint64_t us, int64_t freq)
+{
+    const uint64_t f = (uint64_t)freq;
+    return (int64_t)((us / 1000000ULL) * f + ((us % 1000000ULL) * f) / 1000000ULL);
+}
+
+/* counter ticks -> us (truncated); d >= 0 */
+static inline uint64_t lv2_tsched_ticks_to_us(int64_t d, int64_t freq)
+{
+    const uint64_t u = (uint64_t)d, f = (uint64_t)freq;
+    return (u / f) * 1000000ULL + ((u % f) * 1000000ULL) / f;
+}
+
+static inline void lv2_tsched_init(lv2_tsched* s, int64_t now, int64_t freq, uint64_t period_us)
+{
+    s->base = now;
+    s->freq = freq;
+    s->period_us = period_us;
+    s->n = 1;
+}
+
+static inline int64_t lv2_tsched_deadline_n(const lv2_tsched* s, uint64_t n)
+{
+    return s->base + lv2_tsched_us_to_ticks(n * s->period_us, s->freq);
+}
+
+static inline int64_t lv2_tsched_deadline(const lv2_tsched* s)
+{
+    return lv2_tsched_deadline_n(s, s->n);
+}
+
+/* Call after sending the event for deadline s->n at counter value `now`
+ * (now >= deadline). Advances s->n and returns how many deadlines were
+ * skipped (0 = none). */
+static inline uint64_t lv2_tsched_fire(lv2_tsched* s, int64_t now, unsigned catchup)
+{
+    s->n++;
+    if (now < lv2_tsched_deadline_n(s, s->n + catchup))
+        return 0; /* at most `catchup` deadlines already due: fire them in turn */
+    /* first deadline strictly after now, same phase */
+    const uint64_t el = lv2_tsched_ticks_to_us(now - s->base, s->freq);
+    uint64_t m = el / s->period_us + 1;
+    while (lv2_tsched_deadline_n(s, m) <= now) m++;
+    while (m > s->n && lv2_tsched_deadline_n(s, m - 1) > now) m--;
+    const uint64_t skipped = m - s->n;
+    s->n = m;
+    return skipped;
+}
+
+#endif /* PS3RECOMP_SYS_TIMER_SCHED_H */
