+/* Patch 2063 (KZ3 RSX pass 63): a texture that reads a host zeta gets an SRV of exactly its own size.
+ * The R32F snapshot is as large as the biggest pass that used the zeta offset (patch 2022), so two
+ * surfaces of different sizes at one address share it. KZ3 (Pyrrhus Outskirts and other 512x512-cascade
+ * levels) draws its near sun-shadow cascade, a 512x512 Z16 map, at 0x2980000, which is also its 640x360
+ * half-resolution depth: the snapshot is 640x512. The sun pass samples the map with normalised
+ * coordinates (DEPTH16 compare, linear, clamp), so on the 640-wide snapshot every lookup landed 1.25x
+ * too far right and the receivers indoors read the cleared or stale depth: sunlight in the stairwell, lit
+ * plaster too bright. A 2D SRV cannot select a sub-rectangle, so the top-left w x h of the snapshot is
+ * copied into a w x h R32F texture (kept per zeta and size, recopied only after the snapshot changed).
+ * Clamp-to-edge, filtering, GetDimensions and unnormalised scaling then see the texture the guest
+ * declared. Returns the SRV slot, or -1 to bind the whole snapshot (sizes equal, the read is larger than
+ * the snapshot, or LD_ZWIN=0). */
+static int ld_zwin_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LD_ZWIN"); on = (e && e[0] == '0') ? 0 : 1;
+                  fprintf(stderr, "[zwin] %s (LD_ZWIN)\n", on ? "on" : "off"); }
+    return on;
+}
+static int zdepth_window(u32 i, u32 w, u32 h)
+{
+    zdepth_t* z = &g.zdepths[i];
+    if (!ld_zwin_on() || !z->snapshot || !w || !h) return -1;
+    if (w == z->snapshot_w && h == z->snapshot_h) return -1;
+    if (w > z->snapshot_w || h > z->snapshot_h) return -1;
+    static u32 use_clock;
+    u32 k = LD_ZWIN_PER;
+    for (u32 j = 0; j < LD_ZWIN_PER; j++)
+        if (z->win[j].tex && z->win[j].w == w && z->win[j].h == h) { k = j; break; }
+    if (k == LD_ZWIN_PER) {
+        k = 0;
+        for (u32 j = 1; j < LD_ZWIN_PER; j++)
+            if (!z->win[j].tex || (z->win[k].tex && z->win[j].used < z->win[k].used)) k = j;
+        if (z->win[k].tex) retire_texture(z->win[k].tex);   /* the open command list may still read it */
+        z->win[k].tex = NULL;
+        D3D12_HEAP_PROPERTIES hp = {0};
+        hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+        D3D12_RESOURCE_DESC rd = {0};
+        rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+        rd.Width = w; rd.Height = h;
+        rd.DepthOrArraySize = 1; rd.MipLevels = 1;
+        rd.Format = DXGI_FORMAT_R32_FLOAT;
+        rd.SampleDesc.Count = 1;
+        ID3D12Resource* t = NULL;
+        if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+                D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, NULL, &IID_ID3D12Resource, (void**)&t))) {
+            static u32 n_fail;
+            if (n_fail++ < 8)
+                fprintf(stderr, "[zwin] create failed %u:0x%X %ux%u: whole snapshot bound\n",
+                        z->location, z->offset, w, h);
+            return -1;
+        }
+        z->win[k].tex = t; z->win[k].w = w; z->win[k].h = h; z->win[k].gen = z->snap_gen - 1u;
+        srv_write_zdepth(SRV_ZWIN_BASE + i * LD_ZWIN_PER + k, t);
+        static u32 n_log;
+        if (n_log++ < 16)
+            fprintf(stderr, "[zwin] %u:0x%X snapshot %ux%u -> window %ux%u (slot %u.%u)\n",
+                    z->location, z->offset, z->snapshot_w, z->snapshot_h, w, h, i, k);
+    }
+    z->win[k].used = ++use_clock;
+    if (z->win[k].gen != z->snap_gen) {
+        D3D12_RESOURCE_BARRIER b[2] = {0};
+        b[0].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b[0].Transition.pResource = z->snapshot;
+        b[0].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        b[0].Transition.StateBefore = z->snapshot_state;
+        b[0].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+        b[1].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b[1].Transition.pResource = z->win[k].tex;
+        b[1].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        b[1].Transition.StateBefore = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+        b[1].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+        g.list->lpVtbl->ResourceBarrier(g.list, 2, b);
+        D3D12_TEXTURE_COPY_LOCATION dst = {0}, src = {0};
+        dst.pResource = z->win[k].tex; dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        src.pResource = z->snapshot;   src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        D3D12_BOX box = { 0, 0, 0, w, h, 1 };
+        g.list->lpVtbl->CopyTextureRegion(g.list, &dst, 0, 0, 0, &src, &box);
+        b[0].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+        b[0].Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+        b[1].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+        b[1].Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+        g.list->lpVtbl->ResourceBarrier(g.list, 2, b);
+        z->snapshot_state = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+        z->win[k].gen = z->snap_gen;
+        if ((++g_ld_zwin_copies & 0x3FFFu) == 1u)
+            fprintf(stderr, "[zwin] copies=%llu frame=%u\n", (unsigned long long)g_ld_zwin_copies, g_ld_frames);
+    }
+    return (int)(SRV_ZWIN_BASE + i * LD_ZWIN_PER + k);
+}
