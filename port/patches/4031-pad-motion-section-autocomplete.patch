diff --git a/libs/input/pad_assist_drive.h b/libs/input/pad_assist_drive.h
new file mode 100644
index 0000000..18f0f26
--- /dev/null
+++ b/libs/input/pad_assist_drive.h
@@ -0,0 +1,167 @@
+/* pad_assist_drive.h -- KZ3 patch 4031 (network pass 16). ENHANCEMENT, off by default: `[motion] autocomplete = off|hold`
+ * in keybinds.ini. Hold L3+R3 for 0.5 s (read from the pad packet after the bindings, so a keyboard gets it through
+ * whatever keys are bound to L3 and R3; LeftShift + V or Mouse2 by default) while a human controller is in a valve or
+ * charge section, and the post-hooks of patch 4030 drive the controller's own outputs (target hand angle, grab) through
+ * the game's ratchet until DisableValue / the arm windows are reached. The game's completion, sounds, animation and Lua
+ * run unchanged; no script is skipped. Nothing is read or written outside the sections. Platform-free (host test). */
+#ifndef PAD_ASSIST_DRIVE_H
+#define PAD_ASSIST_DRIVE_H
+
+#include "pad_assist.h"
+
+#define PAS_HOLD_MS     500u     /* L3+R3 held this long engages the autocomplete */
+#define PAS_REACH_EPS   0.02f    /* rad: hand "at" its target */
+
+enum { PAS_OFF = 0, PAS_HOLD = 1, PAS_N_MODES };
+static inline int pas_mode_by_name(const char* s, size_t n)
+{
+    size_t i;
+    char b[8];
+    if (n == 0 || n >= sizeof b) return -1;
+    for (i = 0; i < n; i++) b[i] = (char)((s[i] >= 'A' && s[i] <= 'Z') ? s[i] + 32 : s[i]);
+    b[n] = 0;
+    if (!strcmp(b, "off") || !strcmp(b, "0") || !strcmp(b, "no")) return PAS_OFF;
+    if (!strcmp(b, "hold")) return PAS_HOLD;
+    return -1;
+}
+static inline const char* pas_mode_name(int m) { return m == PAS_HOLD ? "hold" : "off"; }
+
+/* ---- combo: both buttons held for PAS_HOLD_MS; returns +1 on the engage edge, -1 on release, else 0 ---- */
+typedef struct { unsigned long long since; int down, engaged; } PasCombo;
+static inline int pas_combo_step(PasCombo* c, int both_down, unsigned long long now_ms)
+{
+    if (!both_down) {
+        const int was = c->engaged;
+        c->down = 0;
+        c->engaged = 0;
+        return was ? -1 : 0;
+    }
+    if (!c->down) { c->down = 1; c->since = now_ms; }
+    if (!c->engaged && now_ms - c->since >= PAS_HOLD_MS) { c->engaged = 1; return 1; }
+    return 0;
+}
+
+/* ---- ratchet driver for the valve ---- */
+typedef struct { int phase;        /* 0 idle, 1 push (grab held, hand to the far limit), 2 return (grab released) */
+                 int flip;         /* 1 once a push moved the valve the wrong way */
+                 int pushes, done;
+                 float n0; } PasRatchet;
+static inline void pas_ratchet_reset(PasRatchet* r) { memset(r, 0, sizeof *r); }
+
+/* One update. n = valve position 0..1 ((angle - Min)/(Max - Min)), disable = DisableValue, hand = the hand angle,
+ * lo/hi = the hand limits (rad). Writes the controller outputs: *target (rad) and *grab (0.0 held / 1.0 released).
+ * Returns 0 running, 1 done (n reached DisableValue's side), -1 unusable input (non-finite, empty limits). *ev gets 1
+ * when a push started, 2 when a return started, 3 on a wrong-way flip (for the log), else 0. */
+static inline int pas_ratchet_step(PasRatchet* r, float n, float disable, float hand, float lo, float hi,
+                                   float* target, float* grab, int* ev)
+{
+    float far_, near_;
+    int want;
+    *ev = 0;
+    if (!isfinite(n) || !isfinite(disable) || !isfinite(hand) || !isfinite(lo) || !isfinite(hi)) return -1;
+    if (!(hi > lo + 0.05f)) return -1;
+    {
+        const int s = disable > n ? 1 : -1;   /* +1: the angle has to go up */
+        if ((s > 0 && n >= disable) || (s < 0 && n <= disable)) { r->done = 1; return 1; }
+        want = r->flip ? -s : s;              /* hand direction that moves the valve toward DisableValue */
+    }
+    far_ = want > 0 ? hi : lo;
+    near_ = want > 0 ? lo : hi;
+    if (r->phase == 0) { r->phase = 1; r->n0 = n; *ev = 1; }
+    if (r->phase == 1) {
+        *target = far_;
+        *grab = 0.0f;
+        if (fabsf(hand - far_) < PAS_REACH_EPS) {
+            const float moved = (n - r->n0) * (float)(disable > n ? 1 : -1);
+            r->pushes++;
+            if (moved < -1e-4f) {   /* that push moved the valve away from DisableValue: the other hand direction is right */
+                r->flip ^= 1;
+                r->n0 = n;
+                *ev = 3;
+                *target = near_;    /* the old near limit is the new far one; the grab stays held */
+            } else {
+                r->phase = 2;
+                *target = near_;
+                *grab = 1.0f;
+            }
+        }
+    } else {
+        *target = near_;
+        *grab = 1.0f;
+        if (fabsf(hand - near_) < PAS_REACH_EPS) { r->phase = 1; r->n0 = n; *target = far_; *grab = 0.0f; *ev = 2; }
+    }
+    return 0;
+}
+
+/* ---- the drivers' state ---- */
+typedef struct {
+    int mode;                          /* PAS_OFF / PAS_HOLD ([motion] autocomplete) */
+    PasCombo combo;
+    PasRatchet rt;
+    int v_active;                      /* valve: 0 idle, 1 driving, -1 unusable values (logged once) */
+    int c_active, c_idx;
+    unsigned long long c_t;
+} PasDrive;
+static inline int pas_engaged(const PasDrive* d) { return d->mode == PAS_HOLD && d->combo.engaged; }
+
+/* Valve post-hook: marks (patch 4030) and, while engaged, drives the controller outputs. Returns 1 when it wrote. */
+static inline int pas_valve_post(PasState* st, PasDrive* d, uint8_t* vm, uint32_t ctrl, unsigned long long now)
+{
+    PasView v;
+    float target = 0, grab = 1;
+    int ev = 0, rc;
+    if (!pas_valve_mark(st, vm, ctrl, now, &v)) return 0;
+    if (v.fresh) { pas_ratchet_reset(&d->rt); d->v_active = 0; }
+    if (!pas_engaged(d)) {
+        if (d->v_active) { d->v_active = 0; pas_ratchet_reset(&d->rt); printf("[assist] valve autocomplete released n=%.3f\n", (double)v.n); }
+        return 0;
+    }
+    if (d->rt.done) return 0;
+    rc = pas_ratchet_step(&d->rt, v.n, v.dis, v.hand, v.lo, v.hi, &target, &grab, &ev);
+    if (rc < 0) { if (d->v_active != -1) { d->v_active = -1; printf("[assist] valve: unusable resource values, not driven\n"); } return 0; }
+    if (rc == 1) {
+        d->v_active = 0;
+        printf("[assist] valve done n=%.3f (disable=%.3f, sweeps=%d)\n", (double)v.n, (double)v.dis, d->rt.pushes);
+        return 0;
+    }
+    if (d->v_active != 1) { d->v_active = 1; printf("[assist] combo held: valve autocomplete engaged n=%.3f\n", (double)v.n); }
+    if (ev == 1 || ev == 2) printf("[assist] valve sweep push n=%.3f hand=%.3f\n", (double)v.n, (double)v.hand);
+    if (ev == 3) printf("[assist] valve: that push moved the valve the wrong way, direction flipped n=%.3f\n", (double)v.n);
+    pas_wf(vm, ctrl + 0x108, target);
+    pas_wf(vm, ctrl + 0x114, target);   /* the follower's previous value: the next update clamps against it */
+    pas_wf(vm, ctrl + 0x10C, grab);
+    pas_wf(vm, ctrl + 0x110, grab);
+    return 1;
+}
+
+/* Charge post-hook. The arm windows alternate (ISA_D_Charge: centres +-0.7854 rad, ArmStepTime 0), the grab byte is
+ * held, and each window is held long enough for the hand to arrive at MaxRotationSpeed (the hand angle is not read:
+ * ASSUMPTION, the field is not mapped). */
+static inline int pas_charge_post(PasState* st, PasDrive* d, uint8_t* vm, uint32_t ctrl, unsigned long long now)
+{
+    PasView v;
+    float prev, hold_s, t;
+    if (!pas_charge_mark(st, vm, ctrl, now, &v)) return 0;
+    if (v.fresh) { d->c_active = 0; d->c_idx = 0; }
+    if (!pas_engaged(d) || v.nwin < 1) {
+        if (d->c_active) { d->c_active = 0; printf("[assist] charge autocomplete released\n"); }
+        return 0;
+    }
+    if (!d->c_active) { d->c_active = 1; d->c_t = now; d->c_idx = 0; printf("[assist] combo held: charge autocomplete engaged\n"); }
+    if (d->c_idx >= v.nwin) d->c_idx = 0;
+    prev = v.cen[(d->c_idx + v.nwin - 1) % v.nwin];
+    hold_s = (v.spd > 0.1f ? fabsf(v.cen[d->c_idx] - prev) / v.spd : 0.0f) + 0.15f + (isfinite(v.step) && v.step > 0 ? v.step : 0.0f);
+    if (now - d->c_t >= (unsigned long long)(hold_s * 1000.0f)) {
+        d->c_idx = (d->c_idx + 1) % v.nwin;
+        d->c_t = now;
+        printf("[assist] charge window %d centre=%.4f\n", d->c_idx, (double)v.cen[d->c_idx]);
+    }
+    t = v.cen[d->c_idx];
+    if (v.amx > v.amn) t = t < v.amn ? v.amn : t > v.amx ? v.amx : t;
+    pas_wf(vm, ctrl + 0x108, t);
+    pas_wf(vm, ctrl + 0x118, t);
+    vm[ctrl + 0x114] = 1;
+    return 1;
+}
+
+#endif
