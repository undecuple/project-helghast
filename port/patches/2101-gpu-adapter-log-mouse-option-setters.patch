+/* Options > Mouse rows (patch 2101, RSX pass 96): sensitivity and the zoom factor are steppers from 0.5 to 10 in steps
+ * of 0.5 (the page's selectitems are the same 20 numbers); kz3.ini [input] keeps them. Pure helpers (host test
+ * tools/smoke/test_mouse_opts.c). */
+#define PAD_MOUSE_OPT_MIN   0.5f
+#define PAD_MOUSE_OPT_MAX   10.0f
+#define PAD_MOUSE_OPT_STEP  0.5f
+
+/* v clamped to [0.5, 10] and snapped to the nearest 0.5; not a finite number -> def (also snapped). */
+static inline float pad_mouse_opt_clamp(float v, float def)
+{
+    if (!isfinite(v)) v = def;
+    if (v < PAD_MOUSE_OPT_MIN) v = PAD_MOUSE_OPT_MIN;
+    if (v > PAD_MOUSE_OPT_MAX) v = PAD_MOUSE_OPT_MAX;
+    return floorf(v / PAD_MOUSE_OPT_STEP + 0.5f) * PAD_MOUSE_OPT_STEP;
+}
+/* One step up (dir > 0) or down (dir < 0), stopping at the ends. */
+static inline float pad_mouse_opt_step(float v, int dir)
+{
+    v = pad_mouse_opt_clamp(v, PAD_MOUSE_USER_SENS_DEF);
+    return pad_mouse_opt_clamp(v + (dir > 0 ? PAD_MOUSE_OPT_STEP : dir < 0 ? -PAD_MOUSE_OPT_STEP : 0.0f), v);
+}
+/* "2.5", "10": no trailing zero, no ".0" (what the row shows and what kz3.ini keeps). */
+static inline int pad_mouse_opt_fmt(char* out, size_t n, float v)
+{
+    v = pad_mouse_opt_clamp(v, PAD_MOUSE_USER_SENS_DEF);
+    return (v == floorf(v)) ? snprintf(out, n, "%d", (int)v) : snprintf(out, n, "%.1f", v);
+}
+
+/* kz3.ini text with `key = value` set in the [input] section: the key's own line when it exists (any section, as
+ * kz3_ini_get reads), else a new line right under [input], else a new [input] section at the end. Everything else
+ * stays byte for byte. -> bytes written (excluding the NUL), or -1 when `cap` is too small. */
+static inline int pad_mouse_ini_upsert(const char* in, char* out, size_t cap, const char* key, const char* val)
+{
+    const size_t kl = strlen(key);
+    const char* p = in;
+    const char* line_s = NULL; const char* line_e = NULL;   /* the key's line: value span */
+    const char* sec_e = NULL;                               /* end of the [input] header line (incl. newline) */
+    while (*p) {
+        const char* eol = p;
+        while (*eol && *eol != '\n' && *eol != '\r') eol++;
+        const char* nx = eol;
+        while (*nx == '\n' || *nx == '\r') nx++;
+        const char* s = p;
+        while (s < eol && (*s == ' ' || *s == '\t')) s++;
+        if (s < eol && *s == '[') {
+            if ((size_t)(eol - s) >= 7 && !strncmp(s, "[input]", 7)) sec_e = nx;
+        } else if (s < eol && *s != ';' && *s != '#') {
+            const char* eq = s;
+            while (eq < eol && *eq != '=') eq++;
+            const char* ke = eq;
+            while (ke > s && (ke[-1] == ' ' || ke[-1] == '\t')) ke--;
+            if (eq < eol && (size_t)(ke - s) == kl) {
+                size_t i = 0;
+                while (i < kl && (s[i] | 0x20) == (key[i] | 0x20)) i++;
+                if (i == kl && !line_s) { line_s = eq + 1; line_e = eol; }
+            }
+        }
+        p = nx;
+    }
+    const size_t il = strlen(in), vl = strlen(val);
+    size_t o = 0;
+#define PM_PUT(ptr, len) do { if (o + (len) + 1 > cap) return -1; memcpy(out + o, (ptr), (len)); o += (len); } while (0)
+    if (line_s) {   /* replace the value, keep the key text and the comment-free rest of the line */
+        PM_PUT(in, (size_t)(line_s - in));
+        PM_PUT(" ", 1);
+        PM_PUT(val, vl);
+        PM_PUT(line_e, il - (size_t)(line_e - in));
+    } else if (sec_e) {
+        PM_PUT(in, (size_t)(sec_e - in));
+        if (sec_e > in && sec_e[-1] != '\n' && sec_e[-1] != '\r') PM_PUT("\n", 1);
+        PM_PUT(key, kl); PM_PUT(" = ", 3); PM_PUT(val, vl); PM_PUT("\n", 1);
+        PM_PUT(sec_e, il - (size_t)(sec_e - in));
+    } else {
+        PM_PUT(in, il);
+        if (il && in[il - 1] != '\n') PM_PUT("\n", 1);
+        if (il) PM_PUT("\n", 1);
+        PM_PUT("[input]\n", 8);
+        PM_PUT(key, kl); PM_PUT(" = ", 3); PM_PUT(val, vl); PM_PUT("\n", 1);
+    }
+#undef PM_PUT
+    out[o] = 0;
+    return (int)o;
+}
