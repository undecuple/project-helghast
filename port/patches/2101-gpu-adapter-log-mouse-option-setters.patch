+/* Patch 2101: the one-line adapter summary the support package looks for (tools/release/support.py GPU_RX: "adapter"
+ * ... a vendor name). `software`: 1 = DXGI_ADAPTER_FLAG_SOFTWARE (WARP), 0 = hardware, -1 = unknown. The vendor
+ * word comes from the PCI vendor id, so a driver description without it still names one. */
+static inline const char* rsx_vendor_name(unsigned id)
+{
+    switch (id) {
+    case 0x10DE: return "NVIDIA";
+    case 0x1002: case 0x1022: return "AMD";
+    case 0x8086: return "Intel";
+    case 0x1414: return "Microsoft";
+    default: return "";
+    }
+}
+static inline int rsx_adapter_line(char* out, size_t n, const char* name, unsigned vendor, unsigned device,
+                                   unsigned long long vram_mb, int software)
+{
+    const char* vn = rsx_vendor_name(vendor);
+    return snprintf(out, n, "[rsx] D3D12 adapter: %s (vendor 0x%04X%s%s device 0x%04X), %llu MB, %s", name, vendor,
+                    *vn ? " " : "", vn, device, vram_mb,
+                    software == 1 ? "software (WARP)" : software == 0 ? "hardware" : "hardware or software unknown");
+}
