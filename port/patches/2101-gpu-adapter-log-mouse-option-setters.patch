+/* Patch 2101: Options > Mouse. The look thread reads s_cfg once per update; a torn read of a float is not possible on
+ * the platforms we build for, and a stale one is one update old. */
+void pad_mouse_opts_set(float user, float zoom, int invert)
+{
+    pm_init();
+    s_user = pad_mouse_opt_clamp(user, PAD_MOUSE_USER_SENS_DEF);
+    s_cfg.zoom_sens = pad_mouse_opt_clamp(zoom, 1.0f);
+    s_cfg.invert = invert ? 1 : 0;
+    s_cfg.sens = pad_mouse_rad_per_count(s_user, s_deg, NULL);
+}
+void pad_mouse_opts_get(float* user, float* zoom, int* invert)
+{
+    pm_init();
+    if (user) *user = s_user;
+    if (zoom) *zoom = s_cfg.zoom_sens;
+    if (invert) *invert = s_cfg.invert;
+}
