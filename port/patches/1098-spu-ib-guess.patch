+/* KZ3 patch 1098 (SPU pass 73): lift-time guesses for computed hops. A software-pipelined SPU loop closes with
+ * `bi rX` where rX = selb(head, exit, cond) and head was loaded by `ila` (the audio mixer jobs' loops: 0xD100 ->
+ * 0xD2DC -> 0xD100 ...); every iteration went through spu_ib_direct (an out-of-line call, the memo hash and load,
+ * the registry load and an indirect jump: 9.9 % of the audio SPU thread in SPU pass 72). The lifter now finds
+ * such constants (tools/spu_lifter.py compute_ib_guesses) and emits SPU_IB_HOP_G(ctx, T, SPU_IB_GUESS(ctx, G, F)...):
+ * when the target equals G and spu_ib_guess_ok() holds, it is a direct tail call of F, the lifted function at G of
+ * the same image. spu_ib_guess_ok() is spu_ib_direct's tests for that constant, each the same or stricter (a
+ * stricter one only sends the hop down the old path), and the lookup is replaced by an image test: the lifted
+ * TU's s_spu_ib_gid is its image id, set at registration only when spu_lookup(G, id) returns F for every guess
+ * of the TU (spu_ib_guess_register; the registry is append-only and a lookup returns the first match in
+ * registration order, so that answer never changes); spu_ib_direct asks the resident overlay first, then the
+ * context's image, so the guess runs only when the resident overlay is that image, or there is none and the
+ * context's image is. KZ3_SPU_IBGUESS=0 = the old path (one exe for an A/B); KZ3_HOP_STATS=1 counts guess hops. */
+extern int g_spu_ib_guess;                 /* 0 off/undecided, 1 on, 2 on and counted (spu_drain.c spu_hop_init) */
+extern volatile unsigned long long g_spu_ib_guess_n;
+extern int g_kz3_pmend_ib;                 /* spu_channels.c */
+extern void* volatile g_kz3_trace_ctx;     /* spu_channels.c */
+extern int g_spu_ovl_skip_any;             /* spu_channels.c */
+extern uint8_t g_spu_ovl_skip[512];        /* spu_channels.c s_ovl_skip (KZ3_OVL_SKIP_MAX) */
+extern uint64_t g_spu_task_entry_bits[16]; /* spu_channels.c (patch 1097 filters) */
+extern uint64_t g_spu_task_pol_bits[16];
+extern int g_spu_task_pol_big;
+#define SPU_IBG_TASKSET_TASK_LO 0x3000u    /* = SPU_TASKSET_TASK_LO (spu_channels.c, static assert there) */
+#define SPU_IBG_JOB_RETURN_LS   0x3FF00u   /* = SPU_JOB_RETURN_LS */
+int spu_ib_guess_register(const uint32_t* addrs, void (*const* fns)(spu_context*), int n);
+static inline __attribute__((always_inline)) int spu_ib_guess_ok(const spu_context* ctx, uint32_t g, int gid)
+{
+    if (g == 0 || g == 0xA00u || g == SPURS_TASKSET_PM_SYSCALL_LS || g == SPU_IBG_JOB_RETURN_LS || g == 0x4A40u ||
+        g == SPURS_PM_EXIT_TO_KERNEL_LS || g == SPURS_PM_SELECT_WORKLOAD_LS)
+        return 0;   /* constant: folds away (the lifter does not guess these) */
+    if (__builtin_expect(g_spu_ib_guess <= 0 || gid <= 0, 0)) return 0;
+    if (!(ctx->resident_ovl ? ctx->resident_ovl == gid : ctx->image_id == gid)) return 0;
+    if (!spu_hop_ok(ctx)) return 0;
+    if (ctx->irq_saved || g_kz3_pmend_ib != 0 || g_kz3_trace_ctx == (const void*)ctx || g_kz3_wtrace != 0 ||
+        ctx->image_id == SPU_RESOLVER_ONLY_IMAGE_ID || ctx->resident_task)
+        return 0;
+    /* patch 1043/1044 skip or entry hook: spu_ib_direct's own test (the job manager's call of a marked module) */
+    if (g_spu_ovl_skip_any && ctx->resident_ovl > 0 && ctx->resident_ovl < 512 && g_spu_ovl_skip[ctx->resident_ovl] &&
+        ctx->image_id == 2 && g >= 0x4000 && g < 0x3E000 && (ctx->gpr[0]._u32[0] & SPU_LS_MASK) < 0x4000)
+        return 0;
+    if (g >= SPU_IBG_TASKSET_TASK_LO) {
+        const unsigned ov = (unsigned)ctx->resident_ovl;
+        if (g_spu_task_pol_big || ov >= 1024u || (g_spu_task_pol_bits[ov / 64] >> (ov % 64) & 1)) return 0;
+        if (g_spu_task_entry_bits[(g >> 2) & 15] >> ((g >> 6) & 63) & 1) return 0;
+    }
+    for (unsigned slot = 0; slot < 4; ++slot)
+        if (ctx->resident_code[slot].image_id && g >= ctx->resident_code[slot].lsa &&
+            g - ctx->resident_code[slot].lsa < ctx->resident_code[slot].size)
+            return 0;
+    return 1;
+}
+/* one guess: target G, lifted function F of this image (inside SPU_IB_HOP_G only; s_spu_ib_gid is the lifted TU's) */
+#define SPU_IB_GUESS(ctx, G, F)                                                                  \
