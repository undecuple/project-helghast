+# KZ3 patch 1098: addresses a computed hop never guesses (runtime specials, spu_ib_guess_ok in spu_context.h)
+_IB_GUESS_EXCLUDE = {0, 0xA00, 0x9C0, 0x9D0, 0xA70, 0x4A40, 0x3FF00}
+
+
+def compute_ib_guesses(insns, func_starts, sites, window=512, max_guesses=2) -> dict:
+    """KZ3 patch 1098: likely targets of computed hops, for SPU_IB_HOP_G.
+
+    A software-pipelined SPU loop closes with `bi rX`, rX = selb(head, exit, cond), head loaded by `ila` before the
+    loop (the audio mixer jobs: `ila $r38,0xD100` ... `selb $r42,$r38,$r0,$r35` ... `bi $r42` in the next function).
+    From each site, scan back in address order (not control flow: a guess is only a hint, checked at run time) for
+    the nearest writer of the target register; follow selb (both value operands), copies (ori/ai with 0) and stop at
+    il/ila constants that start a lifted function. Returns {site addr: [guess addrs]} for sites with a guess."""
+    ordered = sorted(insns, key=lambda x: x.addr)
+    idx_of = {ins.addr: i for i, ins in enumerate(ordered)}
+
+    def resolve(reg, start_idx, depth, out):
+        if depth > 4 or len(out) >= max_guesses:
+            return
+        for j in range(start_idx, max(-1, start_idx - window), -1):
+            w = ordered[j]
+            if w.mnemonic in _NO_RT_WRITE or _dest_reg(w) != reg or _is_identity_move(w):
+                continue
+            ops = _ops(w.operands)
+            if w.mnemonic in ("il", "ila") and len(ops) >= 2:
+                try:
+                    c = int(ops[1], 0) & 0x3FFFF
+                except ValueError:
+                    return
+                if c in func_starts and c not in _IB_GUESS_EXCLUDE and c not in out:
+                    out.append(c)
+                return
+            if w.mnemonic == "selb" and len(ops) >= 3:
+                for r in (ops[1], ops[2]):
+                    rr = _reg(r)
+                    if rr.isdigit():
+                        resolve(int(rr), j - 1, depth + 1, out)
+                return
+            if w.mnemonic in ("ori", "ai") and len(ops) == 3 and ops[2].strip() in ("0", "0x0"):
+                rr = _reg(ops[1])
+                if rr.isdigit():
+                    resolve(int(rr), j - 1, depth + 1, out)
+                return
+            return
+        return
+
+    guesses = {}
+    for a in sorted(sites):
+        insn = ordered[idx_of[a]]
+        r = _bi_target_reg(insn)
+        if r is None or not r.isdigit():
+            continue
+        out = []
+        resolve(int(r), idx_of[a] - 1, 0, out)
+        if out:
+            guesses[a] = out
+    return guesses
+
