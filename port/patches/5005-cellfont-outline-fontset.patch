diff -ruN a/libs/font/cellFontOutline.c b/libs/font/cellFontOutline.c
--- a/libs/font/cellFontOutline.c	1969-12-31 18:00:00.000000000 -0600
+++ b/libs/font/cellFontOutline.c	2026-10-14 21:26:39.520147440 -0500
@@ -0,0 +1,501 @@
+/*
+ * KZ3 patch 5005 - cellFont outline API on real fonts (system fontset).
+ *
+ * KZ3 opens exactly one system font (cellFontOpenFontset type 0x109), never renders through the library, and reads
+ * glyph OUTLINES: cellFontGetCharGlyphMetrics('M') once, then cellFontGenerateCharGlyph / cellFontDeleteGlyph per
+ * character, converting the contours itself (EBOOT 0x588B4, 0x594C4, 0x58970). Without these functions the imports fell
+ * into the unresolved-NID path (CELL_OK, out-parameters untouched) and every Cyrillic, Hangul, kana and Han glyph was
+ * blank.
+ *
+ * Font sources, tried per code point in this order (the first font whose cmap has the character wins):
+ *   1. the player's own firmware fonts: $KZ3_FONT_DIR/SCE-PS3-*.TTF (the dev_flash/data/font folder an emulator creates);
+ *   2. bundled open fonts (Noto, SIL OFL 1.1): $KZ3_FONT_FALLBACK_DIR, else <exe dir>/fonts, else ./fonts.
+ * Nothing is extracted or decrypted here; the files are read as they are. Only TrueType/OpenType files stb_truetype
+ * reads; cubic (CFF) outlines are split into quadratics because the game's converter is TrueType-style only.
+ *
+ * Guest layout (decoded from 0x58970; offsets are the guest ABI, big-endian):
+ *   CellFontGlyph: +0x08 CellFontGlyphMetrics (8 floats: width, height, h_bearing_x, h_bearing_y, h_advance, v_bearing_x,
+ *   v_bearing_y, v_advance), so h_advance is at +0x18 where the game reads it for an empty glyph; +0x28 s16 contour
+ *   count; +0x2A s16 point count; +0x2C -> float x,y pairs; +0x30 -> u8 flags (0 = off-curve, else on-curve);
+ *   +0x34 -> u16 index of the last point of each contour. ASSUMPTION: y points up, as the game's own font resources do;
+ *   the bytes before +0x08 are zero.
+ * Glyph memory comes from a library-owned guest pool (no guest callbacks: the port ignores the memory interface the
+ * game passes to cellFontInitLibraryFreeType).
+ * Coordinates are pixels at the font's current scale (units * scale / unitsPerEm); KZ3 asks for 2048.
+ */
+#include "cellFont.h"
+#include "../../runtime/ppu/ppu_memory.h"
+#include "../../runtime/ppu/ppu_context.h"
+#include "../../include/ps3emu/nid.h"
+#include "stb_truetype.h"   /* declarations only; the implementation is compiled in cellFont.c */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#ifdef _WIN32
+#  include <windows.h>
+#else
+#  include <unistd.h>
+#endif
+#ifndef KZ3_FONT_NO_COMMIT
+#  include "../../runtime/memory/vm.h"   /* vm_commit */
+#  include "../../runtime/syscalls/sys_memory.h"   /* sys_memory_alloc_window (patch 1113) */
+#endif
+
+/* Defined in cellFont.c. */
+s32 kz3_font_set_scale_pixel(u32 font_ea, float w, float h);
+int kz3_font_slot_stb(u32 handle, stbtt_fontinfo* out);
+
+/* ---- guest pool ---------------------------------------------------------------------------------------------- */
+/* The pool comes from sys_memory_alloc_window (patch 1113): a committed window in the mapper range that neither the
+ * mapper nor the user allocator hands to the title. A fixed 0xB8000000 sat inside v0.17.0's mapper range (SPU pass 97).
+ * KZ3_FONT_POOL_BASE remains for the host test (KZ3_FONT_NO_COMMIT: no allocator, a fixed base in its own buffer). */
+#ifndef KZ3_FONT_POOL_BASE
+#  define KZ3_FONT_POOL_BASE 0x00080000u
+#endif
+#ifndef KZ3_FONT_POOL_SIZE
+#  define KZ3_FONT_POOL_SIZE 0x00400000u
+#endif
+#define POOL_MIN_BIN 7                 /* 128 bytes */
+#define POOL_BINS 24
+#define POOL_LIVE_MAX 2048
+
+static int      s_lock;
+static u32      s_pool_base;
+static u32      s_pool_bump;
+static int      s_pool_ready;
+static u32      s_free_head[POOL_BINS];   /* guest EA of the first free block of each bin (next pointer in its first word) */
+static struct { u32 ea; int bin; } s_live[POOL_LIVE_MAX];
+static int      s_live_n;
+
+static void lock(void)   { while (__atomic_test_and_set(&s_lock, __ATOMIC_ACQUIRE)) { } }
+static void unlock(void) { __atomic_clear(&s_lock, __ATOMIC_RELEASE); }
+
+static u32 pool_alloc(u32 bytes, int* bin_out)
+{
+    int bin = POOL_MIN_BIN;
+    while (bin < POOL_BINS - 1 && (1u << bin) < bytes) bin++;
+    lock();
+    if (!s_pool_ready) {
+#ifndef KZ3_FONT_NO_COMMIT
+        s_pool_base = sys_memory_alloc_window(KZ3_FONT_POOL_SIZE, 0x10000u);   /* committed */
+        if (!s_pool_base) { unlock(); return 0; }
+#else
+        s_pool_base = KZ3_FONT_POOL_BASE;
+#endif
+        s_pool_bump = s_pool_base;
+        s_pool_ready = 1;
+    }
+    u32 ea = 0;
+    if (s_free_head[bin]) {
+        ea = s_free_head[bin];
+        s_free_head[bin] = vm_read32(ea);
+    } else if (s_pool_bump + (1u << bin) <= s_pool_base + KZ3_FONT_POOL_SIZE) {
+        ea = s_pool_bump;
+        s_pool_bump += 1u << bin;
+    }
+    if (ea) {
+        if (s_live_n < POOL_LIVE_MAX) { s_live[s_live_n].ea = ea; s_live[s_live_n].bin = bin; s_live_n++; }
+        else { s_free_head[bin] = ea; ea = 0; }
+    }
+    unlock();
+    if (bin_out) *bin_out = bin;
+    return ea;
+}
+
+static void pool_free(u32 ea)
+{
+    lock();
+    for (int i = 0; i < s_live_n; i++) {
+        if (s_live[i].ea == ea) {
+            int bin = s_live[i].bin;
+            s_live[i] = s_live[--s_live_n];
+            vm_write32(ea, s_free_head[bin]);
+            s_free_head[bin] = ea;
+            break;
+        }
+    }
+    unlock();
+}
+
+/* ---- faces and chains ---------------------------------------------------------------------------------------- */
+typedef struct {
+    char            path[600];
+    int             index;      /* font index inside a .ttc collection (Noto Sans CJK: 0 jp, 1 kr, 2 sc, 3 tc) */
+    int             tried, ok;
+    unsigned char*  data;
+    stbtt_fontinfo  info;
+} KzFace;
+
+#define MAX_FACES 40
+#define MAX_CHAIN 24
+#define MAX_HANDLES 64
+static KzFace s_faces[MAX_FACES];
+static int    s_nfaces;
+
+typedef struct { KzFace* f[MAX_CHAIN]; int n; unsigned type; int han_version; int used; } KzChain;
+static KzChain s_chain[MAX_HANDLES];
+
+/* Han preference: which CJK font is tried first. jp (default), kr, sc, tc. $KZ3_FONT_HAN, or the port calls this. */
+static int s_han = 0, s_han_version = 1;
+void kz3_font_set_han_pref(const char* lang)
+{
+    static const char* names[] = { "jp", "kr", "sc", "tc" };
+    for (int i = 0; lang && i < 4; i++)
+        if (!strcmp(lang, names[i])) { if (s_han != i) { s_han = i; s_han_version++; } return; }
+}
+
+static int file_exists(const char* p) { FILE* f = fopen(p, "rb"); if (f) { fclose(f); return 1; } return 0; }
+
+/* First existing dir/base+ext over the usual spellings; returns 1 and fills out. */
+static int find_file(const char* dir, const char* base, char* out, size_t cap)
+{
+    static const char* exts[] = { ".TTF", ".ttf", ".OTF", ".otf", ".TTC", ".ttc" };
+    if (!dir || !*dir) return 0;
+    for (int i = 0; i < 6; i++) {
+        snprintf(out, cap, "%s/%s%s", dir, base, exts[i]);
+        if (file_exists(out)) return 1;
+    }
+    return 0;
+}
+
+static KzFace* face_for(const char* path, int index)
+{
+    for (int i = 0; i < s_nfaces; i++) if (s_faces[i].index == index && !strcmp(s_faces[i].path, path)) return &s_faces[i];
+    if (s_nfaces >= MAX_FACES) return NULL;
+    KzFace* f = &s_faces[s_nfaces++];
+    memset(f, 0, sizeof *f);
+    snprintf(f->path, sizeof f->path, "%s", path);
+    f->index = index;
+    return f;
+}
+
+/* Loads the file on first use (CJK files are large, so only when a code point is not found earlier in the chain). */
+static int face_load(KzFace* f)
+{
+    if (f->tried) return f->ok;
+    f->tried = 1;
+    FILE* fp = fopen(f->path, "rb");
+    if (!fp) return 0;
+    fseek(fp, 0, SEEK_END); long sz = ftell(fp); fseek(fp, 0, SEEK_SET);
+    if (sz <= 0) { fclose(fp); return 0; }
+    f->data = (unsigned char*)malloc((size_t)sz);
+    if (!f->data || fread(f->data, 1, (size_t)sz, fp) != (size_t)sz) { fclose(fp); free(f->data); f->data = NULL; return 0; }
+    fclose(fp);
+    if (!stbtt_InitFont(&f->info, f->data, stbtt_GetFontOffsetForIndex(f->data, f->index))) {
+        printf("[cellFont] fontset: cannot parse %s\n", f->path);
+        free(f->data); f->data = NULL; return 0;
+    }
+    f->ok = 1;
+    printf("[cellFont] fontset: loaded %s (%ld bytes)\n", f->path, sz);
+    return 1;
+}
+
+static void chain_add(KzChain* c, const char* path, int index)
+{
+    KzFace* f = face_for(path, index);
+    if (!f) return;
+    for (int i = 0; i < c->n; i++) if (c->f[i] == f) return;
+    if (c->n < MAX_CHAIN) c->f[c->n++] = f;
+}
+
+static void chain_add_fw(KzChain* c, const char* dir, const char* code)
+{
+    char base[96], path[600];
+    snprintf(base, sizeof base, "SCE-PS3-%s", code);
+    if (find_file(dir, base, path, sizeof path)) chain_add(c, path, 0);
+}
+
+static int chain_add_noto(KzChain* c, const char* dir, const char* const* names, int ttc_index)
+{
+    char path[600];
+    for (; *names; names++) if (find_file(dir, *names, path, sizeof path)) { chain_add(c, path, 0); return 1; }
+    /* The one-file Noto Sans CJK collection (NotoSansCJK-Regular.ttc) holds all four regions. */
+    if (ttc_index >= 0 && find_file(dir, "NotoSansCJK-Regular", path, sizeof path)) { chain_add(c, path, ttc_index); return 1; }
+    return 0;
+}
+
+static void exe_dir(char* out, size_t cap)
+{
+    out[0] = 0;
+#ifdef _WIN32
+    char p[600]; DWORD n = GetModuleFileNameA(NULL, p, sizeof p);
+    if (n > 0 && n < sizeof p) { while (n > 0 && p[n - 1] != '\\' && p[n - 1] != '/') n--; p[n ? n - 1 : 0] = 0; snprintf(out, cap, "%s", p); }
+#else
+    char p[600]; ssize_t n = readlink("/proc/self/exe", p, sizeof p - 1);
+    if (n > 0) { p[n] = 0; char* s = strrchr(p, '/'); if (s) { *s = 0; snprintf(out, cap, "%s", p); } }
+#endif
+}
+
+static void chain_build(KzChain* c, unsigned type)
+{
+    memset(c, 0, sizeof *c);
+    c->used = 1; c->type = type; c->han_version = s_han_version;
+    const char* han = getenv("KZ3_FONT_HAN");
+    if (han) kz3_font_set_han_pref(han);
+    c->han_version = s_han_version;
+
+    const char* fw = getenv("KZ3_FONT_DIR");
+    /* Firmware: the requested family first (0x1xx = Seurat Maru Gothic, else Rodin; low bits pick Light/Bold). */
+    if (fw && *fw) {
+        unsigned hi = (type >> 8) & 0xFF, lo = type & 3;
+        if (hi == 1) {
+            chain_add_fw(c, fw, "SR-R-LATIN"); chain_add_fw(c, fw, "SR-R-LATIN2");
+        } else {
+            char code[32]; const char w = lo == 1 ? 'L' : lo == 2 ? 'B' : 'R';
+            snprintf(code, sizeof code, "RD-%c-LATIN", w);  chain_add_fw(c, fw, code);
+            snprintf(code, sizeof code, "RD-%c-LATIN2", w); chain_add_fw(c, fw, code);
+        }
+        chain_add_fw(c, fw, "RD-R-LATIN"); chain_add_fw(c, fw, "RD-R-LATIN2");
+        chain_add_fw(c, fw, "SR-R-LATIN"); chain_add_fw(c, fw, "SR-R-LATIN2");
+        static const char* const han_fw[4][4] = {
+            { "SR-R-JPN", "NR-R-JPN", "YG-R-KOR", "DH-R-CGB" },
+            { "YG-R-KOR", "SR-R-JPN", "NR-R-JPN", "DH-R-CGB" },
+            { "DH-R-CGB", "SR-R-JPN", "NR-R-JPN", "YG-R-KOR" },
+            { "DH-R-CGB", "SR-R-JPN", "NR-R-JPN", "YG-R-KOR" } };
+        for (int i = 0; i < 4; i++) chain_add_fw(c, fw, han_fw[s_han][i]);
+        chain_add_fw(c, fw, "SR-R-EXT"); chain_add_fw(c, fw, "NR-R-EXT"); chain_add_fw(c, fw, "CP-R-KANA");
+    }
+    /* Bundled open fonts. */
+    char fb[640]; const char* e = getenv("KZ3_FONT_FALLBACK_DIR");
+    if (e && *e) snprintf(fb, sizeof fb, "%s", e);
+    else { char ed[600]; exe_dir(ed, sizeof ed); if (ed[0]) snprintf(fb, sizeof fb, "%s/fonts", ed); else fb[0] = 0; }
+    static const char* const n_latin[] = { "NotoSans-Regular", "NotoSans[wdth,wght]", NULL };
+    static const char* const n_jp[] = { "NotoSansJP-Regular", "NotoSansJP[wght]", "NotoSansCJKjp-Regular", NULL };
+    static const char* const n_kr[] = { "NotoSansKR-Regular", "NotoSansKR[wght]", "NotoSansCJKkr-Regular", NULL };
+    static const char* const n_sc[] = { "NotoSansSC-Regular", "NotoSansSC[wght]", "NotoSansCJKsc-Regular", NULL };
+    static const char* const n_tc[] = { "NotoSansTC-Regular", "NotoSansTC[wght]", "NotoSansCJKtc-Regular", NULL };
+    static const char* const* const order[4][4] = {
+        { n_jp, n_kr, n_sc, n_tc }, { n_kr, n_jp, n_sc, n_tc }, { n_sc, n_tc, n_jp, n_kr }, { n_tc, n_sc, n_jp, n_kr } };
+    static const int ttc_of[4][4] = { { 0, 1, 2, 3 }, { 1, 0, 2, 3 }, { 2, 3, 0, 1 }, { 3, 2, 0, 1 } };
+    const char* dirs[2] = { fb, "fonts" };
+    for (int d = 0; d < 2; d++) {
+        chain_add_noto(c, dirs[d], n_latin, -1);
+        for (int i = 0; i < 4; i++) chain_add_noto(c, dirs[d], order[s_han][i], ttc_of[s_han][i]);
+    }
+    printf("[cellFont] fontset type=0x%X: %d font file(s) in the chain (firmware dir %s, fallback dir %s)\n",
+           type, c->n, fw && *fw ? fw : "unset", fb[0] ? fb : "none");
+    if (c->n == 0)
+        printf("[cellFont] fontset: no fonts found. Set KZ3_FONT_DIR to a folder with SCE-PS3-*.TTF or put "
+               "NotoSans-Regular.ttf and NotoSans{JP,KR,SC,TC}-Regular.ttf in <exe dir>/fonts. Glyphs will be empty.\n");
+}
+
+/* Exported to cellFont.c. */
+void kz3_fontset_open(u32 handle, u32 type)
+{
+    if (handle >= MAX_HANDLES) return;
+    lock(); chain_build(&s_chain[handle], type); unlock();
+}
+void kz3_fontset_close(u32 handle)
+{
+    if (handle < MAX_HANDLES) s_chain[handle].used = 0;
+}
+/* First loadable face of the chain, so the library's bitmap functions have something too. */
+int kz3_fontset_primary(u32 handle, stbtt_fontinfo* out)
+{
+    if (handle >= MAX_HANDLES || !s_chain[handle].used) return 0;
+    lock();
+    int ok = 0;
+    for (int i = 0; i < s_chain[handle].n && !ok; i++)
+        if (face_load(s_chain[handle].f[i])) { *out = s_chain[handle].f[i]->info; ok = 1; }
+    unlock();
+    return ok;
+}
+
+/* The face and glyph index that draw `code` for this font handle (NULL when none has it). */
+static const stbtt_fontinfo* find_glyph(u32 handle, u32 code, int* glyph, stbtt_fontinfo* tmp)
+{
+    *glyph = 0;
+    if (handle >= MAX_HANDLES) return NULL;
+    KzChain* c = &s_chain[handle];
+    if (!c->used) {   /* not a fontset slot: the font opened from a file or memory */
+        if (kz3_font_slot_stb(handle, tmp)) { *glyph = stbtt_FindGlyphIndex(tmp, (int)code); return *glyph ? tmp : NULL; }
+        return NULL;
+    }
+    lock();
+    if (c->han_version != s_han_version) { unsigned t = c->type; chain_build(c, t); }
+    const stbtt_fontinfo* r = NULL;
+    for (int i = 0; i < c->n; i++) {
+        if (!face_load(c->f[i])) continue;
+        int g = stbtt_FindGlyphIndex(&c->f[i]->info, (int)code);
+        if (g) { *tmp = c->f[i]->info; *glyph = g; r = tmp; break; }
+    }
+    unlock();
+    return r;
+}
+
+/* ---- outline conversion -------------------------------------------------------------------------------------- */
+typedef struct { float x, y; unsigned char on; } Pt;
+typedef struct { Pt* p; int n, cap; unsigned short* ends; int nc, capc; } Outline;
+
+static int ol_pt(Outline* o, float x, float y, int on)
+{
+    if (o->n == o->cap) {
+        int nc = o->cap ? o->cap * 2 : 128;
+        Pt* np = (Pt*)realloc(o->p, (size_t)nc * sizeof(Pt));
+        if (!np) return 0;
+        o->p = np; o->cap = nc;
+    }
+    o->p[o->n].x = x; o->p[o->n].y = y; o->p[o->n].on = (unsigned char)on; o->n++;
+    return 1;
+}
+
+static void ol_close(Outline* o, int start)
+{
+    if (o->n <= start) return;
+    /* stb closes every contour with a line back to the start; the closing point duplicates the first one. */
+    if (o->n - start > 1 && o->p[o->n - 1].on && fabsf(o->p[o->n - 1].x - o->p[start].x) < 1e-3f &&
+        fabsf(o->p[o->n - 1].y - o->p[start].y) < 1e-3f)
+        o->n--;
+    if (o->nc == o->capc) {
+        int nc = o->capc ? o->capc * 2 : 16;
+        unsigned short* ne = (unsigned short*)realloc(o->ends, (size_t)nc * sizeof(unsigned short));
+        if (!ne) return;
+        o->ends = ne; o->capc = nc;
+    }
+    o->ends[o->nc++] = (unsigned short)(o->n - 1);
+}
+
+/* Cubic p0,c1,c2,p3 -> quadratics: split in halves `depth` times, each piece approximated by one quadratic whose
+ * control point is (3(c1+c2) - (p0+p3)) / 4 (exact for a cubic that is really a quadratic). 4 pieces at depth 2. */
+static void cubic_to_quads(Outline* o, float x0, float y0, float x1, float y1, float x2, float y2, float x3, float y3,
+                           int depth)
+{
+    if (depth == 0) {
+        ol_pt(o, (3 * (x1 + x2) - (x0 + x3)) / 4, (3 * (y1 + y2) - (y0 + y3)) / 4, 0);
+        ol_pt(o, x3, y3, 1);
+        return;
+    }
+    float ax = (x0 + x1) / 2, ay = (y0 + y1) / 2, bx = (x1 + x2) / 2, by = (y1 + y2) / 2, cx = (x2 + x3) / 2, cy = (y2 + y3) / 2;
+    float dx = (ax + bx) / 2, dy = (ay + by) / 2, ex = (bx + cx) / 2, ey = (by + cy) / 2;
+    float mx = (dx + ex) / 2, my = (dy + ey) / 2;
+    cubic_to_quads(o, x0, y0, ax, ay, dx, dy, mx, my, depth - 1);
+    cubic_to_quads(o, mx, my, ex, ey, cx, cy, x3, y3, depth - 1);
+}
+
+static int shape_to_outline(const stbtt_fontinfo* info, int glyph, float sx, float sy, Outline* o)
+{
+    stbtt_vertex* v = NULL;
+    int nv = stbtt_GetGlyphShape(info, glyph, &v);
+    int start = 0; float px = 0, py = 0;
+    for (int i = 0; i < nv; i++) {
+        float x = v[i].x * sx, y = v[i].y * sy, cx = v[i].cx * sx, cy = v[i].cy * sy, c1x = v[i].cx1 * sx, c1y = v[i].cy1 * sy;
+        switch (v[i].type) {
+        case STBTT_vmove:  ol_close(o, start); start = o->n; ol_pt(o, x, y, 1); break;
+        case STBTT_vline:  ol_pt(o, x, y, 1); break;
+        case STBTT_vcurve: ol_pt(o, cx, cy, 0); ol_pt(o, x, y, 1); break;
+        case STBTT_vcubic: cubic_to_quads(o, px, py, cx, cy, c1x, c1y, x, y, 2); break;
+        }
+        px = x; py = y;
+    }
+    ol_close(o, start);
+    if (v) stbtt_FreeShape(info, v);
+    return 1;
+}
+
+/* ---- API ------------------------------------------------------------------------------------------------------ */
+static float rd_f32(u32 ea) { uint32_t b = vm_read32(ea); float f; memcpy(&f, &b, 4); return f; }
+
+typedef struct { float m[8]; int found; } Metrics;
+
+static void glyph_metrics(u32 font, u32 code, Metrics* m, Outline* ol, float* sx_out, float* sy_out)
+{
+    memset(m, 0, sizeof *m);
+    float w = rd_f32(font + 8), h = rd_f32(font + 12);
+    u32 handle = vm_read32(font);
+    stbtt_fontinfo tmp; int g;
+    const stbtt_fontinfo* info = find_glyph(handle, code, &g, &tmp);
+    if (sx_out) *sx_out = w;
+    if (sy_out) *sy_out = h;
+    if (!info) {
+        int any = 0;
+        if (handle < MAX_HANDLES) any = s_chain[handle].used && s_chain[handle].n > 0;
+        if (!any && handle < MAX_HANDLES && s_chain[handle].used) {   /* no font at all: plausible metrics, no outline */
+            m->m[0] = w * 0.6f; m->m[1] = h * 0.7f; m->m[3] = h * 0.7f; m->m[4] = w * 0.6f; m->m[7] = h;
+        } else {
+            m->m[4] = w * 0.5f;   /* a missing code draws as an empty glyph of half an em */
+        }
+        return;
+    }
+    float em = stbtt_ScaleForMappingEmToPixels(info, 1.0f);   /* 1 / unitsPerEm */
+    float sx = em * w, sy = em * h;
+    int adv, lsb, x0, y0, x1, y1;
+    stbtt_GetGlyphHMetrics(info, g, &adv, &lsb);
+    if (!stbtt_GetGlyphBox(info, g, &x0, &y0, &x1, &y1)) { x0 = y0 = x1 = y1 = 0; }
+    int asc, desc, gap; stbtt_GetFontVMetrics(info, &asc, &desc, &gap);
+    m->found = 1;
+    m->m[0] = (x1 - x0) * sx;            /* width */
+    m->m[1] = (y1 - y0) * sy;            /* height */
+    m->m[2] = x0 * sx;                   /* h_bearing_x */
+    m->m[3] = y1 * sy;                   /* h_bearing_y: baseline to the top edge */
+    m->m[4] = adv * sx;                  /* h_advance */
+    m->m[5] = x0 * sx - adv * sx * 0.5f; /* v_bearing_x (ASSUMPTION: centred on the advance) */
+    m->m[6] = (asc - y1) * sy;           /* v_bearing_y (ASSUMPTION) */
+    m->m[7] = (asc - desc) * sy;         /* v_advance (ASSUMPTION) */
+    if (ol) shape_to_outline(info, g, sx, sy, ol);
+}
+
+s32 cellFontGetCharGlyphMetrics(u32 font, u32 code, u32 metrics)
+{
+    if (!font || !metrics) return CELL_FONT_ERROR_INVALID_PARAMETER;
+    Metrics m; glyph_metrics(font, code, &m, NULL, NULL, NULL);
+    for (int i = 0; i < 8; i++) vm_write_f32(metrics + 4u * i, m.m[i]);
+    return CELL_OK;
+}
+
+s32 cellFontGenerateCharGlyph(u32 font, u32 code, u32 glyph_out)
+{
+    if (!font || !glyph_out) return CELL_FONT_ERROR_INVALID_PARAMETER;
+    Metrics m; Outline ol; memset(&ol, 0, sizeof ol);
+    glyph_metrics(font, code, &m, &ol, NULL, NULL);
+    u32 n = (u32)ol.n, nc = (u32)ol.nc;
+    u32 o_pts = 0x40, o_flags = o_pts + 8 * n, o_ends = (o_flags + n + 1) & ~1u;
+    u32 bytes = o_ends + 2 * nc;
+    int bin;
+    u32 ea = pool_alloc(bytes, &bin);
+    if (!ea) { free(ol.p); free(ol.ends); vm_write32(glyph_out, 0); return CELL_FONT_ERROR_ALLOCATION_FAILED; }
+    for (u32 o = 0; o < 0x40; o += 4) vm_write32(ea + o, 0);
+    for (int i = 0; i < 8; i++) vm_write_f32(ea + 8 + 4u * i, m.m[i]);
+    vm_write16(ea + 0x28, (uint16_t)nc);
+    vm_write16(ea + 0x2A, (uint16_t)n);
+    vm_write32(ea + 0x2C, n ? ea + o_pts : 0);
+    vm_write32(ea + 0x30, n ? ea + o_flags : 0);
+    vm_write32(ea + 0x34, nc ? ea + o_ends : 0);
+    for (u32 i = 0; i < n; i++) {
+        vm_write_f32(ea + o_pts + 8 * i, ol.p[i].x);
+        vm_write_f32(ea + o_pts + 8 * i + 4, ol.p[i].y);
+        vm_write8(ea + o_flags + i, ol.p[i].on ? 1 : 0);
+    }
+    for (u32 i = 0; i < nc; i++) vm_write16(ea + o_ends + 2 * i, ol.ends[i]);
+    free(ol.p); free(ol.ends);
+    vm_write32(glyph_out, ea);
+    return CELL_OK;
+}
+
+s32 cellFontDeleteGlyph(u32 font, u32 glyph)
+{
+    (void)font;
+    if (glyph) pool_free(glyph);
+    return CELL_OK;
+}
+
+s32 cellFontEndLibrary(u32 lib)
+{
+    (void)lib;
+    return CELL_OK;
+}
+
+/* cellFontSetScalePixel(font, float w, float h): the floats arrive in f1/f2, which the flat integer-register HLE
+ * adapter cannot pass, so the flat cellFontSetScalePixel in cellFont.c received garbage. A context handler registered
+ * under the same NID takes precedence over the flat table. */
+static void hle_set_scale_pixel(ppu_context* ctx)
+{
+    ctx->gpr[3] = (u64)(s64)kz3_font_set_scale_pixel((u32)ctx->gpr[3], (float)ctx->fpr[1], (float)ctx->fpr[2]);
+}
+
+extern void ps3_hle_register_ctx(uint32_t nid, const char* name, void (*fn)(ppu_context*));
+__attribute__((constructor)) static void kz3_font_register(void)
+{
+    ps3_hle_register_ctx(ps3_compute_nid("cellFontSetScalePixel"), "cellFontSetScalePixel", hle_set_scale_pixel);
+    ps3_hle_register_ctx(ps3_compute_nid("cellFontSetupRenderScalePixel"), "cellFontSetupRenderScalePixel", hle_set_scale_pixel);
+}
