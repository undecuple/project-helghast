Rebased on ps3recomp v0.19.0 (group B pass 2, R&C 2026-11-09, on KZ3's group A r152): _cellSpursTasksetAttribute2Initialize, cellSpursCreateTaskset2
and cellSpursCreateTask2 are upstream's now (#629 42c0471d / 23066160: Taskset2 registered for exit codes, its two event flags
created, CreateTask2 takes the TaskAttribute2 context and LS pattern); ours, KZ3_SPURS_TASKSET2_SIZE and our 5th-argument
`name` ASSUMPTION are dropped (upstream reads that argument as the attribute). Kept: cellSpursTryJoinTask2,
cellSpursJoinTask2, cellSpursDestroyTaskset2 and kz3_task2_enabled: v0.19.0 defines none of them (their names appear only in
comments, the NID table and a test), so KZ3's r152 drop of 1019 would leave them unresolved. KZ3 to confirm.

diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
index fa75eab4..31180182 100644
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -1064,6 +1064,48 @@ s32 cellSpursCreateTaskset2(CellSpurs* spurs, CellSpursTaskset* taskset, u64 att
     return rc;
 }
 
+/* KZ3 patch 1019: the Task2 calls Havok's hkPs3SpuUtil makes on a Taskset2 (RE pass 11).
+ * Since v0.19.0, _cellSpursTasksetAttribute2Initialize, cellSpursCreateTaskset2 and cellSpursCreateTask2 are
+ * upstream's (#629, above and below); only the join and destroy calls, which upstream does not define, stay here.
+ * JoinTask2 waits until the task's enabled bit (+0x30, cleared by spu_taskset_task_exited) drops.
+ * ASSUMPTION: the exit code is reported as 0 (the runtime does not record task exit codes yet). */
+static int kz3_task2_enabled(u32 ts, u32 id)
+{
+    return (vm_read8(ts + 0x30 + id / 8) >> (7 - (id & 7))) & 1;
+}
+
+s32 cellSpursTryJoinTask2(void* taskset, u32 id, s32* exitCode)
+{
+    u32 ts = (u32)(uintptr_t)taskset;
+    if (!ts) return CELL_SPURS_TASK_ERROR_NULL_POINTER;
+    if (id >= CELL_SPURS_MAX_TASK) return CELL_SPURS_TASK_ERROR_INVAL;
+    if (kz3_task2_enabled(ts, id)) return CELL_SPURS_TASK_ERROR_BUSY;
+    if (exitCode) vm_write32((u32)(uintptr_t)exitCode, 0);
+    return CELL_OK;
+}
+
+s32 cellSpursJoinTask2(void* taskset, u32 id, s32* exitCode)
+{
+    u32 ts = (u32)(uintptr_t)taskset;
+    if (!ts) return CELL_SPURS_TASK_ERROR_NULL_POINTER;
+    if (id >= CELL_SPURS_MAX_TASK) return CELL_SPURS_TASK_ERROR_INVAL;
+    unsigned spins = 0;
+    while (kz3_task2_enabled(ts, id)) {
+        Sleep(spins < 64 ? 0 : 1);
+        if (++spins == 20000) printf("[cellSpurs] JoinTask2 taskset=0x%08X id=%u still running after ~20 s\n", ts, id);
+    }
+    if (exitCode) vm_write32((u32)(uintptr_t)exitCode, 0);
+    return CELL_OK;
+}
+
+s32 cellSpursDestroyTaskset2(void* taskset)
+{
+    u32 ts = (u32)(uintptr_t)taskset;
+    if (!ts) return CELL_SPURS_TASK_ERROR_NULL_POINTER;
+    printf("[cellSpurs] DestroyTaskset2 taskset=0x%08X\n", ts);
+    return CELL_OK;
+}
+
 s32 cellSpursDestroyTaskset(CellSpursTaskset* taskset)
 {
     taskset = GUEST_PTR(taskset, CellSpursTaskset*);
