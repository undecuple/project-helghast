diff --git a/libs/video/rsx_views.h b/libs/video/rsx_views.h
new file mode 100644
index 00000000..a4a39822
--- /dev/null
+++ b/libs/video/rsx_views.h
@@ -0,0 +1,187 @@
+/* KZ3 patch 2202 (RSX pass 173): RSX_VIEWS=1, the split-screen per-view counter. Pure C (no OS calls, no globals other
+ * than the instance the caller owns), so tools/smoke/test_views.c builds it on the host. Default off.
+ *
+ * What it answers: how many views does the walker see per flip, and how many draw packets, method words and enabled
+ * texture units does each view cost. The game renders split screen as the normal per-view loop (SceneRenderer::RenderFrame
+ * 0x1F5030 with 2 views), into the SAME colour/zeta targets, and the port's draw viewport is always the whole surface, so
+ * neither a target change nor the viewport separates the views. The one per-view state the walker sees is the guest
+ * SET_SCISSOR rectangle (NV4097 0x08C0/0x08C4); the game's own loop markers are PPU code the RSX command stream does
+ * not carry. So a view is a scissor rectangle:
+ *   - draws are grouped by (target width, target height, clamped scissor rect); an unwritten scissor is the whole target;
+ *   - a group is view-like when it has >= min_draws draw packets and its rect covers >= RSX_VIEWS_AREA_PCT % of the target
+ *     (light-volume and UI scissors are small; shadow maps and the post chain are other target sizes);
+ *   - within one target size the view-like rects are taken greedily by draw count, keeping only rects that do not overlap
+ *     one already taken (passes with a slightly different full-screen scissor overlap, split-screen halves do not);
+ *   - views = the largest such set over all target sizes. The surface/zeta change count and the scissor change count are
+ *     logged next to it as the alternative signals.
+ * Method words are attributed to the next draw (a word that sets state is counted for the draw it prepares); words after
+ * the last draw of a flip are `tail`. ASSUMPTION: a view's scissor is a rectangle at least 25 % of the target and the
+ * two views of a split do not overlap (3D-TV eyes or a game that scissors per effect to a large overlapping rect would
+ * count as one view; a full-screen overlay scissor with more draw packets than a view would hide the views, the greedy order
+ * is by draw count). Verified only on the synthetic streams of tools/smoke/test_views.c; no game run. */
+#ifndef RSX_VIEWS_H
+#define RSX_VIEWS_H
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#define RSX_VIEWS_MAXG 64
+#define RSX_VIEWS_AREA_PCT 25u
+#define RSX_VIEWS_MAXSEL 8
+
+typedef struct {
+    uint32_t tw, th;           /* target size in pixels */
+    int32_t x0, y0, x1, y1;    /* clamped scissor rect, x1/y1 exclusive */
+    uint32_t draws, words, binds;
+} rsx_views_grp;
+
+typedef struct {
+    int on;
+    uint32_t min_draws;        /* RSX_VIEWS_MIN, default 8 */
+    uint32_t max_lines;        /* RSX_VIEWS_N detailed lines, default 100; then one summary every 300 flips */
+    /* this flip */
+    rsx_views_grp g[RSX_VIEWS_MAXG];
+    uint32_t ng;
+    uint32_t draws, words, binds, tail_words, ovf_draws, ovf_words, ovf_binds;
+    uint32_t pend_words;       /* words since the previous draw */
+    uint32_t surf_changes, scissor_changes;
+    uint32_t last_col, last_zeta, last_valid;
+    int32_t last_rect[4];
+    /* run totals */
+    uint32_t flips, lines, hist[4];   /* hist[v] flips with v views (3 = 3 or more), hist[0] = flips with no draw */
+} rsx_views;
+
+static inline void rsx_views_init(rsx_views* v, uint32_t min_draws, uint32_t max_lines)
+{
+    memset(v, 0, sizeof(*v));
+    v->on = 1;
+    v->min_draws = min_draws ? min_draws : 8u;
+    v->max_lines = max_lines ? max_lines : 100u;
+}
+
+/* one method word was dispatched */
+static inline void rsx_views_word(rsx_views* v) { v->pend_words++; }
+
+/* one draw packet. col/zeta = surface offsets, tw/th = target size in pixels, sh/sv = raw SCISSOR_HORIZONTAL/VERTICAL
+ * (x | w << 16, y | h << 16), written = the scissor registers were ever written, binds = enabled fragment texture units */
+static inline void rsx_views_draw(rsx_views* v, uint32_t col, uint32_t zeta, uint32_t tw, uint32_t th, uint32_t sh,
+                                  uint32_t sv, int written, uint32_t binds)
+{
+    int32_t x0 = 0, y0 = 0, x1 = (int32_t)tw, y1 = (int32_t)th;
+    if (written) {
+        const int32_t sx = (int32_t)(sh & 0xFFFFu), sw = (int32_t)(sh >> 16);
+        const int32_t sy = (int32_t)(sv & 0xFFFFu), shh = (int32_t)(sv >> 16);
+        if (sx > x0) x0 = sx;
+        if (sy > y0) y0 = sy;
+        if (sx + sw < x1) x1 = sx + sw;
+        if (sy + shh < y1) y1 = sy + shh;
+        if (x1 < x0) x1 = x0;
+        if (y1 < y0) y1 = y0;
+    }
+    if (v->last_valid) {
+        if (col != v->last_col || zeta != v->last_zeta) v->surf_changes++;
+        if (v->last_rect[0] != x0 || v->last_rect[1] != y0 || v->last_rect[2] != x1 || v->last_rect[3] != y1) v->scissor_changes++;
+    }
+    v->last_valid = 1; v->last_col = col; v->last_zeta = zeta;
+    v->last_rect[0] = x0; v->last_rect[1] = y0; v->last_rect[2] = x1; v->last_rect[3] = y1;
+    v->draws++; v->words += v->pend_words; v->binds += binds;
+    uint32_t i = 0;
+    for (; i < v->ng; i++) {
+        rsx_views_grp* g = &v->g[i];
+        if (g->tw == tw && g->th == th && g->x0 == x0 && g->y0 == y0 && g->x1 == x1 && g->y1 == y1) break;
+    }
+    if (i == v->ng) {
+        if (v->ng == RSX_VIEWS_MAXG) { v->ovf_draws++; v->ovf_words += v->pend_words; v->ovf_binds += binds; v->pend_words = 0; return; }
+        rsx_views_grp* g = &v->g[v->ng++];
+        memset(g, 0, sizeof(*g));
+        g->tw = tw; g->th = th; g->x0 = x0; g->y0 = y0; g->x1 = x1; g->y1 = y1;
+    }
+    v->g[i].draws++; v->g[i].words += v->pend_words; v->g[i].binds += binds;
+    v->pend_words = 0;
+}
+
+static inline int rsx_views_overlap(const rsx_views_grp* a, const rsx_views_grp* b)
+{
+    return a->x0 < b->x1 && b->x0 < a->x1 && a->y0 < b->y1 && b->y0 < a->y1;
+}
+
+/* the view set of the groups so far: fills sel[] (indices into g[], ordered by x0 then y0), returns the count */
+static inline uint32_t rsx_views_select(const rsx_views* v, uint32_t sel[RSX_VIEWS_MAXSEL])
+{
+    uint32_t best = 0, best_draws = 0;
+    for (uint32_t c = 0; c < v->ng; c++) {
+        int seen = 0;
+        for (uint32_t k = 0; k < c; k++) if (v->g[k].tw == v->g[c].tw && v->g[k].th == v->g[c].th) { seen = 1; break; }
+        if (seen) continue;   /* one pass per target size */
+        uint32_t cand[RSX_VIEWS_MAXG], nc = 0;
+        for (uint32_t i = 0; i < v->ng; i++) {
+            const rsx_views_grp* g = &v->g[i];
+            if (g->tw != v->g[c].tw || g->th != v->g[c].th) continue;
+            const uint64_t area = (uint64_t)(g->x1 - g->x0) * (uint64_t)(g->y1 - g->y0);
+            if (g->draws < v->min_draws) continue;
+            if (area * 100u < (uint64_t)g->tw * g->th * RSX_VIEWS_AREA_PCT) continue;
+            cand[nc++] = i;
+        }
+        for (uint32_t a = 0; a + 1 < nc; a++)   /* by draws, descending (stable on index) */
+            for (uint32_t b = a + 1; b < nc; b++)
+                if (v->g[cand[b]].draws > v->g[cand[a]].draws) { uint32_t t = cand[a]; cand[a] = cand[b]; cand[b] = t; }
+        uint32_t take[RSX_VIEWS_MAXSEL], nt = 0, td = 0;
+        for (uint32_t a = 0; a < nc && nt < RSX_VIEWS_MAXSEL; a++) {
+            int clash = 0;
+            for (uint32_t k = 0; k < nt; k++) if (rsx_views_overlap(&v->g[cand[a]], &v->g[take[k]])) { clash = 1; break; }
+            if (clash) continue;
+            take[nt++] = cand[a]; td += v->g[cand[a]].draws;
+        }
+        if (nt > best || (nt == best && nt && td > best_draws)) {
+            best = nt; best_draws = td;
+            for (uint32_t k = 0; k < nt; k++) sel[k] = take[k];
+        }
+    }
+    for (uint32_t a = 0; a + 1 < best; a++)
+        for (uint32_t b = a + 1; b < best; b++) {
+            const rsx_views_grp *ga = &v->g[sel[a]], *gb = &v->g[sel[b]];
+            if (gb->x0 < ga->x0 || (gb->x0 == ga->x0 && gb->y0 < ga->y0)) { uint32_t t = sel[a]; sel[a] = sel[b]; sel[b] = t; }
+        }
+    return best;
+}
+
+/* The flip: formats this flip's line into buf (returns its length, 0 = print nothing) and resets the per-flip state.
+ * *views_out receives the view count. A flip with no draw prints nothing. */
+static inline size_t rsx_views_flip(rsx_views* v, char* buf, size_t cap, uint32_t* views_out)
+{
+    uint32_t sel[RSX_VIEWS_MAXSEL];
+    const uint32_t nv = v->draws ? rsx_views_select(v, sel) : 0;
+    const uint32_t nvc = nv > 3u ? 3u : nv;
+    v->flips++;
+    v->hist[nvc]++;
+    v->tail_words = v->pend_words;
+    size_t n = 0;
+    const int detailed = v->draws && v->lines < v->max_lines;
+    const int summary = v->draws && !detailed && (v->flips % 300u) == 0;
+    if (detailed || summary) {
+        n += (size_t)snprintf(buf + n, cap - n, "[views] flip=%u views=%u draws=%u words=%u binds=%u surf=%u scis=%u hist=0:%u 1:%u 2:%u 3+:%u",
+                              v->flips, nv, v->draws, v->words, v->binds, v->surf_changes, v->scissor_changes,
+                              v->hist[0], v->hist[1], v->hist[2], v->hist[3]);
+        if (detailed) {
+            uint32_t sd = 0, sw = 0, sb = 0;
+            for (uint32_t k = 0; k < nv && n < cap; k++) {
+                const rsx_views_grp* g = &v->g[sel[k]];
+                n += (size_t)snprintf(buf + n, cap - n, " | v%u %ux%u rect=%d,%d-%d,%d draws=%u words=%u binds=%u", k, g->tw, g->th,
+                                      (int)g->x0, (int)g->y0, (int)g->x1, (int)g->y1, g->draws, g->words, g->binds);
+                sd += g->draws; sw += g->words; sb += g->binds;
+            }
+            if (n < cap) n += (size_t)snprintf(buf + n, cap - n, " | rest draws=%u words=%u binds=%u tail_words=%u", v->draws - sd,
+                                               v->words - sw, v->binds - sb, v->tail_words);
+        }
+        if (n >= cap) n = cap - 1;
+        v->lines++;
+    }
+    *views_out = nv;
+    v->ng = 0; v->draws = v->words = v->binds = 0; v->ovf_draws = v->ovf_words = v->ovf_binds = 0;
+    v->pend_words = 0; v->surf_changes = v->scissor_changes = 0; v->last_valid = 0;
+    return n;
+}
+/* the instance and its switch live in cellGcmSys.c (beside g_rsx_o0) */
+extern rsx_views g_rsx_views;
+int rsx_perf_views_on(void);   /* RSX_VIEWS=1 (cached; RSX_VIEWS_N detailed lines, RSX_VIEWS_MIN draws per view) */
+#endif
