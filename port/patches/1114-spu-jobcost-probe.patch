     if (g_spu_ovl_skip_any && ctx->resident_ovl > 0 && ctx->resident_ovl < (int)KZ3_OVL_SKIP_MAX &&
@@ -3729,7 +3761,7 @@ SPU_ABI void spu_indirect_branch(spu_context* ctx)
