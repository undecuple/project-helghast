+/* KZ3 patch 1048: a policy-module lane more than twice KZ3_SPURS_RUN_MS into its run and still at a tick site
+ * (it never reached selectWorkload, or ignored the switch answer) is halted like an exitToKernel; the kernel
+ * thread's join then ends and the claim is released. Logged (first 16, then every 1024th). */
+static void kz3_pm_budget_halt(spu_context* ctx, const char* site)
+{
+    extern uint64_t kz3_pm_run_over_budget(int factor);
+    uint64_t over;
+    if (!ctx->policy_mode || !(over = kz3_pm_run_over_budget(2))) return;
+    { static volatile unsigned s_bh = 0;
+      if (++s_bh <= 16 || (s_bh & 0x3FF) == 0)
+          fprintf(stderr, "[spurs-budget] %s at pc=0x%05X img=%d ovl=%d %u ms over 2 x KZ3_SPURS_RUN_MS: halting the lane (#%u)\n",
+                  site, ctx->pc & SPU_LS_MASK, ctx->image_id, ctx->resident_ovl, (unsigned)over, s_bh); }
+    ctx->status = SPU_STATUS_STOPPED_BY_STOP;
+    spu_halt(ctx);
+}
