+/* KZ3 patch 1047/1048: reservation, atomic and event state of a lane (the stuck-run report), the jm dispatcher's
+ * state words (RE pass 71: LS 0x1410 = EA of the list it waits on, 0x1440, 0x14E0-0x14FF) and the first 16 words
+ * of the 128-byte line at that EA (the dependency counters). */
+void spu_pm_ctx_describe_resv(void* p, char* out, int n)
+{
+    spu_context* c = (spu_context*)p;
+    if (!c) { out[0] = 0; return; }
+    int o = snprintf(out, n, "resv=%d@0x%08X atomic=%u ovl=%d evmask=0x%X evstat=0x%X", c->resv_valid, c->resv_ea, c->atomic_stat,
+                     c->resident_ovl, c->event_mask, c->event_status);
+    static const uint32_t at[3] = { 0x1410, 0x1440, 0x14E0 };
+    uint32_t w[3 + 8], ea;
+    for (int i = 0; i < 3; i++) { uint32_t t; memcpy(&t, (const uint8_t*)c->ls + at[i], 4); w[i] = __builtin_bswap32(t); }
+    for (int i = 0; i < 8; i++) { uint32_t t; memcpy(&t, (const uint8_t*)c->ls + 0x14E0 + 4 * i, 4); w[3 + i] = __builtin_bswap32(t); }
+    if (o < n) o += snprintf(out + o, n - o, " LS1410=%08X 1440=%08X 14E0=%08X.%08X.%08X.%08X.%08X.%08X.%08X.%08X", w[0], w[1],
+                             w[3], w[4], w[5], w[6], w[7], w[8], w[9], w[10]);
+    ea = w[0] & ~0x7Fu;
+    if (ea >= 0x10000u && ea < 0xF0000000u && o < n) {
+        extern uint8_t* vm_base;
+        o += snprintf(out + o, n - o, " line@%08X:", ea);
+        for (int i = 0; i < 16 && o < n; i++) { uint32_t t; memcpy(&t, vm_base + ea + 4 * i, 4); o += snprintf(out + o, n - o, " %08X", __builtin_bswap32(t)); }
+    }
+}
+/* KZ3 patch 1048 (SPU pass 34, RE pass 70 section 5): a policy-module run budget, KZ3_SPURS_RUN_MS (0 = off,
+ * the default). The HLE kernel never switches a running module out: selectWorkload always answers "continue"
+ * and a lane that waits for something only another run of the same workload produces spins forever on the
+ * host, holding the workload's claim (gp-t2: jm_hiprio from t = 411 s, every DeferredSchedule job behind it).
+ * Past the budget the selectWorkload intercept answers "another workload wants the SPU" (spu_channels.c) so the
+ * module leaves by its own exit path; past twice the budget a lane that never polls is halted at the GETLLAR
+ * and channel-read tick sites. The kernel thread then joins the lanes, releases the claim and re-enters the
+ * module on its next pass, as the real kernel does after a context switch. kz3-spurs-budget begin */
+SPU_THREAD_LOCAL uint64_t g_kz3_pm_run_t0;
+static int s_kz3_run_ms = -1;
+static uint64_t kz3_pm_now_ms(void)
+{
+#ifdef _WIN32
+    return (uint64_t)GetTickCount64();
+#else
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000u + (uint64_t)ts.tv_nsec / 1000000u;
+#endif
+}
+int kz3_pm_run_budget_ms(void)
+{
+    if (s_kz3_run_ms < 0) { const char* e = getenv("KZ3_SPURS_RUN_MS"); s_kz3_run_ms = e ? atoi(e) : 0; if (s_kz3_run_ms < 0) s_kz3_run_ms = 0; }
+    return s_kz3_run_ms;
+}
+/* 0 = within budget (or budget off / no run on this thread); else the ms over `factor` x budget. */
+uint64_t kz3_pm_run_over_budget(int factor)
+{
+    int b = kz3_pm_run_budget_ms();
+    if (!b || !g_kz3_pm_run_t0) return 0;
+    uint64_t el = kz3_pm_now_ms() - g_kz3_pm_run_t0, lim = (uint64_t)b * (uint64_t)factor;
+    return el > lim ? el - lim : 0;
+}
+/* kz3-spurs-budget end */
 
