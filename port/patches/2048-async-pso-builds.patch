+/* KZ3 patch 2048 (rsx rounds 49-50): platform-neutral bookkeeping of the live renderer's asynchronous PSO builds
+ * (LD_PSO_ASYNC), kept apart from the D3D12 code so a host test can check it with no GPU
+ * (tools/smoke/test_pso_async.c).
+ *
+ * 1. Pending entries. A PSO cache entry whose build is in flight has pso == NULL and pending = 1: a lookup returns
+ *    NULL, so the draw is skipped. When the build is back, RSX_APSO_MERGE finds the key's pending entry and stores
+ *    the PSO (or NULL for a failed build) and clears pending; with no pending entry for the key the caller releases
+ *    the PSO.
+ * 2. In-flight shader compiles (dedupe). Several jobs often need the same VS or PS blob before any of them is back.
+ *    The walker thread registers each blob a job has to compile in a table keyed by type, hash, length and source:
+ *    the first job owns the compile, later jobs depend on the owner's entry (one reference each). A worker that owns
+ *    a blob compiles it and publishes it (done = 1, blob or NULL); a dependent worker waits for done and takes the
+ *    blob. Only the walker inserts and removes entries; an entry goes away when its last job was merged (its blob is
+ *    then in the walker's memory cache, so a later job finds it there). Workers read only entries they hold a
+ *    reference to, under the caller's lock. Deadlock-free with a FIFO queue: a job only depends on entries owned by
+ *    jobs queued before it, which a worker has already taken. */
+#ifndef RSX_PSO_ASYNC_H
+#define RSX_PSO_ASYNC_H
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Index of the pending entry for key k in arr[0..n) (n when none). arr: any array of structs with .key and .pending. */
+#define RSX_APSO_FIND_PENDING(arr, n, k, out)                                                         \
+    do { uint32_t i_ = 0; while (i_ < (n) && !((arr)[i_].key == (k) && (arr)[i_].pending)) i_++;    \
+         (out) = i_; } while (0)
+
+/* Store a finished build into its pending entry. ok = 1 when merged, 0 when no pending entry had the key (the
+ * caller then releases the PSO). */
+#define RSX_APSO_MERGE(arr, n, k, pso_value, ok)                                                      \
+    do { uint32_t m_; RSX_APSO_FIND_PENDING(arr, n, k, m_);                                           \
+         if (m_ < (n)) { (arr)[m_].pso = (pso_value); (arr)[m_].pending = 0; (ok) = 1; }              \
+         else (ok) = 0; } while (0)
+
+typedef struct rsx_apso_blob {
+    struct rsx_apso_blob* next;
+    uint64_t hash;
+    uint32_t len;
+    uint32_t refs;      /* jobs that own or depend on this compile and were not merged yet */
+    char type;          /* 'V' or 'P' */
+    volatile uint8_t done;
+    char* src;          /* copy of the HLSL (exact match on hash collisions) */
+    void* blob;         /* published result (the table's own reference) or NULL when the compile failed */
+} rsx_apso_blob;
+
+typedef struct {
+    rsx_apso_blob* head;
+    uint32_t count;
+    uint64_t owned, deduped;
+} rsx_apso_blobtab;
+
+/* Walker: the in-flight entry for this source, created when absent. *owner = 1 when the caller's job must compile
+ * it, 0 when another job does. Takes one reference. NULL when out of memory (the job compiles on its own). */
+static inline rsx_apso_blob* rsx_apso_blob_acquire(rsx_apso_blobtab* t, char type, const char* src, uint32_t len,
+                                                   uint64_t hash, int* owner)
+{
+    for (rsx_apso_blob* e = t->head; e; e = e->next)
+        if (e->type == type && e->hash == hash && e->len == len && memcmp(e->src, src, len) == 0) {
+            e->refs++; t->deduped++; *owner = 0; return e;
+        }
+    rsx_apso_blob* e = (rsx_apso_blob*)calloc(1, sizeof *e);
+    if (!e) return NULL;
+    e->src = (char*)malloc((size_t)len + 1u);
+    if (!e->src) { free(e); return NULL; }
+    memcpy(e->src, src, len); e->src[len] = 0;
+    e->type = type; e->hash = hash; e->len = len; e->refs = 1;
+    e->next = t->head; t->head = e; t->count++; t->owned++;
+    *owner = 1;
+    return e;
+}
+
+/* Owner worker, under the caller's lock: publish the compile's result (the table keeps `blob` as its own reference:
+ * the caller adds one for it before). */
+static inline void rsx_apso_blob_publish(rsx_apso_blob* e, void* blob)
+{
+    e->blob = blob;
+    e->done = 1;
+}
+
+/* Walker, at a job's merge: drop the job's reference. When it was the last one the entry is removed and its blob
+ * (the table's reference, possibly NULL) is returned through *release for the caller to release; returns 1 then. */
+static inline int rsx_apso_blob_release(rsx_apso_blobtab* t, rsx_apso_blob* e, void** release)
+{
+    *release = NULL;
+    if (!e || !e->refs || --e->refs) return 0;
+    rsx_apso_blob** pp = &t->head;
+    while (*pp && *pp != e) pp = &(*pp)->next;
+    if (*pp) *pp = e->next;
+    t->count--;
+    *release = e->blob;
+    free(e->src); free(e);
+    return 1;
+}
+
+#endif /* RSX_PSO_ASYNC_H */
