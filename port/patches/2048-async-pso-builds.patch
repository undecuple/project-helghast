+/* ===================== KZ3 patch 2048: asynchronous PSO builds (LD_PSO_ASYNC, default on since pass 50; 0 = synchronous) =====================
+ * A walker PSO miss normally decompiles, compiles the VS/PS (D3DCompile) and creates the PSO on the walker thread:
+ * at a cold level start (K4 frozen_shores, empty shader cache, RSX pass 48) 245 misses took 16.4 s of walker time
+ * and the game's Gfx jobs stalled ~6 s on the RSX label. With LD_PSO_ASYNC=1 the walker still decompiles and looks
+ * the blobs up (memory, then the disk cache), then hands the HLSL, render state and layout to worker threads
+ * (LD_PSO_ASYNC_THREADS, default 3) that compile the missing blobs and create the PSO (through the 2031 pipeline
+ * library). Until the PSO is back the key's entry is pending (pso NULL): its draws are skipped (counted as
+ * drop{pso}), as RPCS3's asynchronous shader mode does; a visible pop-in of a frame or a few. The walker merges
+ * finished builds at its next PSO lookup: blobs into the memory and disk caches, the key into pso_keys.bin, the PSO
+ * into its entry. Statistics: [pso-async] every 256 frames while builds ran. */
+typedef struct ld_apso_job {
+    struct ld_apso_job* next;
+    u64 key, vs_hash, ps_hash;
+    u32 vs_len, ps_len;
+    char* vs_src; char* ps_src;           /* NUL-terminated copies of the final HLSL */
+    ID3DBlob* vs; ID3DBlob* ps;           /* in: found by the walker (or NULL); out: compiled */
+    u8 vs_new, ps_new, masked, packed, depth;
+    rsx_apso_blob *vs_e, *ps_e;           /* in-flight compile entries this job owns (vs_own/ps_own) or waits for */
+    u8 vs_own, ps_own;
+    render_state_t rs;
+    rsx_vertex_layout_plan layout;
+    ID3D12PipelineState* pso;
+    unsigned compile_us, create_us;
+    LONGLONG t_submit;
+} ld_apso_job;
+static struct {
+    int on, started, n_threads;
+    CRITICAL_SECTION cs;
+    CONDITION_VARIABLE cv;                /* published in-flight compiles (rsx_pso_async.h) */
+    rsx_apso_blobtab tab;                 /* walker-owned in-flight compile table */
+    u64 waits;                            /* dependent workers that had to wait for the owner's compile */
+    HANDLE sem;
+    ld_apso_job *q_head, *q_tail, *done;
+    volatile LONG done_flag, in_flight;
+    u64 submitted, finished, failed, skipped_draws, compile_us, create_us, latency_us, max_latency_us, merged;
+    u32 max_in_flight;
+} g_apso;
+
+static int ld_apso_on(void)
+{
+    static int on = -1;
+    /* Default on since RSX pass 50 (K4 cold start: level-start stall gone, fps_window A-faster 3/3); LD_PSO_ASYNC=0
+     * restores the synchronous builds. */
+    if (on < 0) { const char* e = getenv("LD_PSO_ASYNC"); on = (e && *e) ? (atoi(e) != 0) : 1;
+                  fprintf(stderr, "[pso-async] %s (LD_PSO_ASYNC=%s)\n", on ? "on" : "off", e && *e ? e : "<unset>, default on"); }
+    return on;
+}
+
+/* Worker: compile one blob; when the job owns an in-flight entry, publish the result to it (the table keeps a
+ * reference of its own). 1 = compiled. */
+static int ld_apso_compile(const char* src, u32 len, const char* target, rsx_apso_blob* e, ID3DBlob** out)
+{
+    ID3DBlob* err = NULL;
+    *out = NULL;
+    if (FAILED(D3DCompile(src, len, target[0] == 'v' ? "xvs" : "xps", NULL, NULL, "main", target, 0, 0, out, &err)))
+        *out = NULL;
+    if (err) err->lpVtbl->Release(err);
+    if (e) {
+        if (*out) (*out)->lpVtbl->AddRef(*out);
+        EnterCriticalSection(&g_apso.cs);
+        rsx_apso_blob_publish(e, *out);
+        LeaveCriticalSection(&g_apso.cs);
+        WakeAllConditionVariable(&g_apso.cv);
+    }
+    return *out != NULL;
+}
+
+/* Worker: wait until the owner job published the entry, then take a reference to its blob (NULL = it failed). */
+static ID3DBlob* ld_apso_wait(rsx_apso_blob* e)
+{
+    EnterCriticalSection(&g_apso.cs);
+    if (!e->done) g_apso.waits++;
+    while (!e->done) SleepConditionVariableCS(&g_apso.cv, &g_apso.cs, INFINITE);
+    ID3DBlob* b = (ID3DBlob*)e->blob;
+    if (b) b->lpVtbl->AddRef(b);
+    LeaveCriticalSection(&g_apso.cs);
+    return b;
+}
+
+static DWORD WINAPI ld_apso_worker(LPVOID arg)
+{
+    (void)arg;
+    for (;;) {
+        WaitForSingleObject(g_apso.sem, INFINITE);
+        EnterCriticalSection(&g_apso.cs);
+        ld_apso_job* j = g_apso.q_head;
+        if (j) { g_apso.q_head = j->next; if (!g_apso.q_head) g_apso.q_tail = NULL; }
+        LeaveCriticalSection(&g_apso.cs);
+        if (!j) continue;
+        LARGE_INTEGER q0, q1, q2, f; QueryPerformanceFrequency(&f); QueryPerformanceCounter(&q0);
+        /* Owned blobs first (always compiled and published, even when the other stage failed: dependents wait on
+         * them), then the ones another job compiles (RSX pass 50: one in-flight compile per blob). */
+        if (!j->vs && (j->vs_own || !j->vs_e)) j->vs_new = (u8)ld_apso_compile(j->vs_src, j->vs_len, "vs_5_0", j->vs_e, &j->vs);
+        if (!j->ps && (j->ps_own || !j->ps_e)) j->ps_new = (u8)ld_apso_compile(j->ps_src, j->ps_len, "ps_5_0", j->ps_e, &j->ps);
+        if (!j->vs && j->vs_e && !j->vs_own) j->vs = ld_apso_wait(j->vs_e);
+        if (!j->ps && j->ps_e && !j->ps_own) j->ps = ld_apso_wait(j->ps_e);
+        QueryPerformanceCounter(&q1);
+        if (j->vs && j->ps) {
+            D3D12_INPUT_ELEMENT_DESC il[16];
+            D3D12_GRAPHICS_PIPELINE_STATE_DESC pd;
+            ld_pso_desc_fill(&pd, il, j->vs, j->ps, &j->rs, j->masked ? j->layout.count : RSX_DSP_NUM_VERTEX_ATTR,
+                             j->masked ? j->layout.attrs : NULL, j->masked, j->packed, j->depth);
+            int lib_hit = 0;
+            if (FAILED(ld_pl_create(&pd, &j->rs, j->key, &j->pso, &lib_hit))) j->pso = NULL;
+        }
+        QueryPerformanceCounter(&q2);
+        j->compile_us = (unsigned)((q1.QuadPart - q0.QuadPart) * 1000000 / f.QuadPart);
+        j->create_us = (unsigned)((q2.QuadPart - q1.QuadPart) * 1000000 / f.QuadPart);
+        EnterCriticalSection(&g_apso.cs);
+        j->next = g_apso.done; g_apso.done = j;
+        LeaveCriticalSection(&g_apso.cs);
+        InterlockedExchange(&g_apso.done_flag, 1);
+    }
+    return 0;
+}
+
+/* Walker: queue the build of `key`. 0 = not queued (the caller builds synchronously). */
+static int ld_apso_submit(const char* vs_hlsl, const char* ps_hlsl, const render_state_t* rs,
+                          const rsx_vertex_layout_plan* masked_layout, int packed, u64 key)
+{
+    if (!g_apso.started) {
+        g_apso.started = 1;
+        InitializeCriticalSection(&g_apso.cs);
+        InitializeConditionVariable(&g_apso.cv);
+        g_apso.sem = CreateSemaphoreA(NULL, 0, 0x7FFFFFFF, NULL);
+        const char* e = getenv("LD_PSO_ASYNC_THREADS");
+        int nt = e ? atoi(e) : 3; if (nt < 1) nt = 1; if (nt > 8) nt = 8;
+        for (int i = 0; i < nt && g_apso.sem; i++) {
+            HANDLE h = CreateThread(NULL, 0, ld_apso_worker, NULL, 0, NULL);
+            if (h) { CloseHandle(h); g_apso.n_threads++; }
+        }
+        fprintf(stderr, "[pso-async] %d worker threads\n", g_apso.n_threads);
+    }
+    if (!g_apso.n_threads) return 0;
+    ld_apso_job* j = (ld_apso_job*)calloc(1, sizeof *j);
+    if (!j) return 0;
+    j->vs_len = (u32)strlen(vs_hlsl); j->ps_len = (u32)strlen(ps_hlsl);
+    j->vs_src = (char*)malloc((size_t)j->vs_len + 1u); j->ps_src = (char*)malloc((size_t)j->ps_len + 1u);
+    if (!j->vs_src || !j->ps_src) { free(j->vs_src); free(j->ps_src); free(j); return 0; }
+    memcpy(j->vs_src, vs_hlsl, (size_t)j->vs_len + 1u); memcpy(j->ps_src, ps_hlsl, (size_t)j->ps_len + 1u);
+    j->vs_hash = fnv1a(vs_hlsl, j->vs_len, 1469598103934665603ull);
+    j->ps_hash = fnv1a(ps_hlsl, j->ps_len, 1469598103934665603ull);
+    int pb = 0, seen = 0;
+    j->vs = shader_blob_cache_find(&g.vs_blobs, vs_hlsl, j->vs_len, j->vs_hash, &pb, &seen);
+    if (!j->vs && (j->vs = ld_pstat_disk_load('V', vs_hlsl, j->vs_len, j->vs_hash)) != NULL)
+        shader_blob_cache_insert_accounted(&g.vs_blobs, vs_hlsl, j->vs_len, j->vs_hash, j->vs, 'V', seen);
+    seen = 0;
+    j->ps = shader_blob_cache_find(&g.ps_blobs, ps_hlsl, j->ps_len, j->ps_hash, &pb, &seen);
+    if (!j->ps && (j->ps = ld_pstat_disk_load('P', ps_hlsl, j->ps_len, j->ps_hash)) != NULL)
+        shader_blob_cache_insert_accounted(&g.ps_blobs, ps_hlsl, j->ps_len, j->ps_hash, j->ps, 'P', seen);
+    /* Blobs not in the caches: one in-flight compile each (RSX pass 50). Only the walker touches the table. */
+    if (!j->vs) { int own = 0; j->vs_e = rsx_apso_blob_acquire(&g_apso.tab, 'V', j->vs_src, j->vs_len, j->vs_hash, &own); j->vs_own = (u8)own; }
+    if (!j->ps) { int own = 0; j->ps_e = rsx_apso_blob_acquire(&g_apso.tab, 'P', j->ps_src, j->ps_len, j->ps_hash, &own); j->ps_own = (u8)own; }
+    j->key = key; j->rs = *rs;
+    j->masked = masked_layout != NULL; j->packed = (u8)(packed != 0); j->depth = g.depth != NULL;
+    if (masked_layout) j->layout = *masked_layout;
+    { LARGE_INTEGER q; QueryPerformanceCounter(&q); j->t_submit = q.QuadPart; }
+    EnterCriticalSection(&g_apso.cs);
+    if (g_apso.q_tail) g_apso.q_tail->next = j; else g_apso.q_head = j;
+    g_apso.q_tail = j;
+    LeaveCriticalSection(&g_apso.cs);
+    const LONG inf = InterlockedIncrement(&g_apso.in_flight);
+    if ((u32)inf > g_apso.max_in_flight) g_apso.max_in_flight = (u32)inf;
+    g_apso.submitted++;
+    ReleaseSemaphore(g_apso.sem, 1, NULL);
+    return 1;
+}
+
+/* Walker: merge the finished builds into the caches and their pending entries. */
+static void ld_apso_drain(void)
+{
+    if (!g_apso.done_flag) return;
+    EnterCriticalSection(&g_apso.cs);
+    InterlockedExchange(&g_apso.done_flag, 0);
+    ld_apso_job* j = g_apso.done; g_apso.done = NULL;
+    LeaveCriticalSection(&g_apso.cs);
+    LARGE_INTEGER now, f; QueryPerformanceCounter(&now); QueryPerformanceFrequency(&f);
+    while (j) {
+        ld_apso_job* nx = j->next;
+        int pb = 0, seen = 0;
+        if (j->vs_new) {
+            shader_disk_cache_store('V', j->vs_src, j->vs_len, j->vs_hash, j->vs);
+            ID3DBlob* o = shader_blob_cache_find(&g.vs_blobs, j->vs_src, j->vs_len, j->vs_hash, &pb, &seen);
+            if (o) o->lpVtbl->Release(o);
+            else shader_blob_cache_insert_accounted(&g.vs_blobs, j->vs_src, j->vs_len, j->vs_hash, j->vs, 'V', seen);
+        }
+        if (j->ps_new) {
+            seen = 0;
+            shader_disk_cache_store('P', j->ps_src, j->ps_len, j->ps_hash, j->ps);
+            ID3DBlob* o = shader_blob_cache_find(&g.ps_blobs, j->ps_src, j->ps_len, j->ps_hash, &pb, &seen);
+            if (o) o->lpVtbl->Release(o);
+            else shader_blob_cache_insert_accounted(&g.ps_blobs, j->ps_src, j->ps_len, j->ps_hash, j->ps, 'P', seen);
+        }
+        if (j->pso) {
+            g_ld_pl_last_vs_hash = j->vs_hash; g_ld_pl_last_vs_len = j->vs_len;
+            g_ld_pl_last_ps_hash = j->ps_hash; g_ld_pl_last_ps_len = j->ps_len;
+            ld_pl_record(j->key, &j->rs, j->masked ? &j->layout : NULL, j->packed, j->depth);
+        } else g_apso.failed++;
+        int merged = 0;
+        RSX_APSO_MERGE(g.psos, g.n_psos, j->key, j->pso, merged);
+        if (merged) g_apso.merged++;
+        else if (j->pso) j->pso->lpVtbl->Release(j->pso);
+        void* tb = NULL;   /* the in-flight entries' last job: the table's blob reference goes */
+        if (rsx_apso_blob_release(&g_apso.tab, j->vs_e, &tb) && tb) ((ID3DBlob*)tb)->lpVtbl->Release((ID3DBlob*)tb);
+        if (rsx_apso_blob_release(&g_apso.tab, j->ps_e, &tb) && tb) ((ID3DBlob*)tb)->lpVtbl->Release((ID3DBlob*)tb);
+        g_apso.finished++;
+        g_apso.compile_us += j->compile_us; g_apso.create_us += j->create_us;
+        const u64 lat = (u64)((now.QuadPart - j->t_submit) * 1000000 / f.QuadPart);
+        g_apso.latency_us += lat; if (lat > g_apso.max_latency_us) g_apso.max_latency_us = lat;
+        if (j->vs) j->vs->lpVtbl->Release(j->vs);
+        if (j->ps) j->ps->lpVtbl->Release(j->ps);
+        free(j->vs_src); free(j->ps_src); free(j);
+        InterlockedDecrement(&g_apso.in_flight);
+        j = nx;
+    }
+}
+
+static void ld_apso_stat_print(void)
+{
+    if (!g_apso.submitted) return;
+    fprintf(stderr, "[pso-async] frame=%u submitted=%llu finished=%llu failed=%llu in-flight=%ld max-in-flight=%u "
+                    "skipped-draws=%llu worker compile=%.1f ms create=%.1f ms latency avg=%.1f max=%.1f ms"
+                    " compiles-owned=%llu deduped=%llu waits=%llu in-flight-blobs=%u\n",
+            g_ld_frames, (unsigned long long)g_apso.submitted, (unsigned long long)g_apso.finished,
+            (unsigned long long)g_apso.failed, (long)g_apso.in_flight, g_apso.max_in_flight,
+            (unsigned long long)g_apso.skipped_draws, g_apso.compile_us / 1e3, g_apso.create_us / 1e3,
+            g_apso.finished ? g_apso.latency_us / 1e3 / (double)g_apso.finished : 0.0, g_apso.max_latency_us / 1e3,
+            (unsigned long long)g_apso.tab.owned, (unsigned long long)g_apso.tab.deduped,
+            (unsigned long long)g_apso.waits, g_apso.tab.count);
+}
