+/* Patch 2065 (KZ3 RSX pass 63): an A8R8G8B8 render surface read as Y16_X16_FLOAT. KZ3's G-buffer writes the view
+ * normal's two halves as the bytes of its third target (0x16C0000: UPB of r0.x, patch 2064) and every lighting
+ * pass reads that surface back as Y16_X16_FLOAT (remap 0x29E4). The RSX reinterprets the 32-bit word; live-draw
+ * bound the surface's RGBA8 UNORM view, so the lights read two byte values in [0,1] as the normal. The word is
+ * A<<24 | R<<16 | G<<8 | B (A8R8G8B8 in guest memory, big-endian) and Y16_X16 keeps Y in the high half, so
+ * X = half(G<<8 | B), Y = half(A<<8 | R). A compute pass (the depth-snapshot root signature) writes them to an
+ * R16G16_FLOAT copy, refreshed when the surface's colour_gen changes, whose SRV maps the remap as the float
+ * texture path does (ld_float_tex_mapping). Exact for any filter. LD_SURF_RG16=0 = old behaviour (RGBA8 view).
+ * ASSUMPTION: only draws and clears change a surface (colour_gen); a blit into it is not seen. */
+static int ld_surf_rg16_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LD_SURF_RG16"); on = (e && e[0] == '0') ? 0 : 1;
+                  fprintf(stderr, "[surf-rg16] %s (LD_SURF_RG16)\n", on ? "on" : "off"); }
+    return on;
+}
+static int ld_surf_rg16_pso(void)
+{
+    static int state = 0;   /* 0 untried, 1 ok, -1 failed */
+    if (state) return state > 0;
+    state = -1;
+    if (!g.depth_snapshot_rootsig) return 0;
+    static const char source[] =
+        "Texture2D<float4> surface_bytes : register(t0);\n"
+        "RWTexture2D<float2> halves : register(u0);\n"
+        "cbuffer size : register(b0) { uint width; uint height; };\n"
+        "[numthreads(8, 8, 1)]\n"
+        "void main(uint3 id : SV_DispatchThreadID) {\n"
+        "    if (id.x < width && id.y < height) {\n"
+        "        uint4 b = (uint4)round(saturate(surface_bytes.Load(int3(id.xy, 0))) * 255.0);\n"
+        "        halves[id.xy] = float2(f16tof32((b.y << 8) | b.z), f16tof32((b.w << 8) | b.x));\n"
+        "    }\n"
+        "}\n";
+    ID3DBlob* shader = NULL; ID3DBlob* errors = NULL;
+    HRESULT hr = D3DCompile(source, sizeof(source) - 1u, "surf_rg16_compute", NULL, NULL, "main", "cs_5_0",
+                            D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &shader, &errors);
+    if (FAILED(hr)) {
+        fprintf(stderr, "[surf-rg16] shader compile failed hr=0x%08lX: %s\n", (unsigned long)hr,
+                errors ? (const char*)errors->lpVtbl->GetBufferPointer(errors) : "<no diagnostics>");
+        if (errors) errors->lpVtbl->Release(errors);
+        return 0;
+    }
+    if (errors) errors->lpVtbl->Release(errors);
+    D3D12_COMPUTE_PIPELINE_STATE_DESC pipeline = {0};
+    pipeline.pRootSignature = g.depth_snapshot_rootsig;
+    pipeline.CS.pShaderBytecode = shader->lpVtbl->GetBufferPointer(shader);
+    pipeline.CS.BytecodeLength = shader->lpVtbl->GetBufferSize(shader);
+    hr = g.dev->lpVtbl->CreateComputePipelineState(g.dev, &pipeline, &IID_ID3D12PipelineState,
+                                                   (void**)&g.surf_rg16_pso);
+    shader->lpVtbl->Release(shader);
+    if (FAILED(hr)) { fprintf(stderr, "[surf-rg16] pipeline failed hr=0x%08lX\n", (unsigned long)hr); return 0; }
+    state = 1;
+    return 1;
+}
+static int ld_surface_rg16(u32 si, u32 remap)
+{
+    surface_t* s = &g.surfaces[si];
+    if (!ld_surf_rg16_on() || !s->tex || s->fmt != DXGI_FORMAT_R8G8B8A8_UNORM || !ld_surf_rg16_pso()) return -1;
+    if (s->rg16_src != s->tex) {   /* new surface resource: new copy */
+        if (s->rg16) retire_texture(s->rg16);
+        s->rg16 = NULL; s->rg16_state = 0;
+        D3D12_HEAP_PROPERTIES hp = {0};
+        hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+        D3D12_RESOURCE_DESC rd = {0};
+        rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+        rd.Width = s->w; rd.Height = s->h;
+        rd.DepthOrArraySize = 1; rd.MipLevels = 1;
+        rd.Format = DXGI_FORMAT_R16G16_FLOAT;
+        rd.SampleDesc.Count = 1;
+        rd.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+        if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+                D3D12_RESOURCE_STATE_UNORDERED_ACCESS, NULL, &IID_ID3D12Resource, (void**)&s->rg16))) {
+            static u32 n_fail;
+            if (n_fail++ < 8) fprintf(stderr, "[surf-rg16] create failed %u:0x%X %ux%u\n", s->location, s->offset, s->w, s->h);
+            s->rg16 = NULL;
+            return -1;
+        }
+        s->rg16_src = s->tex; s->rg16_state = 1; s->rg16_gen = s->colour_gen - 1u; s->rg16_remap = ~0u;
+        D3D12_UNORDERED_ACCESS_VIEW_DESC ud = {0};
+        ud.Format = DXGI_FORMAT_R16G16_FLOAT;
+        ud.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+        g.dev->lpVtbl->CreateUnorderedAccessView(g.dev, s->rg16, NULL, &ud, srv_cpu(UAV_SURF_RG16_BASE + si));
+        static u32 n_log;
+        if (n_log++ < 8) fprintf(stderr, "[surf-rg16] %u:0x%X %ux%u RGBA8 read as Y16_X16_FLOAT: R16G16 copy (slot %u)\n",
+                                 s->location, s->offset, s->w, s->h, si);
+    }
+    if ((remap & 0xFFFFu) != s->rg16_remap) {
+        D3D12_SHADER_RESOURCE_VIEW_DESC sd = {0};
+        sd.Format = DXGI_FORMAT_R16G16_FLOAT;
+        sd.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        sd.Shader4ComponentMapping = ld_float_tex_mapping(RSX_TEX_FMT_Y16X16_FLOAT, remap);
+        sd.Texture2D.MipLevels = 1;
+        ld_create_srv(g.dev, s->rg16, &sd, srv_cpu(SRV_SURF_RG16_BASE + si));
+        s->rg16_remap = remap & 0xFFFFu;
+    }
+    if (s->rg16_gen != s->colour_gen) {
+        if (g.srv_ring_used >= SRV_RING_TABLES) return -1;
+        const u32 base = g.srv_ring_used++ * SRV_TABLE_SIZE;
+        D3D12_CPU_DESCRIPTOR_HANDLE cpu;
+        g.srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(g.srv_heap, &cpu);
+        cpu.ptr += (size_t)base * g.srv_step;
+        g.dev->lpVtbl->CopyDescriptorsSimple(g.dev, 1, cpu, srv_cpu(SRV_SURFACE_BASE + si),
+                                             D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+        cpu.ptr += g.srv_step;
+        g.dev->lpVtbl->CopyDescriptorsSimple(g.dev, 1, cpu, srv_cpu(UAV_SURF_RG16_BASE + si),
+                                             D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+        D3D12_GPU_DESCRIPTOR_HANDLE src_table, dst_table;
+        g.srv_heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(g.srv_heap, &src_table);
+        src_table.ptr += (u64)base * g.srv_step;
+        dst_table = src_table; dst_table.ptr += g.srv_step;
+        D3D12_RESOURCE_BARRIER b[2] = {0};
+        u32 nb = 0;
+        b[nb].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b[nb].Transition.pResource = s->tex;
+        b[nb].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        b[nb].Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+        b[nb].Transition.StateAfter = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+        nb++;
+        if (s->rg16_state != 1) {
+            b[nb].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+            b[nb].Transition.pResource = s->rg16;
+            b[nb].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+            b[nb].Transition.StateBefore = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+            b[nb].Transition.StateAfter = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+            nb++;
+        }
+        g.list->lpVtbl->ResourceBarrier(g.list, nb, b);
+        ID3D12DescriptorHeap* heaps[] = {g.srv_heap, g.smp_heap};
+        g.list->lpVtbl->SetDescriptorHeaps(g.list, 2, heaps);
+        g.list->lpVtbl->SetPipelineState(g.list, g.surf_rg16_pso); LD_SM_INVALIDATE();
+        g.list->lpVtbl->SetComputeRootSignature(g.list, g.depth_snapshot_rootsig);
+        g.list->lpVtbl->SetComputeRootDescriptorTable(g.list, 0, src_table);
+        g.list->lpVtbl->SetComputeRootDescriptorTable(g.list, 1, dst_table);
+        const UINT size[2] = { s->w, s->h };
+        g.list->lpVtbl->SetComputeRoot32BitConstants(g.list, 2, 2, size, 0);
+        g.list->lpVtbl->Dispatch(g.list, (s->w + 7u) / 8u, (s->h + 7u) / 8u, 1);
+        b[0].Transition.StateBefore = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+        b[0].Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+        b[1].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b[1].Transition.pResource = s->rg16;
+        b[1].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        b[1].Transition.StateBefore = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+        b[1].Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+        g.list->lpVtbl->ResourceBarrier(g.list, 2, b);
+        s->rg16_state = 2;
+        s->rg16_gen = s->colour_gen;
+    }
+    return (int)(SRV_SURF_RG16_BASE + si);
+}
