+/* ---- the controls page's pad picture (patch 2094, layout choice 6) ---------------------------------------------------
+ * The game's controls page shows one 512x256 picture of a DualShock 3 with a leader line from each legend label to
+ * its button (the labels are drawn by the game; their places are the line ends below). KC_CTL = that texture. For
+ * the PS4/PS5 and Xbox sets the port draws its own picture: a simplified body outline, the shoulder bars and the
+ * buttons of that pad, strokes in the game's style (grey body, white buttons and lines), and the leader lines from
+ * the same outer ends, re-aimed at the buttons of the drawn pad. Nothing is copied from the original picture or from
+ * any maker's artwork: shapes are the port's own parametric drawing (leader coordinates measured on the game
+ * texture are numbers only). PS3 keeps the game's own picture. */
+typedef float (*pc_dist_fn)(float x, float y, const float* k);
+
+static float pc_d_seg(float x, float y, float ax, float ay, float bx, float by)
+{
+    const float dx = bx - ax, dy = by - ay, l2 = dx * dx + dy * dy;
+    float t = l2 > 0.f ? ((x - ax) * dx + (y - ay) * dy) / l2 : 0.f;
+    t = t < 0.f ? 0.f : t > 1.f ? 1.f : t;
+    const float ex = x - (ax + t * dx), ey = y - (ay + t * dy);
+    return sqrtf(ex * ex + ey * ey);
+}
+/* k = { n, x0, y0, x1, y1, ... } */
+static float pc_d_poly(float x, float y, const float* k)
+{
+    float d = 1e9f;
+    for (int i = 0; i + 1 < (int)k[0]; i++) {
+        const float v = pc_d_seg(x, y, k[1 + 2 * i], k[2 + 2 * i], k[3 + 2 * i], k[4 + 2 * i]);
+        if (v < d) d = v;
+    }
+    return d;
+}
+/* k = { cx, cy, R } */
+static float pc_d_circle(float x, float y, const float* k)
+{
+    const float dx = x - k[0], dy = y - k[1];
+    return sqrtf(dx * dx + dy * dy) - k[2];
+}
+/* k = { cx, cy, hx, hy, r } */
+static float pc_d_rbox(float x, float y, const float* k) { return kc_rbox(x, y, k[0], k[1], k[2], k[3], k[4]); }
+/* k = { cx, cy, arm, half-width, r }: a plus (the d-pad) */
+static float pc_d_plus(float x, float y, const float* k)
+{
+    const float a = kc_rbox(x, y, k[0], k[1], k[2], k[3], k[4]), b = kc_rbox(x, y, k[0], k[1], k[3], k[2], k[4]);
+    return a < b ? a : b;
+}
+/* k = { centre rbox (cx cy hx hy r), left grip (cx cy hx hy r), right grip (cx cy hx hy r) }: the body */
+static float pc_d_body(float x, float y, const float* k)
+{
+    float d = kc_rbox(x, y, k[0], k[1], k[2], k[3], k[4]);
+    for (int g = 1; g < 3; g++) {
+        const float v = kc_rbox(x, y, k[5 * g], k[5 * g + 1], k[5 * g + 2], k[5 * g + 3], k[5 * g + 4]);
+        if (v < d) d = v;
+    }
+    return d;
+}
+
+/* Stroke (hw > 0: the line |d| < hw) or fill (hw < 0: d < 0) of a distance function, grey `lum`, over the bounding
+ * box x0..x1, y0..y1 (the whole image when x1 <= x0). */
+static void pc_draw(uint8_t* img, int w, int h, pc_dist_fn fn, const float* k, float hw, float lum,
+                    int x0, int y0, int x1, int y1)
+{
+    if (x1 <= x0) { x0 = 0; y0 = 0; x1 = w; y1 = h; }
+    if (x0 < 0) x0 = 0;
+    if (y0 < 0) y0 = 0;
+    if (x1 > w) x1 = w;
+    if (y1 > h) y1 = h;
+    for (int y = y0; y < y1; y++) for (int x = x0; x < x1; x++) {
+        const float d = fn(x + 0.5f, y + 0.5f, k);
+        const float cov = hw > 0.f ? kc_clamp01(hw + 0.5f - fabsf(d)) : kc_clamp01(0.5f - d);
+        if (cov > 0.f) kc_over(img + ((size_t)y * w + x) * 4, lum, lum, lum, cov);
+    }
+}
+static void pc_line(uint8_t* img, int w, int h, const float* pts, int n, float lum)
+{
+    float k[32];
+    k[0] = (float)n;
+    float mnx = 1e9f, mny = 1e9f, mxx = -1e9f, mxy = -1e9f;
+    for (int i = 0; i < 2 * n; i++) k[1 + i] = pts[i];
+    for (int i = 0; i < n; i++) {
+        if (pts[2 * i] < mnx) mnx = pts[2 * i];
+        if (pts[2 * i] > mxx) mxx = pts[2 * i];
+        if (pts[2 * i + 1] < mny) mny = pts[2 * i + 1];
+        if (pts[2 * i + 1] > mxy) mxy = pts[2 * i + 1];
+    }
+    pc_draw(img, w, h, pc_d_poly, k, 0.62f, lum, (int)mnx - 2, (int)mny - 2, (int)mxx + 3, (int)mxy + 3);
+}
+static void pc_ring(uint8_t* img, int w, int h, float cx, float cy, float r, float hw, float lum)
+{
+    const float k[3] = { cx, cy, r };
+    pc_draw(img, w, h, pc_d_circle, k, hw, lum, (int)(cx - r) - 3, (int)(cy - r) - 3, (int)(cx + r) + 4, (int)(cy + r) + 4);
+}
+static void pc_rbox(uint8_t* img, int w, int h, float cx, float cy, float hx, float hy, float r, float hw, float lum)
+{
+    const float k[5] = { cx, cy, hx, hy, r };
+    pc_draw(img, w, h, pc_d_rbox, k, hw, lum, (int)(cx - hx) - 3, (int)(cy - hy) - 3, (int)(cx + hx) + 4, (int)(cy + hy) + 4);
+}
+
+/* The leader lines: outer end, optional bend, button end. One row per legend entry, in the game's picture the lines
+ * of: L2, L1, R2, R1 (the shoulder bars), d-pad up, d-pad centre, d-pad left, d-pad down, left stick, SELECT, right
+ * stick, triangle, square, circle, cross. Outer ends are the same for every set (the labels are the game's). */
+typedef struct { int n; float p[8]; } pc_lead;
+enum { PCL_L2, PCL_L1, PCL_R2, PCL_R1, PCL_DUP, PCL_DMID, PCL_DLEFT, PCL_DDOWN, PCL_LS, PCL_SEL, PCL_RS, PCL_TRI, PCL_SQR,
+       PCL_CIR, PCL_CRS, PCL_N };
+
+/* Button places of a pad: shared by the leader targets and the shapes. */
+typedef struct {
+    float body[15];                     /* pc_d_body */
+    float l2[4], l1[4], r2[4], r1[4];   /* shoulder bars: cx cy hx hy */
+    float dpad[2], ls[2], rs[2], tri[2], sqr[2], cir[2], crs[2];
+} pc_layout;
+
+static void pc_layout_of(int xbox, pc_layout* L)
+{
+    static const float ps[15] = { 256.f, 112.f, 150.f, 66.f, 52.f, 124.f, 172.f, 44.f, 68.f, 42.f, 388.f, 172.f, 44.f, 68.f, 42.f };
+    static const float xb[15] = { 256.f, 108.f, 144.f, 64.f, 56.f, 118.f, 172.f, 42.f, 66.f, 40.f, 394.f, 172.f, 42.f, 66.f, 40.f };
+    memcpy(L->body, xbox ? xb : ps, sizeof ps);
+    const float l2[4] = { 159.f, 16.f, 24.f, 10.f }, l1[4] = { 155.f, 36.5f, 23.f, 9.5f };
+    const float r2[4] = { 343.f, 16.f, 24.f, 10.f }, r1[4] = { 347.f, 36.5f, 23.f, 9.5f };
+    memcpy(L->l2, l2, sizeof l2); memcpy(L->l1, l1, sizeof l1); memcpy(L->r2, r2, sizeof r2); memcpy(L->r1, r1, sizeof r1);
+    /* the same button places for every pad: the leader lines (and the game's labels) fix them */
+    const float dp[2] = { 153.f, 117.f }, ls[2] = { 207.f, 172.f }, rs[2] = { 296.f, 172.f }, tri[2] = { 349.f, 89.f },
+                sq[2] = { 322.f, 117.f }, ci[2] = { 378.f, 117.f }, cr[2] = { 349.f, 146.f };
+    memcpy(L->dpad, dp, sizeof dp); memcpy(L->ls, ls, sizeof ls); memcpy(L->rs, rs, sizeof rs); memcpy(L->tri, tri, sizeof tri);
+    memcpy(L->sqr, sq, sizeof sq); memcpy(L->cir, ci, sizeof ci); memcpy(L->crs, cr, sizeof cr);
+}
+
+static void pc_leads(const pc_layout* L, float sel_x, float sel_y, pc_lead out[PCL_N])
+{
