+        [PCL_DDOWN] = { 3, { 48.f, 187.f, 80.f, 187.f, L->dpad[0] - 1.f, L->dpad[1] + 30.f } },
+        [PCL_LS]    = { 2, { 140.f, 251.f, L->ls[0] - 17.f, L->ls[1] + 17.f } },
+        [PCL_SEL]   = { 4, { 213.f, 215.f, 250.f, 159.f, 250.f, sel_y, sel_x, sel_y } },
+        [PCL_RS]    = { 2, { 364.f, 251.f, L->rs[0] + 17.f, L->rs[1] + 17.f } },
