+        [PCL_SQR]   = { 3, { L->sqr[0] + 8.f, 114.f, 423.f, 114.f, 435.f, 121.f } },
+        [PCL_CIR]   = { 3, { 491.f, 155.f, 427.f, 155.f, L->cir[0] + 2.f, L->cir[1] + 14.f } },
+        [PCL_CRS]   = { 3, { 463.f, 188.f, 412.f, 188.f, L->crs[0] + 6.f, L->crs[1] + 12.f } },
