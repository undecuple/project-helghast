diff --git a/libs/video/rsx_pso_keys_hdr.h b/libs/video/rsx_pso_keys_hdr.h
new file mode 100644
index 0000000..1e8b24c
--- /dev/null
+++ b/libs/video/rsx_pso_keys_hdr.h
@@ -0,0 +1,44 @@
+/* KZ3 patch 2141: the header of the PSO preload's key file (pso_keys.bin, patch 2031) and its check.
+ * Design and code from the Killzone 2 port (Project Pyrrhus, its patch 6047).
+ *
+ * The key file maps a PSO key (guest microcode + render state) to the hashes of the HLSL the translator made for it,
+ * and the preload builds those pipelines from the compiled blobs before the walker asks for them; the walker then
+ * uses a preloaded PSO by key alone. A key file written by another build therefore hands this build the OLD
+ * translator's shaders. So the header carries the translator identity, RSX_TRANSLATOR_ID: a hash of the renderer's
+ * sources made at build time (port/kz3/CMakeLists.txt; 0 when the build does not define it). A file from another
+ * build is discarded with the pipeline library beside it, and the cache is rebuilt from this build's shaders (the
+ * compiled blobs are keyed by their HLSL text and stay valid).
+ * Pure C (host test tools/smoke/test_pso_keys_hdr.sh). */
+#ifndef RSX_PSO_KEYS_HDR_H
+#define RSX_PSO_KEYS_HDR_H
+#include <stdint.h>
+
+#ifndef RSX_TRANSLATOR_ID
+#define RSX_TRANSLATOR_ID 0ull
+#endif
+
+#define LD_PL_MAGIC   0x4C505350u   /* "PSPL" */
+#define LD_PL_VERSION 3u   /* patch 2042: keys hash only the sampled texture units; 2141: translator id in the header */
+
+typedef struct { uint32_t magic, version, rec_size, rs_size, cache_version, reserved, id_lo, id_hi; } ld_pl_hdr;
+
+enum { LD_PL_HDR_OK = 0, LD_PL_HDR_LAYOUT = 1, LD_PL_HDR_TRANSLATOR = 2 };
+
+static inline ld_pl_hdr ld_pl_hdr_make(uint32_t rec_size, uint32_t rs_size, uint32_t cache_version, uint64_t id)
+{
+    ld_pl_hdr h = { LD_PL_MAGIC, LD_PL_VERSION, rec_size, rs_size, cache_version, 0u, (uint32_t)id, (uint32_t)(id >> 32) };
+    return h;
+}
+
+static inline uint64_t ld_pl_hdr_id(const ld_pl_hdr* h) { return ((uint64_t)h->id_hi << 32) | h->id_lo; }
+
+/* LD_PL_HDR_OK, LD_PL_HDR_LAYOUT (another file layout or cache version: unreadable) or LD_PL_HDR_TRANSLATOR (readable,
+ * but written by a build with another translator: its shaders are not this build's). */
+static inline int ld_pl_hdr_check(const ld_pl_hdr* h, uint32_t rec_size, uint32_t rs_size, uint32_t cache_version, uint64_t id)
+{
+    if (h->magic != LD_PL_MAGIC || h->version != LD_PL_VERSION || h->rec_size != rec_size || h->rs_size != rs_size ||
+        h->cache_version != cache_version)
+        return LD_PL_HDR_LAYOUT;
+    return ld_pl_hdr_id(h) == id ? LD_PL_HDR_OK : LD_PL_HDR_TRANSLATOR;
+}
+#endif
