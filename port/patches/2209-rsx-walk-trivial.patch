--- /dev/null
+++ b/libs/video/rsx_walk_trivial.h
@@ -0,0 +1,82 @@
+/* KZ3 patch 2209 (RSX pass 174): RSX_WALK_TRIVIAL=1, the trivial-walker measurement switch (default off, diagnostic, never shipped).
+ * Pure C (no OS calls, no globals): the caller owns the instance, passes the clock and the guest-signal counters in, and a host
+ * test builds it. Walker thread only for the counters (relaxed atomics, the report may read them from the flip callback).
+ *
+ * What the switch does (the glue is in rsx_live_draw.c): the walker still consumes the FIFO and keeps labels, semaphores, reports
+ * and guest copies in order (all of that is in cellGcmSys.c and untouched), but the live-draw sink drops every begin / draw /
+ * inline array / indexed draw / end / clear (counted), and a flip is consumed (the guest's flip status advances) without
+ * presenting. Purpose: main-thread compute and SPU floors without the walker (U1/U2 of fps-path-60).
+ *
+ * Guest write-backs that need GPU output, exactly: surf_wb (kind 19, colour-surface write-back), wbd_drain (kind 20, deferred
+ * store) and report_rb (kind 11, the renderer's query-drain value). With no draw there is no surface and no query, so none of
+ * them has anything to read back: they do not run (counted, expected 0) and the guest bytes stay as the guest or an SPU last
+ * wrote them. Nothing is zero-filled and nothing is faked; the line says so. NV0039/NV3089/NV308A copies run on guest memory as
+ * before; one whose source is a render target reads those stale guest bytes. */
+#ifndef RSX_WALK_TRIVIAL_H
+#define RSX_WALK_TRIVIAL_H
+#include <stddef.h>
+#include <stdio.h>
+
+typedef struct {
+    int on;
+    unsigned long long methods, draws, clears, flips, wb_req;   /* bumped by the glue (relaxed atomics) */
+    long long t_last;                                           /* ticks of the last report */
+    unsigned long long p_methods, p_draws, p_clears, p_flips, p_wb_req;
+    unsigned long long p_labels, p_reports, p_gpuwb, p_copies;
+    int announced;
+} rsx_wt;
+
+/* the switch: set and not "0" */
+static inline int rsx_wt_parse(const char* e) { return e && *e && *e != '0'; }
+static inline void rsx_wt_init(rsx_wt* w, const char* env)
+{
+    *w = (rsx_wt){0};
+    w->on = rsx_wt_parse(env);
+}
+#define RSX_WT_ADD(w, f, n) __atomic_fetch_add(&(w)->f, (unsigned long long)(n), __ATOMIC_RELAXED)
+
+/* the line printed once at arm */
+static inline size_t rsx_wt_arm_line(char* b, size_t cap)
+{
+    return (size_t)snprintf(b, cap,
+        "[walk-trivial] on (RSX_WALK_TRIVIAL=1, patch 2209): the walker consumes the FIFO and keeps labels, semaphores, reports and "
+        "guest copies in order, but records and submits NO draw or clear (sink begin/draw/end/clear dropped and counted); a flip is "
+        "consumed (guest flip status advances) and not presented. GPU-output write-backs (surf_wb, wbd_drain, report_rb) never run "
+        "(no surface, no query exists): render-target guest bytes stay as the guest or an SPU last wrote them, NOT zero-filled, NOT "
+        "GPU output; NV0039/NV3089/NV308A copies run on guest memory and read those stale bytes from a render-target source. The "
+        "picture is blank: diagnostic only, never shipped");
+}
+
+/* one report line from the deltas of the last period */
+static inline size_t rsx_wt_fmt(char* b, size_t cap, double secs, unsigned long long flips, unsigned long long methods,
+                                unsigned long long draws, unsigned long long clears, unsigned long long labels,
+                                unsigned long long reports, unsigned long long gpuwb, unsigned long long copies,
+                                unsigned long long wb_req)
+{
+    return (size_t)snprintf(b, cap,
+        "[walk-trivial] %.2fs flips=%llu methods=%llu | dropped draws=%llu clears=%llu | released labels/sems=%llu reports=%llu "
+        "| guest copies (on guest memory)=%llu | GPU write-backs run=%llu (expected 0; requests seen=%llu, no GPU output, no zero-fill)",
+        secs, flips, methods, draws, clears, labels, reports, copies, gpuwb, wb_req);
+}
+
+/* Once per second at most: fills `b` and returns its length, or 0 when no report is due. now/freq are clock ticks; the five
+ * counters are the cumulative g_rsx_gs_n values the glue sums (walker side): labels = label+resync_label+sem_be, reports =
+ * report+report_local, gpuwb = surf_wb+wbd_drain+report_rb, copies = copy0039+copy3089+store308a. */
+static inline size_t rsx_wt_tick(rsx_wt* w, long long now, long long freq, unsigned long long labels,
+                                 unsigned long long reports, unsigned long long gpuwb, unsigned long long copies, char* b, size_t cap)
+{
+    if (!w->on || freq <= 0) return 0;
+    if (w->t_last == 0) { w->t_last = now; return 0; }
+    if (now - w->t_last < freq) return 0;
+    const double secs = (double)(now - w->t_last) / (double)freq;
+    const unsigned long long m = __atomic_load_n(&w->methods, __ATOMIC_RELAXED), d = __atomic_load_n(&w->draws, __ATOMIC_RELAXED),
+        c = __atomic_load_n(&w->clears, __ATOMIC_RELAXED), f = __atomic_load_n(&w->flips, __ATOMIC_RELAXED),
+        r = __atomic_load_n(&w->wb_req, __ATOMIC_RELAXED);
+    const size_t n = rsx_wt_fmt(b, cap, secs, f - w->p_flips, m - w->p_methods, d - w->p_draws, c - w->p_clears,
+                                labels - w->p_labels, reports - w->p_reports, gpuwb - w->p_gpuwb, copies - w->p_copies, r - w->p_wb_req);
+    w->p_flips = f; w->p_methods = m; w->p_draws = d; w->p_clears = c; w->p_wb_req = r;
+    w->p_labels = labels; w->p_reports = reports; w->p_gpuwb = gpuwb; w->p_copies = copies;
+    w->t_last = now;
+    return n;
+}
+#endif
