+            else:                       # bytes 16-sh..15 of vS to the start of EA's quadword
+                st = f"if (sh) ppu_st_coh((uint32_t)(ea & ~0xFULL), {s} + (16u - sh), sh);"
+            return f"{{ uint64_t ea = {_xea(ra, rb)}; uint32_t sh = (uint32_t)(ea & 0xF); {st} }}"
