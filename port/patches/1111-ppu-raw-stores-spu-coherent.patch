--- a/tools/ppu_lifter.py
+++ b/tools/ppu_lifter.py
@@ -151,13 +151,22 @@
 #define VM_RAW_LD(T, ea) ({ const uint8_t* _p = vm_base + (uint32_t)(ea); T _v; \
     if (!((uintptr_t)_p & (sizeof(T) - 1))) _v = __atomic_load_n((const T*)_p, __ATOMIC_RELAXED); \
     else memcpy(&_v, _p, sizeof(T)); _v; })
+/* KZ3 patch 1111 (from JonathanDC64/ps3recomp PR #38, adapted): a raw store is a guest store like vm_write*'s,
+ * so on a 128-byte line an SPU has reserved it commits the same way -- under the line's stripe, with the SPU
+ * reservation broken and SPU_EVENT_LR raised (ppu_st_coh, runtime/ppu/ppu_loader.cpp). Without it a stvx, dcbz
+ * or stwbrx that lands between a PUTLLC's compare and its copy is written back over by the PUTLLC (a lost PPU
+ * store), and an SPU waiting on the line hears of it only from the RdEventStat poll. */
+int  spu_coh_is_reserved(uint32_t addr);
+void ppu_st_coh(uint32_t ea, const void* src, uint32_t n);
 #define VM_RAW_ST(T, ea, val) do { uint8_t* _p = vm_base + (uint32_t)(ea); T _v = (val); \
-    if (!((uintptr_t)_p & (sizeof(T) - 1))) __atomic_store_n((T*)_p, _v, __ATOMIC_RELAXED); \
+    if (__builtin_expect(spu_coh_is_reserved((uint32_t)(ea)), 0)) ppu_st_coh((uint32_t)(ea), &_v, sizeof(T)); \
+    else if (!((uintptr_t)_p & (sizeof(T) - 1))) __atomic_store_n((T*)_p, _v, __ATOMIC_RELAXED); \
     else memcpy(_p, &_v, sizeof(T)); } while (0)
 static inline void vm_raw_ld16(void* dst, uint64_t ea) {   /* quadword-aligned */
     uint64_t lo = VM_RAW_LD(uint64_t, ea), hi = VM_RAW_LD(uint64_t, ea + 8);
     memcpy(dst, &lo, 8); memcpy((uint8_t*)dst + 8, &hi, 8); }
-static inline void vm_raw_st16(uint64_t ea, const void* src) {
+static inline void vm_raw_st16(uint64_t ea, const void* src) {   /* one line: one locked commit (patch 1111) */
+    if (__builtin_expect(spu_coh_is_reserved((uint32_t)ea), 0)) { ppu_st_coh((uint32_t)ea, src, 16); return; }
     uint64_t lo, hi; memcpy(&lo, src, 8); memcpy(&hi, (const uint8_t*)src + 8, 8);
     VM_RAW_ST(uint64_t, ea, lo); VM_RAW_ST(uint64_t, ea + 8, hi); }
 extern int      vm_inline_ok;
