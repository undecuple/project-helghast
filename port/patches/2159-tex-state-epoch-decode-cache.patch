+/* KZ3 patch 2159 (RSX pass 147): reuse the decoded texture-register state across draws.
+ *
+ * rsx_dispatch.tex_ep[u] changes (fresh value from a never-reset counter) exactly when a store changes one of unit u's
+ * 9 registers, so "tex_ep[u] equals the epoch a cached record was made at" means those 9 words are bit-identical now.
+ * Two users, both in rsx_live_draw.c:
+ *   - the decode cache (rsx_tex_dec): rsx_dsp_get_texture is a pure function of the 9 words;
+ *   - the per-unit binding row (rsx_tex_l1): what the registers resolved to when the unit took the plain texture-cache
+ *     path (same record condition and same validity checks as the patch 2136 keyed memo; the keyed memo stays as the
+ *     second level, RSX_TEX_CACHE=1).
+ * Texture CONTENT is never cached here: a hit still runs texture_srv_slot_entry (once-per-frame hash decision with the
+ * writers' page bitmap), exactly like a 2136 hit.
+ * RSX_TEX_EPOCH: unset or 0 off (default since pass 151), 1 on, verify = on, every reuse is recomputed and compared, mismatches are
+ * counted and the fresh value is used. Host test: tools/smoke/test_tex_epoch.py. */
+#ifndef RSX_TEX_EPOCH_H
+#define RSX_TEX_EPOCH_H
+#include <string.h>
+#include "rsx_dispatch.h"
+
+static inline int rsx_tex_epoch_parse(const char* e)
+{
+    if (!e || !e[0]) return 0;
+    if (!strcmp(e, "verify")) return 2;
+    return e[0] == '1' ? 1 : 0;
+}
+
+typedef struct { u32 valid, ep; rsx_dsp_texture t; } rsx_tex_dec;
+typedef struct { unsigned long long hit, miss, bad; } rsx_tex_dec_stat;
+
+/* rsx_dsp_get_texture through the per-unit cache. mode 0: plain decode. */
+static inline void rsx_tex_dec_get(rsx_tex_dec dc[16], const rsx_dispatch* rsx, u32 u, rsx_dsp_texture* out, int mode,
+                                   rsx_tex_dec_stat* st)
+{
+    if (!mode || u >= 16u) { rsx_dsp_get_texture(rsx, u, out); return; }
+    rsx_tex_dec* c = &dc[u];
+    if (c->valid && c->ep == rsx->tex_ep[u]) {
+        st->hit++;
+        if (mode == 2) {
+            rsx_dsp_texture f; rsx_dsp_get_texture(rsx, u, &f);
+            if (memcmp(&f, &c->t, sizeof f)) { st->bad++; c->t = f; *out = f; return; }
+        }
+        *out = c->t;
+        return;
+    }
+    st->miss++;
+    rsx_dsp_get_texture(rsx, u, out);
+    c->t = *out; c->ep = rsx->tex_ep[u]; c->valid = 1;
+}
+
+/* Per-unit binding row. kind 0 none, 1 unit disabled, 2 bound (idx/smp/gens valid). */
+typedef struct {
+    u32 kind, ep;
+    u32 raw[9];
+    rsx_dsp_texture t;
+    u32 surf_gen, zgen, epoch, idx, smp;
+} rsx_tex_l1;
+
+/* May the row stand in for this draw's resolution of unit u? Registers (epoch), surfaces/zetas/device generations;
+ * the caller still checks that the texture-cache entry still holds the key (ld_tex_entry_is). */
+static inline int rsx_tex_l1_hit(const rsx_tex_l1* r, const rsx_dispatch* rsx, u32 u, u32 surf_gen, u32 zgen, u32 epoch)
+{
+    if (!r->kind || r->ep != rsx->tex_ep[u]) return 0;
+    if (r->kind == 1) return 1;
+    return r->surf_gen == surf_gen && r->zgen == zgen && r->epoch == epoch;
+}
+#endif
