+/* Patch 2159: texture-state epochs. One counter for the whole process, never reset, so a re-initialised or re-seeded
+ * register file can never hand out an epoch an older cached decode holds. Unit of a method: the 8-word blocks from
+ * M_TEX_OFFSET (0x1A00..0x1BFF) and the SIZE1 words (0x1840..0x187F). */
+static u32 g_tex_ep_ctr;
+static void tex_ep_all(rsx_dispatch* rsx)
+{
+    for (u32 u = 0; u < 16; u++) rsx->tex_ep[u] = ++g_tex_ep_ctr;
+}
+static inline void tex_ep_store(rsx_dispatch* rsx, u32 method, u32 idx, u32 arg)
+{
+    u32 u;
+    if (method - 0x1A00u < 0x200u) u = (method - 0x1A00u) >> 5;
+    else if (method - 0x1840u < 0x40u) u = (method - 0x1840u) >> 2;
+    else return;
+    if (rsx->regs[idx] != arg) rsx->tex_ep[u] = ++g_tex_ep_ctr;
+}
