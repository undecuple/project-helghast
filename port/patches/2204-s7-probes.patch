+    x.addrs = (void**)malloc((size_t)x.pages * sizeof(void*));
+    if (!x.plain || !x.watched || !x.addrs) { fprintf(stderr, "[s7-ww] allocation failed (pages=%u)\n", x.pages); }
+    else {
+        static const rsx_s7p_ww_ops ops = { s7_ww_now, s7_ww_plain, s7_ww_watched, s7_ww_reset, s7_ww_query };
+        rsx_s7p_ww_res a, b; char ln[768];
+        rsx_s7p_ww_run(&ops, &x, x.pages, 60, 100, &a); rsx_s7p_ww_run(&ops, &x, x.pages, 60, 25, &b);
