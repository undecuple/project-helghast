+/* Patch 2204 (RSX_O0_S7=1): the spans of ld_o0v_spans (same arithmetic, same order) plus the host pointer of each attribute span:
+ * stable_base is the element stable_first, so it is the byte at `off`. Never g.guest_ptr (it would drain 2185 stores). The index
+ * span has no host pointer here (src NULL: its pages are counted, not hashed). */
+static unsigned ld_s7_spans(rsx_s7p_span* out, unsigned* nospan)
+{
+    unsigned ns = 0; *nospan = 0;
+    if (dc.n_idx) {
+        rsx_dsp_index_array ia; rsx_dsp_get_index_array(&g.rsx, &ia);
+        const u32 esz = ia.is_u32 ? 4u : 2u;
+        u64 lo = ~0ull, hi = 0;
+        for (u32 i = 0; i < dc.n_idx; i++) {
+            if (!dc.idx[i].count) continue;
+            const u64 a = (u64)ia.offset + (u64)dc.idx[i].first * esz, b = a + (u64)dc.idx[i].count * esz;
+            if (a < lo) lo = a;
+            if (b > hi) hi = b;
+        }
+        if (hi > lo && hi <= 0x100000000ull && ia.location <= 1u) { out[ns].loc = ia.location; out[ns].off = (u32)lo; out[ns].len = (u32)(hi - lo); out[ns].src = NULL; ns++; }
+    }
+    for (u32 slot = 0; slot < dc.layout.count; slot++) {
+        const rsx_vertex_fetch_attr* f = &dc.fetch_plan.attr[dc.layout.attrs[slot]];
+        if (!f->desc.type || !f->desc.size) continue;
+        if (!f->stable_base || f->desc.location > 1u || ns >= RSX_S7P_SPANS) { (*nospan)++; continue; }
+        const u64 a = (u64)dc.fetch_plan.base_offset + f->desc.offset + (u64)f->stable_first * f->stride;
+        const u64 b = (u64)dc.fetch_plan.base_offset + f->desc.offset + (u64)f->stable_last * f->stride + f->elem_size;
+        if (b > 0x100000000ull || b <= a) { (*nospan)++; continue; }
+        out[ns].loc = f->desc.location; out[ns].off = (u32)a; out[ns].len = (u32)(b - a); out[ns].src = f->stable_base; ns++;
+    }
