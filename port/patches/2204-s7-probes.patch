+/* KZ3 patch 2204 (S7.0 probes, RSX_O0=1 + RSX_O0_S7=1): measurement only, no behaviour change.
+ * Pure C11 (stdint/stdio/stdlib/string only; no platform headers, no SIMD, no asm). The walker hooks live in
+ * rsx_live_draw.c, rsx_commands.c (through a function pointer) and cellGcmSys.c; every hook is `if (on)`.
+ * Docs: the RE notes "S7.0 probes". Times are ticks of the injected clock; the formatters take the
+ * tick factor tk (ms per tick). All counters are monotonic; a period is the difference of two copies.
+ * RSX_S7P_TEST_FAULT=N (host-test control builds only) breaks one rule on purpose, N = 1..11. */
+#ifndef RSX_S7P_H
+#define RSX_S7P_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define RSX_S7P_BINS 24             /* log2 histogram bins */
+#define RSX_S7P_EP_TAB 65536u       /* distinct pages per flip: 32768 max, then ovf */
