+    if (g_rsx_s7p.held_open) di.held_eq = vm_read32(g_rsx_s7p.held_la) == g_rsx_s7p.held_v;
+    if (g_rsx_s7p.on) rsx_s7p_draw(&g_rsx_s7p, &di);
