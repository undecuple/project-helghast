+            di.sp[di.n_spans].loc = vc_hit->spans[i].loc; di.sp[di.n_spans].off = vc_hit->spans[i].off;
+            di.sp[di.n_spans].len = vc_hit->spans[i].len; di.sp[di.n_spans].src = NULL; di.n_spans++;
+        }
