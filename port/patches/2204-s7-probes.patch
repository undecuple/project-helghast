+/* vg reasons, the order of rsx_vtx_gpu.h (RSX_VG_OK, NO_INPUTS, DIVIDED, UNMAPPED, TYPE, BIG) */
+#define RSX_S7P_NVG 6
+
+/* by_kind order (the print order); names are the funnel names of rsx_guest_signal.h */
+static const char* const rsx_s7p_kind_name[RSX_S7P_NKIND] = {
+    "label", "ref", "report", "sem_be", "copy0039", "copy3089", "store308a", "surf_wb", "wbd_drain", "flip", "usercmd",
+    "present", "notify", "get_jump", "get_rel", "get_end", "report_rb", "resync_label" };
+static inline int rsx_s7p_kind_by_name(const char* nm)
+{
+    if (!nm) return -1;
+    for (int i = 0; i < RSX_S7P_NKIND; i++) if (!strcmp(nm, rsx_s7p_kind_name[i])) return i;
+    return -1;   /* ring_jump, ctx_word, put_recycle, ref_push, report_local: not barriers of this probe */
