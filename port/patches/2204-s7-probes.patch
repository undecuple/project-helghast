+    /* hold */
+    int held_open; uint32_t held_la, held_v, hold_id; long long held_t0;
+    int acq_key_valid; uint32_t acq_pos, acq_la, acq_v;   /* the last unmet acquire (re-poll dedup) */
+    int misuse; int tm_open;   /* timer nesting misuse counter / open flag */
+} rsx_s7p;
+
+static inline void rsx_s7p_lock(rsx_s7p* s) { while (__atomic_exchange_n(&s->lock, 1, __ATOMIC_ACQUIRE)) { } }
+static inline void rsx_s7p_unlock(rsx_s7p* s) { __atomic_store_n(&s->lock, 0, __ATOMIC_RELEASE); }
+
+static inline uint64_t rsx_s7p_fnv(const uint8_t* p, unsigned n)
+{
+    uint64_t h = 1469598103934665603ull; unsigned i = 0;
+    for (; i + 8 <= n; i += 8) { uint64_t w; memcpy(&w, p + i, 8); h = (h ^ w) * 1099511628211ull; }
+    for (; i < n; i++) h = (h ^ p[i]) * 1099511628211ull;
+    return h;
+}
+static inline int rsx_s7p_bin(uint64_t n) { int b = 0; while (n > 1 && b < RSX_S7P_BINS - 1) { n >>= 1; b++; } return b; }
+static inline long long rsx_s7p_bin_ub(int b) { return (1ll << (b + 1)) - 1; }
+static inline long long rsx_s7p_pct(const long long* c, const long long* p, int pct)
+{
+    long long tot = 0; for (int i = 0; i < RSX_S7P_BINS; i++) tot += c[i] - (p ? p[i] : 0);
+    if (tot <= 0) return 0;
+    long long cum = 0, need = (tot * pct + 99) / 100;
+    for (int i = 0; i < RSX_S7P_BINS; i++) { cum += c[i] - (p ? p[i] : 0); if (cum >= need) return rsx_s7p_bin_ub(i); }
+    return rsx_s7p_bin_ub(RSX_S7P_BINS - 1);
+}
+/* sample factor: sampled pages x samp = the estimate (samp 0 = no hashing = 0) */
+static inline long long rsx_s7p_est(long long sampled, int samp)
+{
+#if defined(RSX_S7P_TEST_FAULT) && RSX_S7P_TEST_FAULT == 4
+    (void)samp; return sampled;
+#else
+    return samp > 0 ? sampled * samp : 0;
+#endif
+}
+static inline int rsx_s7p_sampled(uint64_t key, int samp)
+{
+    if (samp <= 0) return 0;
+#if defined(RSX_S7P_TEST_FAULT) && RSX_S7P_TEST_FAULT == 10
+    return (int)(((key * 0x9E3779B97F4A7C15ull) >> 58) % (unsigned)samp) == 0;   /* fault 10: the old 6-bit modulo, biased for samp not a power of two */
+#else
+    /* multiply-shift on the top 32 hash bits: h32 * samp >> 32 is uniform over 0..samp-1 for any samp, so "== 0" selects 1/samp of the
+     * pages to within 2^-32 (a modulo of 6 bits was exact only for powers of two: samp 7 sampled 15.6 % instead of 14.3 %) */
+    const uint64_t h32 = (key * 0x9E3779B97F4A7C15ull) >> 32;
+    return ((h32 * (uint64_t)(unsigned)samp) >> 32) == 0;
+#endif
+}
+
+/* clocks is bumped with an atomic add (the perf thread copies c under the lock, the walker bumps it outside the lock: a plain ++ was a data race) */
+static inline long long rsx_s7p_now(rsx_s7p* s) { __atomic_fetch_add(&s->c.clocks, 1, __ATOMIC_RELAXED); return s->clock ? s->clock() : 0; }
+
+/* Cold unit cost of one 4096-byte hash. A 4 KiB buffer hashed 64 times stays in L1, so it understates what a draw pays reading
+ * guest memory that is not in cache. The buffer here is RSX_S7P_COLD_PAGES pages (32 MiB, beyond the L2/L3 of the target CPUs),
+ * written once, then every page is hashed once in a stride order (an odd stride visits each page exactly once, and defeats the
+ * sequential prefetcher across pages). The result is ticks per page. */
+#define RSX_S7P_COLD_PAGES 8192u   /* power of two (the stride must be coprime to it) */
+static inline unsigned rsx_s7p_cold_page(unsigned i, unsigned pages)
+{
+#if defined(RSX_S7P_TEST_FAULT) && RSX_S7P_TEST_FAULT == 9
+    return (unsigned)(((uint64_t)i * 4096u) % pages);   /* fault 9: an even stride, visits only two pages */
+#else
+    return (unsigned)(((uint64_t)i * 4999u) % pages);
+#endif
+}
+static inline double rsx_s7p_measure_cold(long long (*clock)(void), const uint8_t* buf, unsigned pages)
+{
+    volatile uint64_t sink = 0; uint64_t acc = 0;
+    const long long a = clock();
+    for (unsigned i = 0; i < pages; i++) acc += rsx_s7p_fnv(buf + (size_t)rsx_s7p_cold_page(i, pages) * 4096u, 4096);
+    const long long b = clock();
+    sink = acc; (void)sink;
+    return pages ? (double)(b - a) / (double)pages : 0.0;
+}
+
+/* init: parse the sample factor, allocate the tables, measure the unit costs. env_samp NULL/"" = 4. 1 = ok. */
+static inline int rsx_s7p_init(rsx_s7p* s, long long (*clock)(void), const char* env_samp)
+{
+    memset(s, 0, sizeof *s);
+    s->clock = clock; s->samp = 4;
+    if (env_samp && *env_samp) { char* e = NULL; long v = strtol(env_samp, &e, 0); if (e != env_samp && !*e && v >= 0 && v <= 4096) s->samp = (int)v; }
+    s->ep = (rsx_s7p_ep*)calloc(RSX_S7P_EP_TAB, sizeof *s->ep);
+    s->pe = (rsx_s7p_pe*)calloc(RSX_S7P_PE_TAB, sizeof *s->pe);
+    s->rf = (uint64_t*)calloc(RSX_S7P_RF_TAB, sizeof *s->rf);
+    if (!s->ep || !s->pe || !s->rf) { free(s->ep); free(s->pe); free(s->rf); s->ep = NULL; s->pe = NULL; s->rf = NULL; return 0; }
+    if (clock) {
+        static uint8_t buf[4096]; volatile uint64_t sink = 0;
+        long long a = clock(); for (int i = 0; i < 10000; i++) (void)clock();
+        long long b = clock(); s->unit_clock = (double)(b - a) / 10000.0;
+        a = clock(); for (int i = 0; i < 64; i++) sink += rsx_s7p_fnv(buf, 4096) + (uint64_t)i;
+        b = clock(); s->unit_hash = (double)(b - a) / 64.0; (void)sink;   /* the hot fallback (only when the cold buffer cannot be allocated) */
+        uint8_t* cold = (uint8_t*)malloc((size_t)RSX_S7P_COLD_PAGES * 4096u);
+        if (cold) { memset(cold, 0x5A, (size_t)RSX_S7P_COLD_PAGES * 4096u); s->unit_hash = rsx_s7p_measure_cold(clock, cold, RSX_S7P_COLD_PAGES); s->cold_hash = 1; free(cold); }
+    }
+    s->on = 1; s->c.clocks = 0;
+    return 1;
+}
+static inline void rsx_s7p_free(rsx_s7p* s) { free(s->ep); free(s->pe); free(s->rf); s->ep = NULL; s->pe = NULL; s->rf = NULL; s->on = 0; }
+
+/* ---- fill timers: begin/end pairs; walker thread; misuse (end without begin, begin while open) is counted ---- */
+static inline long long rsx_s7p_tm_begin(rsx_s7p* s)
+{
+    if (s->tm_open) s->misuse++;
+    s->tm_open = 1; return rsx_s7p_now(s);
+}
+static inline void rsx_s7p_tm_end(rsx_s7p* s, int which, long long t0)
+{
+    if (!s->tm_open) { s->misuse++; return; }
+    s->tm_open = 0;
+    const long long d = rsx_s7p_now(s) - t0;
+    rsx_s7p_lock(s); s->c.t[which] += d; rsx_s7p_unlock(s);
+}
+/* ticks measured by the caller (plan/fetch pair) */
+static inline void rsx_s7p_t_add(rsx_s7p* s, int which, long long ticks)
+{
+    rsx_s7p_lock(s); s->c.t[which] += ticks; rsx_s7p_unlock(s);
+}
+
+/* ---- barriers ---- */
+static inline void s7p_cut(rsx_s7p* s, int ti, int count_idle)
+{
+    rsx_s7p_trc* ct = &s->c.tr[ti];
+    if (s->tr[ti].n > 0
+#if defined(RSX_S7P_TEST_FAULT) && RSX_S7P_TEST_FAULT == 5
+        || 1
+#endif
+    ) {
+        ct->joins++;
+#if defined(RSX_S7P_TEST_FAULT) && RSX_S7P_TEST_FAULT == 6
+        ct->ovl += s->tr[ti].m;
+#else
+        ct->ovl += s->tr[ti].m - s->tr[ti].last;
+#endif
+        ct->hist[rsx_s7p_bin((uint64_t)s->tr[ti].n)]++;
+    } else if (count_idle) ct->idle++;
+    s->tr[ti].n = s->tr[ti].m = s->tr[ti].last = 0;
+}
+/* cls: CHUNK (a command-list submit), GATE (guest-visible C event that gates fills), GET. kind: by_kind slot or -1. */
+static inline void rsx_s7p_barrier(rsx_s7p* s, int cls, int kind)
+{
+    if (cls == RSX_S7P_CLS_NONE) return;
+    rsx_s7p_lock(s);
+    if (cls == RSX_S7P_CLS_CHUNK) s->c.chunks++;
+    if (cls != RSX_S7P_CLS_CHUNK && kind >= 0 && kind < RSX_S7P_NKIND) {
+        if (cls == RSX_S7P_CLS_GATE && s->tr[RSX_S7P_TR_NARROW].n > 0) s->c.by_kind[kind]++;
+        if (cls == RSX_S7P_CLS_GET && s->tr[RSX_S7P_TR_ALL].n > 0) { s->c.by_kind[kind]++; s->c.get_only_cuts++; }
+    }
+    if (cls != RSX_S7P_CLS_GET) {
+        if (s->tr[RSX_S7P_TR_NARROW].n > 0) { if (s->reuse_flag) s->c.reuse_barriers++; else s->c.disjoint_barriers++; }
+        s->reuse_flag = 0; s->nar_ep++;
+    }
+    if (cls == RSX_S7P_CLS_CHUNK) s7p_cut(s, RSX_S7P_TR_CHUNK, 1);
+    if (cls != RSX_S7P_CLS_GET) s7p_cut(s, RSX_S7P_TR_NARROW, 1);
+    s7p_cut(s, RSX_S7P_TR_ALL, 1);
+    rsx_s7p_unlock(s);
+}
+/* funnel entry (rsx_commands.c): the name of the kind, walker thread only */
+static inline void rsx_s7p_barrier_name(rsx_s7p* s, const char* name)
+{
+    const int k = rsx_s7p_kind_by_name(name);
+    rsx_s7p_barrier(s, rsx_s7p_kind_class(k), k);
+}
+/* a ring cursor reset (g.vb_used = 0): counted; cuts the trackers only when fills are pending (no idle) */
+static inline void rsx_s7p_ring_reset(rsx_s7p* s)
+{
+    rsx_s7p_lock(s);
+    s->c.ring_resets++;
+    for (int i = 0; i < RSX_S7P_NTR; i++) if (s->tr[i].n > 0) s7p_cut(s, i, 0);
+    rsx_s7p_unlock(s);
+}
+
+/* ---- held pages ---- */
+/* pos = the FIFO position of the acquire. With GCM_SEMA_ACQUIRE=1 an unmet acquire is polled again on every walk pass until it is
+ * met; that is one acquire, so a re-poll of the same (pos, label, value) with no draw in between (a draw clears the key) and no met
+ * acquire in between is not counted again. Two different acquires differ in pos. */
+static inline void rsx_s7p_acq(rsx_s7p* s, int met, uint32_t la, uint32_t v, long long now, uint32_t pos)
+{
+    rsx_s7p_lock(s);
+    if (met) { s->c.acq_met++; s->acq_key_valid = 0; }
+    else {
+#if defined(RSX_S7P_TEST_FAULT) && RSX_S7P_TEST_FAULT == 8
+        const int again = 0;   /* fault 8: every poll counts */
+#else
+        const int again = s->acq_key_valid && s->acq_pos == pos && s->acq_la == la && s->acq_v == v;
+#endif
+        s->acq_key_valid = 1; s->acq_pos = pos; s->acq_la = la; s->acq_v = v;
+        if (again) { rsx_s7p_unlock(s); return; }
+        s->c.acq_unmet++;
+        if (!s->held_open) { s->held_open = 1; s->held_la = la; s->held_v = v; s->held_t0 = now; s->hold_id++; }
+    }
+    rsx_s7p_unlock(s);
+}
+static inline void s7p_hold_close(rsx_s7p* s, long long now)
+{
+    if (!s->held_open) return;
+    s->c.held_ticks += now - s->held_t0; s->held_open = 0;
+}
+
+/* ---- pages ---- */
+static inline rsx_s7p_ep* s7p_ep_get(rsx_s7p* s, uint64_t key, int* created)
+{
+    const uint32_t f = s->cur_ep + 1u;
+    unsigned h = (unsigned)((key * 0x9E3779B97F4A7C15ull) >> 40) & (RSX_S7P_EP_TAB - 1u);
+    for (unsigned k = 0; k < RSX_S7P_EP_TAB; k++, h = (h + 1u) & (RSX_S7P_EP_TAB - 1u)) {
+        rsx_s7p_ep* e = &s->ep[h];
+        if (e->f == f && e->key == key) { *created = 0; return e; }
+        if (e->f != f) {   /* empty for this flip */
+            if (s->ep_n >= RSX_S7P_EP_MAX) { s->c.ovf++; return NULL; }
+            e->key = key; e->f = f; e->nar_ep = s->nar_ep; e->hold = 0; e->hashed = 0; s->ep_n++; *created = 1; return e;
+        }
+    }
+    s->c.ovf++; return NULL;
+}
+static inline rsx_s7p_pe* s7p_pe_get(rsx_s7p* s, uint64_t key, int* found)
+{
+    const uint32_t ep = s->cur_ep;
+    unsigned h = (unsigned)((key * 0x9E3779B97F4A7C15ull) >> 40) & (RSX_S7P_PE_TAB - 1u);
+    rsx_s7p_pe* freeslot = NULL;
+    for (unsigned k = 0; k < 16; k++) {
+        rsx_s7p_pe* e = &s->pe[(h + k) & (RSX_S7P_PE_TAB - 1u)];
+        if (e->key == key) { *found = 1; return e; }
+        if (!freeslot && (e->key == 0 || e->f < ep)) freeslot = e;
+    }
+    *found = 0;
+    if (!freeslot) { s->c.ovf++; freeslot = &s->pe[h]; }
+    freeslot->key = key;
+    return freeslot;
+}
+static inline void s7p_page(rsx_s7p* s, unsigned loc, uint64_t page, unsigned lo, unsigned plen, const uint8_t* srcp, int miss, int held)
+{
+    const uint64_t key = (((uint64_t)(loc & 1u) << 40) | page) + 1ull;
+    int created = 0;
+    rsx_s7p_ep* e = s7p_ep_get(s, key, &created);
+    if (!e) return;
+#if defined(RSX_S7P_TEST_FAULT) && RSX_S7P_TEST_FAULT == 1
+    s->c.read_loc[loc & 1u]++;   /* no per-flip dedup */
+#else
+    if (created) s->c.read_loc[loc & 1u]++;
+#endif
+    if (!created && e->nar_ep < s->nar_ep) s->reuse_flag = 1;
+    e->nar_ep = s->nar_ep;
+    if (held && e->hold != s->hold_id) { s->c.held_pages++; e->hold = s->hold_id; }
+    if (!miss) { if (created) s->c.hit_nohash++; return; }
+    if (e->hashed) return;
+    e->hashed = 1;
+    if (!srcp || !rsx_s7p_sampled(key, s->samp)) return;
+    const uint64_t h = rsx_s7p_fnv(srcp, plen);
+    s->c.hashed++;
+    int found = 0;
+    rsx_s7p_pe* pe = s7p_pe_get(s, key, &found);
+    if (found && pe->f == s->cur_ep) {   /* stored in the previous flip */
+        if (pe->lo == lo && pe->len == plen) {
+#if defined(RSX_S7P_TEST_FAULT) && RSX_S7P_TEST_FAULT == 3
+            s->c.changed++;
+#else
+            if (pe->hash == h) s->c.same++; else s->c.changed++;
+#endif
+        } else s->c.shape++;
+    } else s->c.newp++;
+    pe->f = s->cur_ep + 1u; pe->lo = (uint16_t)lo; pe->len = (uint16_t)plen; pe->hash = h;
+}
+static inline void s7p_spans(rsx_s7p* s, const rsx_s7p_draw_in* d, int miss, int held)
+{
+    for (unsigned i = 0; i < d->n_spans && i < RSX_S7P_SPANS; i++) {
+        const rsx_s7p_span* sp = &d->sp[i];
+        if (!sp->len) continue;
+        const uint64_t a = sp->off, b = a + sp->len;
+#if defined(RSX_S7P_TEST_FAULT) && RSX_S7P_TEST_FAULT == 2
+        const uint64_t last = b >> 12;   /* off by one at an exact boundary */
+#else
+        const uint64_t last = (b - 1) >> 12;
+#endif
+        for (uint64_t p = a >> 12; p <= last; p++) {
+            const uint64_t ps = p << 12, pe_ = ps + 4096u;
+            const uint64_t from = a > ps ? a : ps, to = b < pe_ ? b : pe_;
+            s7p_page(s, sp->loc, p, (unsigned)(from - ps), (unsigned)(to - from), sp->src ? sp->src + (from - a) : NULL, miss, held);
+        }
+    }
+}
+static inline uint64_t s7p_span_key(const rsx_s7p_draw_in* d)
+{
+    uint64_t k = 1469598103934665603ull;
+    for (unsigned i = 0; i < d->n_spans && i < RSX_S7P_SPANS; i++) {
+        k = (k ^ (((uint64_t)(d->sp[i].loc & 1u) << 32) | d->sp[i].off)) * 1099511628211ull; k = (k ^ d->sp[i].len) * 1099511628211ull;
+    }
+    return k | 1ull;
+}
+
+/* One draw that reached the copy (not dropped before it). Walker thread. */
+static inline void rsx_s7p_draw(rsx_s7p* s, const rsx_s7p_draw_in* d)
+{
+    rsx_s7p_lock(s);
+    s->acq_key_valid = 0;   /* the walker moved past any blocked acquire */
+    if (!s->have_ep) { s->cur_ep = d->ep; s->have_ep = 1; s->ep_n = 0; }
+    else if (d->ep != s->cur_ep) {   /* flip fold: new epoch tables, any hold ends */
+        s7p_hold_close(s, d->now); s->cur_ep = d->ep; s->ep_n = 0;
+    }
+    rsx_s7p_ctr* c = &s->c;
+    c->draws++; c->t[RSX_S7P_T_RING] += d->t_ring; c->t[RSX_S7P_T_IDX] += d->t_idx;
+    const int loc0 = d->n_spans ? (int)(d->sp[0].loc & 1u) : 0;
+    const int miss = !d->vc_hit;
+    uint64_t span_B = 0; for (unsigned i = 0; i < d->n_spans && i < RSX_S7P_SPANS; i++) span_B += d->sp[i].len;
+    if (miss) {
+        c->fills++; c->refs += (long long)d->refs; c->refs_B += (long long)d->refs * 8; c->fills_loc[loc0]++;
+        c->vb_B += (long long)d->vb_B; c->ib_B += (long long)d->ib_B; c->payload_B += (long long)d->payload_B; c->span_B += (long long)span_B;
+        c->size_hist[rsx_s7p_bin(d->vb_B + d->ib_B)]++; c->refs_hist[rsx_s7p_bin(d->refs)]++; c->miss_n++;
+        if (d->nospan) c->inline_nostable++;
+        if (d->vg_reason >= 0 && d->vg_reason < RSX_S7P_NVG) c->vg[d->vg_reason]++;
+        if (loc0 == 1 && d->n_spans && s->rf) {
+            const uint64_t key = s7p_span_key(d);
+            unsigned h = (unsigned)((key * 0x9E3779B97F4A7C15ull) >> 40) & (RSX_S7P_RF_TAB - 1u); int done = 0;
+            for (unsigned k = 0; k < RSX_S7P_RF_TAB && !done; k++, h = (h + 1u) & (RSX_S7P_RF_TAB - 1u)) {
+                if (s->rf[h] == key) { c->refill_main++; done = 1; }
+                else if (!s->rf[h]) { if (s->rf_n < RSX_S7P_RF_TAB / 4u * 3u) { s->rf[h] = key; s->rf_n++; } else c->ovf++; done = 1; }
+            }
+        }
+        const long long mv = d->t_fetch + d->t_ring + d->t_idx;
+        for (int i = 0; i < RSX_S7P_NTR; i++) { s->tr[i].n++; s->tr[i].m += mv; s->tr[i].last = mv; }
+    } else { c->hits++; c->hits_loc[loc0]++; }
+    int held = 0;
+    if (s->held_open) {
+#if !(defined(RSX_S7P_TEST_FAULT) && RSX_S7P_TEST_FAULT == 7)
+        if (d->held_eq) s7p_hold_close(s, d->now);   /* fault 7: never closes on an equal label */
+#endif
+        if (s->held_open) { held = 1; c->held_draws++; }
+    }
+    s7p_spans(s, d, miss, held);
+    rsx_s7p_unlock(s);
+}
+/* A draw dropped for a late fetch failure (fetch_ok = 0). */
+static inline void rsx_s7p_late_fail(rsx_s7p* s) { rsx_s7p_lock(s); s->c.inline_late++; rsx_s7p_unlock(s); }
+
+/* ---- formatters (pure; return the snprintf length, never write past n) ---- */
+#define S7P_CAT(...) do { if (o > 0 && (size_t)o < n) o += snprintf(out + o, n - (size_t)o, __VA_ARGS__); } while (0)
+#define D7(x) ((double)(c->x - p->x))
+static inline int rsx_s7p_fmt_fill(char* out, size_t n, double t, double tk, long long flips, double bucket_ms,
+                                   double s7_ms, const rsx_s7p_ctr* c, const rsx_s7p_ctr* p, double uc, double uh)
+{
+    const double f = flips > 0 ? (double)flips : 1.0;
+    double m[RSX_S7P_NT]; for (int i = 0; i < RSX_S7P_NT; i++) m[i] = (double)(c->t[i] - p->t[i]) * tk / f;
+    const double mov = m[RSX_S7P_T_FETCH] + m[RSX_S7P_T_RING] + m[RSX_S7P_T_IDX], stay = m[RSX_S7P_T_PLAN] + m[RSX_S7P_T_VCB] + m[RSX_S7P_T_PCB];
+    const double sum = mov + stay;
+    const double err = bucket_ms > 0.0 ? 100.0 * (sum > bucket_ms ? sum - bucket_ms : bucket_ms - sum) / bucket_ms : -1.0;
+    const double probe = (D7(clocks) * uc + D7(hashed) * uh) * tk / f;
+    int o = snprintf(out, n, "[s7-fill] t=%.0f flips=%lld | plan_ms=%.2f fetch_ms=%.2f ring_ms=%.2f idx_ms=%.2f vcb_ms=%.2f pcb_ms=%.2f",
+                     t, flips, m[0], m[1], m[2], m[3], m[4], m[5]);
+    S7P_CAT(" | movable_ms=%.2f stay_ms=%.2f split_sum_ms=%.2f bucket_ms=%.2f sum_err_pct=%.1f", mov, stay, sum, bucket_ms, err);
+    S7P_CAT(" | draws=%.1f fills=%.1f hits=%.1f refs=%.1f refs_B=%.0f probe_ms=%.2f", D7(draws) / f, D7(fills) / f, D7(hits) / f,
+            D7(refs) / f, D7(refs_B) / f, probe);
+#if defined(RSX_S7P_TEST_FAULT) && RSX_S7P_TEST_FAULT == 11
+    (void)s7_ms; S7P_CAT(" s7draw_ms=%.2f", bucket_ms);   /* fault 11: prints the wrong value */
+#else
+    S7P_CAT(" s7draw_ms=%.2f", s7_ms);   /* the ld_s7_draw hook's own time (split bucket X_S7, RSX_PERF_SPLIT=1; 0 without it): outside FILL, in `other` of [perf-split] */
+#endif
+    return o;
+}
+static inline int rsx_s7p_fmt_bar(char* out, size_t n, double t, double tk, long long flips, const rsx_s7p_ctr* c, const rsx_s7p_ctr* p)
+{
+    const double f = flips > 0 ? (double)flips : 1.0, ch = D7(chunks);
+    int o = snprintf(out, n, "[s7-bar] t=%.0f flips=%lld chunks=%.1f ring_resets=%.1f", t, flips, ch / f, D7(ring_resets) / f);
+    static const char* nm[RSX_S7P_NTR] = { "chunk", "narrow", "all" };
+    for (int i = 0; i < RSX_S7P_NTR; i++) {
+        const rsx_s7p_trc* a = &c->tr[i]; const rsx_s7p_trc* b = &p->tr[i];
+        S7P_CAT(" | %s: joins=%.1f idle=%.1f per_chunk=%.2f p50=%lld p95=%lld ovl_ms=%.2f", nm[i], (double)(a->joins - b->joins) / f,
+                (double)(a->idle - b->idle) / f, ch > 0 ? (double)(a->joins - b->joins) / ch : 0.0, rsx_s7p_pct(a->hist, b->hist, 50),
+                rsx_s7p_pct(a->hist, b->hist, 95), (double)(a->ovl - b->ovl) * tk / f);
+        if (i == RSX_S7P_TR_NARROW) S7P_CAT(" reuse=%.1f disjoint=%.1f", D7(reuse_barriers) / f, D7(disjoint_barriers) / f);
+    }
+    S7P_CAT(" | get_only_cuts=%.1f | by_kind:", D7(get_only_cuts) / f);
+    for (int k = 0; k < RSX_S7P_NKIND; k++) S7P_CAT(" %s=%.1f", rsx_s7p_kind_name[k], (double)(c->by_kind[k] - p->by_kind[k]) / f);
+    return o;
+}
+typedef struct { long long dev_fills, dev_fill_B, dyn_skip, inval_dyn, inel_main_verts, src_snap_B, dev_frees; } rsx_s7p_ext;   /* cumulative, from LD */
+static inline int rsx_s7p_fmt_draw(char* out, size_t n, double t, long long flips, const rsx_s7p_ctr* c, const rsx_s7p_ctr* p,
+                                   const rsx_s7p_ext* e, const rsx_s7p_ext* pe)
+{
+    const double f = flips > 0 ? (double)flips : 1.0;
+    int o = snprintf(out, n, "[s7-draw] t=%.0f flips=%lld | fills_loc0=%.1f fills_loc1=%.1f hits_loc0=%.1f hits_loc1=%.1f", t, flips,
+                     (double)(c->fills_loc[0] - p->fills_loc[0]) / f, (double)(c->fills_loc[1] - p->fills_loc[1]) / f,
+                     (double)(c->hits_loc[0] - p->hits_loc[0]) / f, (double)(c->hits_loc[1] - p->hits_loc[1]) / f);
+    S7P_CAT(" | inline_nostable=%.1f inline_late=%.1f", D7(inline_nostable) / f, D7(inline_late) / f);
+    /* print order: ok divided unmapped type big noinput */
+    S7P_CAT(" | vg_ok=%.1f vg_divided=%.1f vg_unmapped=%.1f vg_type=%.1f vg_big=%.1f vg_noinput=%.1f", (double)(c->vg[0] - p->vg[0]) / f,
+            (double)(c->vg[2] - p->vg[2]) / f, (double)(c->vg[3] - p->vg[3]) / f, (double)(c->vg[4] - p->vg[4]) / f,
+            (double)(c->vg[5] - p->vg[5]) / f, (double)(c->vg[1] - p->vg[1]) / f);
+    S7P_CAT(" | vb_B=%.0f ib_B=%.0f payload_B=%.0f span_B=%.0f size_p50=%lld size_p95=%lld refs_p50=%lld refs_p95=%lld", D7(vb_B) / f,
+            D7(ib_B) / f, D7(payload_B) / f, D7(span_B) / f, rsx_s7p_pct(c->size_hist, p->size_hist, 50), rsx_s7p_pct(c->size_hist, p->size_hist, 95),
+            rsx_s7p_pct(c->refs_hist, p->refs_hist, 50), rsx_s7p_pct(c->refs_hist, p->refs_hist, 95));
+    S7P_CAT(" | dev_fills=%.1f dev_fill_B=%.0f refill_main=%.1f dyn_skip=%.1f inval_dyn=%.1f inel_main_verts=%.0f src_snap_B=%.0f dev_frees=%.1f",
+            (double)(e->dev_fills - pe->dev_fills) / f, (double)(e->dev_fill_B - pe->dev_fill_B) / f, D7(refill_main) / f,
+            (double)(e->dyn_skip - pe->dyn_skip) / f, (double)(e->inval_dyn - pe->inval_dyn) / f,
+            (double)(e->inel_main_verts - pe->inel_main_verts) / f, (double)(e->src_snap_B - pe->src_snap_B) / f,
+            (double)(e->dev_frees - pe->dev_frees) / f);
+    return o;
+}
+static inline int rsx_s7p_fmt_page(char* out, size_t n, double t, double tk, long long flips, int samp, const rsx_s7p_ctr* c,
+                                   const rsx_s7p_ctr* p, const rsx_s7p_ext* e, const rsx_s7p_ext* pe)
+{
+    const double f = flips > 0 ? (double)flips : 1.0;
+    const double ch = D7(changed), nw = D7(newp), sm = D7(same);
+    const double churn = ch + sm > 0 ? 100.0 * ch / (ch + sm) : 0.0;
+    const double copyB = (double)rsx_s7p_est((long long)(ch + nw), samp) * 4096.0 / f;
+    const double ringB = ((double)(c->vb_B - p->vb_B) + (double)(c->ib_B - p->ib_B) + (double)(e->dev_fill_B - pe->dev_fill_B)) / f;
+    int o = snprintf(out, n, "[s7-page] t=%.0f flips=%lld samp=%d | read_loc0=%.1f read_loc1=%.1f hashed=%.1f same=%.1f changed=%.1f new=%.1f shape=%.1f hit_nohash=%.1f",
+                     t, flips, samp, (double)(c->read_loc[0] - p->read_loc[0]) / f, (double)(c->read_loc[1] - p->read_loc[1]) / f, D7(hashed) / f, sm / f,
+                     ch / f, nw / f, D7(shape) / f, D7(hit_nohash) / f);
+    S7P_CAT(" | churn_pct=%.1f copy_B_est=%.0f ring_B=%.0f page_vs_ring=%.3f", churn, copyB, ringB, ringB > 0 ? copyB / ringB : 0.0);
+    S7P_CAT(" | acq_met=%.1f acq_unmet=%.1f held_draws=%.1f held_pages=%.1f held_ms=%.2f", D7(acq_met) / f, D7(acq_unmet) / f,
+            D7(held_draws) / f, D7(held_pages) / f, D7(held_ticks) * tk / f);
+    S7P_CAT(" | ovf=%.0f", D7(ovf));
+    return o;
+}
+#undef D7
