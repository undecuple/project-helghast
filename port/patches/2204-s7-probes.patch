+static inline int rsx_s7p_kind_class(int kind) { return kind < 0 ? RSX_S7P_CLS_NONE : kind >= 13 && kind <= 15 ? RSX_S7P_CLS_GET : RSX_S7P_CLS_GATE; }
+
