+/* ---- write-watch microprobe aggregation (the platform part supplies the ops) ---- */
+typedef struct {
+    double (*now_us)(void*);
+    void (*store_plain)(void*, unsigned page);
+    void (*store_watched)(void*, unsigned page);
+    void (*reset)(void*);
+    unsigned (*query)(void*);
+} rsx_s7p_ww_ops;
+typedef struct { double base_us_page, first_us_page, again_us_page, arm_us, query_us; unsigned reported; } rsx_s7p_ww_res;
+/* rounds of: plain stores to the dirty pages, arm (reset), first stores, again stores, query. Dirty pages = the first
+ * `frac` percent. Means over the rounds, per dirty page for the store timings. */
+static inline void rsx_s7p_ww_run(const rsx_s7p_ww_ops* ops, void* ctx, unsigned pages, unsigned rounds, unsigned frac, rsx_s7p_ww_res* r)
+{
+    memset(r, 0, sizeof *r);
+    const unsigned dirty = (unsigned)(((unsigned long long)pages * frac) / 100u);
+    if (!rounds || !dirty) return;
+    double base = 0, first = 0, again = 0, arm = 0, qry = 0; unsigned rep = 0;
+    for (unsigned k = 0; k < rounds; k++) {
+        double a = ops->now_us(ctx); for (unsigned i = 0; i < dirty; i++) ops->store_plain(ctx, i); double b = ops->now_us(ctx); base += b - a;
+        a = ops->now_us(ctx); ops->reset(ctx); b = ops->now_us(ctx); arm += b - a;
+        a = ops->now_us(ctx); for (unsigned i = 0; i < dirty; i++) ops->store_watched(ctx, i); b = ops->now_us(ctx); first += b - a;
+        a = ops->now_us(ctx); for (unsigned i = 0; i < dirty; i++) ops->store_watched(ctx, i); b = ops->now_us(ctx); again += b - a;
+        a = ops->now_us(ctx); rep = ops->query(ctx); b = ops->now_us(ctx); qry += b - a;
+    }
+    r->base_us_page = base / rounds / dirty; r->first_us_page = first / rounds / dirty; r->again_us_page = again / rounds / dirty;
+    r->arm_us = arm / rounds; r->query_us = qry / rounds; r->reported = rep;
+}
+static inline int rsx_s7p_fmt_ww(char* out, size_t n, unsigned pages, unsigned rounds, unsigned f1, const rsx_s7p_ww_res* a, unsigned f2,
+                                 const rsx_s7p_ww_res* b, double changed_pages_per_flip)
+{
+    int o = snprintf(out, n, "[s7-ww] pages=%u rounds=%u frac=%u base_us_page=%.4f watch_first_us_page=%.4f watch_again_us_page=%.4f arm_us=%.2f query_us=%.2f reported=%u",
+                     pages, rounds, f1, a->base_us_page, a->first_us_page, a->again_us_page, a->arm_us, a->query_us, a->reported);
+    S7P_CAT(" | frac=%u base_us_page=%.4f watch_first_us_page=%.4f watch_again_us_page=%.4f arm_us=%.2f query_us=%.2f reported=%u", f2,
+            b->base_us_page, b->first_us_page, b->again_us_page, b->arm_us, b->query_us, b->reported);
+    S7P_CAT(" | cost_ms_flip_est=%.3f", a->first_us_page * changed_pages_per_flip / 1000.0);
+    return o;
+}
