+typedef struct {
+    rsx_wbd_ent q[RSX_WBD_CAP];
+    uint32_t n;                       /* pending entries */
+    uint32_t taken;                   /* bit per readback slot: taken for a record or held by a pending entry */
+    uint64_t seq;
+    uint64_t pending_max, drains, waits, wait_ns, stores, aborted, pushes;
+    uint64_t forced[RSX_WBD_R_N];
+    rsx_wbd_ver ver;
+} rsx_wbd;
+
+static inline void rsx_wbd_init(rsx_wbd* d) { memset(d, 0, sizeof *d); }
+
+/* ---- readback slots ---- */
+static inline uint32_t rsx_wbd_free_slots(const rsx_wbd* d)
+{
+    uint32_t f = 0;
+    for (uint32_t i = 0; i < RSX_WBD_SLOTS; i++) if (!(d->taken & (1u << i))) f++;
+    return f;
+}
+/* Does a record of `need` slots have to drain first? (A slot is not reusable before its store ran.) */
+static inline int rsx_wbd_need_drain_for_slots(const rsx_wbd* d, uint32_t need)
+{
+    return rsx_wbd_free_slots(d) < need;
+}
+static inline int rsx_wbd_slot_take(rsx_wbd* d)
+{
+    for (uint32_t i = 0; i < RSX_WBD_SLOTS; i++)
+        if (!(d->taken & (1u << i))) { d->taken |= 1u << i; return (int)i; }
+    return -1;
+}
+static inline void rsx_wbd_slot_put(rsx_wbd* d, int s)
+{
+    if (s >= 0 && (uint32_t)s < RSX_WBD_SLOTS) d->taken &= ~(1u << (uint32_t)s);
+}
+
+/* ---- queue ---- */
+/* 0 = queue full (the caller drains with RSX_WBD_R_FULL and pushes again). */
+static inline int rsx_wbd_push(rsx_wbd* d, const rsx_wbd_ent* e)
+{
+    if (d->n >= RSX_WBD_CAP) return 0;
+    rsx_wbd_ent* q = &d->q[d->n++];
+    *q = *e;
+    q->seq = ++d->seq;
+    if (q->slot >= 0) d->taken |= 1u << (uint32_t)q->slot;
+    d->pushes++;
+    if (d->n > d->pending_max) d->pending_max = d->n;
+    return 1;
+}
+static inline int rsx_wbd_ranges_hit(uint32_t aloc, uint32_t a0, uint32_t asz, uint32_t bloc, uint32_t b0, uint32_t bsz)
+{
+    if (aloc != bloc) return 0;
+    const uint64_t a1 = (uint64_t)a0 + (asz ? asz : 1u), b1 = (uint64_t)b0 + (bsz ? bsz : 1u);
+    return a0 < b1 && b0 < a1;
+}
+/* Does any pending entry write or read [off, off+size) of `loc`? */
+static inline int rsx_wbd_overlap(const rsx_wbd* d, uint32_t loc, uint32_t off, uint32_t size)
+{
+    for (uint32_t i = 0; i < d->n; i++) {
+        const rsx_wbd_ent* e = &d->q[i];
+        if (rsx_wbd_ranges_hit(e->wloc, e->woff, e->wsize, loc, off, size)) return 1;
+        if (e->rsize && rsx_wbd_ranges_hit(e->rloc, e->roff, e->rsize, loc, off, size)) return 1;
+    }
+    return 0;
+}
+
+/* wait(ctx, fence, &blocked_ns): 0 = failed (device lost), 1 = already complete, 2 = blocked (blocked_ns = time waited).
+ * store(ctx, entry): the guest store of one entry; the slot is freed after it returns. */
+typedef int (*rsx_wbd_wait_fn)(void* ctx, uint64_t fence, uint64_t* blocked_ns);
+typedef void (*rsx_wbd_store_fn)(void* ctx, rsx_wbd_ent* e);
+
+/* Wait the newest pending fence once, then run every store oldest-first. The queue is emptied before the first store
+ * (a hook reached from a store sees nothing pending), so a second drain does nothing. Returns the stores run. */
+static inline uint32_t rsx_wbd_drain(rsx_wbd* d, int reason, rsx_wbd_wait_fn wait, rsx_wbd_store_fn store, void* ctx)
+{
+    const uint32_t n = d->n;
+    if (!n) return 0;
+    rsx_wbd_ent local[RSX_WBD_CAP];
+    memcpy(local, d->q, (size_t)n * sizeof local[0]);
+    d->n = 0;
+    d->drains++;
+    if (reason >= 0 && reason < RSX_WBD_R_N) d->forced[reason]++;
+    uint64_t fence = 0;
+    for (uint32_t i = 0; i < n; i++) if (local[i].fence > fence) fence = local[i].fence;
+    if (fence) {
+        uint64_t blocked = 0;
+        const int rc = wait(ctx, fence, &blocked);
+        if (rc == 2) { d->waits++; d->wait_ns += blocked; }
+        if (!rc) {   /* the GPU is gone: nothing can be stored, release the slots */
+            d->aborted += n;
+            for (uint32_t i = 0; i < n; i++) rsx_wbd_slot_put(d, local[i].slot);
+            return 0;
+        }
+    }
+    /*ORDER*/ for (uint32_t i = 0; i < n; i++) {
+        store(ctx, &local[i]);
+        d->stores++;
+        rsx_wbd_slot_put(d, local[i].slot);
+    }
+    return n;
+}
+/* A reader of [off, off+size) of `loc` is about to look at guest bytes: drain when a pending store covers them. */
+static inline uint32_t rsx_wbd_touch(rsx_wbd* d, uint32_t loc, uint32_t off, uint32_t size, int reason,
+                                     rsx_wbd_wait_fn wait, rsx_wbd_store_fn store, void* ctx)
+{
+    if (!d->n || !rsx_wbd_overlap(d, loc, off, size)) return 0;
+    return rsx_wbd_drain(d, reason, wait, store, ctx);
+}
+
+/* ---- verify mode ---- */
+/* Compare the deferred bytes `a` with the synchronous shadow `b`; tag = surface offset for the log. Returns the number of
+ * differing bytes (0 = equal); counts one mismatch per call that differs and remembers the first (tag, offset) pairs. */
+static inline uint32_t rsx_wbd_cmp(rsx_wbd_ver* v, uint32_t tag, const uint8_t* a, const uint8_t* b, uint32_t n)
+{
+    uint32_t bad = 0, first = 0;
+    v->compared++;
+    /*CMP*/ for (uint32_t i = 0; i < n; i++)
+        if (a[i] != b[i]) { if (!bad) first = i; bad++; }
+    if (bad) {
+        v->mismatches++; v->bytes_bad += bad;
+        if (v->nfirst < RSX_WBD_FIRST) { v->first[v->nfirst].tag = tag; v->first[v->nfirst].off = first; v->nfirst++; }
+    }
+    return bad;
+}
+
+/* The [wb-defer] summary line. */
+static inline int rsx_wbd_fmt(const rsx_wbd* d, uint32_t frame, char* out, size_t cap)
+{
+    int w = snprintf(out, cap, "[wb-defer] f=%u pending_max=%llu pushes=%llu drains=%llu waits=%llu wait_ms=%.3f stores=%llu "
+                     "aborted=%llu forced:", frame, (unsigned long long)d->pending_max, (unsigned long long)d->pushes,
+                     (unsigned long long)d->drains, (unsigned long long)d->waits, (double)d->wait_ns / 1e6,
+                     (unsigned long long)d->stores, (unsigned long long)d->aborted);
+    for (int r = 0; r < RSX_WBD_R_N && w > 0 && (size_t)w < cap; r++)
+        w += snprintf(out + w, cap - (size_t)w, " %s=%llu", rsx_wbd_reason_name[r], (unsigned long long)d->forced[r]);
+    if (w > 0 && (size_t)w < cap)
+        w += snprintf(out + w, cap - (size_t)w, " verified=%llu mismatches=%llu bytes_bad=%llu",
+                      (unsigned long long)d->ver.compared, (unsigned long long)d->ver.mismatches,
+                      (unsigned long long)d->ver.bytes_bad);
+    return w;
+}
+
+/* ---- published ranges (any thread may read, racily, for the diagnostic "an SPU wrote into a pending range") ----
+ * Relaxed atomics so the race is a defined one (TSan-clean): a reader may see a half-updated set, never a torn value. */
+#define RSX_WBD_SNAP 16u
+typedef struct { uint32_t n; uint32_t loc[RSX_WBD_SNAP], off[RSX_WBD_SNAP], size[RSX_WBD_SNAP]; } rsx_wbd_snap;
+#define RSX_WBD_LD(p) __atomic_load_n((p), __ATOMIC_RELAXED)
+#define RSX_WBD_ST(p, v) __atomic_store_n((p), (v), __ATOMIC_RELAXED)
+static inline void rsx_wbd_snap_publish(rsx_wbd_snap* s, const rsx_wbd* d)
+{
+    uint32_t m = 0;
+    RSX_WBD_ST(&s->n, 0u);
+    for (uint32_t i = 0; i < d->n && m < RSX_WBD_SNAP; i++) {
+        RSX_WBD_ST(&s->loc[m], d->q[i].wloc); RSX_WBD_ST(&s->off[m], d->q[i].woff); RSX_WBD_ST(&s->size[m], d->q[i].wsize); m++;
+    }
+    RSX_WBD_ST(&s->n, m);
+}
+static inline int rsx_wbd_snap_hit(const rsx_wbd_snap* s, uint32_t loc, uint32_t off, uint32_t size)
+{
+    const uint32_t n = RSX_WBD_LD(&s->n);
+    for (uint32_t i = 0; i < n && i < RSX_WBD_SNAP; i++)
+        if (rsx_wbd_ranges_hit(RSX_WBD_LD(&s->loc[i]), RSX_WBD_LD(&s->off[i]), RSX_WBD_LD(&s->size[i]), loc, off, size)) return 1;
+    return 0;
+}
+#endif
