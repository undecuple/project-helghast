+/* One chunk of recorded copies (rec[k] into slots[k]): submit without a wait, queue one entry per surface. */
+static u32 ld_wbd_chunk(const u32* rec, const int* slots, u32 nrec, u32 for_off, u32 for_size)
+{
+    ld_oq_close();   /* as ld_flush does: a query ends in the list it began in */
+    g_ld_unsubmitted = 1;
+    const u64 f0 = g.fence_value;
+    ld_submit_nowait();
+    if (!g.ready) return 0;
+    if (g.fence_value == f0) {   /* nothing was submitted: this chunk keeps today's synchronous store, after the older pending ones */
+        ld_wbd_drain(RSX_WBD_R_NOSUBMIT);
+        ld_flush(LD_FLUSH_READBACK); g_ld_wb.waits++;
+        u32 d = 0;
+        if (g.ready)
+            for (u32 k = 0; k < nrec; k++)
+                d += (u32)ld_rb_store(rec[k], (u32)slots[k], for_off ? for_off : g.surfaces[rec[k]].offset, for_size);
+        for (u32 k = 0; k < nrec; k++) rsx_wbd_slot_put(&g_wbd, slots[k]);
+        return d;
+    }
+    const u64 fence = g.fence_value;
+    if (g_wbd_mode == 2 && !ld_wait_fence(fence)) return 0;   /* verify: the readback is read at the original point too */
+    for (u32 k = 0; k < nrec; k++) {
+        surface_t* sf = &g.surfaces[rec[k]];
+        const u32 texel = sf->fmt == DXGI_FORMAT_R16G16B16A16_FLOAT ? 8u : 4u;
+        const u32 gp = sf->pitch ? sf->pitch : sf->w * texel;
+        rsx_wbd_ent e; memset(&e, 0, sizeof e);
+        e.kind = RSX_WBD_SURF; e.slot = slots[k]; e.fence = fence;
+        e.wloc = sf->location; e.woff = sf->offset; e.wsize = gp * (sf->h - 1u) + sf->w * texel;
+        e.p[0] = rec[k]; e.p[1] = sf->w; e.p[2] = sf->h; e.p[3] = (u32)sf->fmt; e.p[4] = gp;
+        e.p[7] = sf->last_write_generation;
+        e.p[8] = (u32)((u64)(uintptr_t)sf->tex & 0xFFFFFFFFu); e.p[9] = (u32)((u64)(uintptr_t)sf->tex >> 32);
+        e.p[10] = (u32)slots[k];
+        if (g_wbd_mode == 2) {
+            u8* sh = (u8*)malloc((size_t)sf->w * texel * sf->h);
+            if (sh && !ld_wbd_conv((u32)slots[k], sf->w, sf->h, (u32)sf->fmt, sh, sf->w * texel)) { free(sh); sh = NULL; }
+            e.user = sh;
+        }
+        sf->gv_gpu_dirty = 0;   /* as the synchronous store clears it; a draw after this submit sets it again */
+        ld_wbd_push(&e);
+    }
+    return nrec;
+}
