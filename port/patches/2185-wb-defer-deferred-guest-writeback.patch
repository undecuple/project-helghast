+    if (!g.ready) return 0;
+    const int block = g.fence->lpVtbl->GetCompletedValue(g.fence) < fence;
+    LARGE_INTEGER a, b, f;
+    QueryPerformanceCounter(&a);
+    if (!ld_wait_fence(fence)) return 0;
+    if (!block) return 1;
+    QueryPerformanceCounter(&b); QueryPerformanceFrequency(&f);
+    *blocked_ns = (u64)((double)(b.QuadPart - a.QuadPart) * 1e9 / (double)f.QuadPart);
+    if (!*blocked_ns) *blocked_ns = 1;
+    return 2;
+}
