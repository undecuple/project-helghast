+    e.rloc = sloc; e.roff = soff; e.rsize = ssize;
+    memcpy(e.p, p, 8 * sizeof p[0]);
+    g_wbd_move_fn = fn;
+    ld_wbd_push(&e);
+    return 1;
+}
