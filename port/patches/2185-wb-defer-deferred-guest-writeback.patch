+/* KZ3 patch 2185 (RSX pass 163): the pending-store queue of the deferred guest write-back (LD_WB_DEFER=1, default off).
+ *
+ * Today the walker waits for the GPU at each store point (the idx0 scene copy, the 0x4A release's main surfaces) and
+ * converts the readback buffer into guest memory at once. Deferred, the copy goes into a readback slot and is submitted
+ * without a wait; one entry per store stays here until ONE drain waits the newest fence and runs every guest store
+ * oldest-first. This header is the GPU-free bookkeeping: slots, order, forced drains, overlap queries, statistics and
+ * the byte compare of the verify mode (LD_WB_DEFER_VERIFY=1). Host test: tools/smoke/test_wb_defer.sh.
+ * Thread model: every call comes from the walker thread (stores use walker state); the queue has no lock. The only
+ * cross-thread data is the published range snapshot (rsx_wbd_snap), diagnostic and read racily on purpose. */
+#ifndef RSX_WB_DEFER_H
+#define RSX_WB_DEFER_H
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define RSX_PATCH_2185 1
+#define RSX_WBD_SLOTS 16u
+#define RSX_WBD_CAP 64u
+#define RSX_WBD_FIRST 8u
+
+enum { RSX_WBD_SURF = 1, RSX_WBD_MOVE = 2 };
+/* why a drain happened (the reason is counted; USERCMD is the one the design expects) */
+enum { RSX_WBD_R_USERCMD, RSX_WBD_R_FLIP, RSX_WBD_R_SLOT, RSX_WBD_R_FULL, RSX_WBD_R_TOUCH, RSX_WBD_R_NV0039,
+       RSX_WBD_R_NOSUBMIT, RSX_WBD_R_OTHER, RSX_WBD_R_N };
+static const char* const rsx_wbd_reason_name[RSX_WBD_R_N] = { "usercmd", "flip", "slot", "full", "touch", "nv0039",
+                                                                "nosubmit", "other" };
+
+typedef struct {
+    uint32_t kind;                    /* RSX_WBD_SURF or RSX_WBD_MOVE */
+    int32_t slot;                     /* readback slot held until the store ran, -1 = none */
+    uint64_t fence;                   /* GPU fence value that completes this entry's copy (0 = none) */
+    uint64_t seq;                     /* push order */
+    uint32_t wloc, woff, wsize;       /* guest bytes the store writes (footprint) */
+    uint32_t rloc, roff, rsize;       /* guest bytes the store reads at the drain (MOVE source), rsize 0 = none */
+    uint32_t p[12];                   /* caller payload (surface geometry, copy parameters) */
+    void* user;                       /* caller pointer (verify shadow) */
+} rsx_wbd_ent;
+
+typedef struct {
+    uint64_t compared, mismatches, bytes_bad;
+    uint32_t nfirst;
+    struct { uint32_t tag, off; } first[RSX_WBD_FIRST];   /* first mismatching (surface tag, byte offset) */
+} rsx_wbd_ver;
