+static u32 ld_wbd_drain(int reason)
+{
+    if (!g_wbd.n) return 0;
+    LDW_T0(st_t0);
+    const u32 r = rsx_wbd_drain(&g_wbd, reason, ld_wbd_wait, ld_wbd_store, NULL);
+    rsx_wbd_snap_publish(&g_wbd_snap, &g_wbd);
+    LDW_ADD(RSX_PERF_W_WB_STORE_T, st_t0);
+    return r;
+}
+
+static void ld_wbd_touch(u32 location, u32 offset, u32 size, int reason)
+{
+    if (g_wbd_owner != GetCurrentThreadId()) return;
+    if (rsx_wbd_touch(&g_wbd, location, offset, size, reason, ld_wbd_wait, ld_wbd_store, NULL))
+        rsx_wbd_snap_publish(&g_wbd_snap, &g_wbd);
+}
+
+static void ld_wbd_push(const rsx_wbd_ent* e)
+{
+    if (!rsx_wbd_push(&g_wbd, e)) { ld_wbd_drain(RSX_WBD_R_FULL); rsx_wbd_push(&g_wbd, e); }
+    g_wbd_owner = GetCurrentThreadId();
+    rsx_wbd_snap_publish(&g_wbd_snap, &g_wbd);
+}
