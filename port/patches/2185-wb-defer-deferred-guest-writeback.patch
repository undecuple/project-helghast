+/* Readback slot -> guest layout rows (the conversion of ld_rb_store, into any destination). 0 = the slot could not be mapped. */
+static int ld_wbd_conv(u32 slot, u32 w, u32 h, u32 fmt, u8* dst, u32 dpitch)
+{
+    const u32 texel = fmt == (u32)DXGI_FORMAT_R16G16B16A16_FLOAT ? 8u : 4u;
+    const u32 pitch = (w * texel + 255u) & ~255u;
+    u8* px = NULL; D3D12_RANGE rr = {0, (SIZE_T)pitch * h};
+    if (slot >= LD_RB_SLOTS || !g_ld_rb[slot] || FAILED(g_ld_rb[slot]->lpVtbl->Map(g_ld_rb[slot], 0, &rr, (void**)&px))) return 0;
+    for (u32 y = 0; y < h; y++) {
+        const u8* sp = px + (size_t)y * pitch;
+        u8* dp = dst + (size_t)y * dpitch;
+        if (fmt == (u32)DXGI_FORMAT_R8G8B8A8_UNORM) {
+            for (u32 x = 0; x < w; x++, sp += 4, dp += 4) { dp[0] = sp[3]; dp[1] = sp[0]; dp[2] = sp[1]; dp[3] = sp[2]; }
+        } else if (texel == 8) {
+            for (u32 x = 0; x < w * 4u; x++, sp += 2, dp += 2) { dp[0] = sp[1]; dp[1] = sp[0]; }
+        } else {
+            for (u32 x = 0; x < w; x++, sp += 4, dp += 4) { u32 v; memcpy(&v, sp, 4); v = __builtin_bswap32(v); memcpy(dp, &v, 4); }
+        }
+    }
+    D3D12_RANGE wr = {0, 0};
+    g_ld_rb[slot]->lpVtbl->Unmap(g_ld_rb[slot], 0, &wr);
+    return 1;
+}
+
+/* The deferred store of one surface (what ld_rb_store does at the original point). Geometry was frozen at the submit. */
+static void ld_wbd_store_surf(rsx_wbd_ent* e)
+{
+    const u32 i = e->p[0], w = e->p[1], h = e->p[2], fmt = e->p[3], gp = e->p[4];
+    const u32 texel = fmt == (u32)DXGI_FORMAT_R16G16B16A16_FLOAT ? 8u : 4u;
+    u8* gm = (u8*)guest_ptr(e->wloc, e->woff, e->wsize);
+    t_ld_ws = LD_WS_WB;
+    ld_td_mark(e->wloc, e->woff, e->wsize);   /* patch 2033: the walker writes guest bytes (now) */
+    t_ld_ws = 0;
+    int ok = 0;
+    u8* shadow = (u8*)e->user;
+    if (gm) {
+        if (shadow) {   /* verify: the deferred conversion against the one made at the original point */
+            u8* tmp = (u8*)malloc((size_t)w * texel * h);
+            if (tmp && ld_wbd_conv(e->p[10], w, h, fmt, tmp, w * texel))
+                rsx_wbd_cmp(&g_wbd.ver, e->woff, tmp, shadow, w * texel * h);
+            free(tmp);
+        }
+        ok = ld_wbd_conv(e->p[10], w, h, fmt, gm, gp);
+    }
+    free(shadow);
+    surface_t* sf = i < g.n_surfaces ? &g.surfaces[i] : NULL;
+    const u64 tex = (u64)e->p[8] | ((u64)e->p[9] << 32);
+    if (ok && sf && (u64)(uintptr_t)sf->tex == tex && sf->location == e->wloc && sf->offset == e->woff && sf->w == w &&
+        sf->h == h && (u32)sf->fmt == fmt && (sf->pitch ? sf->pitch : sf->w * texel) == gp) {
+        ld_pwd_note_writeback(i);
+        ld_wbp_store(sf);
+        if (ld_gv_enabled()) {
+            ld_gv_baseline(sf);   /* guest bytes == the frozen GPU image now */
+            if (sf->last_write_generation != e->p[7]) sf->gv_pending = 1;   /* drawn again since the copy: the guest bytes are older */
+        }
+    }
+    static int logged;
+    if (logged++ < 8)
+        fprintf(stderr, "[surface-writeback] surface %u:0x%08X %ux%u fmt=%d pitch=%u (deferred, seq %llu)\n",
+                e->wloc, e->woff, w, h, (int)fmt, gp, (unsigned long long)e->seq);
+}
+
+/* The deferred NV0039 row copy (idx0: local 0x1300000 -> main 0x01310400), after the source surface's store. */
+static void ld_wbd_store_move(rsx_wbd_ent* e)
+{
+    const u32 bad = g_wbd_move_fn ? g_wbd_move_fn(e->p, g_wbd_mode == 2) : 0;
+    if (g_wbd_mode == 2) {
+        g_wbd.ver.compared++;
+        if (bad) {
+            g_wbd.ver.mismatches++; g_wbd.ver.bytes_bad += bad;
+            if (g_wbd.ver.nfirst < RSX_WBD_FIRST) { g_wbd.ver.first[g_wbd.ver.nfirst].tag = e->woff; g_wbd.ver.first[g_wbd.ver.nfirst].off = 0; g_wbd.ver.nfirst++; }
+        }
+    }
+    t_ld_ws = 3u;
+    ld_td_mark(e->wloc, e->woff, e->wsize);
+    rsx_live_draw_note_guest_write(e->wloc, e->woff, e->wsize);   /* the texture caches see the bytes that really landed */
+    t_ld_ws = 0;
+    if (e->wloc == 1u) rsx_live_draw_wbp_copy_done(e->woff, e->wsize);   /* patch 2184 probe: the idx0 store is done */
+}
+
+static void ld_wbd_store(void* ctx, rsx_wbd_ent* e)
+{
+    (void)ctx;
+    if (e->kind == RSX_WBD_SURF) ld_wbd_store_surf(e); else ld_wbd_store_move(e);
+}
