+/* FSR RCAS sharpness, stored as thousandths so parsing is locale-independent.
+ * The UI uses steps of 0.1; a hand-edited in-range decimal is rounded to that
+ * same step. */
+#define RSX_DM_FSR_SHARPNESS_STEP 100
+#define RSX_DM_FSR_SHARPNESS_DEFAULT 200
+static inline int rsx_dm_fsr_sharpness_round(int v)
+{
+    return v <= 0 ? 0 : v >= 1000 ? 1000 :
+        ((v + RSX_DM_FSR_SHARPNESS_STEP / 2) /
+         RSX_DM_FSR_SHARPNESS_STEP) * RSX_DM_FSR_SHARPNESS_STEP;
+}
+static inline int rsx_dm_parse_fsr_sharpness(const char* s)
+{
+    size_t n;
+    if (!rsx_dm_trim(&s, &n) || (s[0] != '0' && s[0] != '1')) return -1;
+    const int whole = s[0] - '0';
+    if (n == 1) return whole * 1000;
+    if (s[1] != '.' || n == 2 || n > 8) return -1;
+    int fraction = 0, scale = 1;
+    for (size_t i = 2; i < n; i++) {
+        if (s[i] < '0' || s[i] > '9') return -1;
+        fraction = fraction * 10 + (s[i] - '0');
+        scale *= 10;
+    }
+    if (whole && fraction) return -1;
+    const int thousandths = whole ? 1000 :
+        (fraction * 1000 + scale / 2) / scale;
+    return rsx_dm_fsr_sharpness_round(thousandths);
+}
+static inline const char* rsx_dm_fsr_sharpness_name(
+    int thousandths, char* buf, size_t n)
+{
+    const int v = rsx_dm_fsr_sharpness_round(thousandths);
+    snprintf(buf, n, "%d.%d", v / 1000, (v % 1000) / 100);
+    return buf;
+}
+static inline int rsx_dm_ini_fsr_sharpness(const char* t)
+{
+    char v[32];
+    return rsx_dm_ini_value(t, "fsr_sharpness", v, sizeof v) ?
+        rsx_dm_parse_fsr_sharpness(v) : -1;
+}
