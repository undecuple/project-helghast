+                           "# KZ3_BLOOM and KZ3_MOTION_BLUR (on | off | 0..100) override the two for one run.\n"
+                           "bloom = %d\n", rsx_dm_pct_round(bloom));
+    return k < 0 ? k : o + k;
+}
