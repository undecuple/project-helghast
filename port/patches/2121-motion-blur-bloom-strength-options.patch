+/* KZ3 patch 2121 (RSX pass 114): Motion blur and Bloom are strengths, 0..100 percent in steps of 10 (0 = off, 100 = the
+ * game's own look, the default). display.ini: motion_blur = 0..100 (an old file's on = 100 and off = 0 still read),
+ * bloom = 0..100. A hand-edited number is clamped to 0..100 and rounded to the nearest step (55 -> 60), a trailing %
+ * is allowed; anything else is unreadable (-1) and the key is ignored. */
+#define RSX_DM_PCT_STEP 10
+static inline int rsx_dm_pct_round(int v)
+{
+    return v <= 0 ? 0 : v >= 100 ? 100 : ((v + RSX_DM_PCT_STEP / 2) / RSX_DM_PCT_STEP) * RSX_DM_PCT_STEP;
+}
+static inline int rsx_dm_parse_pct(const char* s)   /* 0, 10 .. 100, -1 unreadable */
+{
+    size_t n;
+    if (!rsx_dm_trim(&s, &n)) return -1;
+    if (rsx_dm_ieq(s, n, "on") || rsx_dm_ieq(s, n, "true") || rsx_dm_ieq(s, n, "yes")) return 100;
+    if (rsx_dm_ieq(s, n, "off") || rsx_dm_ieq(s, n, "false") || rsx_dm_ieq(s, n, "no")) return 0;
+    if (n && s[n - 1] == '%') n--;
+    size_t i = 0;
+    int neg = 0;
+    long v = 0;
+    if (i < n && s[i] == '-') { neg = 1; i++; }
+    if (i >= n || n - i > 6) return -1;
+    for (; i < n; i++) {
+        if (s[i] < '0' || s[i] > '9') return -1;
+        v = v * 10 + (s[i] - '0');
+    }
+    return neg ? 0 : rsx_dm_pct_round(v > 1000 ? 1000 : (int)v);
+}
+/* A strength value scaled by a percentage (Bloom: the post parameter vp+0x230, main.cpp's BuildPost override): 100 and above
+ * leave it exactly as it is (the game's own value, bit for bit), 0 gives 0, in between v * pct / 100. */
+static inline float rsx_dm_pct_scale(float v, int pct)
+{
+    return pct >= 100 ? v : pct <= 0 ? 0.0f : v * ((float)pct / 100.0f);
+}
+static inline int rsx_dm_ini_motion_blur(const char* t)    /* 0..100 (steps of 10), -1 missing or unreadable */
+{
+    char v[32];
+    return rsx_dm_ini_value(t, "motion_blur", v, sizeof v) ? rsx_dm_parse_pct(v) : -1;
+}
+static inline int rsx_dm_ini_bloom(const char* t)          /* 0..100 (steps of 10), -1 missing or unreadable */
 {
     char v[32];
-    return rsx_dm_ini_value(t, "motion_blur", v, sizeof v) ? rsx_dm_parse_vsync(v) : -1;
+    return rsx_dm_ini_value(t, "bloom", v, sizeof v) ? rsx_dm_parse_pct(v) : -1;
 }
