+int kz3_spurs_dump_runs(const char* tag)
+{
+    int n = 0;
+    u64 now = GetTickCount64();
+    for (int j = 0; j < MAX_SPURS_INST; j++) {
+        if (!s_inst[j].ea) continue;
+        for (int kt = 0; kt < KZ3_KT_MAX; kt++) {
+            u64 t0 = s_run_t0[j][kt];
+            if (!t0) continue;
+            n++;
+            kz3_spurs_report_stuck_run(j, kt, s_run_wid[j][kt], kz3_spurs_elapsed_ms(now, t0), tag);
+        }
+    }
+    if (!n) {
+        char busy[80] = ""; int bo = 0;
+        for (u32 w = 0; w < CELL_SPURS_MAX_WORKLOAD; w++)
+            if (s_wkl_busy[w]) bo += snprintf(busy + bo, sizeof busy - bo, " %u", w);
+        fprintf(stderr, "%s no kernel thread is in a policy-module run; busy claims:%s\n", tag, bo ? busy : " none");
+    }
+    return n;
+}
