+/* KZ3 patch 1047 (SPU pass 34): host-side readers and a re-kick for the fiber stall report
+ * (port/spu/kz3_ppu_overrides.cpp). peek fills the host readyCount, the instance bytes (ready, state,
+ * current contention) and the owning instance EA; returns 1 when the workload is in use. kick is
+ * ReadyCountSwap without a guest pointer for the old value (returned). image returns the resolved
+ * policy-module image id (0 = none). kz3-spurs-ready begin */
+int kz3_spurs_ready_peek(u32 wid, u32* ready_host, u32* ready_inst, u32* state, u32* curcont, u32* spurs_ea)
+{
+    if (wid >= CELL_SPURS_MAX_WORKLOAD || !s_workloads[wid].in_use) return 0;
+    u32 ea = s_workloads[wid].spurs_ea;
+    if (ready_host) *ready_host = s_workloads[wid].readyCount;
+    if (ready_inst) *ready_inst = ea ? *(vm_base + ea + SPURS_WKL_READY1 + wid) : 0;
+    if (state)      *state      = ea ? *(vm_base + ea + SPURS_WKL_STATE1 + wid) : 0;
+    if (curcont)    *curcont    = ea ? *(vm_base + ea + SPURS_WKL_CURCONT + wid) : 0;
+    if (spurs_ea)   *spurs_ea   = ea;
+    return 1;
+}
+u32 kz3_spurs_ready_kick(u32 wid, u32 value)
+{
+    if (wid >= CELL_SPURS_MAX_WORKLOAD || !s_workloads[wid].in_use) return 0;
+    u32 old = s_workloads[wid].readyCount, ea = s_workloads[wid].spurs_ea;
+    s_workloads[wid].readyCount = value;
+    if (ea) *(vm_base + ea + SPURS_WKL_READY1 + wid) = (u8)value;
+    return old;
+}
+int kz3_spurs_workload_image(u32 wid)
+{
+    if (wid >= CELL_SPURS_MAX_WORKLOAD || !s_workloads[wid].in_use) return 0;
+    WklPm* r = spurs_resolve_pm(wid);
+    return r ? r->image_id : 0;
+}
+/* kz3-spurs-ready end */
