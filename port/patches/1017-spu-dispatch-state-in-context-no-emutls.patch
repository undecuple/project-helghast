+/* KZ3 patch 1017: this runs on every MFC channel access, so the context caches its own engine in
+ * mfc_cache (no lock, no list walk; was thread-local, emulated TLS on MinGW). spu_mfc_release clears
+ * it before it frees the slot; a slot's ctx never changes while it is claimed. Upstream's opt-in
+ * SPU_MFC_LOOKUP_CACHE (thread-local) stays in the slow path. */
+static mfc_engine* mfc_for_slow(spu_context* ctx);
 static mfc_engine* mfc_for(spu_context* ctx)
+{
+    if (ctx->mfc_cache) return (mfc_engine*)ctx->mfc_cache;
+    mfc_engine* e = mfc_for_slow(ctx);
+    ctx->mfc_cache = e;
+    return e;
+}
+
+static mfc_engine* mfc_for_slow(spu_context* ctx)
 {
