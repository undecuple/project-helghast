 /* ---- printer ---------------------------------------------------------------------- */
+/* ---- patch 1135: KZ3_CPU_PROBE (diagnostic, opt-in) ------------------------------------------------
+ * Every 256th indirect hop (spu_ib_direct) of an SPU thread samples the logical processor it runs on; each [wacct] window
+ * prints the per-processor counts and the thread's CPU ms next to the wait totals, and `[cpu-topo]` at start lists
+ * each logical processor's core, SMT sibling and efficiency class. */
+void kz3_wacct_cpu_probe(void)
+{
+#ifdef _WIN32
+    wa_thr* t = me();
+    if (!t || (++t->cpu_tick & 255u)) return;
+    const unsigned c = GetCurrentProcessorNumber();
+    if (c < 64) t->cpu_cnt[c]++;
+#endif
+}
+
+#ifdef _WIN32
+static void cpu_topo(void)
+{
+    DWORD len = 0;
+    GetLogicalProcessorInformationEx(RelationProcessorCore, NULL, &len);
+    if (!len) { fprintf(stderr, "[cpu-topo] GetLogicalProcessorInformationEx gave no length\n"); return; }
+    char* buf = (char*)malloc(len);
+    if (!buf || !GetLogicalProcessorInformationEx(RelationProcessorCore, (SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX*)buf, &len)) {
+        fprintf(stderr, "[cpu-topo] GetLogicalProcessorInformationEx failed\n"); free(buf); return; }
+    int core = 0;
+    for (DWORD off = 0; off < len; ) {
+        SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX* i = (SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX*)(buf + off);
+        char cpus[96]; int n = 0; cpus[0] = 0;
+        for (int g = 0; g < i->Processor.GroupCount; g++)
+            for (int b = 0; b < 64; b++)
+                if (((unsigned long long)i->Processor.GroupMask[g].Mask >> b) & 1 && n < (int)sizeof cpus - 8)
+                    n += snprintf(cpus + n, sizeof cpus - n, "%s%d", n ? "," : "", g * 64 + b);
+        fprintf(stderr, "[cpu-topo] core%d cpus=%s smt=%d effclass=%d\n", core++, cpus,
+                (i->Processor.Flags & LTP_PC_SMT) ? 1 : 0, (int)i->Processor.EfficiencyClass);
+        off += i->Size;
+    }
+    free(buf);
+}
+#endif
