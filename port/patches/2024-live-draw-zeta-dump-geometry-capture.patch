 }
+/* Patch 2024: LD_SURF_DUMP also writes zetas. Reads the R32F snapshot of
+ * zeta i whole and writes it as a PFM (little-endian float, rows bottom to
+ * top). Returns the texels below 1.0, or UINT64_MAX on failure; *mn / *mx get
+ * the range of those texels. */
+static u64 ld_dump_zeta_pfm(const char* path, zdepth_t* z, float* mn, float* mx)
+{
+    *mn = 1.0f; *mx = 0.0f;
+    if (!z->snapshot || !z->snapshot_valid || !z->snapshot_w || !z->snapshot_h) return UINT64_MAX;
+    const u32 w = z->snapshot_w, h = z->snapshot_h, pitch = (w * 4u + 255u) & ~255u;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = (UINT64)pitch * h;
+    bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+    bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1;
+    bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    ID3D12Resource* rb = NULL;
+    if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&rb)))
+        return UINT64_MAX;
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = z->snapshot;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = z->snapshot_state;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+    D3D12_TEXTURE_COPY_LOCATION src = {0}, dst = {0};
+    src.pResource = z->snapshot; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    dst.pResource = rb; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    dst.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R32_FLOAT;
+    dst.PlacedFootprint.Footprint.Width = w;
+    dst.PlacedFootprint.Footprint.Height = h;
+    dst.PlacedFootprint.Footprint.Depth = 1;
+    dst.PlacedFootprint.Footprint.RowPitch = pitch;
+    g.list->lpVtbl->CopyTextureRegion(g.list, &dst, 0, 0, 0, &src, NULL);
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b.Transition.StateAfter = z->snapshot_state;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+    ld_flush(LD_FLUSH_READBACK);
+    u64 below = UINT64_MAX; u8* px = NULL; D3D12_RANGE rr = {0, (SIZE_T)pitch * h};
+    if (SUCCEEDED(rb->lpVtbl->Map(rb, 0, &rr, (void**)&px))) {
+        FILE* f = fopen(path, "wb");
+        below = 0;
+        if (f) fprintf(f, "Pf\n%u %u\n-1.0\n", w, h);
+        for (u32 y = 0; y < h; y++) {
+            const float* row = (const float*)(px + (size_t)pitch * (h - 1u - y));
+            if (f) fwrite(row, 4, w, f);
+            for (u32 x = 0; x < w; x++)
+                if (row[x] < 1.0f) { below++; if (row[x] < *mn) *mn = row[x]; if (row[x] > *mx) *mx = row[x]; }
+        }
+        if (f) fclose(f);
+        D3D12_RANGE wr = {0, 0}; rb->lpVtbl->Unmap(rb, 0, &wr);
+    }
+    rb->lpVtbl->Release(rb);
+    return below;
+}
+/* Dump directory while the frame after a LD_SURF_DUMP trigger runs: every
+ * zeta snapshot a draw samples is written then (the shadow maps are reused
+ * within a frame, so the state at the present is not the one the lights read). */
+static const char* g_zd_dir;
+static u32 g_zd_seq;
+static void ld_zd_after_draw(void)
+{
+    if (g_zd_dir) {
+        static u32 last_zi_frame[64]; static u32 dumped_draw[64];
+        for (u32 k = 0; k < g_zp_n_notes && g_zd_seq < 64; k++) {
+            const ld_zp_note_t* n = &g_zp_notes[k];
+            if (n->zi < 0 || n->why != LD_ZP_SNAP) continue;
+            zdepth_t* z = &g.zdepths[n->zi];
+            /* once per zeta per write generation: snapshot_valid with no new write */
+            const u32 zi = (u32)n->zi & 63u;
+            if (last_zi_frame[zi] == g_ld_frames + 1u && dumped_draw[zi] == (u32)z->draws) continue;
+            static u32 per_zeta[64], per_frame;
+            if (per_frame != g_ld_frames + 1u) { per_frame = g_ld_frames + 1u; memset(per_zeta, 0, sizeof per_zeta); }
+            if (++per_zeta[zi] > 8u && tex_zalias_kind(&n->t) != ZALIAS_SHADOW) continue;
+            last_zi_frame[zi] = g_ld_frames + 1u; dumped_draw[zi] = (u32)z->draws;
+            char path[MAX_PATH * 2]; float mn, mx;
+            snprintf(path, sizeof(path), "%s\\f%06u_zread_%02u_u%u_%08X_fmt%02X_%ux%u.pfm", g_zd_dir,
+                     g_ld_frames, g_zd_seq++, n->unit, z->offset, n->t.format & 0xFFu,
+                     z->snapshot_w, z->snapshot_h);
+            const u64 nb = ld_dump_zeta_pfm(path, z, &mn, &mx);
+            {   /* the draw's inline fragment constants, to recompute the lookup offline */
+                char cp[MAX_PATH * 2];
+                snprintf(cp, sizeof(cp), "%s.fpc", path);
+                FILE* cf = fopen(cp, "wb");
+                if (cf) {
+                    fprintf(cf, "draw %llu frame %u count %u\n", (unsigned long long)g_ld_recent_draw_total,
+                            g_ld_frames, g.fp_constants.count);
+                    for (u32 c = 0; c < g.fp_constants.count; c++)
+                        fprintf(cf, "%08X %08X %08X %08X\n", g.fp_constants.values[c][0], g.fp_constants.values[c][1],
+                                g.fp_constants.values[c][2], g.fp_constants.values[c][3]);
+                    fclose(cf);
+                }
+            }
+            fprintf(stderr, "[zeta-dump] draw=%llu read u%u %u:0x%08X tex=%ux%u fmt=0x%02X zfunc=%u filt=0x%08X "
+                    "pso=%016llx snap=%ux%u below1=%llu min=%.6f max=%.6f\n",
+                    (unsigned long long)g_ld_recent_draw_total, n->unit, z->location, z->offset, n->t.width, n->t.height, n->t.format & 0xFFu,
+                    (n->t.wrap >> 28) & 7u, n->t.filter, (unsigned long long)live_legacy_pso_key(),
+                    z->snapshot_w, z->snapshot_h, (unsigned long long)(nb == UINT64_MAX ? 0 : nb), mn, mx);
+        }
+    }
+}
