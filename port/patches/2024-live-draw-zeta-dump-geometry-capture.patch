+/* Patch 2024 (spike, diagnostic): LD_GEOM_CAPTURE=1 with LD_SURF_DUMP
+ * captures, in the frame after the dump fires, the guest clip-space position
+ * (o[0], before the host's posscale/offset) and the host clip position (Out.pos,
+ * what the rasteriser uses) of every vertex
+ * every draw shades. The generated vertex shader gets a typed UAV write
+ * (RWBuffer<float4> u0, root table 5) guarded by root constants (b2, param 6:
+ * base element, vertex count, on). Written next to the zeta dumps:
+ * geom_meta.tsv (one row per draw), geom_verts.bin (float4 o0, float4 host
+ * clip position per vertex) and geom_idx.bin (the u32 triangle-list indices of indexed draws). */
+#define LD_GC_ELEMS (12u * 1024u * 1024u)   /* float4 elements: 192 MB, 6 M vertices */
+static int g_gc_on = -1;
+static ID3D12Resource* g_gc_buf;
+static u32 g_gc_used, g_gc_draws, g_gc_overflow, g_gc_nopatch;
+static FILE* g_gc_meta; static FILE* g_gc_idx; static u64 g_gc_idx_n;
+static int ld_gc_enabled(void)
+{
+    if (g_gc_on < 0) { const char* e = getenv("LD_GEOM_CAPTURE"); g_gc_on = e && e[0] && e[0] != '0'; }
+    return g_gc_on;
+}
+/* Returns 1 when the shader was patched. */
+static int ld_gc_patch_vs(char* hlsl, u32 size)
+{
+    char* in = strstr(hlsl, "struct VSInput {\n");
+    char* mn = strstr(hlsl, "VSOutput main(");
+    char* out = strstr(hlsl, "    return Out;\n");
+    if (!in || !mn || !out || strstr(out + 1, "    return Out;\n")) return 0;
+    static const char a[] = "    uint cap_vid:SV_VertexID;\n";
+    static const char b[] = "RWBuffer<float4> rsx_cap : register(u0);\ncbuffer CapC : register(b2) { uint4 cap_c; };\n";
+    static const char c[] = "    if (cap_c.z != 0u && input.cap_vid < cap_c.y) {\n"
+        "        rsx_cap[cap_c.x + input.cap_vid * 2u] = o[0];\n"
+        "        rsx_cap[cap_c.x + input.cap_vid * 2u + 1u] = Out.pos; }\n";
+    const u32 used = (u32)strlen(hlsl);
+    if (used + sizeof a + sizeof b + sizeof c > size) return 0;
+    /* back to front so the earlier pointers stay valid */
+    memmove(out + sizeof c - 1, out, strlen(out) + 1); memcpy(out, c, sizeof c - 1);
+    memmove(mn + sizeof b - 1, mn, strlen(mn) + 1); memcpy(mn, b, sizeof b - 1);
+    in += strlen("struct VSInput {\n");
+    memmove(in + sizeof a - 1, in, strlen(in) + 1); memcpy(in, a, sizeof a - 1);
+    return 1;
+}
+static int ld_gc_buffer(void)
+{
+    if (g_gc_buf) return 1;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = (UINT64)LD_GC_ELEMS * 16u;
+    bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+    bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1;
+    bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    bd.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_UNORDERED_ACCESS, NULL, &IID_ID3D12Resource, (void**)&g_gc_buf))) {
+        fprintf(stderr, "[geom-cap] buffer allocation failed\n"); g_gc_on = 0; return 0;
+    }
+    D3D12_UNORDERED_ACCESS_VIEW_DESC ud = {0};
+    ud.Format = DXGI_FORMAT_R32G32B32A32_FLOAT;
+    ud.ViewDimension = D3D12_UAV_DIMENSION_BUFFER;
+    ud.Buffer.NumElements = LD_GC_ELEMS;
+    g.dev->lpVtbl->CreateUnorderedAccessView(g.dev, g_gc_buf, NULL, &ud, srv_cpu(UAV_GEOM_CAP));
+    return 1;
+}
+/* Before each draw while LD_GEOM_CAPTURE is set: bind the UAV table and the
+ * guard constants (capture off outside the capture frame). */
+static void ld_gc_bind(int capture, u32 nverts, u32 n_idx, const u32* idx, u32 target, u32 zslot,
+                       const rsx_dsp_surface* sf, u32 prim, int indexed)
+{
+    if (!ld_gc_buffer() || g.srv_ring_used >= SRV_RING_TABLES) return;
+    const u32 base = g.srv_ring_used++ * SRV_TABLE_SIZE;
+    D3D12_CPU_DESCRIPTOR_HANDLE cpu;
+    g.srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(g.srv_heap, &cpu);
+    cpu.ptr += (size_t)base * g.srv_step;
+    g.dev->lpVtbl->CopyDescriptorsSimple(g.dev, 1, cpu, srv_cpu(UAV_GEOM_CAP),
+                                         D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    D3D12_GPU_DESCRIPTOR_HANDLE gpu;
+    g.srv_heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(g.srv_heap, &gpu);
+    gpu.ptr += (u64)base * g.srv_step;
+    g.list->lpVtbl->SetGraphicsRootDescriptorTable(g.list, 5, gpu);
+    UINT c[4] = { g_gc_used, nverts, 0, 0 };
+    if (capture && g_gc_meta) {
+        if (g_gc_used + 2u * nverts > LD_GC_ELEMS) g_gc_overflow++;
+        else {
+            c[2] = 1;
+            render_state_t rs; decode_render_state(&rs);
+            fprintf(g_gc_meta, "%u\t%u\t0x%X\t%ux%u\t0x%X\t%u\t%ux%u\t%u\t%u\t%u\t%u\t%u\t%llu\t%016llx\t%u\t%u\t%u\t%u\t%u\n",
+                    g_gc_draws, g_ld_frames, target < g.n_surfaces ? g.surfaces[target].offset : 0u,
+                    target < g.n_surfaces ? g.surfaces[target].w : 0u, target < g.n_surfaces ? g.surfaces[target].h : 0u,
+                    zslot ? g.zdepths[zslot - 1u].offset : 0u, zslot ? g.zdepths[zslot - 1u].depth_format : 0u,
+                    sf->clip_w, sf->clip_h, prim, indexed, n_idx, nverts, g_gc_used,
+                    (unsigned long long)(indexed ? g_gc_idx_n : 0ull),
+                    (unsigned long long)g_ld_current_pso.key, g_ld_current_pso.vp_start,
+                    rs.depth_test, rs.depth_write, rs.cull_enable, rs.color_mask);
+            if (indexed && g_gc_idx) { fwrite(idx, 4, n_idx, g_gc_idx); g_gc_idx_n += n_idx; }
+            g_gc_used += 2u * nverts; g_gc_draws++;
+        }
+    }
+    g.list->lpVtbl->SetGraphicsRoot32BitConstants(g.list, 6, 4, c, 0);
+}
+static void ld_gc_start(const char* dir)
+{
+    if (!ld_gc_enabled() || !ld_gc_buffer()) return;
+    char path[MAX_PATH * 2];
+    snprintf(path, sizeof path, "%s\\geom_meta.tsv", dir); g_gc_meta = fopen(path, "wb");
+    snprintf(path, sizeof path, "%s\\geom_idx.bin", dir); g_gc_idx = fopen(path, "wb");
+    if (g_gc_meta) fprintf(g_gc_meta, "draw\tframe\tsurf\tsurf_wh\tzeta\tzfmt\tclip\tprim\tindexed\tn_idx\tnverts\tbase\tidx_off\tpso\tvp_start\tdtest\tdwrite\tcull\tcmask\n");
+    g_gc_used = g_gc_draws = g_gc_overflow = 0; g_gc_idx_n = 0;
+}
+static void ld_gc_finish(const char* dir)
+{
+    if (!g_gc_meta) return;
+    fclose(g_gc_meta); g_gc_meta = NULL;
+    if (g_gc_idx) { fclose(g_gc_idx); g_gc_idx = NULL; }
+    const UINT64 bytes = (UINT64)g_gc_used * 16u;
+    if (bytes) {
+        D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+        D3D12_RESOURCE_DESC bd = {0};
+        bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = bytes;
+        bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+        bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1;
+        bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        ID3D12Resource* rb = NULL;
+        if (SUCCEEDED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+                D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&rb))) {
+            D3D12_RESOURCE_BARRIER b = {0};
+            b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+            b.Transition.pResource = g_gc_buf;
+            b.Transition.StateBefore = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+            b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+            g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+            g.list->lpVtbl->CopyBufferRegion(g.list, rb, 0, g_gc_buf, 0, bytes);
+            b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+            b.Transition.StateAfter = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+            g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+            ld_flush(LD_FLUSH_READBACK);
+            u8* px = NULL; D3D12_RANGE rr = {0, (SIZE_T)bytes};
+            if (SUCCEEDED(rb->lpVtbl->Map(rb, 0, &rr, (void**)&px))) {
+                char path[MAX_PATH * 2];
+                snprintf(path, sizeof path, "%s\\geom_verts.bin", dir);
+                FILE* f = fopen(path, "wb");
+                if (f) { fwrite(px, 1, (size_t)bytes, f); fclose(f); }
+                D3D12_RANGE wr = {0, 0}; rb->lpVtbl->Unmap(rb, 0, &wr);
+            }
+            rb->lpVtbl->Release(rb);
+        }
+    }
+    fprintf(stderr, "[geom-cap] frame=%u draws=%u vertices=%u indices=%llu overflow=%u unpatched_vs=%u\n",
+            g_ld_frames, g_gc_draws, g_gc_used / 2u, (unsigned long long)g_gc_idx_n, g_gc_overflow, g_gc_nopatch);
+}
