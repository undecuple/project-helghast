new file mode 100644
index 00000000..845b2acf
--- /dev/null
+++ b/libs/input/pad_host.h
@@ -0,0 +1,422 @@
+/*
+ * pad_host.h -- host pad state and the SDL3 Gamepad -> DualShock 3 mapping (KZ3 patch 4010).
+ *
+ * Pure functions only: no SDL header and no SDL call, so the mapping, the port assignment, the
+ * actuator and the motion sensor conversions are testable on a host with no SDL and no pad
+ * (tools/net/test_pad_sdl.c). The index values below are SDL3's ABI (SDL_GamepadButton, SDL_GamepadAxis,
+ * SDL_GamepadType, SDL_GamepadButtonLabel, SDL_SensorType; stable since SDL 3.2.0); cellPad.c checks them
+ * against SDL3's headers with static asserts when the build has them.
+ */
+#ifndef PS3RECOMP_PAD_HOST_H
+#define PS3RECOMP_PAD_HOST_H
+
+#include <stdio.h>
+#include <string.h>
+#include "cellPad.h"
+
+typedef struct {
+    int  connected;
+    u16  buttons;           /* CELL_PAD_CTRL_* bitmask */
+    u8   analog_lx;         /* 0-255, center=128 */
+    u8   analog_ly;
+    u8   analog_rx;
+    u8   analog_ry;
+    u8   trigger_l2;        /* 0-255 */
+    u8   trigger_r2;        /* 0-255 */
+    /* Pressure-sensitive face buttons (0-255) */
+    u8   press_right;
+    u8   press_left;
+    u8   press_up;
+    u8   press_down;
+    u8   press_triangle;
+    u8   press_circle;
+    u8   press_cross;
+    u8   press_square;
+    u8   press_l1;
+    u8   press_r1;
+    u8   press_real;   /* 4010: 1 = the ten press_* bytes above are the pad's own analog pressures (DS3), not 0/255 */
+    /* 4010: SIXAXIS words as a DS3 reports them (0-1023), valid when has_sensor (pad_sdl_sensors) */
+    int  has_sensor;
+    u16  sensor_x, sensor_y, sensor_z, sensor_g;
+} PadHostState;
+
+/* SDL3 SDL_GamepadButton values, positional (A = SOUTH, B = EAST, X = WEST, Y = NORTH, whatever the cap says;
+ * PADDLE1-4 = RIGHT_PADDLE1, LEFT_PADDLE1, RIGHT_PADDLE2, LEFT_PADDLE2); MISC2-6 (21-25) are not read. */
+enum { PAD_SDL_A, PAD_SDL_B, PAD_SDL_X, PAD_SDL_Y, PAD_SDL_BACK, PAD_SDL_GUIDE, PAD_SDL_START,
+       PAD_SDL_LEFTSTICK, PAD_SDL_RIGHTSTICK, PAD_SDL_LEFTSHOULDER, PAD_SDL_RIGHTSHOULDER,
+       PAD_SDL_DPAD_UP, PAD_SDL_DPAD_DOWN, PAD_SDL_DPAD_LEFT, PAD_SDL_DPAD_RIGHT,
+       PAD_SDL_MISC1, PAD_SDL_PADDLE1, PAD_SDL_PADDLE2, PAD_SDL_PADDLE3, PAD_SDL_PADDLE4,
+       PAD_SDL_TOUCHPAD, PAD_SDL_BUTTON_MAX };
+/* SDL3 SDL_GamepadAxis values */
+enum { PAD_SDL_LEFTX, PAD_SDL_LEFTY, PAD_SDL_RIGHTX, PAD_SDL_RIGHTY,
+       PAD_SDL_TRIGGERLEFT, PAD_SDL_TRIGGERRIGHT, PAD_SDL_AXIS_MAX };
+
+/* One poll of one controller, as SDL reports it. */
+typedef struct {
+    u8    button[PAD_SDL_BUTTON_MAX];   /* 0/1 */
+    short axis[PAD_SDL_AXIS_MAX];       /* sticks -32768..32767 (Y: up negative), triggers 0..32767 */
+} PadSdlRaw;
+
+/* Same deadzone and L2/R2 threshold as the XInput path, so both backends feel alike. */
+#define PAD_HOST_STICK_DEADZONE    7849
+#define PAD_HOST_TRIGGER_THRESHOLD 30
+
+static inline u8 pad_host_stick_u8(int raw)
+{
+    const int dz = PAD_HOST_STICK_DEADZONE;
+    float n = 0.0f;
+    if (raw > dz)       n = (float)(raw - dz) / (float)(32767 - dz);
+    else if (raw < -dz) n = (float)(raw + dz) / (float)(32767 - dz);
+    int v = (int)(n * 127.0f) + 128;
+    return (u8)(v < 0 ? 0 : v > 255 ? 255 : v);
+}
+
+static inline u8 pad_host_trigger_u8(int raw)
+{
+    int v = raw <= 0 ? 0 : (raw * 255) / 32767;
+    return (u8)(v > 255 ? 255 : v);
+}
+
+/* SDL (position-based) layout -> DS3: A = Cross, B = Circle, X = Square, Y = Triangle; Back (DS4 Share,
+ * DualSense Create) and the touchpad click = Select. Guide (PS button) is not passed on: on a PS3 the system takes it
+ * and the game never sees it. Sticks: SDL's Y is already PS3's (up = low). */
+static inline void pad_sdl_map(const PadSdlRaw* r, PadHostState* hs)
+{
+    static const struct { u8 sdl; u16 cell; } map[] = {
+        { PAD_SDL_BACK, CELL_PAD_CTRL_SELECT },     { PAD_SDL_TOUCHPAD, CELL_PAD_CTRL_SELECT },
+        { PAD_SDL_LEFTSTICK, CELL_PAD_CTRL_L3 },    { PAD_SDL_RIGHTSTICK, CELL_PAD_CTRL_R3 },
+        { PAD_SDL_START, CELL_PAD_CTRL_START },
+        { PAD_SDL_DPAD_UP, CELL_PAD_CTRL_UP },      { PAD_SDL_DPAD_RIGHT, CELL_PAD_CTRL_RIGHT },
+        { PAD_SDL_DPAD_DOWN, CELL_PAD_CTRL_DOWN },  { PAD_SDL_DPAD_LEFT, CELL_PAD_CTRL_LEFT },
+        { PAD_SDL_LEFTSHOULDER, CELL_PAD_CTRL_L1 }, { PAD_SDL_RIGHTSHOULDER, CELL_PAD_CTRL_R1 },
+        { PAD_SDL_Y, CELL_PAD_CTRL_TRIANGLE },      { PAD_SDL_B, CELL_PAD_CTRL_CIRCLE },
+        { PAD_SDL_A, CELL_PAD_CTRL_CROSS },         { PAD_SDL_X, CELL_PAD_CTRL_SQUARE },
+    };
+    u16 b = 0;
+    for (size_t i = 0; i < sizeof map / sizeof map[0]; i++)
+        if (r->button[map[i].sdl]) b |= map[i].cell;
+    memset(hs, 0, sizeof *hs);
+    hs->connected  = 1;
+    hs->trigger_l2 = pad_host_trigger_u8(r->axis[PAD_SDL_TRIGGERLEFT]);
+    hs->trigger_r2 = pad_host_trigger_u8(r->axis[PAD_SDL_TRIGGERRIGHT]);
+    if (hs->trigger_l2 > PAD_HOST_TRIGGER_THRESHOLD) b |= CELL_PAD_CTRL_L2;
+    if (hs->trigger_r2 > PAD_HOST_TRIGGER_THRESHOLD) b |= CELL_PAD_CTRL_R2;
+    hs->buttons   = b;
+    hs->analog_lx = pad_host_stick_u8(r->axis[PAD_SDL_LEFTX]);
+    hs->analog_ly = pad_host_stick_u8(r->axis[PAD_SDL_LEFTY]);
+    hs->analog_rx = pad_host_stick_u8(r->axis[PAD_SDL_RIGHTX]);
+    hs->analog_ry = pad_host_stick_u8(r->axis[PAD_SDL_RIGHTY]);
+    /* Pressure: SDL reports the face buttons as digital, so 0 or 255 (as XInput). */
+    hs->press_up       = (b & CELL_PAD_CTRL_UP)       ? 255 : 0;
+    hs->press_down     = (b & CELL_PAD_CTRL_DOWN)     ? 255 : 0;
+    hs->press_left     = (b & CELL_PAD_CTRL_LEFT)     ? 255 : 0;
+    hs->press_right    = (b & CELL_PAD_CTRL_RIGHT)    ? 255 : 0;
+    hs->press_triangle = (b & CELL_PAD_CTRL_TRIANGLE) ? 255 : 0;
+    hs->press_circle   = (b & CELL_PAD_CTRL_CIRCLE)   ? 255 : 0;
+    hs->press_cross    = (b & CELL_PAD_CTRL_CROSS)    ? 255 : 0;
+    hs->press_square   = (b & CELL_PAD_CTRL_SQUARE)   ? 255 : 0;
+    hs->press_l1       = (b & CELL_PAD_CTRL_L1)       ? 255 : 0;
+    hs->press_r1       = (b & CELL_PAD_CTRL_R1)       ? 255 : 0;
+}
+
+/* SDL_GamepadType -> the name the log shows ("[pad] port 0: DualSense"). */
+static inline const char* pad_sdl_type_name(int t)
+{
+    switch (t) {
+    case 1:  return "gamepad";
+    case 2:  return "Xbox 360";
+    case 3:  return "Xbox One";
+    case 4:  return "DualShock 3";
+    case 5:  return "DualShock 4";
+    case 6:  return "DualSense";
+    case 7:  return "Switch Pro";
+    case 8: case 9: case 10: return "Joy-Con";
+    default: return "gamepad";
+    }
+}
+
+/* SDL_GamepadButtonLabel (what the cap shows) -> log text, for the face buttons. */
+static inline const char* pad_sdl_label_name(int l)
+{
+    static const char* const n[] = { "?", "A", "B", "X", "Y", "Cross", "Circle", "Square", "Triangle" };
+    return l >= 0 && l < (int)(sizeof n / sizeof n[0]) ? n[l] : "?";
+}
+
+/* SDL3 SDL_SensorType values */
+enum { PAD_SDL_SENSOR_ACCEL = 1, PAD_SDL_SENSOR_GYRO = 2 };
+
+/* Motion sensors -> DS3 SIXAXIS (cellPad SENSOR_ON words 20-23, 10 bits, 0..1023):
+ *   DS3: accel X, Y, Z with 512 = 0 g and 113 counts per g; a DS3 lying flat reads Y = 399 (the runtime's rest value);
+ *        G = one gyro, the yaw rate, 512 = still, 123 counts per 90 deg/s.
+ *   SDL3: accel in m/s^2 (+X right, +Y up, +Z toward the player; lying flat reads Y = +9.80665), gyro in rad/s
+ *        (values[0] pitch, [1] yaw, [2] roll; counter-clockwise positive seen from the positive axis).
+ *   ds3_accel = 512 - 113 * a / 9.80665          (SDL's +1 g on Y at rest -> 399, as a DS3)
+ *   ds3_g     = 512 - 123 * yaw * (180 / pi) / 90
+ * rounded, clamped to 0..1023. ASSUMPTION: the signs of X, Z and G (all axes taken inverted from SDL's, as Y must
+ * be) and the scales 113 / 123-per-90 (the ones RPCS3 uses to bring DS4 data into DS3 range, not measured on a DS3);
+ * a real DualShock 4 / DualSense confirms them. accel or gyro NULL = that sensor absent (DS3 rest value). */
+static inline u16 pad_sensor_word(float v)
+{
+    float w = v + (v >= 0.0f ? 0.5f : -0.5f);
+    return (u16)(w < 0.0f ? 0 : w > 1023.0f ? 1023 : (int)w);
+}
+
+static inline void pad_sdl_sensors(const float* accel, const float* gyro, PadHostState* hs)
+{
+    const float g = 9.80665f, deg = 57.29578f;
+    hs->has_sensor = accel || gyro;
+    hs->sensor_x = accel ? pad_sensor_word(512.0f - 113.0f * accel[0] / g) : 512;
+    hs->sensor_y = accel ? pad_sensor_word(512.0f - 113.0f * accel[1] / g) : 399;
+    hs->sensor_z = accel ? pad_sensor_word(512.0f - 113.0f * accel[2] / g) : 512;
+    hs->sensor_g = gyro  ? pad_sensor_word(512.0f - 123.0f * gyro[1] * deg / 90.0f) : 512;
+}
+
+/* DualShock 3 centre (pass 27). SDL's main PS3 driver (SDL_hidapi_ps3.c ScaleAccel :343-348, use :514-516 and :1371-1373,
+ * release-3.4.x): SDL x = (b41/42 - 511)/113 g, y = -(b45/46 - 511)/113 g, z = -(b43/44 - 511)/113 g, in the SDL standard frame
+ * (y up: a flat pad reads y = +g, so Y = 511 - 113 = 398). RPCS3's DS3 handler (ds3_pad_handler.cpp:430-437, master) reads the words as
+ * x = b41, z = b43, y = b45, gyro b47 (ds3_pad_handler.h:56-59) -> cellPad X/Y/Z/G, and flips raw X on a raw HID read (console
+ * X = 1024 - raw X, :433). With that flip the main driver's inverse is X = 513 - 113 x/g, Y = 511 - 113 y/g, Z = 511 - 113 z/g,
+ * which agrees with the sixaxis path (:350-353, :1028-1030: -(raw - 512)/113 g on every axis, = 512 - 113 a/g, a console-convention
+ * driver) to within 1 count; the DS4/DualSense mapping (RPCS3 ds4_pad_handler.cpp:890-902: -accel*113 + 512, SDL's PS4 accel is the
+ * same y-up frame) is 512 - 113 a/g too. So pad_sdl_sensors' 512 is right for DS4/DualSense and the sixaxis path; for a PS3-type
+ * pad this shifts the words onto the main driver's centres (a PS3-type pad cannot be told apart by driver here). ASSUMPTION: the X flip
+ * is RPCS3's reading of a raw HID report, not verified on a console; the 1-count centre is below the DS3's own offset spread.
+ * Call after pad_sdl_sensors; does nothing without accelerometer data (has_sensor with a DS3 means accel; it has no gyro). */
+static inline void pad_sdl_sensors_ds3_centre(PadHostState* hs)
+{
+    if (!hs->has_sensor) return;
+    hs->sensor_x = pad_sensor_word((float)hs->sensor_x + 1.0f);
+    hs->sensor_y = pad_sensor_word((float)hs->sensor_y - 1.0f);
+    hs->sensor_z = pad_sensor_word((float)hs->sensor_z - 1.0f);
+}
+
+/* DS3 actuators: motor[SMALL] is on/off (0 or 1, any non-zero counts), motor[LARGE] is 0-255. SDL's low-frequency
+ * motor is the large one. */
+static inline void pad_act_to_rumble(const u8 motor[CELL_PAD_ACTUATOR_MAX], unsigned short* low, unsigned short* high)
+{
+    *low  = (unsigned short)(motor[CELL_PAD_ACTUATOR_PARAM_LARGE] * 257);
+    *high = motor[CELL_PAD_ACTUATOR_PARAM_SMALL] ? 0xFFFF : 0;
+}
+
+/* Hot-plug: keep each controller (SDL instance id) on the port it got; a new one takes the lowest free port; a port
+ * whose controller is gone is freed (-1). present = the instance ids attached now. Returns a bitmask of changed ports. */
+static inline unsigned pad_slots_sync(int* slot, int nslot, const int* present, int npresent)
+{
+    unsigned changed = 0;
+    for (int s = 0; s < nslot; s++) {
+        if (slot[s] < 0) continue;
+        int found = 0;
+        for (int i = 0; i < npresent && !found; i++) found = present[i] == slot[s];
+        if (!found) { slot[s] = -1; changed |= 1u << s; }
+    }
+    for (int i = 0; i < npresent; i++) {
+        int have = 0;
+        for (int s = 0; s < nslot && !have; s++) have = slot[s] == present[i];
+        for (int s = 0; s < nslot && !have; s++)
+            if (slot[s] < 0) { slot[s] = present[i]; changed |= 1u << s; have = 1; }
+    }
+    return changed;
+}
+
+/* Sensor watch (4010, network pass 23 of 2026-10-20). SDL lists a pad's sensors when its driver adds them. In SDL 3.4.16
+ * the PS4/PS5 HIDAPI drivers add gyro + accel inside SDL_OpenGamepad (their SDL_JOYSTICK_ENHANCED_REPORTS hint
+ * callback runs there) when that hint is "1" or "auto", never while it is "0" on Bluetooth, and later if the hint
+ * changes. So the sensors are looked for at open and again once a second for 10 s (or until both are on):
+ * for ACCEL then GYRO, has(type) and, only when it says yes and that sensor is not on yet, enable(type).
+ * has/enable stand for SDL_GamepadHasSensor and SDL_SetGamepadSensorEnabled(.., true); ctx is the SDL_Gamepad. */
+#define PAD_SENSOR_RECHECK_MS 1000ull
+#define PAD_SENSOR_WINDOW_MS  10000ull
+typedef int (*pad_sensor_has_fn)(void* ctx, int type);
+typedef int (*pad_sensor_enable_fn)(void* ctx, int type);
+typedef struct {
+    unsigned long long open_ms, next_ms;
+    unsigned char on;        /* bit 0 accel, bit 1 gyro: enabled */
+    unsigned char refused;   /* listed by SDL but the enable call failed (last try) */
+    unsigned char watching;  /* 1 while the re-check window runs */
+} PadSensorWatch;
+enum { PAD_SENSOR_CHANGED = 1, PAD_SENSOR_ENDED = 2 };   /* pad_sensor_tick result bits */
+
+static inline void pad_sensor_try(PadSensorWatch* w, pad_sensor_has_fn has, pad_sensor_enable_fn en, void* ctx)
+{
+    static const int type[2] = { PAD_SDL_SENSOR_ACCEL, PAD_SDL_SENSOR_GYRO };
+    for (int i = 0; i < 2; i++) {
+        unsigned char b = (unsigned char)(1u << i);
+        if ((w->on & b) || !has(ctx, type[i])) continue;
+        if (en(ctx, type[i])) { w->on |= b; w->refused &= (unsigned char)~b; }
+        else w->refused |= b;
+    }
+}
+static inline void pad_sensor_open(PadSensorWatch* w, unsigned long long now, pad_sensor_has_fn has,
+                                   pad_sensor_enable_fn en, void* ctx)
+{
+    memset(w, 0, sizeof *w);
+    w->open_ms = now;
+    w->next_ms = now + PAD_SENSOR_RECHECK_MS;
+    pad_sensor_try(w, has, en, ctx);
+    w->watching = w->on != 3;
+}
+/* Call every poll; returns PAD_SENSOR_CHANGED when a sensor came on, PAD_SENSOR_ENDED when the window closed without
+ * both (the last re-check runs at open + 10 s), 0 otherwise. No SDL call between re-checks or after the window. */
+static inline int pad_sensor_tick(PadSensorWatch* w, unsigned long long now, pad_sensor_has_fn has,
+                                  pad_sensor_enable_fn en, void* ctx)
+{
+    if (!w->watching || now < w->next_ms) return 0;
+    unsigned char before = w->on;
+    pad_sensor_try(w, has, en, ctx);
+    do w->next_ms += PAD_SENSOR_RECHECK_MS; while (w->next_ms <= now);   /* on the open + n s grid, no catch-up burst */
+    int r = w->on != before ? PAD_SENSOR_CHANGED : 0;
+    if (w->on == 3) w->watching = 0;
+    else if (now - w->open_ms >= PAD_SENSOR_WINDOW_MS) { w->watching = 0; r |= PAD_SENSOR_ENDED; }
+    return r;
+}
+static inline const char* pad_sensor_set_name(unsigned on)
+{
+    return on == 3 ? "accel+gyro" : on == 1 ? "accel" : on == 2 ? "gyro" : "no";
+}
+/* Why one sensor (bit 0 accel, 1 gyro) is off, for the log: "on", "refused" (listed, enable failed), "none" (not listed). */
+static inline const char* pad_sensor_why(const PadSensorWatch* w, int bit)
+{
+    return (w->on >> bit & 1) ? "on" : (w->refused >> bit & 1) ? "refused" : "none";
+}
+
+/* SDL_GUID bytes for the log: bytes 0-1 = bus (little-endian), byte 14 = driver signature (SDL_joystick.c,
+ * SDL_CreateJoystickGUID; 0 = no signature, which on Windows is DirectInput). On Windows only the HIDAPI (and
+ * GameInput) drivers report pad sensors in SDL 3.4.16; WGI, DirectInput, XInput and RawInput never do. */
+static inline const char* pad_sdl_driver_name(unsigned char sig)
+{
+    switch (sig) {
+    case 'h': return "hidapi";
+    case 'r': return "rawinput";
+    case 'w': return "wgi";
+    case 'x': return "xinput";
+    case 'g': return "gameinput";
+    case 'v': return "virtual";
+    case 'm': return "mfi";
+#ifdef _WIN32
+    case 0:   return "directinput";
+#else
+    case 0:   return "system";
+#endif
+    default:  return "other";
+    }
+}
+static inline const char* pad_sdl_bus_name(const unsigned char guid[16])
+{
+    unsigned bus = guid[0] | (unsigned)guid[1] << 8;
+    return bus == 0x03 ? "usb" : bus == 0x05 ? "bluetooth" : bus == 0xFF ? "virtual" : bus == 0 ? "unknown" : "other";
+}
+/* SDL_JoystickConnectionState: -1 invalid, 0 unknown, 1 wired, 2 wireless */
+static inline const char* pad_sdl_conn_name(int c)
+{
+    return c == 1 ? "wired" : c == 2 ? "wireless" : c == 0 ? "unknown" : "invalid";
+}
+/* A string from SDL (device path) for one log line: printable ASCII only, at most n-1 bytes, NULL -> "?". */
+static inline void pad_log_clean(char* dst, size_t n, const char* src)
+{
+    size_t i = 0;
+    if (!n) return;
+    if (!src) src = "?";
+    for (; src[i] && i + 1 < n; i++) dst[i] = (src[i] >= 0x20 && src[i] <= 0x7E) ? src[i] : '?';
+    dst[i] = 0;
+}
+
+/* SDL hints set before SDL_InitSubSystem with SDL_HINT_OVERRIDE: at normal priority an environment variable of the
+ * same name wins (SDL_hints.c), and Proton passes the Linux environment through. SDL_JOYSTICK_ENHANCED_REPORTS = 1
+ * is SDL 3.4.16's default; "0" in the environment keeps a Bluetooth DS4/DualSense from ever listing its sensors. */
+#if defined(__GNUC__)
+#define PAD_HOST_UNUSED __attribute__((unused))
+#else
+#define PAD_HOST_UNUSED
+#endif
+static const char* const pad_sdl_hints[][2] PAD_HOST_UNUSED = {
+    { "SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS", "1" },
+    { "SDL_JOYSTICK_HIDAPI", "1" },
+    { "SDL_JOYSTICK_HIDAPI_PS4", "1" },
+    { "SDL_JOYSTICK_HIDAPI_PS5", "1" },
+    { "SDL_JOYSTICK_HIDAPI_SWITCH", "1" },
+    { "SDL_JOYSTICK_HIDAPI_XBOX", "1" },
+    { "SDL_JOYSTICK_ENHANCED_REPORTS", "1" },
+    { "SDL_JOYSTICK_RAWINPUT", "0" },
+};
+/* DualShock 3 hints (pass 27, ASSUMPTION: untested on a real DS3), set at SDL_HINT_NORMAL priority, NOT override: a
+ * player's environment variable of the same name wins (SDL_SetHintWithPriority refuses a lower priority than the
+ * environment's, SDL_hints.c), so "SDL_JOYSTICK_HIDAPI_PS3=0" turns the port's choice off. Both drivers are off by
+ * default on Windows (SDL_hidapi_ps3.c HIDAPI_DriverPS3_IsEnabled default_value = false for SDL_PLATFORM_WIN32; the
+ * sixaxis one: SDL_GetHintBoolean(SDL_HINT_JOYSTICK_HIDAPI_PS3_SIXAXIS_DRIVER, false), release-3.4.x). They only
+ * matter when a DS3 is attached and SDL can open it: under Proton with PROTON_ENABLE_HIDRAW the HIDAPI PS3 driver
+ * may now see a DS3; on Windows with DsHidMini in SXS mode (Sony's sixaxis.sys protocol) the sixaxis driver applies. */
+#define PAD_SDL_HINT_NORMAL 1     /* SDL_HintPriority SDL_HINT_NORMAL */
+static const char* const pad_sdl_soft_hints[][2] PAD_HOST_UNUSED = {
+    { "SDL_JOYSTICK_HIDAPI_PS3", "1" },
+    { "SDL_JOYSTICK_HIDAPI_PS3_SIXAXIS_DRIVER", "1" },
+};
+/* The text for the [pad] hint line of a soft hint: which value takes effect. env = getenv(name) or NULL. */
+static inline void pad_sdl_soft_hint_text(char* dst, size_t n, const char* name, const char* ours, const char* env)
+{
+    char v[64];
+    if (!n) return;
+    if (env) {
+        pad_log_clean(v, sizeof v, env);
+        snprintf(dst, n, "SDL hint %s=%s from the environment (port default %s not used)", name, v, ours);
+    } else {
+        snprintf(dst, n, "SDL hint %s=%s (port default; the environment can change it)", name, ours);
+    }
+}
+
+/* DualShock 3 analog button pressures. SDL's PS3 HIDAPI drivers add 10 joystick axes after the 6 standard ones when
+ * the driver has_analog_buttons (SDL_hidapi_ps3.c:281-283 main driver, :741-743 sixaxis driver; has_analog_buttons
+ * = true at :177 and, for the third-party driver, :670-672). The report loops send them "in the order they appear in
+ * the button enumeration", skipping buttons without a pressure, starting at axis_index = 6 (:478-509 main driver,
+ * :858-889 sixaxis driver): SOUTH(cross) 6, EAST(circle) 7, WEST(square) 8, NORTH(triangle) 9, LEFT_SHOULDER(L1) 10,
+ * RIGHT_SHOULDER(R1) 11, DPAD_UP 12, DPAD_DOWN 13, DPAD_LEFT 14, DPAD_RIGHT 15. Value: ((int)byte * 257) - 32768
+ * (:505, :885) = -32768 (0) .. 32767 (255). L2/R2 are the standard trigger axes (:464-467) already in pad_sdl_map. */
+#define PAD_SDL_TYPE_PS3        4
+#define PAD_SDL_PS3_PRESS_FIRST 6
+#define PAD_SDL_PS3_PRESS_COUNT 10
+#define PAD_SDL_PS3_AXES        (PAD_SDL_PS3_PRESS_FIRST + PAD_SDL_PS3_PRESS_COUNT)
+enum { PAD_PS3P_CROSS, PAD_PS3P_CIRCLE, PAD_PS3P_SQUARE, PAD_PS3P_TRIANGLE, PAD_PS3P_L1, PAD_PS3P_R1,
+       PAD_PS3P_UP, PAD_PS3P_DOWN, PAD_PS3P_LEFT, PAD_PS3P_RIGHT };
+
+/* 1 = read the pressure axes: the pad's SDL type is PS3 and its joystick has all 16 axes. */
+static inline int pad_sdl_has_pressure(int sdl_type, int num_axes)
+{
+    return sdl_type == PAD_SDL_TYPE_PS3 && num_axes >= PAD_SDL_PS3_AXES;
+}
+static inline u8 pad_sdl_press_u8(int raw)   /* -32768..32767 -> 0..255, clamped */
+{
+    int v = (raw + 32768) / 257;
+    return (u8)(v < 0 ? 0 : v > 255 ? 255 : v);
+}
+/* Fill the ten press_* bytes from the joystick axes 6..15 (ax[0] = axis 6) after pad_sdl_map; sets press_real. A
+ * button whose digital bit is set but whose pressure reads 0 keeps 255 (ASSUMPTION: a driver or axis that never
+ * reports a pressure must not make a pressed button read as released); a pressure with no digital bit is kept. */
+static inline void pad_sdl_press(const short ax[PAD_SDL_PS3_PRESS_COUNT], PadHostState* hs)
+{
+    static const struct { u8 i; u16 bit; } m[PAD_SDL_PS3_PRESS_COUNT] = {
+        { PAD_PS3P_CROSS, CELL_PAD_CTRL_CROSS },   { PAD_PS3P_CIRCLE, CELL_PAD_CTRL_CIRCLE },
+        { PAD_PS3P_SQUARE, CELL_PAD_CTRL_SQUARE }, { PAD_PS3P_TRIANGLE, CELL_PAD_CTRL_TRIANGLE },
+        { PAD_PS3P_L1, CELL_PAD_CTRL_L1 },         { PAD_PS3P_R1, CELL_PAD_CTRL_R1 },
+        { PAD_PS3P_UP, CELL_PAD_CTRL_UP },         { PAD_PS3P_DOWN, CELL_PAD_CTRL_DOWN },
+        { PAD_PS3P_LEFT, CELL_PAD_CTRL_LEFT },     { PAD_PS3P_RIGHT, CELL_PAD_CTRL_RIGHT },
+    };
+    u8 p[PAD_SDL_PS3_PRESS_COUNT];
+    for (int k = 0; k < PAD_SDL_PS3_PRESS_COUNT; k++) {
+        p[m[k].i] = pad_sdl_press_u8(ax[m[k].i]);
+        if (!p[m[k].i] && (hs->buttons & m[k].bit)) p[m[k].i] = 255;
+    }
+    hs->press_cross = p[PAD_PS3P_CROSS];   hs->press_circle = p[PAD_PS3P_CIRCLE];
+    hs->press_square = p[PAD_PS3P_SQUARE]; hs->press_triangle = p[PAD_PS3P_TRIANGLE];
+    hs->press_l1 = p[PAD_PS3P_L1];         hs->press_r1 = p[PAD_PS3P_R1];
+    hs->press_up = p[PAD_PS3P_UP];         hs->press_down = p[PAD_PS3P_DOWN];
+    hs->press_left = p[PAD_PS3P_LEFT];     hs->press_right = p[PAD_PS3P_RIGHT];
+    hs->press_real = 1;
+}
