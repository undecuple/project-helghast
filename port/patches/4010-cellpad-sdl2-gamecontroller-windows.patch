+static const char* const pad_sdl_env_hints[] PAD_HOST_UNUSED = {
+    "SDL_GAMECONTROLLER_IGNORE_DEVICES", "SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT", "SDL_HIDAPI_IGNORE_DEVICES",
+};
+#define PAD_SDL_HINT_OVERRIDE 2   /* SDL_HintPriority SDL_HINT_OVERRIDE */
