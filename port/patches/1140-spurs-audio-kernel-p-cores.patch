     const char* e = getenv("KZ3_SPU_PCORES");
     int scope = kz3_sched_scope(e, async);
-    if (!scope) return;
+    if (!scope) return 0;
     if (s_state != 2) {
         if (__sync_val_compare_and_swap(&s_state, 0, 1) == 0) {
             uint64_t m = 0;
@@ -95,11 +95,46 @@
         }
         while (s_state != 2) Sleep(0);
     }
-    if (!s_mask) return;
-    if (scope == 1 && s_nids && SetThreadSelectedCpuSets(GetCurrentThread(), s_ids, s_nids)) return;
