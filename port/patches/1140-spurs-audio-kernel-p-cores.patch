+/* KZ3 patch 1140 (SPU pass 117): the kernel threads of chosen SPURS instances are restricted like the async job threads.
+ *
+ * Measured (pass 117, KZ3_CPU_PROBE, i7-12700KF, Proton, K2 pyrrhus_outskirts, 1.14 exe): the one host thread of the
+ * LoPrio SPURS instance (the audio SPU: Amadeus/BrB, wid 9 + 5, the RE notes s.1-5) needs 620-760 ms of CPU per
+ * second on a P-core in the level; the scheduler moved it to the E-cores 16-19 for 10-20 s at a time, where it ran at
+ * 1000 ms/s (saturated): units per second fell below the 187.5 real-time rate and port 0 got 100-560 holes per 10 s
+ * (the in-level stutter). The thread has a real-time deadline and no margin on an E-core, as the Bink decoder (1136).
+ * KZ3_SPU_PCORES_SPURS = comma-separated SPURS name prefixes (exact match); unset = "LoPrio" (KZ3's audio instance,
+ * ASSUMPTION: the only one with a deadline; the HiPrio frame SPUs stay free, the pass 112 "all" A/B was worse);
+ * empty = none. KZ3_SPU_PCORES=0 turns this off too. kz3_spurs_pcore_match() is the pure part (test_r112_sched.c). */
+static inline int kz3_spurs_pcore_match(const char* list, const char* prefix)
+{
+    if (!list || !prefix || !prefix[0]) return 0;
+    size_t n = strlen(prefix);
+    for (const char* p = list; *p; ) {
+        const char* c = strchr(p, ',');
+        size_t l = c ? (size_t)(c - p) : strlen(p);
+        if (l == n && !strncmp(p, prefix, n)) return 1;
+        if (!c) break;
+        p = c + 1;
+    }
+    return 0;
+}
+
+/* Called by a SPURS kernel thread once its instance is known. Returns 1 when the thread was restricted. */
+static inline int kz3_spurs_pcore_thread(const char* prefix)
+{
+    const char* e = getenv("KZ3_SPU_PCORES");
+    if (e && e[0] == '0') return 0;
+    const char* l = getenv("KZ3_SPU_PCORES_SPURS");
+    if (!kz3_spurs_pcore_match(l ? l : "LoPrio", prefix)) return 0;
+    return kz3_spu_thread_sched(1);   /* async scope: the default affinity mask (or CPU sets with =sets) */
+}
+
 #endif
