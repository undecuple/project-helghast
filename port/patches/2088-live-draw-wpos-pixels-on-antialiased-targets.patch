 #define RSX_PT_FLAG_DEPTH  4u    /* a depth surface was bound when the pipeline was first seen */
 #define RSX_PT_FLAG_BUFFERED 8u  /* fragment constants in a constant buffer (the only mode the prewarm builds) */
+#define RSX_PT_WPOS_AA_SHIFT 8u  /* patch 2088: flags bits 8-23 = sample grid of the target (aa_sx | aa_sy << 8),
+                                  * 0 = 1x1; the walker keys WPOS-in-pixels pipelines by it */
 #define RSX_PT_FP_SEED   0x4B5A50545F465031ull   /* seed of the template's fragment-program structural hash */
 #define RSX_PT_MAX_RECS  65536u
 
