 #include <stdatomic.h>
 #include <stdint.h>
 #include <stdio.h>
@@ -365,13 +368,28 @@
 #define RACE_ROUNDS 200000
 static atomic_int g_race_go, g_race_reader_done, g_race_writer_done;
 
+/* Wait for cond with a bounded busy spin, then give the CPU away. The three race threads
+ * (main, reader, writer) hand off 200000 rounds; with fewer CPUs than threads a pure spin
+ * burns a whole scheduler slice per hand-off (2 vCPUs: > 10 min instead of seconds). */
+static inline void race_relax(unsigned* spins)
+{
+    if (++*spins < 200) { YieldProcessor(); return; }
+    *spins = 0;
+#ifdef _WIN32
+    SwitchToThread();
+#else
+    sched_yield();
+#endif
+}
+#define RACE_WAIT(cond) do { unsigned sp_ = 0; while (cond) race_relax(&sp_); } while (0)
+
 static void race_delay(unsigned n) { for (unsigned i = 0; i < n; i++) YieldProcessor(); }
 
