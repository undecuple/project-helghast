+/* Patch 2143: the declaration a program using DDX/DDY carries, and its per-pipeline rewrite: x scales DDX, y DDY (the
+ * target's samples per pixel). Returns 1 when rewritten, 0 when the program has no derivative, -1 when the text does
+ * not fit. */
+#define RSX_FP_DERIV_SCALE_DECL "static const float2 _rsx_deriv_scale = float2(1.0, 1.0);"
+int rsx_fp_set_deriv_scale(char* hlsl, u32 hlsl_size, float sx, float sy);
 
 /* Gamma metadata is a post-filter/post-remap RGBA lane mask, with formats
