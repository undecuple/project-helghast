KZ3 patch 2143 (RSX pass 133): fragment DDX and DDY (screen-space derivatives) are decompiled instead of dropped.
Design and code from the Killzone 2 port (its patch 2096); both projects are MIT and have the same owner.

The decompiler had no case for DDX (0x15) or DDY (0x16): it emitted nothing, so the destination register kept 0 and a
program dividing by fwidth(uv) (Killzone 2's anti-aliased menu panels, which blended away to transparent) got NaN, which
the export guard turns into 0. Now DDX emits ddx(v) * _rsx_deriv_scale.x and DDY ddy(v) * _rsx_deriv_scale.y; a program
that uses either gets "static const float2 _rsx_deriv_scale = float2(1.0, 1.0);" in its preamble (other programs' text is
unchanged). ld_xlate rewrites the scale per pipeline from the sample grid of the target (patch 2088: an antialiased target
is kept at sample resolution, so a D3D derivative spans one sample where the RSX's spans a pixel). The grid is already
in every pipeline key, so no key changes. Not ported: the Killzone 2 port's DDY sign flip for a bottom-origin shader
window (needs its patch 2090, WPOS origin, which this port does not have). ASSUMPTION: DDY follows the window y.
Host test: tools/smoke/test_fp_deriv.sh. Upstream candidate (DDX/DDY are general NV40 ops).

Rebased on ps3recomp v0.19.0 (SPU pass 154): three-way merge into the v0.19.0 chain, hunks kept as before, context follows v0.19 (chain glue, owner lane not re-reviewed).

diff --git a/libs/video/rsx_fp_decompiler.c b/libs/video/rsx_fp_decompiler.c
index 719ada0..dd965db 100644
--- a/libs/video/rsx_fp_decompiler.c
+++ b/libs/video/rsx_fp_decompiler.c
@@ -681,6 +681,22 @@ u32 rsx_fp_texture_bx2_units(const u8* ucode, u32 max_bytes)
     return 0;
 }
 
+/* KZ3 patch 2143 (the Killzone 2 port, patch 2096): rewrite the derivative scale a program carrying DDX/DDY declares.
+ * Returns 1 when rewritten, 0 when the program has no derivative, -1 when the text does not fit. */
+int rsx_fp_set_deriv_scale(char* hlsl, u32 hlsl_size, float sx, float sy)
+{
+    if (!hlsl) return 0;
+    char* at = strstr(hlsl, RSX_FP_DERIV_SCALE_DECL);
+    if (!at) return 0;
+    char rep[128];
+    const int rl = snprintf(rep, sizeof rep, "static const float2 _rsx_deriv_scale = float2(%.1f, %.1f);", sx, sy);
+    const size_t kl = sizeof RSX_FP_DERIV_SCALE_DECL - 1, len = strlen(hlsl);
+    if (rl <= 0 || (size_t)rl >= sizeof rep || len - kl + (size_t)rl + 1 > hlsl_size) return -1;
+    memmove(at + rl, at + kl, len - (size_t)(at - hlsl) - kl + 1);
+    memcpy(at, rep, (size_t)rl);
+    return 1;
+}
+
 static void fp_expand_helper(Out* out)
 {
     out_puts(out,
@@ -835,6 +851,7 @@ static int rsx_fp_decompile_internal(
     Out o = { out, out_size, 0, 1 };
     out[0] = '\0';
     int uses_pack = 0;   /* a pack or unpack opcode was decoded: the preamble gets its helpers */
+    int uses_deriv = 0;  /* patch 2143: DDX or DDY was decoded: the preamble declares _rsx_deriv_scale */
     out_puts(&o,
         /* 64 each: the source and destination register fields are 6 bits
          * (FP_SRC_REG_MASK / FP_OUT_REG_MASK). 48 rejected every program
@@ -1087,12 +1104,13 @@ static int rsx_fp_decompile_internal(
         case OP_MAX: snprintf(rhs, sizeof(rhs), "max((%s), (%s))", a, b); break;
         case OP_FRC: snprintf(rhs, sizeof(rhs), "frac(%s)", a); break;
         case OP_FLR: snprintf(rhs, sizeof(rhs), "floor(%s)", a); break;
-        /* Screen-space derivatives. God of War: Ascension's font is a distance
-         * field whose edge width is max(|ddx|, |ddy|) of the sampled value; as
-         * an unhandled op the destination kept 0 and every glyph bloated. */
-        case OP_DDX: snprintf(rhs, sizeof(rhs), "ddx(%s)", a); break;
-        case OP_DDY: snprintf(rhs, sizeof(rhs), "ddy(%s)", a); break;
         case OP_RCP: snprintf(rhs, sizeof(rhs), "(1.0 / (%s).x)", a); break;
+        /* patch 2143 (the Killzone 2 port, patch 2096): screen-space derivatives. Unhandled, they wrote nothing, so the
+         * destination kept 0 and a program dividing by fwidth (Killzone 2's anti-aliased menu panels) produced NaN,
+         * which the export guard turns into a transparent 0. _rsx_deriv_scale is (1, 1) in the decompiler's text; the
+         * live draw rewrites it per pipeline for the target's sample grid (rsx_fp_set_deriv_scale). */
+        case OP_DDX: uses_deriv = 1; snprintf(rhs, sizeof(rhs), "(ddx(%s) * _rsx_deriv_scale.x)", a); break;
+        case OP_DDY: uses_deriv = 1; snprintf(rhs, sizeof(rhs), "(ddy(%s) * _rsx_deriv_scale.y)", a); break;
         /* Pack/unpack (RPCS3 FragmentProgramDecompiler PK/UP cases and the pkg/upg
          * builtins): the packed word is a scalar that replicates. */
         case OP_PK4UB: uses_pack = 1; snprintf(rhs, sizeof(rhs), "asfloat(_rsx_pk4ub(%s))", a); break;
@@ -1522,6 +1540,7 @@ static int rsx_fp_decompile_internal(
      * decompiler skipped, leaving the destination with whatever it held.
      * Only for a program that uses one, so every other program's text is
      * unchanged. */
+    if (uses_deriv) out_puts(&p, RSX_FP_DERIV_SCALE_DECL "\n");   /* patch 2143 */
     if (uses_pack) out_puts(&p,
         "uint   _rsx_pk4ub(float4 v) { uint4 b = (uint4)round(saturate(v) * 255.0); return b.x | (b.y << 8) | (b.z << 16) | (b.w << 24); }\n"
         "float4 _rsx_up4ub(float v) { uint u = asuint(v); return float4(u & 255u, (u >> 8) & 255u, (u >> 16) & 255u, (u >> 24) & 255u) / 255.0; }\n"
