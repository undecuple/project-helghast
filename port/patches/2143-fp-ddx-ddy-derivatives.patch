diff --git a/libs/video/rsx_live_draw.c b/libs/video/rsx_live_draw.c
index ace06cd..54bc17f 100644
--- a/libs/video/rsx_live_draw.c
+++ b/libs/video/rsx_live_draw.c
@@ -8591,6 +8591,20 @@ static int ld_wpos_aa_on(void)
     }
     return on;
 }
+/* patch 2143 (the Killzone 2 port, patch 2096): DDX / DDY in pixels of the RSX's window. An antialiased target is kept at
+ * its sample resolution (patch 2088), so a D3D derivative spans one sample where the RSX's spans one pixel: scale by the
+ * samples per pixel. The sample grid is already in every pipeline key, so no key changes. ASSUMPTION: the sign of DDY
+ * follows the window y as on the RSX; the Killzone 2 panels take |DDX| + |DDY| so their picture does not depend on it,
+ * and this port does not handle the bottom-origin shader window (the Killzone 2 port keys a DDY flip for it). */
+static int ld_deriv_scale_apply(char* hlsl, size_t size, u32 wpos_aa)
+{
+    const u32 ax = wpos_aa & 0xFFu, ay = (wpos_aa >> 8) & 0xFFu;
+    const float sx = ax > 1u ? (float)ax : 1.0f, sy = ay > 1u ? (float)ay : 1.0f;
+    const int r = rsx_fp_set_deriv_scale(hlsl, (u32)size, sx, sy);
+    static u32 logs;
+    if (r > 0 && logs++ < 8) fprintf(stderr, "[fp-deriv] program with DDX/DDY: scale (%.0f, %.0f)\n", sx, sy);
+    return r;
+}
 static int ld_wpos_aa_apply(char* hlsl, size_t size, u32 wpos_aa)
 {
     const u32 ax = wpos_aa & 0xFFu, ay = (wpos_aa >> 8) & 0xFFu;
@@ -8692,6 +8706,8 @@ static void ld_xlate(const ld_xl_in* in, char* vs_hlsl, size_t vs_sz, char* ps_h
         fi = -1;
     if (fi > 0 && in->wpos_aa && ld_wpos_aa_apply(ps_hlsl, ps_sz, in->wpos_aa) < 0)   /* patch 2088 */
         fi = -1;
+    if (fi > 0 && ld_deriv_scale_apply(ps_hlsl, ps_sz, in->wpos_aa) < 0)   /* patch 2143 */
+        fi = -1;
     if (fi > 0 && srgb_out && rsx_fp_apply_srgb_output(ps_hlsl, ps_sz) < 0) {   /* patch 2055 */
         static int said; if (!said++) fprintf(stderr, "[srgb-out] apply failed: PSO left linear\n");
     }
