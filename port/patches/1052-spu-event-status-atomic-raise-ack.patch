diff --git a/runtime/spu/spu_context.h b/runtime/spu/spu_context.h
index 4df1a8fc..a38ae59b 100644
--- a/runtime/spu/spu_context.h
+++ b/runtime/spu/spu_context.h
@@ -454,6 +454,38 @@ typedef struct spu_context {
 #define SPU_EVENT_SET(c, b)   __atomic_fetch_or(&(c)->event_status, (uint32_t)(b), __ATOMIC_SEQ_CST)
 #define SPU_EVENT_CLEAR(c, b) __atomic_fetch_and(&(c)->event_status, ~(uint32_t)(b), __ATOMIC_SEQ_CST)
 #endif
+/* KZ3 patch 1052: event_status is written by more than one host thread: the
+ * SPU's own thread raises SN (list stall), the tag event and LR (its own
+ * reservation poll) and acknowledges, while a PEER thread raises LR from
+ * spu_coherency.c under the lock-line lock. The own-thread writers did a bare
+ * read-modify-write outside that lock, so a peer's |= LR landing between the
+ * read and the write-back erased the other bit (and vice versa). Losing SN
+ * leaves a list DMA parked at a stall-and-notify element with no interrupt to
+ * resume it: event_status == 0x400 with the tag never completing, the KZ3 level
+ * stall of rounds 32-35. Every raise and ack is one atomic RMW; readers load
+ * with acquire so a raise published before spu_ch_wake is seen by the waiter.
+ * KZ3_SPU_RACE_OLD=1 restores the pre-1052 bare read-modify-writes (and the
+ * registry / ready-count writes below) for A/B runs only. */
+static inline int spu_race_old(void)
+{
+    static int s = -1;   /* per TU; read once */
+    if (s < 0) { const char* e = getenv("KZ3_SPU_RACE_OLD"); s = (e && *e == '1') ? 1 : 0; }
+    return s;
+}
+static inline void spu_event_raise(spu_context* ctx, uint32_t bits)
+{
+    if (spu_race_old()) { volatile uint32_t* p = &ctx->event_status; *p |= bits; return; }
+    __atomic_fetch_or(&ctx->event_status, bits, __ATOMIC_SEQ_CST);
+}
+static inline void spu_event_ack(spu_context* ctx, uint32_t bits)
+{
+    if (spu_race_old()) { volatile uint32_t* p = &ctx->event_status; *p &= ~bits; return; }
+    __atomic_fetch_and(&ctx->event_status, ~bits, __ATOMIC_SEQ_CST);
+}
+static inline uint32_t spu_event_load(const spu_context* ctx)
+{
+    return __atomic_load_n(&ctx->event_status, __ATOMIC_ACQUIRE);
+}
 
 /* Reserved LS addresses (inside the kernel area, below the 0xA00 policy-module
