KZ3 patch 1139 (the same change as patch 6036 of the Killzone 2 port, Project Pyrrhus): lv2 sys_fs_open
(syscall 801) decodes the console's CELL_FS_O_* values. runtime/syscalls/sys_fs.h had its own hex set (O_CREAT 0x100,
O_EXCL 0x400, O_APPEND 0x2000) where the console, libs/filesystem/cellFs.h and runtime/ppu/ppu_fs.cpp have CREAT
0x40, EXCL 0x80, TRUNC 0x200, APPEND 0x400. KZ3's EBOOT calls syscall 801 itself (open wrapper func_00AC6864) with
fopen's words: 0x241 for "w" (TRUNC happened to agree), fopen "a" built from 0x400/0x40 was read as WRONLY|EXCL (no
create, writes at offset 0). One header, include/ps3emu/cell_fs_flags.h, now defines the flags for sys_fs.h, cellFs.h
and ppu_fs.cpp. sys_fs_open also answers O_CREAT|O_EXCL on an existing path with CELL_EEXIST and "w"/"a" without
O_CREAT on a missing file with CELL_ENOENT; its log lines show the flags word. Host test:
tools/upstream/test_sys_fs_flags.sh. Applies after 0004 and 1127 (both touch sys_fs.c). Local carry: upstream
sp00nznet/ps3recomp PR #620 (open) fixes the same values (CREAT 0000100, EXCL 0000200, TRUNC 0001000, APPEND
0002000) with EEXIST handling; drop this patch when #620 merges.

diff --git a/include/ps3emu/cell_fs_flags.h b/include/ps3emu/cell_fs_flags.h
new file mode 100644
index 0000000..a46186c
--- /dev/null
+++ b/include/ps3emu/cell_fs_flags.h
@@ -0,0 +1,31 @@
+/*
+ * cell_fs_flags.h -- the CELL_FS_O_* open flags, one definition for every
+ * filesystem path: the lv2 syscall (runtime/syscalls/sys_fs.c, sys_fs_open,
+ * syscall 801), the cellFs HLE in runtime/ppu/ppu_fs.cpp and the one in
+ * libs/filesystem/cellFs.c.
+ *
+ * These are the console's values (the SDK spells them in octal, as POSIX
+ * does). A guest passes the same word to cellFsOpen and to syscall 801: an
+ * EBOOT that links its C library's open() statically issues `sc` 801 itself
+ * with flags such as 0x241 (O_WRONLY|O_CREAT|O_TRUNC, fopen "w") or 0x441
+ * (O_WRONLY|O_CREAT|O_APPEND, fopen "a").
+ *
+ * sys_fs.h used to carry its own hex set (O_CREAT 0x100, O_EXCL 0x400,
+ * O_APPEND 0x2000), so sys_fs_open read 0x40 as nothing and 0x400 as O_EXCL:
+ * a create on the syscall path was missed and an append opened for write at
+ * offset 0. Keeping one header stops the three copies drifting apart again.
+ */
+#ifndef PS3EMU_CELL_FS_FLAGS_H
+#define PS3EMU_CELL_FS_FLAGS_H
+
+#define CELL_FS_O_RDONLY    000000
+#define CELL_FS_O_WRONLY    000001
+#define CELL_FS_O_RDWR      000002
+#define CELL_FS_O_ACCMODE   000003
+#define CELL_FS_O_CREAT     000100   /* 0x40 */
+#define CELL_FS_O_EXCL      000200   /* 0x80 */
+#define CELL_FS_O_TRUNC     001000   /* 0x200 */
+#define CELL_FS_O_APPEND    002000   /* 0x400 */
+#define CELL_FS_O_MSELF     010000   /* 0x1000 */
+
+#endif /* PS3EMU_CELL_FS_FLAGS_H */
