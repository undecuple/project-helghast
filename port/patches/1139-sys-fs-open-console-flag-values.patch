+          fprintf(stderr, "[sys_fs] open FAILED: %s (flags 0x%x, errno=%d %s, exists=%d, size=%lld)\n",
+                  host_path, (unsigned)flags, errno, strerror(errno), _ex, _ex?(long long)_s2.st_size:-1LL); }
         return (int64_t)(int32_t)CELL_ENOENT;
     }
 
@@ -536,7 +547,7 @@ int64_t sys_fs_open(ppu_context* ctx)
     f->active = 1;     /* published last */
     fs_slot_unlock();
 
-    fprintf(stderr, "[sys_fs] open OK: %s\n", host_path);
+    fprintf(stderr, "[sys_fs] open OK: %s (flags 0x%x, mode %s)\n", host_path, (unsigned)flags, mode);
 
