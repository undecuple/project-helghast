-#define CELL_FS_O_EXCL       0x0080   /* 000200 */
+/* Open flags: the PS3 SDK values (octal), from the one header the lv2
+ * syscall path (sys_fs.h) and libs/filesystem/cellFs.h share. The hex guesses
+ * that used to be here (O_CREAT 0x0200, O_TRUNC 0x0400, O_APPEND 0x0100) put
+ * the right numbers on the wrong names -- 0x200 and 0x400 are TRUNC and
+ * APPEND, not CREAT and TRUNC -- so a title opening a file with
+ * O_RDWR|O_CREAT (flags 0x42 = 000002 | 000100) hit an unnamed bit and got a
+ * plain read-only open; the file was never created. */
+#include "../../include/ps3emu/cell_fs_flags.h"
 #define CELL_FS_SEEK_SET     0
 #define CELL_FS_SEEK_CUR     1
 #define CELL_FS_SEEK_END     2
