+/* Radians per count from the user's sensitivity and the degrees-per-count base; a value that is not a finite
+ * positive number falls back to its default (*bad set to 1 when either did). */
+static inline float pad_mouse_rad_per_count(float user, float deg_per_count, int* bad)
+{
+    int b = 0;
+    if (!(user > 0.0f) || !isfinite(user)) { user = PAD_MOUSE_USER_SENS_DEF; b = 1; }
+    if (!(deg_per_count > 0.0f) || !isfinite(deg_per_count)) { deg_per_count = PAD_MOUSE_DEG_PER_COUNT; b = 1; }
+    if (bad) *bad = b;
+    return user * deg_per_count * 0.017453292519943295f;
+}
+
+/* The look accumulator (pure; pad_mouse.c holds one under its lock). frame = the guest frame counter now. */
+typedef struct {
+    long long dx, dy;      /* counts kept for the next take */
+    unsigned  add_frame;   /* frame of the last add */
+    unsigned  take_frame;  /* frame of the last take */
+    int       taken;       /* a take has happened */
+    long long dropped;     /* |dx|+|dy| dropped since the last take (stale counts of an idle stretch) */
+} PadLookAcc;
+
+static inline int pad_look_acc_idle(const PadLookAcc* a, unsigned frame)
+{
+    return !a->taken || (unsigned)(frame - a->take_frame) >= PAD_LOOK_IDLE_FRAMES;
+}
+/* Counts kept from an earlier frame while no consumer runs are stale: drop them. */
+static inline void pad_look_acc_age(PadLookAcc* a, unsigned frame)
+{
+    if (pad_look_acc_idle(a, frame) && a->add_frame != frame && (a->dx || a->dy)) {
+        a->dropped += (a->dx < 0 ? -a->dx : a->dx) + (a->dy < 0 ? -a->dy : a->dy);
+        a->dx = a->dy = 0;
+    }
+}
+static inline void pad_look_acc_add(PadLookAcc* a, int dx, int dy, unsigned frame)
+{
+    pad_look_acc_age(a, frame);
+    a->add_frame = frame;
+    a->dx += dx;
+    a->dy += dy;
+}
+/* Everything kept, once (cleared); *dropped = counts dropped since the previous take. */
+static inline void pad_look_acc_take(PadLookAcc* a, unsigned frame, int* dx, int* dy, long long* dropped)
+{
+    pad_look_acc_age(a, frame);
+    long long x = a->dx, y = a->dy;
+    if (x > 0x7FFFFFFF) x = 0x7FFFFFFF; else if (x < -0x7FFFFFFF) x = -0x7FFFFFFF;
+    if (y > 0x7FFFFFFF) y = 0x7FFFFFFF; else if (y < -0x7FFFFFFF) y = -0x7FFFFFFF;
+    *dx = (int)x;
+    *dy = (int)y;
+    if (dropped) *dropped = a->dropped;
+    a->dx = a->dy = 0;
+    a->dropped = 0;
+    a->take_frame = frame;
+    a->taken = 1;
+}
 
