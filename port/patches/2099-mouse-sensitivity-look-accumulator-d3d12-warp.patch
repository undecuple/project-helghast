+/* Radians per count from the user's sensitivity and the degrees-per-count base; a value that is not a finite
+ * positive number falls back to its default (*bad set to 1 when either did). */
+static inline float pad_mouse_rad_per_count(float user, float deg_per_count, int* bad)
+{
+    int b = 0;
+    if (!(user > 0.0f) || !isfinite(user)) { user = PAD_MOUSE_USER_SENS_DEF; b = 1; }
+    if (!(deg_per_count > 0.0f) || !isfinite(deg_per_count)) { deg_per_count = PAD_MOUSE_DEG_PER_COUNT; b = 1; }
+    if (bad) *bad = b;
+    return user * deg_per_count * 0.017453292519943295f;
