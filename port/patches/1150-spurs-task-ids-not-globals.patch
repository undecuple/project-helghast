+/* KZ3 patch 1150 (from the Killzone 2 port's patch 7004): the taskset and task id a dispatched task runs as are passed by the
+ * caller. They used to travel through the globals g_ydkj_real_taskset_ea / g_ydkj_real_taskid, which every dispatcher set
+ * just before calling here and which this function copied into the job. The task-exit scan (spu_taskset_task_exited) and
+ * spu_taskset_dispatch set them under the scan lock, but cellSpursCreateTask also writes them outside that lock on another
+ * PPU thread, so a CreateTask landing between a scan's write and this read handed the scan's job the new task's id: image A's
+ * code ran with task B's TaskInfo (args, context), its exit cleared task B's bits, and task A stayed enabled with nothing
+ * behind it. SPU_TASK_IDS_GLOBAL=1 restores the old hand-over (A/B only). */
+static int spu_task_ids_global(void)
+{ static int g = -1; if (g < 0) { const char* e = getenv("SPU_TASK_IDS_GLOBAL"); g = (e && e[0] == '1'); } return g; }
+
 int spu_workload_dispatch_async(const uint8_t* image, uint32_t image_size,
                                 uint32_t args_ea)
+{
+    /* Callers outside a taskset scan (cellSpurs' workload policy dispatch, sys_event's cri path) keep the globals: the last
+     * taskset and task the PPU created, which is what those paths were written for. */
+    extern uint32_t g_ydkj_real_taskset_ea, g_ydkj_real_taskid;
+    return spu_dispatch_async_ids(image, image_size, args_ea, g_ydkj_real_taskset_ea, g_ydkj_real_taskid);
+}
