      * tasks that made both run task 1's descriptor. */
-    { extern uint32_t g_ydkj_real_taskset_ea, g_ydkj_real_taskid;
+    j->taskset_ea = taskset_ea; j->taskid = taskid;   /* KZ3 patch 1150: the caller's ids, not the globals */
+    if (spu_task_ids_global()) { extern uint32_t g_ydkj_real_taskset_ea, g_ydkj_real_taskid;
