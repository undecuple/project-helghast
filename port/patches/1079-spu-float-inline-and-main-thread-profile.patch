+/* patch 1079: KZ3_PROF_FILTER is a '|'-separated list of substrings (e.g. "ppu-main|spurs-kern"); a thread is
+ * profiled when its name contains any of them. */
+static int prof_match(const char* name, const char* filter)
+{
+    for (const char* f = filter; *f;) {
+        const char* bar = strchr(f, '|');
+        const size_t n = bar ? (size_t)(bar - f) : strlen(f);
+        if (n) {
+            for (const char* p = name; *p; p++)
+                if (strncmp(p, f, n) == 0) return 1;
+        }
+        if (!bar) break;
+        f = bar + 1;
+    }
+    return 0;
+}
