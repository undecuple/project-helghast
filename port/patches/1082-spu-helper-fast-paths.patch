-#define SPU_XR_RET(m, r, a, b, op, imm) do { const unsigned _xm = (m); \
+/* KZ3 patch 1082 (SPU pass 65): the recompute is called with vector arguments. A u128 argument (a union of integer and
+ * float arrays) is passed in two general registers on SysV x86-64 and by a stack copy on Windows x64; the compiler
+ * built that argument on the inlined op's main path (result stored to the stack and reloaded into rdi/rsi before the
+ * branch: 4 instructions and a store-forward per float op, the RE notes Pass 64 s.4). __m128 arguments are already
+ * in xmm registers, so the main path keeps the result in a register; the conversion to u128 happens inside the cold
+ * function. Same lanes, same expressions (spu__xr_fix): bit-identical. */
+#if defined(__SSE2__)
+SPU_XR_COLD __m128 spu__xr_fixv(__m128 r, __m128 a, __m128 b, unsigned m, int op, int imm) {
+    u128 R, A, B; memcpy(&R, &r, 16); memcpy(&A, &a, 16); memcpy(&B, &b, 16);
+    R = spu__xr_fix(R, A, B, m, op, imm);
+    memcpy(&r, &R, 16); return r;
+}
+#  define SPU_XR_RET(m, r, a, b, op, imm) do { const unsigned _xm = (m); \
+    if (__builtin_expect(_xm != 0, 0)) { __m128 _xr, _xa, _xb; memcpy(&_xr, &(r), 16); memcpy(&_xa, &(a), 16); \
+        memcpy(&_xb, &(b), 16); _xr = spu__xr_fixv(_xr, _xa, _xb, _xm, op, imm); memcpy(&(r), &_xr, 16); } \
+    return r; } while (0)
+#else
+#  define SPU_XR_RET(m, r, a, b, op, imm) do { const unsigned _xm = (m); \
     if (__builtin_expect(_xm != 0, 0)) return spu__xr_fix(r, a, b, _xm, op, imm); return r; } while (0)
+#endif
 
