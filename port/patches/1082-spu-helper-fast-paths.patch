KZ3 patch 1082 (SPU pass 65): SPU helper fast paths, every result bit-identical.
1. Float ops: the exponent-255 recompute (spu__xr_fix) and the fma cold paths take __m128 arguments, so the
   inlined op keeps its result in a register (a u128 argument made the compiler store the result and reload it
   into two general registers on the main path; fma loaded its three operands as GPR pairs + pinsrq).
2. LS accessors: lifted functions that touch LS open with SPU_LS_LOCALS (LS base + one snapshot of the debug
   gates); the lifted source maps spu_ls_read128/write128 to the _l forms, so -fno-strict-aliasing stores no
   longer force reloads of g_spu_ls_probe, ctx->ls, g_spu_ls_watch_n, g_spu_smc_watch. Any armed (or not yet
   read, -1) gate sends the access through the unchanged full accessor.
3. shufb with ra == rb: spu_shufb1(a, c), one pshufb (7 vector ops instead of 11), emitted by the lifter.
Tests: tools/spu/test_spu_xr.sh, test_spu_fastcg.sh (shufb1 vs reference), test_spu_lift.py, test_job_diff.py.

Rebased on ps3recomp v0.18.0 (SPU pass 108): context only (upstream v0.18.0 changed lines around the hunks; same change).

diff --git a/runtime/spu/spu_context.h b/runtime/spu/spu_context.h
index 81ae1a25..53a95786 100644
--- a/runtime/spu/spu_context.h
+++ b/runtime/spu/spu_context.h
@@ -801,6 +801,54 @@ SPU_HOT void spu_ls_write128(spu_context* ctx, uint32_t lsa, u128 val)
         spu_ls_write_diag(ctx, lsa, val);
 }
 
+/* KZ3 patch 1082 (SPU pass 65): LS accessors with the context's LS base and the debug gates taken once per lifted
+ * function. The lifted code is built with -fno-strict-aliasing, so every store (each ctx->gpr[] write, each LS
+ * store) forces the next spu_ls_read128/write128 to reload g_spu_ls_probe, ctx->ls and g_spu_ls_watch_n (and the
+ * write's g_spu_smc_watch): ~5 instructions of every LS access in a hot loop (the RE notes Pass 64 s.4). The
+ * lifter (spu_lifter.py, emit_source) now opens every function that touches LS with SPU_LS_LOCALS, and the lifted
+ * source maps spu_ls_read128/write128 onto the _l forms below.
+ * Exactness: ctx->ls is set when the context is created (spu_context_init, spu_raw) and never changes while a lifted
+ * function runs. The gates only go from -1 (env not read yet) to their env value, inside the probes themselves; a
+ * snapshot taken while any gate is non-zero (including -1) sends every access of that function through the full
+ * accessor, which reads the live gates, so the env is still read on first use and every armed probe still fires.
+ * With all gates 0 they stay 0, and the full accessor's gated branches are all not-taken: the _l fast path below
+ * is that accessor with those branches removed. The WWS range probes (no gate: image 2 in policy mode, raw lsa
+ * 0xDF0..0xEAF on reads, 0x1320 on writes) stay on the fast path unchanged. */
+static inline int spu_ls_dbg_armed(void)
+{
+    return (g_spu_ls_probe | g_spu_ls_watch_n | g_spu_smc_watch) != 0;
+}
+#define SPU_LS_LOCALS                                                                                  \
+    uint8_t* const spu__ls = ctx->ls;                                                                  \
+    const int spu__lsdbg = spu_ls_dbg_armed();                                                         \
+    (void)spu__ls; (void)spu__lsdbg;
+SPU_HOT u128 spu_ls_read128_l(const spu_context* ctx, const uint8_t* ls, int dbg, uint32_t lsa)
+{
+    if (__builtin_expect(dbg, 0)) return spu_ls_read128(ctx, lsa);
+    if (__builtin_expect((uint32_t)(lsa - 0xDF0u) < 0xC0u && ctx->image_id == 2 && ctx->policy_mode, 0))
+        spu_ls_read_probe(ctx, lsa);
+    const uint8_t* p = ls + (lsa & (SPU_LS_MASK & ~0xFu));
+    u128 v;
+    uint32_t w0, w1, w2, w3;
+    memcpy(&w0, p,      4); memcpy(&w1, p + 4,  4);
+    memcpy(&w2, p + 8,  4); memcpy(&w3, p + 12, 4);
+    v._u32[0] = SPU_BSWAP32(w0); v._u32[1] = SPU_BSWAP32(w1);
+    v._u32[2] = SPU_BSWAP32(w2); v._u32[3] = SPU_BSWAP32(w3);
+    return v;
+}
+SPU_HOT void spu_ls_write128_l(spu_context* ctx, uint8_t* ls, int dbg, uint32_t lsa, u128 val)
+{
+    if (__builtin_expect(dbg, 0)) { spu_ls_write128(ctx, lsa, val); return; }
+    lsa &= SPU_LS_MASK & ~0xFu;
+    if (__builtin_expect(lsa == 0x1320, 0) && ctx->image_id == 2 && ctx->policy_mode)
+        spu_ls_write_probe_pre(ctx, lsa, val);
+    uint8_t* p = ls + lsa;
+    uint32_t w0 = SPU_BSWAP32(val._u32[0]), w1 = SPU_BSWAP32(val._u32[1]);
+    uint32_t w2 = SPU_BSWAP32(val._u32[2]), w3 = SPU_BSWAP32(val._u32[3]);
+    memcpy(p,      &w0, 4); memcpy(p + 4,  &w1, 4);
+    memcpy(p + 8,  &w2, 4); memcpy(p + 12, &w3, 4);
+}
+
