+static void ld_xess_output_size(u32 requested_w, u32 requested_h, u32* w, u32* h)
+{
+    const u32 max_w = g.width <= UINT32_MAX / 3u ? g.width * 3u : UINT32_MAX;
+    const u32 max_h = g.height <= UINT32_MAX / 3u ? g.height * 3u : UINT32_MAX;
