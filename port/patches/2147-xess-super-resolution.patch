+        u32 output_w, output_h;
+        ld_xess_output_size((u32)output.w, (u32)output.h, &output_w, &output_h);
+        if (!ld_xess_pick_camera(&camera) ||
+            !(camera.flags & KZ3_XESS_CAMERA_PLANES_VALID) ||
+            (camera.flags & KZ3_XESS_CAMERA_MULTIPLE_VIEWS) ||
+            output_w < g.width || output_h < g.height ||
+            (output_w == g.width && output_h == g.height)) {
+            return 0;
