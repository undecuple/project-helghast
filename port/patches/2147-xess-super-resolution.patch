+/* may_flush: 0 from a draw, where a flush would lose this draw's recorded state. Nothing of XeSS is in the open list at
+ * the first scene draw of a frame, so the fence is enough there. The present path may hold this frame's captures. */
+static int ld_xess_ensure_context(u32 output_w, u32 output_h, int may_flush)
+{
+    const int changed =
+        g_xess_context_w != output_w || g_xess_context_h != output_h;
+    if (kz3_xess_would_recreate(
+            g.dev, g.width, g.height, output_w, output_h)) {
+        if (may_flush) {
+            ld_flush(LD_FLUSH_RETIRE_QUEUE);
+            if (!g.ready) return 0;
+        } else {
+            ld_wait_fence(g.fence_value);
+        }
+    }
+    if (!kz3_xess_initialize(
+            g.dev, g.width, g.height, output_w, output_h)) {
+        g_xess_context_w = g_xess_context_h = 0;
+        return 0;
+    }
+    if (changed) {
+        g_xess_context_w = output_w;
+        g_xess_context_h = output_h;
+        g_xess_context_generation++;
+        g_xess_depth_frame = UINT32_MAX;
