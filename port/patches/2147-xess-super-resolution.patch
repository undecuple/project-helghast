+/* KZ3_XESS_MIP_BIAS: the scene's extra LOD bias in mip levels, one run. Unset = Intel's log2(input / target); 0 = none. */
+static int ld_xess_mip_bias_now(u32 output_w)
+{
+    const char* e = getenv("KZ3_XESS_MIP_BIAS");
+    if (e && *e) return (int)lroundf((float)atof(e) * 256.0f);
+    return kz3_xess_mip_bias_fp(g.width, output_w);
