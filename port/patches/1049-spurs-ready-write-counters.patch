+/* KZ3 patch 1049: one line per kernel thread of every live instance: "k0:w5/12ms k1:-" (wid in a run and its
+ * elapsed ms, or "-" idle); for the audio diagnostics (patch 1050: what SPURS was doing when a mix block was empty). */
+int kz3_spurs_runs_brief(char* buf, int n)
+{
+    int o = 0; u64 now = GetTickCount64();
+    for (int j = 0; j < MAX_SPURS_INST && o < n - 24; j++) {
+        if (!s_inst[j].ea) continue;
+        for (int kt = 0; kt < KZ3_KT_MAX && kt < s_inst[j].nthreads && o < n - 24; kt++) {
+            u64 t0 = s_run_t0[j][kt];
+            if (t0) o += snprintf(buf + o, (size_t)(n - o), "%sk%d:w%u/%llums", o ? " " : "", kt, s_run_wid[j][kt],
+                                  (unsigned long long)kz3_spurs_elapsed_ms(now, t0));
+            else o += snprintf(buf + o, (size_t)(n - o), "%sk%d:-", o ? " " : "", kt);
+        }
+    }
+    if (!o && n) buf[0] = 0;
+    return o;
+}
