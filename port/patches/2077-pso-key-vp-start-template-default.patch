+/* KZ3 patch 2077: the leader scan's walk (vp_decompile_impl), flow only. */
+int rsx_vp_has_flow(const u8* ucode, u32 max_bytes)
+{
+    u32 o = 0; int k = 0;
+    while (o + 16 <= max_bytes && k < RSX_VP_MAX_INSTR) {
+        const u32 e1 = rd_le(ucode + o + 4), e3 = rd_le(ucode + o + 12);
+        if (vp_is_flow((e1 >> 27) & 0x1F)) return 1;
+        k++; o += 16;
+        if (e3 & 1u) break;
+    }
+    return 0;
+}
+
+u64 rsx_vp_key_branch_base(u64 key, const u8* ucode, u32 max_bytes,
+                           u32 start_slot)
+{
+    if (!rsx_vp_has_flow(ucode, max_bytes)) return key;
+    const u32 w[2] = { 0x31534256u /* "VBS1" */, start_slot };
+    const u8* p = (const u8*)w;
+    for (u32 i = 0; i < (u32)sizeof w; i++) { key ^= p[i]; key *= 1099511628211ull; }
+    return key;
+}
