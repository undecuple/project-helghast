+/* Patch 2077: the template a release ships (installer/pso-template.bin -> pso-template.bin), used when LD_PSO_TEMPLATE
+ * is unset: next to the exe, else one folder up (the release keeps the exe in build\ and the template in the install
+ * root, tools/release/assemble_payload.py TEMPLATE_DEST). NULL when neither file exists. */
+static const char* ld_pt_default_path(char* buf, size_t n)
+{
+    char dir[1024];
+    const DWORD len = GetModuleFileNameA(NULL, dir, (DWORD)sizeof dir);
+    if (len == 0 || len >= sizeof dir) return NULL;
+    char* slash = NULL;
+    for (char* p = dir; *p; p++) if (*p == '\\' || *p == '/') slash = p;
+    if (!slash) return NULL;
+    *slash = 0;
+    static const char* const rel[2] = { "\\pso-template.bin", "\\..\\pso-template.bin" };
+    for (int k = 0; k < 2; k++) {
+        if (snprintf(buf, n, "%s%s", dir, rel[k]) >= (int)n) return NULL;
+        const DWORD a = GetFileAttributesA(buf);
+        if (a != INVALID_FILE_ATTRIBUTES && !(a & FILE_ATTRIBUTE_DIRECTORY)) return buf;
+    }
+    return NULL;
+}
