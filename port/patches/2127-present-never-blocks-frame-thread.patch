-static UINT ld_swap_flags(void) { return g_ld_tearing_ok ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING : 0; }
+/* KZ3 patch 2127 (RSX pass 120): Present never holds the frame thread. That thread also ticks the guest's vblanks and
+ * drains the FIFO (port/kz3/main.cpp frame_clock), so a blocking Present stopped the guest's clock of frames: under
+ * Proton on a desktop machine, a window the compositor does not show (another screen focused, minimised, sometimes the
+ * pause menu) blocked each Present for ~1 s (logs 20261028-193340 / -193925: "[pump] gap ~1000 ms", one flip per pass,
+ * fps 1.0), and on return the backlog of vblanks ran as a burst. The swap chain now has a frame-latency waitable
+ * object (maximum latency 2); a Present whose slot is not free within LD_PRESENT_WAIT_MS (default 16 = one vblank
+ * tick) is skipped (the guest frame is not shown; the guest, its vblanks and its audio run on). LD_PRESENT_WAIT_MS=-1
+ * = the old blocking Present. "[present] skipped" lines count the skips. */
+static HANDLE g_ld_latency_ev;
+static int ld_present_wait_ms(void)
+{
+    static int ms = -2;
+    if (ms == -2) {
+        const char* e = getenv("LD_PRESENT_WAIT_MS");
+        ms = e && *e ? atoi(e) : 16;
+        if (ms < -1) ms = -1;
+        fprintf(stderr, "[present] %s (LD_PRESENT_WAIT_MS=%d, patch 2127)\n",
+                ms < 0 ? "blocking Present (old path)" : "frame-latency wait, a Present never blocks longer", ms);
+    }
+    return ms;
+}
+static UINT ld_swap_flags(void)
+{
+    return (g_ld_tearing_ok ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING : 0) |
+           (ld_present_wait_ms() >= 0 ? DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT : 0);
+}
+/* 1 = present now; 0 = skip this one (no free slot within the wait). */
+static int ld_present_slot(void)
+{
+    static unsigned s_skip, s_skip_win, s_lines;
+    static ULONGLONG s_t0;
+    const int ms = ld_present_wait_ms();
+    if (ms < 0 || !g_ld_latency_ev) return 1;
+    if (WaitForSingleObject(g_ld_latency_ev, (DWORD)ms) == WAIT_OBJECT_0) {
+        if (s_skip_win) {
+            fprintf(stderr, "[present] presenting again after %u skipped (no free swap-chain slot; %u in all)\n", s_skip_win, s_skip);
+            s_skip_win = 0;
+        }
+        return 1;
+    }
+    s_skip++; s_skip_win++;
+    if (s_lines < 20 || GetTickCount64() - s_t0 > 10000) {
+        s_lines++; s_t0 = GetTickCount64();
+        fprintf(stderr, "[present] skipped: no free swap-chain slot within %d ms (%u in a row, %u in all)\n", ms, s_skip_win, s_skip);
+    }
+    return 0;
+}
 /* Present with the interval and flags the setting asks for; logs "[rsx] vsync ..." once and on each change. */
