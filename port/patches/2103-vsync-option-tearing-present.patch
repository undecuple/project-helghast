+/* patch 2103: VSync. The swap chain is created with DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING whenever the factory reports
+ * DXGI_FEATURE_PRESENT_ALLOW_TEARING (harmless with vsync on). ResizeBuffers must repeat the flag. */
+static int g_ld_vsync = 1;                    /* rsx_null_backend.c (window thread = present thread) */
+static int g_ld_tearing_ok;                   /* swap chain has the flag */
+static int g_ld_vsync_logged = -1;
+void rsx_live_draw_set_vsync(int on) { g_ld_vsync = on ? 1 : 0; }
+static UINT ld_swap_flags(void) { return g_ld_tearing_ok ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING : 0; }
+/* Present with the interval and flags the setting asks for; logs "[rsx] vsync ..." once and on each change. */
+static HRESULT ld_present_swap(void)
+{
+    static int s_env = -2;
+    unsigned tearing = 0, interval;
+    if (s_env == -2) {
+        const char* e = getenv("LD_PRESENT_INTERVAL");   /* patch 2007, diagnostic: wins */
+        s_env = (e && *e >= '0' && *e <= '4') ? *e - '0' : -1;
+    }
+    interval = rsx_dm_present_args(g_ld_vsync, g_ld_tearing_ok, g_dm_fs, s_env, &tearing);
+    if (g_ld_vsync_logged != (g_ld_vsync | (int)(tearing << 1) | (s_env >= 0 ? 4 : 0))) {
+        g_ld_vsync_logged = g_ld_vsync | (int)(tearing << 1) | (s_env >= 0 ? 4 : 0);
+        fprintf(stderr, "[rsx] vsync %s (%s%s)\n", rsx_dm_vsync_name(g_ld_vsync),
+                g_ld_tearing_ok ? "tearing allowed" : "tearing not supported",
+                s_env >= 0 ? ", LD_PRESENT_INTERVAL set: interval from the environment" :
+                g_dm_fs && !g_ld_vsync ? ", exclusive fullscreen: interval 0 without the flag" : "");
+    }
+    return g.swap->lpVtbl->Present(g.swap, interval, tearing ? DXGI_PRESENT_ALLOW_TEARING : 0);
+}
