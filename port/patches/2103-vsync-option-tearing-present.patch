+/* KZ3 patch 2103: VSync (ENHANCEMENT, display.ini "vsync = on|off", Options > Display > VSync; default on). The host present
+ * interval only: the guest's vblank / flip pacing stays at its fixed 60 Hz. */
+enum { RSX_DM_VSYNC_OFF = 0, RSX_DM_VSYNC_ON = 1 };
+static inline const char* rsx_dm_vsync_name(int v) { return v ? "on" : "off"; }
+static inline int rsx_dm_parse_vsync(const char* s)
+{
+    size_t n;
+    if (!rsx_dm_trim(&s, &n)) return -1;
+    if (rsx_dm_ieq(s, n, "on") || rsx_dm_ieq(s, n, "true") || rsx_dm_ieq(s, n, "yes") || rsx_dm_ieq(s, n, "1")) return RSX_DM_VSYNC_ON;
+    if (rsx_dm_ieq(s, n, "off") || rsx_dm_ieq(s, n, "false") || rsx_dm_ieq(s, n, "no") || rsx_dm_ieq(s, n, "0")) return RSX_DM_VSYNC_OFF;
+    return -1;
+}
+/* The Present arguments. env_interval = LD_PRESENT_INTERVAL (0..4, -1 unset; wins, no tearing flag, as before patch 2103).
+ * vsync on = interval 1. Off = interval 0, plus the tearing flag when the swap chain has it and is not in exclusive
+ * fullscreen (DXGI refuses the flag there). *tearing = 1 when the flag is set. */
+static inline unsigned rsx_dm_present_args(int vsync, int tearing_ok, int exclusive_fs, int env_interval, unsigned* tearing)
+{
+    *tearing = 0;
+    if (env_interval >= 0) return (unsigned)env_interval;
+    if (vsync) return 1;
+    *tearing = (tearing_ok && !exclusive_fs) ? 1u : 0u;
+    return 0;
+}
