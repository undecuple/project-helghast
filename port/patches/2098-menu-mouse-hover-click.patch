index 00000000..2576d441
--- /dev/null
+++ b/libs/input/pad_menu_mouse.h
@@ -0,0 +1,157 @@
+/* KZ3 patch 2098 (RSX pass 93), ENHANCEMENT: mouse hover and click in the game's GUM menus, on top of pad focus.
+ *
+ * Design data: the RE notes "Menu cursor, pass 143" (RE pass 142/143); the KZ3 glue that walks
+ * the guest's GUM tags and calls the game's own focus setter is port/kz3/main.cpp (kz3_menu_mouse_*), the window
+ * side (pointer position, clicks, cursor rule) is pad_mouse.c, the pad injection is cellPad.c. This header holds the
+ * pure parts (host test tools/smoke/test_menu_mouse.c):
+ *   - kz3_menu_hit_test: which focusable item is under the pointer (re-data's spec, section 5);
+ *   - PadMenuInject: clicks and wheel notches become pad buttons for exactly one delivered pad packet each, with one
+ *     released packet after every press (so two clicks are two edges and no button stays down);
+ *   - PadMenuHover: hover acts only when the pointer moved since the last look, and never while the pad is in use.
+ * Pad bits are hs->buttons' (cellPad.c): DIGITAL1 in bits 0-7, DIGITAL2 in bits 8-15. */
+#ifndef PAD_MENU_MOUSE_H
+#define PAD_MENU_MOUSE_H
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define PMM_UP     0x0010u
+#define PMM_RIGHT  0x0020u
+#define PMM_DOWN   0x0040u
+#define PMM_LEFT   0x0080u
+#define PMM_CIRCLE 0x2000u
+#define PMM_CROSS  0x4000u
+/* Pad input that means "the player is using the pad/keys for the menu": the d-pad, the face buttons, START/SELECT,
+ * L1/R1 (tab rows). While any is down, hover does nothing (the pad wins). */
+#define PMM_PAD_MENU_MASK 0xFCF9u
+
+typedef struct { int l, t, r, b; } KZ3MenuRect;
+#define KZ3_MENU_CLIPS 8
+typedef struct {
+    int id;
+    int l, t, r, b;                   /* inner rect (widget +0xE0.., 1.14 +0xF0..), layout pixels, r/b exclusive */
+    int depth;                        /* tree depth, root = 0 */
+    int n_clips;
+    KZ3MenuRect clip[KZ3_MENU_CLIPS]; /* ancestor rects the point must also be inside */
+    int enabled, focusable;
+} KZ3MenuCand;
+
+/* The candidate id under (x, y), or -1. A candidate hits when focusable && enabled, l-pad <= x < r+pad,
+ * t-pad <= y < b+pad, and the point is inside every clip (clip rects without pad). Among hits the largest depth wins
+ * (innermost), ties go to the later index (drawn last). No hit or n == 0: -1 (the caller keeps the focus). */
+static inline int kz3_menu_hit_test(const KZ3MenuCand* c, int n, float x, float y, int pad_px)
+{
+    int best = -1, bd = -1, i, k;
+    for (i = 0; i < n; i++) {
+        const KZ3MenuCand* q = &c[i];
+        int in = 1;
+        if (!q->focusable || !q->enabled || q->r <= q->l || q->b <= q->t) continue;
+        if (!(x >= (float)(q->l - pad_px) && x < (float)(q->r + pad_px) &&
+              y >= (float)(q->t - pad_px) && y < (float)(q->b + pad_px))) continue;
+        for (k = 0; k < q->n_clips && k < KZ3_MENU_CLIPS && in; k++) {
+            const KZ3MenuRect* r = &q->clip[k];
+            in = x >= (float)r->l && x < (float)r->r && y >= (float)r->t && y < (float)r->b;
+        }
+        if (!in) continue;
+        if (q->depth >= bd) { bd = q->depth; best = i; }
+    }
+    return best < 0 ? -1 : c[best].id;
+}
+
+/* Clicks and wheel notches -> pad presses. A press lasts until it was in at least one delivered packet AND the menu
+ * thread has started two frames since it began (pmi_tick, the per-frame Gum hook), so the game's per-frame input
+ * copy sees it once whatever the pad thread's polling rate (run r93-mc1: the pad is polled on its own guest thread; a
+ * one-packet press was never seen by the menu). The release lasts the same. A focus change made by the click itself
+ * (pmi_defer) holds the next press back for one menu frame, so the page has the new focus before the button arrives
+ * (re-data hook plan step 5). */
+#define PMI_QUEUE 8
+typedef struct {
+    unsigned q[PMI_QUEUE];
+    int head, n;
+    int phase;       /* 0 idle, 1 pressing (cur), 2 releasing */
+    unsigned cur;
+    int defer;       /* menu frames to wait before the next press starts */
+    int sent;        /* the current phase was in a delivered packet */
+    int ticks;       /* menu frames since the current phase began */
+} PadMenuInject;
+
+static inline void pmi_init(PadMenuInject* s) { s->head = s->n = 0; s->phase = 0; s->cur = 0; s->defer = 0; s->sent = 0; s->ticks = 0; }
+static inline int pmi_push(PadMenuInject* s, unsigned bits)
+{
+    if (!bits || s->n >= PMI_QUEUE) return 0;
+    s->q[(s->head + s->n) % PMI_QUEUE] = bits;
+    s->n++;
+    return 1;
+}
+static inline void pmi_defer(PadMenuInject* s) { s->defer = 1; }
+/* Bits for the packet being built now (idempotent until pmi_delivered). */
+static inline unsigned pmi_bits(PadMenuInject* s)
+{
+    if (s->phase == 0 && s->n && !s->defer) {
+        s->cur = s->q[s->head];
+        s->head = (s->head + 1) % PMI_QUEUE;
+        s->n--;
+        s->phase = 1;
+        s->sent = 0;
+        s->ticks = 0;
+    }
+    return s->phase == 1 ? s->cur : 0u;
+}
+/* The packet was handed to the game (len > 0) or not. */
+static inline void pmi_delivered(PadMenuInject* s, int delivered)
+{
+    if (delivered && s->phase) s->sent = 1;
+}
+/* One menu frame began (the menu thread's per-frame hook). */
+static inline void pmi_tick(PadMenuInject* s)
+{
+    if (s->phase == 0) { if (s->defer) s->defer = 0; return; }
+    s->ticks++;
+    if (!s->sent || s->ticks < 2) return;
+    if (s->phase == 1) { s->phase = 2; s->sent = 0; s->ticks = 0; return; }
+    s->phase = 0; s->cur = 0; s->sent = 0; s->ticks = 0;
+}
+/* Menu left (or a port overlay took the input): queued presses are dropped; a press in flight still gets its release. */
+static inline void pmi_clear(PadMenuInject* s)
+{
+    s->head = s->n = 0;
+    s->defer = 0;
+    if (s->phase == 1) { s->phase = 2; s->sent = 0; s->ticks = 0; }
+}
+static inline int pmi_idle(const PadMenuInject* s) { return s->phase == 0 && s->n == 0; }
+
+/* Hover gate: 1 when the pointer moved since the last call (seq changed), is on the image (valid) and the pad is not
+ * in use this poll. The new seq is taken either way, so a move made while the pad is used, or before the menu came
+ * up (pmh_sync), never refocuses later with the pointer still. */
+typedef struct { unsigned seq; int have; } PadMenuHover;
+static inline void pmh_sync(PadMenuHover* h, unsigned seq) { h->seq = seq; h->have = 1; }
+static inline int pmh_should_hover(PadMenuHover* h, unsigned seq, int valid, int pad_active)
+{
+    const int moved = h->have && seq != h->seq;
+    h->seq = seq;
+    h->have = 1;
+    return moved && valid && !pad_active;
+}
+
+/* Mouse events (pad_mouse.c queues them on the window's thread while a menu is up). */
+enum { PMM_EV_LEFT = 1, PMM_EV_RIGHT = 2, PMM_EV_WHEEL = 3 };
+typedef struct { int kind; int wheel; float x, y; int valid; } PadMenuMouseEv;
+
+/* Buttons for one event. hit = the item under the pointer (-1 none), value_item = the focused item is a select or a
+ * slider (wheel changes its value: LEFT/RIGHT; elsewhere UP/DOWN). Left click only acts on an item (CROSS on empty
+ * space would activate whatever has the focus); right click is CIRCLE (back) anywhere; wheel up = UP / RIGHT. */
+static inline unsigned pmm_event_bits(int kind, int wheel, int hit, int value_item)
+{
+    if (kind == PMM_EV_LEFT) return hit >= 0 ? PMM_CROSS : 0u;
+    if (kind == PMM_EV_RIGHT) return PMM_CIRCLE;
+    if (kind == PMM_EV_WHEEL && wheel) {
+        if (value_item) return wheel > 0 ? PMM_RIGHT : PMM_LEFT;
+        return wheel > 0 ? PMM_UP : PMM_DOWN;
+    }
+    return 0u;
+}
+
+#ifdef __cplusplus
+}
+#endif
+#endif
