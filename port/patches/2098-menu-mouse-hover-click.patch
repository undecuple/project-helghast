+/* Patch 2098 (RSX pass 93): the pointer in guest pixels, the ONE place it is kept (hover, and a later drawn cursor
+ * in the fps/watermark overlay path, read it). Written on the window's thread at WM_MOUSEMOVE through
+ * rsx_display_client_to_guest: valid = 0 over a letterbox bar or outside the client area; seq counts the moves. */
+typedef struct { float x, y; int valid; unsigned seq; } PadMouseGuest;
+extern volatile PadMouseGuest g_mouse_guest;
+
+/* KZ3_MENU_MOUSE_SCRIPT (tests, patch 2098): "T:m:X,Y" moves the pointer to client pixel X,Y, "T:l" left click,
+ * "T:r" right click, "T:w:N" N wheel notches (+ up); T = seconds since the first menu poll. The events are posted to
+ * the game window as WM_MOUSEMOVE / WM_LBUTTONDOWN+UP / WM_RBUTTONDOWN+UP / WM_MOUSEWHEEL, so they take the same
+ * path as a real mouse. */
+enum { PMS_MOVE = 1, PMS_LEFT = 2, PMS_RIGHT = 3, PMS_WHEEL = 4 };
+typedef struct { double t; int kind, a, b, done; } PadMenuScriptEv;
+#define PAD_MENU_SCRIPT_MAX 128
+static inline int pad_menu_script_parse(const char* s, PadMenuScriptEv* ev, int max, int* bad)
+{
+    int n = 0;
+    *bad = 0;
+    while (s && *s) {
+        char* e;
+        double t;
+        long a = 0, b = 0;
+        int kind = 0, ok;
+        while (*s == ' ' || *s == ';' || *s == '\t' || *s == '\n' || *s == '\r') s++;
+        if (!*s) break;
+        t = strtod(s, &e);
+        ok = e != s && *e == ':';
+        if (ok) {
+            s = e + 1;
+            if (*s == 'm' && s[1] == ':') {
+                kind = PMS_MOVE; s += 2; a = strtol(s, &e, 10); ok = e != s && *e == ',';
+                if (ok) { s = e + 1; b = strtol(s, &e, 10); ok = e != s; }
+            } else if ((*s == 'l' || *s == 'r') && (s[1] == 0 || s[1] == ' ' || s[1] == ';')) {
+                kind = *s == 'l' ? PMS_LEFT : PMS_RIGHT; e = (char*)s + 1;
+            } else if (*s == 'w' && s[1] == ':') {
+                kind = PMS_WHEEL; s += 2; a = strtol(s, &e, 10); ok = e != s && a != 0;
+            } else ok = 0;
+        }
+        if (ok && *e && *e != ' ' && *e != ';' && *e != '\t' && *e != '\n' && *e != '\r') ok = 0;
+        if (!ok) {
+            (*bad)++;
+            while (*s && *s != ' ' && *s != ';' && *s != '\t' && *s != '\n') s++;
+            continue;
+        }
+        if (n < max) { ev[n].t = t; ev[n].kind = kind; ev[n].a = (int)a; ev[n].b = (int)b; ev[n].done = 0; n++; }
+        else (*bad)++;
+        s = e;
+    }
+    return n;
+}
