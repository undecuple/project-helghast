+
+/* ---- Patch 2098 (RSX pass 93): menu mouse, window side ---------------------------------------------------------
+ * While a GUM menu is up (pad_mouse_menu_set(1) from the pad poll, port/kz3/main.cpp), the cursor is shown and free
+ * (pad_cursor_decide), left/right clicks and wheel notches are queued for the poll, and mouse-bound keys stop
+ * acting as pad buttons (cellPad.c pad_kb_down_win). WM_MOUSEMOVE keeps g_mouse_guest current at all times. */
+#include "pad_menu_mouse.h"
+#define PAD_MOUSE_WM_MENU (WM_APP + 0x6A)
+#define PMQ_MAX 16
+static volatile LONG   s_menu;          /* menu up (pad poll's view) */
+static PadMenuMouseEv  s_mq[PMQ_MAX];   /* under s_lock */
+static int             s_mq_n;
+static int             s_wheel_rest;    /* window thread: wheel delta below one notch */
+int (*g_pad_mouse_to_guest)(int cx, int cy, int* gx, int* gy) = NULL;   /* rsx_null_backend.c: rsx_display_client_to_guest */
+
+static void pm_guest_at(int cx, int cy)
+{
+    int gx = cx, gy = cy, ok = 1;
+    if (g_pad_mouse_to_guest) ok = g_pad_mouse_to_guest(cx, cy, &gx, &gy);
+    else if (s_hwnd) {
+        RECT rc;
+        GetClientRect(s_hwnd, &rc);
+        ok = cx >= 0 && cy >= 0 && cx < rc.right && cy < rc.bottom;
+    }
+    g_mouse_guest.x = (float)gx;
+    g_mouse_guest.y = (float)gy;
+    g_mouse_guest.valid = ok ? 1 : 0;
+    g_mouse_guest.seq = g_mouse_guest.seq + 1u;
+}
+
+static void pm_menu_queue(int kind, int wheel)
+{
+    PadMenuMouseEv ev;
+    ev.kind = kind; ev.wheel = wheel;
+    ev.x = g_mouse_guest.x; ev.y = g_mouse_guest.y; ev.valid = g_mouse_guest.valid;
+    PM_LOCK();
+    if (s_mq_n < PMQ_MAX) s_mq[s_mq_n++] = ev;
+    PM_UNLOCK();
+}
+
+/* Called from pad_mouse_wndmsg for the mouse messages (1 = handled, *res set). */
+static int pm_menu_wndmsg(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp, LRESULT* res)
+{
+    (void)hwnd;
+    switch (msg) {
+    case WM_MOUSEMOVE:
+        pm_guest_at((short)LOWORD(lp), (short)HIWORD(lp));
+        return 0;
+    case WM_LBUTTONDOWN:
+    case WM_RBUTTONDOWN:
+        pm_guest_at((short)LOWORD(lp), (short)HIWORD(lp));
+        if (s_menu) pm_menu_queue(msg == WM_LBUTTONDOWN ? PMM_EV_LEFT : PMM_EV_RIGHT, 0);
+        return 0;
+    case WM_MOUSEWHEEL:
+        if (s_menu) {
+            int d = s_wheel_rest + GET_WHEEL_DELTA_WPARAM(wp), n = d / WHEEL_DELTA;
+            s_wheel_rest = d - n * WHEEL_DELTA;
+            if (n) pm_menu_queue(PMM_EV_WHEEL, n);
+            *res = 0;
+            return 1;
+        }
+        s_wheel_rest = 0;
+        return 0;
+    case PAD_MOUSE_WM_MENU:
+        s_cs.menu = (int)wp;
+        pm_apply(hwnd, wp ? "menu up" : "menu gone");
+        *res = 0;
+        return 1;
+    }
+    return 0;
+}
+
+void pad_mouse_menu_set(int on)
+{
+    on = on ? 1 : 0;
+    if (InterlockedExchange(&s_menu, on) == on) return;
+    if (!on) { PM_LOCK(); s_mq_n = 0; PM_UNLOCK(); }
+    if (s_hwnd) PostMessageA(s_hwnd, PAD_MOUSE_WM_MENU, (WPARAM)on, 0);
+}
+int pad_mouse_menu_on(void) { return (int)s_menu; }
+
+int pad_mouse_menu_take(void* evs, int max)
+{
+    int n;
+    PM_LOCK();
+    n = s_mq_n < max ? s_mq_n : max;
+    memcpy(evs, s_mq, (size_t)n * sizeof(PadMenuMouseEv));
+    s_mq_n = 0;
+    PM_UNLOCK();
+    return n;
+}
+
+void pad_mouse_menu_script_step(double now)
+{
+    static int init = 0, n = 0;
+    static PadMenuScriptEv ev[PAD_MENU_SCRIPT_MAX];
+    static double t0 = -1.0;
+    static int cx, cy;   /* the last scripted move (client pixels): where the clicks land */
+    int i;
+    if (!init) {
+        const char* e = getenv("KZ3_MENU_MOUSE_SCRIPT");
+        int bad = 0;
+        init = 1;
+        if (e && *e) {
+            n = pad_menu_script_parse(e, ev, PAD_MENU_SCRIPT_MAX, &bad);
+            fprintf(stderr, "[menu-mouse] KZ3_MENU_MOUSE_SCRIPT: %d event(s)%s\n", n, bad ? " (some tokens not read)" : "");
+        }
+    }
+    if (!n || !s_hwnd) return;
+    if (t0 < 0.0) t0 = now;
+    for (i = 0; i < n; i++) {
+        PadMenuScriptEv* x = &ev[i];
+        if (x->done || now - t0 < x->t) continue;
+        x->done = 1;
+        if (x->kind == PMS_MOVE) { cx = x->a; cy = x->b; PostMessageA(s_hwnd, WM_MOUSEMOVE, 0, MAKELPARAM(cx, cy)); }
+        else if (x->kind == PMS_LEFT || x->kind == PMS_RIGHT) {
+            const LPARAM lp = MAKELPARAM(cx, cy);
+            PostMessageA(s_hwnd, x->kind == PMS_LEFT ? WM_LBUTTONDOWN : WM_RBUTTONDOWN, 0, lp);
+            PostMessageA(s_hwnd, x->kind == PMS_LEFT ? WM_LBUTTONUP : WM_RBUTTONUP, 0, lp);
+        } else if (x->kind == PMS_WHEEL)
+            PostMessageA(s_hwnd, WM_MOUSEWHEEL, MAKEWPARAM(0, (short)(x->a * WHEEL_DELTA)), 0);
+        fprintf(stderr, "[menu-mouse] script t=%.1f %s %d,%d\n", now - t0,
+                x->kind == PMS_MOVE ? "move" : x->kind == PMS_LEFT ? "left" : x->kind == PMS_RIGHT ? "right" : "wheel",
+                x->a, x->b);
+    }
+}
+#else
+void pad_mouse_menu_set(int on) { (void)on; }
+int  pad_mouse_menu_on(void) { return 0; }
+int  pad_mouse_menu_take(void* evs, int max) { (void)evs; (void)max; return 0; }
+void pad_mouse_menu_script_step(double now) { (void)now; }
 #endif
