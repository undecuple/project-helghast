+/* Presentation geometry shared by the renderer and inverse UI mapping.
+ * Coordinates describe the last successfully submitted presentation, not scanout.
+ * No Win32 types: synthetic host tests exercise the mapping and copy policy. */
+#ifndef RSX_PRESENT_GEOMETRY_H
+#define RSX_PRESENT_GEOMETRY_H
+#include <stdint.h>
+#include <math.h>
+
+typedef struct { int x, y, w, h; } rsx_pg_rect;
+/* Restricted direct-UI ownership propagates through proven whole transfers.
+ * Unknown partial/blur/composite paths retain explicit inference, which must
+ * not be mistaken for a transform captured at the visible HUD draw boundary. */
+enum { RSX_PG_HUD_UNKNOWN = 0, RSX_PG_HUD_GLOBAL_INFERENCE = 1, RSX_PG_HUD_MOVIE_PIXELS = 2,
+       RSX_PG_HUD_SURFACE_OWNER = 3, RSX_PG_HUD_MOVIE_OWNER = 4 };
+typedef struct {
+    int valid;
+    unsigned frame;
+    unsigned logical_w, logical_h, target_w, target_h;
+    rsx_pg_rect image;
+    float hud_kx, hud_ky;
+    int hud_provenance;
+    unsigned ui_surface, ui_state;
+    uint64_t ui_generation;
+} rsx_present_geometry;
+
+typedef struct {
+    uint64_t width;
+    unsigned dimension, height, depth, mips, format, samples, quality;
+} rsx_pg_resource;
+
+/* Strict compatibility is deliberately conservative. No fallback copy of a
+ * differently-sized/typed texture is permitted; scaling may recover later. */
+static inline int rsx_pg_copy_compatible(const rsx_pg_resource* a, const rsx_pg_resource* b)
+{
+    return a->dimension && a->width && a->height && a->depth && a->mips && a->samples &&
+           a->dimension == b->dimension && a->width == b->width && a->height == b->height &&
+           a->depth == b->depth && a->mips == b->mips && a->format == b->format &&
+           a->samples == b->samples && a->quality == b->quality;
+}
+
+/* Client pixel centres -> last submitted target -> image -> logical guest/UI.
+ * A negative image origin supports cropped Fill rectangles as well as Fit and
+ * Stretch. This does not introduce a Fill setting or an internal render scale. */
+static inline int rsx_pg_map(const rsx_present_geometry* p, int cw, int ch,
+                             int cx, int cy, int ui, int* gx, int* gy)
+{
+    *gx = *gy = 0;
+    if (!p->valid || !p->logical_w || !p->logical_h || !p->target_w || !p->target_h ||
+        p->image.w <= 0 || p->image.h <= 0 || cw <= 0 || ch <= 0 ||
+        !isfinite(p->hud_kx) || !isfinite(p->hud_ky) || p->hud_kx <= 0 || p->hud_ky <= 0)
+        return 0;
+    const double bx = ((double)cx + 0.5) * p->target_w / cw;
+    const double by = ((double)cy + 0.5) * p->target_h / ch;
+    const int inside = cx >= 0 && cy >= 0 && cx < cw && cy < ch &&
+        bx >= p->image.x && by >= p->image.y &&
+        bx < (double)p->image.x + p->image.w && by < (double)p->image.y + p->image.h;
+    double x = (bx - p->image.x) * p->logical_w / p->image.w;
+    double y = (by - p->image.y) * p->logical_h / p->image.h;
+    x = x < 0 ? 0 : x >= p->logical_w ? p->logical_w - 1 : x;
+    y = y < 0 ? 0 : y >= p->logical_h ? p->logical_h - 1 : y;
+    if (inside && ui) {
+        x = p->logical_w * 0.5 + (x - p->logical_w * 0.5) / p->hud_kx;
+        y = p->logical_h * 0.5 + (y - p->logical_h * 0.5) / p->hud_ky;
+    }
+    if (!isfinite(x) || !isfinite(y) || x < -2147483647.0 || x > 2147483647.0 ||
+        y < -2147483647.0 || y > 2147483647.0) return 0;
+    *gx = (int)floor(x); *gy = (int)floor(y);
+    return inside && x >= 0 && y >= 0 && x < p->logical_w && y < p->logical_h;
+}
