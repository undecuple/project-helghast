+    D3D12_RESOURCE_DESC d;
+    memset(&d, 0, sizeof d);
+    if (resource) resource->lpVtbl->GetDesc(resource, &d);
+    const rsx_pg_resource r = {d.Width, (unsigned)d.Dimension, d.Height,
+        d.DepthOrArraySize, d.MipLevels, (unsigned)d.Format, d.SampleDesc.Count, d.SampleDesc.Quality};
+    return r;
+}
+
+static int ld_pg_can_copy(ID3D12Resource* source, ID3D12Resource* target)
+{
