+/* The existing draw/present ownership remains unchanged. Pending geometry is
+ * local to each present call. Only the published snapshot is shared; input
+ * copies it under this small lock and never holds the lock while calling DXGI. */
+static SRWLOCK g_pg_lock = SRWLOCK_INIT;
+static rsx_present_geometry g_pg_submitted;
+
+int rsx_live_draw_get_present_geometry(rsx_present_geometry* out)
+{
+    if (!out) return 0;
+    AcquireSRWLockShared(&g_pg_lock);
+    *out = g_pg_submitted;
+    ReleaseSRWLockShared(&g_pg_lock);
+    return out->valid;
+}
+
+static void ld_pg_commit(const rsx_present_geometry* p)
+{
+    AcquireSRWLockExclusive(&g_pg_lock);
+    g_pg_submitted = *p;
+    ReleaseSRWLockExclusive(&g_pg_lock);
+}
