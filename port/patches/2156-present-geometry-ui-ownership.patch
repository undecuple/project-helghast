+/* Scheduled UI-transform ownership, independent of renderer profiling.
+ * A tag describes a consistent direct-UI transform since a known full clear
+ * or whole-image copy. It is not a GPU pixel-coverage/scanout assertion. */
+#ifndef RSX_UI_PROVENANCE_H
+#define RSX_UI_PROVENANCE_H
+#include <stdint.h>
+#include <math.h>
+
+enum { RSX_UI_UNKNOWN = 0, RSX_UI_EMPTY = 1, RSX_UI_KNOWN = 2, RSX_UI_MIXED = 3 };
+typedef struct {
+    uint64_t generation;
+    uint64_t applied_generation;
+    unsigned state, draw_frame;
+    float kx, ky;
+} rsx_ui_provenance;
+
+static inline int rsx_ui_factors_valid(float kx, float ky)
+{ return isfinite(kx) && isfinite(ky) && kx > 0 && ky > 0; }
+
+static inline void rsx_ui_unknown(rsx_ui_provenance* p)
+{
+    p->generation++;
+    if (!p->generation) p->generation = 1;
+    p->state = RSX_UI_UNKNOWN;
+    p->applied_generation = 0;
+    p->kx = p->ky = 1.0f;
+}
+
+/* A constant clear adds no UI transform. A partial clear preserves the
+ * transform of remaining UI pixels; a full clear establishes an empty base. */
+static inline void rsx_ui_clear(rsx_ui_provenance* p, int full)
+{
+    p->generation++;
+    if (!p->generation) { p->generation = 1; p->state = RSX_UI_UNKNOWN; p->applied_generation = 0; }
+    if (full) {
+        p->state = RSX_UI_EMPTY;
+        p->applied_generation = 0;
+        p->kx = p->ky = 1.0f;
+    }
+}
+
+/* Classification matches the existing HUD-squeeze eligibility even when the
+ * requested factor is unit (HUD169 off, fixed camera, or 16:9 output). */
+static inline int rsx_ui_direct_candidate(int display, int full_viewport, int is169,
+                                           int compose, int sampled_full_surface)
+{ return display && full_viewport && is169 && !compose && !sampled_full_surface; }
+
+/* Keep the squeeze classification unchanged. Ownership additionally requires
+ * that the mapped logical viewport covers the resource whose pixels we tag. */
+static inline int rsx_ui_owner_extent_matches(unsigned clip_w, unsigned clip_h,
+    unsigned surface_w, unsigned surface_h, unsigned view_w, unsigned view_h,
+    unsigned logical_w, unsigned logical_h)
+{
+    return clip_w && clip_h && view_w && view_h && clip_w == surface_w && clip_h == surface_h &&
+           view_w == logical_w && view_h == logical_h;
+}
+
+/* Call only for a recorded, unconditional, colour-enabled, nonempty draw.
+ * Unknown backgrounds/composites remain unknown; this never promotes unknown
+ * historical contents merely because a later direct UI draw was observed. */
+static inline void rsx_ui_direct(rsx_ui_provenance* p, float kx, float ky, unsigned frame)
+{
+    p->generation++;
+    if (!p->generation) { p->generation = 1; p->state = RSX_UI_UNKNOWN; }
+    if (!rsx_ui_factors_valid(kx, ky)) {
+        p->state = RSX_UI_UNKNOWN; p->applied_generation = 0; return;
+    }
+    p->applied_generation = p->generation;
+    p->draw_frame = frame;
+    if (p->state == RSX_UI_EMPTY) {
+        p->state = RSX_UI_KNOWN; p->kx = kx; p->ky = ky;
+    } else if (p->state == RSX_UI_KNOWN && (p->kx != kx || p->ky != ky)) {
+        p->state = RSX_UI_MIXED;
+    }
+}
+
+/* The destination's write has already invalidated/advanced its version.
+ * Full normalized-image transfers preserve UI coordinates. Partial copies,
+ * crop, translation and arbitrary shader composites require richer lineage. */
+static inline void rsx_ui_inherit(rsx_ui_provenance* dst, const rsx_ui_provenance* src, int whole)
+{
+    if (!whole || !dst->generation) return;
+    if (!src->generation || (src->state == RSX_UI_KNOWN &&
+        (!src->applied_generation || src->applied_generation > src->generation ||
+         !rsx_ui_factors_valid(src->kx, src->ky)))) return;
+    const uint64_t version = dst->generation;
+    *dst = *src;
+    dst->generation = version;
+    /* A source's direct-write generation is not a destination version. */
+    dst->applied_generation = src->state == RSX_UI_KNOWN ? version : 0;
+}
+
+static inline int rsx_ui_read(const rsx_ui_provenance* p, float* kx, float* ky)
+{
+    if (!p->generation || !p->applied_generation || p->applied_generation > p->generation ||
+        p->state != RSX_UI_KNOWN || !rsx_ui_factors_valid(p->kx, p->ky)) return 0;
+    *kx = p->kx; *ky = p->ky; return 1;
+}
+#endif
