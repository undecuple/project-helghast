+/* Patch 2011: swizzled 3D textures interleave x, y and z bits in that order
+ * while each axis still has bits left (the 2D order extended by one axis).
+ * ASSUMPTION: from the 2D layout; KZ3's one 3D texture (pass 11 capture) is
+ * linear, so this path is untested against real data. */
+static u32 morton_index3(u32 x, u32 y, u32 z, u32 lw, u32 lh, u32 ld)
+{
+    u32 idx = 0, shift = 0;
+    while (lw || lh || ld) {
+        if (lw) { idx |= (x & 1) << shift; x >>= 1; shift++; lw--; }
+        if (lh) { idx |= (y & 1) << shift; y >>= 1; shift++; lh--; }
+        if (ld) { idx |= (z & 1) << shift; z >>= 1; shift++; ld--; }
+    }
+    return idx;
