+/* Patch 2011: TEXTURE_FORMAT dimension 3. KZ3's first level binds one
+ * A8R8G8B8 linear 3D texture in the final 1280x720 composite (pass 11
+ * capture, draw 576 unit 3; ASSUMPTION: colour-grading LUT). Before this it
+ * decoded to nothing and the unit read SRV_WHITE. Uncompressed formats only,
+ * base level only; slices are `pitch * height` apart (linear) or 3D-swizzled. */
+static ID3D12Resource* decode_guest_texture_3d(const rsx_dsp_texture* t, u32 remap,
+                                               u32 base_fmt, int linear)
+{
+    const u32 w = t->width, h = t->height, d = t->depth ? t->depth : 1;
+    u32 texel_size;
+    switch (base_fmt) {
+    case TEX_FMT_B8: texel_size = 1; break;
+    case TEX_FMT_A4R4G4B4:
+    case TEX_FMT_A1R5G5B5:
+    case TEX_FMT_R5G6B5:
+    case TEX_FMT_G8B8: texel_size = 2; break;
+    case TEX_FMT_A8R8G8B8: texel_size = 4; break;
+    case RSX_TEX_FMT_W16Z16Y16X16_FLOAT: texel_size = 8; break;
+    default: return NULL;
+    }
+    if (!linear && ((w & (w - 1)) || (h & (h - 1)) || (d & (d - 1)))) return NULL;
+    const u32 span = texture_source_span(t);
+    const u8* src = span ? guest_ptr(t->location, t->offset, span) : NULL;
+    if (!src) return NULL;
+    const u32 pitch = (linear && t->pitch) ? t->pitch : w * texel_size;
+    u8* rgba = (u8*)malloc((size_t)w * h * d * 4);
+    if (!rgba) return NULL;
+    const u32 lw = log2_u32(w), lh = log2_u32(h), ld = log2_u32(d);
+    for (u32 z = 0; z < d; z++)
