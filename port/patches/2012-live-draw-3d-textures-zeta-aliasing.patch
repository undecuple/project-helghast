+/*
+ * Patch 2011: textures that read a zeta buffer (Killzone 3's first level,
+ * pass 11 RPCS3 capture). live-draw binds its R32_FLOAT depth snapshot for
+ * them; these post-passes turn the generic Sample call into what the RSX
+ * texture unit returns for that format.
+ *
+ * Shadow compare (DEPTH16 / DEPTH16_FLOAT, and DEPTH24_D8 if a caller asks):
+ * the RSX compares texcoord.z (TXP: z / w) against the stored depth with the
+ * TEXTURE_ADDRESS zfunc and returns the (filtered) pass fraction in all four
+ * channels. RPCS3 (VKDraw.cpp, read for reference) enables the compare for
+ * every depth format and reverses the function (zfunc GEQUAL -> LESS_OR_EQUAL).
+ * The call becomes SampleCmpLevelZero with SamplerComparisonState
+ * rsx_cmpF at register s(16 + F), F = RSX zfunc; live-draw's root signature
+ * carries the eight static comparison samplers (linear, clamp).
+ * ASSUMPTION: no LOD / bias on shadow lookups (level 0); unnormalised shadow
+ * coordinates are not scaled.
+ */
+static char* fp_match_paren(char* open)
+{
+    int depth = 0;
+    for (char* p = open; *p; p++) {
+        if (*p == '(') depth++;
+        else if (*p == ')') { depth--; if (!depth) return p; }
+    }
+    return NULL;
+}
+
+/* Copy [b, e) to dst (size n). */
+static void fp_copy_span(char* dst, u32 n, const char* b, const char* e)
+{
+    u32 len = (u32)(e - b);
+    if (len >= n) len = n - 1;
+    memcpy(dst, b, len);
+    dst[len] = '\0';
+}
+
+int rsx_fp_apply_shadow_compare(char* hlsl, u32 hlsl_size, u32 shadow_mask,
+                                const u8 zfunc[16])
+{
+    if (!hlsl || !shadow_mask) return 0;
+    int patched = 0;
+    u32 used_funcs = 0;
+    for (u32 u = 0; u < 16; u++) {
+        if (!((shadow_mask >> u) & 1u)) continue;
+        const u32 f = zfunc[u] & 7u;
+        char needles[2][24];
+        snprintf(needles[0], sizeof needles[0], "rsx_tex[%u].", u);
+        snprintf(needles[1], sizeof needles[1], "rsx_tex%u.", u);
+        for (int nidx = 0; nidx < 2; nidx++) {
+            for (;;) {
+                char* at = strstr(hlsl, needles[nidx]);
+                if (!at) break;
+                char* open = strchr(at, '(');
+                char* close = open ? fp_match_paren(open) : NULL;
+                if (!close) return -1;
+                /* Arguments: sampler, coordinate[, bias/lod]. */
+                char* args[3] = { open + 1, NULL, NULL };
+                char* ends[3] = { close, close, close };
+                int na = 1, depth = 0;
+                for (char* q = open + 1; q < close; q++) {
+                    if (*q == '(') depth++;
+                    else if (*q == ')') depth--;
+                    else if (*q == ',' && depth == 0 && na < 3) {
+                        ends[na - 1] = q;
+                        args[na++] = q + 1;
+                    }
+                }
+                if (na < 2) return -1;
+                char coord[640], ref[640];
+                fp_copy_span(coord, sizeof coord, args[1], ends[1]);
+                /* Reference: the coordinate with its top-level .xy -> .z. */
+                strcpy(ref, coord);
+                int found = 0;
+                depth = 0;
+                for (char* q = ref; *q; q++) {
+                    if (*q == '(') depth++;
+                    else if (*q == ')') depth--;
+                    else if (depth == 0 && q[0] == '.' && q[1] == 'x' && q[2] == 'y' &&
+                             !(q[3] >= 'a' && q[3] <= 'z')) {
+                        q[1] = 'z';
+                        memmove(q + 2, q + 3, strlen(q + 3) + 1);
+                        found = 1;
+                        break;
+                    }
+                }
+                if (!found) snprintf(ref, sizeof ref, "(%s).z", coord);
+                char repl[1500];
+                snprintf(repl, sizeof repl, "%s%u%s.SampleCmpLevelZero(rsx_cmp%u, %s, %s)",
+                         nidx == 0 ? "rsx_TEX[" : "rsx_TEX", u, nidx == 0 ? "]" : "",
+                         f, coord, ref);
+                const u32 rlen = (u32)strlen(repl), olen = (u32)(close + 1 - at);
+                const u32 used = (u32)strlen(hlsl);
+                if (used - olen + rlen + 1 > hlsl_size) return -1;
+                memmove(at + rlen, close + 1, used - (u32)(close + 1 - hlsl) + 1);
+                memcpy(at, repl, rlen);
+                used_funcs |= 1u << f;
+                patched++;
+            }
+        }
+    }
+    for (char* q = hlsl; (q = strstr(q, "rsx_TEX")) != NULL; )
+        memcpy(q, "rsx_tex", 7);
+    if (patched) {
+        char* at = strstr(hlsl, "SamplerState rsx_samp[16] : register(s0);\n");
+        if (!at) return -1;
+        at += strlen("SamplerState rsx_samp[16] : register(s0);\n");
+        for (u32 f = 0; f < 8; f++) {
+            if (!((used_funcs >> f) & 1u)) continue;
+            char decl[80];
+            snprintf(decl, sizeof decl, "SamplerComparisonState rsx_cmp%u : register(s%u);\n",
+                     f, 16u + f);
+            if (fp_insert(hlsl, hlsl_size, at, decl) < 0) return -1;
+            at += strlen(decl);
+        }
+    }
+    return patched;
+}
