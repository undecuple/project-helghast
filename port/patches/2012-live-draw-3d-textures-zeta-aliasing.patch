+/*
+ * A8R8G8B8 read from a Z24S8 zeta (patch 2011): the game reinterprets the
+ * depth buffer's bytes. In guest memory a Z24S8 texel is the big-endian word
+ * depth24 << 8 | stencil, so as A8R8G8B8 it reads A = depth[23:16],
+ * R = depth[15:8], G = depth[7:0], B = stencil. The bound SRV is live-draw's
+ * R32_FLOAT snapshot, so the shader rebuilds the bytes from .x and applies
+ * the unit's remap (CONTROL1, the same encoding as live-draw's remap_comp).
+ * ASSUMPTION: stencil reads 0 (the snapshot has no stencil); the bytes come
+ * from the filtered depth, exact only with point sampling.
+ */
+int rsx_fp_apply_depth_argb(char* hlsl, u32 hlsl_size, u32 argb_mask,
+                            const u16 remap[16])
+{
+    if (!hlsl || !argb_mask) return 0;
+    int patched = 0;
+    char helpers[2048];
+    u32 hl = 0;
+    hl += (u32)snprintf(helpers + hl, sizeof helpers - hl,
+        "float4 rsx_zargb(float d) { uint z = (uint)round(saturate(d) * 16777215.0);\n"
+        "    return float4((z >> 16) & 0xFF, (z >> 8) & 0xFF, z & 0xFF, 0) / 255.0; }\n");
+    for (u32 u = 0; u < 16; u++) {
+        if (!((argb_mask >> u) & 1u)) continue;
+        /* s = (A, R, G, B) = .xyzw; output D3D r,g,b,a = remap comps 1,2,3,0. */
+        static const char* sel_txt[4] = { "s.x", "s.y", "s.z", "s.w" };
+        const char* c[4];
+        for (u32 comp = 0; comp < 4; comp++) {
+            const u32 op = (remap[u] >> (8 + comp * 2)) & 3u;
+            const u32 sel = (remap[u] >> (comp * 2)) & 3u;
+            c[comp] = op == 0 ? "0.0" : op == 1 ? "1.0" : sel_txt[sel];
+        }
+        hl += (u32)snprintf(helpers + hl, sizeof helpers - hl,
+            "float4 rsx_zargb%u(float4 t) { float4 s = rsx_zargb(t.x); return float4(%s, %s, %s, %s); }\n",
+            u, c[1], c[2], c[3], c[0]);
+        if (hl >= sizeof helpers) return -1;
+        char needles[2][24];
+        snprintf(needles[0], sizeof needles[0], "rsx_tex[%u].", u);
+        snprintf(needles[1], sizeof needles[1], "rsx_tex%u.", u);
+        char head[24];
+        snprintf(head, sizeof head, "rsx_zargb%u(", u);
+        for (int nidx = 0; nidx < 2; nidx++) {
+            for (;;) {
+                char* at = strstr(hlsl, needles[nidx]);
+                if (!at) break;
+                char* open = strchr(at, '(');
+                char* close = open ? fp_match_paren(open) : NULL;
+                if (!close) return -1;
+                if (fp_insert(hlsl, hlsl_size, close + 1, ")") < 0) return -1;
+                if (fp_insert(hlsl, hlsl_size, at, head) < 0) return -1;
+                memcpy(at + strlen(head), "rsx_TEX", 7);
+                patched++;
+            }
+        }
+    }
+    for (char* q = hlsl; (q = strstr(q, "rsx_TEX")) != NULL; )
+        memcpy(q, "rsx_tex", 7);
+    if (patched) {
+        char* at = strstr(hlsl, "SamplerState rsx_samp[16] : register(s0);\n");
+        if (!at) return -1;
+        at += strlen("SamplerState rsx_samp[16] : register(s0);\n");
+        if (fp_insert(hlsl, hlsl_size, at, helpers) < 0) return -1;
+    }
+    return patched;
+}
