+/* Patch 2053: device-local vertex/index rings. The walker writes vertices and indices into UPLOAD-heap rings
+ * (system memory); the GPU then fetched every vertex over PCIe (patch 2052's timestamps: the 700 position-only
+ * depth draws per frame of one PSO took 16 ms, 23 us each). Now each draw reads its vertex/index data from a
+ * DEFAULT-heap mirror (same offsets), and every submit first executes a small copy list that copies the byte
+ * range the list's draws used (min..max offset per list) from the upload ring into the mirror. A draw whose
+ * range does not fit the mirror (LD_VB_DEVICE_MB, default 128 / index 32) keeps reading the upload ring.
+ * Default OFF (LD_VB_DEVICE=1 enables): pass 55 measured the copy list costing as much as the draws saved. The mirrors sit in COMMON between lists; the copy list
+ * moves them COMMON -> COPY_DEST -> COMMON, draws promote them implicitly. */
+static int ld_vbd_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LD_VB_DEVICE"); on = e && e[0] == '1'; }   /* default off: pass 55 measured no gain */
+    return on;
+}
+static ID3D12Resource* ld_vbd_make(u64 bytes)
+{
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = bytes; bd.Height = 1; bd.DepthOrArraySize = 1;
+    bd.MipLevels = 1; bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    ID3D12Resource* r = NULL;
+    if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd, D3D12_RESOURCE_STATE_COMMON,
+                                                      NULL, &IID_ID3D12Resource, (void**)&r)))
+        return NULL;
+    return r;
+}
+/* Slot i (0/1) mirrors + copy allocator; called once per slot after the rings exist. */
+static int ld_vbd_slot_init(struct ld_frame_slot* f)
+{
+    static u32 vb_mb, ib_mb;
+    if (!vb_mb) {
+        const char* e = getenv("LD_VB_DEVICE_MB"); vb_mb = e ? (u32)atoi(e) : 128u; if (vb_mb < 4) vb_mb = 128;
+        if (vb_mb > VERT_BUFFER_SIZE / (1024u * 1024u)) vb_mb = VERT_BUFFER_SIZE / (1024u * 1024u);
+        ib_mb = vb_mb / 4u; if (ib_mb < 1) ib_mb = 1;
+        if (ib_mb > INDEX_BUFFER_SIZE / (1024u * 1024u)) ib_mb = INDEX_BUFFER_SIZE / (1024u * 1024u);
+        g.vbd_size = vb_mb * 1024u * 1024u; g.ibd_size = ib_mb * 1024u * 1024u;
+    }
+    f->vbd = ld_vbd_make(g.vbd_size); f->ibd = ld_vbd_make(g.ibd_size);
+    g.dev->lpVtbl->CreateCommandAllocator(g.dev, D3D12_COMMAND_LIST_TYPE_DIRECT, &IID_ID3D12CommandAllocator, (void**)&f->calloc);
+    return f->vbd && f->ibd && f->calloc;
+}
+static void ld_vbd_init(void)
+{
+    g.vbd = NULL; g.ibd = NULL; g.clist = NULL;
+    if (!ld_vbd_on()) return;
+    int ok = ld_vbd_slot_init(&g.fr[0]);
+    if (ok && g.fif_n > 1) ok = ld_vbd_slot_init(&g.fr[1]);
+    if (ok) {
+        g.dev->lpVtbl->CreateCommandList(g.dev, 0, D3D12_COMMAND_LIST_TYPE_DIRECT, g.fr[0].calloc, NULL,
+                                         &IID_ID3D12GraphicsCommandList, (void**)&g.clist);
+        if (g.clist) g.clist->lpVtbl->Close(g.clist); else ok = 0;
+    }
+    if (!ok) { fprintf(stderr, "[live-draw] device vertex rings failed; upload-heap vertex reads\n"); return; }
+    g.vbd = g.fr[g.fr_cur].vbd; g.ibd = g.fr[g.fr_cur].ibd; g.calloc = g.fr[g.fr_cur].calloc;
+    fprintf(stderr, "[live-draw] device vertex rings: vb %u MB, ib %u MB per frame slot\n", g.vbd_size >> 20, g.ibd_size >> 20);
+}
+/* Called by every submit before the draw list executes: copies the byte ranges the list's draws read. */
+static void ld_vbd_submit(void)
+{
+    if (!g.vbd) return;
+    const int vb = g.vb_hi > g.vb_lo, ib = g.ib_hi > g.ib_lo;
+    if (!vb && !ib) return;
+    g.clist->lpVtbl->Reset(g.clist, g.calloc, NULL);
+    ld_gt_copy_stamp(g.clist, 0);   /* patch 2052 timestamps */
+    g_gt.c_bytes += (double)(vb ? g.vb_hi - g.vb_lo : 0) + (double)(ib ? g.ib_hi - g.ib_lo : 0);
+    D3D12_RESOURCE_BARRIER b[2]; memset(b, 0, sizeof b);
+    u32 n = 0;
+    if (vb) { b[n].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION; b[n].Transition.pResource = g.vbd; b[n].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES; b[n].Transition.StateBefore = D3D12_RESOURCE_STATE_COMMON; b[n].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST; n++; }
+    if (ib) { b[n].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION; b[n].Transition.pResource = g.ibd; b[n].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES; b[n].Transition.StateBefore = D3D12_RESOURCE_STATE_COMMON; b[n].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST; n++; }
+    g.clist->lpVtbl->ResourceBarrier(g.clist, n, b);
+    if (vb) g.clist->lpVtbl->CopyBufferRegion(g.clist, g.vbd, g.vb_lo, g.vb, g.vb_lo, (u64)(g.vb_hi - g.vb_lo));
+    if (ib) g.clist->lpVtbl->CopyBufferRegion(g.clist, g.ibd, g.ib_lo, g.ib, g.ib_lo, (u64)(g.ib_hi - g.ib_lo));
+    for (u32 i = 0; i < n; i++) { D3D12_RESOURCE_STATES t = b[i].Transition.StateBefore; b[i].Transition.StateBefore = b[i].Transition.StateAfter; b[i].Transition.StateAfter = t; }
+    g.clist->lpVtbl->ResourceBarrier(g.clist, n, b);
+    ld_gt_copy_stamp(g.clist, 1);
+    g.clist->lpVtbl->Close(g.clist);
+    ID3D12CommandList* cl[] = {(ID3D12CommandList*)g.clist};
+    g.queue->lpVtbl->ExecuteCommandLists(g.queue, 1, cl);
+    g.vb_lo = g.vb_hi = g.ib_lo = g.ib_hi = 0;
+}
+/* Draw side: the vertex/index range [off, off+bytes) is read from the mirror when it fits. */
+static ID3D12Resource* ld_vbd_vb(u32 off, u64 bytes)
+{
+    if (!g.vbd || (u64)off + bytes > g.vbd_size) return g.vb;
+    if (g.vb_hi <= g.vb_lo) { g.vb_lo = off; g.vb_hi = off + (u32)bytes; }
+    else { if (off < g.vb_lo) g.vb_lo = off; if (off + (u32)bytes > g.vb_hi) g.vb_hi = off + (u32)bytes; }
+    return g.vbd;
+}
+static ID3D12Resource* ld_vbd_ib(u32 off, u64 bytes)
+{
+    if (!g.ibd || (u64)off + bytes > g.ibd_size) return g.ib;
+    if (g.ib_hi <= g.ib_lo) { g.ib_lo = off; g.ib_hi = off + (u32)bytes; }
+    else { if (off < g.ib_lo) g.ib_lo = off; if (off + (u32)bytes > g.ib_hi) g.ib_hi = off + (u32)bytes; }
+    return g.ibd;
+}
