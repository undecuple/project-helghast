diff --git a/libs/video/rsx_cb_reuse.h b/libs/video/rsx_cb_reuse.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_cb_reuse.h
@@ -0,0 +1,47 @@
+/* rsx_cb_reuse.h - reuse of the previous draw's vertex constant-buffer view (LD_CB_REUSE).
+ *
+ * Every live draw copies the 512 transform constants plus an 8-float tail (viewport transform) into a slot of the
+ * constant ring. When no constant changed since the draw that filled the previous slot and the tail is equal, the slot
+ * already holds exactly the bytes the shader would read, so the draw can point its root CBV at that slot and skip the
+ * copy. "No constant changed" is a generation counter that the transform-constant writers bump when a stored value
+ * changes (rsx_dispatch.c, the camera repair in rsx_live_draw.c), never a guess about a dirty range.
+ *
+ * Pure functions, no D3D12: used by rsx_live_draw.c and by the host test tools/smoke/test_ld_cb_reuse.sh.
+ */
+#ifndef RSX_CB_REUSE_H
+#define RSX_CB_REUSE_H
+
+#include <string.h>
+#include <stdint.h>
+
+#define LD_CBR_TAIL_MAX 64u
+
+typedef struct ld_cbr {
+    int      valid;
+    uint32_t off;                       /* ring offset of the slot filled by the last copying draw */
+    uint32_t gen;                       /* constant generation that slot holds */
+    uint32_t tail_n;
+    uint8_t  tail[LD_CBR_TAIL_MAX];
+} ld_cbr;
+
+static inline void ld_cbr_invalidate(ld_cbr* r) { r->valid = 0; }
+
+/* 1 = the slot at r->off still holds this draw's constants. cb_used is the ring offset this draw would write to:
+ * the old slot must lie fully below it (a ring wrap resets cb_used to 0 and so fails the test even if the caller
+ * forgot to invalidate). */
+static inline int ld_cbr_can_reuse(const ld_cbr* r, uint32_t cb_used, uint32_t block, uint32_t gen,
+                                   const void* tail, uint32_t tail_n)
+{
+    return r->valid && r->gen == gen && r->tail_n == tail_n && tail_n <= LD_CBR_TAIL_MAX &&
+           r->off + block <= cb_used && memcmp(r->tail, tail, tail_n) == 0;
+}
+
+/* Record the slot the draw has just filled. */
+static inline void ld_cbr_filled(ld_cbr* r, uint32_t off, uint32_t gen, const void* tail, uint32_t tail_n)
+{
+    if (tail_n > LD_CBR_TAIL_MAX) { r->valid = 0; return; }
+    r->valid = 1; r->off = off; r->gen = gen; r->tail_n = tail_n;
+    memcpy(r->tail, tail, tail_n);
+}
+
+#endif
