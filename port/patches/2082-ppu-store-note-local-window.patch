+/* KZ3 patch 2082: recompiled PPU stores into the RSX local window. The PPU runtime (ppu_loader.cpp) tests one
+ * byte per 64 KB guest page on every store (vm_write8..64 and the lifted inline stores) and calls this hook for
+ * the pages that carry its NOTE bit, which is set here on the local window once its address is known. Pass 75's
+ * LD_TEX_WATCH run named the writer of the location-0 texture misses: vm_write64 on a PPU thread (the 0x0FFxxxxx
+ * mip spans). Weak references: host tests link without the PPU runtime. LD_PPU_STORE_NOTE=0 leaves the bits clear
+ * (the old behaviour: PPU stores into local memory note nothing). */
+extern void ppu_set_store_note_hook(void (*hook)(uint32_t ea, uint32_t size)) __attribute__((weak));
+extern void ppu_store_note_pages(uint32_t ea, uint32_t size, int on) __attribute__((weak));
+static int s_ppu_note_tag;   /* LD_TEX_WRITER on: tag the notes "ppu-store" */
+static void gcm_ppu_note_pages_ea(uint32_t ea, uint32_t size)
+{
+    const u32 off = ea - s_config.localAddress;
+    if (off >= s_config.localSize) return;
+    if (size > s_config.localSize - off) size = s_config.localSize - off;
+    if (s_ppu_note_tag) rsx_live_draw_set_write_source(8u);
+    rsx_live_draw_note_guest_write_pages(0u, off, size);
+    if (s_ppu_note_tag) rsx_live_draw_set_write_source(0u);
+}
+void cellGcm_ppu_store_note_install(void)
+{
+    const char* e = getenv("LD_PPU_STORE_NOTE");
+    if ((e && e[0] == '0') || !ppu_set_store_note_hook || !ppu_store_note_pages || !s_config.localSize) return;
+    const char* w = getenv("LD_TEX_WRITER");
+    s_ppu_note_tag = (w && w[0] && w[0] != '0') ? 1 : 0;
+    ppu_set_store_note_hook(gcm_ppu_note_pages_ea);
+    ppu_store_note_pages(s_config.localAddress, s_config.localSize, 1);
+    printf("[cellGcmSys] PPU stores into local memory 0x%08X+0x%X mark texture pages (patch 2082)\n",
+           s_config.localAddress, s_config.localSize);
+}
 void cellGcm_note_guest_write_ea(u32 ea, u32 size)
 {
     if (!size || !rsx_live_draw_enabled()) return;
