+/* ---- KZ3 patch 2082 begin: store note gate (tools/smoke/test_ppu_store_note.sh compiles this block) ---- */
+/* KZ3 patch 2082: page bit NOTE of g_ppu_vm_page (defined with patch 1091 below) marks the pages whose PPU stores
+ * a host consumer must hear about (the RSX local window: the renderer's texture page bitmap). Tested after the
+ * store, so the consumer sees the note only once the bytes are in memory. Only the first byte's page is tested. */
+#define PPU_VM_PAGE_NOTE 0x10u
+extern "C" unsigned char g_ppu_vm_page[65536];
+extern "C" void ppu_store_note(uint32_t ea, uint32_t size);
+#define VM_STORE_NOTE(a, n)                                                                                       \
+    do {                                                                                                          \
+        if (__builtin_expect(__atomic_load_n(&g_ppu_vm_page[(uint32_t)(a) >> 16], __ATOMIC_RELAXED)                \
+                             & PPU_VM_PAGE_NOTE, 0))                                                              \
+            ppu_store_note((uint32_t)(a), (uint32_t)(n));                                                         \
+    } while (0)
+/* ---- KZ3 patch 2082 end ---- */
 
