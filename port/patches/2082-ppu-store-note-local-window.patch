+/* ---- KZ3 patch 2082 begin: store note hook ---- */
+/* KZ3 patch 2082: PPU stores into pages with the NOTE bit call a hook after the store (vm_write8..64 through
+ * VM_WRITE_COH; the lifted code's inline stores -- stvx, dcbz, stwbrx, sthbrx, stvebx/ehx/ewx -- through the same
+ * test in the ppu_lifter.py preamble). The renderer installs the hook and sets the bit on the RSX local window
+ * (cellGcmSys.c: recompiled PPU stores into local memory noted nothing, so the texture cache's clean-page skip had
+ * to leave location 0 out, RSX pass 75). Other pages pay one byte load and a not-taken branch per store. */
+static void (*volatile s_ppu_store_note_hook)(uint32_t ea, uint32_t size);
+extern "C" void ppu_set_store_note_hook(void (*hook)(uint32_t ea, uint32_t size)) { s_ppu_store_note_hook = hook; }
+extern "C" void ppu_store_note_pages(uint32_t ea, uint32_t size, int on)
+{
+    if (!size) return;
+    const uint64_t end = (uint64_t)ea + size - 1u;
+    for (uint64_t pg = ea >> 16; pg <= (end >> 16) && pg < 65536u; pg++) {
+        if (on) __atomic_or_fetch(&g_ppu_vm_page[pg], (unsigned char)PPU_VM_PAGE_NOTE, __ATOMIC_RELAXED);
+        else    __atomic_and_fetch(&g_ppu_vm_page[pg], (unsigned char)~PPU_VM_PAGE_NOTE, __ATOMIC_RELAXED);
+    }
+    __atomic_thread_fence(__ATOMIC_RELEASE);
+}
+extern "C" __attribute__((noinline)) void ppu_store_note(uint32_t ea, uint32_t size)
+{
+    void (*hook)(uint32_t, uint32_t) = s_ppu_store_note_hook;
+    if (hook) hook(ea, size);
+}
