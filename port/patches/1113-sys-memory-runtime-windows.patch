+/* Runtime-owned guest windows (KZ3 patch 1113): neither sys_mmapper_allocate_address nor sys_memory_allocate
+ * hands out any part of a registered window. reserve_window registers a fixed [base, base+size): CELL_OK (also for
+ * the same window again), CELL_EBUSY when it overlaps another window or a live mapper reservation / user allocation
+ * (register before guest code runs, or handle EBUSY), CELL_ENOMEM when the table (16) is full. alloc_window takes
+ * an unused aligned window from the mapper range (alignment 0 = 64 KiB), commits it like a mapper reservation and
+ * registers it; 0 on failure. reserve_window commits nothing: the caller vm_commit()s what it uses. Registrations
+ * survive sys_memory_init. */
+int sys_memory_reserve_window(uint32_t base, uint32_t size);
+uint32_t sys_memory_alloc_window(uint32_t size, uint32_t alignment);
+
 /* Registration */
 void sys_memory_init(lv2_syscall_table* tbl);
 
