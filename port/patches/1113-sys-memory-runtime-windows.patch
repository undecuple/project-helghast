KZ3 patch 1113 (SPU pass 97): runtime-owned guest windows the allocators skip. A library that keeps guest-visible
memory at an address of its own (KZ3 patch 5005's cellFont glyph pool, fixed 0xB8000000) sat inside v0.17.0's mapper
range 0x40000000-0xC0000000 and mapper_address()'s reserved[] list did not know it: a large enough title reservation
would have been handed the pool and both would write the same pages (latent: KZ3's reservations stay low). New
sys_memory_reserve_window(base, size) registers a fixed window (CELL_EBUSY instead of aliasing when a live reservation,
user allocation or other window already covers it) and sys_memory_alloc_window(size, align) carves a committed window
out of the mapper range for a library that needs no particular address; mapper_address() and user_address() skip every
registered window. 16 entries, kept across sys_memory_init like the image query. Host test:
tools/spu/test_r97_mapper_window.sh (104 checks; fails with the skip removed). Upstream candidate (general: a small
reservation hook for runtime/HLE-owned windows, next to the fixed VM_HLE_HEAP/VM_AUDIO/VM_SYS_VM/HLE_INJECT list).

--- a/runtime/syscalls/sys_memory.c
+++ b/runtime/syscalls/sys_memory.c
@@ -55,6 +55,25 @@
 static void bump_unlock(void) { pthread_mutex_unlock(&s_bump_mtx); }
 #endif
 
+/* Runtime-owned guest windows (KZ3 patch 1113). An HLE library that keeps guest-visible memory at an address it
+ * chose itself (a font glyph pool, a codec scratch area) registers the window here, and neither the mapper nor the
+ * user allocator hands any part of it to the title. sys_memory_alloc_window carves a window out of the mapper range
+ * for a library that needs no particular address. The table survives sys_memory_init, like the image query.
+ * Called with the allocator lock held: window_end(). */
+#define SYS_MEMORY_WINDOW_MAX 16
+static struct { uint32_t base, size; } s_windows[SYS_MEMORY_WINDOW_MAX];
+static int s_window_n;
+
+/* Greatest exclusive end of a registered window overlapping [addr, end), or `next` when none ends beyond it. */
+static uint64_t window_end(uint64_t addr, uint64_t end, uint64_t next)
+{
+    for (int i = 0; i < s_window_n; ++i) {
+        uint64_t wb = s_windows[i].base, we = wb + s_windows[i].size;
+        if (addr < we && wb < end && we > next) next = we;
+    }
+    return next;
+}
+
 static void write_be32(uint32_t addr, uint32_t val)
 {
     uint32_t* p = (uint32_t*)vm_to_host(addr);
@@ -96,6 +115,7 @@
             if (a->active && candidate < end && a->addr < candidate + size && end > next)
                 next = end;
         }
+        next = window_end(candidate, candidate + size, next);
         if (next == candidate) return (uint32_t)candidate;
         candidate = next;
     }
@@ -323,6 +343,7 @@
         for (size_t i = 0; i < sizeof(reserved) / sizeof(reserved[0]); ++i)
             if (addr < reserved[i][1] && reserved[i][0] < addr + size &&
                 reserved[i][1] > next) next = reserved[i][1];
+        next = window_end(addr, addr + size, next);
         if (next == addr) break;
         addr = (next + alignment - 1u) & ~(alignment - 1u);
     }
@@ -332,6 +353,42 @@
     return (uint32_t)addr;
 }
 
+int sys_memory_reserve_window(uint32_t base, uint32_t size)
+{
+    uint64_t end = (uint64_t)base + size;
+    if (!base || !size || end > 0x100000000ull) return (int)CELL_EINVAL;
+    int rc = CELL_OK;
+    bump_lock();
+    for (int i = 0; i < s_window_n && rc == CELL_OK; ++i) {
+        uint64_t wb = s_windows[i].base, we = wb + s_windows[i].size;
+        if (wb == base && we == end) { bump_unlock(); return CELL_OK; }   /* the same window again */
+        if (base < we && wb < end) rc = (int)CELL_EBUSY;
+    }
+    for (int i = 0; i < SYS_MEMORY_ALLOC_MAX && rc == CELL_OK; ++i) {
+        const mapper_reservation* r = &s_mapper_reservations[i];
+        if (r->start && base < r->end && r->start < end) rc = (int)CELL_EBUSY;
+        const sys_mem_alloc_info* a = &g_sys_mem_allocs[i];
+        if (a->active && base < (uint64_t)a->addr + a->size && a->addr < end) rc = (int)CELL_EBUSY;
+    }
+    if (rc == CELL_OK && s_window_n >= SYS_MEMORY_WINDOW_MAX) rc = (int)CELL_ENOMEM;
+    if (rc == CELL_OK) { s_windows[s_window_n].base = base; s_windows[s_window_n].size = size; s_window_n++; }
+    bump_unlock();
+    return rc;
+}
+
+uint32_t sys_memory_alloc_window(uint32_t size, uint32_t alignment)
+{
+    if (!alignment) alignment = 0x10000u;
+    if (!size || (alignment & (alignment - 1u))) return 0;
+    bump_lock();
+    uint32_t addr = s_window_n < SYS_MEMORY_WINDOW_MAX ? mapper_address(size, alignment) : 0;
+    if (addr) {
+        s_windows[s_window_n].base = addr; s_windows[s_window_n].size = s_mapper_bump_ptr - addr; s_window_n++;
+    }
+    bump_unlock();
+    return addr;
+}
+
 int64_t sys_mmapper_allocate_address(ppu_context* ctx)
 {
     uint64_t size = LV2_ARG_U64(ctx, 0);
