diff --git a/libs/video/rsx_pub.c b/libs/video/rsx_pub.c
new file mode 100644
index 00000000..1d14f2a2
--- /dev/null
+++ b/libs/video/rsx_pub.c
@@ -0,0 +1,324 @@
+/* KZ3 patch 2197: the ordered publisher P, inline on the walker thread R. See rsx_pub.h.
+ *
+ * Every walker-thread guest signal becomes a kzr_rec {seq, kind, ea, val, aux = stream offset} that is pushed into the kzr log (patch
+ * 2191) and retired in strict seq order on R: the store happens at retire, at the position and with the value the call site had. With
+ * RSX_PUB_LAG = 0 the log is empty at every call boundary; with a lag, P holds the newest N records, except barrier-class records (the
+ * walker re-reads their guest bytes itself: the control page, labels, ring and context words) which retire through themselves, and
+ * the pass end, which drains. Nothing here takes a lock (a kzr_pub_quiesce under s_gcm_fifo_lock would be an ABBA deadlock).
+ *
+ * Mutants for tools/smoke/test_pub_replay.sh and test_pub_locks.sh (each must make a named check fail): RSX_PUB_MUTANT_VAL (retire stores a
+ * wrong label word), _REC (the record truncates val), _NOBARRIER (barrier kinds are held like the rest), _NODRAIN (the pass end does not
+ * drain), _NOLAG (lag ignored), _OWNER (no owner check), _MOVIE (movie check never fires), _TOUCH (touch retires nothing), _LOCK (the movie
+ * check takes a lock through g_rsx_pub_mutant_lock: a lock-taking quiesce). */
+#include "rsx_pub.h"
+#include "rsx_guest_signal.h"
+#include "../kzr/core/sync/kzr_sync.h"
+#include <stdlib.h>
+#include <string.h>
+
+extern void vm_write32(uint32_t a, uint32_t v);
+
+void (*g_rsx_pub_trace)(uint64_t seq, unsigned kind, uint32_t ea, uint32_t val, uint32_t stream_off);
+int g_rsx_pub_mode;
+#ifdef RSX_PUB_MUTANT_LOCK
+void (*g_rsx_pub_mutant_lock)(void);
+#endif
+
+#define PUB_FLAG_STORE_W 1u   /* the retire stores a guest word */
+#define PUB_FLAG_STORE_H 2u   /* ... a big-endian word through a host pointer */
+#define PUB_FLAG_BARRIER 4u
+
+typedef struct { uint32_t kind, ea, val, aux; uintptr_t ptr; } pub_shadow;   /* what the direct path would have stored (verify) */
+typedef _Atomic unsigned long long cnt_t;
+typedef struct {
+    cnt_t rec, retired, stores, barriers, held_max, stalls, bad, empty_bad, owner_bad, refq_drop, rep, repcalc, touch, touch_ret, passes;
+} pub_cnt;
+
+static struct {
+    _Atomic int live; int env_done;           /* live/lag/owner: read by other threads (rsx_pub_check_owner, pass_begin) while R writes them */
+    _Atomic unsigned lag; uint32_t cap;
+    kzr_sync sync; kzr_pub pub; kzr_seq seq;
+    _Atomic uintptr_t owner;               /* kzr_thread_id of R; 0 = unbound */
+    uintptr_t* ptr; pub_shadow* sh;        /* per log slot (index = seq - 1 mod cap): the H-kind host pointer, the verify shadow */
+    const volatile uint32_t* stream;
+    uint32_t (*rd32)(uint32_t);
+    uint64_t tseq;                         /* the direct path's trace seq */
+    kzr_au64 begun, done;                  /* call counters: R is inside a call while begun != done (lock-free movie check) */
+    kzr_au32 pending;                      /* published by R after every push and retire */
+    pub_cnt c;
+} P;
+
+#define CADD(c, n) atomic_store_explicit(&(c), atomic_load_explicit(&(c), memory_order_relaxed) + (n), memory_order_relaxed)   /* single writer */
+#define CINC(c) atomic_fetch_add_explicit(&(c), 1ull, memory_order_relaxed)                                                  /* any thread */
+#define CGET(c) atomic_load_explicit(&(c), memory_order_relaxed)
+
+/* Kinds whose guest bytes the walker itself re-reads (ACQUIRE compares labels and semaphores, the pass start reads put, the ring
+ * recycle re-reads the JUMP and context words it wrote, the NV3089 source read can overlap a 308A store): they retire through
+ * themselves, which is the touch rule of C3 by construction. REPORT, NOTIFY and REF words are only read by the guest. */
+static int pub_kind_holds(unsigned kind)
+{
+    switch (kind) {
+    case RSX_GS_REPORT: case RSX_GS_NOTIFY: case RSX_GS_REF: case RSX_GS_REPORT_RB: return 1;
+    default: break;
+    }
+    const rsx_gs_info* i = rsx_gs_info_of(kind);
+    return !i || i->cls != 'W';   /* S and N records carry no store: nothing to read back, they may wait */
+}
+
+static uint32_t pub_stream_off(void) { return P.stream ? *P.stream : 0u; }
+
+static void pub_bad(const char* what, uint64_t seq, unsigned kind, uint32_t ea, uint32_t want, uint32_t got)
+{
+    const unsigned long long n = atomic_fetch_add_explicit(&P.c.bad, 1ull, memory_order_relaxed);
+    if (n < 16) fprintf(stderr, "[pub-bad] seq=%llu kind=%u ea=0x%08X want=0x%08X got=0x%08X (%s)\n", (unsigned long long)seq, kind, ea, want, got, what);
+}
+static void pub_viol(cnt_t* c, const char* what, unsigned long long pend)
+{
+    const unsigned long long n = atomic_fetch_add_explicit(c, 1ull, memory_order_relaxed);
+    if (n < 8) fprintf(stderr, "[pub-bad] %s (pending %llu)\n", what, pend);
+}
+
+static void pub_retire(void* ctx, const kzr_rec* r)
+{
+    (void)ctx;
+    const uint32_t slot = (uint32_t)((r->seq - 1u) % P.cap);
+    uint32_t val = r->val;
+#ifdef RSX_PUB_MUTANT_VAL
+    if (r->kind == RSX_GS_LABEL) val ^= 1u;
+#endif
+    if (r->flags & PUB_FLAG_STORE_W) { vm_write32(r->ea, val); CADD(P.c.stores, 1); }
+    else if (r->flags & PUB_FLAG_STORE_H) {
+        uint8_t* p = (uint8_t*)P.ptr[slot];
+        p[0] = (uint8_t)(val >> 24); p[1] = (uint8_t)(val >> 16); p[2] = (uint8_t)(val >> 8); p[3] = (uint8_t)val;
+        CADD(P.c.stores, 1);
+    }
+    if (g_rsx_pub_trace) g_rsx_pub_trace(r->seq, r->kind, r->ea, r->val, r->aux);
+    CADD(P.c.retired, 1);
+    if (g_rsx_pub_mode == RSX_PUB_VERIFY) {   /* the record against the shadow of the direct path, then the store against the shadow's value */
+        const pub_shadow* s = &P.sh[slot];
+        if (s->kind != r->kind) pub_bad("kind", r->seq, r->kind, r->ea, s->kind, r->kind);
+        else if (s->ea != r->ea) pub_bad("ea", r->seq, r->kind, s->ea, s->ea, r->ea);
+        else if (s->val != r->val) pub_bad("value", r->seq, r->kind, r->ea, s->val, r->val);
+        else if (s->aux != r->aux) pub_bad("stream offset", r->seq, r->kind, r->ea, s->aux, r->aux);
+        else if ((r->flags & PUB_FLAG_STORE_W) && P.rd32) {
+            const uint32_t got = P.rd32(r->ea);
+            if (got != s->val) pub_bad("guest word after the store", r->seq, r->kind, r->ea, s->val, got);
+        } else if (r->flags & PUB_FLAG_STORE_H) {
+            const uint8_t* p = (const uint8_t*)s->ptr;
+            const uint32_t got = ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+            if (got != s->val) pub_bad("report word after the store", r->seq, r->kind, r->ea, s->val, got);
+        }
+    }
+}
+
+static void pub_publish_pending(void)
+{
+    const uint32_t n = kzr_pub_pending(&P.pub);
+    atomic_store_explicit(&P.pending, n, memory_order_release);
+}
+
+int rsx_pub_configure(int mode, unsigned lag)
+{
+    rsx_pub_shutdown();
+    memset(&P.c, 0, sizeof P.c);
+    P.tseq = 0; P.owner = 0;
+    if (lag > RSX_PUB_LAG_MAX) lag = RSX_PUB_LAG_MAX;
+    P.lag = lag;
+#ifdef RSX_PUB_MUTANT_NOLAG
+    P.lag = 0;
+#endif
+    if (mode <= RSX_PUB_OFF) { g_rsx_pub_mode = RSX_PUB_OFF; return 0; }
+    P.cap = lag * 2u + 1024u;
+    P.ptr = (uintptr_t*)calloc(P.cap, sizeof *P.ptr);
+    P.sh = (pub_shadow*)calloc(P.cap, sizeof *P.sh);
+    if (!P.ptr || !P.sh) { free(P.ptr); free(P.sh); P.ptr = NULL; P.sh = NULL; return -1; }
+    kzr_sync_init(&P.sync, 0);
+    if (kzr_pub_init(&P.pub, &P.sync, P.cap, pub_retire, NULL)) { kzr_sync_destroy(&P.sync); free(P.ptr); free(P.sh); P.ptr = NULL; P.sh = NULL; return -1; }
+    kzr_seq_init(&P.seq);
+    atomic_store_explicit(&P.begun, 0, memory_order_relaxed); atomic_store_explicit(&P.done, 0, memory_order_relaxed);
+    atomic_store_explicit(&P.pending, 0, memory_order_relaxed);
+    P.live = 1;
+    g_rsx_pub_mode = mode;
+    return 0;
+}
+
+void rsx_pub_shutdown(void)
+{
+    g_rsx_pub_mode = RSX_PUB_OFF;
+    if (!P.live) return;
+    P.live = 0;
+    kzr_pub_destroy(&P.pub); kzr_sync_destroy(&P.sync);
+    free(P.ptr); free(P.sh); P.ptr = NULL; P.sh = NULL;
+}
+
+void rsx_pub_init_env(int force_off)
+{
+    if (P.env_done) return;
+    P.env_done = 1;
+    const char* e = getenv("RSX_PUB");
+    int bad = 0, mode = rsx_pub_mode_parse(e, &bad);
+    const char* l = getenv("RSX_PUB_LAG");
+    unsigned lag = l && *l ? (unsigned)strtoul(l, NULL, 0) : 0u;
+    if (bad) fprintf(stderr, "[pub] RSX_PUB=%s is not 0, 1 or verify: off\n", e);
+    if (mode && force_off) { fprintf(stderr, "[pub] RSX_PUB=%s ignored: GCM_GET_EQ_PUT=1 forces it off\n", e); mode = RSX_PUB_OFF; }
+    if (rsx_pub_configure(mode, lag)) { fprintf(stderr, "[pub] RSX_PUB: log allocation failed, off\n"); return; }
+    if (mode) fprintf(stderr, "[pub] RSX_PUB=%s: guest signals go through the ordered publisher inline on the walker (patch 2197)%s; lag=%u\n",
+                      mode == RSX_PUB_VERIFY ? "verify" : "1", mode == RSX_PUB_VERIFY ? ", every retire checked against a shadow" : "", P.lag);
+}
+
+int rsx_pub_mode(void) { return g_rsx_pub_mode; }
+unsigned rsx_pub_lag(void) { return P.lag; }
+void rsx_pub_set_stream_src(const volatile uint32_t* p) { P.stream = p; }
+void rsx_pub_set_reader(uint32_t (*rd32)(uint32_t)) { P.rd32 = rd32; }
+unsigned long rsx_pub_owner_tid(void) { return (unsigned long)P.owner; }
+unsigned rsx_pub_pending(void) { return atomic_load_explicit(&P.pending, memory_order_relaxed); }
+
+int rsx_pub_take(char cls, unsigned kind, uint32_t ea, uint32_t val, uint8_t* hp)
+{
+    if (!P.live || g_rsx_pub_mode == RSX_PUB_OFF) {   /* the direct path: the funnel stores; the trace hook sees the same tuple */
+        if (g_rsx_pub_trace) g_rsx_pub_trace(++P.tseq, kind, ea, val, pub_stream_off());
+        return 0;
+    }
+    const uintptr_t self = kzr_thread_id();
+#ifndef RSX_PUB_MUTANT_OWNER
+    if (P.owner != self) {
+        if (kzr_pub_pending(&P.pub) == 0) P.owner = self;   /* the walker thread changed between passes: nothing pending, rebind */
+        else {   /* C7: P belongs to R. Another thread in a walker pass while records are pending: store directly, as before the publisher */
+            pub_viol(&P.c.owner_bad, "P used from a thread that is not R with records pending", kzr_pub_pending(&P.pub));
+            return 0;
+        }
+    }
+#else
+    P.owner = self;
+#endif
+    atomic_store_explicit(&P.begun, atomic_load_explicit(&P.begun, memory_order_relaxed) + 1, memory_order_release);
+    if (!P.lag && kzr_pub_pending(&P.pub)) pub_viol(&P.c.empty_bad, "log not empty at a call boundary", kzr_pub_pending(&P.pub));
+
+    const uint64_t seq = kzr_seq_alloc(&P.seq);
+    const uint32_t slot = (uint32_t)((seq - 1u) % P.cap);
+    const uint32_t aux = pub_stream_off();
+    kzr_rec r; memset(&r, 0, sizeof r);
+    r.seq = seq; r.gate = KZR_GATE(KZR_GATE_READS, 0);   /* G_READS: with no worker, reads are done once R has resolved the record */
+    r.ea = ea; r.val = val; r.aux = aux; r.kind = (uint8_t)kind;
+    r.flags = cls == 'W' ? PUB_FLAG_STORE_W : cls == 'H' ? PUB_FLAG_STORE_H : 0u;
+    const int holds = pub_kind_holds(kind);
+#ifdef RSX_PUB_MUTANT_NOBARRIER
+    const int barrier = 0;
+#else
+    const int barrier = !holds;
+#endif
+    if (barrier) r.flags |= PUB_FLAG_BARRIER;
+#ifdef RSX_PUB_MUTANT_REC
+    r.val = val & 0xFFFFu;
+#endif
+    P.ptr[slot] = (uintptr_t)hp;
+    if (g_rsx_pub_mode == RSX_PUB_VERIFY) { pub_shadow* s = &P.sh[slot]; s->kind = kind; s->ea = ea; s->val = val; s->aux = aux; s->ptr = (uintptr_t)hp; }
+    kzr_sync_prep_publish(&P.sync, seq);   /* everything <= seq is resolved: the record is complete */
+    const unsigned long long st0 = P.pub.st.stalls;
+    kzr_pub_push(&P.pub, &r);
+    CADD(P.c.rec, 1);
+    if (P.pub.st.stalls != st0) CADD(P.c.stalls, P.pub.st.stalls - st0);
+    const unsigned pend = kzr_pub_pending(&P.pub);
+    if (pend > CGET(P.c.held_max)) atomic_store_explicit(&P.c.held_max, pend, memory_order_relaxed);
+    pub_publish_pending();
+    if (barrier) CADD(P.c.barriers, 1);
+    kzr_pub_retire_ready_upto(&P.pub, barrier ? seq : (seq > P.lag ? seq - P.lag : 0u));
+    pub_publish_pending();
+    atomic_store_explicit(&P.done, atomic_load_explicit(&P.begun, memory_order_relaxed), memory_order_release);
+    return cls == 'W' || cls == 'H';   /* S and N sites have no store to skip: the funnel does what it did (count, capture word) */
+}
+
+void rsx_pub_drain(void)
+{
+    if (!P.live) return;
+    kzr_pub_drain(&P.pub);
+    pub_publish_pending();
+}
+
+void rsx_pub_pass_begin(void)
+{
+    if (!P.live || g_rsx_pub_mode == RSX_PUB_OFF) return;
+    CADD(P.c.passes, 1);
+    const uintptr_t self = kzr_thread_id();
+    if (P.owner != self) {
+        if (kzr_pub_pending(&P.pub) == 0) P.owner = self;
+        else pub_viol(&P.c.owner_bad, "walker pass started on a thread that is not P's owner with records pending", kzr_pub_pending(&P.pub));
+    }
+    if (kzr_pub_pending(&P.pub)) pub_viol(&P.c.empty_bad, "log not empty at pass start", kzr_pub_pending(&P.pub));
+}
+
+void rsx_pub_pass_end(void)
+{
+    if (!P.live || g_rsx_pub_mode == RSX_PUB_OFF) return;
+    if (!P.lag && kzr_pub_pending(&P.pub)) pub_viol(&P.c.empty_bad, "log not empty at pass end", kzr_pub_pending(&P.pub));
+#ifndef RSX_PUB_MUTANT_NODRAIN
+    rsx_pub_drain();
+#endif
+    if (kzr_pub_pending(&P.pub)) pub_viol(&P.c.empty_bad, "log not empty after the pass-end drain", kzr_pub_pending(&P.pub));
+    {   /* C4: one rsx_live_draw_report_value call per answered GET_REPORT; a surplus call (it clears slot.rb and bumps counters) is a bug */
+        static unsigned long long seen;
+        const unsigned long long rep = CGET(P.c.rep), calc = CGET(P.c.repcalc);
+        if (calc != rep && calc + rep != seen) { seen = calc + rep; pub_bad("report value computed more than once (C4)", 0, RSX_GS_REPORT, 0, (uint32_t)rep, (uint32_t)calc); }
+    }
+}
+
+void rsx_pub_touch(uint32_t ea, uint32_t len)
+{
+    if (!P.live || !len || !kzr_pub_pending(&P.pub)) return;
+    CADD(P.c.touch, 1);
+    uint64_t last = 0;
+    const uint64_t e1 = (uint64_t)ea + len;
+    for (uint64_t i = P.pub.head; i != P.pub.tail; i++) {
+        const kzr_rec* r = &P.pub.log[i % P.pub.cap];
+        if (!(r->flags & PUB_FLAG_STORE_W)) continue;   /* only word stores are guest bytes at an EA; H and S carry no EA span here */
+        if ((uint64_t)r->ea < e1 && (uint64_t)r->ea + 4u > ea) last = r->seq;
+    }
+#ifdef RSX_PUB_MUTANT_TOUCH
+    last = 0;
+#endif
+    if (!last) return;
+    CADD(P.c.touch_ret, 1);
+    kzr_pub_retire_ready_upto(&P.pub, last);
+    pub_publish_pending();
+}
+
+int rsx_pub_movie_check(void)
+{
+    if (!P.live || g_rsx_pub_mode == RSX_PUB_OFF || P.lag) return 0;
+#ifdef RSX_PUB_MUTANT_LOCK
+    if (g_rsx_pub_mutant_lock) g_rsx_pub_mutant_lock();   /* a lock-taking quiesce: a lock the walker holds while it takes the one we hold */
+#endif
+#ifdef RSX_PUB_MUTANT_MOVIE
+    return 0;
+#endif
+    /* No call in flight (done == begun) before the read and none started after it (begun unchanged): pending is a leftover. */
+    const uint64_t d = atomic_load_explicit(&P.done, memory_order_acquire);
+    const uint64_t b1 = atomic_load_explicit(&P.begun, memory_order_acquire);
+    if (d != b1) return 0;
+    const uint32_t pend = atomic_load_explicit(&P.pending, memory_order_acquire);
+    const uint64_t b2 = atomic_load_explicit(&P.begun, memory_order_acquire);
+    if (b2 != b1 || !pend) return 0;
+    pub_viol(&P.c.empty_bad, "log not empty in set_movie_mode (a record outlived its call)", pend);
+    return 1;
+}
+
+void rsx_pub_check_owner(const char* where)
+{
+    if (!P.live || g_rsx_pub_mode == RSX_PUB_OFF) return;
+#ifdef RSX_PUB_MUTANT_OWNER
+    (void)where; return;
+#endif
+    if (atomic_load_explicit(&P.pending, memory_order_acquire) && P.owner && P.owner != kzr_thread_id())
+        pub_viol(&P.c.owner_bad, where, atomic_load_explicit(&P.pending, memory_order_relaxed));
+}
+
+void rsx_pub_note_refq_drop(void) { CINC(P.c.refq_drop); }
+void rsx_pub_note_report(int calc) { if (!P.live) return; /* default off: no atomic read-modify-write on the ZPASS path */ if (calc) CINC(P.c.repcalc); else CINC(P.c.rep); }
+
+void rsx_pub_stats_snapshot(rsx_pub_stats* o)
+{
+    o->rec = CGET(P.c.rec); o->retired = CGET(P.c.retired); o->stores = CGET(P.c.stores); o->barriers = CGET(P.c.barriers);
+    o->held_max = CGET(P.c.held_max); o->stalls = CGET(P.c.stalls); o->bad = CGET(P.c.bad); o->empty_bad = CGET(P.c.empty_bad);
+    o->owner_bad = CGET(P.c.owner_bad); o->refq_drop = CGET(P.c.refq_drop); o->rep = CGET(P.c.rep); o->repcalc = CGET(P.c.repcalc);
+    o->touch = CGET(P.c.touch); o->touch_ret = CGET(P.c.touch_ret); o->passes = CGET(P.c.passes);
+}
diff --git a/libs/video/rsx_pub.h b/libs/video/rsx_pub.h
new file mode 100644
index 00000000..977ee726
--- /dev/null
+++ b/libs/video/rsx_pub.h
@@ -0,0 +1,105 @@
+/* KZ3 patch 2197: the ordered publisher P,
+ * inline on the walker thread R. RSX_PUB=1 routes every walker-thread guest signal of rsx_guest_signal.h through a kzr record
+ * (kzr/core/sync, patch 2191) that P retires in strict seq order at today's position with today's value; RSX_PUB=verify also
+ * checks each retired record against a shadow of what the direct path would have stored ([pub-bad] on a difference). Unset or
+ * 0 = the funnel's direct path, unchanged. RSX_PUB_LAG=N holds N records before retiring (host shake / lag measurement only).
+ *
+ * Pure header (stdint/stdio/string only) so host tests include it without the runtime. The implementation is rsx_pub.c. */
+#ifndef RSX_PUB_H
+#define RSX_PUB_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <stddef.h>
+
+enum { RSX_PUB_OFF = 0, RSX_PUB_ON = 1, RSX_PUB_VERIFY = 2 };
+#define RSX_PUB_LAG_MAX 4096u
+
+/* RSX_PUB parsing: unset / "" / "0" = off, "1" = on, "verify" = verify; anything else = off (flagged in *bad so the caller can say so). */
+static inline int rsx_pub_mode_parse(const char* s, int* bad)
+{
+    if (bad) *bad = 0;
+    if (!s || !*s || (s[0] == '0' && !s[1])) return RSX_PUB_OFF;
+    if (s[0] == '1' && !s[1]) return RSX_PUB_ON;
+    if (!strcmp(s, "verify")) return RSX_PUB_VERIFY;
+    if (bad) *bad = 1;
+    return RSX_PUB_OFF;
+}
+
+/* Counters (single writer R unless noted). Other threads read them with relaxed atomic loads (rsx_pub_stats_snapshot). */
+typedef struct rsx_pub_stats {
+    unsigned long long rec;          /* records pushed by R */
+    unsigned long long retired;      /* records retired by P */
+    unsigned long long stores;       /* guest word / report stores P made (W and H kinds) */
+    unsigned long long barriers;     /* barrier-class records: retire through themselves (see pub_kind_holds in rsx_pub.c) */
+    unsigned long long held_max;     /* most records pending at once (gauge) */
+    unsigned long long stalls;       /* pushes that found the log full (kzr stall counter) */
+    unsigned long long bad;          /* [pub-bad] verify differences (any thread) */
+    unsigned long long empty_bad;    /* log not empty where the contract says it is: call boundary, pass end, movie mode (any thread) */
+    unsigned long long owner_bad;    /* P or the 2185 table used from a thread that is not R while records were pending (C7) */
+    unsigned long long refq_drop;    /* ref-queue overflow: the oldest fence was dropped, kept behaviour (any thread) */
+    unsigned long long rep;          /* GET_REPORT main-memory ZPASS answers computed at the walker */
+    unsigned long long repcalc;      /* rsx_live_draw_report_value calls for them: must equal rep (C4, computed once) */
+    unsigned long long touch;        /* rsx_pub_touch calls */
+    unsigned long long touch_ret;    /* ... that had a pending store to retire first */
+    unsigned long long passes;       /* walker passes that ran P */
+} rsx_pub_stats;
+
+/* host tests only: called for every walker-thread signal at its store (the retire with RSX_PUB!=0, the direct store with RSX_PUB=0) with
+ * (seq, kind, ea, val, stream_off); NULL = off. seq counts walker-thread signals from 1 in both modes. */
+extern void (*g_rsx_pub_trace)(uint64_t seq, unsigned kind, uint32_t ea, uint32_t val, uint32_t stream_off);
+extern int g_rsx_pub_mode;           /* RSX_PUB_OFF .. RSX_PUB_VERIFY; read by the funnel on every call */
+
+/* rsx_pub_init_env reads RSX_PUB and RSX_PUB_LAG once (later calls do nothing); force_off = GCM_GET_EQ_PUT (forced to 0).
+ * rsx_pub_configure is for host tests: (re)creates the log, 0 on success. */
+void rsx_pub_init_env(int force_off);
+int  rsx_pub_configure(int mode, unsigned lag);
+void rsx_pub_shutdown(void);
+int  rsx_pub_mode(void);
+unsigned rsx_pub_lag(void);
+/* The walker's stream position (s_fifo_getoff) for the record's stream_off, and a guest word reader for verify's read-back: both set by
+ * cellGcmSys.c, which owns the variable and the guest access; NULL = stream_off 0 / no read-back. */
+void rsx_pub_set_stream_src(const volatile uint32_t* p);
+void rsx_pub_set_reader(uint32_t (*rd32)(uint32_t ea));
+
+/* Called by the funnel for a walker-thread signal. cls = 'W','H','S','N' (rsx_gs_info). W: store val at ea. H: store val big-endian through
+ * hp (ea is only the capture tag). S: a bulk store the site makes itself (ea, val = n bytes). N: host-state effect (ea, val = a, b). Returns
+ * 1 when P made the store (the funnel must not), 0 when the funnel stores directly (RSX_PUB off; the trace hook, if any, was called). */
+int  rsx_pub_take(char cls, unsigned kind, uint32_t ea, uint32_t val, uint8_t* hp);
+
+/* Walker pass brackets (cellGcmSys.c): begin binds P's owner thread (R) and checks the boundary; end drains everything and asserts the
+ * log is empty. Both no-ops with RSX_PUB off. */
+void rsx_pub_pass_begin(void);
+void rsx_pub_pass_end(void);
+/* Retire every pending record (inline, on R). For events ordered after everything R recorded so far (a harness-injected renderer write;
+ * a quiesce serviced at pass end). Takes no lock. */
+void rsx_pub_drain(void);
+/* C3: a read of guest bytes [ea, ea+len) by R sees every pending P store to the span: retire up to the last overlapping one. */
+void rsx_pub_touch(uint32_t ea, uint32_t len);
+/* C7 / H7: the log is empty at a call boundary. Lock-free, callable from any thread (set_movie_mode runs on the host thread under
+ * g_ld_access_lock and must take no walker lock). Returns 1 and counts [pub-bad] when a record outlived its call. With RSX_PUB_LAG > 0
+ * records are legitimately pending between calls, so it checks nothing there. */
+int  rsx_pub_movie_check(void);
+/* C7: the 2185 pending-store table and P belong to R: count a use from another thread while records are pending. */
+void rsx_pub_check_owner(const char* where);
+unsigned long rsx_pub_owner_tid(void);   /* P's thread (kzr_thread_id of R), 0 before the first pass */
+
+void rsx_pub_note_refq_drop(void);       /* any thread */
+void rsx_pub_note_report(int calc);      /* calc = 0: one GET_REPORT answered (rep); 1: one value() call (repcalc) */
+void rsx_pub_stats_snapshot(rsx_pub_stats* out);
+unsigned rsx_pub_pending(void);          /* records pending now (any thread, relaxed) */
+
+/* `[pub] t=.. mode=on lag=N rec=.. ret=.. ...`: deltas of this second for the flow counters, absolute for the gauges and the violation counters. */
+static inline int rsx_pub_fmt(char* out, size_t n, double t, int mode, unsigned lag, const rsx_pub_stats* c, const rsx_pub_stats* p)
+{
+    return snprintf(out, n,
+        "[pub] t=%.0f mode=%s lag=%u rec=%llu ret=%llu store=%llu barr=%llu held_max=%llu stall=%llu bad=%llu empty_bad=%llu owner_bad=%llu "
+        "refq_drop=%llu rep=%llu repcalc=%llu touch=%llu/%llu passes=%llu",
+        t, mode == RSX_PUB_VERIFY ? "verify" : mode == RSX_PUB_ON ? "on" : "off", lag,
+        c->rec - p->rec, c->retired - p->retired, c->stores - p->stores, c->barriers - p->barriers, c->held_max, c->stalls - p->stalls,
+        c->bad, c->empty_bad, c->owner_bad, c->refq_drop - p->refq_drop, c->rep - p->rep, c->repcalc - p->repcalc,
+        c->touch_ret - p->touch_ret, c->touch - p->touch, c->passes - p->passes);
+}
+
+#endif
