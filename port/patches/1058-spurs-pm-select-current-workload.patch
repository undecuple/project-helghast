+uint32_t kz3_pm_select(const uint8_t* ls, uint32_t lr, uint32_t arg, int over_budget)
+{
+    const uint32_t cur = kz3_ls_be32(ls, 0x1DC), ea = kz3_ls_be32(ls, 0x1C4);
+    int want = 0;
+    const int old = kz3_pm_select_old();
+    uint64_t run_us = 0;
