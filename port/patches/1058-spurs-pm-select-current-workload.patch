+    }
+    return ans;
+}
+static void kz3_pm_select_run_begin(void) { s_kz3_sel_t0_us = kz3_pm_now_us(); s_kz3_sel_sw = 0; }
+static void kz3_pm_select_run_end(const spu_context* ctx, uint32_t wid)
