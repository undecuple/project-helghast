+        want = g_kz3_spurs_switch_wanted(ea, cur, run_us);
+    }
+    kz3_pm_select_old();
+    const uint32_t ans = s_kz3_sel_bare ? cur : spurs_pm_select_answer(cur, old, over_budget, want);
