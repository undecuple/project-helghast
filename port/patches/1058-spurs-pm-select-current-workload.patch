+/* KZ3 patch 1058 (SPU pass 40): the port kernel's side of the selectWorkload answer (spurs_policy.c
+ * kz3_pm_select). A running policy module keeps its SPU (the answer is its own wklCurrentId) unless another
+ * workload of the instance is enabled, state 2, not claimed by a kernel thread, and
+ *  - kicked (ready count or signal): it waits for an SPU, as the real kernel's readyCount > contention rule, or
+ *  - every kernel thread of the instance is in a run and this run is past KZ3_PM_QUANTUM_US (default 8000; 0 =
+ *    none): the round-robin passes would otherwise stall behind long runs.
+ * A free kernel thread is not enough to keep running past a kick: an idle thread sleeps between passes, so a
+ * kicked workload (wid 10 LibMP3 next to wid 9) waited up to that sleep (pass 40 probe spu-40n, first variant). 
+ * ASSUMPTION: the real kernel weighs per-SPU priorities (wklInfo) too; the port's kernel threads are
+ * round-robin with no priorities, so any waiting kicked workload counts. kz3-pm-switch begin */
+static int s_kz3_quantum_us = -1;
+static int kz3_spurs_switch_wanted(u32 ea, u32 cur, u64 run_us)
+{
+    struct SpursInst* si = NULL;
+    for (int i = 0; i < MAX_SPURS_INST; i++) if (s_inst[i].ea == ea) { si = &s_inst[i]; break; }
+    if (!si) return 0;
+    const int j = (int)(si - s_inst);
+    int n = si->nthreads < 1 ? 1 : si->nthreads;
+    if (n > KZ3_KT_MAX) n = KZ3_KT_MAX;
+    if (s_kz3_quantum_us < 0) { const char* e = getenv("KZ3_PM_QUANTUM_US"); int q = e ? atoi(e) : 8000; s_kz3_quantum_us = q < 0 ? 0 : q; }
+    int over_q = s_kz3_quantum_us && run_us > (u64)s_kz3_quantum_us;
+    for (int kt = 0; kt < n && over_q; kt++) if (!s_run_t0[j][kt]) over_q = 0;
+    const u32 enabled = vm_read32(ea + SPURS_WKL_ENABLED);
+    const u32 sig = vm_read32(ea + SPURS_WKL_SIGNAL1) >> 16;
+    for (u32 w = 0; w < 16; w++) {
+        if (w == cur || !(enabled & (0x80000000u >> w))) continue;
+        if (*(vm_base + ea + SPURS_WKL_STATE1 + w) != 2) continue;
+        if (!s_workloads[w].in_use || s_workloads[w].spurs_ea != ea || s_wkl_busy[w]) continue;
+        if (over_q || *(vm_base + ea + SPURS_WKL_READY1 + w) || (sig & (0x8000u >> w))) return 1;
+    }
+    return 0;
+}
+__attribute__((constructor)) static void kz3_pm_switch_init(void)
+{
+    extern int (*g_kz3_spurs_switch_wanted)(uint32_t, uint32_t, uint64_t);
+    g_kz3_spurs_switch_wanted = kz3_spurs_switch_wanted;
+}
+/* kz3-pm-switch end */
