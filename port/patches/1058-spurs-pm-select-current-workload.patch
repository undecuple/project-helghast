+            long sw = __atomic_exchange_n(&s_kz3_sel_swc[w], 0, __ATOMIC_RELAXED);
+            long st = __atomic_exchange_n(&s_kz3_sel_stop[w], 0, __ATOMIC_RELAXED);
+            if (rn || pl) o += snprintf(b + o, sizeof b - (size_t)o, " w%d:%ld/%ld/%ld/%ld", w, rn, pl, sw, st);
+        }
+        if (last) fprintf(stderr, "[pm-sel] 10s runs/polls/switch/stopped:%s\n", b);
+    }
+}
