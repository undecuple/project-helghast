+/* KZ3 patch 1058 (SPU pass 40, RE pass 86 "why the BrB job manager runs one job per PM run"):
+ * the answer of the HLE kernel's selectWorkload intercept (LS 0x9D0, spu_channels.c).
+ *
+ * A policy module asks the kernel "which workload should this SPU run now?" and compares the answer with
+ * wklCurrentId (kernel context LS 0x1DC). The WWS job-manager PM (every KZ3 job manager: BrB audio wid 9,
+ * jm_gfx, physics, post ...) does it in its rate-limited poll 0x2D40 -> wrapper 0x3678 (`ceq r5, cur` at
+ * 0x36C8): a different id means "another workload was selected": the PM stops prefetching (LS 0x12C0 |= 0xFFF0
+ * at 0x1A20) and exits to the kernel once the job in flight is done. The HLE used to answer 0, which differs
+ * from every wid != 0, so every such PM ran exactly one job per kernel run (SPU pass 39 P3).
+ *
+ * The answer now: the current id (keep running) unless the kernel genuinely wants the SPU elsewhere (the run is
+ * over KZ3_SPURS_RUN_MS, patch 1048, or the port's kernel has another kicked workload waiting unclaimed,
+ * or every kernel thread is busy and the run is past KZ3_PM_QUANTUM_US; cellSpurs.c kz3_spurs_switch_wanted), then cur + 1 (mod 16), which is never cur. Off by default: KZ3_PM_SELECT=1 turns it on, KZ3_PM_SELECT_OLD=1 forces
+ * the old answers (0 within budget, 1 over budget) for A/B. Pure, so the host test checks it alone. */
+#ifndef SPURS_SELECT_H
+#define SPURS_SELECT_H
+#include <stdint.h>
+
+static inline uint32_t spurs_pm_select_answer(uint32_t cur_wid, int old_mode, int over_budget, int switch_wanted)
+{
+    if (old_mode) return over_budget ? 1u : 0u;          /* pre-1058: 0 = "continue", 1 = budget switch */
+    if (over_budget || switch_wanted) return (cur_wid + 1u) & 0xFu;
+    return cur_wid;
+}
+
+#endif
