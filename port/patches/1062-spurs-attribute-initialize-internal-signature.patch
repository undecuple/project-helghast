diff --git a/libs/spurs/kz3_spurs_attr.h b/libs/spurs/kz3_spurs_attr.h
new file mode 100644
index 00000000..25186ad8
--- /dev/null
+++ b/libs/spurs/kz3_spurs_attr.h
@@ -0,0 +1,45 @@
+/* KZ3 patch 1062 (SPU pass 47, from RE pass 104): the SDK's internal
+ * _cellSpursAttributeInitialize (NID 0x95180230, what the cellSpursAttributeInitialize()
+ * macro imports) takes (attr, revision, sdkVersion, nSpus, spuPriority, ppuPriority,
+ * exitIfNoWork). The HLE used the public five-argument prototype, so it read r4 (the
+ * revision, 2) as nSpus, r5 (the SDK version) as spuPriority and r6 (the real nSpus) as
+ * ppuPriority. KZ3 asks for 5 SPUs (HiPrio) and 1 (LoPrio); the HLE made both 2.
+ * The register-to-argument mapping lives here so a host test can check it without the
+ * Windows-only cellSpurs.c. ON by default since SPU pass 60 (with the per-SPU kernel 1074 and the PM
+ * argument fix 1077 the real 5/1 counts reach K4; before, the boot hung: spu rounds 47, 58-59);
+ * KZ3_SPURS_ATTR_SDK=0 selects the old mapping (r4 read as nSpus, 2/2). */
+#ifndef KZ3_SPURS_ATTR_H
+#define KZ3_SPURS_ATTR_H
+#include <stdint.h>
+#include <stdlib.h>
+
+typedef struct {
+    uint32_t revision, sdkVersion;
+    int32_t  nSpus, spuPriority, ppuPriority;
+    uint8_t  exitIfNoWork;
+} kz3_spurs_attr_args;
+
+static inline int kz3_spurs_attr_sdk(void)
+{
+    static int s = -1;
+    if (s < 0) { const char* e = getenv("KZ3_SPURS_ATTR_SDK"); s = (e && *e == '0') ? 0 : 1; }
+    return s;
+}
+
+/* r4..r9 as the generic HLE adapter hands them over (r3 = attr). */
+static inline kz3_spurs_attr_args kz3_spurs_attr_map(uint64_t r4, uint64_t r5, uint64_t r6,
+                                                     uint64_t r7, uint64_t r8, uint64_t r9)
+{
+    kz3_spurs_attr_args a;
+    if (!kz3_spurs_attr_sdk()) {         /* KZ3_SPURS_ATTR_SDK=0: the public prototype on the internal NID (2/2) */
+        a.revision = 0; a.sdkVersion = 0;
+        a.nSpus = (int32_t)r4; a.spuPriority = (int32_t)r5; a.ppuPriority = (int32_t)r6;
+        a.exitIfNoWork = (uint8_t)r7;
+    } else {
+        a.revision = (uint32_t)r4; a.sdkVersion = (uint32_t)r5;
+        a.nSpus = (int32_t)r6; a.spuPriority = (int32_t)r7; a.ppuPriority = (int32_t)r8;
+        a.exitIfNoWork = (uint8_t)r9;
+    }
+    return a;
+}
+#endif
