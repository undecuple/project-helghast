+/* ---- KZ3 patch 1033: host sampling profiler (Windows only, needs KZ3_WAIT_ACCT) ------------------
+ * KZ3_PROF=FROM,TO (seconds since start): from FROM to TO a sampler thread suspends every profiled
+ * thread about once per ms, reads its RIP and counts (RIP, resident job module) pairs; at TO it prints
+ * every pair once ("[prof] rva=0x... job=N n=..."; rva relative to the exe's load address, "ext" for
+ * code outside the exe) and stops. tools/spu/prof_resolve.py maps the RVAs to function names.
+ * Profiled threads: those named through kz3_wacct_name whose name contains KZ3_PROF_FILTER
+ * (default: the SPURS kernel threads "spurs-kern" and the lane workers "pm-worker"). */
+#ifdef _WIN32
+enum { PR_SLOTS = 1 << 16 };
+typedef struct { uint64_t rip; int job; uint32_t n; } pr_ent;
+static pr_ent* s_pr;
+static volatile long s_pr_lock = 0;
+static int s_prof_on = -1;
+static double s_prof_from = 0, s_prof_to = 0;
+static const char* s_prof_filter = 0;
+
+static void pr_add(uint64_t rip, int job)
+{
+    uint64_t key = rip ^ ((uint64_t)(uint32_t)job << 40);
+    uint32_t h = (uint32_t)((key * 0x9E3779B97F4A7C15ull) >> 40) & (PR_SLOTS - 1);
+    for (int p = 0; p < 64; p++) {
+        pr_ent* e = &s_pr[(h + p) & (PR_SLOTS - 1)];
+        if (e->n && e->rip == rip && e->job == job) { e->n++; return; }
+        if (!e->n) { e->rip = rip; e->job = job; e->n = 1; return; }
+    }
+}
+
+static DWORD WINAPI prof_thread(LPVOID p)
+{
+    (void)p;
+    const uint64_t base = (uint64_t)(uintptr_t)GetModuleHandleA(NULL);
+    const IMAGE_NT_HEADERS* nt = (const IMAGE_NT_HEADERS*)(uintptr_t)(base + ((const IMAGE_DOS_HEADER*)(uintptr_t)base)->e_lfanew);
+    const uint64_t size = nt->OptionalHeader.SizeOfImage;
+    uint64_t samples = 0, miss = 0;
+    for (;;) {
+        Sleep(1);
+        double t = (double)(kz3_wacct_now() - s_t0) / 1e9;
+        if (t < s_prof_from) continue;
+        if (t >= s_prof_to) break;
+        while (__sync_lock_test_and_set(&s_pr_lock, 1)) { }
+        long nt2 = s_nthr; if (nt2 > WA_THREADS) nt2 = WA_THREADS;
+        for (long i = 0; i < nt2; i++) {
+            wa_thr* w = s_thr[i];
+            if (!w || !w->hthr) continue;
+            HANDLE h = (HANDLE)w->hthr;
+            if (SuspendThread(h) == (DWORD)-1) { miss++; continue; }
+            CONTEXT c; memset(&c, 0, sizeof c); c.ContextFlags = CONTEXT_CONTROL;
+            if (GetThreadContext(h, &c)) { pr_add((uint64_t)c.Rip, w->job_img); samples++; } else miss++;
+            ResumeThread(h);
+        }
+        __sync_lock_release(&s_pr_lock);
+    }
+    fprintf(stderr, "[prof] done t=%.1f..%.1fs samples=%llu miss=%llu base=0x%llx size=0x%llx\n", s_prof_from, s_prof_to,
+            (unsigned long long)samples, (unsigned long long)miss, (unsigned long long)base, (unsigned long long)size);
+    for (int i = 0; i < PR_SLOTS; i++) {
+        const pr_ent* e = &s_pr[i];
+        if (!e->n) continue;
+        if (e->rip >= base && e->rip < base + size)
+            fprintf(stderr, "[prof] rva=0x%llx job=%d n=%u\n", (unsigned long long)(e->rip - base), e->job, e->n);
+        else
+            fprintf(stderr, "[prof] ext=0x%llx job=%d n=%u\n", (unsigned long long)e->rip, e->job, e->n);
+    }
+    fflush(stderr);
+    return 0;
+}
+
+static void prof_init(void)
+{
+    const char* e = getenv("KZ3_PROF");
+    s_prof_on = 0;
+    if (!e || sscanf(e, "%lf,%lf", &s_prof_from, &s_prof_to) != 2 || s_prof_to <= s_prof_from) return;
+    s_prof_filter = getenv("KZ3_PROF_FILTER");
+    s_pr = (pr_ent*)calloc(PR_SLOTS, sizeof *s_pr);
+    if (!s_pr) return;
+    s_prof_on = 1;
+    fprintf(stderr, "[prof] on: %.0f..%.0f s, threads matching %s (KZ3 patch 1033)\n", s_prof_from, s_prof_to,
+            s_prof_filter ? s_prof_filter : "spurs-kern|pm-worker");
+    CreateThread(NULL, 1u << 18, prof_thread, NULL, 0, NULL);
+}
+
+static void prof_attach(wa_thr* t)
+{
+    if (s_prof_on <= 0 || !t) return;
+    int m = s_prof_filter ? strstr(t->name, s_prof_filter) != NULL
+                          : (strstr(t->name, "spurs-kern") || strstr(t->name, "pm-worker"));
+    if (!m) return;
+    HANDLE h = NULL;
+    if (!DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &h,
+                         THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, 0)) return;
+    while (__sync_lock_test_and_set(&s_pr_lock, 1)) { }
+    if (t->hthr) CloseHandle((HANDLE)t->hthr);
+    t->hthr = h;
+    __sync_lock_release(&s_pr_lock);
+}
+#else
+static void prof_init(void) { }
+static void prof_attach(wa_thr* t) { (void)t; }
+#endif
