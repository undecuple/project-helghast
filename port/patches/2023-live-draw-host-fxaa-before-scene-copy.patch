+/* Patch 2023 (ENHANCEMENT): host anti-aliasing pass. Killzone 3 anti-aliases
+ * with MLAA on the SPUs (post job 0x26 with a hardcoded 1280-pixel pitch, run
+ * in place on the NV0039 copy of the scene in main memory). When the port
+ * skips that job (a PPU override of the MLAA call, see rsx_live_draw.h), the
+ * host runs FXAA (3.11 quality-style, one compute pass) on the scene surface
+ * right before the NV0039 copy writes it back, so the copy carries the
+ * anti-aliased scene into the post chain.
+ * Setting: KZ3_HOST_AA=fxaa|off. Unset = fxaa, but the pass only runs once
+ * the port armed it (rsx_live_draw_host_aa_arm, i.e. the game's own AA is
+ * off), so FXAA never stacks on SPU MLAA; an explicit KZ3_HOST_AA=fxaa runs
+ * it unconditionally (tests). Alpha is passed through untouched (the post
+ * chain may keep data there); pixels whose 4-neighbourhood luma contrast is
+ * under the edge threshold are written back bit-exactly. */
+static ID3D12RootSignature* g_aa_rootsig;
+static ID3D12PipelineState* g_aa_pso;
+static ID3D12Resource* g_aa_tex;
+static u32 g_aa_w, g_aa_h, g_aa_failed, g_aa_passes, g_aa_armed;
+static u32 g_aa_frame[MAX_SURFACES];
+static D3D12_RESOURCE_STATES g_aa_state;
+
+int rsx_live_draw_host_aa_mode(void)
+{
+    static int mode = -1;
+    if (mode < 0) {
+        const char* e = getenv("KZ3_HOST_AA");
+        mode = (e && (!_stricmp(e, "off") || !strcmp(e, "0"))) ? 0 : 1;
+    }
+    return mode;
+}
+void rsx_live_draw_host_aa_arm(int on) { g_aa_armed = on ? 1u : 0u; }
+int rsx_live_draw_host_aa_active(void)
+{
+    const char* e = getenv("KZ3_HOST_AA");
+    return rsx_live_draw_host_aa_mode() && (g_aa_armed || (e && *e));
+}
+u32 rsx_live_draw_debug_host_aa_passes(void) { return g_aa_passes; }
+
+static int ld_host_aa_pipeline(void)
+{
+    if (g_aa_pso) return 1;
+    if (g_aa_failed) return 0;
+    g_aa_failed = 1;
+    /* Sizes come as root constants (Wine's d3dcompiler rejects
+     * RWTexture2D::GetDimensions, see make_depth_snapshot_pipeline). No
+     * arrays, attributes or early loop exits, for vkd3d-shader's HLSL. */
+    static const char source[] =
+        "Texture2D<float4> src : register(t0);\n"
+        "RWTexture2D<float4> dst : register(u0);\n"
+        "SamplerState lin : register(s0);\n"
+        "cbuffer aa : register(b0) { uint W; uint H; float rw; float rh; };\n"
+        "float L(float4 c) { return dot(c.rgb, float3(0.299, 0.587, 0.114)); }\n"
+        "float Lat(int2 p) { return L(src.Load(int3(clamp(p, int2(0, 0), int2(W - 1, H - 1)), 0))); }\n"
+        "float Luv(float2 uv) { return L(src.SampleLevel(lin, uv, 0)); }\n"
+        "[numthreads(8, 8, 1)]\n"
+        "void main(uint3 id : SV_DispatchThreadID) {\n"
+        "  if (id.x >= W || id.y >= H) return;\n"
+        "  int2 p = int2(id.xy);\n"
+        "  float4 cM = src.Load(int3(p, 0));\n"
+        "  float lM = L(cM);\n"
+        "  float lN = Lat(p + int2(0, -1)), lS = Lat(p + int2(0, 1));\n"
+        "  float lW = Lat(p + int2(-1, 0)), lE = Lat(p + int2(1, 0));\n"
+        "  float lMax = max(max(max(lN, lS), max(lW, lE)), lM);\n"
+        "  float lMin = min(min(min(lN, lS), min(lW, lE)), lM);\n"
+        "  float range = lMax - lMin;\n"
+        "  if (range < max(0.0833, lMax * 0.166)) { dst[p] = cM; return; }\n"
+        "  float lNW = Lat(p + int2(-1, -1)), lNE = Lat(p + int2(1, -1));\n"
+        "  float lSW = Lat(p + int2(-1, 1)), lSE = Lat(p + int2(1, 1));\n"
+        "  float lNS = lN + lS, lWE = lW + lE;\n"
+        "  float lNWSW = lNW + lSW, lNESE = lNE + lSE, lNWNE = lNW + lNE, lSWSE = lSW + lSE;\n"
+        "  float eH = abs(-2.0 * lW + lNWSW) + abs(-2.0 * lM + lNS) * 2.0 + abs(-2.0 * lE + lNESE);\n"
+        "  float eV = abs(-2.0 * lS + lSWSE) + abs(-2.0 * lM + lWE) * 2.0 + abs(-2.0 * lN + lNWNE);\n"
+        "  bool horz = eH >= eV;\n"
+        "  float subA = (lNS + lWE) * 2.0 + lNWSW + lNESE;\n"
+        "  float subC = saturate(abs(subA / 12.0 - lM) / range);\n"
+        "  float subF = (-2.0 * subC + 3.0) * subC * subC;\n"
+        "  float subH = subF * subF * 0.75;\n"
+        "  float len = horz ? rh : rw;\n"
+        "  if (!horz) { lN = lW; lS = lE; }\n"
+        "  float gN = lN - lM, gS = lS - lM;\n"
+        "  bool pairN = abs(gN) >= abs(gS);\n"
+        "  float grad = max(abs(gN), abs(gS));\n"
+        "  if (pairN) len = -len;\n"
+        "  float lNN = pairN ? lN + lM : lS + lM;\n"
+        "  float2 posM = (float2(p) + 0.5) * float2(rw, rh);\n"
+        "  float2 posB = posM;\n"
+        "  if (horz) posB.y += len * 0.5; else posB.x += len * 0.5;\n"
+        "  float2 off = horz ? float2(rw, 0.0) : float2(0.0, rh);\n"
+        "  float2 posN = posB - off, posP = posB + off;\n"
+        "  float gs = grad * 0.25;\n"
+        "  bool mLTZ = (lM - lNN * 0.5) < 0.0;\n"
+        "  float eN = Luv(posN) - lNN * 0.5, eP = Luv(posP) - lNN * 0.5;\n"
+        "  bool dN = abs(eN) >= gs, dP = abs(eP) >= gs;\n"
+        "  for (int i = 0; i < 8; i++) {\n"
+        "    float st = i == 0 ? 1.5 : (i < 5 ? 2.0 : (i == 5 ? 4.0 : 8.0));\n"
+        "    if (!dN) posN -= off * st;\n"
+        "    if (!dP) posP += off * st;\n"
+        "    if (!dN) eN = Luv(posN) - lNN * 0.5;\n"
+        "    if (!dP) eP = Luv(posP) - lNN * 0.5;\n"
+        "    dN = dN || abs(eN) >= gs;\n"
+        "    dP = dP || abs(eP) >= gs;\n"
+        "  }\n"
+        "  float dstN = horz ? posM.x - posN.x : posM.y - posN.y;\n"
+        "  float dstP = horz ? posP.x - posM.x : posP.y - posM.y;\n"
+        "  bool goodN = (eN < 0.0) != mLTZ, goodP = (eP < 0.0) != mLTZ;\n"
+        "  bool dirN = dstN < dstP;\n"
+        "  float d = min(dstN, dstP);\n"
+        "  float off1 = (dirN ? goodN : goodP) ? 0.5 - d / (dstN + dstP) : 0.0;\n"
+        "  float o = max(off1, subH);\n"
+        "  if (horz) posM.y += o * len; else posM.x += o * len;\n"
+        "  dst[p] = float4(src.SampleLevel(lin, posM, 0).rgb, cM.a);\n"
+        "}\n";
+    ID3DBlob* cs = NULL; ID3DBlob* err = NULL;
+    HRESULT hr = D3DCompile(source, sizeof(source) - 1u, "host_aa_fxaa", NULL, NULL, "main", "cs_5_0",
+                            D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &cs, &err);
+    if (FAILED(hr)) {
+        fprintf(stderr, "[host-aa] FXAA compile failed hr=0x%08lX: %s\n", (unsigned long)hr,
+                err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "<no diagnostics>");
+        if (err) err->lpVtbl->Release(err);
+        return 0;
+    }
+    if (err) err->lpVtbl->Release(err);
+    D3D12_DESCRIPTOR_RANGE rg[2] = {0};
+    rg[0].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV; rg[0].NumDescriptors = 1;
+    rg[1].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV; rg[1].NumDescriptors = 1;
+    D3D12_ROOT_PARAMETER rp[3] = {0};
+    for (u32 i = 0; i < 2; i++) {
+        rp[i].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+        rp[i].DescriptorTable.NumDescriptorRanges = 1;
+        rp[i].DescriptorTable.pDescriptorRanges = &rg[i];
+        rp[i].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    }
+    rp[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    rp[2].Constants.Num32BitValues = 4;
+    rp[2].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    D3D12_STATIC_SAMPLER_DESC ss = {0};
+    ss.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+    ss.AddressU = ss.AddressV = ss.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    ss.MaxLOD = D3D12_FLOAT32_MAX;
+    ss.ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    D3D12_ROOT_SIGNATURE_DESC rd = {0};
+    rd.NumParameters = 3; rd.pParameters = rp;
+    rd.NumStaticSamplers = 1; rd.pStaticSamplers = &ss;
+    ID3DBlob* sig = NULL;
+    hr = D3D12SerializeRootSignature(&rd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err);
+    if (err) err->lpVtbl->Release(err);
+    if (SUCCEEDED(hr)) {
+        hr = g.dev->lpVtbl->CreateRootSignature(g.dev, 0, sig->lpVtbl->GetBufferPointer(sig),
+                                                sig->lpVtbl->GetBufferSize(sig),
+                                                &IID_ID3D12RootSignature, (void**)&g_aa_rootsig);
+        sig->lpVtbl->Release(sig);
+    }
+    if (SUCCEEDED(hr)) {
+        D3D12_COMPUTE_PIPELINE_STATE_DESC pd = {0};
+        pd.pRootSignature = g_aa_rootsig;
+        pd.CS.pShaderBytecode = cs->lpVtbl->GetBufferPointer(cs);
+        pd.CS.BytecodeLength = cs->lpVtbl->GetBufferSize(cs);
+        hr = g.dev->lpVtbl->CreateComputePipelineState(g.dev, &pd, &IID_ID3D12PipelineState, (void**)&g_aa_pso);
+    }
+    cs->lpVtbl->Release(cs);
+    if (FAILED(hr) || !g_aa_pso) {
+        fprintf(stderr, "[host-aa] FXAA pipeline failed hr=0x%08lX\n", (unsigned long)hr);
+        return 0;
+    }
+    g_aa_failed = 0;
+    return 1;
+}
+
+/* Output texture (UAV) of the surface's size; it is copied over the surface. */
+static int ld_host_aa_target(u32 w, u32 h)
+{
+    if (g_aa_tex && g_aa_w == w && g_aa_h == h) return 1;
+    if (g_aa_tex) { retire_texture(g_aa_tex); g_aa_tex = NULL; }
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC rd = {0};
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    rd.Width = w; rd.Height = h; rd.DepthOrArraySize = 1; rd.MipLevels = 1;
+    rd.Format = DXGI_FORMAT_R8G8B8A8_UNORM; rd.SampleDesc.Count = 1;
+    rd.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+            D3D12_RESOURCE_STATE_UNORDERED_ACCESS, NULL, &IID_ID3D12Resource, (void**)&g_aa_tex)))
+        { g_aa_tex = NULL; return 0; }
+    g_aa_state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    g_aa_w = w; g_aa_h = h;
+    D3D12_UNORDERED_ACCESS_VIEW_DESC ud = {0};
+    ud.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    ud.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+    g.dev->lpVtbl->CreateUnorderedAccessView(g.dev, g_aa_tex, NULL, &ud, srv_cpu(UAV_HOST_AA));
+    return 1;
+}
+
+/* Anti-alias colour surface i in place (recorded into the open list). Once
+ * per frame per surface; only A8R8G8B8 surfaces of at least 640x360. */
+static int ld_host_aa(u32 i)
+{
+    if (i >= MAX_SURFACES || !rsx_live_draw_host_aa_active()) return 0;
+    surface_t* sf = &g.surfaces[i];
+    if (!sf->tex || sf->fmt != DXGI_FORMAT_R8G8B8A8_UNORM || sf->w < 640u || sf->h < 360u) return 0;
+    if (g_aa_frame[i] == g_ld_frames + 1u) return 0;
+    if (!ld_host_aa_pipeline() || !ld_host_aa_target(sf->w, sf->h)) return 0;
+    if (g.srv_ring_used >= SRV_RING_TABLES) return 0;
+    const u32 base = g.srv_ring_used++ * SRV_TABLE_SIZE;
+    D3D12_CPU_DESCRIPTOR_HANDLE cpu;
+    g.srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(g.srv_heap, &cpu);
+    cpu.ptr += (size_t)base * g.srv_step;
+    g.dev->lpVtbl->CopyDescriptorsSimple(g.dev, 1, cpu, srv_cpu(SRV_SURFACE_BASE + i),
+                                         D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    cpu.ptr += g.srv_step;
+    g.dev->lpVtbl->CopyDescriptorsSimple(g.dev, 1, cpu, srv_cpu(UAV_HOST_AA),
+                                         D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    D3D12_GPU_DESCRIPTOR_HANDLE gpu;
+    g.srv_heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(g.srv_heap, &gpu);
+    gpu.ptr += (u64)base * g.srv_step;
+    D3D12_GPU_DESCRIPTOR_HANDLE gpu_uav = gpu; gpu_uav.ptr += g.srv_step;
+
+    D3D12_RESOURCE_BARRIER b[2] = {0};
+    u32 nb = 0;
+    b[nb].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b[nb].Transition.pResource = sf->tex;
+    b[nb].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b[nb].Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b[nb].Transition.StateAfter = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+    nb++;
+    if (g_aa_state != D3D12_RESOURCE_STATE_UNORDERED_ACCESS) {
+        b[nb].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b[nb].Transition.pResource = g_aa_tex;
+        b[nb].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        b[nb].Transition.StateBefore = g_aa_state;
+        b[nb].Transition.StateAfter = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+        nb++;
+    }
+    g.list->lpVtbl->ResourceBarrier(g.list, nb, b);
+    ID3D12DescriptorHeap* heaps[] = {g.srv_heap, g.smp_heap};
+    g.list->lpVtbl->SetDescriptorHeaps(g.list, 2, heaps);
+    g.list->lpVtbl->SetPipelineState(g.list, g_aa_pso);
+    g.list->lpVtbl->SetComputeRootSignature(g.list, g_aa_rootsig);
+    g.list->lpVtbl->SetComputeRootDescriptorTable(g.list, 0, gpu);
+    g.list->lpVtbl->SetComputeRootDescriptorTable(g.list, 1, gpu_uav);
+    {
+        const float rw = 1.0f / (float)sf->w, rh = 1.0f / (float)sf->h;
+        UINT k[4] = { sf->w, sf->h, 0, 0 };
+        memcpy(&k[2], &rw, 4); memcpy(&k[3], &rh, 4);
+        g.list->lpVtbl->SetComputeRoot32BitConstants(g.list, 2, 4, k, 0);
+    }
+    g.list->lpVtbl->Dispatch(g.list, (sf->w + 7u) / 8u, (sf->h + 7u) / 8u, 1);
+    b[0].Transition.StateBefore = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+    b[0].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+    b[1].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b[1].Transition.pResource = g_aa_tex;
+    b[1].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b[1].Transition.StateBefore = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    b[1].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    g.list->lpVtbl->ResourceBarrier(g.list, 2, b);
+    g.list->lpVtbl->CopyResource(g.list, sf->tex, g_aa_tex);
+    b[0].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    b[0].Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, b);
+    g_aa_state = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    ld_surface_note_write(i, LD_SURFACE_WRITE_OTHER);
+    g_aa_frame[i] = g_ld_frames + 1u;
+    if (g_aa_passes++ < 4)
+        fprintf(stderr, "[host-aa] fxaa on surface %u:0x%08X %ux%u (frame %u)\n",
+                sf->location, sf->offset, sf->w, sf->h, g_ld_frames);
+    return 1;
+}
+
 u32 rsx_live_draw_writeback_range(u32 location, u32 offset, u32 size)
 {
     static int en = -1;
@@ -10975,6 +11246,10 @@ u32 rsx_live_draw_writeback_range(u32 location, u32 offset, u32 size)
         const u64 s0 = sf->offset, s1 = s0 + (u64)gp * (sf->h - 1u) + (u64)sf->w * texel;
         if (!(s0 < r1 && r0 < s1)) continue;
         if (n < 64) idx[n++] = i;   /* patch 2018: batched */
+        /* Patch 2023: a copy of a whole frame-sized colour surface is the
+         * scene leaving for the SPU post chain (KZ3: local 0x1300000 -> main
+         * 0x1310400, where SPU MLAA ran); the host AA pass runs on it first. */
+        if (r0 <= s0 && r1 >= s1) ld_host_aa(i);
     }
     done = ld_writeback_batch(idx, n, offset, size);
     return done;
diff --git a/libs/video/rsx_live_draw.h b/libs/video/rsx_live_draw.h
index c057aed9..c8ae39fd 100644
--- a/libs/video/rsx_live_draw.h
+++ b/libs/video/rsx_live_draw.h
@@ -110,6 +110,19 @@ u32  rsx_live_draw_writeback_range(u32 location, u32 offset, u32 size);
