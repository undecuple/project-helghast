diff -ruN a/libs/video/rsx_ring_marks.h b/libs/video/rsx_ring_marks.h
--- a/libs/video/rsx_ring_marks.h	1970-01-01 00:00:00.000000000 +0000
+++ b/libs/video/rsx_ring_marks.h	2026-11-05 00:29:35.446297767 +0000
@@ -0,0 +1,97 @@
+/* rsx_ring_marks.h - KZ3 patch 2153: per-ring (range, fence) marks for rings that wrap without draining the queue.
+ *
+ * A live-draw ring is written linearly from 0. Every queue submit covers the bytes (or table slots) the
+ * cursor advanced over since the previous submit: submit(used, fence) appends the mark [cur_end, used) -> fence.
+ * When the ring is full the caller submits the open list (so no unsubmitted work references the ring), calls
+ * wrap(), and restarts the cursor at 0. The old generation's marks stay as the "not yet re-entered" list: before
+ * the cursor writes [a, b) the caller calls acquire(b), which returns the newest fence among the old marks
+ * that start below b (the GPU may still read those ranges) and retires those marks. The caller waits for that
+ * fence; nothing else.
+ *
+ * Conservative on every doubt: a mark list that overflows merges neighbours (union range, newest fence), and
+ * an out-of-order submit (cursor moved back without wrap(), or a fence that does not increase) replaces the
+ * current marks with one mark over the whole range seen so far, so the next wait covers it.
+ * Pure arithmetic; no D3D12 types, so tools/smoke/test_ld_ring_marks.c builds it on the host. */
+#ifndef RSX_RING_MARKS_H
+#define RSX_RING_MARKS_H
+#include <stdint.h>
+
+#define RSX_RM_MAX 64u
+
+typedef struct { uint64_t start, end, fence; } rsx_rm_mark;   /* [start, end) last read by work up to `fence` */
+
+typedef struct {
+    rsx_rm_mark old[RSX_RM_MAX]; uint32_t old_n;   /* previous generations, sorted by start, disjoint */
+    rsx_rm_mark cur[RSX_RM_MAX]; uint32_t cur_n;   /* this generation, sorted, contiguous from 0 */
+    uint64_t cur_end;                              /* end of the last current mark */
+    uint64_t last_fence;                           /* newest fence seen; submits must exceed it */
+} rsx_ring_marks;
+
+static inline void rsx_rm_clear(rsx_ring_marks* m)
+{
+    m->old_n = 0; m->cur_n = 0; m->cur_end = 0; m->last_fence = 0;
+}
+
+/* Merge marks i and i+1 of a sorted list (union range, newest fence): the overflow rule. */
+static inline void rsx_rm_merge_at(rsx_rm_mark* a, uint32_t* n, uint32_t i)
+{
+    a[i].end = a[i + 1].end;
+    if (a[i + 1].fence > a[i].fence) a[i].fence = a[i + 1].fence;
+    for (uint32_t k = i + 1; k + 1 < *n; k++) a[k] = a[k + 1];
+    (*n)--;
+}
+
+/* A queue submit with `fence` covers everything the cursor wrote up to `used`. 1 = mark added, 0 = nothing new
+ * to mark, -1 = rejected (out of order: the marks were widened conservatively, see above). */
+static inline int rsx_rm_submit(rsx_ring_marks* m, uint64_t used, uint64_t fence)
+{
+    if (used < m->cur_end || fence <= m->last_fence) {
+        const uint64_t end = used > m->cur_end ? used : m->cur_end;
+        const uint64_t f = fence > m->last_fence ? fence : m->last_fence;
+        m->cur[0].start = 0; m->cur[0].end = end; m->cur[0].fence = f;
+        m->cur_n = 1; m->cur_end = end; m->last_fence = f;
+        return -1;
+    }
+    m->last_fence = fence;
+    if (used == m->cur_end) return 0;
+    if (m->cur_n == RSX_RM_MAX) rsx_rm_merge_at(m->cur, &m->cur_n, m->cur_n - 2);
+    m->cur[m->cur_n].start = m->cur_end; m->cur[m->cur_n].end = used; m->cur[m->cur_n].fence = fence;
+    m->cur_n++; m->cur_end = used;
+    return 1;
+}
+
+/* The cursor restarts at 0. The caller has submitted the open list first (so every byte written is marked).
+ * New old list = this generation's marks + the old marks beyond where this generation reached. */
+static inline void rsx_rm_wrap(rsx_ring_marks* m)
+{
+    rsx_rm_mark t[2u * RSX_RM_MAX]; uint32_t n = 0;
+    for (uint32_t i = 0; i < m->cur_n; i++) t[n++] = m->cur[i];
+    for (uint32_t i = 0; i < m->old_n; i++) {
+        rsx_rm_mark o = m->old[i];
+        if (o.end <= m->cur_end) continue;
+        if (o.start < m->cur_end) o.start = m->cur_end;
+        t[n++] = o;
+    }
+    while (n > RSX_RM_MAX) rsx_rm_merge_at(t, &n, n - 2);
+    for (uint32_t i = 0; i < n; i++) m->old[i] = t[i];
+    m->old_n = n; m->cur_n = 0; m->cur_end = 0;
+}
+
+/* The cursor is about to write below `end`. Returns the newest fence among the old marks that start below
+ * `end` (0 = none: the range is free) and retires them; the caller must wait for the fence before writing. */
+static inline uint64_t rsx_rm_acquire(rsx_ring_marks* m, uint64_t end)
+{
+    uint64_t f = 0; uint32_t keep = 0;
+    for (uint32_t i = 0; i < m->old_n; i++) {
+        rsx_rm_mark o = m->old[i];
+        if (o.start < end) {
+            if (o.fence > f) f = o.fence;
+            if (o.end <= end) continue;   /* fully re-entered */
+            o.start = end;                /* partly: the rest stays protected */
+        }
+        m->old[keep++] = o;
+    }
+    m->old_n = keep;
+    return f;
+}
+#endif
