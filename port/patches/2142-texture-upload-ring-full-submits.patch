diff --git a/libs/video/rsx_upload_ring.h b/libs/video/rsx_upload_ring.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_upload_ring.h	2026-11-02 15:27:35.360837997 -0600
@@ -0,0 +1,34 @@
+/* KZ3 patch 2142 (the Killzone 2 port, patch 6048): where a texture upload goes in the per-frame upload ring (live
+ * draw, UPLOAD_SIZE = 64 MB).
+ *
+ * Texture texels are staged in the upload ring and copied into the texture by CopyTextureRegion. The ring is
+ * emptied only when the command list is submitted. Before this patch a texture level that did not fit in what was
+ * left of the ring was skipped silently ("break"): the D3D12 resource stayed as created (zeros), the cache entry
+ * still held it, and its hash never changed, so the texture was never uploaded again (cube and 3D textures returned
+ * NULL and bound white). The Killzone 2 port saw this as a green sky after a frame that decoded thousands of textures.
+ *
+ * Now a level that does not fit submits the list first (the GPU then has the earlier copies, and the ring starts
+ * again at 0), as the guest-surface upload (ld_gv_upload_rows) and the retire queue already do. Only a single level
+ * larger than the whole ring cannot be staged; that is reported, never silent.
+ * Pure C (host test tools/smoke/test_upload_ring.sh). */
+#ifndef RSX_UPLOAD_RING_H
+#define RSX_UPLOAD_RING_H
+#include <stdint.h>
+
+#define RSX_UP_ALIGN 512u   /* D3D12_TEXTURE_DATA_PLACEMENT_ALIGNMENT */
+
+enum { RSX_UP_FIT = 0, RSX_UP_FLUSH = 1, RSX_UP_TOO_BIG = 2 };
+
+/* used = bytes of the ring taken this list, bytes = the level's staged size (row pitch x rows), size = the ring.
+ * FIT: *start is the aligned offset after `used`. FLUSH: submit the list, then stage at *start = 0.
+ * TOO_BIG: the level alone exceeds the ring. An empty ring never asks for a flush. */
+static inline int rsx_upload_place(uint64_t used, uint64_t bytes, uint64_t size, uint64_t* start)
+{
+    *start = 0;
+    if (bytes > size) return RSX_UP_TOO_BIG;
+    const uint64_t s = (used + (RSX_UP_ALIGN - 1u)) & ~(uint64_t)(RSX_UP_ALIGN - 1u);
+    if (s <= size && bytes <= size - s) { *start = s; return RSX_UP_FIT; }
+    return RSX_UP_FLUSH;
+}
+
+#endif
