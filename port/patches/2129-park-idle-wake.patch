+/* Patch 2129: the frame thread's idle sleep of ms milliseconds. When the last pass ended on an unreleased park, wait
+ * on the park's wake event instead (set by gcm_note_spu_put when a PUT covers the park word), at most ms; a park
+ * already released skips the sleep. Returns 0 slept, 1 woken by the PUT, 2 released before the wait, 3 timed out. */
+int cellGcm_park_idle_wait(unsigned ms)
+{
+    static int on = -1;
+    static unsigned long long n[4];
+    static ULONGLONG s_last_log;
+    if (on < 0) {
+        const char* e = getenv("KZ3_PARK_IDLE_WAKE");
+        on = e && *e == '1';   /* off by default: run r122-j1 saw no PUT wake at all (see the summary line) */
+        fprintf(stderr, "[cellGcmSys] park idle wake (patch 2129): %s\n",
+                on ? "on (KZ3_PARK_IDLE_WAKE=1: the frame thread's sleep ends when an SPU PUT releases the park)" : "off (flat sleep; KZ3_PARK_IDLE_WAKE=1 on)");
+    }
+    const u32 io = __atomic_exchange_n(&s_park_idle_io, 0xFFFFFFFFu, __ATOMIC_ACQ_REL);
+    int r = 0;
+    if (!on || io == 0xFFFFFFFFu || !s_park_wake_ev) Sleep(ms);
+    else {
+        const u32 ea = gcm_io2ea(io);
+        if (ea && vm_read32(ea) == s_park_idle_word)
+            r = WaitForSingleObject(s_park_wake_ev, ms) == WAIT_OBJECT_0 ? 1 : 3;
+        else r = 2;
+        __atomic_store_n(&s_park_wake_io, 0xFFFFFFFFu, __ATOMIC_RELEASE);
+    }
+    n[r]++;
+    if (on) {
+        const ULONGLONG now = GetTickCount64();
+        if (now - s_last_log >= 60000) {
+            if (s_last_log)
+                fprintf(stderr, "[cellGcmSys] park idle wake: sleeps %llu, park waits woken by the PUT %llu, released before %llu, timed out %llu; "
+                        "PUTs over a published park %ld\n", n[0], n[1], n[2], n[3], (long)s_park_put_wakes);
+            s_last_log = now;
+        }
+    }
+    return r;
+}
