+/* Patch 2014 (test hook): copy the raw texels of the host surface at
+ * (location, offset) into out (rows packed, w * texel bytes each). Returns the
+ * texel size (8 FP16, 4 RGBA8/R32F) or -1. Host tests compare float targets
+ * bit-exactly with it; the title never calls it. */
+int rsx_live_draw_debug_read_surface(u32 location, u32 offset, void* out,
+                                     u32 out_bytes, u32* out_w, u32* out_h)
+{
+    if (!g.ready || !out) return -1;
+    const surface_t* surface = NULL;
+    for (u32 i = 0; i < g.n_surfaces; i++)
+        if (g.surfaces[i].location == location && g.surfaces[i].offset == offset &&
+            g.surfaces[i].tex) { surface = &g.surfaces[i]; break; }
+    if (!surface) return -1;
+    const u32 width = surface->w, height = surface->h;
+    const u32 texel = surface->fmt == DXGI_FORMAT_R16G16B16A16_FLOAT ? 8u : 4u;
+    const u32 pitch = (width * texel + 255) & ~255u;
+    if ((u64)width * height * texel > out_bytes) return -1;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = (UINT64)pitch * height;
+    bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+    bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1;
+    bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    ID3D12Resource* rb = NULL;
+    if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&rb)))
+        return -1;
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = surface->tex;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+    D3D12_TEXTURE_COPY_LOCATION src = {0}, dst = {0};
+    src.pResource = surface->tex; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    dst.pResource = rb; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    dst.PlacedFootprint.Footprint.Format = surface->fmt;
+    dst.PlacedFootprint.Footprint.Width = width;
+    dst.PlacedFootprint.Footprint.Height = height;
+    dst.PlacedFootprint.Footprint.Depth = 1;
+    dst.PlacedFootprint.Footprint.RowPitch = pitch;
+    g.list->lpVtbl->CopyTextureRegion(g.list, &dst, 0, 0, 0, &src, NULL);
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+    ld_flush(LD_FLUSH_READBACK);
+    int ret = -1;
+    u8* px = NULL; D3D12_RANGE rr = {0, (SIZE_T)pitch * height};
+    if (SUCCEEDED(rb->lpVtbl->Map(rb, 0, &rr, (void**)&px))) {
+        for (u32 y = 0; y < height; y++)
+            memcpy((u8*)out + (size_t)y * width * texel, px + (size_t)y * pitch, (size_t)width * texel);
+        D3D12_RANGE wr = {0, 0};
+        rb->lpVtbl->Unmap(rb, 0, &wr);
+        if (out_w) *out_w = width;
+        if (out_h) *out_h = height;
+        ret = (int)texel;
+    }
+    rb->lpVtbl->Release(rb);
+    return ret;
+}
