+/* Patch 2014: FP16 textures keep their format. W16Z16Y16X16_FLOAT was decoded
+ * to RGBA8 (clamped to [0,1], negatives to 0), which threw away the HDR range
+ * of the FP16 buffers Killzone 3's composite reads; Y16_X16_FLOAT (0x9F, 172
+ * binds in the first level's frame, pass 11 capture) was not decoded at all
+ * and read SRV_WHITE. Both now upload as R16G16B16A16_FLOAT / R16G16_FLOAT:
+ * each big-endian half is byte-swapped in place, the first half in memory is
+ * D3D component R (X), then G (Y), B (Z), A (W). The RSX remap is not applied
+ * here; write_texture_srv turns it into the SRV component mapping
+ * (ld_float_tex_mapping), so the texels stay bit-exact. 2D and cube, swizzled
+ * or linear, with mips as for the RGBA8 path. */
+static int ld_is_float_tex(u32 base_fmt)
+{
+    return base_fmt == RSX_TEX_FMT_W16Z16Y16X16_FLOAT ||
+           base_fmt == RSX_TEX_FMT_Y16X16_FLOAT;
+}
+static ID3D12Resource* decode_guest_texture_float(const rsx_dsp_texture* t, u32 base_fmt,
+                                                  int linear, u32 n_mips)
+{
+    const u32 w = t->width, h = t->height;
+    const u32 texel = base_fmt == RSX_TEX_FMT_W16Z16Y16X16_FLOAT ? 8u : 4u;
+    const DXGI_FORMAT dxgi = texel == 8u ? DXGI_FORMAT_R16G16B16A16_FLOAT
+                                         : DXGI_FORMAT_R16G16_FLOAT;
+    if (!linear && ((w & (w - 1)) || (h & (h - 1)))) return NULL;
+    const u32 span = texture_source_span(t);
+    const u8* src = span ? guest_ptr(t->location, t->offset, span) : NULL;
+    if (!src) return NULL;
+    u32 available = 1;
+    for (u32 mw = w, mh = h; mw > 1 || mh > 1; available++) {
+        mw = mw > 1 ? mw >> 1 : 1;
+        mh = mh > 1 ? mh >> 1 : 1;
+    }
+    if (n_mips > available) n_mips = available;
+    const u32 faces = t->cubemap ? 6u : 1u;
+    const u32 face_span = span / faces;
+    u8* buf[6 * 14] = {0};
+    tex_level_t lv[6 * 14];
+    u32 n = 0;
+    int oom = 0;
+    for (u32 face = 0; face < faces && !oom; face++) {
+        u32 mw = w, mh = h, off = 0;
+        for (u32 m = 0; m < n_mips; m++) {
+            const u32 pitch = (m == 0 && linear && t->pitch) ? t->pitch : mw * texel;
+            buf[n] = (u8*)malloc((size_t)mw * mh * texel);
+            if (!buf[n]) { oom = 1; break; }
+            const u32 lw = log2_u32(mw), lh = log2_u32(mh);
+            const u8* level_src = src + (size_t)face * face_span + off;
+            for (u32 y = 0; y < mh; y++)
+                for (u32 x = 0; x < mw; x++) {
+                    const u8* px = linear
+                        ? level_src + (size_t)y * pitch + (size_t)x * texel
+                        : level_src + (size_t)morton_index(x, y, lw, lh) * texel;
+                    u8* d = buf[n] + ((size_t)y * mw + x) * texel;
+                    for (u32 k = 0; k < texel; k += 2) { d[k] = px[k + 1]; d[k + 1] = px[k]; }
+                }
+            lv[n].w = mw; lv[n].h = mh; lv[n].data = buf[n];
+            lv[n].row_bytes = mw * texel; lv[n].rows = mh;
+            n++;
+            off += pitch * mh;
+            mw = mw > 1 ? mw >> 1 : 1;
+            mh = mh > 1 ? mh >> 1 : 1;
+        }
+    }
+    ID3D12Resource* res = NULL;
+    if (!oom)
+        res = faces == 6 ? create_texture_cube(dxgi, lv, n_mips)
+                         : create_texture_mipped(dxgi, lv, n);
+    for (u32 i = 0; i < n; i++) free(buf[i]);
+    return res;
+}
+
+/* Patch 2014: SRV component mapping for the float formats from the RSX remap
+ * (ARGB order: comp 0 = A, 1 = R, 2 = G, 3 = B; op 0 = zero, 1 = one,
+ * 2 = source). Source channel sel (A,R,G,B) -> D3D component:
+ * W16Z16Y16X16 A=W(3) R=X(0) G=Y(1) B=Z(2); Y16_X16 has two halves and reads
+ * A=Y G=Y, R=X B=X (ASSUMPTION: the RSX's two-channel fill, as RPCS3 maps
+ * Y16_X16[_FLOAT]; KZ3's binds use remap 0x29E4 = (X, Y, 0, 1) and never
+ * select B or A from the source). */
+static u32 ld_float_tex_mapping(u32 base_fmt, u32 remap)
+{
+    static const u32 sel_rgba[4] = { 3, 0, 1, 2 };
+    static const u32 sel_rg[4]   = { 1, 0, 1, 0 };
+    static const u32 out2comp[4] = { 1, 2, 3, 0 };
+    const u32* sel2d3d = base_fmt == RSX_TEX_FMT_Y16X16_FLOAT ? sel_rg : sel_rgba;
+    u32 mapping = 1u << 12;
+    for (u32 out = 0; out < 4; out++) {
+        const u32 comp = out2comp[out];
+        const u32 op = (remap >> (8 + comp * 2)) & 3;
+        const u32 sel = (remap >> (comp * 2)) & 3;
+        mapping |= (op == 0 ? 4u : op == 1 ? 5u : sel2d3d[sel]) << (out * 3);
+    }
+    return mapping;
+}
