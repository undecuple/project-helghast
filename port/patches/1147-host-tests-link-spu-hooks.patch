--- a/runtime/spu/spu_fpmode.h
+++ b/runtime/spu/spu_fpmode.h
@@ -33,6 +33,17 @@ static inline void spu_fpmode_set_spu(void)
 #endif
 }
 
+/* The same rule as spu_host_fp_init() in spu_drain.c (which the SPURS kernels call), header-inline for the raw SPU and
+ * workload host threads (spu_raw.c, spu_workload.c): a TU that includes either alone links without spu_drain.c.
+ * Called at thread start only, never hot. */
+#include <stdlib.h>
+static inline void spu_fpmode_init_thread(void)
+{
+    static int s_on = -1;
+    if (s_on < 0) s_on = spu_fpmode_env_on(getenv("KZ3_SPU_FTZ"));
+    if (s_on) spu_fpmode_set_spu();
+}
+
