+/* KZ3 patch 4028 (network pass 47; ENHANCEMENT, opt-in, default off): the DSU (cemuhook) motion client, pure
+ * part: the setting's name <-> port, the request packet, the strict parser for a server's pad-data packet, the
+ * conversion to the DS3 SIXAXIS words the game reads (the same words and constants as pad_sdl_sensors in pad_host.h).
+ * The socket part is pad_dsu_io.h. Nothing here touches the network or guest memory.
+ *
+ * Protocol (cemuhook, as implemented by DS4Windows, Steam Deck DSU servers, DSUClient): UDP, little endian.
+ *   header 16 bytes: magic "DSUC" (client) / "DSUS" (server), u16 version 1001, u16 length of what follows the header,
+ *   u32 CRC32 of the whole packet with this field zero, u32 sender id.
+ *   then u32 event type; 0x100002 = pad data. Request body: u8 flags (0 = all slots, 1 = by slot), u8 slot, 6 bytes MAC.
+ *   pad data (100 bytes): 20 slot, 21 slot state, 22 model, 23 connection, 24-29 MAC, 30 battery, 31 connected,
+ *   32 u32 packet number, 36.. buttons / sticks / touch, 68 u64 motion timestamp (us), 76 accel x y z (float, g),
+ *   88 gyro pitch yaw roll (float, deg/s).
+ * Every byte from the server is untrusted (it is on 127.0.0.1, but still another process): the parser checks the
+ * magic, version, length, CRC, event type, slot state and that every float is finite and in a physical range before
+ * anything reaches the pad state. ASSUMPTION: the frame of the server's accel/gyro is the DualShock 4's own as the
+ * common servers pass it on, which is the frame SDL reports for a DS4 (x right, y up with +1 g flat, z toward the
+ * player; gyro positive counter-clockwise); not verified against a real server on hardware. */
+#ifndef KZ3_PAD_DSU_H
+#define KZ3_PAD_DSU_H
+
+#include <stdint.h>
+#include <string.h>
+#include <stdio.h>
+
+#define PDSU_PORT_DEFAULT 26760
+#define PDSU_VERSION 1001
+#define PDSU_EV_DATA 0x100002u
+#define PDSU_DATA_LEN 100
+#define PDSU_REQ_LEN 28
+
+static inline uint32_t pdsu_crc32(const uint8_t* p, unsigned long n)
+{
+    uint32_t c = 0xFFFFFFFFu;
+    unsigned long i;
+    int k;
+    for (i = 0; i < n; i++) {
+        c ^= p[i];
+        for (k = 0; k < 8; k++) c = (c >> 1) ^ (0xEDB88320u & (uint32_t)-(int32_t)(c & 1u));
+    }
+    return ~c;
+}
+static inline void pdsu_put16(uint8_t* p, unsigned v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); }
+static inline void pdsu_put32(uint8_t* p, uint32_t v) { pdsu_put16(p, v & 0xFFFFu); pdsu_put16(p + 2, v >> 16); }
+static inline unsigned pdsu_get16(const uint8_t* p) { return (unsigned)p[0] | ((unsigned)p[1] << 8); }
+static inline uint32_t pdsu_get32(const uint8_t* p) { return pdsu_get16(p) | ((uint32_t)pdsu_get16(p + 2) << 16); }
+static inline float pdsu_getf(const uint8_t* p) { uint32_t u = pdsu_get32(p); float f; memcpy(&f, &u, 4); return f; }
+
+/* setting: "off" (or "0") -> 0, a decimal port 1024..65535 -> the port, anything else -1 */
+static inline int pdsu_port_by_name(const char* s, unsigned long n)
+{
+    unsigned long i;
+    long v = 0;
+    if (n == 3 && (s[0] | 0x20) == 'o' && (s[1] | 0x20) == 'f' && (s[2] | 0x20) == 'f') return 0;
+    if (n == 0 || n > 5) return -1;
+    for (i = 0; i < n; i++) {
+        if (s[i] < '0' || s[i] > '9') return -1;
+        v = v * 10 + (s[i] - '0');
+    }
+    if (v == 0) return 0;
+    return v >= 1024 && v <= 65535 ? (int)v : -1;
+}
+static inline void pdsu_port_name(unsigned port, char* out, unsigned long n)
+{
+    if (!port) snprintf(out, n, "off");
+    else snprintf(out, n, "%u", port);
+}
+
+/* the registration request (pad data of every slot); returns PDSU_REQ_LEN */
+static inline int pdsu_request(uint8_t out[PDSU_REQ_LEN], uint32_t client_id)
+{
+    memset(out, 0, PDSU_REQ_LEN);
+    memcpy(out, "DSUC", 4);
+    pdsu_put16(out + 4, PDSU_VERSION);
+    pdsu_put16(out + 6, 12);   /* event type + flags + slot + MAC */
+    pdsu_put32(out + 12, client_id);
+    pdsu_put32(out + 16, PDSU_EV_DATA);   /* flags 0, slot 0, MAC 0: all slots */
+    pdsu_put32(out + 8, pdsu_crc32(out, PDSU_REQ_LEN));
+    return PDSU_REQ_LEN;
+}
+
+typedef struct { float accel[3]; float gyro[3]; uint64_t ts_us; unsigned slot; } PadDsuSample;
+enum { PDSU_OK = 0, PDSU_SHORT, PDSU_MAGIC, PDSU_VERSION_BAD, PDSU_LENGTH, PDSU_CRC, PDSU_EVENT, PDSU_NOPAD, PDSU_RANGE };
+
+/* parse one datagram of n bytes; PDSU_OK fills *s. Accepted pad data must be connected (byte 31 = 1, slot state 2). */
+static inline int pdsu_parse(const uint8_t* p, unsigned long n, PadDsuSample* s)
+{
+    uint8_t tmp[PDSU_DATA_LEN];
+    uint32_t crc;
+    float v[6];
+    int i;
+    if (n < PDSU_DATA_LEN) return PDSU_SHORT;
+    if (n > PDSU_DATA_LEN) n = PDSU_DATA_LEN;   /* a longer datagram: the first 100 bytes, the length field is checked below */
+    if (memcmp(p, "DSUS", 4)) return PDSU_MAGIC;
+    if (pdsu_get16(p + 4) != PDSU_VERSION) return PDSU_VERSION_BAD;
+    if (pdsu_get16(p + 6) != PDSU_DATA_LEN - 16) return PDSU_LENGTH;
+    memcpy(tmp, p, PDSU_DATA_LEN);
+    crc = pdsu_get32(p + 8);
+    memset(tmp + 8, 0, 4);
+    if (pdsu_crc32(tmp, PDSU_DATA_LEN) != crc) return PDSU_CRC;
+    if (pdsu_get32(p + 16) != PDSU_EV_DATA) return PDSU_EVENT;
+    if (p[21] != 2 || p[31] != 1) return PDSU_NOPAD;
+    for (i = 0; i < 3; i++) {
+        const float a = pdsu_getf(p + 76 + 4 * i), g = pdsu_getf(p + 88 + 4 * i);
+        if (!(a >= -16.0f && a <= 16.0f) || !(g >= -2000.0f && g <= 2000.0f)) return PDSU_RANGE;   /* also rejects NaN */
+        v[i] = a;
+        v[3 + i] = g;
+    }
+    memcpy(s->accel, v, sizeof s->accel);   /* only a fully accepted packet touches the sample */
+    memcpy(s->gyro, v + 3, sizeof s->gyro);
+    s->ts_us = (uint64_t)pdsu_get32(p + 68) | ((uint64_t)pdsu_get32(p + 72) << 32);
+    s->slot = p[20];
+    return PDSU_OK;
+}
+
+/* DS3 SIXAXIS words (10 bits) as pad_sdl_sensors makes them: accel 512 - 113 a/g (flat: Y = 399 at +1 g), gyro G =
+ * 512 - 123 yaw/(90 deg/s) with yaw = the server's second gyro value. w = x, y, z, g. */
+static inline unsigned pdsu_word(float v)
+{
+    float w = v + (v >= 0.0f ? 0.5f : -0.5f);
+    return (unsigned)(w < 0.0f ? 0 : w > 1023.0f ? 1023 : (int)w);
+}
+/* Axis map (data, not code: the DSU reference defines no axis signs, so which server axis feeds which DS3 word is a
+ * setting, [motion] word_x / word_y / word_z / word_g = [+-]ax|ay|az|gx|gy|gz). Entry value: +-(1..3) = accel x/y/z,
+ * +-(4..6) = gyro x/y/z (pitch, yaw, roll); sign = direction. Default = the DS4 mapping described above.
+ * ASSUMPTION: the default is NOT yet checked against a real DSU server. */
+typedef struct { signed char w[4]; } PadDsuMap;
+static inline void pdsu_map_default(PadDsuMap* m) { m->w[0] = 1; m->w[1] = 2; m->w[2] = 3; m->w[3] = 5; }
+/* "+ay", "-gz", "ax" -> entry, 0 if not valid */
+static inline int pdsu_map_by_name(const char* s, unsigned long n)
+{
+    int sg = 1, a;
+    if (n && (s[0] == '+' || s[0] == '-')) { sg = s[0] == '-' ? -1 : 1; s++; n--; }
+    if (n != 2) return 0;
+    a = (s[0] | 0x20) == 'a' ? 0 : (s[0] | 0x20) == 'g' ? 3 : -1;
+    if (a < 0 || (s[1] | 0x20) < 'x' || (s[1] | 0x20) > 'z') return 0;
+    return sg * (a + 1 + ((s[1] | 0x20) - 'x'));
+}
+static inline void pdsu_map_name(int e, char* out, unsigned long n)
+{
+    snprintf(out, n, "%c%c%c", e < 0 ? '-' : '+', (e < 0 ? -e : e) <= 3 ? 'a' : 'g', 'x' + ((e < 0 ? -e : e) - 1) % 3);
+}
+static inline void pdsu_words(const PadDsuSample* s, const PadDsuMap* m, unsigned w[4])
+{
+    int i;
+    for (i = 0; i < 4; i++) {
+        int e = m->w[i], k = e < 0 ? -e : e;
+        float sg = e < 0 ? -1.0f : 1.0f, v;
+        if (k < 1 || k > 6) { w[i] = 512; continue; }
+        v = k <= 3 ? s->accel[k - 1] : s->gyro[k - 4];
+        w[i] = i < 3 ? pdsu_word(512.0f - 113.0f * sg * v) : pdsu_word(512.0f - 123.0f * sg * v / 90.0f);
+    }
+}
