--- a/libs/input/pad_dsu_io.h
+++ b/libs/input/pad_dsu_io.h
@@ -0,0 +1,92 @@
+/* KZ3 patch 4028: the DSU client's socket (see pad_dsu.h). One non-blocking UDP socket, bound to 127.0.0.1 (port chosen
+ * by the system) and connect()ed to 127.0.0.1:<setting>: it can only send to and receive from that address, there is no
+ * way to name another host, and nothing listens on a public interface. Polled from the pad poll (no thread). */
+#ifndef KZ3_PAD_DSU_IO_H
+#define KZ3_PAD_DSU_IO_H
+
+#include "pad_dsu.h"
+#ifdef _WIN32
+  #include <winsock2.h>
+  typedef SOCKET pdsu_sock_t;
+  #define PDSU_BAD INVALID_SOCKET
+  static inline void pdsu_closesock(pdsu_sock_t s) { closesocket(s); }
+  static inline int pdsu_nonblock(pdsu_sock_t s) { u_long on = 1; return ioctlsocket(s, FIONBIO, &on); }
+#else
+  #include <sys/socket.h>
+  #include <netinet/in.h>
+  #include <arpa/inet.h>
+  #include <fcntl.h>
+  #include <unistd.h>
+  typedef int pdsu_sock_t;
+  #define PDSU_BAD (-1)
+  static inline void pdsu_closesock(pdsu_sock_t s) { close(s); }
+  static inline int pdsu_nonblock(pdsu_sock_t s) { return fcntl(s, F_SETFL, fcntl(s, F_GETFL, 0) | O_NONBLOCK); }
+#endif
+
+typedef struct {
+    pdsu_sock_t sock;
+    unsigned port;                 /* the server's port on 127.0.0.1, 0 = closed */
+    unsigned long long next_reg;   /* ms: when to send the next registration */
+    unsigned long long last_ms;    /* ms: the last accepted sample (0 = none yet) */
+    uint32_t client_id;
+    PadDsuSample last;
+    unsigned accepted, rejected;
+} PadDsu;
+
+/* 1 = open (or already open on this port), 0 = failed. Re-opens when the port changes. */
+static inline int pdsu_open(PadDsu* d, unsigned port)
+{
+    struct sockaddr_in a;
+    if (d->port == port && d->sock != PDSU_BAD && port) return 1;
+    if (d->port && d->sock != PDSU_BAD) pdsu_closesock(d->sock);
+    d->port = 0; d->sock = PDSU_BAD; d->last_ms = 0;
+    if (!port || port > 65535u) return 0;
+#ifdef _WIN32
+    { WSADATA w; if (WSAStartup(MAKEWORD(2, 2), &w)) return 0; }
+#endif
+    d->sock = socket(AF_INET, SOCK_DGRAM, 0);
+    if (d->sock == PDSU_BAD) return 0;
+    memset(&a, 0, sizeof a);
+    a.sin_family = AF_INET;
+    a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    a.sin_port = 0;
+    if (bind(d->sock, (struct sockaddr*)&a, sizeof a) || (a.sin_port = htons((unsigned short)port),
+        connect(d->sock, (struct sockaddr*)&a, sizeof a)) || pdsu_nonblock(d->sock)) {
+        pdsu_closesock(d->sock); d->sock = PDSU_BAD;
+        return 0;
+    }
+    d->port = port;
+    d->next_reg = 0;
+    if (!d->client_id) d->client_id = 0x4B5A3300u ^ (uint32_t)(port * 2654435761u);
+    return 1;
+}
+static inline void pdsu_close(PadDsu* d)
+{
+    if (d->port && d->sock != PDSU_BAD) pdsu_closesock(d->sock);
+    d->port = 0; d->sock = PDSU_BAD; d->last_ms = 0;
+}
+
+/* Call from the pad poll with a millisecond clock: registers (first call, then every 1000 ms: a server drops a client
+ * that is silent for longer than a few seconds), takes every datagram waiting (at most 32), keeps the newest accepted
+ * one. Returns 1 when the last accepted sample is younger than 1000 ms. */
+static inline int pdsu_poll(PadDsu* d, unsigned long long now_ms)
+{
+    uint8_t buf[512];
+    int i;
+    if (!d->port || d->sock == PDSU_BAD) return 0;
+    if (now_ms >= d->next_reg) {
+        uint8_t rq[PDSU_REQ_LEN];
+        pdsu_request(rq, d->client_id);
+        send(d->sock, (const char*)rq, PDSU_REQ_LEN, 0);   /* errors (ICMP port unreachable) just mean no server yet */
+        d->next_reg = now_ms + 1000;
+    }
+    for (i = 0; i < 32; i++) {
+        PadDsuSample s;
+        int n = (int)recv(d->sock, (char*)buf, sizeof buf, 0);
+        if (n <= 0) break;
+        if (pdsu_parse(buf, (unsigned long)n, &s) == PDSU_OK) { d->last = s; d->last_ms = now_ms ? now_ms : 1; d->accepted++; }
+        else d->rejected++;
+    }
+    return d->last_ms && now_ms - d->last_ms < 1000;
+}
+#endif
