+/* Patch 2009 (diagnostic, off by default): LD_GAMMA_LOG=1 prints each new
+ * (unit, format, gamma) combination of an enabled fragment texture whose
+ * TEXTURE_ADDRESS gamma bits [23:20] are set, and every new value of
+ * SET_SHADER_PACKER (0x1FBC, sRGB output) and SET_SURFACE_FORMAT (0x208).
+ * Live-draw ignores both (probe: the menu is brighter/yellower than RPCS3). */
+static void ld_gamma_log(u32 unit, const rsx_dsp_texture* t)
+{
+    static int on = -1;
+    if (on < 0) on = getenv("LD_GAMMA_LOG") ? 1 : 0;
+    if (!on) return;
+    static u32 seen[256]; static u32 nseen; static u32 last_packer = ~0u, last_surf = ~0u;
+    static unsigned long long draws, gdraws;
+    const u32 packer = rsx_dsp_reg(&g.rsx, 0x1FBC), surf = rsx_dsp_reg(&g.rsx, 0x208);
+    if (unit == 0) {
+        draws++;
+        if (packer != last_packer || surf != last_surf) {
+            fprintf(stderr, "[gamma] packer=0x%08x surface_format=0x%08x (draw %llu, gamma-tex draws %llu)\n",
+                    packer, surf, draws, gdraws);
+            last_packer = packer; last_surf = surf;
+        }
+    }
+    const u32 gam = (t->wrap >> 20) & 0xF;
+    if (!gam) return;
+    gdraws++;
+    const u32 key = (unit << 16) | (t->format << 8) | gam;
+    for (u32 i = 0; i < nseen; i++) if (seen[i] == key) return;
+    if (nseen < 256) seen[nseen++] = key;
+    fprintf(stderr, "[gamma] unit %u format 0x%02x gamma 0x%x addr 0x%08x (draw %llu)\n",
+            unit, t->format, gam, t->wrap, draws);
+}
