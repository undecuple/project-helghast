Live-draw applies the RSX texture gamma bits: sRGB-to-linear decode on fetch for units whose TEXTURE_ADDRESS [22:20] R/G/B bits are set.

Killzone 3 sets gamma 0x7 on its menu/UI textures (A8R8G8B8 swizzled and linear, DXT45) and on the render surfaces
it samples back (1280x720 scene, 320x180 glow), with SET_SHADER_PACKER sRGB output off. Live-draw ignored the bits,
so the main menu came out brighter than RPCS3 with reds turned yellow and the 3D emblem a bright dotted fill.
rsx_fp_apply_gamma (rsx_fp_decompiler.c) is an HLSL post-pass beside rsx_fp_apply_unnorm_scale: every Sample /
SampleBias / SampleLevel of a gamma unit is wrapped in rsx_srgb(c, float3 mask). The per-unit mask (3 bits per unit)
is part of the PSO key. ASSUMPTION: bits 0/1/2 = R/G/B; the alpha bit is not applied; the decode runs after filtering.
Switches: LD_NO_GAMMA=1 turns the decode off; LD_GAMMA_NO_SURF=1 (diagnostic A/B) skips units that sample a render
surface; LD_GAMMA_LOG=1 prints each new (unit, format, gamma) combination, the units that sample a surface, and
SET_SHADER_PACKER (0x1FBC, ASSUMPTION: the sRGB-output register) / SET_SURFACE_FORMAT values.

Rebased on ps3recomp v0.18.0 (SPU pass 108): PSO key: upstream's VP branch bits then gamma_mask.

diff --git a/libs/video/rsx_fp_decompiler.c b/libs/video/rsx_fp_decompiler.c
index 87cf639c..7f87d76c 100644
--- a/libs/video/rsx_fp_decompiler.c
+++ b/libs/video/rsx_fp_decompiler.c
@@ -1648,6 +1648,73 @@ u32 rsx_fp_code_hash(const u8* ucode, u32 max_bytes)
     return h;
 }
 
+/*
+ * Texture gamma (patch 2009). RSX TEXTURE_ADDRESS bits [23:20] ask the
+ * texture unit to convert sRGB-encoded channels to linear on fetch (RPCS3
+ * fragment_texture::gamma()). Killzone 3 sets 0x7 on its menu/UI textures
+ * (A8R8G8B8 and DXT45) and leaves SET_SHADER_PACKER sRGB output off, so the
+ * linear values are written straight to the RGBA8 surface: without the decode
+ * every gamma texture comes out brighter and its reds turn yellow.
+ * ASSUMPTION: bits 0/1/2 = R/G/B; bit 3 (alpha) is not applied. The decode
+ * runs after filtering, not before as on the hardware.
+ */
+static int fp_insert(char* hlsl, u32 hlsl_size, char* at, const char* text)
+{
+    const u32 tlen = (u32)strlen(text);
+    const u32 used = (u32)strlen(hlsl);
+    if (used + tlen + 1 > hlsl_size) return -1;
+    memmove(at + tlen, at, used - (u32)(at - hlsl) + 1);
+    memcpy(at, text, tlen);
+    return 0;
+}
+
+int rsx_fp_apply_gamma(char* hlsl, u32 hlsl_size, u64 gamma_mask)
+{
+    if (!hlsl || !gamma_mask) return 0;
+    int patched = 0;
+    for (u32 u = 0; u < 16; u++) {
+        const u32 bits = (u32)(gamma_mask >> (u * 3)) & 7u;
+        if (!bits) continue;
+        char needles[2][24];
+        snprintf(needles[0], sizeof needles[0], "rsx_tex[%u].", u);
+        snprintf(needles[1], sizeof needles[1], "rsx_tex%u.", u);
+        char tail[48];
+        snprintf(tail, sizeof tail, ", float3(%u, %u, %u))",
+                 bits & 1u, (bits >> 1) & 1u, (bits >> 2) & 1u);
+        for (int nidx = 0; nidx < 2; nidx++) {
+            for (;;) {
+                char* at = strstr(hlsl, needles[nidx]);
+                if (!at) break;
+                char* open = strchr(at, '(');
+                if (!open) break;
+                int depth = 0;
+                char* p = open;
+                for (; *p; p++) {
+                    if (*p == '(') depth++;
+                    else if (*p == ')') { depth--; if (!depth) break; }
+                }
+                if (*p != ')') break;
+                if (fp_insert(hlsl, hlsl_size, p + 1, tail) < 0) return -1;
+                if (fp_insert(hlsl, hlsl_size, at, "rsx_srgb(") < 0) return -1;
+                at += 9;
+                memcpy(at, "rsx_TEX", 7);   /* done marker, restored below */
+                patched++;
+            }
+        }
+    }
+    for (char* q = hlsl; (q = strstr(q, "rsx_TEX")) != NULL; )
+        memcpy(q, "rsx_tex", 7);
+    if (patched) {
+        static const char helper[] =
+            "float4 rsx_srgb(float4 c, float3 m) {\n"
+            "    float3 l = c.rgb <= 0.04045 ? c.rgb / 12.92 : pow((max(c.rgb, 0.0) + 0.055) / 1.055, 2.4);\n"
+            "    return float4(lerp(c.rgb, l, m), c.a);\n"
+            "}\n";
+        if (fp_insert(hlsl, hlsl_size, hlsl, helper) < 0) return -1;
+    }
+    return patched;
+}
+
