+/* ---------------------------------------------------------------------------
+ * Patch 2017: guest writes live-draw did not issue.
+ *
+ * Live surfaces keep their pixels on the GPU; the guest bytes under them are
+ * whatever was there before (live-draw writes them only for an NV0039 copy,
+ * patch 2015). When the guest (PPU code, SPU DMA, an HLE copy) writes those
+ * bytes after the GPU's last write, real hardware samples the new bytes; a
+ * texture bind that resolves to the live surface sampled the stale host copy.
+ *
+ * Detection without SPU-side changes: a sampled hash of the guest bytes per
+ * band of LD_GV_BAND rows. Baseline after the GPU writes (at the first sample
+ * as a texture, or at the flip, whichever comes first); compare at most once
+ * per frame when the surface is bound as a texture; bands that changed are
+ * converted to the host layout and uploaded into the surface before the draw.
+ * Sampling (LD_GUEST_HASH_STRIDE, default 1024 bytes): per row one 64-byte
+ * chunk per stride window, at a phase that steps by 5 chunks per row, so the 16
+ * rows of a band visit every 64-byte column chunk once: any write that covers
+ * an aligned 64-byte chunk on all rows of a band is always seen; a smaller
+ * write may be missed. LD_GUEST_HASH_STRIDE=0 hashes whole rows.
+ * Exact path: rsx_live_draw_note_guest_write (rsx thread) and
+ * rsx_live_draw_note_guest_write_async (any thread, e.g. SPU DMA) mark the
+ * written rows, which are uploaded at the next bind even in the same frame.
+ * Textures that are not live surfaces keep the per-frame content hash
+ * (texture_srv_slot); the same hooks mark them for a re-hash.
+ * LD_GUEST_WRITE_CHECK=0 disables all of it (negative control).
+ * ASSUMPTION: a write that changes part of a band replaces the whole band with
+ * guest bytes (the rest of those rows comes back as the stale guest bytes, not
+ * the GPU's); guest writes behind the renderer are whole images (SPU post
+ * output, streaming into reused memory). Colour surfaces only (RGBA8, FP16,
+ * F_X32); depth surfaces are not validated.
+ * -------------------------------------------------------------------------*/
+#define LD_GV_BAND 16u
+static int g_gv_on = -1;
+static u32 g_gv_stride = 1024;
+static struct {
+    u64 checks, baselines, uploads_bands, upload_events, explicit_uploads, hashed_bytes, ticks;
+    u64 frame_hashed_bytes, frame_ticks, max_frame_ticks;
+    u32 frames;
+} g_gv;
+static LARGE_INTEGER g_gv_qpf;
+
+static int ld_gv_enabled(void)
+{
+    if (g_gv_on < 0) {
+        const char* e = getenv("LD_GUEST_WRITE_CHECK");
+        g_gv_on = e ? atoi(e) != 0 : 1;
+        const char* st = getenv("LD_GUEST_HASH_STRIDE");
+        if (st) g_gv_stride = (u32)strtoul(st, NULL, 0);
+        if (g_gv_stride && g_gv_stride < 128) g_gv_stride = 128;
+        g_gv_stride &= ~63u;
+        QueryPerformanceFrequency(&g_gv_qpf);
+        fprintf(stderr, "[guest-validate] %s, stride %u bytes (0 = full rows), band %u rows\n",
+                g_gv_on ? "ON" : "OFF (LD_GUEST_WRITE_CHECK=0)", g_gv_stride, LD_GV_BAND);
+    }
+    return g_gv_on;
+}
+
+static inline u64 ld_gv_mix(u64 h, const u8* p, u32 n)
+{
+    u32 i = 0;
+    for (; i + 8 <= n; i += 8) { u64 w; memcpy(&w, p + i, 8); h = (h ^ w) * 1099511628211ull; }
+    for (; i < n; i++) h = (h ^ p[i]) * 1099511628211ull;
+    return h;
+}
+
+static int ld_gv_geometry(const surface_t* s, u32* texel, u32* gp)
+{
+    const u32 t = s->fmt == DXGI_FORMAT_R16G16B16A16_FLOAT ? 8u : 4u;
+    const u32 p = s->pitch ? s->pitch : s->w * t;
+    if (!s->tex || !s->w || !s->h || p < s->w * t) return 0;
+    *texel = t; *gp = p;
+    return 1;
+}
+
+static u32 ld_gv_band_hash(const u8* gm, u32 gp, u32 row_bytes, u32 y0, u32 y1)
+{
+    u64 h = 1469598103934665603ull ^ y0;
+    const u32 windows = g_gv_stride / 64u;
+    for (u32 y = y0; y < y1; y++) {
+        const u8* row = gm + (size_t)y * gp;
+        if (!g_gv_stride || row_bytes <= g_gv_stride) {
+            h = ld_gv_mix(h, row, row_bytes);
+            g_gv.frame_hashed_bytes += row_bytes;
+            continue;
+        }
+        for (u32 o = ((y * 5u) % windows) * 64u; o < row_bytes; o += g_gv_stride) {
+            const u32 n = row_bytes - o < 64u ? row_bytes - o : 64u;
+            h = ld_gv_mix(h, row + o, n);
+            g_gv.frame_hashed_bytes += n;
+        }
+    }
+    return (u32)(h ^ (h >> 32));
+}
+
+/* Recompute the band hashes. changed (optional) gets 1 per band that differs
+ * from the stored baseline. Returns 0 if the guest range is unreadable. */
+static int ld_gv_hash_bands(surface_t* s, u8* changed)
+{
+    u32 texel, gp;
+    if (!ld_gv_geometry(s, &texel, &gp)) return 0;
+    const u8* gm = guest_ptr(s->location, s->offset, gp * (s->h - 1u) + s->w * texel);
+    if (!gm) return 0;
+    const u32 bands = (s->h + LD_GV_BAND - 1u) / LD_GV_BAND;
+    if (bands != s->gv_bands || !s->gv_band) {
+        free(s->gv_band);
+        s->gv_band = (u32*)calloc(bands, sizeof(u32));
+        s->gv_bands = s->gv_band ? bands : 0;
+        if (!s->gv_band) return 0;
+        changed = NULL;
+    }
+    LARGE_INTEGER t0, t1; QueryPerformanceCounter(&t0);
+    for (u32 b = 0; b < bands; b++) {
+        const u32 y0 = b * LD_GV_BAND, y1 = y0 + LD_GV_BAND < s->h ? y0 + LD_GV_BAND : s->h;
+        const u32 hsh = ld_gv_band_hash(gm, gp, s->w * texel, y0, y1);
+        if (changed) changed[b] = hsh != s->gv_band[b];
+        s->gv_band[b] = hsh;
+    }
+    QueryPerformanceCounter(&t1);
+    g_gv.frame_ticks += (u64)(t1.QuadPart - t0.QuadPart);
+    return 1;
+}
+
+static void ld_gv_baseline(surface_t* s)
+{
+    if (ld_gv_hash_bands(s, NULL)) {
+        s->gv_w = s->w; s->gv_h = s->h; s->gv_pitch = s->pitch;
+        g_gv.baselines++;
+    } else {
+        s->gv_w = 0;
+    }
+    s->gv_pending = 0;
+    s->gv_dirty = 0;
+    s->gv_frame = g_ld_frames;
+}
+
+/* Guest rows [y0, y1) of surface s -> host layout -> the surface (RENDER_TARGET
+ * state outside a draw, as rsx_live_draw_debug_read_surface assumes). */
+static int ld_gv_upload_rows(surface_t* s, u32 y0, u32 y1)
+{
+    u32 texel, gp;
+    if (y1 > s->h) y1 = s->h;
+    if (y0 >= y1 || !ld_gv_geometry(s, &texel, &gp)) return 0;
+    const u8* gm = guest_ptr(s->location, s->offset, gp * (s->h - 1u) + s->w * texel);
+    if (!gm) return 0;
+    const u32 rows = y1 - y0, pitch = (s->w * texel + 255u) & ~255u;
+    if ((u64)pitch * rows > UPLOAD_SIZE) return 0;
+    u32 start = (g.upload_used + 511u) & ~511u;
+    if ((u64)start + (u64)pitch * rows > UPLOAD_SIZE) {
+        ld_flush(LD_FLUSH_READBACK);
+        start = 0;
+    }
+    for (u32 y = 0; y < rows; y++) {
+        const u8* sp = gm + (size_t)(y0 + y) * gp;
+        u8* dp = g.upload_mapped + start + (size_t)y * pitch;
+        for (u32 x = 0; x < s->w; x++, sp += texel, dp += texel) {
+            if (s->fmt == DXGI_FORMAT_R8G8B8A8_UNORM) {          /* guest A,R,G,B -> host R,G,B,A */
+                dp[0] = sp[1]; dp[1] = sp[2]; dp[2] = sp[3]; dp[3] = sp[0];
+            } else if (texel == 8) {                             /* BE halves, X first -> LE */
+                for (u32 c = 0; c < 4; c++) { dp[c * 2] = sp[c * 2 + 1]; dp[c * 2 + 1] = sp[c * 2]; }
+            } else {                                             /* R32_FLOAT BE -> LE */
+                dp[0] = sp[3]; dp[1] = sp[2]; dp[2] = sp[1]; dp[3] = sp[0];
+            }
+        }
+    }
+    g.upload_used = start + pitch * rows;
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = s->tex;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+    D3D12_TEXTURE_COPY_LOCATION src = {0}, dst = {0};
+    src.pResource = g.upload; src.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    src.PlacedFootprint.Offset = start;
+    src.PlacedFootprint.Footprint.Format = s->fmt;
+    src.PlacedFootprint.Footprint.Width = s->w;
+    src.PlacedFootprint.Footprint.Height = rows;
+    src.PlacedFootprint.Footprint.Depth = 1;
+    src.PlacedFootprint.Footprint.RowPitch = pitch;
+    dst.pResource = s->tex; dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    g.list->lpVtbl->CopyTextureRegion(g.list, &dst, 0, y0, 0, &src, NULL);
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+    g_gv.uploads_bands += (rows + LD_GV_BAND - 1u) / LD_GV_BAND;
+    return 1;
+}
+
+/* Bring surface i up to date with guest writes made after the GPU's last
+ * write. Returns the number of row ranges uploaded (0 = host copy current). */
+static u32 ld_gv_validate(u32 i)
+{
+    if (i >= g.n_surfaces || !ld_gv_enabled()) return 0;
+    surface_t* s = &g.surfaces[i];
+    if (!s->tex) return 0;
+    u32 uploads = 0;
+    if (s->gv_dirty) {                      /* exact: an explicit hook saw the write */
+        uploads += (u32)ld_gv_upload_rows(s, s->gv_dirty_y0, s->gv_dirty_y1);
+        if (uploads) g_gv.explicit_uploads++;
+        ld_gv_baseline(s);
+        g_gv.upload_events += uploads;
+        return uploads;
+    }
+    if (s->gv_pending || s->gv_w != s->w || s->gv_h != s->h || s->gv_pitch != s->pitch) {
+        ld_gv_baseline(s);
+        return 0;
+    }
+    if (s->gv_frame == g_ld_frames) return 0;    /* compared this frame already */
+    s->gv_frame = g_ld_frames;
+    g_gv.checks++;
+    u8 changed_stack[256];
+    u8* changed = s->gv_bands <= sizeof changed_stack ? changed_stack : (u8*)malloc(s->gv_bands);
+    if (!changed) return 0;
+    const u32 bands = s->gv_bands;
+    if (ld_gv_hash_bands(s, changed)) {
+        for (u32 b = 0; b < bands; ) {
+            if (!changed[b]) { b++; continue; }
+            u32 e = b;
+            while (e < bands && changed[e]) e++;
+            uploads += (u32)ld_gv_upload_rows(s, b * LD_GV_BAND, e * LD_GV_BAND);
+            b = e;
+        }
+    }
+    if (changed != changed_stack) free(changed);
+    if (uploads) {
