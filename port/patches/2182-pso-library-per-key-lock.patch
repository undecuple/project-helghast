diff --git a/libs/video/rsx_pl_lock.h b/libs/video/rsx_pl_lock.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_pl_lock.h
@@ -0,0 +1,93 @@
+/* KZ3 patch 2182 (RSX pass 158): per-key lock around the pipeline-library Load + create + Store of one PSO key.
+ * GPU-free so a host test can drive it with threads (tools/smoke/test_pl_lock.c).
+ *
+ * Why: ld_pl_create is reached from the preload workers, the template workers, the async compile workers and the
+ * walker, and their key sets overlap by design. Two threads missing the library for one key both compiled it and both
+ * called StorePipeline (the second fails; ID3D12PipelineLibrary names are unique), and a Load concurrent with the
+ * Store of the same name has no defined result. rsx_pl_get takes a lock chosen by the key, re-runs the Load under it
+ * (so the thread that waited gets the first thread's stored pipeline instead of compiling again), and creates + stores
+ * only on a miss.
+ *
+ * Lock order: the stripe lock is a LEAF. Inside it only the three callbacks run (library Load, device create, library
+ * Store: D3D12 calls that take no lock of ours). Callers must hold no other LD lock around rsx_pl_get that a callback
+ * could want, and the callbacks must not take any LD lock. Keys of different stripes never wait for each other.
+ */
+#ifndef RSX_PL_LOCK_H
+#define RSX_PL_LOCK_H
+#include <stdint.h>
+#include <string.h>
+#ifdef _WIN32
+#include <windows.h>
+typedef SRWLOCK rsx_pl_mutex;
+#define RSX_PL_MUTEX_INIT(m) InitializeSRWLock(m)
+#define RSX_PL_MUTEX_LOCK(m) AcquireSRWLockExclusive(m)
+#define RSX_PL_MUTEX_TRY(m)  (TryAcquireSRWLockExclusive(m) != 0)
+#define RSX_PL_MUTEX_UNLOCK(m) ReleaseSRWLockExclusive(m)
+#else
+#include <pthread.h>
+typedef pthread_mutex_t rsx_pl_mutex;
+#define RSX_PL_MUTEX_INIT(m) pthread_mutex_init((m), NULL)
+#define RSX_PL_MUTEX_LOCK(m) pthread_mutex_lock(m)
+#define RSX_PL_MUTEX_TRY(m)  (pthread_mutex_trylock(m) == 0)
+#define RSX_PL_MUTEX_UNLOCK(m) pthread_mutex_unlock(m)
+#endif
+
+#define RSX_PL_STRIPES 64u
+
+typedef struct {
+    rsx_pl_mutex mu[RSX_PL_STRIPES];
+    int off;                      /* test-only: 1 = no locking (negative control); the game never sets it */
+    /* run totals ([pso-lib] line); updated with atomic adds */
+    unsigned n_calls;             /* rsx_pl_get calls that reached the library */
+    unsigned n_waits;             /* stripe lock was held by another thread: this caller waited */
+    unsigned n_second_hits;       /* caller had waited and its Load then hit (the first thread's pipeline: no compile) */
+    unsigned n_loads, n_load_hits, n_creates, n_stores, n_store_rejects;
+} rsx_pl_locks;
+
+typedef struct {
+    int (*load)(void* ctx, void** out);          /* 1 = library hit, *out set */
+    int (*create)(void* ctx, void** out);        /* 1 = created, *out set */
+    int (*store)(void* ctx, void* obj);          /* 1 = stored */
+} rsx_pl_ops;
+
+static inline void rsx_pl_locks_init(rsx_pl_locks* L)
+{
+    memset(L, 0, sizeof *L);
+    for (unsigned i = 0; i < RSX_PL_STRIPES; i++) RSX_PL_MUTEX_INIT(&L->mu[i]);
+}
+
+static inline unsigned rsx_pl_stripe(uint64_t key)
+{
+    uint64_t h = key * 0x9E3779B97F4A7C15ull;     /* keys are hashes already; the multiply mixes the low bits */
+    return (unsigned)(h >> 58);                   /* top 6 bits = 64 stripes */
+}
+
+#define RSX_PL_ADD(p) __atomic_fetch_add((p), 1u, __ATOMIC_RELAXED)
+
+/* Returns 1 when *out holds a pipeline (hit_lib = 1 when it came from the library), 0 when the create failed. */
+static inline int rsx_pl_get(rsx_pl_locks* L, uint64_t key, const rsx_pl_ops* ops, void* ctx, void** out, int* hit_lib)
+{
+    rsx_pl_mutex* mu = &L->mu[rsx_pl_stripe(key)];
+    int waited = 0, ok = 0;
+    *hit_lib = 0; *out = NULL;
+    RSX_PL_ADD(&L->n_calls);
+    if (!L->off) {
+        if (!RSX_PL_MUTEX_TRY(mu)) { waited = 1; RSX_PL_ADD(&L->n_waits); RSX_PL_MUTEX_LOCK(mu); }
+    }
+    RSX_PL_ADD(&L->n_loads);
+    if (ops->load(ctx, out) && *out) {
+        RSX_PL_ADD(&L->n_load_hits);
+        if (waited) RSX_PL_ADD(&L->n_second_hits);
+        *hit_lib = 1; ok = 1;
+    } else {
+        *out = NULL;
+        RSX_PL_ADD(&L->n_creates);
+        if (ops->create(ctx, out) && *out) {
+            ok = 1;
+            if (ops->store(ctx, *out)) RSX_PL_ADD(&L->n_stores); else RSX_PL_ADD(&L->n_store_rejects);
+        }
+    }
+    if (!L->off) RSX_PL_MUTEX_UNLOCK(mu);
+    return ok;
+}
+#endif
