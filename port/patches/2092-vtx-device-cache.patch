@@ -0,0 +1,149 @@
+/* KZ3 patch 2092: device-resident vertex cache, the parts that need no D3D12 (host-tested by
+ * tools/smoke/test_vtx_dev.sh).
+ *
+ * 1. rsx_vd_arena: an allocator over one DEFAULT-heap buffer. A block freed while command lists that may read it
+ *    are still queued goes to a pending list tagged with the fence value those lists signal; it becomes free again
+ *    only when the completed fence value reaches the tag (rsx_vd_reclaim). Free extents are kept sorted and
+ *    coalesced; allocation is first fit in RSX_VD_ALIGN units.
+ * 2. rsx_vd_pages_written: the tracked-write test of patch 2047 (64 KB pages: a bit in the live bitmap = written
+ *    since the last flip; a stamp = 1 + the last frame a write was seen in) as a pure function.
+ * 3. rsx_vd_validate: the hit rule. A filled entry is a hit only when no tracked writer touched any source span
+ *    since the fill AND every merged source span still equals the copy taken at the fill (byte compare: recompiled
+ *    PPU stores into main memory note nothing, pass 48/49, so the compare is what makes a hit exact; the page notes
+ *    only reject known-written entries early and mark entries dynamic). */
+#ifndef RSX_VTX_DEV_H
+#define RSX_VTX_DEV_H
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define RSX_VD_ALIGN 256u
+#define RSX_VD_NONE 0xFFFFFFFFu
+
+typedef struct { uint32_t off, len; } rsx_vd_ext;
+typedef struct { uint32_t off, len; uint64_t fence; } rsx_vd_pend;
+typedef struct {
+    uint32_t size;
+    rsx_vd_ext* fr; uint32_t n_fr, cap_fr;    /* free extents, sorted by off, never adjacent */
+    rsx_vd_pend* pd; uint32_t n_pd, cap_pd;   /* freed blocks waiting for their fence (tags non-decreasing) */
+    uint64_t used;                            /* bytes allocated (pending blocks count as used) */
+} rsx_vd_arena;
+
+static inline uint32_t rsx_vd_round(uint32_t n) { return (n + RSX_VD_ALIGN - 1u) & ~(RSX_VD_ALIGN - 1u); }
+
+static inline int rsx_vd_init(rsx_vd_arena* a, uint32_t size)
+{
+    memset(a, 0, sizeof *a);
+    a->size = size & ~(RSX_VD_ALIGN - 1u);
+    a->cap_fr = 64u;
+    a->fr = (rsx_vd_ext*)malloc(a->cap_fr * sizeof a->fr[0]);
+    if (!a->fr) return 0;
+    a->fr[0].off = 0; a->fr[0].len = a->size; a->n_fr = a->size ? 1u : 0u;
+    return 1;
+}
+static inline void rsx_vd_destroy(rsx_vd_arena* a) { free(a->fr); free(a->pd); memset(a, 0, sizeof *a); }
+
+/* First fit; RSX_VD_NONE when no extent is large enough. */
+static inline uint32_t rsx_vd_alloc(rsx_vd_arena* a, uint32_t len)
+{
+    len = rsx_vd_round(len ? len : 1u);
+    for (uint32_t i = 0; i < a->n_fr; i++) {
+        if (a->fr[i].len < len) continue;
+        const uint32_t off = a->fr[i].off;
+        a->fr[i].off += len; a->fr[i].len -= len;
+        if (!a->fr[i].len) { memmove(a->fr + i, a->fr + i + 1, (a->n_fr - i - 1u) * sizeof a->fr[0]); a->n_fr--; }
+        a->used += len;
+        return off;
+    }
+    return RSX_VD_NONE;
+}
+
+/* Back into the free list at once (no reader can be queued). 0 = out of memory for the extent list. */
+static inline int rsx_vd_free_now(rsx_vd_arena* a, uint32_t off, uint32_t len)
+{
+    len = rsx_vd_round(len ? len : 1u);
+    uint32_t lo = 0, hi = a->n_fr;   /* first extent with off > this one */
+    while (lo < hi) { const uint32_t m = (lo + hi) / 2u; if (a->fr[m].off < off) lo = m + 1u; else hi = m; }
+    const int join_prev = lo > 0 && a->fr[lo - 1].off + a->fr[lo - 1].len == off;
+    const int join_next = lo < a->n_fr && off + len == a->fr[lo].off;
+    if (join_prev && join_next) {
+        a->fr[lo - 1].len += len + a->fr[lo].len;
+        memmove(a->fr + lo, a->fr + lo + 1, (a->n_fr - lo - 1u) * sizeof a->fr[0]); a->n_fr--;
+    } else if (join_prev) a->fr[lo - 1].len += len;
+    else if (join_next) { a->fr[lo].off = off; a->fr[lo].len += len; }
+    else {
+        if (a->n_fr == a->cap_fr) {
+            rsx_vd_ext* n = (rsx_vd_ext*)realloc(a->fr, 2u * a->cap_fr * sizeof a->fr[0]);
+            if (!n) return 0;
+            a->fr = n; a->cap_fr *= 2u;
+        }
+        memmove(a->fr + lo + 1, a->fr + lo, (a->n_fr - lo) * sizeof a->fr[0]);
+        a->fr[lo].off = off; a->fr[lo].len = len; a->n_fr++;
+    }
+    a->used -= len;
+    return 1;
+}
+
+/* Freed once the GPU has completed `fence` (the value the lists that may still read the block will signal). */
+static inline int rsx_vd_free_later(rsx_vd_arena* a, uint32_t off, uint32_t len, uint64_t fence)
+{
+    if (a->n_pd == a->cap_pd) {
+        const uint32_t c = a->cap_pd ? 2u * a->cap_pd : 256u;
+        rsx_vd_pend* n = (rsx_vd_pend*)realloc(a->pd, c * sizeof a->pd[0]);
+        if (!n) return 0;
+        a->pd = n; a->cap_pd = c;
+    }
+    a->pd[a->n_pd].off = off; a->pd[a->n_pd].len = len; a->pd[a->n_pd].fence = fence; a->n_pd++;
+    return 1;
+}
+
+/* Every pending block whose fence is <= completed goes back to the free list. Returns the bytes reclaimed. */
+static inline uint64_t rsx_vd_reclaim(rsx_vd_arena* a, uint64_t completed)
+{
+    uint32_t i = 0; uint64_t bytes = 0;
+    while (i < a->n_pd && a->pd[i].fence <= completed) {
+        if (!rsx_vd_free_now(a, a->pd[i].off, a->pd[i].len)) break;
+        bytes += rsx_vd_round(a->pd[i].len ? a->pd[i].len : 1u); i++;
+    }
+    if (i) { memmove(a->pd, a->pd + i, (a->n_pd - i) * sizeof a->pd[0]); a->n_pd -= i; }
+    return bytes;
+}
+
+/* Patch 2047's tracked-write rule. td_live: bit per 64 KB page written since the last flip; stamps: 1 + the
+ * last frame each page was written in (set at the flip). Written since `since_frame`? */
+static inline int rsx_vd_pages_written(const uint32_t* td_live, const uint32_t* stamps, uint32_t off, uint32_t len,
+                                       uint32_t since_frame)
+{
+    if (!len) return 1;
+    const uint64_t end = (uint64_t)off + len - 1u;
+    const uint32_t p0 = off >> 16, p1 = (uint32_t)(end > 0xFFFFFFFFull ? 0xFFFFFFFFull : end) >> 16;
+    for (uint32_t p = p0; ; p++) {
+        if (td_live[p >> 5] & (1u << (p & 31u))) return 1;
+        if (stamps[p] > since_frame) return 1;
+        if (p == p1) break;
+    }
+    return 0;
+}
+
+typedef struct { uint32_t loc, off, len; } rsx_vd_span;
+enum { RSX_VD_HIT = 0, RSX_VD_TRACKED = 1, RSX_VD_CONTENT = 2 };
+/* written(ctx, span, since): a tracked write touched the span since the frame; ptr(ctx, span): host bytes of the
+ * span or NULL. spans = the per-attribute/index source ranges, cmp = the same merged per location, copy = the
+ * bytes of every cmp span at the fill, back to back. *cmp_bytes += the bytes compared. */
+static inline int rsx_vd_validate(const rsx_vd_span* spans, uint32_t n_spans, const rsx_vd_span* cmp, uint32_t n_cmp,
+                                  const uint8_t* copy, uint32_t since_frame,
+                                  int (*written)(void*, const rsx_vd_span*, uint32_t),
+                                  const uint8_t* (*ptr)(void*, const rsx_vd_span*), void* ctx, uint64_t* cmp_bytes)
+{
+    for (uint32_t i = 0; i < n_spans; i++)
+        if (written(ctx, &spans[i], since_frame)) return RSX_VD_TRACKED;
+    for (uint32_t i = 0; i < n_cmp; i++) {
+        const uint8_t* p = ptr(ctx, &cmp[i]);
+        if (cmp_bytes) *cmp_bytes += cmp[i].len;
+        if (!p || memcmp(p, copy, cmp[i].len)) return RSX_VD_CONTENT;
+        copy += cmp[i].len;
+    }
+    return RSX_VD_HIT;
+}
+
+#endif /* RSX_VTX_DEV_H */
