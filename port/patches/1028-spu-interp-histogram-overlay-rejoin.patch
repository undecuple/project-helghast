+/* KZ3 patch 1028: the rejoin probe. A WWS job module the policy module (image 2)
+ * runs is registered under its own overlay image (resident_ovl), so probing
+ * image 2 alone never finds the job's lifted functions: once a job fell into the
+ * interpreter it stayed there to its end. Probe the resident overlay first, as
+ * SPU_DRAIN's resume does (spu_drain.c); SPU_INTERP_OVL_REJOIN=0 restores the old
+ * probe. */
+static int s_ovl_rejoin = -1;
+static spu_lifted_fn spu_interp_rejoin_lookup(const spu_context* ctx, uint32_t pc) {
+    if (s_ovl_rejoin < 0) { const char* e = getenv("SPU_INTERP_OVL_REJOIN"); s_ovl_rejoin = (e && *e == '0') ? 0 : 1; }
+    if (s_ovl_rejoin && ctx->resident_ovl && pc >= 0x4000) {
+        extern spu_lifted_fn spu_lookup_ovl_exact(uint32_t addr, int image_id);
+        spu_lifted_fn f = spu_lookup_ovl_exact(pc, ctx->resident_ovl);
+        if (f) return f;
+    }
+    return spu_lifted_lookup(ctx, pc);
+}
