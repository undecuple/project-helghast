+/* KZ3 patch 1028: exact-image probe for the interpreter's rejoin (no image-0
+ * wildcard, no cross-image report): is there a lifted function of THIS overlay
+ * image at addr? */
+spu_fn spu_lookup_ovl_exact(uint32_t addr, int image_id)
+{
+    for (uint32_t n = s_hash_head[spu_fn_hash(addr)]; n; n = s_hash_next[n - 1]) {
+        const spu_reg_entry* e = &s_registry[n - 1];
+        if (e->addr == addr && e->image_id == image_id) return e->fn;
+    }
+    return NULL;
+}
