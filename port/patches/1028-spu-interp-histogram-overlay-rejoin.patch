+/* KZ3 patch 1028: which code runs interpreted, and for how long.
+ * SPU_INTERP_HIST=1 keys every interpreter entry by (image, resident overlay,
+ * start pc, WWS code buffer LS[0x1320], overlay signature match there) and adds
+ * up calls, steps and host time; every 10 s it prints the interpreted share of
+ * the window and the top entries (cumulative). */
+#include <time.h>
+#include <string.h>
+typedef struct { int img, ovl, sig; uint32_t start, cb, lo, hi, w0; uint64_t calls, steps, ns; } spu_ih_ent;
+static spu_ih_ent s_ih[256]; static int s_ih_n = 0, s_ih_on = -1; static volatile int s_ih_lock = 0;
+static uint64_t s_ih_t0 = 0, s_ih_last = 0, s_ih_win_ns = 0, s_ih_win_steps = 0, s_ih_win_calls = 0;
+#ifdef _WIN32
+__declspec(dllimport) int __stdcall QueryPerformanceCounter(long long* c);
+__declspec(dllimport) int __stdcall QueryPerformanceFrequency(long long* f);
+static uint64_t spu_ih_now(void) { static long long f = 0; long long c; if (!f) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c); return (uint64_t)((double)c * 1e9 / (double)f); }
+#else
+static uint64_t spu_ih_now(void) { struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec; }
+#endif
+static uint32_t spu_ih_be(const spu_context* c, uint32_t o) { o &= 0x3FFFC;
+    return ((uint32_t)c->ls[o]<<24)|((uint32_t)c->ls[o+1]<<16)|((uint32_t)c->ls[o+2]<<8)|c->ls[o+3]; }
+static void spu_ih_note(const spu_context* ctx, uint32_t start, uint64_t steps, uint64_t t0, uint32_t lo, uint32_t hi) {
+    extern int spu_overlay_match_sig(const uint8_t hdr[16]);
+    uint64_t t1 = spu_ih_now(), dt = t1 - t0;
+    uint32_t cb = spu_ih_be(ctx, 0x1320) & 0x3FFF0;
+    int sig = (cb + 16 <= 0x40000) ? spu_overlay_match_sig(&ctx->ls[cb]) : 0;
+    while (__atomic_exchange_n(&s_ih_lock, 1, __ATOMIC_ACQUIRE)) {}
+    if (!s_ih_t0) { s_ih_t0 = s_ih_last = t0; }
+    s_ih_win_ns += dt; s_ih_win_steps += steps; s_ih_win_calls++;
+    int i;
+    for (i = 0; i < s_ih_n; i++) { spu_ih_ent* e = &s_ih[i];
+        if (e->img == ctx->image_id && e->ovl == ctx->resident_ovl && e->start == start && e->cb == cb && e->sig == sig) break; }
+    if (i == s_ih_n && s_ih_n < 256) { spu_ih_ent* e = &s_ih[s_ih_n++]; memset(e, 0, sizeof *e);
+        e->img = ctx->image_id; e->ovl = ctx->resident_ovl; e->start = start; e->cb = cb; e->sig = sig;
+        e->lo = lo; e->hi = hi; e->w0 = spu_ih_be(ctx, start); }
+    if (i < 256 && i < s_ih_n) { spu_ih_ent* e = &s_ih[i]; e->calls++; e->steps += steps; e->ns += dt;
+        if (lo < e->lo) e->lo = lo; if (hi > e->hi) e->hi = hi; }
+    if (t1 - s_ih_last >= 10000000000ull) {
+        uint64_t win = t1 - s_ih_last;
+        fprintf(stderr, "[interp-hist] t=%llus window %llu ms: interpreted %llu ms (%.1f%% of one thread), %llu entries, %llu steps (%.1f M/s)\n",
+                (unsigned long long)((t1 - s_ih_t0) / 1000000000ull), (unsigned long long)(win / 1000000ull),
+                (unsigned long long)(s_ih_win_ns / 1000000ull), 100.0 * (double)s_ih_win_ns / (double)win,
+                (unsigned long long)s_ih_win_calls, (unsigned long long)s_ih_win_steps,
+                (double)s_ih_win_steps * 1000.0 / (double)(s_ih_win_ns ? s_ih_win_ns : 1));
+        int used[256] = {0};
+        for (int k = 0; k < 12; k++) { int b = -1;
+            for (int j = 0; j < s_ih_n; j++) if (!used[j] && (b < 0 || s_ih[j].ns > s_ih[b].ns)) b = j;
+            if (b < 0) break; used[b] = 1; spu_ih_ent* e = &s_ih[b];
+            fprintf(stderr, "[interp-hist]   img=%d ovl=%d start=0x%05X w0=%08X cb=0x%05X sig=%d pc=0x%05X-0x%05X calls=%llu steps=%llu ms=%llu\n",
+                    e->img, e->ovl, e->start, e->w0, e->cb, e->sig, e->lo, e->hi, (unsigned long long)e->calls,
+                    (unsigned long long)e->steps, (unsigned long long)(e->ns / 1000000ull)); }
+        s_ih_last = t1; s_ih_win_ns = s_ih_win_steps = s_ih_win_calls = 0;
+    }
+    __atomic_store_n(&s_ih_lock, 0, __ATOMIC_RELEASE);
+}
