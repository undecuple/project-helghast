@@ -587,6 +591,7 @@ int spu_taskset_join_wait(uint32_t taskset_ea)
                 memset(s_ts_run[i].running, 0, sizeof s_ts_run[i].running);
             }
             ts_unlock();
+            if (parked > 0) { extern void spu_taskset_wake_waiters(void); spu_taskset_wake_waiters(); }   /* 1067 */
             break;
         }
         ts_unlock();
@@ -1602,6 +1607,16 @@ void spu_taskset_line_committed(uint32_t line)
 /* WAIT_SIGNAL from the task side (runs ON the task's host thread, called by
  * the 0xA70 taskset-syscall intercept). Consumes a pending signal or blocks
  * until one is delivered. Returns 0 (the syscall's success rc). */
+/* KZ3 patch 1067: wake every WAIT_SIGNAL waiter to re-check its condition (a cut-off one then leaves). */
+void spu_taskset_wake_waiters(void)
+{
+#ifdef _WIN32
+    AcquireSRWLockExclusive(&s_sig_lock); WakeAllConditionVariable(&s_sig_cv); ReleaseSRWLockExclusive(&s_sig_lock);
+#else
+    pthread_mutex_lock(&s_sig_lock); pthread_cond_broadcast(&s_sig_cv); pthread_mutex_unlock(&s_sig_lock);
+#endif
+}
+
