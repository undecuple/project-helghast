+/* KZ3 patch 1154: task thread pool (KZ3_SPU_TASK_POOL=1, default off). Every cellSpursCreateTask started a host thread
+ * (256 MB stack reservation, detached) and the thread ended with its task. Creating a thread is the largest part of
+ * the PPU's cost of a create (the bookkeeping around it is a few microseconds; about 15-35 us per thread on Linux,
+ * more under Wine, where a thread start is several wineserver round trips), and the KZ3 main thread creates ~390
+ * tasks a second. With the pool a task thread, when its job is over, parks and the next job is handed to it: same
+ * job function, same stack-range cleanup after each job, same per-job thread setup (fpmode, ids, taskset binding,
+ * KZ3 patch 1072 record) done inside spu_async_run. What a parked thread keeps is its thread-local counters that
+ * are statistics only, plus the YDKJ cri EXIT count (spu_channels.c, image 22), which is per thread, not per job:
+ * a title that runs image 22 leaves the switch off. Threads are created only when none is parked, so their number
+ * is the peak number of concurrent tasks; nothing times out or is capped. */
+static int spu_task_pool_on(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("KZ3_SPU_TASK_POOL"); v = (e && *e && *e != '0') ? 1 : 0; }
+    return v;
+}
+typedef struct spu_pool_worker {
+    struct spu_pool_worker* next;
+    spu_async_job* job;
+#ifdef _WIN32
+    ps3_evcv cv;   /* patch 1148: never ntdll's futex queue */
+#else
+    pthread_cond_t cv;
+#endif
+} spu_pool_worker;
+#ifdef _WIN32
+static SRWLOCK s_pool_lock = SRWLOCK_INIT;
+#define POOL_LOCK()   AcquireSRWLockExclusive(&s_pool_lock)
+#define POOL_UNLOCK() ReleaseSRWLockExclusive(&s_pool_lock)
+#else
+static pthread_mutex_t s_pool_lock = PTHREAD_MUTEX_INITIALIZER;
+#define POOL_LOCK()   pthread_mutex_lock(&s_pool_lock)
+#define POOL_UNLOCK() pthread_mutex_unlock(&s_pool_lock)
+#endif
+static spu_pool_worker* s_pool_idle;          /* parked workers, most recently parked first */
+unsigned long g_spu_pool_reused, g_spu_pool_created;   /* statistics (host test, [spu-pool]) */
+
+/* Hand the job to a parked worker. 0 when none is parked (the caller creates a thread). */
+static int spu_pool_handoff(spu_async_job* j)
+{
+    POOL_LOCK();
+    spu_pool_worker* w = s_pool_idle;
+    if (w) { s_pool_idle = w->next; w->job = j; __atomic_fetch_add(&g_spu_pool_reused, 1, __ATOMIC_RELAXED); }
+    POOL_UNLOCK();
+    if (!w) return 0;
+#ifdef _WIN32
+    ps3_evcv_wake_one(&w->cv);
+#else
+    pthread_cond_signal(&w->cv);
+#endif
+    return 1;
+}
+/* A worker whose job is over parks here until it is handed the next one. */
+static spu_async_job* spu_pool_park(spu_pool_worker* w)
+{
+    POOL_LOCK();
+    w->job = NULL; w->next = s_pool_idle; s_pool_idle = w;
+    while (!w->job) {
+#ifdef _WIN32
+        ps3_evcv_sleep_srw(&w->cv, &s_pool_lock, INFINITE);
+#else
+        pthread_cond_wait(&w->cv, &s_pool_lock);
+#endif
+    }
+    spu_async_job* j = w->job;
+    POOL_UNLOCK();
+    return j;
+}
+
+/* One job on the calling task thread, and what the thread leaves behind. */
+static void spu_async_thread_job(spu_async_job* j)
+{
+    spu_async_run(j);
+#ifdef _WIN32
+    /* Nothing on this stack may stay in the lock-line reserver set. */
+    { ULONG_PTR lo, hi; GetCurrentThreadStackLimits(&lo, &hi);
+      extern void spu_coh_forget_range(uintptr_t, uintptr_t);
+      spu_coh_forget_range((uintptr_t)lo, (uintptr_t)hi);
+      spu_mfc_forget_range((uintptr_t)lo, (uintptr_t)hi); }
+#endif
+}
+static void spu_async_thread_main(spu_async_job* j)
+{
+    if (!spu_task_pool_on()) { spu_async_thread_job(j); return; }
+    spu_pool_worker w;
+    memset(&w, 0, sizeof w);
+#ifdef _WIN32
+    ps3_evcv_init(&w.cv);
+#else
+    pthread_cond_init(&w.cv, NULL);
+#endif
+    for (;;) { spu_async_thread_job(j); j = spu_pool_park(&w); }
+}
+
