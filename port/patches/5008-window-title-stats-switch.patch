+/* KZ3 patch 5008: the "| FPS | draws | WxH" caption suffix is a diagnostic, off by default (the title reads just the
+ * game's name). KZ3_TITLE_STATS=1 turns it back on. */
+static int kz3_title_stats(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("KZ3_TITLE_STATS"); on = (e && e[0] && e[0] != '0') ? 1 : 0; }
+    return on;
+}
