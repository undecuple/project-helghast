--- a/libs/video/rsx_tex_samef.h	1969-12-31 18:00:00.000000000 -0600
+++ b/libs/video/rsx_tex_samef.h	1969-12-31 18:00:00.000000000 -0600
@@ -0,0 +1,29 @@
+/* KZ3 patch 2137 (RSX pass 129): per-64 KB-page write sequence for the same-frame texture re-check (RSX_TEX_SAMEF).
+ * Every tracked write (ld_td_mark) takes the next value of a global counter and stamps the pages it covers with it.
+ * A texture entry records the counter just before its hash read the guest bytes; at a later bind in the SAME frame a
+ * page stamped after that value means a tracked writer landed after the hash, so the entry is re-hashed (the bitmap
+ * flip alone only flags it for the next frame: one frame late). Sequences are wrap-safe, 0 = never stamped.
+ * Host test: tools/smoke/test_tex_samef.sh. */
+#pragma once
+#include <stdint.h>
+#define LD_SF_PAGES 65536u   /* 64 KB pages over a 4 GB offset space */
+
+static inline void ld_sf_stamp(uint32_t* pg, uint32_t offset, uint32_t size, uint32_t seq)
+{
+    if (!size) return;
+    const uint64_t end = (uint64_t)offset + size - 1u;
+    const uint32_t p0 = offset >> 16, p1 = (uint32_t)(end > 0xFFFFFFFFull ? 0xFFFFFFFFull : end) >> 16;
+    for (uint32_t p = p0; ; p++) { pg[p] = seq; if (p == p1) break; }
+}
+/* Is any page of [offset, offset+span) stamped after `since`? span 0 = unknown, never claimed. */
+static inline int ld_sf_after(const uint32_t* pg, uint32_t offset, uint32_t span, uint32_t since)
+{
+    if (!span) return 0;
+    const uint64_t end = (uint64_t)offset + span - 1u;
+    const uint32_t p0 = offset >> 16, p1 = (uint32_t)(end > 0xFFFFFFFFull ? 0xFFFFFFFFull : end) >> 16;
+    for (uint32_t p = p0; ; p++) {
+        if (pg[p] != 0 && (int32_t)(pg[p] - since) > 0) return 1;
+        if (p == p1) break;
+    }
+    return 0;
+}
