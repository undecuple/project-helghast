+static void ld_pt_build(u32 ri, char* vs_hlsl, char* ps_hlsl, rsx_fp_constant_block* cb)
+{
+    const rsx_pt_rec* r = &g_pt.in[ri];
+    const ld_pt_prog* vp = &g_pt.vp[g_pt.rec_vp[ri]];
+    const ld_pt_prog* fp = &g_pt.fp[g_pt.rec_fp[ri]];
+    render_state_t rs;
+    if (r->rs_words != sizeof rs / 4u) { InterlockedIncrement(&g_pt.failed_xlate); return; }
+    memcpy(&rs, r->rs, sizeof rs);
+    rsx_vertex_layout_plan lay; memset(&lay, 0, sizeof lay);
+    const int masked = (r->flags & RSX_PT_FLAG_LAYOUT) != 0;
+    if (masked) { lay.mask = r->layout_mask; lay.stride = r->layout_stride; lay.count = (u8)r->layout_count;
+                  memcpy(lay.attrs, r->attrs, sizeof lay.attrs); }
+    const int fc = rsx_fp_collect_constants(fp->bytes, fp->size, cb);
+    if (fc < 0) { InterlockedIncrement(&g_pt.failed_xlate); return; }
+    ld_xl_in xi; memset(&xi, 0, sizeof xi);
+    xi.vp_uc = vp->bytes; xi.vp_instrs = r->vp_instrs; xi.vp_start = r->vp_start;
+    xi.layout = masked ? &lay : NULL; xi.vtex_mask = r->vtex_mask;
+    xi.fp_uc = fp->bytes; xi.fp_size = fp->size; xi.fp_ctrl = r->fp_ctrl; xi.cube_mask = r->cube_mask;
+    u8 zf[16]; u16 remap[16]; u32 unn[16][3] = {{0}};   /* copies: the record is packed */
+    memcpy(zf, r->shadow_zfunc, sizeof zf); memcpy(remap, r->argb_remap, sizeof remap);
+    for (int u = 0; u < 16; u++) { unn[u][0] = r->unnorm_dim[u][0]; unn[u][1] = r->unnorm_dim[u][1]; }
+    xi.rs = &rs; xi.shadow_mask = r->shadow_mask; xi.shadow_zfunc = zf;
+    xi.unnorm_mask = r->unnorm_mask; xi.unnorm_dim = unn; xi.gamma_mask = r->gamma_mask;
+    xi.argb_mask = r->argb_mask; xi.argb_remap = remap; xi.srgb_out = r->srgb_out;
+    xi.fp_const_count = (u32)fc; xi.fp_alpha_ref = 0;
+    {   /* the record's key must be what the walker derives from these programs and this state */
+        const u64 fh = rsx_fp_structural_hash(fp->bytes, fp->size, r->vp_hash);
+        if (!fh || ld_pso_key_tail(fh, &xi, (r->flags & RSX_PT_FLAG_PACKED) != 0, NULL) != r->key) {
+            InterlockedIncrement(&g_pt.failed_key); return;
+        }
+    }
+    const LONGLONG t0 = ld_pt_qpc();
+    int vi = 0, fi = 0;
+    ld_xlate(&xi, vs_hlsl, 256u * 1024u, ps_hlsl, 256u * 1024u, &vi, &fi);
+    if (vi <= 0 || fi <= 0) { InterlockedIncrement(&g_pt.failed_xlate); return; }
+    ID3DBlob* vs = ld_pt_blob('V', vs_hlsl, (u32)strlen(vs_hlsl));
+    ID3DBlob* ps = vs ? ld_pt_blob('P', ps_hlsl, (u32)strlen(ps_hlsl)) : NULL;
+    if (!vs || !ps) { if (vs) vs->lpVtbl->Release(vs); InterlockedIncrement(&g_pt.failed_blob); return; }
+    D3D12_INPUT_ELEMENT_DESC il[16];
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd;
+    ld_pso_desc_fill(&pd, il, vs, ps, &rs, masked ? r->layout_count : RSX_DSP_NUM_VERTEX_ATTR, r->attrs,
+                     masked, (r->flags & RSX_PT_FLAG_PACKED) != 0, (r->flags & RSX_PT_FLAG_DEPTH) != 0);
+    ID3D12PipelineState* pso = NULL;
+    int lib_hit = 0;
+    const LONGLONG tc = ld_pt_qpc();
+    const HRESULT hr = ld_pl_create(&pd, &rs, r->key, &pso, &lib_hit);
+    const unsigned long long cus = (unsigned long long)((ld_pt_qpc() - tc) * 1000000 / g_pt.qpf);
+    vs->lpVtbl->Release(vs); ps->lpVtbl->Release(ps);
+    EnterCriticalSection(&g_pt.cs);
+    g_pt.create_us += cus; g_pt.xlate_us += (unsigned long long)((tc - t0) * 1000000 / g_pt.qpf);
+    LeaveCriticalSection(&g_pt.cs);
+    if (FAILED(hr) || !pso) { InterlockedIncrement(&g_pt.failed_pso); return; }
+    if (lib_hit) InterlockedIncrement(&g_pt.lib_hits);
+    InterlockedIncrement(&g_pt.built);
+    ld_pl_stage(r->key, pso, 2);
+    InterlockedIncrement(&g_pt.staged);
+}
+
+static DWORD WINAPI ld_pt_worker(LPVOID arg)
+{
+    (void)arg;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    char* vs = (char*)malloc(256u * 1024u);
+    char* ps = (char*)malloc(256u * 1024u);
+    rsx_fp_constant_block* cb = (rsx_fp_constant_block*)malloc(sizeof *cb);
+    for (;;) {
+        WaitForSingleObject(g_pt.sem, INFINITE);
+        u32 ri = 0xFFFFFFFFu;
+        EnterCriticalSection(&g_pt.cs);
+        if (g_pt.q_head != g_pt.q_tail) ri = g_pt.q[g_pt.q_head++];
+        LeaveCriticalSection(&g_pt.cs);
+        if (g_pt.stop) break;
+        if (ri != 0xFFFFFFFFu && vs && ps && cb) ld_pt_build(ri, vs, ps, cb);
+    }
+    free(vs); free(ps); free(cb);
+    return 0;
+}
+
+static void ld_pt_hit(void* user, const u8* p, size_t remaining, uint32_t kind, uint32_t id)
+{
+    (void)user;
+    if (kind == 0) {
+        ld_pt_prog* t = &g_pt.vp[id];
+        if (t->bytes || remaining < t->size) return;
+        u8* host = (u8*)malloc(t->size + LD_PT_FP_PAD);
+        if (!host) return;
+        for (u32 k = 0; k < t->size / 4u; k++) {
+            host[4*k] = p[4*k+3]; host[4*k+1] = p[4*k+2]; host[4*k+2] = p[4*k+1]; host[4*k+3] = p[4*k];
+        }
+        memset(host + t->size, 0, LD_PT_FP_PAD);
+        if (fnv1a(host, t->size, 1469598103934665603ull) == t->hash) { t->bytes = host; g_pt.vp_found++; }
+        else free(host);
+    } else {
+        ld_pt_prog* t = &g_pt.fp[id];
+        if (t->bytes) return;
+        const u32 lim = remaining > 0x10000u ? 0x10000u : (u32)remaining;
+        const u32 sz = rsx_fp_program_size(p, lim);
+        if (sz != t->size) return;
+        if (rsx_fp_structural_hash(p, sz, RSX_PT_FP_SEED) != t->hash) return;
+        u8* c = (u8*)malloc(sz + LD_PT_FP_PAD);
+        if (!c) return;
+        memcpy(c, p, sz); memset(c + sz, 0, LD_PT_FP_PAD);
+        t->bytes = c; g_pt.fp_found++;
+    }
+}
+
+/* One pass over the committed pages of the guest's address space (host base = the VirtualAlloc'd reservation,
+ * found through any guest pointer). Returns the bytes scanned. */
+static size_t ld_pt_scan_pass(const rsx_pt_qtab* qt)
+{
+    const u8* any = g.guest_ptr ? g.guest_ptr(g.guest_user, 0u, 0u, 1u) : NULL;
+    if (!any) any = g.guest_ptr ? g.guest_ptr(g.guest_user, 1u, 0u, 1u) : NULL;
+    if (!any) return 0;
+    MEMORY_BASIC_INFORMATION mi;
+    if (!VirtualQuery(any, &mi, sizeof mi) || !mi.AllocationBase) return 0;
+    const u8* base = (const u8*)mi.AllocationBase;
+    size_t total = 0;
+    const u8* p = base + 0x10000u;
+    const u8* end = base + 0xE0000000ull;
+    while (p < end && !g_pt.stop) {
+        if (!VirtualQuery(p, &mi, sizeof mi)) break;
+        const u8* rb = (const u8*)mi.BaseAddress;
+        size_t rs = mi.RegionSize;
+        if (rb + rs > end) rs = (size_t)(end - rb);
+        if (mi.State == MEM_COMMIT && (mi.Protect & (PAGE_READONLY | PAGE_READWRITE | PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE |
+                                                      PAGE_WRITECOPY)) && !(mi.Protect & (PAGE_GUARD | PAGE_NOACCESS))) {
+            const u8* s = rb < p ? p : rb;
+            const size_t len = (size_t)((rb + rs) - s) & ~(size_t)15;
+            total += len;
+            rsx_pt_scan(s, len, qt, ld_pt_hit, NULL);
+        }
+        p = rb + rs;
+    }
+    return total;
+}
+
+static DWORD WINAPI ld_pt_scout(LPVOID arg)
+{
+    (void)arg;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    rsx_pt_qtab qt; memset(&qt, 0, sizeof qt);
+    if (!rsx_pt_qtab_build(&qt, g_pt.n_vp + g_pt.n_fp)) return 0;
+    for (u32 i = 0; i < g_pt.n_vp; i++) rsx_pt_qtab_add(&qt, g_pt.vp[i].first, 0, i);
+    for (u32 i = 0; i < g_pt.n_fp; i++) rsx_pt_qtab_add(&qt, g_pt.fp[i].first, 1, i);
+    u32 last_vp = 0, last_fp = 0, queued = 0;
+    while (!g_pt.stop && queued < g_pt.n_in) {
+        const LONGLONG t0 = ld_pt_qpc();
+        const size_t bytes = ld_pt_scan_pass(&qt);
+        const unsigned long long us = (unsigned long long)((ld_pt_qpc() - t0) * 1000000 / g_pt.qpf);
+        g_pt.scan_us += us; g_pt.passes++;
+        /* Queue every record whose two programs are known. */
+        u32 newq = 0;
+        EnterCriticalSection(&g_pt.cs);
+        for (u32 i = 0; i < g_pt.n_in; i++) {
+            if (g_pt.rec_state[i] || !g_pt.vp[g_pt.rec_vp[i]].bytes || !g_pt.fp[g_pt.rec_fp[i]].bytes) continue;
+            g_pt.rec_state[i] = 1;
+            g_pt.q[g_pt.q_tail++] = i; newq++; queued++;
+        }
+        LeaveCriticalSection(&g_pt.cs);
+        if (newq) ReleaseSemaphore(g_pt.sem, (LONG)newq, NULL);
+        if (g_pt.passes <= 3 || g_pt.vp_found != last_vp || g_pt.fp_found != last_fp)
+            fprintf(stderr, "[pso-template] scan %u at %.1f s: %.0f MB in %.0f ms; programs found vp %u/%u fp %u/%u; "
+                            "%u/%u pipelines queued (+%u)\n",
+                    g_pt.passes, ld_pt_secs(), bytes / 1048576.0, us / 1e3, g_pt.vp_found, g_pt.n_vp, g_pt.fp_found,
+                    g_pt.n_fp, queued, g_pt.n_in, newq);
+        last_vp = g_pt.vp_found; last_fp = g_pt.fp_found;
+        unsigned wait_ms = 1500;
+        if (g_pt.passes > 200) wait_ms = 15000; else if (g_pt.passes > 40) wait_ms = 5000;
+        if ((unsigned)(us / 1000 * 3) > wait_ms) wait_ms = (unsigned)(us / 1000 * 3);
+        for (unsigned w = 0; w < wait_ms && !g_pt.stop; w += 50) Sleep(50);
+    }
+    free(qt.e);
+    return 0;
+}
+
+/* Init thread, after ld_pl_start (the pipeline library exists by then). */
+static void ld_pt_start(void)
+{
+    if (g_pt.started) return;
+    g_pt.started = 1;
+    { LARGE_INTEGER f; QueryPerformanceFrequency(&f); g_pt.qpf = f.QuadPart; g_pt.t0 = ld_pt_qpc(); }
+    const char* o = getenv("LD_PSO_TEMPLATE_OUT");
+    if (o && *o && snprintf(g_pt.out_path, sizeof g_pt.out_path, "%s", o) < (int)sizeof g_pt.out_path) {
+        g_pt.out_on = 1; g_pt.last_write = ld_pt_qpc();
+        fprintf(stderr, "[pso-template] export on: '%s'\n", g_pt.out_path);
+    }
+    const char* i = getenv("LD_PSO_TEMPLATE");
+    if (!i || !*i) return;
+    if (snprintf(g_pt.in_path, sizeof g_pt.in_path, "%s", i) >= (int)sizeof g_pt.in_path) return;
+    if (!ld_fp_constants_buffered()) { fprintf(stderr, "[pso-template] off: literal fragment constants\n"); return; }
+    if (!g_ld_pl.opened || !g_ld_pl.on) { fprintf(stderr, "[pso-template] off: the PSO preload is off (LD_PSO_PRELOAD=0)\n"); return; }
+    uint32_t flags = 0;
+    const int rc = rsx_pt_read(g_pt.in_path, &g_pt.in, &g_pt.n_in, &g_pt.n_dropped, &flags);
+    if (rc) { fprintf(stderr, "[pso-template] cannot use '%s' (%s)\n", g_pt.in_path, rc == -1 ? "missing" : "another format or key version"); return; }
+    /* Records of another render-state layout cannot be rebuilt. */
+    { u32 k = 0;
+      for (u32 j = 0; j < g_pt.n_in; j++)
+          if (ld_pt_rec_ok(&g_pt.in[j])) g_pt.in[k++] = g_pt.in[j];
+          else g_pt.n_dropped++;
+      g_pt.n_in = k; }
+    g_pt.rec_vp = (u32*)calloc(g_pt.n_in + 1u, sizeof(u32));
+    g_pt.rec_fp = (u32*)calloc(g_pt.n_in + 1u, sizeof(u32));
+    g_pt.rec_state = (u8*)calloc(g_pt.n_in + 1u, 1);
+    g_pt.vp = (ld_pt_prog*)calloc(g_pt.n_in + 1u, sizeof(ld_pt_prog));
+    g_pt.fp = (ld_pt_prog*)calloc(g_pt.n_in + 1u, sizeof(ld_pt_prog));
+    g_pt.q = (u32*)calloc(g_pt.n_in + 1u, sizeof(u32));
+    if (!g_pt.rec_vp || !g_pt.rec_fp || !g_pt.rec_state || !g_pt.vp || !g_pt.fp || !g_pt.q || !g_pt.n_in) {
+        fprintf(stderr, "[pso-template] '%s': %u usable pipelines (%u dropped), nothing to prewarm\n", g_pt.in_path, g_pt.n_in, g_pt.n_dropped);
+        return;
+    }
+    for (u32 j = 0; j < g_pt.n_in; j++) {
+        const rsx_pt_rec* r = &g_pt.in[j];
+        u32 v = 0, f = 0;
+        while (v < g_pt.n_vp && g_pt.vp[v].hash != r->vp_hash) v++;
+        if (v == g_pt.n_vp) { g_pt.vp[v].hash = r->vp_hash; g_pt.vp[v].first = r->vp_first; g_pt.vp[v].size = r->vp_instrs * 16u; g_pt.n_vp++; }
+        while (f < g_pt.n_fp && g_pt.fp[f].hash != r->fp_hash) f++;
+        if (f == g_pt.n_fp) { g_pt.fp[f].hash = r->fp_hash; g_pt.fp[f].first = r->fp_first; g_pt.fp[f].size = r->fp_size; g_pt.n_fp++; }
+        g_pt.rec_vp[j] = v; g_pt.rec_fp[j] = f;
+    }
+    InitializeCriticalSection(&g_pt.cs);
+    InitializeConditionVariable(&g_pt.cv);
+    g_pt.sem = CreateSemaphoreA(NULL, 0, 0x7FFFFFFF, NULL);
+    const char* te = getenv("LD_PSO_TEMPLATE_THREADS");
+    int nt = te && *te ? atoi(te) : 3;
+    if (nt < 1) nt = 1;
+    if (nt > 8) nt = 8;
+    g_pt.in_on = 1;
+    fprintf(stderr, "[pso-template] prewarm on: '%s' %u pipelines (%u dropped), %u vertex / %u fragment programs to find, %d threads\n",
+            g_pt.in_path, g_pt.n_in, g_pt.n_dropped, g_pt.n_vp, g_pt.n_fp, nt);
+    for (int k = 0; k < nt; k++) {
+        g_pt.workers[g_pt.n_workers] = CreateThread(NULL, 0, ld_pt_worker, NULL, 0, NULL);
+        if (g_pt.workers[g_pt.n_workers]) g_pt.n_workers++;
+    }
+    g_pt.scout = CreateThread(NULL, 0, ld_pt_scout, NULL, 0, NULL);
+}
+
+static void ld_pt_tick(void)   /* present */
+{
+    if (g_pt.out_on && g_pt.dirty && (ld_pt_qpc() - g_pt.last_write) > 5 * g_pt.qpf) ld_pt_write_out("periodic");
+    if (g_pt.in_on) {   /* progress line, at most every 10 s while the counts change */
+        static LONG reported; static LONGLONG last;
+        const LONG done = g_pt.built + g_pt.failed_xlate + g_pt.failed_key + g_pt.failed_blob + g_pt.failed_pso;
+        const LONGLONG now = ld_pt_qpc();
+        if (done != reported && (now - last) > 10 * g_pt.qpf) {
+            reported = done; last = now;
+            fprintf(stderr, "[pso-template] at %.1f s: built %ld (%ld from the library), translate failed %ld, key mismatch %ld, blob failed %ld, "
+                            "create failed %ld, walker used %ld\n", ld_pt_secs(), (long)g_pt.built, (long)g_pt.lib_hits,
+                    (long)g_pt.failed_xlate, (long)g_pt.failed_key, (long)g_pt.failed_blob, (long)g_pt.failed_pso, (long)g_pt.used);
+        }
+    }
+}
+
+static void ld_pt_shutdown(void)
+{
+    if (!g_pt.started) return;
+    ld_pt_write_out("exit");
+    if (!g_pt.in_on) return;
+    g_pt.stop = 1;
+    if (g_pt.scout) { WaitForSingleObject(g_pt.scout, 5000); CloseHandle(g_pt.scout); g_pt.scout = NULL; }
+    ReleaseSemaphore(g_pt.sem, (LONG)(g_pt.n_workers + 1u), NULL);
+    for (u32 i = 0; i < g_pt.n_workers; i++) { WaitForSingleObject(g_pt.workers[i], 10000); CloseHandle(g_pt.workers[i]); }
+    g_pt.n_workers = 0;
+    fprintf(stderr, "[pso-template] done: %u pipelines in the template, programs found vp %u/%u fp %u/%u, built %ld (%ld from the library), "
+                    "translate failed %ld, key mismatch %ld, blob failed %ld, create failed %ld, walker used %ld; scans %u (%.0f ms total), "
+                    "translate+blobs %.0f ms (of which compile %.0f ms), create %.0f ms (summed over threads)\n",
+            g_pt.n_in, g_pt.vp_found, g_pt.n_vp, g_pt.fp_found, g_pt.n_fp, (long)g_pt.built, (long)g_pt.lib_hits,
+            (long)g_pt.failed_xlate, (long)g_pt.failed_key, (long)g_pt.failed_blob, (long)g_pt.failed_pso, (long)g_pt.used, g_pt.passes,
+            g_pt.scan_us / 1e3, g_pt.xlate_us / 1e3, g_pt.compile_us / 1e3, g_pt.create_us / 1e3);
+}
