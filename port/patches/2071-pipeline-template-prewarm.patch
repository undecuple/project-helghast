diff --git a/libs/video/rsx_pso_template.h b/libs/video/rsx_pso_template.h
new file mode 100644
index 00000000..3259e182
--- /dev/null
+++ b/libs/video/rsx_pso_template.h
@@ -0,0 +1,181 @@
+/* KZ3 patch 2071 (RSX pass 67): the shared pipeline template -- file format, record set and the guest-memory
+ * shader finder, platform-neutral so a host test can check them with no GPU (tools/smoke/test_pso_template.c) and
+ * the merge tool (tools/smoke/pso_template.py) reads the same layout.
+ *
+ * A template is a list of pipeline records. Each record holds ONLY hashes and render state:
+ *   - FNV / structural hashes of the vertex and fragment program microcode (one-way; the microcode is not stored),
+ *     their lengths, and a "first" fingerprint (a 64-bit mix of the program's first 16 bytes) that the finder uses
+ *     to locate the program in the player's own guest memory;
+ *   - the numeric state words that select the shader variant and the pipeline (texture-unit masks, gamma / shadow /
+ *     ARGB / unnormalised-size masks, sRGB output, vertex layout) and the render state (blend, depth, raster,
+ *     formats), all plain integers;
+ *   - the pipeline key the walker looks the pipeline up by (itself a hash of the above).
+ * No shader text, no microcode, no texture, no address of the game, no string derived from game data. A template
+ * therefore carries nothing the public repository must not hold; the player's own game supplies the programs (the
+ * finder searches the running guest's memory for programs whose hashes the template lists) and the player's own
+ * translator and driver build the pipelines.
+ *
+ * Layout (little endian, packed): rsx_pt_hdr, then count records of rec_size bytes. rsx_pt_rec has the pipeline key
+ * as its first 8 bytes, which is all the merge tool needs for dedupe; the other fields are listed for --info. */
+#ifndef RSX_PSO_TEMPLATE_H
+#define RSX_PSO_TEMPLATE_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define RSX_PT_MAGIC     0x54505A4Bu   /* bytes "KZPT" */
+#define RSX_PT_VERSION   1u
+/* Bump when the meaning of a record or the way the walker derives the pipeline key changes: a file with another
+ * key version is ignored (its keys would never match, its records would build pipelines nothing asks for). */
+#define RSX_PT_KEYVER    1u
+#define RSX_PT_RS_WORDS  64
+#define RSX_PT_FLAG_LAYOUT 1u    /* masked vertex layout (layout_* and attrs are valid) */
+#define RSX_PT_FLAG_PACKED 2u    /* packed payload offsets */
+#define RSX_PT_FLAG_DEPTH  4u    /* a depth surface was bound when the pipeline was first seen */
+#define RSX_PT_FLAG_BUFFERED 8u  /* fragment constants in a constant buffer (the only mode the prewarm builds) */
+#define RSX_PT_FP_SEED   0x4B5A50545F465031ull   /* seed of the template's fragment-program structural hash */
+#define RSX_PT_MAX_RECS  65536u
+
+#pragma pack(push, 1)
+typedef struct {
+    uint32_t magic, version, rec_size, key_version, flags, count;
+} rsx_pt_hdr;
+
+typedef struct {
+    uint64_t key;                       /* the walker's pipeline key */
+    uint64_t vp_hash, vp_first;         /* FNV of the VP words (host order), fingerprint of its first 16 guest bytes */
+    uint64_t fp_hash, fp_first;         /* structural hash (seed RSX_PT_FP_SEED), fingerprint of its first 16 bytes */
+    uint64_t gamma_mask;
+    uint32_t vp_instrs, vp_start, fp_size, fp_ctrl, cube_mask, vtex_mask, srgb_out;
+    uint32_t shadow_mask, argb_mask, unnorm_mask, flags;
+    uint32_t layout_mask, layout_stride, layout_count;
+    uint32_t rs_words;                  /* used words of rs[] (sizeof the walker's render state / 4) */
+    uint8_t  shadow_zfunc[16];
+    uint16_t argb_remap[16];
+    uint32_t unnorm_dim[16][2];
+    uint8_t  attrs[16];
+    uint32_t rs[RSX_PT_RS_WORDS];
+} rsx_pt_rec;
+#pragma pack(pop)
+
+/* Fingerprint of 16 bytes (never 0). */
+static inline uint64_t rsx_pt_quick(const uint8_t* p)
+{
+    uint64_t a, b;
+    memcpy(&a, p, 8); memcpy(&b, p + 8, 8);
+    uint64_t h = a * 0x9E3779B97F4A7C15ull;
+    h ^= ((b * 0xC2B2AE3D27D4EB4Full) << 31) | ((b * 0xC2B2AE3D27D4EB4Full) >> 33);
+    h ^= h >> 29; h *= 0xBF58476D1CE4E5B9ull; h ^= h >> 32;
+    return h ? h : 1ull;
+}
+
+/* ---- key set (the walker thread notes each pipeline key once) ---- */
+typedef struct { uint64_t* a; uint32_t cap, n; } rsx_pt_set;
+/* 1 when the key was new (and is now in the set), 0 when present or on allocation failure. */
+static inline int rsx_pt_set_add(rsx_pt_set* s, uint64_t key)
+{
+    if (!key) key = 1;
+    if (!s->a || (s->n + 1u) * 2u > s->cap) {
+        const uint32_t ncap = s->cap ? s->cap * 2u : 4096u;
+        uint64_t* na = (uint64_t*)calloc(ncap, sizeof(uint64_t));
+        if (!na) return 0;
+        for (uint32_t i = 0; i < s->cap; i++) if (s->a[i]) {
+            uint32_t j = (uint32_t)(s->a[i] ^ (s->a[i] >> 29)) & (ncap - 1u);
+            while (na[j]) j = (j + 1u) & (ncap - 1u);
+            na[j] = s->a[i];
+        }
+        free(s->a); s->a = na; s->cap = ncap;
+    }
+    uint32_t i = (uint32_t)(key ^ (key >> 29)) & (s->cap - 1u);
+    for (;; i = (i + 1u) & (s->cap - 1u)) {
+        if (s->a[i] == key) return 0;
+        if (!s->a[i]) { s->a[i] = key; s->n++; return 1; }
+    }
+}
+
+/* ---- file ---- */
+/* Write recs to path (temporary file, then replace). 0 = ok. */
+static inline int rsx_pt_write(const char* path, const rsx_pt_rec* recs, uint32_t n, uint32_t flags)
+{
+    char tmp[1024];
+    if (snprintf(tmp, sizeof tmp, "%s.tmp", path) >= (int)sizeof tmp) return -1;
+    FILE* f = fopen(tmp, "wb");
+    if (!f) return -1;
+    rsx_pt_hdr h = { RSX_PT_MAGIC, RSX_PT_VERSION, (uint32_t)sizeof(rsx_pt_rec), RSX_PT_KEYVER, flags, n };
+    int ok = fwrite(&h, sizeof h, 1, f) == 1 && (!n || fwrite(recs, sizeof(rsx_pt_rec), n, f) == n);
+    ok = (fclose(f) == 0) && ok;
+    if (!ok) { remove(tmp); return -1; }
+    remove(path);
+    if (rename(tmp, path) != 0) { remove(tmp); return -1; }
+    return 0;
+}
+
+/* Read a template: 0 = ok (*out malloc'ed, *n records with duplicate keys dropped, *dropped counts them and the
+ * records another layout or key version made unusable), -1 = missing file, -2 = header mismatch. */
+static inline int rsx_pt_read(const char* path, rsx_pt_rec** out, uint32_t* n, uint32_t* dropped, uint32_t* flags)
+{
+    *out = NULL; *n = 0; if (dropped) *dropped = 0;
+    FILE* f = fopen(path, "rb");
+    if (!f) return -1;
+    rsx_pt_hdr h;
+    if (fread(&h, sizeof h, 1, f) != 1 || h.magic != RSX_PT_MAGIC || h.version != RSX_PT_VERSION ||
+        h.rec_size != sizeof(rsx_pt_rec) || h.key_version != RSX_PT_KEYVER || h.count > RSX_PT_MAX_RECS) {
+        fclose(f); return -2;
+    }
+    if (flags) *flags = h.flags;
+    rsx_pt_rec* r = (rsx_pt_rec*)malloc((h.count ? h.count : 1u) * sizeof(rsx_pt_rec));
+    if (!r) { fclose(f); return -2; }
+    rsx_pt_set seen; memset(&seen, 0, sizeof seen);
+    uint32_t k = 0, drop = 0;
+    for (uint32_t i = 0; i < h.count; i++) {
+        rsx_pt_rec t;
+        if (fread(&t, sizeof t, 1, f) != 1) break;
+        if (t.rs_words > RSX_PT_RS_WORDS || t.layout_count > 16u || !t.key || !rsx_pt_set_add(&seen, t.key)) { drop++; continue; }
+        r[k++] = t;
+    }
+    fclose(f); free(seen.a);
+    *out = r; *n = k; if (dropped) *dropped = drop;
+    return 0;
+}
+
+/* ---- finder ---- */
+/* Fingerprint table: open addressing on the fingerprint, several entries may share one (kind, id distinguish). */
+typedef struct { uint64_t q; uint32_t kind, id; } rsx_pt_qent;
+typedef struct { rsx_pt_qent* e; uint32_t cap; } rsx_pt_qtab;
+static inline int rsx_pt_qtab_build(rsx_pt_qtab* t, uint32_t n_entries)
+{
+    uint32_t cap = 64u;
+    while (cap < n_entries * 4u) cap <<= 1;
+    t->e = (rsx_pt_qent*)calloc(cap, sizeof(rsx_pt_qent));
+    t->cap = t->e ? cap : 0;
+    return t->e != NULL;
+}
+static inline void rsx_pt_qtab_add(rsx_pt_qtab* t, uint64_t q, uint32_t kind, uint32_t id)
+{
+    uint32_t i = (uint32_t)(q ^ (q >> 31)) & (t->cap - 1u);
+    while (t->e[i].q) i = (i + 1u) & (t->cap - 1u);
+    t->e[i].q = q; t->e[i].kind = kind; t->e[i].id = id;
+}
+/* Calls hit(user, ptr, remaining_bytes, kind, id) for every 16-byte aligned block whose fingerprint is in the
+ * table. Returns the number of blocks inspected. */
+typedef void (*rsx_pt_hit_fn)(void* user, const uint8_t* p, size_t remaining, uint32_t kind, uint32_t id);
+static inline size_t rsx_pt_scan(const uint8_t* base, size_t len, const rsx_pt_qtab* t, rsx_pt_hit_fn hit, void* user)
+{
+    if (!t->cap) return 0;
+    const uint32_t mask = t->cap - 1u;
+    size_t blocks = 0;
+    for (size_t o = 0; o + 16u <= len; o += 16u, blocks++) {
+        const uint8_t* p = base + o;
+        const uint64_t q = rsx_pt_quick(p);
+        uint32_t i = (uint32_t)(q ^ (q >> 31)) & mask;
+        while (t->e[i].q) {
+            if (t->e[i].q == q) hit(user, p, len - o, t->e[i].kind, t->e[i].id);
+            i = (i + 1u) & mask;
+        }
+    }
+    return blocks;
+}
+
+#endif /* RSX_PSO_TEMPLATE_H */
