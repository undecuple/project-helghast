+/* ===== KZ3 patch 2071: the walker's translation step (VP and FP microcode + variant state -> HLSL), one function
+ * shared by get_pso and the template prewarm threads. The decompilers keep static scratch buffers and the VP branch
+ * base, so the whole step runs under one lock. ===== */
+typedef struct {
+    const u8* vp_uc; u32 vp_instrs, vp_start;
+    const rsx_vertex_layout_plan* layout;      /* masked layout, or NULL */
+    u32 vtex_mask;
+    const u8* fp_uc; u32 fp_size, fp_ctrl, cube_mask;
+    const render_state_t* rs;
+    u32 shadow_mask; const u8* shadow_zfunc;
+    u32 unnorm_mask; const u32 (*unnorm_dim)[3];   /* v0.18.0: w, h, depth (00c2999d) */
+    u32 vp_branch_bits;                        /* v0.18.0: BRB/CLB outcomes baked into the VP (0x1FF8) */
+    u64 gamma_mask; u32 argb_mask; const u16* argb_remap; u32 srgb_out;
+    u32 fp_const_count; u32 fp_alpha_ref;
+} ld_xl_in;
+static CRITICAL_SECTION g_ld_xl_cs;
+static volatile LONG g_ld_xl_state;
+static void ld_xl_lock(void)
+{
+    if (g_ld_xl_state != 2) {
+        if (InterlockedCompareExchange(&g_ld_xl_state, 1, 0) == 0) { InitializeCriticalSection(&g_ld_xl_cs); g_ld_xl_state = 2; }
+        else while (g_ld_xl_state != 2) Sleep(0);
+    }
+    EnterCriticalSection(&g_ld_xl_cs);
+}
+static void ld_xlate(const ld_xl_in* in, char* vs_hlsl, size_t vs_sz, char* ps_hlsl, size_t ps_sz, int* vi_out, int* fi_out)
+{
+    const u8* vp_uc = in->vp_uc; const u32 vp_instrs = in->vp_instrs; const u32 vtex_mask = in->vtex_mask;
+    const rsx_vertex_layout_plan* masked_layout = in->layout;
+    const u8* fp_uc = in->fp_uc; const u32 fp_size = in->fp_size, fp_ctrl = in->fp_ctrl, cube_mask = in->cube_mask;
+    const render_state_t rs = *in->rs;
+    const u32 shadow_mask = in->shadow_mask, unnorm_mask = in->unnorm_mask, argb_mask = in->argb_mask, srgb_out = in->srgb_out;
+    const u8* shadow_zfunc = in->shadow_zfunc; const u32 (*unnorm_dim)[3] = in->unnorm_dim;
+    const u64 gamma_mask = in->gamma_mask; const u16* argb_remap = in->argb_remap;
+    ld_xl_lock();
+    rsx_vp_set_branch_base(in->vp_start);
+    rsx_vp_set_branch_bits(in->vp_branch_bits);
+    const int vi = masked_layout
+        ? rsx_vp_decompile_compact_ex(
+            vp_uc, vp_instrs * 16, vtex_mask, masked_layout->mask,
+            vs_hlsl, vs_sz)
+        : rsx_vp_decompile_ex(
+            vp_uc, vp_instrs * 16, vtex_mask, vs_hlsl, vs_sz);
+    u32 decompiled_constant_count = 0;
+    int fi;
+    if (ld_fp_constants_buffered()) {
+        fi = rsx_fp_decompile_buffered_ex(
+            fp_uc, fp_size, fp_ctrl, cube_mask, ps_hlsl,
+            ps_sz, &decompiled_constant_count);
+        if (fi > 0 &&
+            decompiled_constant_count != in->fp_const_count)
+            fi = -1;
+        if (fi > 0 && rs.alpha_test_enable &&
+            rsx_fp_apply_alpha_test_buffered(
+                ps_hlsl, ps_sz, rs.alpha_func) < 0)
+            fi = -1;
+        if (fi > 0 && rsx_fp_apply_shadow_compare(
+                ps_hlsl, ps_sz, shadow_mask, shadow_zfunc) < 0)
+            fi = -1;
+        if (fi > 0) {
+            const int np = rsx_fp_apply_unnorm_scale(
+                ps_hlsl, ps_sz, unnorm_mask, unnorm_dim, cube_mask, 0u);
+            { static int n = 0;
+              if (PS3_LOG_FIRST(n, 8))
+                  fprintf(stderr, "[unnorm] mask=0x%X cube=0x%X dim0=%ux%u"
+                                  " patched=%d\n",
+                          unnorm_mask, cube_mask, unnorm_dim[0][0],
+                          unnorm_dim[0][1], np); }
+            if (np < 0) fi = -1;
+        }
+    } else {
+        fi = rsx_fp_decompile_ex(
+            fp_uc, fp_size, fp_ctrl, cube_mask,
+            ps_hlsl, ps_sz);
+        if (fi > 0 && rs.alpha_test_enable &&
+            rsx_fp_apply_alpha_test(
+                ps_hlsl, ps_sz, rs.alpha_func,
+                in->fp_alpha_ref) < 0)
+            fi = -1;
+        if (fi > 0 && rsx_fp_apply_shadow_compare(
+                ps_hlsl, ps_sz, shadow_mask, shadow_zfunc) < 0)
+            fi = -1;
+        if (fi > 0 && rsx_fp_apply_unnorm_scale(
+                ps_hlsl, ps_sz, unnorm_mask,
+                unnorm_dim, cube_mask, 0u) < 0)
+            fi = -1;
+    }
+    if (fi > 0 && rsx_fp_apply_gamma(ps_hlsl, ps_sz, gamma_mask) < 0)
+        fi = -1;
+    if (fi > 0 && rsx_fp_apply_depth_argb(ps_hlsl, ps_sz, argb_mask, argb_remap) < 0)
+        fi = -1;
+    if (fi > 0 && srgb_out && rsx_fp_apply_srgb_output(ps_hlsl, ps_sz) < 0) {   /* patch 2055 */
+        static int said; if (!said++) fprintf(stderr, "[srgb-out] apply failed: PSO left linear\n");
+    }
+    if (fi > 0 && (shadow_mask || argb_mask)) {
+        static u32 n_log = 0;
+        if (n_log++ < 8)
+            fprintf(stderr, "[zalias] pso shadow=0x%04X argb=0x%04X\n", shadow_mask, argb_mask);
+    }
+    LeaveCriticalSection(&g_ld_xl_cs);
+    *vi_out = vi; *fi_out = fi;
+}
