+/* Patch 2071: the part of the pipeline key that follows the program hashes (fp_ctrl, the texture-unit masks, sRGB, the
+ * vertex layout, the render state), shared by get_pso and the template prewarm, which recomputes each record's key
+ * from the programs it found and refuses a record whose stored key disagrees (a stale, edited or mismatched file never
+ * stands in for the wrong pipeline). key in = FNV chain after the vertex and fragment program hashes. */
+static u64 ld_pso_key_tail(u64 key, const ld_xl_in* xi, int packed_payload, u64* kl_pre_rs)
+{
+    const u32 fp_ctrl = xi->fp_ctrl, cube_mask = xi->cube_mask, vtex_mask = xi->vtex_mask, srgb_out = xi->srgb_out;
+    const u64 gamma_mask = xi->gamma_mask;
+    const u32 shadow_mask = xi->shadow_mask, argb_mask = xi->argb_mask, unnorm_mask = xi->unnorm_mask;
+    const u8* shadow_zfunc = xi->shadow_zfunc; const u16* argb_remap = xi->argb_remap; const u32 (*unnorm_dim)[3] = xi->unnorm_dim;
+    const rsx_vertex_layout_plan* masked_layout = xi->layout;
+    const render_state_t rs = *xi->rs;
+    u64 dummy; if (!kl_pre_rs) kl_pre_rs = &dummy;
+    const u32 fp_ctrl_key = fp_ctrl & 0x4Eu;   /* patch 2021: + depth export */
+    key = fnv1a(&fp_ctrl_key, sizeof(fp_ctrl_key), key);
+    key = fnv1a(&cube_mask, sizeof(cube_mask), key);
+    key = fnv1a(&vtex_mask, sizeof(vtex_mask), key);
+    /* v0.18.0: BRB/CLB outcomes are baked into the program (rsx_vp_set_branch_bits). The template records do not
+     * store them: the prewarm passes 0, so only records made with 0 bits keep their key. */
+    if (rsx_vp_uses_branch_bits(xi->vp_uc, xi->vp_instrs * 16))
+        key = fnv1a(&xi->vp_branch_bits, sizeof(xi->vp_branch_bits), key);
+    if (gamma_mask) key = fnv1a(&gamma_mask, sizeof(gamma_mask), key);
+    if (srgb_out) key = fnv1a(&srgb_out, sizeof(srgb_out), key);   /* patch 2055 */
+    { static int s2a = -1;   /* patch 2057: the SRC2 abs switch changes shader text, so it changes the key */
+      if (s2a < 0) { const char* e = getenv("LD_SRC2_ABS"); s2a = (e && e[0] == '1') ? 1 : 0; }
+      if (s2a) { const u32 tag = 0x5A2Au; key = fnv1a(&tag, sizeof(tag), key); } }
+    if (shadow_mask) {
+        key = fnv1a(&shadow_mask, sizeof(shadow_mask), key);
+        key = fnv1a(shadow_zfunc, 16, key);
+    }
+    if (argb_mask) {
+        key = fnv1a(&argb_mask, sizeof(argb_mask), key);
+        key = fnv1a(argb_remap, 32, key);
+    }
+    key = fnv1a(&unnorm_mask, sizeof(unnorm_mask), key);
+    if (unnorm_mask) {   /* w, h per unit (128 bytes, as the [16][2] records store them) */
+        u32 wh[16][2];
+        for (int u = 0; u < 16; u++) { wh[u][0] = unnorm_dim[u][0]; wh[u][1] = unnorm_dim[u][1]; }
+        key = fnv1a(wh, sizeof wh, key);
+    }
+    if (masked_layout) {
+        static const u32 masked_layout_tag = 0x314B534Du; /* "MSK1" */
+        const u32 payload_stride =
+            packed_payload ? masked_layout->stride : VERT_STRIDE;
+        key = fnv1a(
+            &masked_layout_tag, sizeof(masked_layout_tag), key);
+        key = fnv1a(
+            &masked_layout->mask, sizeof(masked_layout->mask), key);
+        key = fnv1a(
+            &payload_stride, sizeof(payload_stride), key);
+        key = fnv1a(
+            &packed_payload, sizeof(packed_payload), key);
+    }
+    *kl_pre_rs = key;   /* patch 2042 */
+    if (ld_fp_constants_buffered())
+        key = ld_hash_structural_render_state(&rs, key);
+    else
+        key = fnv1a(&rs, sizeof(rs), key);
+    return key;
+}
+
+/* ===================== KZ3 patch 2071: shared pipeline template (RSX pass 67) =====================
+ * Cold-cache level starts stall the walker: every new pipeline is translated, compiled and created while the
+ * frame waits (K4: 245 pipelines, 16 s). A template (rsx_pso_template.h) lists the pipelines of an earlier session
+ * as hashes and numeric state only, no shader text and no microcode, so players can share it. At init
+ * (LD_PSO_TEMPLATE=<file>) a scout thread searches the running guest's memory for the programs whose hashes the
+ * template lists (the player's own game loaded them, long before the level draws with them); once a record's vertex
+ * and fragment program are both found, worker threads translate them with the walker's own translator (ld_xlate),
+ * compile (disk cache first), create the pipeline and stage it like a preloaded one. The walker finds it ready at
+ * its next lookup; a pipeline that is not ready is built by the walker as before (no draw is skipped or dropped).
+ * LD_PSO_TEMPLATE_OUT=<file> writes this session's pipelines in the same format (every 5 s when it grew, at exit). */
+#define LD_PT_FP_PAD 64u
+typedef struct { u64 hash, first; u32 size; u8* bytes; } ld_pt_prog;   /* bytes: VP host order / FP guest bytes + pad */
+typedef struct { u32 stage; u64 hash; u32 len; ID3DBlob* blob; int done; } ld_pt_blobent;
+static struct {
+    int out_on, in_on, started, stop;
+    char out_path[MAX_PATH], in_path[MAX_PATH];
+    /* export (walker thread) */
+    rsx_pt_set seen; rsx_pt_rec* out; u32 n_out, cap_out; int dirty; LONGLONG last_write; u32 writes;
+    /* prewarm */
+    rsx_pt_rec* in; u32 n_in, n_dropped;
+    ld_pt_prog *vp, *fp; u32 n_vp, n_fp, vp_found, fp_found;
+    u32 *rec_vp, *rec_fp; u8* rec_state;        /* 0 waiting, 1 queued */
+    CRITICAL_SECTION cs; CONDITION_VARIABLE cv;
+    u32* q; u32 q_head, q_tail, n_queued; HANDLE sem;
+    ld_pt_blobent* blobs; u32 n_blobs, cap_blobs;
+    HANDLE scout, workers[8]; u32 n_workers;
+    LONGLONG t0, qpf;
+    volatile LONG built, failed_xlate, failed_blob, failed_pso, failed_key, lib_hits, staged;
+    volatile LONG used;                          /* walker lookups that found a template pipeline ready */
+    unsigned passes; unsigned long long scan_us, xlate_us, compile_us, create_us;
+} g_pt;
+
+static LONGLONG ld_pt_qpc(void) { LARGE_INTEGER q; QueryPerformanceCounter(&q); return q.QuadPart; }
+static double ld_pt_secs(void) { return (double)(ld_pt_qpc() - g_pt.t0) / (double)(g_pt.qpf ? g_pt.qpf : 1); }
+
+/* ---- export (walker thread) ---- */
+static void ld_pt_note(u64 key, const ld_xl_in* xi, int packed, int depth)
+{
+    if (!rsx_pt_set_add(&g_pt.seen, key)) return;
+    if (!ld_fp_constants_buffered()) return;
+    if (g_pt.n_out == g_pt.cap_out) {
+        const u32 cap = g_pt.cap_out ? 2u * g_pt.cap_out : 512u;
+        rsx_pt_rec* n = (rsx_pt_rec*)realloc(g_pt.out, cap * sizeof(rsx_pt_rec));
+        if (!n) return;
+        g_pt.out = n; g_pt.cap_out = cap;
+    }
+    rsx_pt_rec* r = &g_pt.out[g_pt.n_out];
+    memset(r, 0, sizeof *r);
+    r->key = key;
+    r->vp_hash = fnv1a(xi->vp_uc, xi->vp_instrs * 16u, 1469598103934665603ull);
+    { u8 b[16]; const u32* w = (const u32*)xi->vp_uc;
+      for (int k = 0; k < 4; k++) { b[4*k] = (u8)(w[k] >> 24); b[4*k+1] = (u8)(w[k] >> 16); b[4*k+2] = (u8)(w[k] >> 8); b[4*k+3] = (u8)w[k]; }
+      r->vp_first = rsx_pt_quick(b); }
+    r->fp_hash = rsx_fp_structural_hash(xi->fp_uc, xi->fp_size, RSX_PT_FP_SEED);
+    r->fp_first = rsx_pt_quick(xi->fp_uc);
+    r->gamma_mask = xi->gamma_mask;
+    r->vp_instrs = xi->vp_instrs; r->vp_start = xi->vp_start; r->fp_size = xi->fp_size; r->fp_ctrl = xi->fp_ctrl;
+    r->cube_mask = xi->cube_mask; r->vtex_mask = xi->vtex_mask; r->srgb_out = xi->srgb_out;
+    r->shadow_mask = xi->shadow_mask; r->argb_mask = xi->argb_mask; r->unnorm_mask = xi->unnorm_mask;
+    r->flags = RSX_PT_FLAG_BUFFERED | (xi->layout ? RSX_PT_FLAG_LAYOUT : 0u) | (xi->layout && packed ? RSX_PT_FLAG_PACKED : 0u) |
+               (depth ? RSX_PT_FLAG_DEPTH : 0u);
+    if (xi->layout) {
+        r->layout_mask = xi->layout->mask; r->layout_stride = xi->layout->stride; r->layout_count = xi->layout->count;
+        memcpy(r->attrs, xi->layout->attrs, sizeof r->attrs);
+    }
+    r->rs_words = (u32)(sizeof(render_state_t) / 4u);
+    memcpy(r->rs, xi->rs, sizeof(render_state_t));
+    memcpy(r->shadow_zfunc, xi->shadow_zfunc, 16);
+    memcpy(r->argb_remap, xi->argb_remap, sizeof r->argb_remap);
+    for (int u = 0; u < 16; u++) { r->unnorm_dim[u][0] = xi->unnorm_dim[u][0]; r->unnorm_dim[u][1] = xi->unnorm_dim[u][1]; }
+    g_pt.n_out++;
+    g_pt.dirty = 1;
+}
+
+static void ld_pt_write_out(const char* why)
+{
+    if (!g_pt.out_on || !g_pt.dirty) return;
+    g_pt.dirty = 0;
+    g_pt.last_write = ld_pt_qpc();
+    if (rsx_pt_write(g_pt.out_path, g_pt.out, g_pt.n_out, RSX_PT_FLAG_BUFFERED) == 0) {
+        g_pt.writes++;
+        if (!strcmp(why, "exit") || g_pt.writes == 1)
+            fprintf(stderr, "[pso-template] wrote %u pipelines to '%s' (%s)\n", g_pt.n_out, g_pt.out_path, why);
+    } else {
+        fprintf(stderr, "[pso-template] cannot write '%s'\n", g_pt.out_path);
+    }
+}
+
+/* ---- prewarm ---- */
+/* A template is a shared file: refuse records with impossible numbers before anything is sized from them. */
+static int ld_pt_rec_ok(const rsx_pt_rec* r)
+{
+    if (r->rs_words != sizeof(render_state_t) / 4u || !(r->flags & RSX_PT_FLAG_BUFFERED)) return 0;
+    if (r->vp_instrs < 1u || r->vp_instrs > RSX_DSP_VP_INSTR || r->vp_start >= RSX_DSP_VP_INSTR) return 0;
+    if (r->fp_size < 16u || r->fp_size > 0x10000u || (r->fp_size & 15u)) return 0;
+    if (r->layout_count > RSX_DSP_NUM_VERTEX_ATTR) return 0;
+    for (u32 i = 0; i < r->layout_count; i++) if (r->attrs[i] >= RSX_DSP_NUM_VERTEX_ATTR) return 0;
+    return 1;
+}
+
+static ID3DBlob* ld_pt_blob(u32 stage, const char* src, u32 len)
+{
+    const u64 hash = fnv1a(src, len, 1469598103934665603ull);
+    u32 idx = 0;
+    EnterCriticalSection(&g_pt.cs);
+    for (idx = 0; idx < g_pt.n_blobs; idx++)
+        if (g_pt.blobs[idx].hash == hash && g_pt.blobs[idx].len == len && g_pt.blobs[idx].stage == stage) break;
+    if (idx < g_pt.n_blobs) {
+        while (!g_pt.blobs[idx].done) SleepConditionVariableCS(&g_pt.cv, &g_pt.cs, INFINITE);
+        ID3DBlob* b = g_pt.blobs[idx].blob;
+        if (b) b->lpVtbl->AddRef(b);
+        LeaveCriticalSection(&g_pt.cs);
+        return b;
+    }
+    if (g_pt.n_blobs == g_pt.cap_blobs) {
+        const u32 cap = g_pt.cap_blobs ? 2u * g_pt.cap_blobs : 512u;
+        ld_pt_blobent* n = (ld_pt_blobent*)realloc(g_pt.blobs, cap * sizeof(ld_pt_blobent));
+        if (!n) { LeaveCriticalSection(&g_pt.cs); return NULL; }
+        g_pt.blobs = n; g_pt.cap_blobs = cap;
+    }
+    idx = g_pt.n_blobs++;
+    g_pt.blobs[idx].stage = stage; g_pt.blobs[idx].hash = hash; g_pt.blobs[idx].len = len;
+    g_pt.blobs[idx].blob = NULL; g_pt.blobs[idx].done = 0;
+    LeaveCriticalSection(&g_pt.cs);
+
+    const LONGLONG t0 = ld_pt_qpc();
+    ID3DBlob* blob = ld_pl_load_blob(stage, hash, len);
+    if (!blob) {
+        ID3DBlob* err = NULL;
+        if (FAILED(D3DCompile(src, len, stage == 'V' ? "xvs" : "xps", NULL, NULL, "main", stage == 'V' ? "vs_5_0" : "ps_5_0",
+                              0, 0, &blob, &err)))
+            blob = NULL;
+        if (err) err->lpVtbl->Release(err);
+        if (blob) shader_disk_cache_store(stage, src, len, hash, blob);
+        EnterCriticalSection(&g_pt.cs);
+        g_pt.compile_us += (unsigned long long)((ld_pt_qpc() - t0) * 1000000 / g_pt.qpf);
+        LeaveCriticalSection(&g_pt.cs);
+    }
+    EnterCriticalSection(&g_pt.cs);
+    g_pt.blobs[idx].blob = blob; g_pt.blobs[idx].done = 1;   /* the table keeps this reference */
+    if (blob) blob->lpVtbl->AddRef(blob);
+    LeaveCriticalSection(&g_pt.cs);
+    WakeAllConditionVariable(&g_pt.cv);
+    return blob;
+}
