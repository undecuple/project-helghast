diff --git a/libs/video/rsx_legacy_skip.h b/libs/video/rsx_legacy_skip.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_legacy_skip.h
@@ -0,0 +1,88 @@
+/* KZ3 patch 2189 (command-thread overhaul O1): the legacy rsx_state machine off the FIFO walker under live draw.
+ * Pure core (no toolkit headers), host-tested by tools/smoke/test_legacy_skip.sh.
+ *
+ *   GCM_LEGACY_STATE_SKIP   unset / "" / 1  = skip (default since patch 2189; before: off)
+ *                           0               = off (the old gate: the machine runs whenever a backend is set)
+ *                           verify          = the machine runs for every method (the shadow) and the readers are counted
+ *   Skip applies when live draw is up and the backend is none or the null backend (the window); a real vtable backend
+ *   (D3D12 / Vulkan rsx_state path) keeps the machine.
+ *
+ * Effect list = the methods whose handler in rsx_process_method does more than update rsx_state, plus the ones the walker
+ * answers itself. Reasons:
+ *   0x0050 NV406E_SET_REFERENCE      g_rsx_last_reference (the ref publication reads it)
+ *   0x0104 NV4097_NOTIFY             writes the notify slot to guest memory (rsx_commands.c)
+ *   0x0180 SET_CONTEXT_DMA_NOTIFIES  s_notify_ctx, picks the notify slot
+ *   0x01A4 SET_CONTEXT_DMA_SEMAPHORE s_sem_ctx, picks where a semaphore lands
+ *   0x1D6C SET_SEMAPHORE_OFFSET      g_rsx_sem_off_4097
+ *   0x1D70 BACK_END_WRITE_SEMAPHORE  guest label write (+ fcap tag 9)
+ *   0x1D74 TEXTURE_READ_SEMAPHORE    guest label write, game frame marks
+ *   0x01A8 SET_CONTEXT_DMA_REPORT    s_report_dma is set by the walker after the gate; kept on the list so a later move of that
+ *                                    line cannot lose it
+ *   0x0000 SET_OBJECT                the walker's subchannel table; kept for the same reason
+ *   0xE920/0xE924                    the flip-command words, the walker handles them before this gate; kept for the same reason
+ * Every reader found by `verify` adds its method here; the copy is never deleted blind. */
+#ifndef RSX_LEGACY_SKIP_H
+#define RSX_LEGACY_SKIP_H
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+enum { RSX_LGS_OFF = 0, RSX_LGS_SKIP = 1, RSX_LGS_VERIFY = 2 };
+
+static inline int rsx_lgs_mode(const char* e)
+{
+    if (!e || !*e) return RSX_LGS_SKIP;
+    if (!strcmp(e, "verify")) return RSX_LGS_VERIFY;
+    return atoi(e) != 0 ? RSX_LGS_SKIP : RSX_LGS_OFF;
+}
+
+/* Test hook (compile time only, never defined in the toolkit build): drops one method from the list, the negative control. */
+static inline int rsx_lgs_effect(unsigned m)
+{
+#ifdef RSX_LGS_NEG_DROP
+    if (m == (unsigned)(RSX_LGS_NEG_DROP)) return 0;
+#endif
+    switch (m) {
+    case 0x0050u: case 0x0104u: case 0x0180u: case 0x01A4u: case 0x1D6Cu: case 0x1D70u: case 0x1D74u:
+    case 0x01A8u: case 0x0000u: case 0xE920u: case 0xE924u:
+        return 1;
+    default:
+        return 0;
+    }
+}
+
+enum { RSX_LGS_RD_MAX = 16 };
+typedef struct rsx_lgs {
+    unsigned long long m3d, ran, skipped;       /* methods seen, run through the machine, left out */
+    unsigned long long readers;                 /* verify: backend state callbacks after a method outside the list, backend not null */
+    unsigned long long null_state, null_param;  /* verify: calls into the null backend (log-only readers), by kind */
+    unsigned rd_m[RSX_LGS_RD_MAX]; unsigned long long rd_n[RSX_LGS_RD_MAX]; int rd_cnt;
+    int verify;
+} rsx_lgs;
+
+/* One method run through the shadow machine. d_state = backend callbacks that receive the rsx_state pointer, d_param = the
+ * ones that get plain parameters (clear, draws), both during this one method. Returns 1 when this is a new reader method. */
+static inline int rsx_lgs_note(rsx_lgs* s, unsigned m, int in_list, unsigned long long d_state, unsigned long long d_param, int null_backend)
+{
+    s->ran++;
+    if (in_list || (!d_state && !d_param)) return 0;
+    if (null_backend) { s->null_state += d_state; s->null_param += d_param; return 0; }
+    s->readers += d_state + d_param;
+    for (int i = 0; i < s->rd_cnt; i++) if (s->rd_m[i] == m) { s->rd_n[i] += d_state + d_param; return 0; }
+    if (s->rd_cnt < RSX_LGS_RD_MAX) { s->rd_m[s->rd_cnt] = m; s->rd_n[s->rd_cnt] = d_state + d_param; s->rd_cnt++; }
+    return 1;
+}
+
+/* [legacy-skip] t= mode= m3d= ran= skipped= readers= null_state= null_param= by_method=0x1808:12,0x1D94:3 (deltas of one period) */
+static inline int rsx_lgs_fmt(char* out, size_t n, double t, const rsx_lgs* c, const rsx_lgs* p)
+{
+    int o = snprintf(out, n, "[legacy-skip] t=%.0f mode=%s m3d=%llu ran=%llu skipped=%llu readers=%llu null_state=%llu null_param=%llu by_method=",
+                     t, c->verify ? "verify" : "skip", c->m3d - p->m3d, c->ran - p->ran, c->skipped - p->skipped,
+                     c->readers - p->readers, c->null_state - p->null_state, c->null_param - p->null_param);
+    if (o < 0) return o;
+    if (!c->rd_cnt && (size_t)o + 2 < n) o += snprintf(out + o, n - (size_t)o, "-");
+    for (int i = 0; i < c->rd_cnt && (size_t)o + 24 < n; i++)
+        o += snprintf(out + o, n - (size_t)o, "%s0x%04X:%llu", i ? "," : "", c->rd_m[i], c->rd_n[i]);
+    return o;
+}
+#endif
