+
+/* Walker, at a hash result: keep the quiet counter and the statistics. */
+static void ld_tex_hash_note(int readable, int changed, u32* quiet, u32* written)
+{
+    g_ld_th.hashes++;
+    if (readable && changed) {
+        g_ld_th.changes++;
+        if (*written) g_ld_th.tracked++; else g_ld_th.untracked++;
+        *quiet = 0;
+    } else if (readable && *quiet < 0xFFFFu) {
+        (*quiet)++;
+    }
+    *written = 0;
