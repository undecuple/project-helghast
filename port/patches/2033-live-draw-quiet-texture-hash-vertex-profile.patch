+/* Walker, at a hash decision: hash now, or keep the cached decode for this frame? */
+static int ld_tex_hash_due(u32 location, u32 offset, u32 span, u32 last_hash_frame, u32 quiet, u32* written,
+                           u32* skip_frame)
+{
+    const int n = ld_tex_hash_span();
+    if (location > 1u || !span) return 1;   /* never rate-limited; `written` stays as it is for the stat */
+    if (*written) return 1;
+    if (ld_td_test((const u32*)g_ld_td[location], offset, span)) { *written = 1; return 1; }
+    const int due = !n || quiet < (u32)n || g_ld_frames - last_hash_frame >= (u32)n;
+    { static int dbg = -1;   /* LD_TEX_HASH_DBG=1: every decision (host tests) */
+      if (dbg < 0) dbg = getenv("LD_TEX_HASH_DBG") ? 1 : 0;
+      if (dbg) fprintf(stderr, "[tex-hash-dbg] frame=%u src=%u:0x%08X span=%u quiet=%u last=%u due=%d\n",
+                       g_ld_frames, location, offset, span, quiet, last_hash_frame, due); }
+    if (due) return 1;
+    if (*skip_frame != g_ld_frames) { *skip_frame = g_ld_frames; g_ld_th.skipped++; }   /* once per entry per frame */
+    return 0;
