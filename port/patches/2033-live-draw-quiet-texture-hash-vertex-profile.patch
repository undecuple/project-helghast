+/* ---------------------------------------------------------------------------
+ * KZ3 patch 2033: cheaper texture change detection.
+ *
+ * 1. ld_fast_hash: the per-frame content hash ran one FNV multiply per 8 bytes
+ *    on a single dependency chain (~2.5 GB/s). Four independent lanes over
+ *    32-byte blocks keep the detector exact (every byte feeds the result) and
+ *    run at memory speed. The value is only compared with itself.
+ *
+ * 2. Quiet-texture hashing (LD_TEX_HASH_SPAN=N, 0 = off): a cached texture
+ *    whose hash came back unchanged N times in a row is re-hashed every N
+ *    frames instead of every frame, unless a tracked writer touched its guest
+ *    span. Tracked writers set bits in a 64 KB page bitmap per location
+ *    (ld_td_mark, any thread, atomic OR):
+ *      - the walker's own guest stores: NV0039 copies (note_guest_write),
+ *        NV3089 blits and NV308A inline writes (cellGcmSys.c), surface
+ *        write-backs (ld_writeback_surface / batch);
+ *      - SPU DMA puts (spu_dma.h -> cellGcm_note_guest_write_ea);
+ *      - the gv ring (rsx_live_draw_note_guest_write_async).
+ *    A bind consults the live bitmap (writes earlier this frame); the flip
+ *    moves the live bits aside and flags every entry under them (writes after
+ *    the bind), so a tracked write is hashed at the texture's next bind, as
+ *    before the patch. Direct PPU stores (recompiled code) have no hook: a
+ *    long-quiet texture rewritten in place by the PPU shows up to N-1 frames
+ *    late; [tex-hash] counts those as "untracked" changes (hash changed with
+ *    no tracked write), which is the evidence for the default.
+ * -------------------------------------------------------------------------*/
+static u64 ld_fast_hash(const u8* src, u32 n)
+{
+    const u64 P = 1099511628211ull;
+    u64 h0 = 1469598103934665603ull, h1 = 0x9E3779B97F4A7C15ull, h2 = 0xC2B2AE3D27D4EB4Full,
+        h3 = 0x165667B19E3779F9ull;
+    u32 i = 0;
+    for (; i + 32 <= n; i += 32) {
+        u64 w0, w1, w2, w3;
+        memcpy(&w0, src + i, 8); memcpy(&w1, src + i + 8, 8);
+        memcpy(&w2, src + i + 16, 8); memcpy(&w3, src + i + 24, 8);
+        h0 = (h0 ^ w0) * P; h1 = (h1 ^ w1) * P; h2 = (h2 ^ w2) * P; h3 = (h3 ^ w3) * P;
+    }
+    for (; i + 8 <= n; i += 8) { u64 w; memcpy(&w, src + i, 8); h0 = (h0 ^ w) * P; }
+    for (; i < n; i++) h0 = (h0 ^ src[i]) * P;
+    u64 h = h0 ^ (h1 * 0x9E3779B97F4A7C15ull) ^ (h2 * 0xC2B2AE3D27D4EB4Full) ^ (h3 * 0x165667B19E3779F9ull);
+    h ^= h >> 29; h *= 0xBF58476D1CE4E5B9ull; h ^= h >> 32;
+    return h;
+}
+
+#define LD_TD_WORDS 2048u   /* 64 KB pages over a 4 GB offset space, 32 pages per word, per location */
+static volatile LONG g_ld_td[2][LD_TD_WORDS];   /* pages written since the last flip (any thread) */
+static u32 g_ld_td_prev[2][LD_TD_WORDS];        /* pages written during the previous frame (walker) */
+static int g_ld_tex_hash_span = -1;
+static struct { u64 hashes, skipped, changes, tracked, untracked, hashed_bytes, flip_flags; } g_ld_th;
+
+static int ld_tex_hash_span(void)
+{
+    if (g_ld_tex_hash_span < 0) {
+        const char* e = getenv("LD_TEX_HASH_SPAN");
+        g_ld_tex_hash_span = e ? atoi(e) : LD_TEX_HASH_SPAN_DEFAULT;
+        if (g_ld_tex_hash_span < 0) g_ld_tex_hash_span = 0;
+    }
+    return g_ld_tex_hash_span;
+}
+
+/* Any thread. Marks the 64 KB pages of [offset, offset+size) in `location`. */
+static void ld_td_mark(u32 location, u32 offset, u32 size)
+{
+    if (location > 1u || !size) return;
+    const u64 end = (u64)offset + size - 1u;
+    const u32 p0 = offset >> 16, p1 = (u32)(end > 0xFFFFFFFFull ? 0xFFFFFFFFull : end) >> 16;
+    volatile LONG* td = g_ld_td[location];
+    for (u32 p = p0; ; p++) {
+        const LONG bit = (LONG)(1u << (p & 31u));
+        if (!(td[p >> 5] & bit)) InterlockedOr(&td[p >> 5], bit);
+        if (p == p1) break;
+    }
+}
+void rsx_live_draw_note_guest_write_pages(u32 location, u32 offset, u32 size) { ld_td_mark(location, offset, size); }
+
+/* Walker. Is any page of the span flagged in `td`? An unknown span (0) counts as written. */
+static int ld_td_test(const u32* td, u32 offset, u32 span)
+{
+    if (!span) return 1;
+    const u64 end = (u64)offset + span - 1u;
+    const u32 p0 = offset >> 16, p1 = (u32)(end > 0xFFFFFFFFull ? 0xFFFFFFFFull : end) >> 16;
+    for (u32 p = p0; ; p++) {
+        if (td[p >> 5] & (1u << (p & 31u))) return 1;
+        if (p == p1) break;
+    }
+    return 0;
+}
