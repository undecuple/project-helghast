+
+/* Walker, at the flip: move the live bits aside and flag the entries under them. */
+static void ld_td_flip(void)
+{
+    int any = 0;
+    for (u32 l = 0; l < 2u; l++)
+        for (u32 i = 0; i < LD_TD_WORDS; i++) {
+            u32 w = 0;
+            if (g_ld_td[l][i]) { w = (u32)InterlockedExchange(&g_ld_td[l][i], 0); any = 1; }
+            g_ld_td_prev[l][i] = w;
+        }
+    if (any) {
+        for (u32 i = 0; i < g.n_textures; i++) {
+            texcache_t* e = &g.textures[i];
+            if (e->tex && !e->written && e->location < 2u &&
+                ld_td_test(g_ld_td_prev[e->location], e->offset, e->span)) { e->written = 1; g_ld_th.flip_flags++; }
+        }
+        for (u32 i = 0; i < g.n_vtex; i++) {
+            vtexcache_t* e = &g.vtex[i];
+            if (e->tex && !e->written && e->location < 2u &&
+                ld_td_test(g_ld_td_prev[e->location], e->offset, e->span)) { e->written = 1; g_ld_th.flip_flags++; }
+        }
+    }
+    if (rsx_perf_enabled() && (g_ld_frames % 256u) == 255u) {
+        fprintf(stderr, "[tex-hash] span=%d frame=%u hashes=%llu skipped=%llu bytes=%.1fMB changes=%llu tracked=%llu"
+                        " untracked=%llu flip-flags=%llu\n",
+                ld_tex_hash_span(), g_ld_frames, (unsigned long long)g_ld_th.hashes,
+                (unsigned long long)g_ld_th.skipped, (double)g_ld_th.hashed_bytes / 1048576.0,
+                (unsigned long long)g_ld_th.changes, (unsigned long long)g_ld_th.tracked,
+                (unsigned long long)g_ld_th.untracked, (unsigned long long)g_ld_th.flip_flags);
+        memset(&g_ld_th, 0, sizeof g_ld_th);
+    }
+}
