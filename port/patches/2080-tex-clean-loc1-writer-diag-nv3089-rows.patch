+/* KZ3 patch 2080: NV3089 unscaled blits as row copies (LD_NV3089_ROWS=1; default off until the A/B).
+ *
+ * cellGcmSys.c's nv3089_blit copies the guest bytes one pixel at a time (vm_read32 + vm_write32, two byte swaps
+ * that cancel). For ds_dx == dt_dy == 1.0 (0x100000, 12.20) the source column is sx = ((u0 << 8) >> 20) + x and
+ * the row sy = ((v0 << 8) >> 20) + y exactly (x << 20 has no low bits), so every clipped destination row is one
+ * contiguous run of the source row: a memmove of the same bytes. Same idea as upstream PR 334 (erikomis), but the
+ * caller keeps its guest-write note for the destination (texture tracking, patches 2033/2079) and falls back to the
+ * per-pixel loop whenever the two could differ:
+ *   - the source and destination byte ranges (first row start .. last row end) overlap: the per-pixel loop's
+ *     forward order then defines the result, a row memmove would not;
+ *   - an address or row end leaves the 4 GB guest space (the per-pixel loop's u32 addresses wrap);
+ *   - dst_plain (if given) says a store into the destination range would do more than store: vm_write32's
+ *     write watch (PS3_WW_CHECK), an SPU reservation on a line (VM_WRITE_COH), a PPU reservation break.
+ * Returns 1 when it copied (or nothing is inside the clip), 0 when the caller must run its per-pixel loop.
+ * *bytes = destination bytes written either way (0 when nothing is inside the clip).
+ * Host test: tools/smoke/test_nv3089_rows.sh (byte-identical to the per-pixel loop over random blits). */
+#pragma once
+#include <stdint.h>
+#include <string.h>
+
+static inline int nv3089_rows_copy(uint8_t* base, uint32_t src, uint32_t in_pitch, uint32_t u0, uint32_t v0,
+                                   uint32_t dst, uint32_t dst_pitch, uint32_t out_x, uint32_t out_y,
+                                   uint32_t out_w, uint32_t out_h, uint32_t cx0, uint32_t cx1, uint32_t cy0,
+                                   uint32_t cy1, uint32_t bpp, uint64_t* bytes,
+                                   int (*dst_plain)(uint32_t lo, uint64_t n))
+{
+    uint64_t xa = out_x, xb = (uint64_t)out_x + out_w, ya = out_y, yb = (uint64_t)out_y + out_h;
+    if (xa < cx0) xa = cx0;
+    if (xb > cx1) xb = cx1;
+    if (ya < cy0) ya = cy0;
+    if (yb > cy1) yb = cy1;
+    *bytes = 0;
+    if (xa >= xb || ya >= yb) return 1;   /* the per-pixel loop writes nothing either */
+    const uint64_t len = (xb - xa) * bpp;
+    *bytes = len * (yb - ya);
+    const uint64_t sx0 = (((uint64_t)u0 << 8) >> 20) + (xa - out_x), sy0 = (((uint64_t)v0 << 8) >> 20) + (ya - out_y);
+    const uint64_t s_lo = src + sy0 * in_pitch + sx0 * bpp, s_hi = s_lo + (yb - ya - 1u) * in_pitch + len;
+    const uint64_t d_lo = dst + ya * dst_pitch + xa * bpp, d_hi = d_lo + (yb - ya - 1u) * dst_pitch + len;
+    if (s_hi > 0x100000000ull || d_hi > 0x100000000ull) return 0;   /* u32 wrap in the per-pixel loop */
+    if (s_lo < d_hi && d_lo < s_hi) return 0;                        /* overlap: forward order matters */
+    if (dst_plain && !dst_plain((uint32_t)d_lo, d_hi - d_lo)) return 0;   /* store hooks would fire: per-pixel */
+    for (uint64_t r = 0; r < yb - ya; r++)
+        memcpy(base + d_lo + r * dst_pitch, base + s_lo + r * in_pitch, (size_t)len);
+    return 1;
+}
