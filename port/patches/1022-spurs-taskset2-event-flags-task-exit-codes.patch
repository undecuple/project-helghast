

Rebased on ps3recomp v0.15.0 (SPU pass 81): upstream PR283 added a different spu_taskset_line_committed (wakes waiters), ours renamed spu_taskset_line_scan, both called.

Rebased on ps3recomp v0.17.0 (SPU pass 95): #381's Taskset2 helpers (spu_taskset2_register/set_exit; nothing registers a taskset in v0.17.0) kept next to spu_task2_exit_code_set; task_exited keeps #388's lock-line externs and s_ts_held.

Rebased on ps3recomp v0.19.0 (group B pass 2, R&C 2026-11-09, on KZ3's group A r152): follows KZ3's r152 merge shape (explore/1022)
so group A's 1056 applies: spu_task2_exit_code_set, spu_taskset_line_scan and the exit_code argument of
spu_taskset_task_exited as in v0.18. Dropped: the event-flag hunk (#629's CreateTaskset2 creates both flags at +0x1898/+0x189C)
and the CreateTask2 hunk on our old CreateTask2 (#629 has its own). Two fixes for v0.19: upstream's cellSpursCreateTask2
(TaskAttribute2 5th argument) now calls spu_task2_exit_code_set(..., create=1) after cellSpursCreateTask, which had left the
entry zeroed (state 0, which the SPU-side join reads as STAT); spu_taskset_task_exited passes the task's exit code to
upstream's spu_taskset2_set_exit, which otherwise overwrote the code just recorded with 0 for a registered Taskset2.
Kept: kz3_task2_take_exit_code in cellSpursTryJoinTask2/cellSpursJoinTask2 (patch 1019 keeps those; v0.19 has none).

diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
index 31180182..97a3ccc7 100644
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -1074,13 +1074,26 @@ static int kz3_task2_enabled(u32 ts, u32 id)
     return (vm_read8(ts + 0x30 + id / 8) >> (7 - (id & 7))) & 1;
 }
 
+/* The exit code recorded in task_exit_code[id] (+0x1980 + 16*id, +8) when the entry says exited (state 2);
+ * marks it joined (4), as the SPU-side join does. 0 otherwise (KZ3 patch 1022). */
+static s32 kz3_task2_take_exit_code(u32 ts, u32 id)
+{
+    if (vm_read32(ts + 0x1890) != 0x2900u) return 0;
+    u32 e = ts + 0x1980 + 16 * id;
+    if ((vm_read8(e + 15) & 0x0F) != 2) return 0;
+    s32 code = (s32)vm_read32(e + 8);
+    vm_write8(e + 15, 4);
+    return code;
+}
+
 s32 cellSpursTryJoinTask2(void* taskset, u32 id, s32* exitCode)
 {
     u32 ts = (u32)(uintptr_t)taskset;
     if (!ts) return CELL_SPURS_TASK_ERROR_NULL_POINTER;
     if (id >= CELL_SPURS_MAX_TASK) return CELL_SPURS_TASK_ERROR_INVAL;
     if (kz3_task2_enabled(ts, id)) return CELL_SPURS_TASK_ERROR_BUSY;
-    if (exitCode) vm_write32((u32)(uintptr_t)exitCode, 0);
+    if (exitCode) vm_write32((u32)(uintptr_t)exitCode, kz3_task2_take_exit_code(ts, id));
+    else kz3_task2_take_exit_code(ts, id);
     return CELL_OK;
 }
 
@@ -1094,7 +1107,8 @@ s32 cellSpursJoinTask2(void* taskset, u32 id, s32* exitCode)
         Sleep(spins < 64 ? 0 : 1);
         if (++spins == 20000) printf("[cellSpurs] JoinTask2 taskset=0x%08X id=%u still running after ~20 s\n", ts, id);
     }
-    if (exitCode) vm_write32((u32)(uintptr_t)exitCode, 0);
+    if (exitCode) vm_write32((u32)(uintptr_t)exitCode, kz3_task2_take_exit_code(ts, id));
+    else kz3_task2_take_exit_code(ts, id);
     return CELL_OK;
 }
 
@@ -1501,6 +1515,9 @@ s32 cellSpursCreateTask2(CellSpursTaskset* taskset, u64 id_ea, u64 elf_ea,
                                  (void*)(uintptr_t)(u32)elf_ea,
                                  (void*)(uintptr_t)context_ea, size_context,
                                  ls_pattern_ea, (u32)argument_ea);
+    /* task_exit_code[id] := running, joinable (KZ3 patch 1022, see spu_task2_exit_code_set). */
+    { extern void spu_task2_exit_code_set(uint32_t, uint32_t, int32_t, int);
+      if (rc == CELL_OK) spu_task2_exit_code_set((u32)(uintptr_t)taskset, vm_read32((u32)id_ea), 0, 1); }
     return rc;
 }
 
