-static void spu_taskset_task_exited(uint32_t taskset_ea, uint32_t done_task)
+/* CellSpursTaskset2 (size 0x2900 at +0x1890): task_exit_code[128] at +0x1980, 16 bytes per task. Read
+ * from the SPU-side join in KZ3's Havok task (elf_00f6b900 LS 0x1D08C-0x1D1BC, GETLLAR/PUTLLC on the
+ * entry): u32 exit code at +8; byte 14 must be 0; byte 15 low nibble = state. 1 = running (with 0x10 set:
+ * joinable, the join answers AGAIN 0x80410901 and retries), 2 = exited (join copies +8 and sets byte 15 to
+ * 4 = joined), 3 = shut down (SHUTDOWN 0x80410920), anything else = STAT 0x8041090F. Nothing wrote the
+ * array, so every SPU join saw 0 (STAT) and the Havok workers spun on it. The task exit writes state 2
+ * here, cellSpursCreateTask2 writes 0x11 (KZ3 patch 1022). Shared with the PPU join in cellSpurs.c. */
+void spu_task2_exit_code_set(uint32_t taskset_ea, uint32_t task, int32_t exit_code, int create)
+{
+    extern uint8_t* vm_base;
+    if (!vm_base || !taskset_ea || task >= 128) return;
+    uint8_t* ts = vm_base + taskset_ea;
+    uint32_t size = ((uint32_t)ts[0x1890] << 24) | ((uint32_t)ts[0x1891] << 16) |
+                    ((uint32_t)ts[0x1892] << 8) | ts[0x1893];
+    if (size != 0x2900u) return;
+    uint32_t ea = taskset_ea + 0x1980u + 16u * task;
+    uint8_t* e = vm_base + ea;
+    extern void spu_lockline_lock(void); extern void spu_lockline_unlock(void);
+    extern void spu_coh_notify_write(uint32_t ea);
+    spu_lockline_lock();
+    uint8_t st = e[15] & 0x0Fu;
+    if (create) {
+        if (st != 2 && st != 3) {          /* the task may already have exited: keep that */
+            e[8] = e[9] = e[10] = e[11] = 0; e[14] = 0; e[15] = 0x11;
+        }
+    } else {
+        e[8] = (uint8_t)((uint32_t)exit_code >> 24); e[9] = (uint8_t)((uint32_t)exit_code >> 16);
+        e[10] = (uint8_t)((uint32_t)exit_code >> 8); e[11] = (uint8_t)exit_code;
+        e[14] = 0; e[15] = (uint8_t)((e[15] & 0xF0u) | 2u);
+    }
+    spu_lockline_unlock();
+    spu_coh_notify_write(ea);
+    static int n;
+    if (n++ < 16)
+        fprintf(stderr, "[task2] taskset 0x%08X task %u %s exit_code[%u] state 0x%02X code %d\n", taskset_ea,
+                task, create ? "created:" : "exited:", task, e[15], exit_code);
+}
+
+static void spu_taskset_task_exited(uint32_t taskset_ea, uint32_t done_task, int32_t exit_code)
 {
     extern uint8_t* vm_base;
     extern uint32_t g_ydkj_real_taskset_ea, g_ydkj_real_taskid;
     extern void spu_lockline_lock(void); extern void spu_lockline_unlock(void);
     extern void spu_coh_notify_write(uint32_t);
+    spu_task2_exit_code_set(taskset_ea, done_task, exit_code, 0);   /* KZ3 patch 1022 */
     ts_lock(); s_ts_held = 1;
     uint8_t* ts = vm_base + taskset_ea;
     uint8_t* run = ts_running(taskset_ea);
@@ -500,7 +539,22 @@ static void spu_taskset_task_exited(uint32_t taskset_ea, uint32_t done_task)
  * last exit (Havok's master recreates its workers) was never noticed. */
 void spu_taskset_start_pending(uint32_t taskset_ea)
 {
-    if (taskset_ea) spu_taskset_task_exited(taskset_ea, 0xFFFFFFFFu);
+    if (taskset_ea) spu_taskset_task_exited(taskset_ea, 0xFFFFFFFFu, 0);
+}
+
+/* A PUTLLC landed in the first 0x1900 bytes of a taskset the runtime tracks (bitsets, task_info): SPU code
+ * may have created a task or made one ready (KZ3's Havok task calls the SPU-side cellSpursCreateTask2,
+ * elf_00f6b900 LS 0x1C710, then joins it). The real taskset policy module would schedule it; scan the
+ * taskset now, as a task exit does, instead of only when some task of it exits (KZ3 patch 1022; named
+ * _scan since upstream's spu_taskset_line_committed below wakes WAIT_SIGNAL waiters on the same commits). */
+void spu_taskset_line_scan(uint32_t line)
+{
+    uint32_t hit = 0;
+    for (int i = 0; i < TS_TRACK; i++) {
+        uint32_t ts = s_ts_run[i].ea;
+        if (ts && line >= ts && line < ts + 0x1900u) { hit = ts; break; }
+    }
+    if (hit) spu_taskset_task_exited(hit, 128u, 0);
 }
 
