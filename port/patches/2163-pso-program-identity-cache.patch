diff --git a/libs/video/rsx_pso_memo.h b/libs/video/rsx_pso_memo.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_pso_memo.h
@@ -0,0 +1,227 @@
+/* KZ3 patch 2163: multi-entry program identity cache for get_pso (RSX pass 150).
+ *
+ * get_pso() kept one fragment-program memo (g_ld_fpm: bytes + FP key hash) and one vertex-program memo (g_ld_vpm: bytes
+ * + FNV). Alternating programs (A B A B ...) defeat a one-slot memo, so every draw re-ran the FP size scan, the FP
+ * structural hash, the VP FNV, the texture-unit mask, the TXL mask, the flow scans and rsx_fp_collect_constants
+ * (pass 119 counters: 623 FP size scans + 623 FP key hashes + 320 VP FNVs per frame, ~1.1 ms/frame together).
+ *
+ * This keeps two small direct-mapped tables, VP by start slot and FP by (location, offset). Every entry holds the
+ * program bytes it was made for; a hit is only taken after a memcmp of those bytes against the current guest bytes
+ * (never reused unvalidated, so a guest rewrite at the same address misses). The derived values are pure functions of
+ * those bytes: VP instruction count, TXL mask, flow, branch-bit use, FNV; FP size, texture-unit mask and inline
+ * constants (rsx_fp_collect_constants; g.fp_constants has no other writer in the live draw). The FP key hash also
+ * depends on the VP hash (seed) and the constants mode, so each FP entry holds two (mode, seed, hash) results.
+ * Programs larger than the entry buffers are never cached (a transient entry is returned, nothing stored).
+ * The VP size scan is skipped on a hit: the cached bytes end in an instruction with the end bit and no earlier
+ * instruction has it, so equal bytes give the same count (verify mode re-scans and counts disagreements).
+ * LD_PSO_MEMO_N = entries per table (0 = old single-slot memos, rounded down to a power of two, max 16, default 16),
+ * LD_PSO_MEMO_VERIFY=1 = recompute everything on every hit, use the recomputed values and count mismatches.
+ * Host test: tools/smoke/test_pso_memo.sh. */
+#ifndef RSX_PSO_MEMO_H
+#define RSX_PSO_MEMO_H
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include "rsx_fp_decompiler.h"
+#include "rsx_vp_decompiler.h"
+
+#define RSX_PM_MAX_SLOTS 16u
+#define RSX_PM_VP_CAP    (544u * 16u)   /* RSX_DSP_VP_INSTR * 16 */
+#define RSX_PM_FP_CAP    8192u
+
+typedef struct rsx_pm_vp {
+    uint32_t valid, start, n, instrs;
+    uint32_t txl; int flow, bbits;
+    uint64_t h;
+    uint8_t bytes[RSX_PM_VP_CAP];
+} rsx_pm_vp;
+
+typedef struct rsx_pm_hash { uint32_t valid, mode; uint64_t seed, h; } rsx_pm_hash;
+
+typedef struct rsx_pm_fp {
+    uint32_t valid, loc, off, size;
+    int units_valid; uint32_t units;
+    int consts_valid; uint32_t nconst;   /* nconst = rsx_fp_collect_constants result (>= 0) */
+    rsx_pm_hash hs[2]; uint32_t hnext;
+    rsx_fp_constant_block consts;
+    uint8_t bytes[RSX_PM_FP_CAP];
+} rsx_pm_fp;
+
+typedef struct rsx_pm {
+    uint32_t n;            /* slots per table: 0 = off, else a power of two <= 16 */
+    int verify;
+    uint64_t vp_hit, vp_miss, fp_hit, fp_miss, mismatch, big;
+    rsx_pm_vp vp[RSX_PM_MAX_SLOTS], vp_tmp;
+    rsx_pm_fp fp[RSX_PM_MAX_SLOTS], fp_tmp;
+} rsx_pm;
+
+typedef uint64_t (*rsx_pm_hash_fn)(const void*, uint32_t, uint64_t);
+typedef const uint8_t* (*rsx_pm_guest_fn)(uint32_t loc, uint32_t off, uint32_t min_bytes);
+
+/* Test hook only (tools/smoke/test_pso_memo.sh negative control): RSX_PM_TEST_FLAW skips the byte validation. */
+#ifdef RSX_PM_TEST_FLAW
+#define RSX_PM_MEMCMP(a, b, n) 0
+#else
+#define RSX_PM_MEMCMP(a, b, n) memcmp((a), (b), (n))
+#endif
+
+#define RSX_PM_VP_SEED 1469598103934665603ull
+
+/* LD_PSO_MEMO_N parsing: unset = 16, "0" = 0, else floor-pow2 clamp to [1, 16]. */
+static inline uint32_t rsx_pm_slots_from(const char* e)
+{
+    if (!e || !e[0]) return RSX_PM_MAX_SLOTS;
+    int v = atoi(e);
+    if (v <= 0) return 0;
+    uint32_t n = 1;
+    while (n * 2u <= (uint32_t)v && n * 2u <= RSX_PM_MAX_SLOTS) n *= 2u;
+    return n;
+}
+static inline void rsx_pm_init(rsx_pm* pm, uint32_t n, int verify)
+{
+    memset(pm->vp, 0, sizeof pm->vp); memset(pm->fp, 0, sizeof pm->fp);   /* valid = 0 */
+    pm->vp_tmp.valid = 0; pm->fp_tmp.valid = 0;
+    pm->n = n; pm->verify = verify;
+    pm->vp_hit = pm->vp_miss = pm->fp_hit = pm->fp_miss = pm->mismatch = pm->big = 0;
+}
+
+static inline uint32_t rsx_pm_vp_slot(const rsx_pm* pm, uint32_t start)
+{ return ((start * 0x9E3779B1u) >> 28) & (pm->n - 1u); }
+static inline uint32_t rsx_pm_fp_slot(const rsx_pm* pm, uint32_t loc, uint32_t off)
+{ return ((((off >> 4) ^ (loc << 24)) * 0x9E3779B1u) >> 28) & (pm->n - 1u); }
+
+/* Same logic as rsx_live_draw.c vp_txl_unit_mask (kept there for the uncached path and the verify compare). */
+static inline uint32_t rsx_pm_vp_txl_mask(const uint8_t* uc, uint32_t instrs)
+{
+    uint32_t mask = 0;
+    for (uint32_t i = 0; i < instrs; i++) {
+        const uint8_t* p = uc + i * 16;
+        const uint32_t d1 = (uint32_t)p[4] | ((uint32_t)p[5] << 8) | ((uint32_t)p[6] << 16) | ((uint32_t)p[7] << 24);
+        if (((d1 >> 22) & 0x1Fu) != 0x19u) continue;
+        const uint32_t d2 = (uint32_t)p[8] | ((uint32_t)p[9] << 8) | ((uint32_t)p[10] << 16) | ((uint32_t)p[11] << 24);
+        mask |= 1u << ((d2 >> 8) & 3u);
+    }
+    return mask;
+}
+/* rsx_vp_key_branch_base's key mix for a program with flow ("VBS1" + start slot), FNV-1a over 8 bytes. */
+static inline uint64_t rsx_pm_vbs_key(uint64_t key, uint32_t start_slot)
+{
+    const uint32_t w[2] = { 0x31534256u, start_slot };
+    const uint8_t* p = (const uint8_t*)w;
+    for (uint32_t i = 0; i < (uint32_t)sizeof w; i++) { key ^= p[i]; key *= 1099511628211ull; }
+    return key;
+}
+
+static inline void rsx_pm_vp_fill(rsx_pm_vp* e, const uint8_t* vp_uc, uint32_t start, uint32_t instrs, rsx_pm_hash_fn fnv)
+{
+    const uint32_t n = instrs * 16u;
+    e->start = start; e->instrs = instrs; e->n = n;
+    e->txl = rsx_pm_vp_txl_mask(vp_uc, instrs);
+    e->flow = rsx_vp_has_flow(vp_uc, n);
+    e->bbits = e->flow && rsx_vp_uses_branch_bits(vp_uc, n);
+    e->h = fnv(vp_uc, n, RSX_PM_VP_SEED);
+}
+
+/* The vertex program at vp_uc (avail_bytes readable from slot `start`). Returns an entry (valid for use until the next
+ * call); entry->instrs == 0 means no program (no end bit), same as rsx_vp_program_size_instrs. */
+static inline const rsx_pm_vp* rsx_pm_vp_get(rsx_pm* pm, const uint8_t* vp_uc, uint32_t start, uint32_t avail_bytes,
+                                             rsx_pm_hash_fn fnv)
+{
+    rsx_pm_vp* e = &pm->vp[rsx_pm_vp_slot(pm, start)];
+    if (e->valid && e->start == start && !RSX_PM_MEMCMP(vp_uc, e->bytes, e->n)) {
+        pm->vp_hit++;
+        if (pm->verify) {
+            rsx_pm_vp r; const uint32_t ri = rsx_vp_program_size_instrs(vp_uc, avail_bytes);
+            int bad = ri != e->instrs;
+            if (!bad) { rsx_pm_vp_fill(&r, vp_uc, start, ri, fnv);
+                bad = r.txl != e->txl || r.flow != e->flow || r.bbits != e->bbits || r.h != e->h; }
+            if (bad) { pm->mismatch++; e->valid = 0; goto miss; }
+        }
+        return e;
+    }
+miss:
+    pm->vp_miss++;
+    {
+        const uint32_t instrs = rsx_vp_program_size_instrs(vp_uc, avail_bytes);
+        rsx_pm_vp* t = &pm->vp_tmp;
+        if (!instrs) { t->valid = 0; t->instrs = 0; t->n = 0; return t; }
+        if (instrs * 16u > RSX_PM_VP_CAP) { pm->big++; t = &pm->vp_tmp; }
+        else t = e;
+        rsx_pm_vp_fill(t, vp_uc, start, instrs, fnv);
+        if (t == e) { memcpy(e->bytes, vp_uc, e->n); e->valid = 1; }
+        else t->valid = 0;
+        return t;
+    }
+}
+
+/* Lookup: a valid entry for (loc, off) whose bytes equal the guest bytes now, else NULL. fp_uc16 = the 16-byte
+ * resolution (the base the size scan reads from; verify only). */
+static inline rsx_pm_fp* rsx_pm_fp_lookup(rsx_pm* pm, uint32_t loc, uint32_t off, const uint8_t* fp_uc16,
+                                          rsx_pm_guest_fn gp)
+{
+    rsx_pm_fp* e = &pm->fp[rsx_pm_fp_slot(pm, loc, off)];
+    if (e->valid && e->loc == loc && e->off == off) {
+        const uint8_t* q = gp(loc, off, e->size);
+        if (q && !RSX_PM_MEMCMP(q, e->bytes, e->size)) {
+            pm->fp_hit++;
+            if (pm->verify && rsx_fp_program_size(fp_uc16, 0x10000) != e->size) { pm->mismatch++; e->valid = 0; return NULL; }
+            return e;
+        }
+    }
+    pm->fp_miss++;
+    return NULL;
+}
+/* Insert (after a miss and the caller's size scan); fp_uc = the bytes resolved with the true size. Never NULL. */
+static inline rsx_pm_fp* rsx_pm_fp_insert(rsx_pm* pm, uint32_t loc, uint32_t off, const uint8_t* fp_uc, uint32_t size)
+{
+    rsx_pm_fp* e = size <= RSX_PM_FP_CAP ? &pm->fp[rsx_pm_fp_slot(pm, loc, off)] : &pm->fp_tmp;
+    if (e == &pm->fp_tmp) pm->big++;
+    e->loc = loc; e->off = off; e->size = size;
+    e->units_valid = 0; e->consts_valid = 0; e->hs[0].valid = e->hs[1].valid = 0; e->hnext = 0;
+    if (e != &pm->fp_tmp) { memcpy(e->bytes, fp_uc, size); e->valid = 1; } else e->valid = 0;
+    return e;
+}
+static inline uint32_t rsx_pm_fp_units(rsx_pm* pm, rsx_pm_fp* e, const uint8_t* fp_uc)
+{
+    if (e->units_valid) {
+        if (pm->verify && rsx_fp_texture_unit_mask(fp_uc, e->size) != e->units) {
+            pm->mismatch++; e->units = rsx_fp_texture_unit_mask(fp_uc, e->size); }
+        return e->units;
+    }
+    e->units = rsx_fp_texture_unit_mask(fp_uc, e->size); e->units_valid = 1;
+    return e->units;
+}
+/* Inline constants into *out (count + count rows, like rsx_fp_collect_constants); < 0 = collection failed (not cached). */
+static inline int rsx_pm_fp_consts(rsx_pm* pm, rsx_pm_fp* e, const uint8_t* fp_uc, rsx_fp_constant_block* out)
+{
+    if (!e->consts_valid) {
+        const int rc = rsx_fp_collect_constants(fp_uc, e->size, &e->consts);
+        if (rc < 0) return rc;
+        e->nconst = (uint32_t)rc; e->consts_valid = 1;
+    } else if (pm->verify) {
+        static rsx_fp_constant_block ref;
+        const int rc = rsx_fp_collect_constants(fp_uc, e->size, &ref);
+        if (rc < 0 || (uint32_t)rc != e->nconst || memcmp(ref.values, e->consts.values, (size_t)rc * 16u)) {
+            pm->mismatch++;
+            if (rc < 0) return rc;
+            memcpy(&e->consts, &ref, sizeof ref); e->nconst = (uint32_t)rc;
+        }
+    }
+    out->count = e->nconst;
+    memcpy(out->values, e->consts.values, (size_t)e->nconst * 16u);
+    return (int)e->nconst;
+}
+static inline int rsx_pm_fp_hash_get(rsx_pm_fp* e, uint32_t mode, uint64_t seed, uint64_t* h)
+{
+    for (int i = 0; i < 2; i++)
+        if (e->hs[i].valid && e->hs[i].mode == mode && e->hs[i].seed == seed) { *h = e->hs[i].h; return 1; }
+    return 0;
+}
+static inline void rsx_pm_fp_hash_put(rsx_pm_fp* e, uint32_t mode, uint64_t seed, uint64_t h)
+{
+    rsx_pm_hash* s = &e->hs[e->hnext & 1u]; e->hnext++;
+    s->valid = 1; s->mode = mode; s->seed = seed; s->h = h;
+}
+
+#endif
