+/* KZ3 patch 1030 (diagnostic): one line per tracked taskset with its bitsets, the runtime's running marks and
+ * every enabled task's ELF/context and taskset2 exit-code state; called from the SEMDUMP periodic dump. */
+void spu_taskset_dump_tracked(const char* why)
+{
+    extern uint8_t* vm_base;
+    if (!vm_base) return;
+    for (int i = 0; i < TS_TRACK; i++) {
+        uint32_t ea = s_ts_run[i].ea;
+        if (!ea) continue;
+        const uint8_t* t = vm_base + ea; const uint8_t* r = s_ts_run[i].running;
+        fprintf(stderr, "[ts-dump] %s ts=0x%08X run=%02X%02X ready=%02X%02X pend=%02X%02X en=%02X%02X sig=%02X%02X wait=%02X%02X\n",
+                why, ea, r[0], r[1], t[0x10], t[0x11], t[0x20], t[0x21], t[0x30], t[0x31], t[0x40], t[0x41], t[0x50], t[0x51]);
+        uint32_t size = ((uint32_t)t[0x1890] << 24) | ((uint32_t)t[0x1891] << 16) | ((uint32_t)t[0x1892] << 8) | t[0x1893];
+        for (int k = 0; k < 16; k++) {
+            const uint8_t* ti = t + 0x80 + 0x30 * k;
+            uint32_t elf = ((uint32_t)ti[0x14] << 24) | ((uint32_t)ti[0x15] << 16) | ((uint32_t)ti[0x16] << 8) | ti[0x17];
+            if (!elf) continue;
+            const uint8_t* xc = t + 0x1980 + 16 * k;
+            fprintf(stderr, "[ts-dump]   task %d elf=%08X ctx=%02X%02X%02X%02X exit=%s%02X%02X%02X%02X/%02X\n", k, elf,
+                    ti[0x1C], ti[0x1D], ti[0x1E], ti[0x1F], size == 0x2900u ? "" : "(n/a)", xc[8], xc[9], xc[10], xc[11], xc[15]);
+        }
+    }
+}
